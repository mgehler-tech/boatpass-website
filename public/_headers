# Cloudflare Pages – Caching
# Gehashte Build-Assets (Dateiname ändert sich bei jedem Build) → für immer cachen
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder & Fonts → lange cachen
/images/*
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

# Sicherheits-Header für alle Seiten
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # HSTS: erzwingt HTTPS und spart Google den Redirect-Hop beim Crawlen.
  # Ohne `preload`-Direktive – die ist einseitig schwer rückgängig zu machen.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Die Seite braucht keine dieser Browser-APIs; explizit abschalten.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
