---
import BaseLayout from '../layouts/BaseLayout.astro';

// FAQPage-Schema: spiegelt die vier sichtbaren Selbsthilfe-Fragen unten auf der Seite.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ich habe gekauft, sehe die Fragen aber nicht",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der Kauf hängt am Google-Konto, nicht am Gerät. Öffne die App mit demselben Konto und tippe in den Einstellungen auf „Käufe wiederherstellen\". Klappt das nicht, schreib uns mit deiner Bestellnummer aus der Play-Store-Bestätigungsmail.",
      },
    },
    {
      "@type": "Question",
      "name": "Ist der Fragenkatalog aktuell?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir nutzen den amtlichen ELWIS-Katalog von DSV und DMYV und gleichen ihn regelmäßig ab. Welche Fragen in der Prüfung drankommen, steht auf den Seiten SBF Binnen Prüfungsfragen und SBF See Prüfungsfragen.",
      },
    },
    {
      "@type": "Question",
      "name": "Gibt es Boatpass für iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aktuell nur für Android. Eine iOS-Version ist in Arbeit – schreib uns gern, dann sagen wir dir zum Start Bescheid.",
      },
    },
    {
      "@type": "Question",
      "name": "Fragen zur Prüfung selbst",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zu Anmeldung, Kosten und Ablauf beraten wir nicht individuell – das übernehmen DSV und DMYV. Das Wichtigste haben wir aber gesammelt: Prüfungsablauf, Kosten, Promillegrenze an Bord und die häufigen Fragen.",
      },
    },
  ],
};
---

<BaseLayout
  title="Kontakt"
  description="Fragen zur Boatpass-App, zum SBF-Fragenkatalog oder ein technisches Problem? So erreichst du uns – wir antworten in der Regel binnen 24 Stunden."
  lang="de"
  altUrl="https://boatpass.de/en/contact/"
  showCta={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div style="max-width:600px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        Kontakt
      </div>
      <h1 style="font-size:clamp(30px,4.5vw,42px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:12px;">Schreib uns</h1>
      <p style="font-size:16px; color:#656B78;">Fragen, Feedback oder ein Bug gefunden? Wir freuen uns von dir zu hören.</p>
    </div>

    <div id="success-msg" role="status" aria-live="polite" aria-atomic="true" style="display:none; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; border-radius:12px; padding:20px 24px; margin-bottom:24px; font-weight:500; font-size:1rem;">
      ✓ Nachricht erfolgreich gesendet! Das Team meldet sich so schnell wie möglich bei dir.
    </div>
    <div id="error-msg" role="alert" aria-live="assertive" aria-atomic="true" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:12px; padding:16px 20px; margin-bottom:24px;"></div>

    <form id="kontakt-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Dein Name</label>
        <input type="text" id="name" name="name" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">E-Mail-Adresse</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Deine Nachricht</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Absenden
      </button>
    </form>

    <!-- Support-Selbsthilfe: beantwortet die Fragen, die uns am häufigsten per
         Formular erreichen, und macht die Seite für Suchmaschinen mehr als ein
         nacktes Formular. -->
    <section style="margin-top:56px;">
      <h2 style="font-size:22px; font-weight:900; letter-spacing:-0.02em; color:#1A1F36; margin-bottom:8px;">Vielleicht hilft das schon weiter</h2>
      <p style="font-size:15px; color:#656B78; margin-bottom:24px;">Diese vier Fragen erreichen uns am häufigsten – die Antwort steht meist schon auf der Website.</p>

      <div style="display:grid; gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Ich habe gekauft, sehe die Fragen aber nicht</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Der Kauf hängt am Google-Konto, nicht am Gerät. Öffne die App mit demselben Konto und tippe in den Einstellungen auf „Käufe wiederherstellen". Klappt das nicht, schreib uns mit deiner Bestellnummer aus der Play-Store-Bestätigungsmail.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Ist der Fragenkatalog aktuell?</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Ja. Wir nutzen den amtlichen ELWIS-Katalog von DSV und DMYV und gleichen ihn regelmäßig ab. Welche Fragen in der Prüfung drankommen, steht auf den Seiten <a href="/sbf-binnen-pruefungsfragen/" style="color:#3366FF;">SBF Binnen Prüfungsfragen</a> und <a href="/sbf-see-pruefungsfragen/" style="color:#3366FF;">SBF See Prüfungsfragen</a>.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Gibt es Boatpass für iPhone?</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Aktuell nur für Android. Eine iOS-Version ist in Arbeit – schreib uns gern, dann sagen wir dir zum Start Bescheid.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Fragen zur Prüfung selbst</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Zu Anmeldung, Kosten und Ablauf beraten wir nicht individuell – das übernehmen DSV und DMYV. Das Wichtigste haben wir aber gesammelt: <a href="/sbf-pruefung-ablauf/" style="color:#3366FF;">Prüfungsablauf</a>, <a href="/sbf-kosten/" style="color:#3366FF;">Kosten</a>, <a href="/blog/promillegrenze-boot/" style="color:#3366FF;">Promillegrenze an Bord</a> und die <a href="/faq/" style="color:#3366FF;">häufigen Fragen</a>.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    const form = document.getElementById('kontakt-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Fehler beim Senden. Bitte versuche es erneut.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Absenden';
        }
      } catch {
        errorMsg.textContent = 'Netzwerkfehler. Bitte versuche es erneut.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Absenden';
      }
    });
  </script>
</BaseLayout>
