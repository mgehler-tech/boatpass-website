---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';

// FAQPage-Schema: spiegelt die vier sichtbaren Selbsthilfe-Fragen unten auf der Seite.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ich habe gekauft, sehe die Fragen aber nicht",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der Kauf hängt an deinem Google-Konto bzw. deiner Apple-ID, nicht am Gerät. Öffne die App mit demselben Konto und tippe in den Einstellungen auf „Käufe wiederherstellen\". Klappt das nicht, schreib uns mit deiner Bestellnummer aus der Kaufbestätigung von Google Play oder Apple. Ein Kauf bei Google Play gilt übrigens nicht auf dem iPhone und umgekehrt.",
      },
    },
    {
      "@type": "Question",
      "name": "Ist der Fragenkatalog aktuell?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Wir nutzen den amtlichen ELWIS-Katalog von DSV und DMYV und gleichen ihn regelmäßig ab. Welche Fragen in der Prüfung drankommen, steht auf den Seiten SBF Binnen Prüfungsfragen und SBF See Prüfungsfragen.",
      },
    },
    {
      "@type": "Question",
      "name": "Gibt es Boatpass für iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, seit Oktober 2026 – für iPhone und iPad ab iOS 16, kostenlos im App Store.",
      },
    },
    {
      "@type": "Question",
      "name": "Fragen zur Prüfung selbst",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zu Anmeldung, Kosten und Ablauf beraten wir nicht individuell – das übernehmen DSV und DMYV. Das Wichtigste haben wir aber gesammelt: Prüfungsablauf, Kosten, Promillegrenze an Bord und die häufigen Fragen.",
      },
    },
  ],
};
---

<BaseLayout
  title="Kontakt – SBF-App Support & Fragen"
  description="Fragen zur Boatpass-App, zum SBF-Fragenkatalog oder ein technisches Problem? So erreichst du mich – ich antworte meist innerhalb weniger Stunden."
  lang="de"
  altUrl="https://boatpass.de/en/contact/"
  showCta={false}
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1/3.5) -->
  <PageHead
    lang="de"
    eyebrow="Kontakt"
    lede="Fragen, Feedback oder ein Bug gefunden? Wir freuen uns von dir zu hören."
  >
    Schreib uns
  </PageHead>

  <PageLayout variant="narrow">

    <div id="success-msg" role="status" aria-live="polite" aria-atomic="true" class="pg-notice pg-notice--ok" style="display:none;">
      ✓ Nachricht angekommen! Sie landet direkt bei Marius – Antwort meist innerhalb weniger Stunden.
    </div>
    <div id="error-msg" role="alert" aria-live="assertive" aria-atomic="true" class="pg-notice pg-notice--error" style="display:none;"></div>

    <form id="kontakt-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Dein Name</label>
        <input type="text" id="name" name="name" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">E-Mail-Adresse</label>
        <input type="email" id="email" name="email" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Deine Nachricht</label>
        <textarea id="message" name="message" rows="5" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Absenden
      </button>
    </form>

    <!-- Support-Selbsthilfe: beantwortet die Fragen, die uns am häufigsten per
         Formular erreichen, und macht die Seite für Suchmaschinen mehr als ein
         nacktes Formular. -->
    <section class="pg-section">
      <h2 class="pg-h2">Vielleicht hilft das schon weiter</h2>
      <p class="pg-p">Diese vier Fragen erreichen uns am häufigsten – die Antwort steht meist schon auf der Website.</p>

      <div class="pg-faq">
        <div class="pg-faq-item">
          <h3 class="pg-h3">Ich habe gekauft, sehe die Fragen aber nicht</h3>
          <p class="pg-card-text">Der Kauf hängt an deinem Google-Konto bzw. deiner Apple-ID, nicht am Gerät. Öffne die App mit demselben Konto und tippe in den Einstellungen auf „Käufe wiederherstellen". Klappt das nicht, schreib uns mit deiner Bestellnummer aus der Kaufbestätigung von Google Play oder Apple. Ein Kauf bei Google Play gilt übrigens nicht auf dem iPhone und umgekehrt.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Ist der Fragenkatalog aktuell?</h3>
          <p class="pg-card-text">Ja. Wir nutzen den amtlichen ELWIS-Katalog von DSV und DMYV und gleichen ihn regelmäßig ab. Welche Fragen in der Prüfung drankommen, steht auf den Seiten <a href="/sbf-binnen-pruefungsfragen/" class="pg-inline-link">SBF Binnen Prüfungsfragen</a> und <a href="/sbf-see-pruefungsfragen/" class="pg-inline-link">SBF See Prüfungsfragen</a>.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Gibt es Boatpass für iPhone?</h3>
          <p class="pg-card-text">Ja, seit Oktober 2026 – für iPhone und iPad ab iOS 16, kostenlos im App Store.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Fragen zur Prüfung selbst</h3>
          <p class="pg-card-text">Zu Anmeldung, Kosten und Ablauf beraten wir nicht individuell – das übernehmen DSV und DMYV. Das Wichtigste haben wir aber gesammelt: <a href="/sbf-pruefung-ablauf/" class="pg-inline-link">Prüfungsablauf</a>, <a href="/sbf-kosten/" class="pg-inline-link">Kosten</a>, <a href="/blog/promillegrenze-boot/" class="pg-inline-link">Promillegrenze an Bord</a> und die <a href="/faq/" class="pg-inline-link">häufigen Fragen</a>.</p>
        </div>
      </div>
    </section>
  </PageLayout>

  <style>
    /* Formularfelder an das projektweite Design-System angeglichen. Vorher trugen
       die Inputs nur Tailwind-Utilities ohne Dark-Mode-Behandlung – im Dunkelmodus
       standen sie als helle Kästen mit hellgrauem Rahmen gegen den dunklen Grund
       (jede andere Fläche der Seite nutzt #181E2E). Der Light-Mode-Look bleibt
       unverändert (weißer Grund, #e5e7eb-Rahmen = vormals border-gray-200), im
       Dark-Mode greifen jetzt Oberflächen- und Rahmen-Token wie überall sonst.
       Zusätzlich ersetzt ein sichtbarer Fokus-Ring (2px, Markenblau, 2px Offset –
       exakt das Muster aus global.css) den zuvor per focus:outline-none entfernten
       Fokus, der nur durch eine dezente 1px-Rahmenfarbe angedeutet war. Reiner
       Feinschliff: keine Marken-Hexcodes geändert. */
    .contact-field {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      color: var(--color-text);
    }
    .contact-field::placeholder { color: #9097A6; }
    .contact-field:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
      border-color: var(--color-primary);
    }
    html.dark .contact-field {
      background: #181E2E;
      border-color: rgba(90, 120, 255, 0.18);
    }
    html.dark .contact-field::placeholder { color: #656B78; }
  </style>

  <script>
    const form = document.getElementById('kontakt-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Fehler beim Senden. Bitte versuche es erneut.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Absenden';
        }
      } catch {
        errorMsg.textContent = 'Netzwerkfehler. Bitte versuche es erneut.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Absenden';
      }
    });
  </script>
</BaseLayout>
