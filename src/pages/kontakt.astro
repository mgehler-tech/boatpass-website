---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt – Boatpass"
  description="Kontaktiere das Boatpass-Team bei Fragen, Feedback oder technischen Problemen."
  lang="de"
  altUrl="https://boatpass.de/en/contact/"
  showCta={false}
>
  <div style="max-width:600px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        ✉️ Kontakt
      </div>
      <h1 style="font-size:42px; font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:12px;">Schreib uns</h1>
      <p style="font-size:16px; color:#6B7280;">Fragen, Feedback oder ein Bug gefunden? Wir freuen uns von dir zu hören.</p>
    </div>

    <div id="success-msg" style="display:none; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; border-radius:12px; padding:20px 24px; margin-bottom:24px; font-weight:500; font-size:1rem;">
      ✓ Nachricht erfolgreich gesendet! Das Team meldet sich so schnell wie möglich bei dir.
    </div>
    <div id="error-msg" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:12px; padding:16px 20px; margin-bottom:24px;"></div>

    <form id="kontakt-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Dein Name</label>
        <input type="text" id="name" name="name" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">E-Mail-Adresse</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Deine Nachricht</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Absenden
      </button>
    </form>
  </div>

  <script>
    const form = document.getElementById('kontakt-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Fehler beim Senden. Bitte versuche es erneut.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Absenden';
        }
      } catch {
        errorMsg.textContent = 'Netzwerkfehler. Bitte versuche es erneut.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Absenden';
      }
    });
  </script>
</BaseLayout>
