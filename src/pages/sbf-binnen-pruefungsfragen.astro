---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Binnen", "item": "https://boatpass.de/sbf-binnen/" },
    { "@type": "ListItem", "position": 3, "name": "Prüfungsfragen", "item": "https://boatpass.de/sbf-binnen-pruefungsfragen/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Schifffahrtsrecht', desc: 'Vorfahrtregeln, Lichterführung & Wasserstraßenordnung', count: 124, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation', desc: 'Karten, Kurse, Positionen & Peilungen', count: 52, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Sicherheit', desc: 'Rettungsausrüstung, Notsignale & Sicherheitsverhalten', count: 39, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signale & Zeichen', desc: 'Schallzeichen, Sichtzeichen & Flaggen', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Wetterkunde', desc: 'Wind, Wetter & Vorhersage', count: 5, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'Allgemein', desc: 'Allgemeine Grundlagen & Seemannschaft', count: 3, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
];

const faqs = [
  {
    q: 'Wie viele Fragen hat der SBF-Binnen-Fragenkatalog?',
    a: 'Der amtliche Fragenkatalog für den SBF Binnen unter Motor umfasst 72 Basisfragen und 181 spezifische Binnenfragen (zusammen 253 Fragen). Für den Geltungsbereich unter Segel kommen 47 Segelfragen hinzu. In der Prüfung werden daraus 30 Fragen gezogen (7 Basisfragen + 23 spezifische Fragen).',
  },
  {
    q: 'Wo finde ich die offiziellen SBF-Binnen-Prüfungsfragen?',
    a: 'Der vollständige Fragenkatalog wird von ELWIS (Elektronisches Wasserstraßen-Informations-System) kostenlos herausgegeben. In der Boatpass-App lernst du genau diese Fragen strukturiert nach Kategorien – inklusive Prüfungssimulation und Fehler-Training.',
  },
  {
    q: 'Sind die Fragen in der App identisch mit der echten Prüfung?',
    a: 'Ja. Die App enthält den vollständigen, aktuellen amtlichen ELWIS-Katalog. Du lernst exakt die Fragen, die auch in der echten Theorieprüfung gestellt werden – wird der Katalog aktualisiert, zieht die App zeitnah nach.',
  },
  {
    q: 'Wie viele Fragen muss ich richtig beantworten, um zu bestehen?',
    a: 'Bestanden hat, wer mindestens 5 von 7 Basisfragen und mindestens 18 von 23 spezifischen Fragen richtig beantwortet. Insgesamt hast du 45 Minuten Zeit.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Binnen Prüfungsfragen – offizieller Fragenkatalog üben"
  description="Alle SBF-Binnen-Prüfungsfragen aus dem offiziellen ELWIS-Katalog üben: Aufbau, Kategorien, Bestehensgrenze und wie du die 30 Prüfungsfragen effektiv lernst."
  lang="de"
  hasAlternate={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        SBF Binnen Prüfungsfragen
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        SBF Binnen Fragen –<br>offiziellen Katalog üben
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Über 250 amtliche ELWIS-Fragen, übersichtlich nach Kategorien sortiert. Lern mit echter Prüfungssimulation und gezieltem Fehler-Training – und geh sicher in die SBF-Binnen-Theorieprüfung.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Kostenlos Fragen üben
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">Auf den Punkt</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          Der amtliche SBF-Binnen-Fragenkatalog umfasst 253 Fragen (72 Basis- + 181 spezifische Binnenfragen), unter Segel kommen 47 Segelfragen hinzu. In der Theorieprüfung werden daraus 30 Fragen gezogen (7 Basis + 23 spezifische), die in 45 Minuten zu lösen sind. Bestanden hat, wer mindestens 5 von 7 Basisfragen und 18 von 23 spezifischen Fragen richtig beantwortet. Boatpass trainiert exakt diesen ELWIS-Katalog mit Prüfungssimulation und Fehler-Training.
        </p>
      </div>
    </section>

    <!-- Der Katalog -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Der offizielle SBF-Binnen-Fragenkatalog</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Die <strong>Prüfungsfragen für den SBF Binnen</strong> stammen aus dem amtlichen Fragenkatalog, den <strong>DSV und DMYV</strong> festlegen und der über <strong>ELWIS</strong> kostenlos veröffentlicht wird. Für den Geltungsbereich <strong>unter Motor</strong> umfasst er <strong>72 Basisfragen und 181 spezifische Binnenfragen</strong> (zusammen 253 Fragen). Wer zusätzlich <strong>unter Segel</strong> fahren möchte, lernt 47 weitere Segelfragen.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        In der echten Theorieprüfung wird daraus ein Bogen mit <strong>30 Fragen</strong> zusammengestellt – 7 Basisfragen und 23 spezifische Fragen. Wer den Katalog systematisch durcharbeitet, kennt am Prüfungstag jede mögliche Frage.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:14px;">
        Quelle: amtlicher Fragenkatalog (DSV/DMYV), kostenlos veröffentlicht über <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-neu-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
    </section>

    <!-- Aufbau der Prüfung -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">So ist die Theorieprüfung aufgebaut</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Prüfungsbogen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">30 Fragen · 45 Minuten<br>Multiple Choice</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basisfragen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 Fragen<br>mind. 5 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Spezifische Fragen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">23 Fragen<br>mind. 18 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Fragenkatalog</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">253 Fragen (Motor)<br>+ 47 Segelfragen</div>
        </div>
      </div>
    </section>

    <!-- Effektiv üben -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">SBF-Binnen-Fragen effektiv üben</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: 'book', title: 'Lernmodus: Kategorie für Kategorie', desc: 'Arbeite den kompletten Katalog strukturiert nach Themengebieten durch, in deinem Tempo. So bleibt kein Thema offen.' },
          { icon: 'target', title: 'Prüfungssimulation: 30 Fragen, 45 Minuten', desc: 'Übe unter echten Prüfungsbedingungen mit zufälligem Bogen und Bestehensgrenze – genau wie am Prüfungstag.' },
          { icon: 'refresh', title: 'Fehler-Training: nur deine Schwachstellen', desc: 'Wiederhole gezielt die Fragen, die du noch nicht sicher kannst, statt Zeit mit bereits Gelerntem zu verlieren.' },
          { icon: 'chart', title: 'Fortschritt im Blick', desc: 'Sieh nach Kategorie aufgeschlüsselt, wo du stehst und wann du prüfungsreif bist.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon as IconName} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Häufige Fragen zum Fragenkatalog</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <div style="font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</div>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">Lernen nach Kategorie</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        Der Fragenkatalog ist in Themengebiete unterteilt – übe gezielt nach Schwachstellen.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
            </div>
            <span style="font-size:12px; font-weight:700; color:#6B7280; background:rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.07); border-radius:100px; padding:3px 10px; flex-shrink:0; white-space:nowrap;">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h2 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Weiterführende Seiten</h2>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/sbf-binnen/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Binnen lernen: Überblick & App</a>
        <a href="/sbf-see-pruefungsfragen/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF See Prüfungsfragen üben</a>
        <a href="/sbf-pruefung-ablauf/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Prüfung: Ablauf von Theorie & Praxis</a>
        <a href="/sbf-kosten/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Was kostet der Sportbootführerschein?</a>
      </div>
    </section>

  </div>
</BaseLayout>
