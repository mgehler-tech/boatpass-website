---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import CatalogHubTopics from '../components/catalog/CatalogHubTopics.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Binnen", "item": "https://boatpass.de/sbf-binnen/" },
    { "@type": "ListItem", "position": 3, "name": "Prüfungsfragen", "item": "https://boatpass.de/sbf-binnen-pruefungsfragen/" },
  ],
};


const faqs = [
  {
    q: 'Wie viele Fragen hat der SBF-Binnen-Fragenkatalog?',
    a: 'Der amtliche Fragenkatalog für den SBF Binnen unter Motor umfasst 72 Basisfragen und 181 spezifische Binnenfragen (zusammen 253 Fragen). Für den Geltungsbereich unter Segel kommen 47 Segelfragen hinzu. In der Prüfung werden daraus 30 Fragen gezogen (7 Basisfragen + 23 spezifische Fragen).',
  },
  {
    q: 'Wo finde ich die offiziellen SBF-Binnen-Prüfungsfragen?',
    a: 'Der vollständige Fragenkatalog wird von ELWIS (Elektronisches Wasserstraßen-Informations-System) kostenlos herausgegeben. In der Boatpass-App lernst du genau diese Fragen strukturiert nach Kategorien – inklusive Prüfungssimulation und Fehlertraining.',
  },
  {
    q: 'Sind die Fragen in der App identisch mit der echten Prüfung?',
    a: 'Ja. Die App enthält den vollständigen, aktuellen amtlichen ELWIS-Katalog. Du lernst exakt die Fragen, die auch in der echten Theorieprüfung gestellt werden – wird der Katalog aktualisiert, zieht die App zeitnah nach.',
  },
  {
    q: 'Wie viele Fragen muss ich richtig beantworten, um zu bestehen?',
    a: 'Bestanden hat, wer mindestens 5 von 7 Basisfragen und mindestens 18 von 23 spezifischen Fragen richtig beantwortet. Insgesamt hast du 45 Minuten Zeit.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Binnen Prüfungsfragen – ELWIS-Katalog"
  description="Alle 300 SBF-Binnen-Prüfungsfragen aus dem amtlichen ELWIS-Katalog nach Themen, mit richtiger Antwort und Fragebogen online. Dazu Aufbau und Bestehensgrenze."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-inland-exam-questions/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="SBF Binnen Prüfungsfragen"
    lede="Alle 300 amtlichen ELWIS-Fragen, nach Themen sortiert und mit richtiger Antwort. Lern mit echter Prüfungssimulation und gezieltem Fehlertraining – und geh sicher in die SBF-Binnen-Theorieprüfung."
    ctaLabel="Kostenlos Fragen üben"
    cta
  >
    SBF Binnen Fragen –<br />offiziellen Katalog üben
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfBinnen"
      items={[
        { k: 'Fragenkatalog', v: '253 Fragen (72 Basis + 181 spezifisch)' },
        { k: 'Theorieprüfung', v: '30 Fragen · 45 Min' },
        { k: 'Basisfragen', v: '7, mind. 5 richtig' },
        { k: 'Spezifische Fragen', v: '23, mind. 18 richtig' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Der amtliche SBF-Binnen-Fragenkatalog umfasst 253 Fragen (72 Basis- + 181 spezifische Binnenfragen), unter Segel kommen 47 Segelfragen hinzu. In der Theorieprüfung werden daraus 30 Fragen gezogen (7 Basis + 23 spezifische), die in 45 Minuten zu lösen sind. Bestanden hat, wer mindestens 5 von 7 Basisfragen und 18 von 23 spezifischen Fragen richtig beantwortet. Boatpass trainiert exakt diesen ELWIS-Katalog mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Der Katalog -->
    <section class="pg-section">
      <h2 class="pg-h2">Der offizielle SBF-Binnen-Fragenkatalog</h2>
      <p class="pg-p">
        Die <strong>Prüfungsfragen für den SBF Binnen</strong> stammen aus dem amtlichen Fragen- und Antwortenkatalog, den das <strong>Bundesministerium für Digitales und Verkehr (BMDV)</strong> im Verkehrsblatt bekannt gemacht hat und der über <strong>ELWIS</strong> kostenlos veröffentlicht wird. Für den Geltungsbereich <strong>unter Motor</strong> umfasst er <strong>72 Basisfragen und 181 spezifische Binnenfragen</strong> (zusammen 253 Fragen). Wer zusätzlich <strong>unter Segel</strong> fahren möchte, lernt 47 weitere Segelfragen.
      </p>
      <p class="pg-p">
        In der echten Theorieprüfung wird daraus ein Bogen mit <strong>30 Fragen</strong> zusammengestellt – 7 Basisfragen und 23 spezifische Fragen. Wer den Katalog systematisch durcharbeitet, kennt am Prüfungstag jede mögliche Frage.
      </p>
      <p class="pg-note pg-note--sm pg-note--after">
        Quelle: amtlicher Fragenkatalog des BMDV, gültig seit 01.08.2023, kostenlos veröffentlicht über <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
    </section>

    <!-- Alle Fragen nach Themen (Prüfungsfragen-Hubs) -->
    <CatalogHubTopics lang="de" catalog="binnen" />

    <!-- Aufbau der Prüfung -->
    <section class="pg-section">
      <h2 class="pg-h2">So ist die Theorieprüfung aufgebaut</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Prüfungsbogen</p>
          <p class="pg-card-text">30 Fragen · 45 Minuten<br>Multiple Choice</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basisfragen</p>
          <p class="pg-card-text">7 Fragen<br>mind. 5 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Spezifische Fragen</p>
          <p class="pg-card-text">23 Fragen<br>mind. 18 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Fragenkatalog</p>
          <p class="pg-card-text">253 Fragen (Motor)<br>+ 47 Segelfragen</p>
        </div>
      </div>
    </section>

    <!-- Effektiv üben -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF-Binnen-Fragen effektiv üben</h2>
      <div class="pg-rows">
        {[
          { icon: 'book', title: 'Lernmodus: Kategorie für Kategorie', desc: 'Arbeite den kompletten Katalog strukturiert nach Themengebieten durch, in deinem Tempo. So bleibt kein Thema offen.' },
          { icon: 'target', title: 'Prüfungssimulation: 30 Fragen, 45 Minuten', desc: 'Übe unter echten Prüfungsbedingungen mit zufälligem Bogen und Bestehensgrenze – genau wie am Prüfungstag.' },
          { icon: 'refresh', title: 'Fehlertraining: nur deine Schwachstellen', desc: 'Wiederhole gezielt die Fragen, die du noch nicht sicher kannst, statt Zeit mit bereits Gelerntem zu verlieren.' },
          { icon: 'chart', title: 'Fortschritt im Blick', desc: 'Sieh nach Kategorie aufgeschlüsselt, wo du stehst und wann du prüfungsreif bist.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum Fragenkatalog</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>


    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Seiten</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen/">SBF Binnen lernen: Überblick & App<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see-pruefungsfragen/">SBF See Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/schwierigste-sbf-pruefungsfragen/">Die schwierigsten SBF-Prüfungsfragen – und wie du sie meisterst<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/haeufigste-fehler-sbf/">Die häufigsten Fehler bei der SBF-Prüfung vermeiden<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
