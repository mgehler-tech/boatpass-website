---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import BoatSchoolFinder from '../components/BoatSchoolFinder.astro';
import type { IconName } from '../icons';
import { PLAY_STORE_URL, schemaOffers } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF See", "item": "https://boatpass.de/sbf-see/" },
  ],
};

const faqs = [
  {
    q: 'Wo gilt der SBF See?',
    a: 'Der SBF See berechtigt zur Fahrt auf den Seeschifffahrtsstraßen – den Küstengewässern von Nord- und Ostsee bis drei Seemeilen vor der Festlandküste, den Fahrwassern innerhalb der Zwölf-Seemeilen-Zone sowie den seewärtigen Mündungsbereichen von Ems, Weser, Elbe, Trave und Warnow und dem Nord-Ostsee-Kanal. Anders als beim SBF Binnen gibt es keine Begrenzung der Bootslänge.',
  },
  {
    q: 'Wie läuft die SBF-See-Theorieprüfung ab?',
    a: 'Die Theorie besteht aus einem Fragebogen mit 30 Multiple-Choice-Fragen (7 Basisfragen + 23 spezifische See-Fragen) und zusätzlich einer Navigationsaufgabe mit 9 Einzelfragen – insgesamt 60 Minuten Zeit. Bestanden ist die Prüfung mit mindestens 23 von 30 richtigen Antworten im Fragebogen (5 von 7 Basisfragen UND 18 von 23 spezifischen Fragen – beide Blöcke werden separat gewertet) und mindestens 7 von 9 richtigen Antworten in der Navigationsaufgabe.',
  },
  {
    q: 'Was ist die Navigationsaufgabe?',
    a: 'In der Navigationsaufgabe arbeitest du mit einer amtlichen Übungsseekarte: Kurse abtragen, den eigenen Standort bestimmen, Wind- und Stromversatz berücksichtigen und Gezeiten einrechnen. Sie gilt als anspruchsvollster Teil der Prüfung – deshalb übst du sie bei Boatpass gezielt und getrennt vom Fragebogen.',
  },
  {
    q: 'Welche Voraussetzungen muss ich erfüllen?',
    a: 'Das Mindestalter für den SBF See unter Motor beträgt 16 Jahre. Eine Fahrschule ist nicht vorgeschrieben – der offizielle ELWIS-Fragenkatalog ist frei verfügbar, sodass du die Theorie eigenständig lernen kannst. Für die Praxis wird mindestens ein Übungstag auf dem Wasser empfohlen.',
  },
  {
    q: 'Lohnt sich die Kombination mit dem SBF Binnen?',
    a: 'Ja. Wer Binnen und See zusammen in einer kombinierten Prüfung ablegt, zahlt mit rund 178,61 € deutlich weniger als für zwei Einzelprüfungen (130,78 € + 148,38 €). Viele Basisfragen sind identisch, sodass sich der Lernaufwand für beide Scheine stark überschneidet.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist der SBF See?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SBF See",
  "alternateName": "Sportbootführerschein See",
  "description": "Der Sportbootführerschein See (SBF See) berechtigt zur Fahrt auf Seeschifffahrtsstraßen – Nord- und Ostsee innerhalb der 3-Seemeilen-Zone. Er ist die Voraussetzung für das Führen von Sportbooten im deutschen Küstenbereich.",
  "url": "https://boatpass.de/sbf-see/",
  "inLanguage": "de",
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für den SBF See
// (zusätzlich zur App-Auszeichnung). Alle Angaben spiegeln den Seiteninhalt.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF See Prüfungsvorbereitung",
  "description": "Komplette Vorbereitung auf die theoretische Prüfung zum Sportbootführerschein See mit dem vollständigen amtlichen ELWIS-Fragenkatalog, Prüfungssimulation und gezieltem Training der Navigationsaufgabe (Kartenarbeit).",
  "url": "https://boatpass.de/sbf-see/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Seeschifffahrtsrecht und Kollisionsverhütungsregeln",
    "Schifffahrtszeichen und Lichterführung",
    "Navigation und Seekartenarbeit",
    "Gezeiten und Stromversatz",
    "Amtlicher SBF-See-Fragenkatalog inkl. Navigationsaufgabe",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT15H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('sbfSee'),
};

// Direktvergleich Binnen vs. See als Entscheidungshilfe
const compare = [
  { label: 'Revier', binnen: 'Flüsse, Kanäle & Binnenseen', see: 'Küstengewässer Nord- & Ostsee' },
  { label: 'Pflicht ab', binnen: '11,03 kW (15 PS)', see: '11,03 kW (15 PS)' },
  { label: 'Bootslänge', binnen: 'unter Motor max. 20 m', see: 'keine Begrenzung' },
  { label: 'Theorieprüfung', binnen: '30 Fragen · 45 Min', see: '30 Fragen + Navigation · 60 Min' },
  { label: 'Navigationsaufgabe', binnen: '–', see: 'ja (Kartenaufgabe)' },
  { label: 'Prüfungsgebühr 2026', binnen: '130,78 €', see: '148,38 €' },
  { label: 'Mindestalter', binnen: '16 Jahre', see: '16 Jahre' },
];

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Schifffahrtsrecht', desc: 'Vorfahrtregeln, Lichterführung & Kollisionsverhütungsregeln', count: 130, icon: 'scale' },
  { name: 'Navigation & Seekarte', desc: 'Kartenarbeit, Kurse, Gezeiten & Strom', count: 72, icon: 'compass' },
  { name: 'Sicherheit', desc: 'Rettungsausrüstung, Notsignale & Sicherheitsverhalten', count: 40, icon: 'shield' },
  { name: 'Signale & Zeichen', desc: 'Schall-, Sicht- und Seezeichen', count: 28, icon: 'bell' },
  { name: 'Wetterkunde', desc: 'Wind, Wetter, Gezeitentafel & Vorhersage', count: 10, icon: 'cloud' },
  { name: 'Allgemein', desc: 'Allgemeine Grundlagen & Seemannschaft', count: 5, icon: 'document' },
  { name: 'Navigationsaufgaben', desc: '15 Kartenaufgaben à 9 Fragen: Kurse, Standort, Gezeiten & Stromversatz', count: 135, icon: 'target' },
];
---

<BaseLayout
  title="SBF See lernen – Sportbootführerschein See App"
  description="Lerne für den SBF See mit der Boatpass-App: offizieller ELWIS-Fragenkatalog, realistische Prüfungssimulation & Navigationsaufgaben. Kostenlos starten."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-coastal/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Sportbootführerschein See"
    lede="Bereite dich mit dem offiziellen ELWIS-Fragenkatalog auf die SBF-See-Prüfung vor. Inklusive Navigationsprüfung – mit Prüfungssimulation und gezieltem Fehlertraining."
    cta
  >
    SBF See lernen –<br />die smarte Lernapp
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfSee"
      items={[
        { k: 'Theorieprüfung', v: '39 Fragen · 60 Min' },
        { k: 'Navigationsaufgabe', v: '9 Fragen, mind. 7 richtig' },
        { k: 'Bestehensgrenze', v: '5 von 7 Basis, 18 von 23 spezifisch' },
        { k: 'Prüfungsgebühr 2026', v: '148,38 €' },
        { k: 'Mindestalter', v: '16 Jahre' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Der SBF See (Sportbootführerschein See) ist die amtliche Fahrerlaubnis für Sportboote auf den Seeschifffahrtsstraßen von Nord- und Ostsee. Die Theorieprüfung umfasst 39 Fragen in 60 Minuten: einen Fragebogen mit 30 Fragen (mind. 5 von 7 Basis- und 18 von 23 spezifischen Fragen richtig) sowie eine Navigationsaufgabe mit 9 Fragen (mind. 7 richtig). Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog See; Boatpass trainiert alle Inhalte inklusive Navigation mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist SBF See -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist der SBF See?</h2>
      <p class="pg-p">
        Der <strong>Sportbootführerschein See (SBF See)</strong> berechtigt zur Fahrt auf Seeschifffahrtsstraßen – Nord- und Ostsee innerhalb der 3-Seemeilen-Zone. Er ist die Voraussetzung für das Führen von Sportbooten im deutschen Küstenbereich und Grundlage für den <strong>ICC (International Certificate of Competence)</strong>.
      </p>
      <p class="pg-p">
        Der SBF See kann separat oder kombiniert mit dem SBF Binnen erworben werden. Die Kombination ist in einer gemeinsamen Prüfung möglich und günstiger als zwei Einzelprüfungen.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section class="pg-section">
      <CatalogSources lang="de" only="see" />
    </section>

    <!-- Prüfungsaufbau -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF-See-Prüfung: Aufbau & Bestehensgrenze</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theorieprüfung</p>
          <p class="pg-card-text">39 Fragen · 60 Minuten<br>inkl. Navigation</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basisfragen</p>
          <p class="pg-card-text">7 Fragen<br>mind. 5 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Navigationsfragen</p>
          <p class="pg-card-text">9 Fragen<br>mind. 7 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Fragenkatalog</p>
          <p class="pg-card-text">Offizieller<br>ELWIS-Katalog See</p>
        </div>
      </div>
      <p class="pg-note">
        Der SBF See beinhaltet eine <strong>Navigationsaufgabe</strong> – das ist der anspruchsvollste Teil der Prüfung. Boatpass trainiert alle Fragentypen gezielt. Die amtliche Prüfungsgebühr beträgt 2026 <strong>148,38 €</strong> (Theorie + Praxis).
      </p>
    </section>

    <!-- Praxis-Brücke: Kartenaufgaben digital meistern -->
    <PracticeBridge variant="navigation" />

    <!-- Ablauf: Praxis & Anmeldung -->
    <section class="pg-section">
      <h2 class="pg-h2">Ablauf: von der Anmeldung bis zur Praxis</h2>
      <p class="pg-p">
        Du meldest dich bei einem anerkannten Prüfungsausschuss (z. B. DMYV) an. Zuerst legst du die Theorieprüfung inkl. Navigationsaufgabe ab, danach folgt die <strong>praktische Prüfung</strong> auf dem Wasser.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Anmeldung</p>
          <p class="pg-card-text">Antrag beim Prüfungsausschuss, Passbild und Ausweis – Mindestalter 16 Jahre.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Praktische Manöver</p>
          <p class="pg-card-text">An- und Ablegen, Wenden, Aufstoppen und das Mann-über-Bord-Manöver.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title"><a href="/blog/wichtigste-knoten-sbf/" class="pg-card-link">Knoten</a></p>
          <p class="pg-card-text">Die prüfungsrelevanten Knoten zügig anwenden (z. B. Palstek, Webeleinstek, Klampe).</p>
        </div>
      </div>
      <PageLink lang="de" href="/sbf-pruefung-ablauf/">Prüfungsablauf Schritt für Schritt</PageLink>
    </section>

    <!-- Bootsfahrschule finden -->
    <BoatSchoolFinder lang="de" variant="see" />

    <!-- Kosten kompakt -->
    <section class="pg-section">
      <h2 class="pg-h2">Was kostet der SBF See?</h2>
      <p class="pg-p">
        Fest ist nur die amtliche <strong>Prüfungsgebühr von 148,38 €</strong> (Theorie + Praxis). Den größten Kostenblock macht der Vorbereitungskurs aus – wer die Theorie selbst mit dem offiziellen ELWIS-Katalog lernt, spart genau diesen Posten.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-kpi">148,38 €</p>
          <p class="pg-card-text">Amtliche Prüfungsgebühr</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi">≈ 500–650 €</p>
          <p class="pg-card-text">Kompletter Kurs (optional)</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">ab 9,99 €</p>
          <p class="pg-card-text">Theorie lernen mit Boatpass</p>
        </div>
      </div>
      <PageLink lang="de" href="/sbf-kosten/">Alle SBF-Kosten im Detail</PageLink>
    </section>

    <!-- Geltungsbereich -->
    <section class="pg-section">
      <h2 class="pg-h2">Wo darf ich mit dem SBF See fahren?</h2>
      <p class="pg-p">
        Der SBF See gilt auf den <strong>Seeschifffahrtsstraßen</strong>: den Küstengewässern von Nord- und Ostsee bis drei Seemeilen vor der Festlandküste, den Fahrwassern innerhalb der Zwölf-Seemeilen-Zone sowie den seewärtigen Mündungen von Ems, Weser, Elbe, Trave und Warnow und dem Nord-Ostsee-Kanal. Eine Begrenzung der Bootslänge gibt es – anders als beim SBF Binnen – nicht.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Wo er gilt</p>
          <p class="pg-card-text">Küstengewässer von Nord- und Ostsee, Mündungsbereiche und Nord-Ostsee-Kanal.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Voraussetzungen</p>
          <p class="pg-card-text">Mindestalter 16 Jahre unter Motor. Grundlage für das internationale Zertifikat ICC.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Besonderheit</p>
          <p class="pg-card-text">Zusätzliche Navigationsaufgabe mit Seekarte, Kursberechnung und Gezeiten.</p>
        </div>
      </div>
    </section>

    <!-- Vergleich Binnen vs. See -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF See oder Binnen – was brauchst du?</h2>
      <p class="pg-p">
        See und Binnen sind zwei eigenständige Scheine. Wer beide Reviere befahren will, kann sie in einer
        <strong>kombinierten Prüfung</strong> günstiger zusammen ablegen (rund 178,61 € statt zweimal einzeln).
      </p>
      <!-- min-width aktiviert das horizontale Scrollen des overflow-x-Wrappers auf schmalen Screens (wie AppComparisonTable/CatalogSources). Ohne min-width wurde die Tabelle stattdessen auf Handybreite gequetscht: die drei Spalten brachen mehrzeilig um und wurden unleserlich. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">SBF Binnen</th>
              <th scope="col">SBF See</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.binnen}</td>
                <td>{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <PageLink lang="de" href="/sbf-binnen/" class="pg-link--spaced">SBF Binnen im Detail ansehen</PageLink>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum SBF See</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-card">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der offizielle ELWIS-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten (inkl. 15 Navigationsaufgaben à 9 Fragen) – übe gezielt nach Schwachstellen.
      </p>
      <p class="pg-note pg-note--sm">
        Quelle: amtlicher Fragenkatalog (DSV/DMYV) auf <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Wie die App hilft -->
    <section class="pg-section">
      <h2 class="pg-h2">So hilft Boatpass beim SBF See</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Vollständiger ELWIS-Katalog See', desc: 'Alle offiziellen Fragen für den SBF See – inklusive Navigation – immer auf aktuellem Stand.' },
          { icon: 'compass', title: 'Navigationsfragen gezielt üben', desc: 'Die Navigationsaufgaben sind der schwierigste Teil. Boatpass trainiert sie separat.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Echte Prüfungsbedingungen: 39 Fragen, 60 Minuten, getrennte Bestehensgrenze – genau wie am Prüfungstag.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Nur die Fragen üben, die du noch nicht kennst – keine Zeit verschwenden.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Artikel</h2>
      <ul class="pg-related">
        <li><a href="/sbf-see-pruefungsfragen/">SBF See Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see-app/">SBF-See-Apps im Vergleich<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-binnen-vs-see/">SBF Binnen vs. SBF See – was ist der Unterschied?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-vorbereitung-wie-lange/">Wie lange muss ich für den SBF lernen?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/richtig-ankern-grundlagen-ankerarten-fehler/">Richtig ankern – Grundlagen, Ankerarten und häufige Fehler<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/seekarte-lesen-lernen/">Seekarte lesen lernen – Symbole, Tiefenangaben und Maßstäbe<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/kursumrechnung-sbf-see/">Kursumrechnung beim SBF See: rwK, mwK & MgK einfach erklärt<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/gezeiten-zwoelftelregel/">Gezeiten berechnen mit der Zwölftelregel – einfach erklärt<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/stroemung-tide-toernplanung-grundlagen/">Strömung und Tide praktisch nutzen – Grundlagen der Törnplanung<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/gps-kartenplotter-funkgeraet-moderne-navigation/">GPS, Kartenplotter und Funkgerät – moderne Navigation an Bord verstehen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/peilung-kollisionskurs-cpa-erklaert/">Peilung und Kollisionskurs erkennen – CPA einfach erklärt<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
