---
import BaseLayout from '../layouts/BaseLayout.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<BaseLayout
  title="SBF See lernen – Sportbootführerschein See App"
  description="Lerne für den SBF See mit der Boatpass-App. Offizieller ELWIS-Fragenkatalog, Prüfungssimulation & Navigation. Kostenlos starten."
  lang="de"
>

  <!-- Hero -->
  <div style="background:#f7faff; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(8,145,178,0.08); border:1px solid rgba(8,145,178,0.2); color:#0891b2; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        🌊 Sportbootführerschein See
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#0a2647; line-height:1.1; margin-bottom:20px;">
        SBF See lernen –<br>die smarte Lernapp
      </h1>
      <p style="font-size:18px; color:#64748b; line-height:1.65; max-width:560px; margin:0 auto 36px;">
        Bereite dich mit dem offiziellen ELWIS-Fragenkatalog auf die SBF-See-Prüfung vor.
        Inklusive Navigationsprüfung — mit Prüfungssimulation und gezieltem Fehler-Training.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#0a2647,#0c5f9b); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(10,38,71,0.2);">
        ▶&nbsp;Kostenlos im Play Store
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Was ist SBF See -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#0a2647; letter-spacing:-1px; margin-bottom:16px;">Was ist der SBF See?</h2>
      <p style="font-size:16px; color:#475569; line-height:1.75; margin-bottom:12px;">
        Der <strong>Sportbootführerschein See (SBF See)</strong> berechtigt zur Fahrt auf Seeschifffahrtsstraßen — Nord- und Ostsee innerhalb der 3-Seemeilen-Zone. Er ist die Voraussetzung für das Führen von Sportbooten im deutschen Küstenbereich und Grundlage für den <strong>ICC (International Certificate of Competence)</strong>.
      </p>
      <p style="font-size:16px; color:#475569; line-height:1.75;">
        Der SBF See kann separat oder kombiniert mit dem SBF Binnen erworben werden. Die Kombination ist in einer gemeinsamen Prüfung möglich und günstiger als zwei Einzelprüfungen.
      </p>
    </section>

    <!-- Prüfungsaufbau -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#0a2647; letter-spacing:-1px; margin-bottom:20px;">SBF-See-Prüfung: Aufbau & Bestehensgrenze</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(12,95,155,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#0891b2; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theorieprüfung</div>
          <div style="font-size:15px; color:#475569; line-height:1.6;">39 Fragen · 60 Minuten<br>inkl. Navigation</div>
        </div>
        <div style="background:white; border:1px solid rgba(12,95,155,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#0891b2; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basisfragen</div>
          <div style="font-size:15px; color:#475569; line-height:1.6;">7 Fragen<br>mind. 5 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(12,95,155,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#0891b2; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Navigationsfragen</div>
          <div style="font-size:15px; color:#475569; line-height:1.6;">9 Fragen<br>mind. 7 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(12,95,155,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#0891b2; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Fragenkatalog</div>
          <div style="font-size:15px; color:#475569; line-height:1.6;">Offizieller<br>ELWIS-Katalog See</div>
        </div>
      </div>
      <p style="font-size:15px; color:#64748b; line-height:1.7;">
        Der SBF See beinhaltet eine <strong>Navigationsaufgabe</strong> — das ist der anspruchsvollste Teil der Prüfung. Boatpass trainiert alle Fragentypen gezielt.
      </p>
    </section>

    <!-- SBF Binnen vs See -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#0a2647; letter-spacing:-1px; margin-bottom:16px;">SBF See vs. SBF Binnen: Was brauchst du?</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:white; border:2px solid rgba(8,145,178,0.2); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#0a2647; margin-bottom:12px;">SBF Binnen</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#475569; line-height:1.8;">
            <li>✓ Flüsse & Kanäle</li>
            <li>✓ Binnenseen</li>
            <li>✗ Nordsee / Ostsee</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(8,145,178,0.2); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#0a2647; margin-bottom:12px;">SBF See</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#475569; line-height:1.8;">
            <li>✓ Nord- & Ostsee</li>
            <li>✓ Küstengewässer</li>
            <li>✓ Basis für ICC</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Wie die App hilft -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#0a2647; letter-spacing:-1px; margin-bottom:20px;">So hilft Boatpass beim SBF See</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: '📚', title: 'Vollständiger ELWIS-Katalog See', desc: 'Alle offiziellen Fragen für den SBF See — inklusive Navigation — immer auf aktuellem Stand.' },
          { icon: '🧭', title: 'Navigationsfragen gezielt üben', desc: 'Die Navigationsaufgaben sind der schwierigste Teil. Boatpass trainiert sie separat.' },
          { icon: '🎯', title: 'Prüfungssimulation', desc: 'Echte Prüfungsbedingungen: 39 Fragen, 60 Minuten, getrennte Bestehensgrenze — genau wie am Prüfungstag.' },
          { icon: '🔁', title: 'Fehler-Training', desc: 'Nur die Fragen üben, die du noch nicht kennst — keine Zeit verschwenden.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(12,95,155,0.1); border-radius:16px; padding:20px;">
            <span style="font-size:24px; flex-shrink:0;">{f.icon}</span>
            <div>
              <div style="font-weight:700; color:#0a2647; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#64748b; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:linear-gradient(135deg,#0a2647,#0c5f9b); border-radius:24px; padding:48px 32px; text-align:center;">
      <h2 style="font-size:26px; font-weight:800; color:white; margin-bottom:12px;">Jetzt mit dem SBF See starten</h2>
      <p style="font-size:16px; color:rgba(255,255,255,0.75); margin-bottom:28px;">SBF See Vollzugang für einmalig 4,99 € — kein Abo, kein Account nötig.</p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:white; color:#0a2647; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none;">
        ▶&nbsp;Im Google Play Store öffnen
      </a>
    </section>

    <!-- Interne Links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(12,95,155,0.1);">
      <h3 style="font-size:16px; font-weight:700; color:#0a2647; margin-bottom:16px;">Weiterführende Artikel</h3>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/blog/sbf-binnen-vs-see/" style="color:#0891b2; text-decoration:none; font-size:15px;">→ SBF Binnen vs. SBF See – was ist der Unterschied?</a>
        <a href="/blog/sbf-pruefung-alles-wissenswerte/" style="color:#0891b2; text-decoration:none; font-size:15px;">→ SBF Prüfung: Alles was du wissen musst</a>
        <a href="/blog/sbf-vorbereitung-wie-lange/" style="color:#0891b2; text-decoration:none; font-size:15px;">→ Wie lange muss ich für den SBF lernen?</a>
        <a href="/faq/" style="color:#0891b2; text-decoration:none; font-size:15px;">→ Häufige Fragen zum Sportbootführerschein</a>
        <a href="/sbf-binnen/" style="color:#0891b2; text-decoration:none; font-size:15px;">→ SBF Binnen lernen mit Boatpass</a>
      </div>
    </section>

  </div>
</BaseLayout>
