---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBoot from '../components/home/HomeBoot.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeNavtex from '../components/home/HomeNavtex.astro';
import HomeJourney from '../components/home/HomeJourney.astro';
import HomeReviews from '../components/home/HomeReviews.astro';
import HomeFounder from '../components/home/HomeFounder.astro';
import HomePricing from '../components/home/HomePricing.astro';
import HomeCatalogs from '../components/home/HomeCatalogs.astro';
import HomeGuide from '../components/home/HomeGuide.astro';
import HomeFinalCta from '../components/home/HomeFinalCta.astro';
import { getBoatpassRating } from '../data/apps';
import '../styles/home.css';
// Display-Schrift der Startseite vorladen (nur das lateinische Subset, das
// DE/EN tatsächlich braucht) – die H1 im Hero ist das größte Element.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

const appRating = getBoatpassRating();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Boatpass",
  "alternateName": "Boatpass – Sportbootführerschein App",
  "url": "https://boatpass.de",
  "inLanguage": "de-DE",
  "publisher": { "@type": "Organization", "name": "Boatpass", "url": "https://boatpass.de" },
};

const faqs = [
  {
    q: 'Was ist der Sportbootführerschein (SBF)?',
    a: 'Der Sportbootführerschein (SBF) ist die amtliche Fahrerlaubnis für motorisierte Sportboote in Deutschland – je nach Revier als SBF Binnen oder SBF See. Nachgewiesen wird er in einer Theorie- und einer Praxisprüfung nach dem amtlichen ELWIS-Fragenkatalog von DSV und DMYV.',
  },
  {
    q: 'Was ist der Unterschied zwischen SBF Binnen und SBF See?',
    a: 'Der SBF Binnen berechtigt zum Führen von Sportbooten auf Binnenschifffahrtsstraßen, der SBF See auf Seeschifffahrtsstraßen und im Küstenbereich. Die Prüfung SBF See enthält zusätzlich eine Navigationsaufgabe mit 9 Fragen, die beim SBF Binnen entfällt.',
  },
  {
    q: 'Was kostet der Sportbootführerschein?',
    a: 'Die amtlichen Prüfungsgebühren liegen bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Mit Vorbereitungskurs kommen 2026 meist 500–650 € pro Schein zusammen – wer die Theorie selbst mit einer App lernt, spart die Kursgebühr.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Sportbootführerschein App: SBF Binnen & See"
  description="Die beste SBF Lernapp für Sportbootführerschein Binnen und See. Offizielle ELWIS-Prüfungsfragen, Prüfungssimulation & Fehlertraining. Kostenlos starten."
  lang="de"
  appRating={appRating}
  showCta={false}
>
  <Fragment slot="head">
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <HomeBoot />
  <!-- Seitenfluss als Route: Ablegen (Hero) → vier Etappen (Lernweg) → Vertrauen
       (Rezensionen, Gründer) → Lizenz & Preis → Nachprüfen (amtliche Kataloge)
       → Fragen & Ratgeber → Hafen (Download). Der Schein-Finder hängt direkt
       an der Preisauswahl, wo die Frage „welcher Schein?" entsteht. -->
  <div class="home">
    <HomeHero lang="de" />
    <HomeNavtex lang="de" />
    <HomeJourney lang="de" num="01" />
    <HomeReviews num="02" />
    <HomeFounder lang="de" num="03" />
    <HomePricing lang="de" num="04" />
    <HomeCatalogs lang="de" num="05" />
    <HomeGuide lang="de" num="06" faqs={faqs} />
    <HomeFinalCta lang="de" num="07" />
  </div>
</BaseLayout>

<script>
  import '../scripts/home-motion';
</script>
