---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import LearningSteps from '../components/LearningSteps.astro';
import FounderNote from '../components/FounderNote.astro';
import Reviews from '../components/Reviews.astro';
import PricingSection from '../components/PricingSection.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import FinderTeaser from '../components/FinderTeaser.astro';
import { getBoatpassRating } from '../data/apps';

const appRating = getBoatpassRating();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Boatpass",
  "alternateName": "Boatpass – Sportbootführerschein App",
  "url": "https://boatpass.de",
  "inLanguage": "de-DE",
  "publisher": { "@type": "Organization", "name": "Boatpass", "url": "https://boatpass.de" },
};

const faqs = [
  {
    q: 'Was ist der Sportbootführerschein (SBF)?',
    a: 'Der Sportbootführerschein (SBF) ist die amtliche Fahrerlaubnis für motorisierte Sportboote in Deutschland – je nach Revier als SBF Binnen oder SBF See. Nachgewiesen wird er in einer Theorie- und einer Praxisprüfung nach dem amtlichen ELWIS-Fragenkatalog von DSV und DMYV.',
  },
  {
    q: 'Was ist der Unterschied zwischen SBF Binnen und SBF See?',
    a: 'Der SBF Binnen berechtigt zum Führen von Sportbooten auf Binnenschifffahrtsstraßen, der SBF See auf Seeschifffahrtsstraßen und im Küstenbereich. Die Prüfung SBF See enthält zusätzlich eine Navigationsaufgabe mit 9 Fragen, die beim SBF Binnen entfällt.',
  },
  {
    q: 'Was kostet der Sportbootführerschein?',
    a: 'Die amtlichen Prüfungsgebühren liegen bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Mit Vorbereitungskurs kommen 2026 meist 500–650 € pro Schein zusammen – wer die Theorie selbst mit einer App lernt, spart die Kursgebühr.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Sportbootführerschein App: SBF Binnen & See"
  description="Die beste SBF Lernapp für Sportbootführerschein Binnen und See. Offizielle ELWIS-Prüfungsfragen, Prüfungssimulation & Fehlertraining. Kostenlos starten."
  lang="de"
  appRating={appRating}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Reihenfolge: erst das Produkt, dann die Person dahinter, dann Belege,
       dann der Preis. Der Führerschein-Finder stand bisher zwischen Features
       und Preisen und unterbrach damit die Produktvorstellung; er sitzt jetzt
       hinter der Kaufentscheidung, wo er als Umweg auch hingehört. -->
  <HeroSection lang="de" />
  <LearningSteps lang="de" />
  <FounderNote lang="de" />
  <Reviews lang="de" />
  <!-- withProof: die amtlichen Quellen ("Nachprüfen") laufen jetzt als
       dritte Unter-Gruppe INNERHALB der Preis-Sektion – eine Band statt
       zwei Sektionen. withSourceNote bleibt aus, sonst stünde der Hinweis
       doppelt (kurz oben, ausführlich im eingebetteten Quellen-Block). -->
  <PricingSection lang="de" withGuarantee withSourceNote={false} withProof />
  <FinderTeaser lang="de" />
  <BlogTeaser lang="de" />

  <div class="home-faq section-band">
    <section>
      <span class="section-eyebrow" style="margin-bottom:14px;">FAQ</span>
      <h2 class="section-display-title" style="margin-bottom:24px;">Häufig gestellte Fragen</h2>
      <!-- Akkordeon wie auf /faq/. Ausgeschrieben brauchten die drei Antworten
           auf dem Handy 1201 px, also 9 % der Seitenhöhe – gelesen werden sie
           dort ohnehin gezielt und nicht am Stück. Die Antworten bleiben im
           DOM, das FAQPage-Schema oben ist davon unberührt. -->
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <details class="faq-item home-faq-item">
            <summary class="home-faq-q">
              <h3>{f.q}</h3>
              <span class="home-faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="home-faq-a">{f.a}</div>
          </details>
        ))}
      </div>
      <p style="font-size:15px; color:#656B78; line-height:1.7; margin-top:16px;">
        Weitere Antworten findest du in den <a href="/faq/" style="color:#3366FF; text-decoration:underline;">häufigen Fragen zum Sportbootführerschein</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* Akkordeon der Startseiten-FAQ. Übernimmt Rahmen und Radius von .faq-item
     auf /faq/, damit beide Seiten gleich aussehen. */
  .home-faq-item {
    background: #fff;
    border: 1px solid rgba(51, 102, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }
  .home-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    /* WCAG 2.5.5: sichere Treffergröße */
    min-height: 56px;
  }
  .home-faq-q::-webkit-details-marker { display: none; }
  .home-faq-q h3 {
    font-size: 16px;
    font-weight: 700;
    color: #1A1F36;
    margin: 0;
    line-height: 1.4;
  }
  .home-faq-q:focus-visible { outline: 2px solid #3366FF; outline-offset: -2px; }

  /* Chevron per CSS statt Zeichen: dreht beim Öffnen. */
  .home-faq-icon {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-right: 2px solid #3366FF;
    border-bottom: 2px solid #3366FF;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s ease;
  }
  .home-faq-item[open] .home-faq-icon {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .home-faq-a {
    padding: 0 22px 22px;
    font-size: 15px;
    color: #656B78;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq-icon { transition: none; }
  }

  html.dark .home-faq-item {
    background: #181E2E;
    border-color: rgba(90, 120, 255, 0.12);
  }
  html.dark .home-faq-q h3 { color: #E2E8F0; }
  html.dark .home-faq-a { color: #94A3B8; }
</style>
