---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';
import { priceText } from '../../data/stores';

const available = [
  {
    icon: 'waves' as IconName,
    title: 'SBF Inland',
    tag: 'Rivers, canals & lakes',
    desc: 'The boating license for inland waters – rivers, canals and lakes. Required for motorboats above 15 HP.',
    href: '/en/sbf-inland/',
  },
  {
    icon: 'sailboat' as IconName,
    title: 'SBF Coastal',
    tag: 'North & Baltic Sea',
    desc: 'The license for coastal waters of the North and Baltic Sea. Its own exam with a navigation task.',
    href: '/en/sbf-coastal/',
  },
  {
    icon: 'banknotes' as IconName,
    title: 'SBF Costs',
    tag: 'Fees & saving tips',
    desc: 'Exam fees, courses and practice at a glance – and how to save money while studying.',
    href: '/en/sbf-costs/',
  },
  {
    icon: 'document' as IconName,
    title: 'Exam & Process',
    tag: 'Theory & practice',
    desc: 'How the theory and practical exams work, how to register and what counts on exam day.',
    href: '/en/sbf-exam/',
  },
  {
    icon: 'phone' as IconName,
    title: 'UBI',
    tag: 'VHF radio (inland)',
    desc: 'The VHF radio certificate for inland navigation – now a module in the app, a one-time ' + priceText('ubi', 'en') + '.',
    href: '/en/ubi/',
  },
  {
    icon: 'satellite' as IconName,
    title: 'SRC',
    tag: 'Marine radio (coastal)',
    desc: 'Short Range Certificate – VHF marine radio with DSC for the coastal area. A module in the app, one-time ' + priceText('src', 'en') + '.',
    href: '/en/src/',
  },
  {
    icon: 'globe' as IconName,
    title: 'LRC',
    tag: 'Marine radio (worldwide)',
    desc: 'Long Range Certificate – the general operator\'s certificate for worldwide marine radio. A module in the app, one-time ' + priceText('lrc', 'en') + '.',
    href: '/en/lrc/',
  },
];

const soon = [
  { icon: 'anchor' as IconName, title: 'Lake Constance Licence', desc: 'Mandatory licence for Lake Constance.', href: null },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "Licenses", "item": "https://boatpass.de/en/licenses/" },
  ],
};

const faqs = [
  {
    q: 'Which boating license do I need?',
    a: "It depends on the waters and engine power: for rivers, canals and lakes above 15 HP you need the SBF Inland, for the North and Baltic Sea coast the SBF Coastal. If there's a radio on board, UBI, SRC or LRC may also apply depending on the area. The free finder above shows you the right combination in 3 questions.",
  },
  {
    q: 'How much does a boating license cost?',
    a: 'The official exam fees in 2026 are €130.78 for the SBF Inland and €148.38 for the SBF Coastal. A full preparation course usually adds €500–650 per license; learning the theory yourself – for example with Boatpass at €9.99 per catalog – saves most of that.',
  },
  {
    q: 'Do I have to take a course for the boating license?',
    a: "No, a course isn't required for the theory exam. The official ELWIS question catalog is freely available, so you can study on your own – for example with an app like Boatpass. For the practical exam, some hands-on practice on the water is still a good idea.",
  },
  {
    q: 'Do I also need a radio certificate?',
    a: 'Only if there is a radio on board: UBI covers inland waters, SRC covers short-range coastal radio, and LRC covers worldwide marine radio. Without a radio on board, no additional certificate is required.',
  },
  {
    q: 'Can I operate a boat without a license at all?',
    a: 'Yes, a charter certificate lets you operate a rented boat without an SBF on designated inland waters such as the Mecklenburg Lake District. Boats up to 15 HP can also be operated with no license at all.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is a radio certificate?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "Radio certificate",
  "alternateName": "Funkzeugnis",
  "description": "A radio certificate is the official qualification required to operate marine or inland radio equipment on board – unlike the boating license itself, it's only needed if a radio is actually installed on board. Germany has three radio certificates: UBI, SRC and LRC.",
  "url": "https://boatpass.de/en/licenses/",
  "inLanguage": "en",
};
---

<BaseLayout
  title="Boating Licenses Compared – Which One Fits You?"
  description="All boating licenses at a glance: SBF Inland, SBF Coastal, costs and exam process – plus radio certificates UBI and SRC. Find the right one for you."
  lang="en"
  altUrl="https://boatpass.de/fuehrerscheine/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und breite Spalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="All Licenses"
    lede="Inland waters or coast, motorboat or radio on board – find the right license here and everything you need to know to prepare."
  >
    Which license<br />fits you?
  </PageHead>

  <PageLayout variant="wide">

    <!-- Finder banner -->
    <a href="/en/tools/which-boating-license/" class="pg-banner">
      <span class="pg-banner-text">
        <span class="pg-eyebrow">Free finder</span>
        <span class="pg-banner-title">Not sure which licence you need?</span>
        <span class="pg-banner-sub">Answer 3 questions – instantly find the right licence and matching radio certificate.</span>
      </span>
      <span class="h-btn h-btn--sm pg-banner-cta">Start finder<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></span>
    </a>

    <!-- Available -->
    <section class="pg-section">
      <h2 class="pg-h2">
        Sportbootführerschein (SBF)
      </h2>
      <p class="pg-p">
        With Boatpass you learn the complete theory – the detail pages explain each license in depth.
      </p>
      <div class="license-grid">
        {available.map(c => (
          <a href={c.href} class="license-card">
            <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
            <div class="license-title">{c.title}</div>
            <span class="license-tag">{c.tag}</span>
            <div class="license-desc">{c.desc}</div>
            <div class="license-link">Learn more<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
          </a>
        ))}
      </div>
    </section>

    <!-- What is a radio certificate -->
    <section class="pg-section">
      <h2 class="pg-h2">What is a radio certificate?</h2>
      <p class="pg-p">
        A <strong>radio certificate</strong> is the official qualification required to operate marine or inland radio equipment on board – unlike the boating license itself, it's only needed if a radio is actually installed on board. Germany has three radio certificates: the <a href="/en/ubi/" class="pg-inline-link">UBI</a> for VHF radio on inland waterways, the <a href="/en/src/" class="pg-inline-link">SRC</a> for coastal VHF marine radio with DSC, and the <a href="/en/lrc/" class="pg-inline-link">LRC</a> for worldwide marine radio, including MF/HF and satellite communication.
      </p>
    </section>

    <!-- Coming soon -->
    <section>
      <h2 class="pg-h2">
        Coming soon
      </h2>
      <p class="pg-p">
        We're working on more catalogs – special licenses like the Lake Constance licence are on the way.
      </p>
      <div class:list={["license-grid", { "license-grid--single": soon.length === 1 }]}>
        {soon.map(c => (
          c.href ? (
            <a href={c.href} class="license-card license-card-soon">
              <span class="license-soon-badge">soon</span>
              <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
              <div class="license-link">Preview<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
            </a>
          ) : (
            <div class="license-card license-card-soon license-card-disabled">
              <span class="license-soon-badge">soon</span>
              <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about boating licenses</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Further reading -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/blog/boating-license-requirements/">Requirements for a German boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/eyesight-test-boating-license-requirements-process/">Eyesight test for the German boating license – requirements and process<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/minimum-age-children-boat-germany/">What minimum age applies to children driving a boat in Germany?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/recreational-boating-license-reform-2026/">Recreational Boating License Reform 2026: what's changing and what stays the same<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/replacing-a-lost-or-damaged-boating-license/">Replacing a lost or damaged boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-inland-vs-coastal/">SBF Inland vs. SBF Coastal – what's the difference?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/motorboat-or-sailboat-which-sbf/">Motorboat or sailboat – which SBF is right for you?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/ubi-vs-src-radio-license/">UBI vs. SRC – which radio certificate do I need?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/charter-certificate-rent-boat-without-license/">Renting a boat without a license: the charter certificate<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sks-coastal-skippers-license/">Sports Coastal Skipper's License (SKS): the next stage after the SBF Coastal<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-valid-abroad/">German boat license abroad: Croatia, Netherlands & Italy<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

