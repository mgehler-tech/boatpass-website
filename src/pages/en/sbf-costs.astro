---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Costs", "item": "https://boatpass.de/en/sbf-costs/" },
  ],
};

const faqs = [
  {
    q: 'What does the German boating license cost in total?',
    a: 'With a complete course (theory + practice) you should budget around €500–650 per license in 2026, depending on provider and region. Online courses including practical training start at about €340–400. Anyone who learns the theory independently with an app and only books the practical lessons externally saves the expensive course fee and gets through much cheaper.',
  },
  {
    q: 'How high are the pure exam fees?',
    a: 'The official exam fees (theory + practice) in 2026 are €130.78 for the SBF Inland and €148.38 for the SBF Coastal. The combined exam SBF Inland + Coastal together costs only €178.61 – significantly less than both individual exams (€279.16).',
  },
  {
    q: 'Can I save money on the SBF?',
    a: 'Yes. The biggest cost block is the preparation course. Since the official ELWIS question catalog is freely available, you can learn the theory without an expensive course – e.g. with the Boatpass app for a one-time €9.99 per catalog (or €16.98 for both). For the practical part, a single day of practice on the water is often enough.',
  },
  {
    q: 'Is the combined Inland + Coastal exam cheaper?',
    a: 'Yes. Anyone who takes the SBF Inland and SBF Coastal together pays less for the combined exam than for both individual exams. You also save on study material with the complete package of both catalogs.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="German Boating License Costs 2026 – Full Guide"
  description="What does the boating license cost in 2026? Exam fees, course & practice costs for SBF Inland, SBF Coastal and the combo license – plus top saving tips."
  lang="en"
  altUrl="https://boatpass.de/sbf-kosten/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        SBF Costs
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        What does the<br>boating license cost?
      </h1>
      <p style="font-size:18px; color:#656B78; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Exam fees, course, practice and study material – here you see all the cost items for SBF Inland, SBF Coastal and the combination at a glance. Plus: how to save smartly.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:#3366FF; color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
        ▶&nbsp;Learn theory from €9.99
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Overview -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">SBF costs at a glance</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The total cost of the <strong>German boating license</strong> depends above all on whether you attend a preparation course or learn the theory independently. Only the <strong>official exam fees</strong> are fixed (€130.78 Inland, €148.38 Coastal) – everything else you can influence.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        With a complete course you'll be at around <strong>€500–650</strong> per license in 2026. Anyone who learns the theory themselves and only practices the practical part externally gets through much cheaper with <strong>exam fee + app from approx. €138</strong> plus practice costs.
      </p>
    </section>

    <!-- Cost table -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">The individual cost items</h2>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:15px; background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; overflow:hidden;">
          <thead>
            <tr style="background:rgba(26,31,54,0.04);">
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Cost item</th>
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Approximate cost</th>
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Mandatory?</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Exam fee Inland (theory + practice)</td>
              <td style="padding:13px 16px; color:#374151;">€130.78</td>
              <td style="padding:13px 16px; color:#374151;">Yes</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08); background:rgba(26,31,54,0.02);">
              <td style="padding:13px 16px; color:#374151;">Exam fee Coastal (theory + practice)</td>
              <td style="padding:13px 16px; color:#374151;">€148.38</td>
              <td style="padding:13px 16px; color:#374151;">Yes</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Combined exam Inland + Coastal</td>
              <td style="padding:13px 16px; color:#374151;">€178.61 (instead of €279.16)</td>
              <td style="padding:13px 16px; color:#374151;">Yes</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08); background:rgba(26,31,54,0.02);">
              <td style="padding:13px 16px; color:#374151;">Preparation course (online/driving school)</td>
              <td style="padding:13px 16px; color:#374151;">approx. €340–400 upwards</td>
              <td style="padding:13px 16px; color:#374151;">Optional</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Learning app / question catalog (Boatpass)</td>
              <td style="padding:13px 16px; color:#374151;">€9.99 per catalog · €16.98 package</td>
              <td style="padding:13px 16px; color:#374151;">Optional</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08); background:rgba(26,31,54,0.02);">
              <td style="padding:13px 16px; color:#374151;">Practical lessons</td>
              <td style="padding:13px 16px; color:#374151;">variable (depending on provider)</td>
              <td style="padding:13px 16px; color:#374151;">Recommended</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Incidentals (passport photo, registration)</td>
              <td style="padding:13px 16px; color:#374151;">low</td>
              <td style="padding:13px 16px; color:#374151;">Yes</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:12px;">
        The exam fees are set uniformly nationwide by the DSV and DMYV (as of 2026). Course and practice costs vary by provider and region.
      </p>
    </section>

    <!-- Inland / Coastal / Combined -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">SBF Inland, SBF Coastal or both?</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">SBF Inland</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Exam fee <strong>€130.78</strong> (theory + practice) plus study material.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">SBF Coastal</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Exam fee <strong>€148.38</strong> – slightly higher because of the navigation task.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Combined Inland + Coastal</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Only <strong>€178.61</strong> instead of €279.16 – over €100 saved with a combined exam.</div>
        </div>
      </div>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-top:20px;">
        If you want to navigate both areas anyway, the <strong>combined exam</strong> is clearly the most economical: you save both on the exam fee and on the study material (complete package instead of two separate purchases).
      </p>
    </section>

    <!-- How to save -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">How to save on the boating license</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: 'phoneDevice', title: 'Learn the theory yourself', desc: 'The biggest cost block is the preparation course. With the official ELWIS catalog in the app you learn the theory independently – for a one-time €9.99 instead of several hundred euros in course fees.' },
          { icon: 'target', title: 'Practice targeted, not broad', desc: 'With exam simulation and mistake training you pass on the first attempt – a retake means paying fees all over again.' },
          { icon: 'users', title: 'Use the combined exam', desc: 'If you need Inland and Coastal, the combined exam saves money compared to two separate attempts.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon as IconName} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#656B78; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Frequently asked questions about SBF costs</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</h3>
            <div style="font-size:15px; color:#656B78; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h2 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Further reading</h2>
      <div class="related-links">
        <a href="/en/sbf-inland/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Learn SBF Inland with Boatpass</a>
        <a href="/en/sbf-coastal/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Learn SBF Coastal with Boatpass</a>
        <a href="/en/sbf-exam/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF exam: how theory & practice work</a>
        <a href="/en/faq/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Frequently asked questions about the boating license</a>
        <a href="/en/blog/save-money-boating-license/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Save money on your boating license: the 5 best tips</a>
        <a href="/en/blog/sbf-app-vs-boating-school/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF app vs. boating school – is a theory course worth it?</a>
        <a href="/en/blog/own-boat-or-charter-boat-sbf/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF with your own boat or a charter boat – which fits you?</a>
        <a href="/en/blog/outboard-motor-basic-maintenance/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Outboard motor basic maintenance – simple care for a long lifespan</a>
        <a href="/en/blog/boat-insurance-for-sportboats-what-makes-sense/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Boat insurance: which policies actually make sense for your boat</a>
      </div>
    </section>

  </div>
</BaseLayout>
