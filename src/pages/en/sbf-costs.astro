---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';
import { priceText } from '../../data/stores';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Costs", "item": "https://boatpass.de/en/sbf-costs/" },
  ],
};

const faqs = [
  {
    q: 'What does the German boating license cost in total?',
    a: 'With a complete course (theory + practice) you should budget around €500–650 per license in 2026, depending on provider and region. Online courses including practical training start at about €340–400. Anyone who learns the theory independently with an app and only books the practical lessons externally saves the expensive course fee and gets through much cheaper.',
  },
  {
    q: 'How high are the pure exam fees?',
    a: 'The official exam fees (theory + practice) in 2026 are €130.78 for the SBF Inland and €148.38 for the SBF Coastal. The combined exam SBF Inland + Coastal together costs only €178.61 – significantly less than both individual exams (€279.16).',
  },
  {
    q: 'Can I save money on the SBF?',
    a: 'Yes. The biggest cost block is the preparation course. Since the official ELWIS question catalog is freely available, you can learn the theory without an expensive course – e.g. with the Boatpass app for a one-time €9.99 per catalog (or ' + priceText('bundleSbf', 'en') + ' for both). For the practical part, a single day of practice on the water is often enough.',
  },
  {
    q: 'Is the combined Inland + Coastal exam cheaper?',
    a: 'Yes. Anyone who takes the SBF Inland and SBF Coastal together pays less for the combined exam than for both individual exams. You also save on study material with the complete package of both catalogs.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="German Boating License Costs 2026 – Full Guide"
  description="What does the boating license cost in 2026? Exam fees, course & practice costs for SBF Inland, SBF Coastal and the combo license – plus top saving tips."
  lang="en"
  altUrl="https://boatpass.de/sbf-kosten/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="SBF Costs"
    lede="Exam fees, course, practice and study material – here you see all the cost items for SBF Inland, SBF Coastal and the combination at a glance. Plus: how to save smartly."
    ctaLabel="Learn theory from €9.99"
    cta
  >
    What does the<br />boating license cost?
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfBinnen"
      from
      items={[
        { k: 'Exam fee Inland', v: '€130.78' },
        { k: 'Exam fee Coastal', v: '€148.38' },
        { k: 'Combined exam', v: '€178.61' },
        { k: 'Preparation course', v: 'approx. €340–400 upwards' },
        { k: 'Theory with Boatpass', v: 'from €9.99' },
      ]}
    />

    <!-- Overview -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF costs at a glance</h2>
      <p class="pg-p">
        The total cost of the <strong>German boating license</strong> depends above all on whether you attend a preparation course or learn the theory independently. Only the <strong>official exam fees</strong> are fixed (€130.78 Inland, €148.38 Coastal) – everything else you can influence.
      </p>
      <p class="pg-p">
        With a complete course you'll be at around <strong>€500–650</strong> per license in 2026. Anyone who learns the theory themselves and only practices the practical part externally gets through much cheaper with <strong>exam fee + app from approx. €138</strong> plus practice costs.
      </p>
    </section>

    <!-- Cost table -->
    <section class="pg-section">
      <h2 class="pg-h2">The individual cost items</h2>
      <!-- min-width activates the overflow-x wrapper's horizontal scroll on narrow screens (like AppComparisonTable/CatalogSources). Without it the table was squeezed to phone width instead, crushing the three columns into unreadable multi-line cells. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col">Cost item</th>
              <th scope="col">Approximate cost</th>
              <th scope="col">Mandatory?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Exam fee Inland (theory + practice)</th>
              <td>€130.78</td>
              <td>Yes</td>
            </tr>
            <tr>
              <th scope="row">Exam fee Coastal (theory + practice)</th>
              <td>€148.38</td>
              <td>Yes</td>
            </tr>
            <tr>
              <th scope="row">Combined exam Inland + Coastal</th>
              <td>€178.61 (instead of €279.16)</td>
              <td>Yes</td>
            </tr>
            <tr>
              <th scope="row">Preparation course (online/driving school)</th>
              <td>approx. €340–400 upwards</td>
              <td>Optional</td>
            </tr>
            <tr>
              <th scope="row">Learning app / question catalog (Boatpass)</th>
              <td>€9.99 per catalog · {priceText('bundleSbf', 'en')} package</td>
              <td>Optional</td>
            </tr>
            <tr>
              <th scope="row">Practical lessons</th>
              <td>variable (depending on provider)</td>
              <td>Recommended</td>
            </tr>
            <tr>
              <th scope="row">Incidentals (passport photo, registration)</th>
              <td>low</td>
              <td>Yes</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        The exam fees are set uniformly nationwide by the DSV and DMYV (as of 2026). Course and practice costs vary by provider and region.
      </p>
    </section>

    <!-- Inland / Coastal / Combined -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Inland, SBF Coastal or both?</h2>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">SBF Inland</p>
          <p class="pg-card-text">Exam fee <strong>€130.78</strong> (theory + practice) plus study material.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">SBF Coastal</p>
          <p class="pg-card-text">Exam fee <strong>€148.38</strong> – slightly higher because of the navigation task.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Combined Inland + Coastal</p>
          <p class="pg-card-text">Only <strong>€178.61</strong> instead of €279.16 – over €100 saved with a combined exam.</p>
        </div>
      </div>
      <p class="pg-p">
        If you want to navigate both areas anyway, the <strong>combined exam</strong> is clearly the most economical: you save both on the exam fee and on the study material (complete package instead of two separate purchases).
      </p>
    </section>

    <!-- How to save -->
    <section class="pg-section">
      <h2 class="pg-h2">How to save on the boating license</h2>
      <div class="pg-rows">
        {[
          { icon: 'phoneDevice', title: 'Learn the theory yourself', desc: 'The biggest cost block is the preparation course. With the official ELWIS catalog in the app you learn the theory independently – for a one-time €9.99 instead of several hundred euros in course fees.' },
          { icon: 'target', title: 'Practice targeted, not broad', desc: 'With exam simulation and mistake training you pass on the first attempt – a retake means paying fees all over again.' },
          { icon: 'users', title: 'Use the combined exam', desc: 'If you need Inland and Coastal, the combined exam saves money compared to two separate attempts.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about SBF costs</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-inland/">Learn SBF Inland with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory & practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/save-money-boating-license/">Save money on your boating license: the 5 best tips<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-app-vs-boating-school/">SBF app vs. boating school – is a theory course worth it?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/own-boat-or-charter-boat-sbf/">SBF with your own boat or a charter boat – which fits you?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/outboard-motor-basic-maintenance/">Outboard motor basic maintenance – simple care for a long lifespan<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boat-insurance-for-sportboats-what-makes-sense/">Boat insurance: which policies actually make sense for your boat<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
