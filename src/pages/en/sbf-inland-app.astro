---
import AppLandingPage from '../../components/AppLandingPage.astro';
import { appsForLicense } from '../../data/apps';

const apps = appsForLicense('sbf-binnen');

const faqs = [
  {
    q: 'Which app is best for SBF Binnen?',
    a: 'If you do not want to pay: Sportbootführerschein Binnen by Matthias Wimmer – 4.9 ★ from 772 ratings, completely free, no ads and no tracking. If you want to understand the material rather than memorise it: SBF Binnen by Ralf Goritz, with a textbook and Leitner boxes. If you also want a companion online course: Bootspruefung.de. If you are combining SBF Binnen with a radio certificate and do not want a subscription: Boatpass.',
  },
  {
    q: 'Do the apps include the sailing supplement questions?',
    a: 'Yes, every app compared here covers the basic questions, the inland supplement and the sailing supplement. You only need the sailing questions if you take SBF Binnen under sail – for the motor-only variant they do not apply.',
  },
  {
    q: 'How many questions does the SBF Binnen exam have?',
    a: 'The official catalogue holds roughly 250 questions across basic, inland supplement and sailing supplement sections. The exam paper contains 30 questions. If you already hold SBF See, only the inland-specific questions remain.',
  },
  {
    q: 'Is there a free SBF Binnen app for Android?',
    a: 'Yes. Sportbootführerschein Binnen by Matthias Wimmer is permanently free, contains the full official catalogue, shows no ads, does no tracking and requests no permissions. Bootspruefung.de also lets you practise all official exam questions for free – there, theory texts and offline use are the paid part.',
  },
  {
    q: 'Is an app enough for SBF Binnen?',
    a: 'For the theory, yes – no course is required and the catalogue is published officially. For the practical exam with manoeuvres and knots you need time on the water.',
  },
  {
    q: 'Is there an SBF Binnen app for iPhone?',
    a: 'Bootspruefung.de, SBF-Fragen and SBF Binnen by Ralf Goritz are available for iOS. The free Wimmer app and Sailbyte are Android only. Boatpass is currently Android only too; the iOS version is in progress.',
  },
];

const relatedLinks = [
  { href: '/en/sbf-inland/', label: 'SBF Binnen – exam, costs and procedure' },
  { href: '/en/sbf-inland-exam-questions/', label: 'SBF Binnen exam questions explained' },
  { href: '/en/sbf-app/', label: 'All boating licence apps compared' },
  { href: '/en/sbf-coastal-app/', label: 'SBF See apps compared' },
  { href: '/en/blog/sbf-inland-vs-coastal/', label: 'SBF Binnen or See – which licence fits?' },
  { href: '/en/sbf-costs/', label: 'What does the German boating licence cost?' },
];
---

<AppLandingPage
  lang="en"
  title="SBF Binnen app: the best apps compared"
  description="Looking for an SBF Binnen app? We compare six Android and iPhone apps on price, question catalogues and ratings – including Boatpass. Compare now."
  altUrl="https://boatpass.de/sbf-binnen-app/"
  path="/sbf-inland-app/"
  breadcrumbName="SBF Binnen apps compared"
  badge="Sportbootführerschein Binnen"
  h1="SBF Binnen apps compared"
  heroIntro="Six apps cover the official SBF Binnen question catalogue – from permanently free to a monthly subscription. Prices, ratings and features side by side."
  answer="Six learning apps are worth considering for SBF Binnen. Permanently free is Sportbootführerschein Binnen by Matthias Wimmer (4.9 ★, 772 ratings). SBF Binnen by Ralf Goritz (4.8 ★, 567 ratings) has the most carefully built learning mechanic including a textbook, Bootspruefung.de adds an online course, SBF-Fragen comes from publisher Delius Klasing, Sailbyte costs €4.79 a month, and Boatpass bundles five catalogues without a subscription."
  apps={apps}
  tableCaption="Every app covering the official SBF Binnen question catalogue – sorted alphabetically."
  androidHeading="SBF Binnen app for Android"
  androidParagraphs={[
    'All six apps are on Google Play. The strongest free option is <strong>Sportbootführerschein Binnen</strong> by Matthias Wimmer: over 100,000 downloads, 4.9 ★ from 772 ratings, no ads, no in-app purchases, no tracking. The full official catalogue including sailing supplement questions is there, learned on a spaced-repetition principle.',
    'What it lacks is explanations for the answers. If you want to understand rather than memorise, <strong>SBF Binnen by Ralf Goritz</strong> (4.8 ★ from 567 ratings) serves you best: a textbook for every question, Leitner boxes either automatic or manual, a dedicated mode for uncertain questions and all exam knots. <strong>Bootspruefung.de</strong> and <strong>SBF-Fragen</strong> also supply theory texts.',
    'Boatpass is on Google Play as well. The SBF Binnen catalogue costs €9.99 as a one-off, or €16.98 together with SBF See. Trying it is free.',
  ]}
  iosHeading="SBF Binnen app for iPhone and iPad"
  iosParagraphs={[
    'On iPhone, three of the six apps are available to you: <strong>Bootspruefung.de</strong>, <strong>SBF-Fragen</strong> and <strong>SBF Binnen by Ralf Goritz</strong>. All three contain the full catalogue including sailing supplement questions.',
    'The free Wimmer app and Sailbyte are Android exclusives. <strong>Boatpass is not in the App Store yet</strong> – the iOS version is in development. To start on an iPhone today, the three apps above are the choice.',
  ]}
  strengths={[
    'Complete official SBF Binnen catalogue including sailing supplement questions',
    'Exam simulation with time limit and pass mark',
    'Mistake training for targeted repetition',
    'SBF Binnen, SBF See, UBI, SRC and LRC in one app',
    '€9.99 one-off for the SBF Binnen catalogue, no subscription',
    'Study offline – works without an internet connection',
  ]}
  limitations={[
    'Android only so far',
    'No Lake Constance licence – for that you need Bootspruefung.de or SBF-Fragen',
    'Only 10 Play Store ratings, against 772 for the Wimmer app',
    'No companion online course in the browser',
    'Does not replace practical training with a boating school',
  ]}
  faqs={faqs}
  relatedLinks={relatedLinks}
/>
