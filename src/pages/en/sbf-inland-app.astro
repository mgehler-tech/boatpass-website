---
import AppLandingPage from '../../components/AppLandingPage.astro';
import { appsForLicense } from '../../data/apps';
import { priceText } from '../../data/stores';

const apps = appsForLicense('sbf-binnen');

const faqs = [
  {
    q: 'Which app is best for SBF Binnen?',
    a: 'If you do not want to pay: Sportbootführerschein Binnen by Matthias Wimmer – completely free, no ads and no tracking. If you want to understand the material rather than memorise it: SBF Binnen by Ralf Goritz, with a textbook and Leitner boxes. If you also want a companion online course: Bootspruefung.de. If you are combining SBF Binnen with a radio certificate and do not want a subscription: Boatpass.',
  },
  {
    q: 'Do the apps include the sailing supplement questions?',
    a: 'Yes, every app compared here covers the basic questions, the inland supplement and the sailing supplement. You only need the sailing questions if you take SBF Binnen under sail – for the motor-only variant they do not apply.',
  },
  {
    q: 'How many questions does the SBF Binnen exam have?',
    a: 'The official catalogue holds 253 questions under engine (72 basic and 181 inland questions) and 300 including the 47 sailing questions. The exam paper contains 30 questions. If you already hold SBF See, only the inland-specific questions remain.',
  },
  {
    q: 'Is there a free SBF Binnen app for Android?',
    a: 'Yes. Sportbootführerschein Binnen by Matthias Wimmer is permanently free, contains the full official catalogue, shows no ads, does no tracking and requests no permissions. Bootspruefung.de also lets you practise all official exam questions for free – there, theory texts and offline use are the paid part.',
  },
  {
    q: 'Is an app enough for SBF Binnen?',
    a: 'For the theory, yes – no course is required and the catalogue is published officially. For the practical exam with manoeuvres and knots you need time on the water.',
  },
  {
    q: 'Is there an SBF Binnen app for iPhone?',
    a: 'Yes: Bootspruefung.de, Bootsprüfung, Bootsschule1, SBF-Fragen, SBF Binnen by Ralf Goritz, Sailbyte and Boatpass (since October 2026) are available for iOS. Only the free Wimmer app is limited to Android.',
  },
];

const relatedLinks = [
  { href: '/en/sbf-inland/', label: 'SBF Binnen – exam, costs and procedure' },
  { href: '/en/sbf-inland-exam-questions/', label: 'SBF Binnen exam questions explained' },
  { href: '/en/sbf-app/', label: 'All boating licence apps compared' },
  { href: '/en/sbf-coastal-app/', label: 'SBF See apps compared' },
  { href: '/en/blog/sbf-inland-vs-coastal/', label: 'SBF Binnen or See – which licence fits?' },
  { href: '/en/sbf-costs/', label: 'What does the German boating licence cost?' },
];
---

<AppLandingPage
  lang="en"
  title="SBF Inland App: the best apps compared 2026"
  description="Looking for an SBF Binnen app? Eight Android and iPhone apps compared on price, ratings and engine or sailing questions – including Boatpass."
  altUrl="https://boatpass.de/sbf-binnen-app/"
  path="/sbf-inland-app/"
  breadcrumbName="SBF Binnen apps compared"
  badge="Sportbootführerschein Binnen"
  h1="SBF Binnen apps compared"
  heroIntro="Eight apps cover the official SBF Binnen question catalogue – from permanently free to a monthly subscription. Prices, ratings and features side by side."
  answer="Eight widely used learning apps are worth considering for SBF Binnen. Permanently free is Sportbootführerschein Binnen by Matthias Wimmer. SBF Binnen by Ralf Goritz has the most carefully built learning mechanic including a textbook, Bootspruefung.de has the most ratings and adds an online course, SBF-Fragen comes from publisher Delius Klasing, Bootsschule1 belongs to a complete course, Bootsprüfung is the newest provider, Sailbyte costs €4.99 a month, and Boatpass bundles five catalogues without a subscription."
  apps={apps}
  tableCaption="Every app covering the official SBF Binnen question catalogue – sorted alphabetically."
  androidHeading="SBF Binnen app for Android"
  androidParagraphs={[
    'All eight apps are on Google Play. The strongest free option is <strong>Sportbootführerschein Binnen</strong> by Matthias Wimmer: over 100,000 downloads, very highly rated, no ads, no in-app purchases, no tracking. The full official catalogue including sailing supplement questions is there, learned on a spaced-repetition principle.',
    'What it lacks is explanations for the answers. If you want to understand rather than memorise, <strong>SBF Binnen by Ralf Goritz</strong> serves you best: a textbook for every question, Leitner boxes either automatic or manual, a dedicated mode for uncertain questions and all exam knots. <strong>Bootspruefung.de</strong> and <strong>SBF-Fragen</strong> also supply theory texts.',
    'Boatpass is on Google Play as well. The SBF Binnen catalogue costs ' + priceText('sbfBinnen', 'en') + ' as a one-off, or ' + priceText('bundleSbf', 'en') + ' together with SBF See. Trying it is free.',
  ]}
  iosHeading="SBF Binnen app for iPhone and iPad"
  iosParagraphs={[
    'On iPhone, seven of the eight apps are available to you: <strong>Bootspruefung.de</strong>, <strong>Bootsprüfung</strong>, <strong>Bootsschule1</strong>, <strong>SBF-Fragen</strong>, <strong>SBF Binnen by Ralf Goritz</strong>, <strong>Sailbyte</strong> and <strong>Boatpass</strong>. Goritz and SBF-Fragen each have over 5,000 ratings there, a much broader base than on Google Play.',
    'Only the free Wimmer app is an Android exclusive. <strong>Boatpass has been on the App Store since October 2026</strong> – with the same 15 free questions per day as on Android. A purchase only applies to the store you bought in.',
  ]}
  strengths={[
    'Complete official SBF Binnen catalogue including sailing supplement questions',
    'Exam simulation with time limit and pass mark',
    'Mistake training for targeted repetition',
    'SBF Binnen, SBF See, UBI, SRC and LRC in one app',
    '€9.99 one-off for the SBF Binnen catalogue, no subscription',
    'Study offline – works without an internet connection',
  ]}
  limitations={[
    'Purchases apply per store – no transfer between Android and iPhone',
    'No Lake Constance licence – for that you need Bootspruefung.de or SBF-Fragen',
    'Still few ratings compared with Bootspruefung.de, Goritz or Wimmer',
    'No companion online course in the browser',
    'Does not replace practical training with a boating school',
  ]}
  faqs={faqs}
  relatedLinks={relatedLinks}
>
  <section slot="after-table" style="margin-bottom:48px;">
    <h2 class="content-section-title" style="margin-bottom:16px;">Engine, sail or already SBF See: which questions you need</h2>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      How much you have to learn for SBF Binnen depends on your starting point. Under engine, the official catalogue holds 253 questions (72 basic and 181 inland questions). If you also want the licence under sail, you learn 47 sailing questions on top, 300 in total. If you already hold SBF See, you do not need the basic questions again.
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Good apps adjust the number of questions to this so you learn nothing you do not need. According to their store descriptions, <strong>SBF Binnen by Ralf Goritz</strong>, <strong>SBF-Fragen</strong> and <strong>Bootspruefung.de</strong> ask which licences you already hold and hide the questions you no longer need. In <strong>Boatpass</strong> you choose the exam type, such as engine or engine and sail. The free <strong>Wimmer app</strong> contains the complete catalogue including the sailing questions, without such filters.
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Which variant suits you is covered in the article <a href="/en/blog/motorboat-or-sailboat-which-sbf/" style="color:#3366FF; text-decoration:underline;">Motorboat or sailboat – which SBF?</a>. You will find the structure of the exam on the page <a href="/en/sbf-inland-exam-questions/" style="color:#3366FF; text-decoration:underline;">SBF Binnen exam questions</a>.
    </p>
  </section>
</AppLandingPage>
