---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';

// FAQPage schema: mirrors the four visible self-service questions further down the page.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "I bought the app but cannot see the questions",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your purchase is tied to your Google account or Apple ID, not the device. Open the app with the same account and tap „Restore purchases\" in the settings. If that fails, send us the order number from your Google Play or Apple purchase confirmation. Note that a Google Play purchase does not apply on iPhone and vice versa.",
      },
    },
    {
      "@type": "Question",
      "name": "Is the question catalog up to date?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We use the official ELWIS catalog issued by DSV and DMYV and sync it regularly. See what comes up in the exam on SBF Inland exam questions and SBF Coastal exam questions.",
      },
    },
    {
      "@type": "Question",
      "name": "Is Boatpass available for iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, since October 2026 – for iPhone and iPad with iOS 16 or later, free on the App Store.",
      },
    },
    {
      "@type": "Question",
      "name": "Questions about the exam itself",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We do not advise individually on registration, costs or scheduling – DSV and DMYV handle that. We have collected the essentials though: exam process, costs, blood alcohol limits on board and the FAQ.",
      },
    },
  ],
};
---

<BaseLayout
  title="Contact – SBF App Support & Questions"
  description="Questions about the Boatpass app, the SBF question catalog or a technical problem? Here is how to reach me – I usually reply within a few hours."
  lang="en"
  altUrl="https://boatpass.de/kontakt/"
  showCta={false}
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1/3.5) -->
  <PageHead
    lang="en"
    eyebrow="Contact"
    lede="Questions, feedback, or found a bug? We'd love to hear from you."
  >
    Get in touch
  </PageHead>

  <PageLayout variant="narrow">

    <div id="success-msg" role="status" aria-live="polite" aria-atomic="true" class="pg-notice pg-notice--ok" style="display:none;">
      ✓ Message received! It goes straight to Marius – usually answered within a few hours.
    </div>
    <div id="error-msg" role="alert" aria-live="assertive" aria-atomic="true" class="pg-notice pg-notice--error" style="display:none;"></div>

    <form id="contact-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Your name</label>
        <input type="text" id="name" name="name" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">Email address</label>
        <input type="email" id="email" name="email" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Your message</label>
        <textarea id="message" name="message" rows="5" required
          class="contact-field w-full rounded-xl px-4 py-3 transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Send
      </button>
    </form>

    <!-- Self-service support: answers the questions that most often reach us via
         the form, and gives the page substance beyond a bare form. -->
    <section class="pg-section">
      <h2 class="pg-h2">This might already answer it</h2>
      <p class="pg-p">These four questions reach us most often – and the answer is usually already on the site.</p>

      <div class="pg-faq">
        <div class="pg-faq-item">
          <h3 class="pg-h3">I bought the app but cannot see the questions</h3>
          <p class="pg-card-text">Your purchase is tied to your Google account or Apple ID, not the device. Open the app with the same account and tap „Restore purchases" in the settings. If that fails, send us the order number from your Google Play or Apple purchase confirmation. Note that a Google Play purchase does not apply on iPhone and vice versa.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Is the question catalog up to date?</h3>
          <p class="pg-card-text">Yes. We use the official ELWIS catalog issued by DSV and DMYV and sync it regularly. See what comes up in the exam on <a href="/en/sbf-inland-exam-questions/" class="pg-inline-link">SBF Inland exam questions</a> and <a href="/en/sbf-coastal-exam-questions/" class="pg-inline-link">SBF Coastal exam questions</a>.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Is Boatpass available for iPhone?</h3>
          <p class="pg-card-text">Yes, since October 2026 – for iPhone and iPad with iOS 16 or later, free on the App Store.</p>
        </div>
        <div class="pg-faq-item">
          <h3 class="pg-h3">Questions about the exam itself</h3>
          <p class="pg-card-text">We do not advise individually on registration, costs or scheduling – DSV and DMYV handle that. We have collected the essentials though: <a href="/en/sbf-exam/" class="pg-inline-link">exam process</a>, <a href="/en/sbf-costs/" class="pg-inline-link">costs</a>, <a href="/en/blog/blood-alcohol-limit-boat/" class="pg-inline-link">blood alcohol limits on board</a> and the <a href="/en/faq/" class="pg-inline-link">FAQ</a>.</p>
        </div>
      </div>
    </section>
  </PageLayout>

  <style>
    /* Form fields aligned with the site-wide design system. Previously the inputs
       carried only Tailwind utilities with no dark-mode treatment – in dark mode
       they showed as bright boxes with a light-gray border against the dark page
       (every other surface uses #181E2E). The light-mode look is unchanged (white
       background, #e5e7eb border = former border-gray-200); in dark mode the
       surface and border tokens now apply as everywhere else. A visible focus ring
       (2px, brand blue, 2px offset – exactly the global.css pattern) also replaces
       the focus previously removed by focus:outline-none, which had only been hinted
       at by a subtle 1px border-color change. Pure polish: no brand hex codes
       changed. */
    .contact-field {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      color: var(--color-text);
    }
    .contact-field::placeholder { color: #9097A6; }
    .contact-field:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
      border-color: var(--color-primary);
    }
    html.dark .contact-field {
      background: #181E2E;
      border-color: rgba(90, 120, 255, 0.18);
    }
    html.dark .contact-field::placeholder { color: #656B78; }
  </style>

  <script>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Error sending. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send';
        }
      } catch {
        errorMsg.textContent = 'Network error. Please try again.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    });
  </script>
</BaseLayout>
