---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact – Boatpass"
  description="Contact the Boatpass team with questions, feedback, or bug reports."
  lang="en"
  altUrl="https://boatpass.de/kontakt/"
  showCta={false}
>
  <div class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-text mb-4">Contact</h1>
    <p class="text-gray-500 mb-10">Questions, feedback, or found a bug? Write to us!</p>

    <div id="success-msg" style="display:none; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; border-radius:12px; padding:20px 24px; margin-bottom:24px; font-weight:500; font-size:1rem;">
      ✓ Message sent successfully! The team will get back to you as soon as possible.
    </div>
    <div id="error-msg" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:12px; padding:16px 20px; margin-bottom:24px;"></div>

    <form id="contact-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Your name</label>
        <input type="text" id="name" name="name" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">Email address</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Your message</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Send
      </button>
    </form>
  </div>

  <script>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Error sending. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send';
        }
      } catch {
        errorMsg.textContent = 'Network error. Please try again.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    });
  </script>
</BaseLayout>
