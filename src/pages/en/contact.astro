---
import BaseLayout from '../../layouts/BaseLayout.astro';

// FAQPage schema: mirrors the four visible self-service questions further down the page.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "I bought the app but cannot see the questions",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your purchase is tied to your Google account, not the device. Open the app with the same account and tap „Restore purchases\" in the settings. If that fails, send us the order number from your Play Store confirmation email.",
      },
    },
    {
      "@type": "Question",
      "name": "Is the question catalog up to date?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We use the official ELWIS catalog issued by DSV and DMYV and sync it regularly. See what comes up in the exam on SBF Inland exam questions and SBF Coastal exam questions.",
      },
    },
    {
      "@type": "Question",
      "name": "Is Boatpass available for iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Android only for now. An iOS version is in the works – write to us and we will let you know when it launches.",
      },
    },
    {
      "@type": "Question",
      "name": "Questions about the exam itself",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We do not advise individually on registration, costs or scheduling – DSV and DMYV handle that. We have collected the essentials though: exam process, costs, blood alcohol limits on board and the FAQ.",
      },
    },
  ],
};
---

<BaseLayout
  title="Contact"
  description="Questions about the Boatpass app, the SBF question catalog or a technical problem? Here is how to reach us – we usually reply within 24 hours."
  lang="en"
  altUrl="https://boatpass.de/kontakt/"
  showCta={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div style="max-width:600px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        Contact
      </div>
      <h1 style="font-size:clamp(30px,4.5vw,42px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:12px;">Get in touch</h1>
      <p style="font-size:16px; color:#656B78;">Questions, feedback, or found a bug? We'd love to hear from you.</p>
    </div>

    <div id="success-msg" role="status" aria-live="polite" aria-atomic="true" style="display:none; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; border-radius:12px; padding:20px 24px; margin-bottom:24px; font-weight:500; font-size:1rem;">
      ✓ Message sent successfully! The team will get back to you as soon as possible.
    </div>
    <div id="error-msg" role="alert" aria-live="assertive" aria-atomic="true" style="display:none; background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:12px; padding:16px 20px; margin-bottom:24px;"></div>

    <form id="contact-form" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="name">Your name</label>
        <input type="text" id="name" name="name" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="email">Email address</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" />
      </div>
      <div>
        <label class="block text-sm font-medium text-text mb-2" for="message">Your message</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors resize-none"></textarea>
      </div>
      <button type="submit" id="submit-btn"
        class="w-full bg-primary text-white py-3 rounded-xl font-semibold hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Send
      </button>
    </form>

    <!-- Self-service support: answers the questions that most often reach us via
         the form, and gives the page substance beyond a bare form. -->
    <section style="margin-top:56px;">
      <h2 style="font-size:22px; font-weight:900; letter-spacing:-0.02em; color:#1A1F36; margin-bottom:8px;">This might already answer it</h2>
      <p style="font-size:15px; color:#656B78; margin-bottom:24px;">These four questions reach us most often – and the answer is usually already on the site.</p>

      <div style="display:grid; gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">I bought the app but cannot see the questions</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Your purchase is tied to your Google account, not the device. Open the app with the same account and tap „Restore purchases" in the settings. If that fails, send us the order number from your Play Store confirmation email.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Is the question catalog up to date?</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Yes. We use the official ELWIS catalog issued by DSV and DMYV and sync it regularly. See what comes up in the exam on <a href="/en/sbf-inland-exam-questions/" style="color:#3366FF;">SBF Inland exam questions</a> and <a href="/en/sbf-coastal-exam-questions/" style="color:#3366FF;">SBF Coastal exam questions</a>.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Is Boatpass available for iPhone?</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">Android only for now. An iOS version is in the works – write to us and we will let you know when it launches.</p>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; padding:20px 24px;">
          <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:6px;">Questions about the exam itself</h3>
          <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">We do not advise individually on registration, costs or scheduling – DSV and DMYV handle that. We have collected the essentials though: <a href="/en/sbf-exam/" style="color:#3366FF;">exam process</a>, <a href="/en/sbf-costs/" style="color:#3366FF;">costs</a>, <a href="/en/blog/blood-alcohol-limit-boat/" style="color:#3366FF;">blood alcohol limits on board</a> and the <a href="/en/faq/" style="color:#3366FF;">FAQ</a>.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('success-msg');
    const errorMsg = document.getElementById('error-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xgoqqywe', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          const data = await res.json();
          errorMsg.textContent = data?.errors?.map((e) => e.message).join(', ') || 'Error sending. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send';
        }
      } catch {
        errorMsg.textContent = 'Network error. Please try again.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    });
  </script>
</BaseLayout>
