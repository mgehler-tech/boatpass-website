---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Inland", "item": "https://boatpass.de/en/sbf-inland/" },
  ],
};

const faqs = [
  {
    q: 'When do I need the SBF Inland?',
    a: 'The SBF Inland is mandatory for recreational boats with more than 11.03 kW (15 HP) of propulsion power on inland waterways. For electric drives the license requirement currently applies from 7.5 kW. A planned reform aims to standardize the limit technology-neutrally at 11.03 kW, but it has not yet come into force. On individual areas such as the Rhine, stricter regional rules may apply.',
  },
  {
    q: 'How does the SBF Inland theory exam work?',
    a: 'You answer a paper of 30 multiple-choice questions (7 basic questions + 23 specific inland questions) in 45 minutes. Since the separate grading, you have to pass both parts separately: at least 5 of 7 basic questions and at least 18 of 23 specific questions correct. After that comes a short practical exam on the water.',
  },
  {
    q: 'Do I need a course for the SBF Inland?',
    a: 'No. The official ELWIS question catalog is freely available, so you can learn the theory independently – e.g. with Boatpass. A driving school is not required; for the practical part a single day of practice on the water is often enough.',
  },
  {
    q: 'How long do I have to study for the SBF Inland?',
    a: 'At 20–30 minutes a day, the theory is usually solidly mastered in 3–5 weeks. Anyone who works through the complete question catalog systematically and specifically reviews mistakes is ready for the exam much faster.',
  },
  {
    q: 'Is the SBF Inland also valid on the North and Baltic Sea?',
    a: 'No. For the coastal waters of the North and Baltic Sea you need the SBF Coastal. Anyone who wants to navigate both areas can take Inland and Coastal in a combined exam – which is cheaper than two separate exams.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// Course schema: clearly marks the page as a learning course for the SBF Inland
// (in addition to the app markup). All details mirror the page content.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Inland Exam Preparation",
  "description": "Complete preparation for the theory exam of the German inland boating license (SBF Inland) with the full official ELWIS question catalog (253+ questions), exam simulation and targeted mistake training.",
  "url": "https://boatpass.de/en/sbf-inland/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Maritime law and waterways regulations",
    "Right-of-way and give-way rules",
    "Navigation marks and lights",
    "Navigation on inland waters",
    "Official SBF Inland question catalog",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "9.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

// Direct comparison Inland vs. Coastal as a decision aid
const compare = [
  { label: 'Area', binnen: 'Rivers, canals & inland lakes', see: 'Coastal waters of North & Baltic Sea' },
  { label: 'Mandatory from', binnen: '11.03 kW (15 HP)', see: '11.03 kW (15 HP)' },
  { label: 'Boat length', binnen: 'under engine max. 20 m', see: 'no limit' },
  { label: 'Theory exam', binnen: '30 questions · 45 min', see: '30 questions + navigation · 60 min' },
  { label: 'Navigation task', binnen: '–', see: 'yes (chart task)' },
  { label: 'Exam fee 2026', binnen: '€130.78', see: '€148.38' },
  { label: 'Minimum age', binnen: '16 years', see: '16 years' },
];

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & waterways regulations', count: 124, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation', desc: 'Charts, courses, positions & bearings', count: 52, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 39, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signals & marks', desc: 'Sound signals, visual signals & flags', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Meteorology', desc: 'Wind, weather & forecasting', count: 6, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 4, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
  { name: 'Sailing', desc: 'Sailing-specific questions for the sailing scope', count: 47, icon: 'sailboat', color: '#0EA5E9', bg: 'rgba(14,165,233,0.10)' },
];
---

<BaseLayout
  title="Learn SBF Inland – German Inland Boating License App"
  description="Study for the SBF Inland with the Boatpass app. Official ELWIS question catalog, exam simulation & mistake training. Start for free."
  lang="en"
  altUrl="https://boatpass.de/sbf-binnen/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Inland Boating License
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Learn SBF Inland –<br>the smart study app
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:560px; margin:0 auto 36px;">
        Prepare for the SBF Inland exam with the official ELWIS question catalog.
        3 learning modes, exam simulation and targeted mistake training – start for free.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Free on the Play Store
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- What is SBF Inland -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">What is the SBF Inland?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The <strong>inland boating license (SBF Inland)</strong> is the official permit for motorboats on German inland waterways – rivers, canals and inland lakes. It is mandatory for boats with more than <strong>11.03 kW (15 HP) of engine power</strong>. For electric motors a limit of 7.5 kW applied so far – with the 2026 reform it is raised technology-neutrally to a uniform 11.03 kW. On some areas (e.g. the Rhine) stricter regional limits apply.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        The minimum age is 16. The license is administered by the DMYV and is valid indefinitely.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="en" only="binnen" />
    </section>

    <!-- Exam structure -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">SBF Inland exam: structure & passing threshold</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theory exam</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">30 questions · 45 minutes<br>Multiple choice</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basic questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 questions<br>at least 5 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Specific questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">23 questions<br>at least 18 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Question catalog</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">253+ questions<br>official ELWIS catalog</div>
        </div>
      </div>
      <p style="font-size:15px; color:#6B7280; line-height:1.7;">
        After the theory comes a <strong>practical exam</strong> on the water. The official exam fee for the SBF Inland in 2026 is <strong>€130.78</strong> (theory + practice).
      </p>
    </section>

    <!-- Process: practice & registration -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Process: from registration to the practical part</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        You register with a recognized examination board (e.g. DMYV). First you take the theory exam, then comes the <strong>practical exam</strong> on the water.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Registration</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Application to the examination board, passport photo and ID – minimum age 16.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Practical maneuvers</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Coming alongside and casting off, turning, stopping and the man-overboard maneuver.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;"><a href="/en/blog/most-important-knots-sbf/" style="color:inherit; text-decoration:underline;">Knots</a></div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Apply the exam-relevant knots quickly (e.g. bowline, clove hitch, cleat).</div>
        </div>
      </div>
      <a href="/en/sbf-exam/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">Exam process step by step →</a>
    </section>

    <!-- Costs compact -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">What does the SBF Inland cost?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Only the official <strong>exam fee of €130.78</strong> (theory + practice) is fixed. The biggest cost block is the preparation course – anyone who learns the theory themselves with the official ELWIS catalog saves exactly that item.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">€130.78</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Official exam fee</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">≈ €500–650</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Complete course (optional)</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#3366FF;">from €9.99</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Learn theory with Boatpass</div>
        </div>
      </div>
      <a href="/en/sbf-costs/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">All SBF costs in detail →</a>
    </section>

    <!-- Scope -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Where may I navigate with the SBF Inland?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        The SBF Inland is valid on Germany's <strong>inland waterways</strong> – i.e. rivers, canals and inland lakes. Under engine the boat length is limited to <strong>20 meters</strong>; for longer vessels you need a recreational skipper's certificate. It is not valid for the coastal waters of the North and Baltic Sea – there the SBF Coastal applies.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Where it's valid</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Rivers, canals and inland lakes on German inland waterways.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Requirements</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Minimum age 16. The license is administered by the DMYV and is valid indefinitely.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Regional limits</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">On some areas (e.g. the Rhine) stricter power limits apply – check beforehand.</div>
        </div>
      </div>
    </section>

    <!-- Comparison Inland vs. Coastal -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">SBF Inland or Coastal – what do you need?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Inland and Coastal are two separate licenses. Anyone who wants to navigate both areas can take them together more cheaply in a
        <strong>combined exam</strong> (around €178.61 instead of twice separately).
      </p>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:15px; background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; overflow:hidden;">
          <thead>
            <tr style="background:rgba(26,31,54,0.04);">
              <th style="text-align:left; padding:14px 18px; font-weight:700; color:#1A1F36;"></th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF Inland</th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF Coastal</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr style={`border-top:1px solid rgba(51,102,255,0.08);${i % 2 ? ' background:rgba(26,31,54,0.02);' : ''}`}>
                <td style="padding:13px 18px; font-weight:600; color:#1A1F36;">{row.label}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.binnen}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/en/sbf-coastal/" style="display:inline-flex; align-items:center; gap:8px; margin-top:18px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">View SBF Coastal in detail →</a>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Frequently asked questions about the SBF Inland</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <div style="font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</div>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">Learn by category</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        The official question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
        Source: official question catalog (DSV/DMYV) on <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-neu-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
            </div>
            <span style="font-size:12px; font-weight:700; color:#6B7280; background:rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.07); border-radius:100px; padding:3px 10px; flex-shrink:0; white-space:nowrap;">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- How the app helps -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">How Boatpass helps with the SBF Inland</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {([
          { icon: 'book', title: 'Complete ELWIS catalog', desc: 'All 253+ official questions for SBF Inland – always up to date, right in the app.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Real exam conditions: 30 questions, 45 minutes, passing threshold – just like on exam day.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Specifically train the questions you don\'t know yet. No wasting time on content you\'ve already learned.' },
          { icon: 'chart', title: 'Progress display', desc: 'See at any time how far you are – broken down by category.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Further reading</h3>
