---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import BoatSchoolFinder from '../../components/BoatSchoolFinder.astro';
import type { IconName } from '../../icons';
import { PLAY_STORE_URL, schemaOffers } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Inland", "item": "https://boatpass.de/en/sbf-inland/" },
  ],
};

const faqs = [
  {
    q: 'When do I need the SBF Inland?',
    a: 'The SBF Inland is mandatory for recreational boats with more than 11.03 kW (15 HP) of propulsion power on inland waterways. For electric drives the license requirement currently applies from 7.5 kW. A planned reform aims to standardize the limit technology-neutrally at 11.03 kW, but it has not yet come into force. On individual areas such as the Rhine, stricter regional rules may apply.',
  },
  {
    q: 'How does the SBF Inland theory exam work?',
    a: 'You answer a paper of 30 multiple-choice questions (7 basic questions + 23 specific inland questions) in 45 minutes. Since the separate grading, you have to pass both parts separately: at least 5 of 7 basic questions and at least 18 of 23 specific questions correct. After that comes a short practical exam on the water.',
  },
  {
    q: 'Do I need a course for the SBF Inland?',
    a: 'No. The official ELWIS question catalog is freely available, so you can learn the theory independently – e.g. with Boatpass. A driving school is not required; for the practical part a single day of practice on the water is often enough.',
  },
  {
    q: 'How long do I have to study for the SBF Inland?',
    a: 'At 20–30 minutes a day, the theory is usually solidly mastered in 3–5 weeks. Anyone who works through the complete question catalog systematically and specifically reviews mistakes is ready for the exam much faster.',
  },
  {
    q: 'Is the SBF Inland also valid on the North and Baltic Sea?',
    a: 'No. For the coastal waters of the North and Baltic Sea you need the SBF Coastal. Anyone who wants to navigate both areas can take Inland and Coastal in a combined exam – which is cheaper than two separate exams.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is the SBF Inland?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SBF Inland",
  "alternateName": "German inland boating license",
  "description": "The inland boating license (SBF Inland) is the official permit for motorboats on German inland waterways – rivers, canals and inland lakes. It is mandatory for boats with more than 11.03 kW (15 HP) of engine power.",
  "url": "https://boatpass.de/en/sbf-inland/",
  "inLanguage": "en",
};

// Course schema: clearly marks the page as a learning course for the SBF Inland
// (in addition to the app markup). All details mirror the page content.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Inland Exam Preparation",
  "description": "Complete preparation for the theory exam of the German inland boating license (SBF Inland) with the full official ELWIS question catalog (253+ questions), exam simulation and targeted mistake training.",
  "url": "https://boatpass.de/en/sbf-inland/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Maritime law and waterways regulations",
    "Right-of-way and give-way rules",
    "Navigation marks and lights",
    "Navigation on inland waters",
    "Official SBF Inland question catalog",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('sbfBinnen'),
};

// Direct comparison Inland vs. Coastal as a decision aid
const compare = [
  { label: 'Area', binnen: 'Rivers, canals & inland lakes', see: 'Coastal waters of North & Baltic Sea' },
  { label: 'Mandatory from', binnen: '11.03 kW (15 HP)', see: '11.03 kW (15 HP)' },
  { label: 'Boat length', binnen: 'under engine max. 20 m', see: 'no limit' },
  { label: 'Theory exam', binnen: '30 questions · 45 min', see: '30 questions + navigation · 60 min' },
  { label: 'Navigation task', binnen: '–', see: 'yes (chart task)' },
  { label: 'Exam fee 2026', binnen: '€130.78', see: '€148.38' },
  { label: 'Minimum age', binnen: '16 years', see: '16 years' },
];

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & waterways regulations', count: 124, icon: 'scale' },
  { name: 'Navigation', desc: 'Charts, courses, positions & bearings', count: 52, icon: 'compass' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 39, icon: 'shield' },
  { name: 'Signals & marks', desc: 'Sound signals, visual signals & flags', count: 28, icon: 'bell' },
  { name: 'Meteorology', desc: 'Wind, weather & forecasting', count: 6, icon: 'cloud' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 4, icon: 'document' },
  { name: 'Sailing', desc: 'Sailing-specific questions for the sailing scope', count: 47, icon: 'sailboat' },
];
---

<BaseLayout
  title="Learn SBF Inland – Boating License Study App"
  description="Study for the SBF Inland (SBF Binnen) with the Boatpass app: official ELWIS question catalog, exam simulation & mistake training. Start for free."
  lang="en"
  altUrl="https://boatpass.de/sbf-binnen/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Inland Boating License"
    lede="Prepare for the SBF Inland exam with the official ELWIS question catalog. 3 learning modes, exam simulation and targeted mistake training – start for free."
    cta
  >
    Learn SBF Inland –<br />the smart study app
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfBinnen"
      items={[
        { k: 'Question catalogue', v: '253+ questions' },
        { k: 'Theory exam', v: '30 questions · 45 min' },
        { k: 'Pass mark', v: '5 of 7 basic, 18 of 23 specific' },
        { k: 'Exam fee 2026', v: '€130.78' },
        { k: 'Minimum age', v: '16 years' },
      ]}
    />

    <!-- Answer-Snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In short</p>
        <p class="pg-answer-text">
          The SBF Inland (German inland boating license) is the official permit for motorboats with more than 11.03 kW (15 HP) on German inland waterways. The theory exam consists of 30 multiple-choice questions (7 basic + 23 specific questions) in 45 minutes – passed with at least 5 of 7 basic and 18 of 23 specific questions correct. The exam draws on the official ELWIS question catalog (253+ questions); Boatpass trains all content with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is SBF Inland -->
    <section class="pg-section">
      <h2 class="pg-h2">What is the SBF Inland?</h2>
      <p class="pg-p">
        The <strong>inland boating license (SBF Inland)</strong> is the official permit for motorboats on German inland waterways – rivers, canals and inland lakes. It is mandatory for boats with more than <strong>11.03 kW (15 HP) of engine power</strong>. For electric motors a limit of 7.5 kW applies so far – a planned reform aims to raise it technology-neutrally to a uniform 11.03 kW, but it has not yet come into force. On some areas (e.g. the Rhine) stricter regional limits apply. See exactly where the line is drawn and when you can <a href="/en/blog/boating-without-license-15-hp/" class="pg-inline-link">boat without a license at all</a>.
      </p>
      <p class="pg-p">
        The minimum age is 16. The license is administered by the DMYV and is valid indefinitely.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section class="pg-section">
      <CatalogSources lang="en" only="binnen" />
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Inland exam: structure & passing threshold</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theory exam</p>
          <p class="pg-card-text">30 questions · 45 minutes<br>Multiple choice</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basic questions</p>
          <p class="pg-card-text">7 questions<br>at least 5 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Specific questions</p>
          <p class="pg-card-text">23 questions<br>at least 18 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Question catalog</p>
          <p class="pg-card-text">253+ questions<br>official ELWIS catalog</p>
        </div>
      </div>
      <p class="pg-note">
        After the theory comes a <strong>practical exam</strong> on the water. The official exam fee for the SBF Inland in 2026 is <strong>€130.78</strong> (theory + practice).
      </p>
    </section>

    <!-- Process: practice & registration -->
    <section class="pg-section">
      <h2 class="pg-h2">Process: from registration to the practical part</h2>
      <p class="pg-p">
        You register with a recognized examination board (e.g. DMYV). First you take the theory exam, then comes the <strong>practical exam</strong> on the water.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Registration</p>
          <p class="pg-card-text">Application to the examination board, passport photo and ID – minimum age 16.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Practical maneuvers</p>
          <p class="pg-card-text">Coming alongside and casting off, turning, stopping and the man-overboard maneuver.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title"><a href="/en/blog/most-important-knots-sbf/" class="pg-card-link">Knots</a></p>
          <p class="pg-card-text">Apply the exam-relevant knots quickly (e.g. bowline, clove hitch, cleat).</p>
        </div>
      </div>
      <PageLink lang="en" href="/en/sbf-exam/">Exam process step by step</PageLink>
    </section>

    <!-- Find a boat school -->
    <BoatSchoolFinder lang="en" variant="binnen" />

    <!-- Costs compact -->
    <section class="pg-section">
      <h2 class="pg-h2">What does the SBF Inland cost?</h2>
      <p class="pg-p">
        Only the official <strong>exam fee of €130.78</strong> (theory + practice) is fixed. The biggest cost block is the preparation course – anyone who learns the theory themselves with the official ELWIS catalog saves exactly that item.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-kpi">€130.78</p>
          <p class="pg-card-text">Official exam fee</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi">≈ €500–650</p>
          <p class="pg-card-text">Complete course (optional)</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">from €9.99</p>
          <p class="pg-card-text">Learn theory with Boatpass</p>
        </div>
      </div>
      <PageLink lang="en" href="/en/sbf-costs/">All SBF costs in detail</PageLink>
    </section>

    <!-- Scope -->
    <section class="pg-section">
      <h2 class="pg-h2">Where may I navigate with the SBF Inland?</h2>
      <p class="pg-p">
        The SBF Inland is valid on Germany's <strong>inland waterways</strong> – i.e. rivers, canals and inland lakes. Under engine the boat length is limited to <strong>20 meters</strong>; for longer vessels you need a recreational skipper's certificate. It is not valid for the coastal waters of the North and Baltic Sea – there the SBF Coastal applies.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Where it's valid</p>
          <p class="pg-card-text">Rivers, canals and inland lakes on German inland waterways.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Requirements</p>
          <p class="pg-card-text">Minimum age 16. The license is administered by the DMYV and is valid indefinitely.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Regional limits</p>
          <p class="pg-card-text">On some areas (e.g. the Rhine) stricter power limits apply – check beforehand.</p>
        </div>
      </div>
    </section>

    <!-- Comparison Inland vs. Coastal -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Inland or Coastal – what do you need?</h2>
      <p class="pg-p">
        Inland and Coastal are two separate licenses. Anyone who wants to navigate both areas can take them together more cheaply in a
        <strong>combined exam</strong> (around €178.61 instead of twice separately).
      </p>
      <!-- min-width activates the overflow-x wrapper's horizontal scroll on narrow screens (like AppComparisonTable/CatalogSources). Without it the table was squeezed to phone width instead, crushing the three columns into unreadable multi-line cells. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">SBF Inland</th>
              <th scope="col">SBF Coastal</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.binnen}</td>
                <td>{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <PageLink lang="en" href="/en/sbf-coastal/" class="pg-link--spaced">View SBF Coastal in detail</PageLink>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the SBF Inland</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The official question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p class="pg-note pg-note--sm">
        Source: official question catalog (DSV/DMYV) on <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- How the app helps -->
    <section class="pg-section">
      <h2 class="pg-h2">How Boatpass helps with the SBF Inland</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Complete ELWIS catalog', desc: 'All 253+ official questions for SBF Inland – always up to date, right in the app.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Real exam conditions: 30 questions, 45 minutes, passing threshold – just like on exam day.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Specifically train the questions you don\'t know yet. No wasting time on content you\'ve already learned.' },
          { icon: 'chart', title: 'Progress display', desc: 'See at any time how far you are – broken down by category.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-inland-exam-questions/">Practice SBF Inland exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-inland-app/">SBF Binnen apps compared<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boating license cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory & practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-preparation-how-long/">How long do I have to study for the SBF?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-inland-vs-coastal/">SBF Inland vs. SBF Coastal – what's the difference?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/motorboat-or-sailboat-which-sbf/">Motorboat or sailboat – which SBF and which practical exam?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/right-of-way-collision-rules/">Right of way on the water – who has to give way?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sound-signals-sbf-explained/">Sound signals for the SBF: coastal & inland overview<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/navigation-lights-explained/">Navigation lights explained – which lights does a boat show at night?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/how-to-behave-in-restricted-visibility-fog/">Restricted visibility and fog: how to behave with your boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/towing-convoys-special-vessels-day-shapes/">Towing convoys and special vessels – recognizing day shapes<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/docking-undocking-harbor-maneuvers/">Docking and undocking: harbor maneuvers for beginners<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/5-tips-pass-sbf/">5 tips to pass the SBF exam on your first try<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/life-jacket-buoyancy-classes/">Choosing the right life jacket – buoyancy classes explained<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/bridge-clearance-heights-inland-waterways/">Bridge clearance heights – what to watch for on inland waterways<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/trailering-and-launching-a-boat/">Trailering and launching a boat – what boaters need to know<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/winterizing-a-boat-checklist-for-winter-storage/">Winterizing a boat – a checklist for winter storage<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/getting-your-boat-ready-spring-checklist-season-start/">Getting your boat ready in spring – a season start checklist<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/water-skiing-wakeboarding-rules-observer-duty/">Water skiing and wakeboarding – rules, observer duty, and markings<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/conduct-after-a-boating-accident-duties-and-reporting/">Conduct after a boating accident – duties, reporting and evidence<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/fines-violations-on-the-water/">Fines and violations on the water – the costliest mistakes and their consequences<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/minimum-age-children-boat-germany/">What minimum age applies to children driving a boat in Germany?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/navigating-locks-procedure-behavior-boaters/">Navigating locks: procedure and behavior for recreational boaters<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/environmental-protection-boating-water-conservation/">Environmental protection and water conservation for boaters<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boating-at-night/">Boating at night: how to stay safe after sunset<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boat-wake-wash-liability/">Boat wake and suction: consideration and liability on the water<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
