---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeBridge from '../../components/PracticeBridge.astro';
import PageHead from '../../components/page/PageHead.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import BoatSchoolFinder from '../../components/BoatSchoolFinder.astro';
import type { IconName } from '../../icons';
import { PLAY_STORE_URL, schemaOffers } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Coastal", "item": "https://boatpass.de/en/sbf-coastal/" },
  ],
};

const faqs = [
  {
    q: 'Where is the SBF Coastal valid?',
    a: 'The SBF Coastal is valid on Germany\'s maritime waterways: the North and Baltic Sea coastal waters up to three nautical miles off the mainland coast, and the fairways within the twelve-nautical-mile zone. It also covers the seaward estuaries of the Ems, Weser, Elbe, Trave and Warnow and the Kiel Canal; unlike the SBF Inland, there is no limit on boat length.',
  },
  {
    q: 'How does the SBF Coastal theory exam work?',
    a: 'The theory consists of a paper of 30 multiple-choice questions (7 basic questions + 23 specific coastal questions) plus a navigation task with 9 individual questions – 60 minutes in total. You pass with at least 23 of 30 correct answers in the paper (5 of 7 basic and 18 of 23 specific coastal questions) and at least 7 of 9 correct answers in the navigation task.',
  },
  {
    q: 'What is the navigation task?',
    a: 'In the navigation task you work with an official training chart: plotting courses, determining your own position, accounting for wind and current set and factoring in tides. It is considered the most demanding part of the exam – which is why you practice it specifically and separately from the question paper with Boatpass.',
  },
  {
    q: 'What requirements do I have to meet?',
    a: 'The minimum age for the SBF Coastal under engine is 16. A driving school is not required – the official ELWIS question catalog is freely available, so you can learn the theory independently. For the practical part, at least one day of practice on the water is recommended.',
  },
  {
    q: 'Is it worth combining with the SBF Inland?',
    a: 'Yes. Anyone who takes Inland and Coastal together in a combined exam pays around €178.61 – significantly less than for two individual exams (€130.78 + €148.38). Many basic questions are identical, so the study effort for both licenses overlaps strongly.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is the SBF Coastal?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SBF Coastal",
  "alternateName": "German coastal boating license",
  "description": "The coastal boating license (SBF Coastal) permits navigation on maritime waterways – the North and Baltic Sea within the 3-nautical-mile zone. It is the prerequisite for operating recreational boats in the German coastal area.",
  "url": "https://boatpass.de/en/sbf-coastal/",
  "inLanguage": "en",
};

// Course schema: clearly marks the page as a learning course for the SBF Coastal
// (in addition to the app markup). All details mirror the page content.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Coastal Exam Preparation",
  "description": "Complete preparation for the theory exam of the German coastal boating license (SBF Coastal) with the full official ELWIS question catalog, exam simulation and targeted training of the navigation task (chartwork).",
  "url": "https://boatpass.de/en/sbf-coastal/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Maritime law and collision regulations",
    "Navigation marks and lights",
    "Navigation and chartwork",
    "Tides and current set",
    "Official SBF Coastal question catalog incl. navigation task",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT15H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('sbfSee'),
};

// Direct comparison Inland vs. Coastal as a decision aid
const compare = [
  { label: 'Area', binnen: 'Rivers, canals & inland lakes', see: 'Coastal waters of North & Baltic Sea' },
  { label: 'Mandatory from', binnen: '11.03 kW (15 HP)', see: '11.03 kW (15 HP)' },
  { label: 'Boat length', binnen: 'under engine max. 20 m', see: 'no limit' },
  { label: 'Theory exam', binnen: '30 questions · 45 min', see: '30 questions + navigation · 60 min' },
  { label: 'Navigation task', binnen: '–', see: 'yes (chart task)' },
  { label: 'Exam fee 2026', binnen: '€130.78', see: '€148.38' },
  { label: 'Minimum age', binnen: '16 years', see: '16 years' },
];

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & collision regulations', count: 130, icon: 'scale' },
  { name: 'Navigation & charts', desc: 'Chartwork, courses, tides & current', count: 72, icon: 'compass' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 40, icon: 'shield' },
  { name: 'Signals & marks', desc: 'Sound, visual and sea marks', count: 28, icon: 'bell' },
  { name: 'Meteorology', desc: 'Wind, weather, tide tables & forecasting', count: 10, icon: 'cloud' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 5, icon: 'document' },
  { name: 'Navigation tasks', desc: '15 chart tasks of 9 questions each: courses, position, tides & current set', count: 135, icon: 'target' },
];

---

<BaseLayout
  title="Learn SBF Coastal – Boating License App"
  description="Study for the SBF Coastal (SBF See) with the Boatpass app: official ELWIS question catalog, realistic exam simulation & navigation tasks. Start for free."
  lang="en"
  altUrl="https://boatpass.de/sbf-see/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Coastal Boating License"
    lede="Prepare for the SBF Coastal exam with the official ELWIS question catalog. Including the navigation exam – with exam simulation and targeted mistake training."
    cta
  >
    Learn SBF Coastal –<br />the smart study app
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfSee"
      items={[
        { k: 'Theory exam', v: '39 questions · 60 min' },
        { k: 'Navigation task', v: '9 questions, at least 7 correct' },
        { k: 'Pass mark', v: '5 of 7 basic, 18 of 23 specific' },
        { k: 'Exam fee 2026', v: '€148.38' },
        { k: 'Minimum age', v: '16 years' },
      ]}
    />

    <!-- Answer-Snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In short</p>
        <p class="pg-answer-text">
          The SBF Coastal (German coastal boating license) is the official permit for recreational boats on the maritime waterways of the North and Baltic Sea. The theory exam covers 39 questions in 60 minutes: a paper of 30 questions (at least 5 of 7 basic and 18 of 23 specific questions correct) plus a navigation task with 9 questions (at least 7 correct). The exam draws on the official ELWIS coastal question catalog; Boatpass trains all content including navigation with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is SBF Coastal -->
    <section class="pg-section">
      <h2 class="pg-h2">What is the SBF Coastal?</h2>
      <p class="pg-p">
        The <strong>coastal boating license (SBF Coastal)</strong> permits navigation on maritime waterways – the North and Baltic Sea within the 3-nautical-mile zone. It is the prerequisite for operating recreational boats in the German coastal area and the basis for the <strong>ICC (International Certificate of Competence)</strong>.
      </p>
      <p class="pg-p">
        The SBF Coastal can be obtained separately or combined with the SBF Inland. The combination is possible in a single exam and is cheaper than two individual exams.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section class="pg-section">
      <CatalogSources lang="en" only="see" />
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Coastal exam: structure & passing threshold</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theory exam</p>
          <p class="pg-card-text">39 questions · 60 minutes<br>incl. navigation</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basic questions</p>
          <p class="pg-card-text">7 questions<br>at least 5 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Navigation questions</p>
          <p class="pg-card-text">9 questions<br>at least 7 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Question catalog</p>
          <p class="pg-card-text">Official<br>ELWIS coastal catalog</p>
        </div>
      </div>
      <p class="pg-note">
        The SBF Coastal includes a <strong>navigation task</strong> – this is the most demanding part of the exam. Boatpass trains all question types in a targeted way. The official exam fee in 2026 is <strong>€148.38</strong> (theory + practice).
      </p>
    </section>

    <PracticeBridge variant="navigation" lang="en" />

    <!-- Process: practice & registration -->
    <section class="pg-section">
      <h2 class="pg-h2">Process: from registration to the practical part</h2>
      <p class="pg-p">
        You register with a recognized examination board (e.g. DMYV). First you take the theory exam incl. navigation task, then comes the <strong>practical exam</strong> on the water.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Registration</p>
          <p class="pg-card-text">Application to the examination board, passport photo and ID – minimum age 16.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Practical maneuvers</p>
          <p class="pg-card-text">Coming alongside and casting off, turning, stopping and the man-overboard maneuver.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title"><a href="/en/blog/most-important-knots-sbf/" class="pg-card-link">Knots</a></p>
          <p class="pg-card-text">Apply the exam-relevant knots quickly (e.g. bowline, clove hitch, cleat).</p>
        </div>
      </div>
      <PageLink lang="en" href="/en/sbf-exam/">Exam process step by step</PageLink>
    </section>

    <!-- Find a boat school -->
    <BoatSchoolFinder lang="en" variant="see" />

    <!-- Costs compact -->
    <section class="pg-section">
      <h2 class="pg-h2">What does the SBF Coastal cost?</h2>
      <p class="pg-p">
        Only the official <strong>exam fee of €148.38</strong> (theory + practice) is fixed. The biggest cost block is the preparation course – anyone who learns the theory themselves with the official ELWIS catalog saves exactly that item.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-kpi">€148.38</p>
          <p class="pg-card-text">Official exam fee</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi">≈ €500–650</p>
          <p class="pg-card-text">Complete course (optional)</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">from €9.99</p>
          <p class="pg-card-text">Learn theory with Boatpass</p>
        </div>
      </div>
      <PageLink lang="en" href="/en/sbf-costs/">All SBF costs in detail</PageLink>
    </section>

    <!-- Scope -->
    <section class="pg-section">
      <h2 class="pg-h2">Where may I navigate with the SBF Coastal?</h2>
      <p class="pg-p">
        The SBF Coastal is valid on the <strong>maritime waterways</strong>: the coastal waters of the North and Baltic Sea up to three nautical miles off the mainland coast, the fairways within the twelve-nautical-mile zone, as well as the seaward estuaries of the Ems, Weser, Elbe, Trave and Warnow and the Kiel Canal. Unlike the SBF Inland, there is no limit on boat length.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Where it's valid</p>
          <p class="pg-card-text">Coastal waters of the North and Baltic Sea, estuary areas and the Kiel Canal.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Requirements</p>
          <p class="pg-card-text">Minimum age 16 under engine. The basis for the international ICC certificate.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Special feature</p>
          <p class="pg-card-text">An additional navigation task with a chart, course calculation and tides.</p>
        </div>
      </div>
    </section>

    <!-- Comparison Inland vs. Coastal -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Coastal or Inland – what do you need?</h2>
      <p class="pg-p">
        Coastal and Inland are two separate licenses. Anyone who wants to navigate both areas can take them together more cheaply in a
        <strong>combined exam</strong> (around €178.61 instead of twice separately).
      </p>
      <!-- min-width activates the overflow-x wrapper's horizontal scroll on narrow screens (like AppComparisonTable/CatalogSources). Without it the table was squeezed to phone width instead, crushing the three columns into unreadable multi-line cells. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">SBF Inland</th>
              <th scope="col">SBF Coastal</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.binnen}</td>
                <td>{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <PageLink lang="en" href="/en/sbf-inland/" class="pg-link--spaced">View SBF Inland in detail</PageLink>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the SBF Coastal</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The official ELWIS question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas (incl. 15 navigation tasks of 9 questions each) – practice in a targeted way based on your weak spots.
      </p>
      <p class="pg-note pg-note--sm">
        Source: official question catalog (DSV/DMYV) on <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- How the app helps -->
    <section class="pg-section">
      <h2 class="pg-h2">How Boatpass helps with the SBF Coastal</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Complete ELWIS coastal catalog', desc: 'All official questions for the SBF Coastal – including navigation – always up to date.' },
          { icon: 'compass', title: 'Practice navigation questions specifically', desc: 'The navigation tasks are the hardest part. Boatpass trains them separately.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Real exam conditions: 39 questions, 60 minutes, separate passing thresholds – just like on exam day.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Only practice the questions you don\'t know yet – no wasting time.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-coastal-exam-questions/">Practice SBF Coastal exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal-app/">SBF See apps compared<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boating license cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory & practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-inland-vs-coastal/">SBF Inland vs. SBF Coastal – what's the difference?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-preparation-how-long/">How long do I have to study for the SBF?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/anchoring-basics-anchor-types-mistakes/">Anchoring basics – anchor types and common mistakes<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/how-to-read-a-nautical-chart/">How to read a nautical chart – symbols, depths and scales<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/course-conversion-sbf-coastal/">Course conversion for the SBF Coastal: true, magnetic & compass course explained<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/tides-rule-of-twelfths/">Calculating tides with the rule of twelfths – simply explained<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/using-currents-and-tides-for-trip-planning/">Using currents and tides for trip planning – the basics<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/gps-chartplotter-vhf-modern-navigation/">GPS, chartplotters, and VHF radio – understanding modern onboard navigation<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/bearing-collision-course-cpa-explained/">Bearing and collision course – CPA explained simply<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sea-marks-lateral-system-explained/">Sea marks & the lateral system explained – buoys, cardinal marks & co.<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/navigation-lights-explained/">Navigation lights explained – which lights does a boat show at night?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/towing-convoys-special-vessels-day-shapes/">Towing convoys and special vessels – recognizing day shapes<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/how-to-behave-in-restricted-visibility-fog/">Restricted visibility and fog: how to behave with your boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/buoyage-north-sea-vs-baltic-sea/">Buoyage North Sea vs. Baltic Sea: differences in the lateral system<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/weather-beaufort-scale/">Weather knowledge & the Beaufort scale for the SBF Coastal<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/marine-weather-report-warnings-weather-services-for-skippers/">Using the marine weather report and weather warnings – weather services for skippers<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/thunderstorms-lightning-on-the-water/">Thunderstorms and lightning on the water – how to prepare and stay safe<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/life-jacket-buoyancy-classes/">Choosing the right life jacket – buoyancy classes explained<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/fkn-pyrotechnic-distress-signals/">FKN and pyrotechnics on board: distress signal devices explained<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sks-coastal-skippers-license/">Sports Coastal Skipper's License (SKS): the next step after the SBF Coastal<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sound-signals-sbf-explained/">Sound signals for the SBF Coastal exam – the most common mix-ups<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/distress-signals-at-sea/">Distress signals at sea – what you need to know for the exam<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boating-regions-in-germany/">Boating regions in Germany – where can you go?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/water-skiing-wakeboarding-rules-observer-duty/">Water skiing and wakeboarding – rules, observer duty, and markings<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/conduct-after-a-boating-accident-duties-and-reporting/">Conduct after a boating accident – duties, reporting and evidence<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/fines-violations-on-the-water/">Fines and violations on the water – the costliest mistakes and their consequences<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/minimum-age-children-boat-germany/">What minimum age applies to children driving a boat in Germany?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/environmental-protection-boating-water-conservation/">Environmental protection and water conservation for boaters<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boating-at-night/">Boating at night: how to stay safe after sunset<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
