---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import BoatSchoolFinder from '../../components/BoatSchoolFinder.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Coastal", "item": "https://boatpass.de/en/sbf-coastal/" },
  ],
};

const faqs = [
  {
    q: 'Where is the SBF Coastal valid?',
    a: 'The SBF Coastal permits navigation on the maritime waterways – the coastal waters of the North and Baltic Sea up to three nautical miles off the mainland coast, the fairways within the twelve-nautical-mile zone, as well as the seaward estuaries of the Ems, Weser, Elbe, Trave and Warnow and the Kiel Canal. Unlike the SBF Inland, there is no limit on boat length.',
  },
  {
    q: 'How does the SBF Coastal theory exam work?',
    a: 'The theory consists of a paper of 30 multiple-choice questions (7 basic questions + 23 specific coastal questions) plus a navigation task with 9 individual questions – 60 minutes in total. You pass with at least 23 of 30 correct answers in the paper (5 of 7 basic and 18 of 23 specific coastal questions) and at least 7 of 9 correct answers in the navigation task.',
  },
  {
    q: 'What is the navigation task?',
    a: 'In the navigation task you work with an official training chart: plotting courses, determining your own position, accounting for wind and current set and factoring in tides. It is considered the most demanding part of the exam – which is why you practice it specifically and separately from the question paper with Boatpass.',
  },
  {
    q: 'What requirements do I have to meet?',
    a: 'The minimum age for the SBF Coastal under engine is 16. A driving school is not required – the official ELWIS question catalog is freely available, so you can learn the theory independently. For the practical part, at least one day of practice on the water is recommended.',
  },
  {
    q: 'Is it worth combining with the SBF Inland?',
    a: 'Yes. Anyone who takes Inland and Coastal together in a combined exam pays around €178.61 – significantly less than for two individual exams (€130.78 + €148.38). Many basic questions are identical, so the study effort for both licenses overlaps strongly.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// Course schema: clearly marks the page as a learning course for the SBF Coastal
// (in addition to the app markup). All details mirror the page content.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Coastal Exam Preparation",
  "description": "Complete preparation for the theory exam of the German coastal boating license (SBF Coastal) with the full official ELWIS question catalog, exam simulation and targeted training of the navigation task (chartwork).",
  "url": "https://boatpass.de/en/sbf-coastal/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Maritime law and collision regulations",
    "Navigation marks and lights",
    "Navigation and chartwork",
    "Tides and current set",
    "Official SBF Coastal question catalog incl. navigation task",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT15H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "9.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

// Direct comparison Inland vs. Coastal as a decision aid
const compare = [
  { label: 'Area', binnen: 'Rivers, canals & inland lakes', see: 'Coastal waters of North & Baltic Sea' },
  { label: 'Mandatory from', binnen: '11.03 kW (15 HP)', see: '11.03 kW (15 HP)' },
  { label: 'Boat length', binnen: 'under engine max. 20 m', see: 'no limit' },
  { label: 'Theory exam', binnen: '30 questions · 45 min', see: '30 questions + navigation · 60 min' },
  { label: 'Navigation task', binnen: '–', see: 'yes (chart task)' },
  { label: 'Exam fee 2026', binnen: '€130.78', see: '€148.38' },
  { label: 'Minimum age', binnen: '16 years', see: '16 years' },
];

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & collision regulations', count: 130, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation & charts', desc: 'Chartwork, courses, tides & current', count: 72, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 40, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signals & marks', desc: 'Sound, visual and sea marks', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Meteorology', desc: 'Wind, weather, tide tables & forecasting', count: 10, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 5, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
  { name: 'Navigation tasks', desc: '15 chart tasks of 9 questions each: courses, position, tides & current set', count: 135, icon: 'target', color: '#2563EB', bg: 'rgba(37,99,235,0.10)' },
];

const navPoints: { icon: IconName; title: string; desc: string }[] = [
  { icon: 'compass', title: 'A method, not guesswork', desc: 'Every chart task follows the same calculation steps. You learn the procedure – not 15 individual cases by heart.' },
  { icon: 'refresh', title: 'Repeat as often as you like', desc: 'All 15 navigation tasks of 9 questions each can be practiced separately from the question paper – as often as it takes for the procedure to stick.' },
  { icon: 'check', title: 'Instant feedback', desc: 'After each step you see whether your result is right – with an explanation, not just "correct/incorrect".' },
];
---

<BaseLayout
  title="Learn SBF Coastal – Boating License App"
  description="Study for the SBF Coastal with the Boatpass app. Official ELWIS question catalog, exam simulation & navigation. Start for free."
  lang="en"
  altUrl="https://boatpass.de/sbf-see/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Coastal Boating License
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Learn SBF Coastal –<br>the smart study app
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:560px; margin:0 auto 36px;">
        Prepare for the SBF Coastal exam with the official ELWIS question catalog.
        Including the navigation exam – with exam simulation and targeted mistake training.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Free on the Play Store
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer-Snippet: short, quotable direct answer for search engines & AI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">In short</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          The SBF Coastal (German coastal boating license) is the official permit for recreational boats on the maritime waterways of the North and Baltic Sea. The theory exam covers 39 questions in 60 minutes: a paper of 30 questions (at least 5 of 7 basic and 18 of 23 specific questions correct) plus a navigation task with 9 questions (at least 7 correct). The exam draws on the official ELWIS coastal question catalog; Boatpass trains all content including navigation with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is SBF Coastal -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">What is the SBF Coastal?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The <strong>coastal boating license (SBF Coastal)</strong> permits navigation on maritime waterways – the North and Baltic Sea within the 3-nautical-mile zone. It is the prerequisite for operating recreational boats in the German coastal area and the basis for the <strong>ICC (International Certificate of Competence)</strong>.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        The SBF Coastal can be obtained separately or combined with the SBF Inland. The combination is possible in a single exam and is cheaper than two individual exams.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="en" only="see" />
    </section>

    <!-- Exam structure -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">SBF Coastal exam: structure & passing threshold</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theory exam</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">39 questions · 60 minutes<br>incl. navigation</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basic questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 questions<br>at least 5 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Navigation questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">9 questions<br>at least 7 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Question catalog</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Official<br>ELWIS coastal catalog</div>
        </div>
      </div>
      <p style="font-size:15px; color:#6B7280; line-height:1.7;">
        The SBF Coastal includes a <strong>navigation task</strong> – this is the most demanding part of the exam. Boatpass trains all question types in a targeted way. The official exam fee in 2026 is <strong>€148.38</strong> (theory + practice).
      </p>
    </section>

    <!-- Practice bridge: mastering chart tasks digitally -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Mastering chart tasks digitally – can I do it without a course?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        The navigation task is considered the hardest part of the exam – but it's not a gut feeling, it's a fixed scheme: lay out the course, determine your position, factor in wind and current set as well as tides. Repetitive tasks like these are often easier to learn on your phone than in a book.
      </p>
      <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:18px;">
        {navPoints.map(p => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={p.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{p.title}</div>
              <div style="font-size:14px; color:#4B5563; line-height:1.6;">{p.desc}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="display:flex; align-items:flex-start; gap:14px; background:linear-gradient(160deg,#F4F7FE 0%,#EAF0FC 100%); border:1px solid rgba(51,102,255,0.16); border-radius:16px; padding:20px 24px;">
        <span style="flex-shrink:0; margin-top:1px;"><Icon name="lifebuoy" size={20} stroke="#3366FF" strokeWidth={1.75} /></span>
        <p style="font-size:14px; color:#4B5563; line-height:1.65; margin:0;">For the practical chartwork on exam day you need a training chart, dividers and a course plotter. The calculation method you bring with you confidently via Boatpass – you go into the task with routine, not hope.</p>
      </div>
    </section>

    <!-- Process: practice & registration -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Process: from registration to the practical part</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        You register with a recognized examination board (e.g. DMYV). First you take the theory exam incl. navigation task, then comes the <strong>practical exam</strong> on the water.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Registration</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Application to the examination board, passport photo and ID – minimum age 16.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Practical maneuvers</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Coming alongside and casting off, turning, stopping and the man-overboard maneuver.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;"><a href="/en/blog/most-important-knots-sbf/" style="color:inherit; text-decoration:underline;">Knots</a></div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Apply the exam-relevant knots quickly (e.g. bowline, clove hitch, cleat).</div>
        </div>
      </div>
      <a href="/en/sbf-exam/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">Exam process step by step →</a>
    </section>

    <!-- Find a boat school -->
    <BoatSchoolFinder lang="en" variant="see" />

    <!-- Costs compact -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">What does the SBF Coastal cost?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Only the official <strong>exam fee of €148.38</strong> (theory + practice) is fixed. The biggest cost block is the preparation course – anyone who learns the theory themselves with the official ELWIS catalog saves exactly that item.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">€148.38</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Official exam fee</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">≈ €500–650</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Complete course (optional)</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#3366FF;">from €9.99</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.55; margin-top:4px;">Learn theory with Boatpass</div>
        </div>
      </div>
      <a href="/en/sbf-costs/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">All SBF costs in detail →</a>
    </section>

    <!-- Scope -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Where may I navigate with the SBF Coastal?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        The SBF Coastal is valid on the <strong>maritime waterways</strong>: the coastal waters of the North and Baltic Sea up to three nautical miles off the mainland coast, the fairways within the twelve-nautical-mile zone, as well as the seaward estuaries of the Ems, Weser, Elbe, Trave and Warnow and the Kiel Canal. Unlike the SBF Inland, there is no limit on boat length.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Where it's valid</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Coastal waters of the North and Baltic Sea, estuary areas and the Kiel Canal.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Requirements</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">Minimum age 16 under engine. The basis for the international ICC certificate.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Special feature</div>
          <div style="font-size:15px; color:#6B7280; line-height:1.65;">An additional navigation task with a chart, course calculation and tides.</div>
        </div>
      </div>
    </section>

    <!-- Comparison Inland vs. Coastal -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">SBF Coastal or Inland – what do you need?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Coastal and Inland are two separate licenses. Anyone who wants to navigate both areas can take them together more cheaply in a
        <strong>combined exam</strong> (around €178.61 instead of twice separately).
      </p>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:15px; background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; overflow:hidden;">
          <thead>
            <tr style="background:rgba(26,31,54,0.04);">
              <th style="text-align:left; padding:14px 18px; font-weight:700; color:#1A1F36;"></th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF Inland</th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF Coastal</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr style={`border-top:1px solid rgba(51,102,255,0.08);${i % 2 ? ' background:rgba(26,31,54,0.02);' : ''}`}>
                <td style="padding:13px 18px; font-weight:600; color:#1A1F36;">{row.label}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.binnen}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/en/sbf-inland/" style="display:inline-flex; align-items:center; gap:8px; margin-top:18px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">View SBF Inland in detail →</a>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Frequently asked questions about the SBF Coastal</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:16px; padding:22px;">
            <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</h3>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Learn by category</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        The official ELWIS question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas (incl. 15 navigation tasks of 9 questions each) – practice in a targeted way based on your weak spots.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
        Source: official question catalog (DSV/DMYV) on <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
