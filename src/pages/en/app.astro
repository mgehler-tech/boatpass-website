  title="Get the BoatPass app – iPhone, iPad & Android"
  description="Get the BoatPass app for the German boating licence (SBF Inland & Coastal): free on the App Store for iPhone and iPad or on Google Play for Android."
  lang="en"
  altUrl="https://boatpass.de/app/"
  noindex={true}
  showCta={false}
>
  <AppChooser lang="en" />
</BaseLayout>
