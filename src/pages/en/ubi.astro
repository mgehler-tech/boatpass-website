---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeBridge from '../../components/PracticeBridge.astro';
import PageHead from '../../components/page/PageHead.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import type { IconName } from '../../icons';
import PlatformPrice from '../../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "UBI Radio Certificate", "item": "https://boatpass.de/en/ubi/" },
  ],
};

// Course schema: clearly marks the page as a learning course for the UBI.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "UBI Exam Preparation – VHF Radio Certificate Inland",
  "description": "Preparation for the exam for the VHF radio certificate for inland navigation (UBI) with the official question catalog (130 questions), exam simulation and mistake training.",
  "url": "https://boatpass.de/en/ubi/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Inland navigation radio and traffic circuits",
    "Radio equipment and ATIS",
    "Distress, urgency and safety traffic",
    "Radio operating procedures and priorities",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT6H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('ubi'),
};

const faqs = [
  {
    q: 'How many questions does the UBI exam have and how many do I need to get right?',
    a: 'The theoretical UBI exam consists of a paper with 22 multiple-choice questions that you answer in 60 minutes – passed from 17 correct answers. Added to that is a practical part with mandatory tasks such as ATIS setup, equipment knowledge as well as distress, urgency and safety messages. Boatpass trains the complete official question catalog with 130 questions.',
  },
  {
    q: 'What does the UBI cost?',
    a: 'The official total fee for the UBI is €108.71, made up of admission (€15.89), the theory & practice exam (€70.03) and issuance of the certificate (€22.79). A retake of theory or practice costs €45.64. These official fees are independent of the Boatpass UBI learning module (one-time ' + priceText('ubi', 'en') + ').',
  },
  {
    q: 'Do I need a radio course for the UBI?',
    a: 'No. A preparation course is not required – the official question catalog is freely available, so you can learn the theory independently, for example with the Boatpass UBI module. For the practical radio part, some prior practice on the device is advisable.',
  },
  {
    q: 'From what age can I take the UBI?',
    a: 'The minimum age for the UBI exam is 15. The UBI is independent of the SBF Inland and can be obtained separately.',
  },
  {
    q: 'UBI or SRC – which radio certificate do I need?',
    a: 'The UBI covers VHF radio on inland waterways, while the SRC covers VHF marine radio in the coastal area. The two are not mutually creditable. However, anyone who already holds a marine radio certificate (SRC or LRC) gets a shortened theoretical and practical UBI exam.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is the UBI?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "UBI",
  "alternateName": "VHF radio certificate for inland navigation",
  "description": "The VHF radio certificate for inland navigation (UBI) is the official or officially recognized authorization to operate and supervise a ship's radio station on inland waterways.",
  "url": "https://boatpass.de/en/ubi/",
  "inLanguage": "en",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Traffic circuits', desc: 'Channel and area radio, route radio on inland waterways', count: 30, icon: 'wifi' },
  { name: 'Operating procedures', desc: 'Call handling, priorities & speaking procedures', count: 29, icon: 'microphone' },
  { name: 'ATIS & technology', desc: 'Automatic transmitter identification and equipment knowledge', count: 25, icon: 'satellite' },
  { name: 'Distress & safety', desc: 'Distress calls, urgency and safety traffic', count: 24, icon: 'shield' },
  { name: 'Radio & regulations', desc: 'Frequencies, licensing law & radio regulations', count: 22, icon: 'scale' },
];

---

<BaseLayout
  title="UBI Study App – Inland Radio Certificate"
  description={`Learn the UBI VHF radio certificate for inland waters: exam, contents, prep. Boatpass UBI module, one-time from ${minPrice(['ubi'], 'en')} with exam simulation – start today.`}
  lang="en"
  altUrl="https://boatpass.de/ubi/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="VHF Radio Certificate (Inland)"
    lede="The VHF radio certificate for inland navigation (UBI) is mandatory for anyone who wants to operate a radio on board. Here you'll find everything about the exam – and how the Boatpass UBI module prepares you optimally."
    ctaLabel="Start learning UBI in the app"
    cta
  >
    Learn UBI –<br />everything about the radio certificate
    <span slot="badge">Boatpass UBI module – now available · one-time&nbsp;<PlatformPrice product="ubi" lang="en" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="ubi"
      items={[
        { k: 'Question catalogue', v: '130 questions' },
        { k: 'Theory', v: '60 min, pass from 17 correct' },
        { k: 'Exam format', v: 'Written + practical (DSV)' },
        { k: 'Exam fee', v: '€108.71' },
        { k: 'Minimum age', v: '15 years' },
      ]}
    />

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In a nutshell</p>
        <p class="pg-answer-text">
          The UBI (VHF radio certificate for inland navigation) permits the operation of VHF radio equipment on inland waterways. The exam consists of a theory part with 22 multiple-choice questions in 60 minutes – passed from 17 correct answers – and a practical part with mandatory tasks (ATIS setup, equipment knowledge, and distress, urgency and safety messages). Minimum age: 15. Boatpass trains the complete official question catalog (130 questions) with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is UBI -->
    <section class="pg-section">
      <h2 class="pg-h2">What is the UBI?</h2>
      <p class="pg-p">
        The <strong>VHF radio certificate for inland navigation (UBI)</strong> is the official or officially recognized authorization to operate and supervise a ship's radio station on inland waterways. The exam is administered by the examination boards of the German Sailing Association (DSV). Minimum age: 15.
      </p>
      <p class="pg-p">
        The UBI is <strong>independent of the SBF Inland</strong> – you can obtain it separately. In practice, however, preparing for both together is advisable, since many inland boaters need both certificates.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section class="pg-section">
      <CatalogSources lang="en" only="ubi" />
    </section>

    <!-- Who needs it -->
    <section class="pg-section">
      <h2 class="pg-h2">Who needs the UBI?</h2>
      <div class="pg-rows">
        {([
          { icon: 'anchor', title: 'Inland radio requirement', desc: 'Anyone operating a VHF radio installation on inland waterways' },
          { icon: 'lifebuoy', title: 'Busy areas', desc: 'Recreational boaters traveling on the Rhine, Elbe or Danube' },
          { icon: 'satellite', title: 'AIS transmit operation', desc: 'Anyone using AIS devices (Automatic Identification System) with transmit operation' },
          { icon: 'home', title: 'Houseboats & charter', desc: 'Charterers of houseboats and larger motorboats on inland waterways' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">UBI exam: structure & contents</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Exam format</p>
          <p class="pg-card-text">Written + practical<br>DSV examination board</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Theory</p>
          <p class="pg-card-text">Multiple choice<br>Area & operating knowledge</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Practice</p>
          <p class="pg-card-text">Speaking exercises<br>Distress calls & procedures</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Exam fee</p>
          <p class="pg-card-text">approx. €109<br>full exam (DSV)</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Exam topics:</strong> traffic circuits as well as the priority and types of radio traffic, frequencies and their use, automatic transmitter identification system (ATIS), distress, urgency and safety traffic, plus operation and technology of the radio installation.
        </p>
      </div>
      <div class="pg-card pg-card--note pg-card--hint">
        <span class="pg-row-icon pg-row-icon--hint"><Icon name="lightbulb" size={20} strokeWidth={1.75} /></span>
        <p class="pg-note">
          <strong>Already have a marine radio certificate?</strong> For holders of the <a href="/en/src/" class="pg-inline-link">SRC</a> or <a href="/en/lrc/" class="pg-inline-link">LRC</a>, the theory and practical UBI exams are shortened – both exams may even be possible in a single day.
        </p>
      </div>
    </section>

    <PracticeBridge variant="radio" lang="en" />

    <!-- Costs in detail -->
    <section class="pg-section">
      <h2 class="pg-h2">What does the UBI cost?</h2>
      <p class="pg-p">
        The official exam fee is made up of three items. Here's what you pay for what:
      </p>
      <div class="pg-fees">
        {[
          { label: 'Admission to the exam', desc: 'Application processing & admission by the examination board', price: '€15.89' },
          { label: 'Theory & practice exam', desc: 'Administration of the written and practical exam', price: '€70.03' },
          { label: 'Issuance of the radio certificate', desc: 'Issuing the official UBI certificate', price: '€22.79' },
        ].map(row => (
          <div class="pg-fee">
            <div>
              <p class="pg-fee-label">{row.label}</p>
              <p class="pg-fee-desc">{row.desc}</p>
            </div>
            <p class="pg-fee-price h-num">{row.price}</p>
          </div>
        ))}
        <div class="pg-fee pg-fee--total">
          <p class="pg-fee-label">Total (incl. VAT)</p>
          <p class="pg-fee-price pg-fee-price--accent h-num">€108.71</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        Fees as per the DSV. Retake of theory <u>or</u> practice: €45.64. For exams abroad, additional travel costs may apply. These official fees are independent of the Boatpass UBI learning module (one-time {priceText('ubi', 'en')}).
      </p>
    </section>

    <!-- How Boatpass helps with the UBI -->
    <section class="pg-section">
      <h2 class="pg-h2">How Boatpass helps with the UBI</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Complete UBI question catalog', desc: 'All official UBI questions on inland radio and ATIS – fully covered, always up to date.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Practice under real exam conditions with a passing threshold and time pressure.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Train only your weak spots – efficiently and in a targeted way.' },
          { icon: 'chart', title: 'Progress by category', desc: 'See, broken down by topic, how well you\'re prepared for the UBI exam.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The UBI question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p class="pg-note pg-note--sm">
        Source: official UBI question catalog 2026 (valid since 1 Oct 2026) from the issuing office, the WSV's ABVT: <a href="https://www.abvt.wsv.de/Webs/WSA/ABVT/DE/UKW-Sprechfunkzeugnisse/UBI_node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">abvt.wsv.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass UBI module available -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Now available</p>
          <h2 class="pg-h2">Boatpass UBI module</h2>
          <p class="pg-p">The UBI module for Boatpass is here – with the same learning concept as SBF Inland & Coastal: official question catalog, exam simulation and mistake training. One-time <strong><PlatformPrice product="ubi" lang="en" /></strong>, no subscription.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="ubi" lang="en" alt /></span> <span class="pg-cta-unit">one-time purchase</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            Unlock the UBI module in the app
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the UBI</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Related licenses</h2>
      <ul class="pg-related">
        <li><a href="/en/radio-certificate-app/">Radio certificate apps compared<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-inland/">Learn SBF Inland with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/src/">SRC – Short Range Certificate for marine radio<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/ubi-vs-src-radio-license/">UBI or SRC – which radio certificate fits your boat?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/ubi-question-catalog-2026/">UBI question catalog 2026: what changes on October 1<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/distress-signals-at-sea/">Distress signals at sea: what you need to know<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/gps-chartplotter-vhf-modern-navigation/">GPS, chartplotters & VHF radio – modern onboard navigation<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
