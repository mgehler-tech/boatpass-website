---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
---

<BaseLayout
  title="Legal Notice – Boatpass Website & App Terms"
  description="Legal notice for the Boatpass website under § 5 DDG: provider, contact details and liability information. Details on our SBF study app and radio courses."
  lang="en"
  altUrl="https://boatpass.de/impressum/"
  showCta={false}
>
  <DisplayFontPreload slot="head" />
  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1/3.5) -->
  <PageHead
    lang="en"
    eyebrow="Legal"
    lede="Information pursuant to § 5 DDG (German Digital Services Act). Applies to the website boatpass.de and to the BoatPass app on Google Play and the App Store."
  >
    Legal Notice
  </PageHead>

  <PageLayout variant="narrow">

    <!-- Card: Provider -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Provider</h2>
      <p class="pg-p pg-p--sm pg-strong">Marius Gehler</p>
      <p class="pg-p pg-p--sm">
        Blissestraße 56<br />
        10713 Berlin<br />
        Germany
      </p>
    </div>

    <!-- Card: Contact -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Contact</h2>
      <p class="pg-p pg-p--sm"><a href="mailto:support@boatpass.de" class="pg-inline-link">support@boatpass.de</a></p>
      <p class="pg-p pg-p--sm">
        or via the <a href="/en/contact/" class="pg-inline-link">contact form</a>
      </p>
    </div>

    <!-- Card: Responsible under MStV (the study guide blog is a journalistic-editorial service) -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Responsible for content under § 18(2) MStV</h2>
      <p class="pg-p pg-p--sm">
        Marius Gehler<br />
        Blissestraße 56, 10713 Berlin, Germany
      </p>
    </div>

    <!-- Card: Liability for content -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Liability for content</h2>
      <p class="pg-p pg-p--sm">
        The content of this website has been created with the greatest care. However, we cannot guarantee the accuracy, completeness, or timeliness of the content. As a service provider, we are responsible for our own content on these pages in accordance with general law pursuant to § 7(1) DDG.
      </p>
    </div>

    <!-- Card: Liability for links -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Liability for links</h2>
      <p class="pg-p pg-p--sm">
        Our website contains links to external third-party websites over whose content we have no control. We therefore cannot accept any liability for this external content. The respective provider or operator of the linked pages is always responsible for their content.
      </p>
    </div>

    <!-- Card: Copyright -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-card-label">Copyright</h2>
      <p class="pg-p pg-p--sm">
        The content and works created by the site operators on these pages are subject to German copyright law. Reproduction, editing, distribution, and any kind of exploitation outside the limits of copyright law require the written consent of the respective author or creator.
      </p>
    </div>

  </PageLayout>
</BaseLayout>
