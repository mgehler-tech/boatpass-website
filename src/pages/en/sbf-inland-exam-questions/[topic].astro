---
// Themenseiten der Prüfungsfragen (Vorlage: components/catalog/CatalogTopicPage).
import CatalogTopicPage from '../../../components/catalog/CatalogTopicPage.astro';
import { TOPICS, type Topic } from '../../../data/catalog';

export function getStaticPaths() {
  return TOPICS.binnen.map(topic => ({ params: { topic: topic.slug.en }, props: { topic } }));
}

const { topic } = Astro.props as { topic: Topic };
---

<CatalogTopicPage lang="en" catalog="binnen" topic={topic} />
