---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SRC Marine Radio", "item": "https://boatpass.de/en/src/" },
  ],
};

// Course schema: clearly marks the page as a learning course for the SRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SRC Exam Preparation – Short Range Certificate (Marine Radio)",
  "description": "Preparation for the Short Range Certificate (SRC) exam for VHF marine radio with DSC in the coastal area – with the official ELWIS question catalog (180 questions), exam simulation and mistake training.",
  "url": "https://boatpass.de/en/src/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "VHF marine radio and operating procedures",
    "DSC procedures (Digital Selective Calling)",
    "Distress, urgency and safety traffic in the GMDSS",
    "Radio regulations and frequency use",
    "Equipment knowledge and operation of VHF marine radios",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT8H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "7.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

const faqs = [
  {
    q: 'How does the SRC exam work?',
    a: 'The theoretical SRC exam comprises a paper with 24 multiple-choice questions in 30 minutes – passed from 19 correct answers. Added to that are the written recording of a distress, urgency or safety message and a practical part with four tasks on the DSC radio. The exam draws on the official ELWIS question catalog with 180 questions, which Boatpass trains in full.',
  },
  {
    q: 'What does the SRC cost?',
    a: 'The official exam fee for the SRC at the DSV/DMYV is currently around €127.88 (admission, exam and issuance of the certificate). An optional preparation course at a radio school costs an additional €250–350 but is not mandatory. These fees are independent of the Boatpass SRC learning module (one-time €7.99).',
  },
  {
    q: 'SRC or UBI – which radio certificate do I need?',
    a: 'The SRC is the VHF marine radio certificate with DSC for the coastal area (sea area A1), while the UBI covers VHF radio on inland waterways. The two are not mutually creditable. Anyone who wants to radio on the high seas beyond VHF range needs the more extensive LRC.',
  },
  {
    q: 'From what age can I take the SRC and how long is it valid?',
    a: 'You can be admitted to the SRC exam from age 15. The SRC is administered by the examination boards of the DSV and DMYV, is internationally recognized and valid without a time limit.',
  },
  {
    q: 'Do I need a radio course for the SRC?',
    a: 'No. A preparation course is not required – you can learn the theory independently with the official question catalog, for example with the Boatpass SRC module. For the practical part, some prior practice on the DSC radio is advisable.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Operating procedures', desc: 'Call handling, priorities & speaking procedures', count: 48, icon: 'microphone', color: '#EA580C', bg: 'rgba(234,88,12,0.10)' },
  { name: 'DSC procedures', desc: 'Digital Selective Calling, distress DSC & reception', count: 38, icon: 'wifi', color: '#7C3AED', bg: 'rgba(124,58,237,0.10)' },
  { name: 'Distress & safety traffic', desc: 'Mayday, Pan-Pan, Sécurité & coordination', count: 34, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Radio regulations', desc: 'ITU regulations, frequencies & certification', count: 30, icon: 'scale', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Equipment & technology', desc: 'Setup, operation & maintenance of VHF devices', count: 30, icon: 'satellite', color: '#1D4ED8', bg: 'rgba(29,78,216,0.10)' },
];

const radioPoints: { icon: IconName; title: string; desc: string }[] = [
  { icon: 'microphone', title: 'A fixed wording', desc: 'Distress, urgency and safety messages have a fixed order. You learn the pattern – and fill it in confidently in an emergency.' },
  { icon: 'clipboard', title: 'Messages step by step', desc: 'Phonetic alphabet, call, traffic handling: you practice each building block individually until it comes without thinking.' },
  { icon: 'refresh', title: 'Confidence through repetition', desc: 'What you\'ve run through a hundred times you\'ll say automatically on exam day – the practical hurdle becomes a formality.' },
];
---

<BaseLayout
  title="SRC Study App – Learn the Short Range Certificate (Marine Radio)"
  description="Everything about the SRC (Short Range Certificate): exam structure, contents, costs and preparation. The Boatpass SRC module is now in the app – a one-time €7.99."
  lang="en"
  altUrl="https://boatpass.de/src/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Short Range Certificate · Coastal Marine Radio
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Learn SRC –<br>Short Range Certificate
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        The Short Range Certificate (SRC) is the most widely used marine radio certificate in recreational boating – mandatory for anyone who operates a VHF marine radio with DSC in the coastal area.
      </p>

      <!-- Available badge -->
      <div style="display:inline-flex; align-items:center; gap:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#047857; font-size:14px; font-weight:700; padding:10px 20px; border-radius:14px; margin-bottom:24px;">
        <Icon name="check" size={17} stroke="#047857" strokeWidth={2.5} />
        Boatpass SRC module – now available · one-time €7.99
      </div>
      <br/>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:15px; padding:14px 28px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2); margin-top:16px;">
        ▶&nbsp;Start learning SRC in the app
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">In a nutshell</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          The SRC (Short Range Certificate) is the VHF marine radio certificate with DSC for the coastal area (sea area A1). The theory exam comprises a paper of 24 multiple-choice questions in 30 minutes – passed from 19 correct answers. Added to that are the written recording of a distress, urgency or safety message and a practical part with four tasks on the radio. The exam draws on the official ELWIS question catalog (180 questions); Boatpass trains all SRC content with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is SRC -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">What is the SRC?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The <strong>Short Range Certificate (SRC)</strong> is the official authorization to participate in the worldwide maritime radio service (GMDSS) in the <strong>VHF band</strong>. It permits the operation of all VHF marine radio installations including DSC (Digital Selective Calling) with a range of around <strong>35 nautical miles</strong> (sea area A1).
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        The SRC is <strong>mandatory for sailors and motorboaters as soon as a VHF marine radio is used on board</strong> – including in the coastal area. It is administered by the examination boards of the German Sailing Association (DSV) and the German Motor Yachting Association (DMYV), is internationally recognized and valid indefinitely.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="en" only="src" />
    </section>

    <!-- Who needs it -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Who needs the SRC?</h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {([
          { icon: 'sailboat', title: 'VHF radio on board', desc: 'Sailors and motorboaters with a fixed or portable VHF marine radio (DSC) on board' },
          { icon: 'waves', title: 'Coastal area & Baltic', desc: 'Anyone traveling on the North and Baltic Sea or in the coastal area (sea area A1)' },
          { icon: 'lifebuoy', title: 'Charter skippers', desc: 'Many charter companies require the SRC for yachts with a radio installation' },
          { icon: 'phone', title: 'Distress call & DSC alert', desc: 'Anyone who needs to be able to correctly send a DSC distress alert and Mayday call in an emergency' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={item.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{item.title}</div>
              <div style="font-size:14px; color:#4B5563; line-height:1.6;">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Practice bridge: take the fear out of radio -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Afraid of radio? We'll take that fear away.</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        The worry about dictation and sending a message almost always comes from a lack of repetition – not from a lack of ability. The messages follow a fixed wording (MAYDAY, PAN PAN, phonetic alphabet). Anyone who has run through the procedure often enough has it down.
      </p>
      <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:18px;">
        {radioPoints.map(p => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={p.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{p.title}</div>
              <div style="font-size:14px; color:#4B5563; line-height:1.6;">{p.desc}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="display:flex; align-items:flex-start; gap:14px; background:linear-gradient(160deg,#F4F7FE 0%,#EAF0FC 100%); border:1px solid rgba(51,102,255,0.16); border-radius:16px; padding:20px 24px;">
        <span style="flex-shrink:0; margin-top:1px;"><Icon name="lifebuoy" size={20} stroke="#3366FF" strokeWidth={1.75} /></span>
        <p style="font-size:14px; color:#4B5563; line-height:1.65; margin:0;">You get the final speaking polish on real equipment in the practical exam part at your radio school. The wording and procedures you bring with you confidently via Boatpass.</p>
      </div>
    </section>

    <!-- SRC vs UBI vs LRC -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">SRC, UBI or LRC – which radio certificate?</h2>
      <div class="funk-compare-grid">
        <div style="background:white; border:2px solid rgba(51,102,255,0.2); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">SRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Short Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Coastal marine radio (A1)</li>
            <li>✓ VHF + DSC</li>
            <li>✓ Internationally valid</li>
            <li>✗ No MF/HF</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">UBI</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">VHF radio inland</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Inland radio (rivers, canals)</li>
            <li>✓ AIS inland navigation</li>
            <li>✗ Not valid for marine radio</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">LRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Long Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Marine radio worldwide (A1–A4)</li>
            <li>✓ VHF + MF/HF</li>
            <li>✓ Satellite radio (GMDSS)</li>
          </ul>
        </div>
      </div>
      <p style="font-size:14px; color:#9CA3AF; margin-top:12px; line-height:1.6;">
        For the vast majority of coastal areas the <strong>SRC</strong> is the right certificate. Anyone who wants to use radio on the high seas needs the <a href="/en/lrc/" style="color:#3366FF; text-decoration:none;">LRC</a>; for inland waters the <a href="/en/ubi/" style="color:#3366FF; text-decoration:none;">UBI</a> is responsible. SRC and UBI are not mutually creditable.
      </p>
    </section>

    <!-- Exam structure -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">SRC exam: structure & contents</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theory</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Written<br>Multiple-choice paper</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Practice</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Operating a DSC radio<br>Distress, urgency & safety traffic</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">English</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Receive & translate distress calls<br>Render German text into English</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Minimum age</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">from 15 years<br>admitted to the exam</div>
        </div>
      </div>
      <div style="background:rgba(51,102,255,0.05); border:1px solid rgba(51,102,255,0.15); border-radius:14px; padding:20px;">
        <p style="font-size:15px; color:#4B5563; line-height:1.7; margin:0;">
          <strong style="color:#1A1F36;">Exam topics:</strong> VHF marine radio and the GMDSS system (sea area A1), DSC procedures (Digital Selective Calling), distress, urgency and safety traffic, ship-to-ship and ship-to-shore communication, NAVTEX, the international phonetic alphabet and distress English, plus the ITU radio regulations (Radio Regulations).
        </p>
      </div>
    </section>

    <!-- Costs -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">What does the SRC cost?</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:24px;">
        For the official SRC exam there is a fee for admission, the exam and the issuance of the certificate:
      </p>
      <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; overflow:hidden;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px; border-bottom:1px solid rgba(51,102,255,0.08);">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Admission, exam & issuance</div>
            <div style="font-size:13px; color:#6B7280; line-height:1.5;">Official fee via DSV / DMYV (theory + practice + certificate)</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">approx. €128</div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px;">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Preparation course (optional)</div>
            <div style="font-size:13px; color:#6B7280; line-height:1.5;">Radio school with study material & practical training on the device</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">approx. €250–350</div>
        </div>
      </div>
      <p style="font-size:13px; color:#9CA3AF; line-height:1.6; margin-top:12px;">
        The official exam fee at the DSV/DMYV is currently around €127.88. A preparation course is not required – you can also learn the theory independently with the official question catalog. These official fees are independent of the Boatpass SRC learning module (one-time €7.99).
      </p>
    </section>

    <!-- How Boatpass helps with the SRC -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">How Boatpass helps with the SRC</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {([
          { icon: 'book', title: 'Complete SRC question catalog', desc: 'All official SRC questions for the coastal area – fully covered, always up to date.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Practice under real exam conditions with time pressure and a passing threshold.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Focus on the questions you don\'t yet have a firm grasp of.' },
          { icon: 'chart', title: 'Progress by category', desc: 'Keep an overview – which topics are already solid, where is more practice needed?' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">Learn by category</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        The SRC question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
        Source: official question catalog on <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
