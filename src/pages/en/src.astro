---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeBridge from '../../components/PracticeBridge.astro';
import PageHead from '../../components/page/PageHead.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import type { IconName } from '../../icons';
import PlatformPrice from '../../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SRC Marine Radio", "item": "https://boatpass.de/en/src/" },
  ],
};

// Course schema: clearly marks the page as a learning course for the SRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SRC Exam Preparation – Short Range Certificate (Marine Radio)",
  "description": "Preparation for the Short Range Certificate (SRC) exam for VHF marine radio with DSC in the coastal area – with the official ELWIS question catalog (180 questions), exam simulation and mistake training.",
  "url": "https://boatpass.de/en/src/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "VHF marine radio and operating procedures",
    "DSC procedures (Digital Selective Calling)",
    "Distress, urgency and safety traffic in the GMDSS",
    "Radio regulations and frequency use",
    "Equipment knowledge and operation of VHF marine radios",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT8H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('src'),
};

const faqs = [
  {
    q: 'How does the SRC exam work?',
    a: 'The theoretical SRC exam comprises a paper with 24 multiple-choice questions in 30 minutes – passed from 19 correct answers. Added to that are the written recording of a distress, urgency or safety message and a practical part with four tasks on the DSC radio. The exam draws on the official ELWIS question catalog with 180 questions, which Boatpass trains in full.',
  },
  {
    q: 'What does the SRC cost?',
    a: 'The official exam fee for the SRC at the DSV/DMYV is currently around €127.88 (admission, exam and issuance of the certificate). An optional preparation course at a radio school costs an additional €250–350 but is not mandatory. These fees are independent of the Boatpass SRC learning module (one-time ' + priceText('src', 'en') + ').',
  },
  {
    q: 'SRC or UBI – which radio certificate do I need?',
    a: 'The SRC is the VHF marine radio certificate with DSC for the coastal area (sea area A1), while the UBI covers VHF radio on inland waterways. The two are not mutually creditable. Anyone who wants to radio on the high seas beyond VHF range needs the more extensive LRC.',
  },
  {
    q: 'From what age can I take the SRC and how long is it valid?',
    a: 'You can be admitted to the SRC exam from age 15. The SRC is administered by the examination boards of the DSV and DMYV, is internationally recognized and valid without a time limit.',
  },
  {
    q: 'Do I need a radio course for the SRC?',
    a: 'No. A preparation course is not required – you can learn the theory independently with the official question catalog, for example with the Boatpass SRC module. For the practical part, some prior practice on the DSC radio is advisable.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is the SRC?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SRC",
  "alternateName": "Short Range Certificate",
  "description": "The Short Range Certificate (SRC) is the official authorization to participate in the worldwide maritime radio service (GMDSS) in the VHF band. It permits the operation of all VHF marine radio installations including DSC.",
  "url": "https://boatpass.de/en/src/",
  "inLanguage": "en",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Operating procedures', desc: 'Call handling, priorities & speaking procedures', count: 48, icon: 'microphone' },
  { name: 'DSC procedures', desc: 'Digital Selective Calling, distress DSC & reception', count: 38, icon: 'wifi' },
  { name: 'Distress & safety traffic', desc: 'Mayday, Pan-Pan, Sécurité & coordination', count: 34, icon: 'shield' },
  { name: 'Radio regulations', desc: 'ITU regulations, frequencies & certification', count: 30, icon: 'scale' },
  { name: 'Equipment & technology', desc: 'Setup, operation & maintenance of VHF devices', count: 30, icon: 'satellite' },
];

---

<BaseLayout
  title="SRC Study App – Short Range Certificate"
  description={`Learn the SRC radio certificate: exam format, contents and costs. Boatpass SRC module, one-time payment from ${minPrice(['src'], 'en')} with exam simulation – start today.`}
  lang="en"
  altUrl="https://boatpass.de/src/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Short Range Certificate · Coastal Marine Radio"
    lede="The Short Range Certificate (SRC) is the most widely used marine radio certificate in recreational boating – mandatory for anyone who operates a VHF marine radio with DSC in the coastal area."
    ctaLabel="Start learning SRC in the app"
    cta
  >
    Learn SRC –<br />Short Range Certificate
    <span slot="badge">Boatpass SRC module – now available · one-time&nbsp;<PlatformPrice product="src" lang="en" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="src"
      items={[
        { k: 'Question catalogue', v: '180 questions' },
        { k: 'Theory', v: '30 min, pass from 19 correct' },
        { k: 'Practical', v: 'Operating the DSC radio' },
        { k: 'Exam fee', v: '€127.88' },
        { k: 'Minimum age', v: '15 years' },
      ]}
    />

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In a nutshell</p>
        <p class="pg-answer-text">
          The SRC (Short Range Certificate) is the VHF marine radio certificate with DSC for the coastal area (sea area A1). The theory exam comprises a paper of 24 multiple-choice questions in 30 minutes – passed from 19 correct answers. Added to that are the written recording of a distress, urgency or safety message and a practical part with four tasks on the radio. The exam draws on the official ELWIS question catalog (180 questions); Boatpass trains all SRC content with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">What is the SRC?</h2>
      <p class="pg-p">
        The <strong>Short Range Certificate (SRC)</strong> is the official authorization to participate in the worldwide maritime radio service (GMDSS) in the <strong>VHF band</strong>. It permits the operation of all VHF marine radio installations including DSC (Digital Selective Calling) with a range of around <strong>35 nautical miles</strong> (sea area A1).
      </p>
      <p class="pg-p">
        The SRC is <strong>mandatory for sailors and motorboaters as soon as a VHF marine radio is used on board</strong> – including in the coastal area. It is administered by the examination boards of the German Sailing Association (DSV) and the German Motor Yachting Association (DMYV), is internationally recognized and valid indefinitely.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section class="pg-section">
      <CatalogSources lang="en" only="src" />
    </section>

    <!-- Who needs it -->
    <section class="pg-section">
      <h2 class="pg-h2">Who needs the SRC?</h2>
      <div class="pg-rows">
        {([
          { icon: 'sailboat', title: 'VHF radio on board', desc: 'Sailors and motorboaters with a fixed or portable VHF marine radio (DSC) on board' },
          { icon: 'waves', title: 'Coastal area & Baltic', desc: 'Anyone traveling on the North and Baltic Sea or in the coastal area (sea area A1)' },
          { icon: 'lifebuoy', title: 'Charter skippers', desc: 'Many charter companies require the SRC for yachts with a radio installation' },
          { icon: 'phone', title: 'Distress call & DSC alert', desc: 'Anyone who needs to be able to correctly send a DSC distress alert and Mayday call in an emergency' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <PracticeBridge variant="radio" lang="en" />

    <!-- SRC vs UBI vs LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">SRC, UBI or LRC – which radio certificate?</h2>
      <div class="funk-compare-grid">
        <div class="pg-card pg-card--current">
          <p class="pg-card-title">SRC</p>
          <p class="pg-card-sub">Short Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Coastal marine radio (A1)</li>
            <li>✓ VHF + DSC</li>
            <li>✓ Internationally valid</li>
            <li>✗ No MF/HF</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">UBI</p>
          <p class="pg-card-sub">VHF radio inland</p>
          <ul class="pg-checklist">
            <li>✓ Inland radio (rivers, canals)</li>
            <li>✓ AIS inland navigation</li>
            <li>✗ Not valid for marine radio</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">LRC</p>
          <p class="pg-card-sub">Long Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Marine radio worldwide (A1–A4)</li>
            <li>✓ VHF + MF/HF</li>
            <li>✓ Satellite radio (GMDSS)</li>
          </ul>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        For the vast majority of coastal areas the <strong>SRC</strong> is the right certificate. Anyone who wants to use radio on the high seas needs the <a href="/en/lrc/" class="pg-inline-link">LRC</a>; for inland waters the <a href="/en/ubi/" class="pg-inline-link">UBI</a> is responsible. SRC and UBI are not mutually creditable.
      </p>
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">SRC exam: structure & contents</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theory</p>
          <p class="pg-card-text">Written<br>Multiple-choice paper</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Practice</p>
          <p class="pg-card-text">Operating a DSC radio<br>Distress, urgency & safety traffic</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">English</p>
          <p class="pg-card-text">Receive & translate distress calls<br>Render German text into English</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Minimum age</p>
          <p class="pg-card-text">from 15 years<br>admitted to the exam</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Exam topics:</strong> VHF marine radio and the GMDSS system (sea area A1), DSC procedures (Digital Selective Calling), distress, urgency and safety traffic, ship-to-ship and ship-to-shore communication, NAVTEX, the international phonetic alphabet and distress English, plus the ITU radio regulations (Radio Regulations).
        </p>
      </div>
    </section>

    <!-- Costs -->
    <section class="pg-section">
      <h2 class="pg-h2">What does the SRC cost?</h2>
      <p class="pg-p">
        For the official SRC exam there is a fee for admission, the exam and the issuance of the certificate:
      </p>
      <div class="pg-fees">
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Admission, exam & issuance</p>
            <p class="pg-fee-desc">Official fee via DSV / DMYV (theory + practice + certificate)</p>
          </div>
          <p class="pg-fee-price h-num">approx. €128</p>
        </div>
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Preparation course (optional)</p>
            <p class="pg-fee-desc">Radio school with study material & practical training on the device</p>
          </div>
          <p class="pg-fee-price h-num">approx. €250–350</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        The official exam fee at the DSV/DMYV is currently around €127.88. A preparation course is not required – you can also learn the theory independently with the official question catalog. These official fees are independent of the Boatpass SRC learning module (one-time {priceText('src', 'en')}).
      </p>
    </section>

    <!-- How Boatpass helps with the SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">How Boatpass helps with the SRC</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Complete SRC question catalog', desc: 'All official SRC questions for the coastal area – fully covered, always up to date.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Practice under real exam conditions with time pressure and a passing threshold.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Focus on the questions you don\'t yet have a firm grasp of.' },
          { icon: 'chart', title: 'Progress by category', desc: 'Keep an overview – which topics are already solid, where is more practice needed?' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The SRC question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p class="pg-note pg-note--sm">
        Source: official question catalog on <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass SRC module available -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Now available</p>
          <h2 class="pg-h2">Boatpass SRC module</h2>
          <p class="pg-p">The SRC module for Boatpass is here – with the same learning concept as SBF Inland & Coastal: official question catalog, exam simulation and targeted mistake training. One-time <strong><PlatformPrice product="src" lang="en" /></strong>, no subscription.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="src" lang="en" alt /></span> <span class="pg-cta-unit">one-time purchase</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            Unlock the SRC module in the app
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the SRC</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Related licenses</h2>
      <ul class="pg-related">
        <li><a href="/en/radio-certificate-app/">Radio certificate apps compared<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-inland/">Learn SBF Inland with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/lrc/">LRC – Long Range Certificate for worldwide marine radio<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/ubi/">UBI – VHF radio certificate inland<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/ubi-vs-src-radio-license/">UBI or SRC – which radio certificate fits your boat?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/marine-radio-basics-beginners/">Marine radio basics: channels, DSC and distress calls<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/distress-signals-at-sea/">Distress signals at sea: what you need to know<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/gps-chartplotter-vhf-modern-navigation/">GPS, chartplotters & VHF radio – modern onboard navigation<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

<style>
  /* SRC/UBI/LRC comparison: 3 columns on desktop, stacked on narrow
     screens – otherwise the cards break the viewport (horizontal overflow). */
  .funk-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .funk-compare-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
