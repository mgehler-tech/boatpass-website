---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/page/PageHead.astro';
import PageLayout from '../../../components/page/PageLayout.astro';
import DisplayFontPreload from '../../../components/page/DisplayFontPreload.astro';
import Icon from '../../../components/Icon.astro';
import { cities } from '../../../data/boat-schools';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "Boat Schools", "item": "https://boatpass.de/en/boat-schools/" },
  ],
};

const faqs = [
  {
    q: 'Do I need a boat school to get my German boat licence?',
    a: 'No. A boat school is not legally required for the theory exam. The official ELWIS question catalogue is freely available, and you can prepare independently with an app like BoatPass. However, most candidates benefit from practical training at a boat school for the hands-on part of the exam.',
  },
  {
    q: 'What does a boat school cost in Germany?',
    a: 'Prices vary by city and licence type. A full course (theory + practical) typically costs between 400 and 800 euros on top of the official exam fees (around 130 euros for SBF Inland, 148 euros for SBF Coastal). By studying the theory yourself with BoatPass for 9.99 euros, you can save the largest portion of those course fees.',
  },
  {
    q: 'How do I choose the right boat school?',
    a: 'Look for a school that is certified by the DMYV or DSV, offers practical training on waterways you plan to use, and has flexible scheduling. Reviews on Google Maps are a good starting point. Many schools offer a free introductory session so you can see if the teaching style suits you.',
  },
  {
    q: 'Can I learn theory with BoatPass and only do the practical at a school?',
    a: 'Yes, and this is the most cost-effective approach. BoatPass covers the complete official ELWIS question catalogue with exam simulation and mistake training. You then book only the practical lessons at a boat school for the on-water manoeuvres and exam registration.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Boat Schools in Germany – Find One Near You"
  description="Find a boat school in your city: Berlin, Hamburg, Munich, Cologne and more. Information about waterways, exam locations and costs for the license."
  lang="en"
  altUrl="https://boatpass.de/bootsfahrschulen/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und breite Spalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Find a School"
    lede="BoatPass covers the theory for your German boat licence. For practical training and exam registration, you need a boat school. Find one in your city below."
  >
    Boat Schools<br />Near You
  </PageHead>

  <PageLayout variant="wide">

    <!-- Note box -->
    <div class="pg-answer pg-answer--icon">
      <span class="pg-row-icon"><Icon name="lightbulb" size={20} strokeWidth={1.75} /></span>
      <div class="pg-answer-body">
        <p class="pg-card-title">BoatPass + Boat School = Ready for the exam</p>
        <p class="pg-card-text">
          <strong>BoatPass</strong> is your theory learning app: the complete official ELWIS question catalogue with exam simulation and mistake training.
          A <strong>boat school</strong> provides practical training on the water, knot practice and helps with exam registration.
          Together, they cover everything you need for your German boat licence.
        </p>
      </div>
    </div>

    <!-- City grid -->
    <section class="pg-section">
      <h2 class="pg-h2">
        Boat Schools by City
      </h2>
      <p class="pg-p">
        Select your city to find boat schools, waterway information, exam locations and costs.
      </p>
      <div class="city-grid">
        {cities.map(city => (
          <a href={`/en/boat-schools/${city.slug}/`} class="city-card">
            <div class="city-icon"><Icon name="mapPin" size={26} strokeWidth={1.75} /></div>
            <div class="city-name">{city.name}</div>
            <span class="pg-pill">{city.state}</span>
            <div class="city-waterways">{city.waterways.en}</div>
            <div class="city-link">Learn more<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently Asked Questions</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-inland/">Learn SBF Inland with BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boat licence cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory and practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/licenses/">All German boating licences at a glance<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

