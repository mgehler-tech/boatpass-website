---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/page/PageHead.astro';
import PageLayout from '../../../components/page/PageLayout.astro';
import PageFacts from '../../../components/page/PageFacts.astro';
import DisplayFontPreload from '../../../components/page/DisplayFontPreload.astro';
import Icon from '../../../components/Icon.astro';
import { cities, mapsSearchUrl } from '../../../data/boat-schools';
import type { BoatSchoolCity } from '../../../data/boat-schools';
import { PLAY_STORE_URL } from '../../../data/stores';

export function getStaticPaths() {
  return cities.map(city => ({ params: { city: city.slug }, props: { city } }));
}

interface Props { city: BoatSchoolCity }

const { city } = Astro.props;

const playStoreUrl = PLAY_STORE_URL;

const licenceTypes = city.variant === 'coastal'
  ? [{ name: 'SBF Coastal', href: '/en/sbf-coastal/' }]
  : city.variant === 'inland'
    ? [{ name: 'SBF Inland', href: '/en/sbf-inland/' }]
    : [
        { name: 'SBF Inland', href: '/en/sbf-inland/' },
        { name: 'SBF Coastal', href: '/en/sbf-coastal/' },
      ];

// Schein-Bezeichnung und Erklärung je Variante, Gegenstück zu licenceLabel/licenceDescription der DE-Seite.
const licenceLabel = licenceTypes.map(l => l.name).join(' & ');

function licenceDescription(variant: 'coastal' | 'inland' | 'both', name: string): string {
  if (variant === 'coastal') {
    return `For the coastal waters around ${name} you need the Sportbootführerschein See (SBF Coastal). It covers the maritime waterways of the North Sea and the Baltic Sea.`;
  }
  if (variant === 'inland') {
    return `For the inland waters around ${name} you need the Sportbootführerschein Binnen (SBF Inland) for boats above 15 HP. It is valid on rivers, canals and lakes throughout Germany.`;
  }
  return `${name} gives you access to both inland and coastal waters. For rivers and lakes you need the SBF Inland, for the coast the SBF Coastal. Many boat schools offer a combined course for both licences.`;
}

// Sidebar facts, taken verbatim from the city data (spec round 3, 3.3).
const cityFacts = [
  { k: 'State', v: city.state },
  { k: 'Waterways', v: city.waterways.en },
  { k: 'Licence required', v: licenceTypes.map(l => l.name).join(' & ') },
  ...(city.schools.length ? [{ k: 'Boat schools listed', v: `${city.schools.length}` }] : []),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "Boat Schools", "item": "https://boatpass.de/en/boat-schools/" },
    { "@type": "ListItem", "position": 3, "name": city.name, "item": `https://boatpass.de/en/boat-schools/${city.slug}/` },
  ],
};

const faqSchema = city.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": city.faq.map(f => ({
    "@type": "Question",
    "name": f.q.en,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.en },
  })),
} : null;
---

<BaseLayout
  title={`Boat Schools in ${city.name} – SBF Courses`}
  description={city.metaDescription.en}
  lang="en"
  altUrl={`https://boatpass.de/bootsfahrschulen/${city.slug}/`}
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow={city.state}
    lede={city.intro.en}
    ctaLabel="Download for free"
    cta
  >
    Boat Schools<br />in {city.name}
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfBinnen"
      from
      items={cityFacts}
    />

    <!-- Waterways -->
    <section class="pg-section">
      <h2 class="pg-h2">Waterways in {city.name}</h2>
      <p class="pg-p">
        {city.waterways.en} – {licenceDescription(city.variant, city.name)}
      </p>
      <div class="pg-cards pg-cards--2">
        <div class="pg-card">
          <p class="pg-card-title">Waterways</p>
          <p class="pg-card-text">{city.waterways.en}</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Licence required</p>
          <p class="pg-card-text">{licenceLabel}</p>
        </div>
      </div>
      <ul class="pg-related">
        {licenceTypes.map(l => (
          <li><a href={l.href}>{l.name} in detail<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        ))}
      </ul>
    </section>

    <!-- Boat Schools -->
    <section class="pg-section">
      <h2 class="pg-h2">Boat Schools in {city.name}</h2>
      <p class="pg-p">
        {city.schools.length > 0
          ? `Here are ${city.schools.length} boat schools in ${city.name} that offer boat licence training.`
          : `There are several boat schools in ${city.name} that prepare you for the boat licence exam.`}
      </p>

      {city.schools.length > 0 && (
        <div class="pg-schools">
          {city.schools.map(school => (
            <div class="pg-school">
              <div class="pg-school-head">
                <span class="pg-row-icon pg-row-icon--sm">
                  <Icon name="mapPin" size={18} strokeWidth={1.75} />
                </span>
                <div class="pg-row-body">
                  <h3 class="pg-card-title">{school.name}</h3>
                  <p class="pg-row-text">{school.address}</p>
                </div>
              </div>
              <div class="pg-school-tags">
                {school.licenses.map(lic => (
                  <span class="pg-pill">{lic}</span>
                ))}
              </div>
              <div class="pg-school-actions">
                <a href={school.website} target="_blank" rel="noopener noreferrer" class="pg-school-link">
                  <Icon name="globe" size={15} strokeWidth={1.75} />
                  Website
                </a>
                {school.phone && (
                  <a href={`tel:${school.phone.replace(/\s/g, '')}`} class="pg-school-link pg-school-link--muted">
                    <Icon name="phone" size={15} strokeWidth={1.75} />
                    {school.phone}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      <a href={mapsSearchUrl(city.mapsQuery)} target="_blank" rel="noopener noreferrer" class="pg-banner">
        <span class="pg-banner-text">
          <span class="pg-eyebrow">Google Maps</span>
          <span class="pg-banner-title">More boat schools in {city.name}</span>
          <span class="pg-banner-sub">Browse all schools on the map, compare reviews and find directions.</span>
        </span>
        <span class="h-btn h-btn--sm pg-banner-cta">Open Map<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></span>
      </a>
    </section>

    <!-- Exams -->
    <section class="pg-section">
      <h2 class="pg-h2">Exams in {city.name}</h2>
      <p class="pg-p">
        {city.examInfo.en}
      </p>
      <div class="pg-cards pg-cards--2">
        <div class="pg-card">
          <p class="pg-kpi">
            €{city.variant === 'coastal' ? '148.38' : city.variant === 'inland' ? '130.78' : '178.61'}
          </p>
          <p class="pg-card-text">
            Official exam fee {city.variant === 'both' ? '(combined)' : city.variant === 'coastal' ? '(Coastal)' : '(Inland)'}
          </p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">from €9.99</p>
          <p class="pg-card-text">Study theory with BoatPass</p>
        </div>
      </div>
    </section>

    <!-- Study theory with BoatPass -->
    <section class="pg-section">
      <h2 class="pg-h2">Study Theory with BoatPass</h2>
      <p class="pg-p">
        You do not need a boat school for the theory exam. Prepare on your own with the official
        ELWIS question catalogue, exam simulation and targeted mistake training – then book only the
        practical lessons at a boat school in {city.name} and learn flexibly at your own pace.
      </p>
      <div class="pg-rows">
        {([
          { icon: 'book' as const, title: 'Official ELWIS question catalogue', desc: `All official exam questions for the ${licenceLabel} – always up to date.` },
          { icon: 'target' as const, title: 'Exam simulation', desc: 'Real exam conditions with a timer and a separate pass mark.' },
          { icon: 'refresh' as const, title: 'Mistake training', desc: 'Practise only the questions you are not yet sure about.' },
        ]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="h-btn h-btn--sm">Download for free<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></a>
    </section>

    <!-- FAQ -->
    {city.faq.length > 0 && (
      <section class="pg-section">
        <h2 class="pg-h2">Frequently asked questions about {city.name}</h2>
        <div class="pg-faq">
          {city.faq.map(f => (
            <div class="pg-faq-item">
              <h3 class="pg-h3">{f.q.en}</h3>
              <p class="pg-card-text">{f.a.en}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/boat-schools/">All boat school cities<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/boating-regions-in-germany/">Boating regions in Germany: where can you go with the SBF?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-inland/">Learn SBF Inland with BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boat licence cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory and practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/licenses/">All German boating licences at a glance<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

