---
import BaseLayout from '../../layouts/BaseLayout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marius Gehler",
  "url": "https://boatpass.de/en/about/",
  "jobTitle": "Founder & Developer",
  "image": "https://boatpass.de/ueber-uns.webp",
  "worksFor": {
    "@type": "Organization",
    "name": "BoatPass",
    "url": "https://boatpass.de",
  },
  "description": "Marius Gehler is the founder and developer of BoatPass – the modern study app for the German boating license (SBF Binnen & See).",
  "knowsAbout": [
    "Sportbootführerschein",
    "SBF Binnen",
    "SBF See",
    "Android development",
    "ELWIS question catalog",
  ],
};
---

<BaseLayout
  title="About – BoatPass"
  description="Who is behind BoatPass? The story and motivation behind the boating license study app – built by someone studying for the license himself."
  lang="en"
  altUrl="https://boatpass.de/ueber-uns/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div style="max-width:720px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        About us
      </div>
      <h1 style="font-size:42px; font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:12px;">About BoatPass</h1>
      <p style="font-size:16px; color:#6B7280;">The person behind the app – and why it exists.</p>
    </div>

    <!-- Author profile -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; overflow:hidden; margin-bottom:16px;">
      <img
        src="/ueber-uns.webp"
        alt="Marius Gehler, founder of BoatPass, at the helm of a sailboat"
        loading="lazy"
        style="display:block; width:100%; height:300px; object-fit:cover; object-position:center 35%;"
      />
      <div style="padding:32px;">
        <div style="font-size:20px; font-weight:800; color:#1A1F36; margin-bottom:4px;">Marius Gehler</div>
        <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Founder & Developer of BoatPass</div>
        <p style="font-size:16px; color:#4B5563; line-height:1.7; margin:0;">
          Hi, I'm Marius – founder and developer of BoatPass. Right now I'm studying for the boating
          license myself. And that's exactly how this app came to be: not on a drawing board, but out
          of my own day-to-day learning.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:20px;">
          {["SBF Binnen", "SBF See", "ELWIS catalog", "Android development"].map(tag => (
            <span style="font-size:12px; font-weight:700; background:rgba(51,102,255,0.08); color:#3366FF; border:1px solid rgba(51,102,255,0.15); padding:3px 10px; border-radius:100px;">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Card: Why BoatPass exists -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Why BoatPass exists</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        When I started studying, I asked friends who already had their license. Their verdict was almost
        always the same: there are apps with good content – but none that make studying on your phone
        actually enjoyable. Clunky menus, uninspired interfaces, questions you just memorize by rote.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        That stuck with me. I've been building apps in my spare time for years – BoatPass is my passion
        project alongside my day job. My goal: an SBF app that genuinely feels great on a smartphone.
        Fast, clean, motivating. So I built it – and I'm studying with it myself.
      </p>
    </div>

    <!-- Card: What matters to me -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">What matters to me</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Studying theory for the boating license shouldn't feel like a chore. You should enjoy learning and
        make fast progress. That's why every question comes with clear explanations and memory aids –
        instead of just „right/wrong“. The material sticks, and you get out on the water sooner.
      </p>
    </div>

    <!-- Card: My promise -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">My promise</h2>
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px;">
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Always up-to-date official question catalog (ELWIS)
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          No subscription – buy once, use it for good
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Explanations & memory aids instead of rote memorization
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Built by someone who's studying for the license right now
        </li>
      </ul>
    </div>

    <!-- Card: Contact -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Contact</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Feedback, found a bug, or just a question? Reach me via the
        <a href="/en/contact/" style="color:#3366FF; text-decoration:none; font-weight:500;">contact form</a> –
        I read every message myself.
      </p>
    </div>

  </div>
</BaseLayout>
