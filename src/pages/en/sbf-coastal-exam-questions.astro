---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Coastal", "item": "https://boatpass.de/en/sbf-coastal/" },
    { "@type": "ListItem", "position": 3, "name": "Exam Questions", "item": "https://boatpass.de/en/sbf-coastal-exam-questions/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & collision regulations', count: 130, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation & charts', desc: 'Chartwork, courses, tides & current', count: 72, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 40, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signals & marks', desc: 'Sound, visual and sea marks', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Meteorology', desc: 'Wind, weather, tide tables & forecasting', count: 10, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 5, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
];

const faqs = [
  {
    q: 'What is different about the SBF Coastal catalog compared to Inland?',
    a: 'The SBF Coastal covers the maritime waterways and additionally contains a navigation task. The theory exam consists of 30 standard questions (7 basic + 23 specific) plus 9 questions on the navigation task – 39 questions in total in 60 minutes.',
  },
  {
    q: 'How does the navigation task work?',
    a: 'In the navigation task you work with a nautical chart: plotting courses, determining positions, accounting for tides and current. Of the 9 questions you have to answer at least 7 correctly. Exactly this part is practiced in the Boatpass app with a real navigation section.',
  },
  {
    q: 'Where do I find the official SBF Coastal exam questions?',
    a: 'The official coastal question catalog is published free of charge by ELWIS. In the Boatpass app you learn the complete current catalog for the coast and maritime waterways – including exam simulation with a navigation section.',
  },
  {
    q: 'How many questions do I have to get right to pass?',
    a: 'You need at least 5 of 7 basic questions, 18 of 23 specific questions and 7 of 9 navigation task questions. You have 60 minutes in total.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Coastal Exam Questions & Navigation"
  description="Practice all SBF Coastal exam questions from the official ELWIS catalog, incl. navigation task – structure, passing threshold and the 39 questions."
  lang="en"
  altUrl="https://boatpass.de/sbf-see-pruefungsfragen/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        SBF Coastal Exam Questions
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        SBF Coastal questions –<br>practice including navigation
      </h1>
      <p style="font-size:18px; color:#656B78; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        The complete official ELWIS coastal catalog – plus the navigation task with a real navigation section. Practice all 39 exam questions under real conditions.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Practice questions for free
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">In a nutshell</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          The official SBF Coastal question catalog comprises 285 questions (72 basic + 213 specific coastal questions). The theory exam consists of 39 questions in 60 minutes: 30 standard questions (7 basic + 23 specific) plus 9 questions on the navigation task on the nautical chart. You pass if you get at least 5 of 7 basic questions, 18 of 23 specific questions and 7 of 9 navigation questions right. Boatpass trains the complete ELWIS catalog including a real navigation section.
        </p>
      </div>
    </section>

    <!-- The catalog -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">The official SBF Coastal question catalog</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The <strong>exam questions for the SBF Coastal</strong> come from the official question catalog (DSV/DMYV, published via ELWIS) for the <strong>maritime waterways</strong> (North and Baltic Sea). It comprises <strong>72 basic questions and 213 specific coastal questions</strong> (285 questions in total). On top of that comes the decisive part that Inland doesn't have: the <strong>navigation task</strong>.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        The theory exam comprises a total of <strong>39 questions in 60 minutes</strong> – 30 standard questions plus 9 questions on the navigation task on the nautical chart.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:14px;">
        Source: official question catalog (DSV/DMYV), published free of charge via <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
    </section>

    <!-- Exam structure -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">How the SBF Coastal theory exam is structured</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Exam paper</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">39 questions · 60 minutes<br>Multiple choice + navigation</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basic questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 questions<br>at least 5 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Specific questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">23 questions<br>at least 18 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Navigation task</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">9 questions<br>at least 7 correct</div>
        </div>
      </div>
    </section>

    <!-- Navigation task -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">The navigation task – the sticking point of the SBF Coastal</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The navigation task is the part most candidates are wary of. On the official <strong>training chart</strong> you plot courses, determine positions and account for influences such as <strong>current, wind and tides</strong>. Of the 9 individual questions you have to solve at least 7 correctly.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        The big advantage: there are only <strong>15 official navigation tasks</strong> in total, one of which is set unchanged in the exam. Anyone who practices these 15 tasks with a <strong>real navigation section</strong> – just like in the actual exam – heads into exam day with confidence. That's exactly what the Boatpass app replicates.
      </p>
    </section>

    <!-- Practice effectively -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Practice SBF Coastal questions effectively</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: 'book', title: 'Complete ELWIS coastal catalog', desc: 'All questions on the coast and maritime waterways – fully covered, always up to date.' },
          { icon: 'compass', title: 'Navigation with a real navigation section', desc: 'Practice the navigation task the way it is set in the real exam – courses, positions, tides.' },
          { icon: 'target', title: 'Exam simulation: 39 questions, 60 minutes', desc: 'Real exam conditions including the navigation section and passing threshold.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Specifically repeat your weak spots instead of learning everything from scratch.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon as IconName} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#656B78; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Frequently asked questions about the SBF Coastal catalog</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</h3>
            <div style="font-size:15px; color:#656B78; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Learn by category</h2>
      <p style="font-size:16px; color:#656B78; line-height:1.6; margin-bottom:20px;">
        The question catalog is divided into topic areas – practice in a targeted way based on your weak spots.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
            </div>
            <span style="font-size:12px; font-weight:700; color:#656B78; background:rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.07); border-radius:100px; padding:3px 10px; flex-shrink:0; white-space:nowrap;">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h2 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Further reading</h2>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/en/sbf-coastal/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Learn SBF Coastal: overview & app</a>
        <a href="/en/sbf-inland-exam-questions/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Practice SBF Inland exam questions</a>
        <a href="/en/sbf-exam/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF exam: how theory & practice work</a>
        <a href="/en/sbf-costs/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ What does the boating license cost?</a>
        <a href="/en/blog/sbf-coastal-navigation-tasks-explained/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Coastal navigation tasks explained – structure & tips</a>
        <a href="/en/blog/hardest-sbf-exam-questions/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ The hardest SBF exam questions – and how to master them</a>
      </div>
    </section>

  </div>
</BaseLayout>
