---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';
import { PLAY_STORE_URL } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Coastal", "item": "https://boatpass.de/en/sbf-coastal/" },
    { "@type": "ListItem", "position": 3, "name": "Exam Questions", "item": "https://boatpass.de/en/sbf-coastal-exam-questions/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & collision regulations', count: 130, icon: 'scale' },
  { name: 'Navigation & charts', desc: 'Chartwork, courses, tides & current', count: 72, icon: 'compass' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 40, icon: 'shield' },
  { name: 'Signals & marks', desc: 'Sound, visual and sea marks', count: 28, icon: 'bell' },
  { name: 'Meteorology', desc: 'Wind, weather, tide tables & forecasting', count: 10, icon: 'cloud' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 5, icon: 'document' },
];

const faqs = [
  {
    q: 'What is different about the SBF Coastal catalog compared to Inland?',
    a: 'The SBF Coastal covers the maritime waterways and additionally contains a navigation task. The theory exam consists of 30 standard questions (7 basic + 23 specific) plus 9 questions on the navigation task – 39 questions in total in 60 minutes.',
  },
  {
    q: 'How does the navigation task work?',
    a: 'In the navigation task you work with a nautical chart: plotting courses, determining positions, accounting for tides and current. Of the 9 questions you have to answer at least 7 correctly. Exactly this part is practiced in the Boatpass app with a real navigation section.',
  },
  {
    q: 'Where do I find the official SBF Coastal exam questions?',
    a: 'The official coastal question catalog is published free of charge by ELWIS. In the Boatpass app you learn the complete current catalog for the coast and maritime waterways – including exam simulation with a navigation section.',
  },
  {
    q: 'How many questions do I have to get right to pass?',
    a: 'You need at least 5 of 7 basic questions, 18 of 23 specific questions and 7 of 9 navigation task questions. You have 60 minutes in total.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Coastal Exam Questions & Navigation"
  description="Practice all SBF Coastal exam questions from the official ELWIS catalog, incl. navigation task – structure, passing threshold and the 39 questions."
  lang="en"
  altUrl="https://boatpass.de/sbf-see-pruefungsfragen/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="SBF Coastal Exam Questions"
    lede="The complete official ELWIS coastal catalog – plus the navigation task with a real navigation section. Practice all 39 exam questions under real conditions."
    ctaLabel="Practice questions for free"
    cta
  >
    SBF Coastal questions –<br />practice including navigation
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfSee"
      items={[
        { k: 'Question catalogue', v: '285 questions (72 basic + 213 specific)' },
        { k: 'Theory exam', v: '39 questions · 60 min' },
        { k: 'Basic questions', v: '7, at least 5 correct' },
        { k: 'Specific questions', v: '23, at least 18 correct' },
        { k: 'Navigation task', v: '9 questions, at least 7 correct' },
      ]}
    />

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In a nutshell</p>
        <p class="pg-answer-text">
          The official SBF Coastal question catalog comprises 285 questions (72 basic + 213 specific coastal questions). The theory exam consists of 39 questions in 60 minutes: 30 standard questions (7 basic + 23 specific) plus 9 questions on the navigation task on the nautical chart. You pass if you get at least 5 of 7 basic questions, 18 of 23 specific questions and 7 of 9 navigation questions right. Boatpass trains the complete ELWIS catalog including a real navigation section.
        </p>
      </div>
    </section>

    <!-- The catalog -->
    <section class="pg-section">
      <h2 class="pg-h2">The official SBF Coastal question catalog</h2>
      <p class="pg-p">
        The <strong>exam questions for the SBF Coastal</strong> come from the official question catalog (DSV/DMYV, published via ELWIS) for the <strong>maritime waterways</strong> (North and Baltic Sea). It comprises <strong>72 basic questions and 213 specific coastal questions</strong> (285 questions in total). On top of that comes the decisive part that Inland doesn't have: the <strong>navigation task</strong>.
      </p>
      <p class="pg-p">
        The theory exam comprises a total of <strong>39 questions in 60 minutes</strong> – 30 standard questions plus 9 questions on the navigation task on the nautical chart.
      </p>
      <p class="pg-note pg-note--sm pg-note--after">
        Source: official question catalog (DSV/DMYV), published free of charge via <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">How the SBF Coastal theory exam is structured</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Exam paper</p>
          <p class="pg-card-text">39 questions · 60 minutes<br>Multiple choice + navigation</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basic questions</p>
          <p class="pg-card-text">7 questions<br>at least 5 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Specific questions</p>
          <p class="pg-card-text">23 questions<br>at least 18 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Navigation task</p>
          <p class="pg-card-text">9 questions<br>at least 7 correct</p>
        </div>
      </div>
    </section>

    <!-- Navigation task -->
    <section class="pg-section">
      <h2 class="pg-h2">The navigation task – the sticking point of the SBF Coastal</h2>
      <p class="pg-p">
        The navigation task is the part most candidates are wary of. On the official <strong>training chart</strong> you plot courses, determine positions and account for influences such as <strong>current, wind and tides</strong>. Of the 9 individual questions you have to solve at least 7 correctly.
      </p>
      <p class="pg-p">
        The big advantage: there are only <strong>15 official navigation tasks</strong> in total, one of which is set unchanged in the exam. Anyone who practices these 15 tasks with a <strong>real navigation section</strong> – just like in the actual exam – heads into exam day with confidence. That's exactly what the Boatpass app replicates.
      </p>
    </section>

    <!-- Practice effectively -->
    <section class="pg-section">
      <h2 class="pg-h2">Practice SBF Coastal questions effectively</h2>
      <div class="pg-rows">
        {[
          { icon: 'book', title: 'Complete ELWIS coastal catalog', desc: 'All questions on the coast and maritime waterways – fully covered, always up to date.' },
          { icon: 'compass', title: 'Navigation with a real navigation section', desc: 'Practice the navigation task the way it is set in the real exam – courses, positions, tides.' },
          { icon: 'target', title: 'Exam simulation: 39 questions, 60 minutes', desc: 'Real exam conditions including the navigation section and passing threshold.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Specifically repeat your weak spots instead of learning everything from scratch.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the SBF Coastal catalog</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The question catalog is divided into topic areas – practice in a targeted way based on your weak spots.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal: overview & app<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-inland-exam-questions/">Practice SBF Inland exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory & practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boating license cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sbf-coastal-navigation-tasks-explained/">SBF Coastal navigation tasks explained – structure & tips<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/hardest-sbf-exam-questions/">The hardest SBF exam questions – and how to master them<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
