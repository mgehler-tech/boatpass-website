---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';
import { PLAY_STORE_URL } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Exam Process", "item": "https://boatpass.de/en/sbf-exam/" },
  ],
};

const faqs = [
  {
    q: 'How does the SBF exam work?',
    a: 'The SBF exam consists of a theory part and a practical part. In the theory you answer a multiple-choice paper (SBF Inland: 30 questions in 45 minutes; SBF Coastal: 39 questions incl. navigation task in 60 minutes). In the practical part you demonstrate maneuvers on the water such as coming alongside and casting off, turning and man-overboard, as well as the most important knots.',
  },
  {
    q: 'Do I have to do theory and practice on the same day?',
    a: 'That depends on the exam center. Theory and practice often take place on the same date, but they are separate exam parts. Both have to be passed in order to receive the license.',
  },
  {
    q: 'What happens if I fail?',
    a: 'You can retake the part you didn\'t pass. Exam fees apply again. With targeted preparation – exam simulation and mistake training – most candidates pass on the first attempt, however.',
  },
  {
    q: 'What requirements do I need for the SBF exam?',
    a: 'For the SBF Inland the minimum age is 16. You register with the responsible examination board (e.g. DMYV). A preparation course is not required – you can prepare entirely on your own.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// HowTo schema: mirrors this page's step-by-step guide (registration → theory exam → practical exam),
// same pattern as the German version and BlogLayout.
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How the German boating license (SBF) exam works",
  "description": "Step by step to the German boating license: registration with the examination board, the theory exam and the practical exam for SBF Inland and SBF Coastal.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Register with the examination board",
      "text": "Register with the responsible examination board (e.g. DMYV). For the SBF Inland the minimum age is 16. A preparation course is not required – you can prepare entirely on your own.",
    },
    {
      "@type": "HowToStep",
      "name": "Pass the theory exam",
      "text": "Answer the multiple-choice paper from the official ELWIS catalog: SBF Inland 30 questions in 45 minutes (at least 5 of 7 basic and 18 of 23 specific questions correct), SBF Coastal 39 questions incl. navigation task in 60 minutes.",
    },
    {
      "@type": "HowToStep",
      "name": "Pass the practical exam",
      "text": "Show on the water that you can handle a boat safely: coming alongside and casting off, turning, stopping and the man-overboard maneuver, as well as the exam-relevant knots.",
    },
  ],
};
---

<BaseLayout
  title="SBF Exam Process – Theory & Practice"
  description="How does the German boating license exam work? Theory & practice: structure, questions, maneuvers, passing thresholds – SBF Inland and SBF Coastal."
  lang="en"
  altUrl="https://boatpass.de/sbf-pruefung-ablauf/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Boating License · Inland & Coastal"
    lede="Theory and practice explained step by step: structure, questions, maneuvers and passing thresholds for SBF Inland and SBF Coastal. So you know exactly what to expect on exam day."
    ctaLabel="Prepare for the theory"
    cta
  >
    The SBF exam –<br />how it works
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfBinnen"
      from
      items={[
        { k: 'Theory Inland', v: '30 questions · 45 min' },
        { k: 'Theory Coastal', v: '39 questions · 60 min (incl. navigation)' },
        { k: 'Pass mark', v: '5 of 7 basic, 18 of 23 specific' },
        { k: 'Minimum age', v: '16 years' },
        { k: 'Registration', v: 'Exam board (DMYV)' },
      ]}
    />

    <!-- Scope note -->
    <div class="pg-card pg-card--soft pg-card--note">
      <span class="pg-row-icon pg-row-icon--sm">
        <Icon name="document" size={18} strokeWidth={1.75} />
      </span>
      <div class="pg-card-text">
        <strong>This page describes the process of the boating license exam – for <a href="/en/sbf-inland/" class="pg-inline-link">SBF Inland</a> and <a href="/en/sbf-coastal/" class="pg-inline-link">SBF Coastal</a>.</strong>
        The radio certificates have their own exam process – you'll find the structure and contents on the pages for <a href="/en/ubi/" class="pg-inline-link">UBI</a>, <a href="/en/src/" class="pg-inline-link">SRC</a> and <a href="/en/lrc/" class="pg-inline-link">LRC</a>.
      </div>
    </div>

    <!-- Overview -->
    <section class="pg-section">
      <h2 class="pg-h2">Theory and practice – two exam parts</h2>
      <p class="pg-p">
        The <strong>boating license exam</strong> consists of two separate parts: a <strong>theory exam</strong> (multiple-choice paper) and a <strong>practical exam</strong> on the water. You have to pass both to receive the license. The exam is administered by a recognized examination board (e.g. DMYV).
      </p>
      <p class="pg-p">
        A preparation course is <strong>not required</strong> – you can learn the theory independently with the official question catalog.
      </p>
    </section>

    <!-- Theory -->
    <section class="pg-section">
      <h2 class="pg-h2">1. The theory exam</h2>
      <p class="pg-p">
        In the theory you answer a question paper from the official ELWIS catalog. The structure differs depending on the license:
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">SBF Inland</p>
          <div class="pg-card-text">30 questions · 45 minutes<br>7 basic questions (at least 5 correct)<br>23 specific questions (at least 18 correct)</div>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">SBF Coastal</p>
          <div class="pg-card-text">39 questions · 60 minutes<br>30 standard questions like Inland<br>+ 9 navigation task questions (at least 7 correct)</div>
        </div>
      </div>
    </section>

    <!-- Practice -->
    <section class="pg-section">
      <h2 class="pg-h2">2. The practical exam</h2>
      <p class="pg-p">
        In the practical part you show on the water that you can handle a boat safely. Typically tested are:
      </p>
      <div class="pg-rows">
        {[
          { icon: 'lifebuoy', title: 'Maneuvers', desc: 'Coming alongside and casting off, turning, stopping and the important man-overboard maneuver.', href: '/en/blog/docking-undocking-harbor-maneuvers/' },
          { icon: 'knot', title: 'Knots', desc: 'Applying the exam-relevant knots confidently and quickly (e.g. bowline, clove hitch, securing a cleat).', href: '/en/blog/most-important-knots-sbf/' },
          { icon: 'compass', title: 'Boat handling & safety', desc: 'Correct behavior on board, give-way rules and safe steering in the area.', href: '/en/blog/right-of-way-collision-rules/' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div>
              <div class="pg-row-title">
                {f.href ? <a href={f.href} class="pg-card-link">{f.title}</a> : f.title}
              </div>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="pg-note pg-note--after">
        For the practical part, at least one day of practice on the water is recommended. The exact requirements can vary slightly depending on the examination board.
      </p>
    </section>

    <!-- Requirements / Registration -->
    <section class="pg-section">
      <h2 class="pg-h2">Requirements & registration</h2>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">Minimum age</p>
          <p class="pg-card-text">16 years (SBF Inland)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Registration</p>
          <p class="pg-card-text">with the examination board (DMYV)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Course requirement</p>
          <p class="pg-card-text">none – self-study possible</p>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        For a step-by-step walkthrough of registering with the DSV and DMYV, see our <a href="/en/blog/how-to-register-sbf-exam/" class="pg-inline-link">SBF exam registration guide</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the exam process</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-inland-exam-questions/">Practice SBF Inland exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal-exam-questions/">Practice SBF Coastal exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boating license cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/man-overboard-maneuver/">Man-overboard maneuver: how to nail it in the practical exam<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/docking-undocking-harbor-maneuvers/">Docking and undocking: harbor maneuvers for the practical exam<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/sound-signals-sbf-explained/">Sound signals for the SBF: coastal & inland overview<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/first-aid-on-board/">First aid on board: the essential measures on the water<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/failed-sbf-inland-exam-what-to-do-next/">Failed the SBF Inland exam? What to do next<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/blood-alcohol-limit-boat/">Blood alcohol limit on a boat – what skippers need to know<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/environmental-protection-boating-water-conservation/">Environmental protection and water conservation for boaters<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
