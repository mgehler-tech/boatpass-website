---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import LearningSteps from '../../components/LearningSteps.astro';
import FounderNote from '../../components/FounderNote.astro';
import PricingSection from '../../components/PricingSection.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import BlogTeaser from '../../components/BlogTeaser.astro';
import FinderTeaser from '../../components/FinderTeaser.astro';
import { getBoatpassRating } from '../../data/apps';

const appRating = getBoatpassRating();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Boatpass",
  "alternateName": "Boatpass – German Boating License App",
  "url": "https://boatpass.de/en/",
  "inLanguage": "en-US",
  "publisher": { "@type": "Organization", "name": "Boatpass", "url": "https://boatpass.de" },
};

const faqs = [
  {
    q: 'What is the German boating license (SBF)?',
    a: 'The Sportbootführerschein (SBF) is Germany’s official license for powered recreational boats – issued as SBF Inland or SBF Coastal depending on the waters. It requires passing a theory and a practical exam based on the official ELWIS question catalog from DSV and DMYV.',
  },
  {
    q: 'What’s the difference between SBF Inland and SBF Coastal?',
    a: 'The SBF Inland covers inland waterways, while the SBF Coastal covers coastal and offshore waters. The SBF Coastal exam also includes a navigation task with 9 questions that isn’t part of the SBF Inland exam.',
  },
  {
    q: 'How much does the German boating license cost?',
    a: 'Official exam fees are €130.78 for the SBF Inland and €148.38 for the SBF Coastal. With a preparation course, total costs in 2026 are usually €500–650 per license – learning the theory yourself with an app saves the course fee.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Boating License App – Learn SBF Inland & Coastal"
  description="The best study app for the German boating license (SBF Inland & Coastal): official ELWIS exam questions, exam simulation & mistake training. Free start."
  lang="en"
  appRating={appRating}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Gleiche Reihenfolge wie auf der deutschen Startseite, ohne die
       Bewertungs-Sektion: Alle vorliegenden Rezensionen sind deutschsprachig,
       und eine übersetzte Rezension wäre keine Rezension mehr. -->
  <HeroSection lang="en" />
  <LearningSteps lang="en" />
  <FounderNote lang="en" />
  <PricingSection lang="en" withGuarantee withSourceNote={false} />
  <CatalogSources lang="en" collapsible />
  <FinderTeaser lang="en" />
  <BlogTeaser lang="en" />

  <div class="home-faq section-band">
    <section>
      <span class="section-eyebrow" style="margin-bottom:14px;">FAQ</span>
      <h2 class="section-display-title" style="margin-bottom:24px;">Frequently Asked Questions</h2>
      <!-- Akkordeon wie auf der deutschen Startseite und auf /faq/. -->
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <details class="faq-item home-faq-item">
            <summary class="home-faq-q">
              <h3>{f.q}</h3>
              <span class="home-faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="home-faq-a">{f.a}</div>
          </details>
        ))}
      </div>
      <p style="font-size:15px; color:#656B78; line-height:1.7; margin-top:16px;">
        Find more answers in the <a href="/en/faq/" style="color:#3366FF; text-decoration:underline;">German boating license FAQ</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* Akkordeon der Startseiten-FAQ. Übernimmt Rahmen und Radius von .faq-item
     auf /faq/, damit beide Seiten gleich aussehen. */
  .home-faq-item {
    background: #fff;
    border: 1px solid rgba(51, 102, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }
  .home-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    /* WCAG 2.5.5: sichere Treffergröße */
    min-height: 56px;
  }
  .home-faq-q::-webkit-details-marker { display: none; }
  .home-faq-q h3 {
    font-size: 16px;
    font-weight: 700;
    color: #1A1F36;
    margin: 0;
    line-height: 1.4;
  }
  .home-faq-q:focus-visible { outline: 2px solid #3366FF; outline-offset: -2px; }

  /* Chevron per CSS statt Zeichen: dreht beim Öffnen. */
  .home-faq-icon {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-right: 2px solid #3366FF;
    border-bottom: 2px solid #3366FF;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s ease;
  }
  .home-faq-item[open] .home-faq-icon {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .home-faq-a {
    padding: 0 22px 22px;
    font-size: 15px;
    color: #656B78;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq-icon { transition: none; }
  }

  html.dark .home-faq-item {
    background: #181E2E;
    border-color: rgba(90, 120, 255, 0.12);
  }
  html.dark .home-faq-q h3 { color: #E2E8F0; }
  html.dark .home-faq-a { color: #94A3B8; }
</style>
