---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBoot from '../../components/home/HomeBoot.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import HomeJourney from '../../components/home/HomeJourney.astro';
import HomeFounder from '../../components/home/HomeFounder.astro';
import HomePricing from '../../components/home/HomePricing.astro';
import HomeCatalogs from '../../components/home/HomeCatalogs.astro';
import HomeGuide from '../../components/home/HomeGuide.astro';
import HomeFinalCta from '../../components/home/HomeFinalCta.astro';
import { getBoatpassRating } from '../../data/apps';
import '../../styles/home.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesLatinItalic from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';

const appRating = getBoatpassRating();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Boatpass",
  "alternateName": "Boatpass – German Boating License App",
  "url": "https://boatpass.de/en/",
  "inLanguage": "en-US",
  "publisher": { "@type": "Organization", "name": "Boatpass", "url": "https://boatpass.de" },
};

const faqs = [
  {
    q: 'What is the German boating license (SBF)?',
    a: 'The Sportbootführerschein (SBF) is Germany’s official license for powered recreational boats – issued as SBF Inland or SBF Coastal depending on the waters. It requires passing a theory and a practical exam based on the official ELWIS question catalog from DSV and DMYV.',
  },
  {
    q: 'What’s the difference between SBF Inland and SBF Coastal?',
    a: 'The SBF Inland covers inland waterways, while the SBF Coastal covers coastal and offshore waters. The SBF Coastal exam also includes a navigation task with 9 questions that isn’t part of the SBF Inland exam.',
  },
  {
    q: 'How much does the German boating license cost?',
    a: 'Official exam fees are €130.78 for the SBF Inland and €148.38 for the SBF Coastal. With a preparation course, total costs in 2026 are usually €500–650 per license – learning the theory yourself with an app saves the course fee.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Boating License App – SBF Inland & Coastal"
  description="The best study app for the German boating license (SBF Inland & Coastal): official ELWIS exam questions, exam simulation & mistake training. Free start."
  lang="en"
  appRating={appRating}
  showCta={false}
>
  <Fragment slot="head">
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatinItalic} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <HomeBoot />
  <!-- Same route as the German home page, without the reviews section: every
       review we have is in German, and a translated review is no longer a
       review. -->
  <div class="home">
    <HomeHero lang="en" />
    <HomeJourney lang="en" />
    <HomeFounder lang="en" />
    <HomePricing lang="en" />
    <HomeCatalogs lang="en" />
    <HomeGuide lang="en" faqs={faqs} />
    <HomeFinalCta lang="en" />
  </div>
</BaseLayout>

<script>
  import '../../scripts/home-motion';
</script>
