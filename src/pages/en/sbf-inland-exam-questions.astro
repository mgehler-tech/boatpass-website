---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Inland", "item": "https://boatpass.de/en/sbf-inland/" },
    { "@type": "ListItem", "position": 3, "name": "Exam Questions", "item": "https://boatpass.de/en/sbf-inland-exam-questions/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & waterways regulations', count: 124, icon: 'scale' },
  { name: 'Navigation', desc: 'Charts, courses, positions & bearings', count: 52, icon: 'compass' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 39, icon: 'shield' },
  { name: 'Signals & marks', desc: 'Sound signals, visual signals & flags', count: 28, icon: 'bell' },
  { name: 'Meteorology', desc: 'Wind, weather & forecasting', count: 5, icon: 'cloud' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 3, icon: 'document' },
];

const faqs = [
  {
    q: 'How many questions are in the SBF Inland catalog?',
    a: 'The official question catalog for the SBF Inland under engine comprises 72 basic questions and 181 specific inland questions (253 questions in total). For the sailing scope, 47 sailing questions are added. In the exam, 30 questions are drawn from these (7 basic questions + 23 specific questions).',
  },
  {
    q: 'Where do I find the official SBF Inland exam questions?',
    a: 'The complete question catalog is published free of charge by ELWIS (Electronic Waterways Information System). In the Boatpass app you learn exactly these questions structured by category – including exam simulation and mistake training.',
  },
  {
    q: 'Are the questions in the app identical to the real exam?',
    a: 'Yes. The app contains the complete, current official ELWIS catalog. You learn exactly the questions that are also asked in the real theory exam – when the catalog is updated, the app follows promptly.',
  },
  {
    q: 'How many questions do I have to answer correctly to pass?',
    a: 'You pass if you answer at least 5 of 7 basic questions and at least 18 of 23 specific questions correctly. You have 45 minutes in total.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Inland Exam Questions – ELWIS Catalog"
  description="Practice all SBF Inland exam questions from the official ELWIS catalog: structure, categories, passing threshold and how to master the 30 questions."
  lang="en"
  altUrl="https://boatpass.de/sbf-binnen-pruefungsfragen/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="SBF Inland Exam Questions"
    lede="Over 250 official ELWIS questions, clearly sorted by category. Learn with a real exam simulation and targeted mistake training – and head into the SBF Inland theory exam with confidence."
    ctaLabel="Practice questions for free"
    cta
  >
    SBF Inland questions –<br />practice the official catalog
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="sbfBinnen"
      items={[
        { k: 'Question catalogue', v: '253 questions (72 basic + 181 specific)' },
        { k: 'Theory exam', v: '30 questions · 45 min' },
        { k: 'Basic questions', v: '7, at least 5 correct' },
        { k: 'Specific questions', v: '23, at least 18 correct' },
      ]}
    />

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In a nutshell</p>
        <p class="pg-answer-text">
          The official SBF Inland question catalog comprises 253 questions (72 basic + 181 specific inland questions); under sail, 47 sailing questions are added. In the theory exam, 30 questions are drawn from these (7 basic + 23 specific), to be solved in 45 minutes. You pass if you answer at least 5 of 7 basic questions and 18 of 23 specific questions correctly. Boatpass trains exactly this ELWIS catalog with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- The catalog -->
    <section class="pg-section">
      <h2 class="pg-h2">The official SBF Inland question catalog</h2>
      <p class="pg-p">
        The <strong>exam questions for the SBF Inland</strong> come from the official question catalog set by the <strong>DSV and DMYV</strong> and published free of charge via <strong>ELWIS</strong>. For the <strong>under engine</strong> scope it comprises <strong>72 basic questions and 181 specific inland questions</strong> (253 questions in total). Anyone who also wants to navigate <strong>under sail</strong> learns 47 additional sailing questions.
      </p>
      <p class="pg-p">
        In the real theory exam, a paper of <strong>30 questions</strong> is compiled from these – 7 basic questions and 23 specific questions. Anyone who works through the catalog systematically knows every possible question on exam day.
      </p>
      <p class="pg-note pg-note--sm pg-note--after">
        Source: official question catalog (DSV/DMYV), published free of charge via <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-neu-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">How the theory exam is structured</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Exam paper</p>
          <p class="pg-card-text">30 questions · 45 minutes<br>Multiple choice</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basic questions</p>
          <p class="pg-card-text">7 questions<br>at least 5 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Specific questions</p>
          <p class="pg-card-text">23 questions<br>at least 18 correct</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Question catalog</p>
          <p class="pg-card-text">253 questions (engine)<br>+ 47 sailing questions</p>
        </div>
      </div>
    </section>

    <!-- Practice effectively -->
    <section class="pg-section">
      <h2 class="pg-h2">Practice SBF Inland questions effectively</h2>
      <div class="pg-rows">
        {[
          { icon: 'book', title: 'Learning mode: category by category', desc: 'Work through the complete catalog structured by topic, at your own pace. That way no topic is left open.' },
          { icon: 'target', title: 'Exam simulation: 30 questions, 45 minutes', desc: 'Practice under real exam conditions with a random paper and passing threshold – just like on exam day.' },
          { icon: 'refresh', title: 'Mistake training: only your weak spots', desc: 'Specifically repeat the questions you don\'t know yet, instead of wasting time on what you\'ve already learned.' },
          { icon: 'chart', title: 'Keep an eye on your progress', desc: 'See, broken down by category, where you stand and when you\'re ready for the exam.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the catalog</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The question catalog is divided into topic areas – practice in a targeted way based on your weak spots.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Further reading</h2>
      <ul class="pg-related">
        <li><a href="/en/sbf-inland/">Learn SBF Inland: overview & app<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal-exam-questions/">Practice SBF Coastal exam questions<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-exam/">SBF exam: how theory & practice work<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-costs/">What does the boating license cost?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/hardest-sbf-exam-questions/">The hardest SBF exam questions – and how to master them<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/most-common-sbf-mistakes/">The most common mistakes in the SBF exam – and how to avoid them<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
