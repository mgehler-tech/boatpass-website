---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Inland", "item": "https://boatpass.de/en/sbf-inland/" },
    { "@type": "ListItem", "position": 3, "name": "Exam Questions", "item": "https://boatpass.de/en/sbf-inland-exam-questions/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Maritime law', desc: 'Right-of-way rules, navigation lights & waterways regulations', count: 124, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation', desc: 'Charts, courses, positions & bearings', count: 52, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Safety', desc: 'Rescue equipment, distress signals & safety behavior', count: 39, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signals & marks', desc: 'Sound signals, visual signals & flags', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Meteorology', desc: 'Wind, weather & forecasting', count: 5, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'General', desc: 'General fundamentals & seamanship', count: 3, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
];

const faqs = [
  {
    q: 'How many questions are in the SBF Inland catalog?',
    a: 'The official question catalog for the SBF Inland under engine comprises 72 basic questions and 181 specific inland questions (253 questions in total). For the sailing scope, 47 sailing questions are added. In the exam, 30 questions are drawn from these (7 basic questions + 23 specific questions).',
  },
  {
    q: 'Where do I find the official SBF Inland exam questions?',
    a: 'The complete question catalog is published free of charge by ELWIS (Electronic Waterways Information System). In the Boatpass app you learn exactly these questions structured by category – including exam simulation and mistake training.',
  },
  {
    q: 'Are the questions in the app identical to the real exam?',
    a: 'Yes. The app contains the complete, current official ELWIS catalog. You learn exactly the questions that are also asked in the real theory exam – when the catalog is updated, the app follows promptly.',
  },
  {
    q: 'How many questions do I have to answer correctly to pass?',
    a: 'You pass if you answer at least 5 of 7 basic questions and at least 18 of 23 specific questions correctly. You have 45 minutes in total.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF Inland Exam Questions – Practice the Official Catalog"
  description="Practice all SBF Inland exam questions from the official ELWIS catalog: structure, categories, passing threshold and how to learn the 30 exam questions effectively."
  lang="en"
  altUrl="https://boatpass.de/sbf-binnen-pruefungsfragen/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        SBF Inland Exam Questions
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        SBF Inland questions –<br>practice the official catalog
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Over 250 official ELWIS questions, clearly sorted by category. Learn with a real exam simulation and targeted mistake training – and head into the SBF Inland theory exam with confidence.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Practice questions for free
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">In a nutshell</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          The official SBF Inland question catalog comprises 253 questions (72 basic + 181 specific inland questions); under sail, 47 sailing questions are added. In the theory exam, 30 questions are drawn from these (7 basic + 23 specific), to be solved in 45 minutes. You pass if you answer at least 5 of 7 basic questions and 18 of 23 specific questions correctly. Boatpass trains exactly this ELWIS catalog with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- The catalog -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">The official SBF Inland question catalog</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        The <strong>exam questions for the SBF Inland</strong> come from the official question catalog set by the <strong>DSV and DMYV</strong> and published free of charge via <strong>ELWIS</strong>. For the <strong>under engine</strong> scope it comprises <strong>72 basic questions and 181 specific inland questions</strong> (253 questions in total). Anyone who also wants to navigate <strong>under sail</strong> learns 47 additional sailing questions.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        In the real theory exam, a paper of <strong>30 questions</strong> is compiled from these – 7 basic questions and 23 specific questions. Anyone who works through the catalog systematically knows every possible question on exam day.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:14px;">
        Source: official question catalog (DSV/DMYV), published free of charge via <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-neu-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
    </section>

    <!-- Exam structure -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">How the theory exam is structured</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Exam paper</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">30 questions · 45 minutes<br>Multiple choice</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basic questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 questions<br>at least 5 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Specific questions</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">23 questions<br>at least 18 correct</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Question catalog</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">253 questions (engine)<br>+ 47 sailing questions</div>
        </div>
      </div>
    </section>

    <!-- Practice effectively -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Practice SBF Inland questions effectively</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: 'book', title: 'Learning mode: category by category', desc: 'Work through the complete catalog structured by topic, at your own pace. That way no topic is left open.' },
          { icon: 'target', title: 'Exam simulation: 30 questions, 45 minutes', desc: 'Practice under real exam conditions with a random paper and passing threshold – just like on exam day.' },
          { icon: 'refresh', title: 'Mistake training: only your weak spots', desc: 'Specifically repeat the questions you don\'t know yet, instead of wasting time on what you\'ve already learned.' },
          { icon: 'chart', title: 'Keep an eye on your progress', desc: 'See, broken down by category, where you stand and when you\'re ready for the exam.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon as IconName} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Frequently asked questions about the catalog</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <div style="font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</div>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">Learn by category</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        The question catalog is divided into topic areas – practice in a targeted way based on your weak spots.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
            </div>
            <span style="font-size:12px; font-weight:700; color:#6B7280; background:rgba(0,0,0,0.04); border:1px solid rgba(0,0,0,0.07); border-radius:100px; padding:3px 10px; flex-shrink:0; white-space:nowrap;">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h2 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Further reading</h2>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/en/sbf-inland/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Learn SBF Inland: overview & app</a>
        <a href="/en/sbf-coastal-exam-questions/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Practice SBF Coastal exam questions</a>
        <a href="/en/sbf-exam/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF exam: how theory & practice work</a>
        <a href="/en/sbf-costs/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ What does the boating license cost?</a>
        <a href="/en/blog/sound-signals-sbf-explained/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Sound signals for the boating license: coastal & inland at a glance</a>
        <a href="/en/blog/hardest-sbf-exam-questions/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ The hardest SBF exam questions – and how to master them</a>
      </div>
    </section>

  </div>
</BaseLayout>
