---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeBridge from '../../components/PracticeBridge.astro';
import PageHead from '../../components/page/PageHead.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import PageLink from '../../components/page/PageLink.astro';
import Icon from '../../components/Icon.astro';
import CatalogSources from '../../components/CatalogSources.astro';
import type { IconName } from '../../icons';
import PlatformPrice from '../../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://boatpass.de/en/" },
    { "@type": "ListItem", "position": 2, "name": "LRC Marine Radio", "item": "https://boatpass.de/en/lrc/" },
  ],
};

// Course schema: clearly marks the page as a learning course for the LRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "LRC Exam Preparation – Long Range Certificate",
  "description": "Preparation for the Long Range Certificate (LRC) exam, the general operator's certificate for worldwide marine radio (VHF, MF/HF, satellite) – with the official ELWIS question catalog (76 questions), exam simulation and mistake training.",
  "url": "https://boatpass.de/en/lrc/",
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Advanced",
  "teaches": [
    "Marine radio via VHF, MF and HF",
    "Satellite radio in the GMDSS (Inmarsat, EPIRB, SART)",
    "Distress, urgency and safety traffic",
    "Radio regulations and sea areas A1–A4",
    "Marine radio English and phonetic alphabet",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('lrc'),
};

const faqs = [
  {
    q: 'How does the LRC exam work?',
    a: 'In the theory you answer a paper with 14 LRC questions in 20 minutes – passed from 11 correct answers. Anyone who does not yet hold an SRC additionally works through the SRC paper with 24 questions. Added to that are an English dictation with translation and a practical part on the GMDSS equipment. Boatpass trains the official LRC question catalog with 76 questions.',
  },
  {
    q: 'What is the difference between LRC and SRC?',
    a: 'The SRC is valid only for VHF marine radio in the coastal area (sea area A1). The LRC is the highest marine radio certificate in recreational boating and is valid worldwide in all sea areas A1–A4 – via VHF, MF/HF and satellite. The LRC fully includes the functional scope of the SRC.',
  },
  {
    q: 'What does the LRC cost?',
    a: 'The official exam fee for the LRC varies by association and federal state and is around €188–207. An optional preparation course costs an additional €300–500 but is not mandatory. These fees are independent of the Boatpass LRC learning module (one-time ' + priceText('lrc', 'en') + ').',
  },
  {
    q: 'From what age can I take the LRC?',
    a: 'You can apply for the LRC from age 18; on the exam day you must be at least 17 years and 9 months old. The LRC is administered by the examination boards of the DSV and DMYV and is internationally recognized and valid without a time limit.',
  },
  {
    q: 'Do I need the SRC first before taking the LRC?',
    a: 'No. Anyone who does not hold an SRC additionally works through the SRC paper with 24 questions in the LRC exam. The LRC includes the complete functional scope of the SRC, so you don\'t need to obtain it separately beforehand.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm schema: machine-readable short definition for entity clarity
// with AI search engines. Mirrors the text of the "What is the LRC?" section.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "LRC",
  "alternateName": "Long Range Certificate",
  "description": "The Long Range Certificate (LRC) is the official authorization for unrestricted participation in the worldwide maritime radio service within the GMDSS. It permits radio via VHF, MF and HF as well as via satellite and is the highest marine radio certificate in recreational boating.",
  "url": "https://boatpass.de/en/lrc/",
  "inLanguage": "en",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'VHF & operating procedures', desc: 'Marine radio, DSC, speaking procedures & GMDSS overview', count: 19, icon: 'microphone' },
  { name: 'MF & HF', desc: 'MF/HF radio, NAVTEX & transmission procedures', count: 15, icon: 'wifi' },
  { name: 'Satellite radio', desc: 'GMDSS satellite, Inmarsat, EPIRB & SART', count: 13, icon: 'satellite' },
  { name: 'Distress & safety traffic', desc: 'Mayday, distress DSC & SAR coordination', count: 11, icon: 'shield' },
  { name: 'Radio regulations', desc: 'ITU Radio Regulations, sea areas A1–A4 & certification', count: 10, icon: 'scale' },
  { name: 'English & phonetics', desc: 'Distress English, phonetic alphabet & distress calls', count: 8, icon: 'document' },
];

---

<BaseLayout
  title="LRC Study App – Learn the Long Range Certificate"
  description={`Learn the LRC radio certificate: exam format, contents and costs. Boatpass LRC module, one-time payment from ${minPrice(['lrc'], 'en')} with exam simulation – start today.`}
  lang="en"
  altUrl="https://boatpass.de/lrc/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="en"
    eyebrow="Long Range Certificate · Worldwide Marine Radio"
    lede="The Long Range Certificate (LRC) is the highest marine radio certificate in recreational boating – valid for VHF, MF/HF and satellite radio in all sea areas worldwide."
    ctaLabel="Start learning LRC in the app"
    cta
  >
    Learn LRC –<br />General Operator's Certificate
    <span slot="badge">Boatpass LRC module – now available · one-time&nbsp;<PlatformPrice product="lrc" lang="en" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="en"
      title="At a glance"
      product="lrc"
      items={[
        { k: 'Question catalogue', v: '76 questions' },
        { k: 'Theory', v: '20 min, pass from 11 correct' },
        { k: 'Practical', v: 'Operating GMDSS equipment' },
        { k: 'Exam fee', v: 'approx. €188–207' },
        { k: 'Minimum age', v: '18 years (application)' },
      ]}
    />

    <!-- Answer snippet: short, quotable direct answer for search engines & AI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">In a nutshell</p>
        <p class="pg-answer-text">
          The LRC (Long Range Certificate) is the highest marine radio certificate in recreational boating and is valid worldwide for VHF, MF/HF and satellite radio (all sea areas A1–A4). It builds on the SRC: in the theory you answer a paper of 14 LRC questions in 20 minutes – passed from 11 correct answers. Anyone without an SRC additionally works through the SRC paper (24 questions). Added to that are an English dictation with translation and a practical part. Boatpass trains the official LRC question catalog (76 questions) with exam simulation and mistake training.
        </p>
      </div>
    </section>

    <!-- What is LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">What is the LRC?</h2>
      <p class="pg-p">
        The <strong>Long Range Certificate (LRC)</strong> is the official authorization for unrestricted participation in the worldwide maritime radio service within the GMDSS (Global Maritime Distress and Safety System). It permits radio via <strong>VHF, MF and HF</strong> as well as via <strong>satellite</strong> – i.e. also far from the coast on the high seas.
      </p>
      <p class="pg-p">
        This makes the LRC the <strong>highest marine radio certificate in recreational boating</strong>. It is administered by the examination boards of the German Sailing Association (DSV) and the German Motor Yachting Association (DMYV), is internationally recognized and valid indefinitely.
      </p>
    </section>

    <!-- Source transparency: official question catalog -->
    <section class="pg-section">
      <CatalogSources lang="en" only="lrc" />
    </section>

    <!-- Who needs it -->
    <section class="pg-section">
      <h2 class="pg-h2">Who needs the LRC?</h2>
      <div class="pg-rows">
        {([
          { icon: 'waves', title: 'Offshore & blue water', desc: 'Offshore and blue-water sailors traveling beyond VHF range (sea areas A2–A4)' },
          { icon: 'satellite', title: 'MF/HF radio', desc: 'Anyone using MF/HF radio or satellite communication (e.g. Inmarsat) on board' },
          { icon: 'compass', title: 'Long-distance & Atlantic', desc: 'Skippers on long passages, an Atlantic crossing or a circumnavigation' },
          { icon: 'anchor', title: 'Worldwide certificate', desc: 'Anyone who wants an unrestricted, worldwide-valid marine radio certificate instead of the coastal SRC' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- LRC vs SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">LRC vs. SRC: what's the difference?</h2>
      <div class="lrc-compare-grid">
        <div class="pg-card pg-card--current">
          <p class="pg-card-title">LRC</p>
          <p class="pg-card-sub">Long Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Worldwide (sea areas A1–A4)</li>
            <li>✓ VHF + MF/HF</li>
            <li>✓ Satellite radio (GMDSS)</li>
            <li>✓ Unrestricted validity</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">SRC</p>
          <p class="pg-card-sub">Short Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Coastal area (sea area A1)</li>
            <li>✓ VHF marine radio only</li>
            <li>✗ No MF/HF</li>
            <li>✗ No satellite radio</li>
          </ul>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        For most coastal areas the <a href="/en/src/" class="pg-inline-link">SRC</a> is sufficient. But anyone who wants to use radio on the high seas needs the LRC – it fully includes the scope of the SRC.
      </p>
    </section>

    <!-- Exam structure -->
    <section class="pg-section">
      <h2 class="pg-h2">LRC exam: structure & contents</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theory</p>
          <p class="pg-card-text">Written<br>Multiple choice (SRC + LRC papers)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">English</p>
          <p class="pg-card-text">Receive & translate distress calls<br>Send texts (phonetics)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Practice</p>
          <p class="pg-card-text">Operating GMDSS devices<br>DSC, MF/HF, satellite</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Minimum age</p>
          <p class="pg-card-text">18 years (application)<br>on exam day ≥ 17 y. 9 mo.</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Exam topics:</strong> the GMDSS system and sea areas A1–A4, VHF/MF/HF marine radio, DSC procedures (Digital Selective Calling), satellite radio (Inmarsat), NAVTEX, distress, urgency and safety traffic, international distress English and the phonetic alphabet, plus the ITU radio regulations (Radio Regulations).
        </p>
      </div>
    </section>

    <PracticeBridge variant="radio" lang="en" />

    <!-- Costs -->
    <section class="pg-section">
      <h2 class="pg-h2">What does the LRC cost?</h2>
      <p class="pg-p">
        For the official LRC exam there is a fee for admission, the exam and the issuance of the certificate:
      </p>
      <div class="pg-fees">
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Admission, exam & issuance</p>
            <p class="pg-fee-desc">Official fee via DSV / DMYV (theory + practice + certificate)</p>
          </div>
          <p class="pg-fee-price h-num">approx. €188</p>
        </div>
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Preparation course (optional)</p>
            <p class="pg-fee-desc">Radio school with study material & practical training</p>
          </div>
          <p class="pg-fee-price h-num">approx. €300–500</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        The exact exam fee varies by association and federal state (approx. €188–207). A preparation course is not required – you can also learn the theory independently with the official question catalog. These official fees are independent of the Boatpass LRC learning module (one-time {priceText('lrc', 'en')}).
      </p>
    </section>

    <!-- How Boatpass helps with the LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">How Boatpass helps with the LRC</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Complete LRC question catalog', desc: 'All official LRC questions – including the SRC part and the LRC extension – always up to date.' },
          { icon: 'target', title: 'Exam simulation', desc: 'Practice under real conditions: written theory exam with a passing threshold and time pressure.' },
          { icon: 'refresh', title: 'Mistake training', desc: 'Only practice your weak spots – no time lost on content you\'ve already learned.' },
          { icon: 'chart', title: 'Progress by category', desc: 'See which LRC topics you have a firm grasp of and where there are still gaps.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Learn by category -->
    <section class="pg-section">
      <h2 class="pg-h2">Learn by category</h2>
      <p class="pg-p">
        The LRC question catalog comprises {categories.reduce((s, c) => s + c.count, 0)} questions across {categories.length} topic areas – practice in a targeted way based on your weak spots.
      </p>
      <p class="pg-note pg-note--sm">
        Source: official question catalog on <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} questions</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass LRC module available -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Now available</p>
          <h2 class="pg-h2">Boatpass LRC module</h2>
          <p class="pg-p">The LRC module for Boatpass is here – with the same learning concept as SBF Inland & Coastal: official question catalog, exam simulation and targeted mistake training. One-time <strong><PlatformPrice product="lrc" lang="en" /></strong>, no subscription.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="lrc" lang="en" alt /></span> <span class="pg-cta-unit">one-time purchase</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            Unlock the LRC module in the app
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Frequently asked questions about the LRC</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Related licenses</h2>
      <ul class="pg-related">
        <li><a href="/en/radio-certificate-app/">Radio certificate apps compared<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/src/">SRC – Short Range Certificate for marine radio<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/sbf-coastal/">Learn SBF Coastal with Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/ubi/">UBI – VHF radio certificate inland<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/faq/">Frequently asked questions about the boating license<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/ubi-vs-src-radio-license/">UBI or SRC – which radio certificate fits your boat?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/marine-radio-basics-beginners/">Marine radio basics: channels, DSC and distress calls<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/distress-signals-at-sea/">Distress signals at sea: what you need to know<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/en/blog/gps-chartplotter-vhf-modern-navigation/">GPS, chartplotters & VHF radio – modern onboard navigation<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

<style>
  /* LRC/SRC comparison: 2 columns on wider screens, stacked on narrow
     mobile devices – otherwise the cards overflow the viewport. */
  .lrc-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .lrc-compare-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
