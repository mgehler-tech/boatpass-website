---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';

// Shared section styles (layout identical to the privacy policy).
---

<BaseLayout
  title="Terms of Use – Boatpass SBF App & Website"
  description="Terms of use for the Boatpass apps and website: one-off purchase instead of subscription, usage rights, liability and your right of withdrawal."
  lang="en"
  altUrl="https://boatpass.de/nutzungsbedingungen/"
  showCta={false}
>
  <DisplayFontPreload slot="head" />
  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1/3.5) -->
  <PageHead
    lang="en"
    eyebrow="Legal"
    lede="Valid for the BoatPass app for Android and iPhone/iPad and for the website boatpass.de. Last updated: October 2026. The German version is legally binding."
  >
    Terms of Use
  </PageHead>

  <PageLayout variant="narrow">

    <!-- 01 Provider -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">01</p>
      <h2 class="pg-h2 pg-h2--sm">Provider</h2>
      <p class="pg-p pg-p--sm pg-strong">Marius Gehler</p>
      <p class="pg-p pg-p--sm">
        Blissestraße 56 · 10713 Berlin · Germany<br />
        <a href="mailto:support@boatpass.de" class="pg-inline-link">support@boatpass.de</a>
      </p>
    </div>

    <!-- 02 Scope -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">02</p>
      <h2 class="pg-h2 pg-h2--sm">Scope</h2>
      <p class="pg-p pg-p--sm">
        These terms apply to the use of the <strong>BoatPass</strong> app (study app for the German recreational boating licence and radio certificates) in its Android version from Google Play and its iOS/iPadOS version from the App Store, and to the website <strong>boatpass.de</strong>. Section 10 additionally applies to the iOS app.
      </p>
    </div>

    <!-- 03 Requirements -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">03</p>
      <h2 class="pg-h2 pg-h2--sm">Requirements</h2>
      <div class="pg-kvs">
        <div class="pg-kv">
          <span class="pg-kv-k">Android</span>
          <span class="pg-kv-v">Android 8.0 or later, free on Google Play. Purchases require a Google account.</span>
        </div>
        <div class="pg-kv">
          <span class="pg-kv-k">iPhone &amp; iPad</span>
          <span class="pg-kv-v">iOS or iPadOS 16 or later, free on the App Store. Purchases require an Apple Account.</span>
        </div>
      </div>
    </div>

    <!-- 04 Licence -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">04</p>
      <h2 class="pg-h2 pg-h2--sm">Licence</h2>
      <p class="pg-p pg-p--sm">
        You receive a personal, non-transferable licence to use the app on your own devices. Passing it on, copying it or using it commercially is not permitted. You may use the iOS app on Apple-branded devices that you own or control, as permitted by the Usage Rules in Apple's Media Services Terms and Conditions.
      </p>
    </div>

    <!-- 05 Free use & purchases -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">05</p>
      <h2 class="pg-h2 pg-h2--sm">Free use &amp; catalogue purchases</h2>
      <p class="pg-p pg-p--sm">
        BoatPass is free to download. Individual question catalogues are available as one-off purchases; there is no subscription:
      </p>
      <div class="pg-kvs">
        {[
          ['SBF Binnen (inland)', 'Free with a daily limit (15 questions/day). Full access (300 questions) via one-off purchase.'],
          ['SBF See (coastal)', 'Full access (285 questions, all modes) via one-off purchase.'],
          ['VHF radio (UBI)', 'Full access (130 questions) via one-off purchase.'],
          ['Short Range Certificate (SRC)', 'Full access (180 questions) via one-off purchase.'],
          ['Long Range Certificate (LRC)', 'Full access (76 questions) via one-off purchase.'],
          ['Bundles', 'SBF Binnen + See as a combo bundle and the radio bundle (UBI + SRC + LRC).'],
          ['More catalogues', 'E.g. Lake Constance licence – in preparation.'],
        ].map(([name, desc]) => (
          <div class="pg-kv">
            <span class="pg-kv-k">{name}</span>
            <span class="pg-kv-v">{desc}</span>
          </div>
        ))}
      </div>
      <p class="pg-note">
        Prices and scope are shown before purchase in the app and in the respective store; the price shown there, including VAT, applies. Prices may differ between Google Play and the App Store. Each catalogue purchase only applies to the respective licence type.
      </p>
    </div>

    <!-- 06 Purchases per store -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">06</p>
      <h2 class="pg-h2 pg-h2--sm">Purchases apply per store</h2>
      <p class="pg-p pg-p--sm">
        A purchase is tied to the account of the store you bought it in: Google Play purchases apply in the Android app, App Store purchases in the iOS app. <strong>Purchases cannot be transferred between Android and iPhone/iPad</strong>, because the stores process purchases separately and we do not run our own user accounts.
      </p>
      <p class="pg-p pg-p--sm">
        On other devices of the same platform or after reinstalling, you recover your purchases with the same Google account or Apple Account via "Restore purchases". Apple Family Sharing is not supported.
      </p>
    </div>

    <!-- 07 Withdrawal -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">07</p>
      <h2 class="pg-h2 pg-h2--sm">Purchases, right of withdrawal &amp; refunds</h2>
      <p class="pg-p pg-p--sm">
        Purchases are processed via Google Play or the App Store. The respective store operator is the contracting party for payment.
      </p>
      <p class="pg-p pg-p--sm">
        <strong>Right of withdrawal:</strong> As a consumer in the EU you generally have a 14-day right of withdrawal. For digital content (question catalogues) made available immediately after purchase, the right of withdrawal expires under Section 356(5) of the German Civil Code (BGB) once you have expressly agreed to immediate provision before the withdrawal period ends and confirmed that you thereby lose your right of withdrawal. This consent is obtained in the respective store's purchase process.
      </p>
      <p class="pg-p pg-p--sm">
        Refunds follow the store's policies: <a href="https://support.google.com/googleplay/answer/2479637" target="_blank" rel="noopener noreferrer" class="pg-inline-link">Google Play refund policy</a> or, for the App Store, via <a href="https://reportaproblem.apple.com" target="_blank" rel="noopener noreferrer" class="pg-inline-link">reportaproblem.apple.com</a>. We cannot refund store purchases ourselves for technical reasons. For any other issues: <a href="mailto:support@boatpass.de" class="pg-inline-link">support@boatpass.de</a>
      </p>
    </div>

    <!-- 08 Catalogue -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">08</p>
      <h2 class="pg-h2 pg-h2--sm">Question catalogue &amp; accuracy</h2>
      <p class="pg-p pg-p--sm">
        The question catalogues are based on the official exam questions of the competent authorities (SBF Binnen: GDWS; SBF See: BSH; last updated August 2023, valid for the 2026 exam year). We strive to keep content up to date but accept no liability for complete conformity with the currently valid exam status. <strong>The app supports your learning and does not replace official exam preparation.</strong>
      </p>
    </div>

    <!-- 09 Liability -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">09</p>
      <h2 class="pg-h2 pg-h2--sm">Liability</h2>
      <p class="pg-p pg-p--sm">
        We are liable without limitation for damage resulting from injury to life, body or health and for intent and gross negligence. For slight negligence we are only liable for breach of an essential contractual obligation (cardinal obligation), and then only up to the foreseeable, typical damage. Any further liability is excluded. Liability under the German Product Liability Act and your statutory warranty rights remain unaffected.
      </p>
      <p class="pg-p pg-p--sm">
        In particular, we do not guarantee that using the app will lead to passing an exam.
      </p>
    </div>

    <!-- 10 iOS terms (Apple minimum terms) -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">10</p>
      <h2 class="pg-h2 pg-h2--sm">Additional terms for the iOS app</h2>
      <p class="pg-p pg-p--sm">
        For the iOS/iPadOS version, Apple's <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/" target="_blank" rel="noopener noreferrer" class="pg-inline-link">Licensed Application End User License Agreement (Standard EULA)</a> and the following terms additionally apply:
      </p>
      <div class="pg-kvs">
        {[
          ['Parties', 'These terms are concluded between you and us only, not with Apple. We alone are responsible for the app and its content.'],
          ['Maintenance &amp; support', 'We alone provide maintenance and support for the app. Apple has no obligation to do so.'],
          ['Warranty', 'If the app fails to conform to any applicable warranty, you may notify Apple, and Apple will refund the purchase price. To the maximum extent permitted by law, Apple has no other warranty obligation. Your statutory warranty rights against us remain unaffected.'],
          ['Claims', 'We, not Apple, are responsible for addressing any claims relating to the app, such as product liability claims, claims that the app fails to conform to legal or regulatory requirements, and consumer protection claims.'],
          ['Intellectual property', 'If a third party claims that the app infringes its intellectual property rights, we, not Apple, are responsible for the investigation, defence, settlement and discharge of that claim.'],
          ['Export control', 'You represent that you are not located in a country subject to a US government embargo and are not listed on any US government list of prohibited or restricted parties.'],
          ['Third-party terms', 'When using the app you must comply with applicable third-party terms, such as those of your mobile network operator.'],
          ['Third-party beneficiary', 'Apple and its subsidiaries are third-party beneficiaries of these terms and, upon your acceptance, may enforce them against you.'],
        ].map(([name, desc]) => (
          <div class="pg-kv">
            <span class="pg-kv-k" set:html={name}></span>
            <span class="pg-kv-v">{desc}</span>
          </div>
        ))}
      </div>
      <p class="pg-note pg-note--after">
        Please direct any questions, complaints or claims regarding the app to the provider (section 01).
      </p>
    </div>

    <!-- 11 Changes -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">11</p>
      <h2 class="pg-h2 pg-h2--sm">Changes to these terms</h2>
      <p class="pg-p pg-p--sm">
        We may change these terms for objective reasons (e.g. changes in the law or new features). We will inform you of material changes in good time within the app. Catalogues you have already bought are not affected by changes.
      </p>
    </div>

    <!-- 12 Governing law -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">12</p>
      <h2 class="pg-h2 pg-h2--sm">Governing law &amp; jurisdiction</h2>
      <p class="pg-p pg-p--sm">
        German law applies. Place of jurisdiction for disputes with businesses is Berlin. For consumers the statutory rules on jurisdiction apply; mandatory consumer protection provisions of the country of your habitual residence remain unaffected.
      </p>
    </div>

    <!-- 13 Dispute resolution -->
    <div class="pg-card pg-card--legal">
      <p class="pg-card-label pg-card-label--muted">13</p>
      <h2 class="pg-h2 pg-h2--sm">Dispute resolution</h2>
      <p class="pg-p pg-p--sm">
        We are neither willing nor obliged to take part in dispute resolution proceedings before a consumer arbitration board (Section 36 VSBG). For questions or complaints, contact us at <a href="mailto:support@boatpass.de" class="pg-inline-link">support@boatpass.de</a>.
      </p>
    </div>

  </PageLayout>
</BaseLayout>
