---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Use"
  description="Terms of use for the Boatpass Android app and website: scope, one-time purchase instead of subscription, usage rights, liability and right of withdrawal."
  lang="en"
  altUrl="https://boatpass.de/nutzungsbedingungen/"
  showCta={false}
>
  <div style="max-width:720px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        Legal
      </div>
      <h1 style="font-size:clamp(30px,4.5vw,42px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:12px;">Terms of Use</h1>
      <p style="font-size:16px; color:#656B78;">Applicable to the <strong style="color:#1A1F36;">BoatPass Android app</strong> and <strong style="color:#1A1F36;">boatpass.de</strong>. Last updated: July 2026.</p>
    </div>

    <!-- 01 Provider -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">01</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Provider</h2>
      <p style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:4px;">Marius Gehler</p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Blissestraße 56 · 10713 Berlin · Germany<br />
        <a href="mailto:support@boatpass.de" style="color:#3366FF; text-decoration:none;">support@boatpass.de</a>
      </p>
    </div>

    <!-- 02 Scope -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">02</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Scope</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        These terms apply to the use of the Android app <strong style="color:#1A1F36;">BoatPass</strong> (a study app for the German boating licence) and the website <strong style="color:#1A1F36;">boatpass.de</strong>. By using the app or website, you agree to these terms.
      </p>
    </div>

    <!-- 03 Requirements -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">03</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Requirements</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        The app can be downloaded free of charge from the Google Play Store on Android 8.0 or later. A Google account is required to purchase paid content.
      </p>
    </div>

    <!-- 04 Licence -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">04</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Licence</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        You receive a personal, non-transferable licence to use the app on your own devices. Redistribution, copying, or commercial use is not permitted.
      </p>
    </div>

    <!-- 05 Free use & purchases -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">05</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Free Use &amp; Catalogue Purchases</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:16px;">
        BoatPass is free to download. Individual question catalogues are available as one-time purchases:
      </p>
      <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:16px;">
        {[
          ['SBF Binnen', 'Free with daily limit (15 questions/day). Full access (300 questions) via one-time purchase.'],
          ['SBF See', 'Full access (285 questions, all modes) via one-time purchase.'],
          ['UKW Radio (UBI)', 'Full access (130 questions) via one-time purchase.'],
          ['Short-Range Certificate (SRC)', 'Full access (180 questions) via one-time purchase.'],
          ['Long-Range Certificate (LRC)', 'Full access (76 questions) via one-time purchase.'],
          ['Further catalogues', 'e.g. Lake Constance licence – coming soon.'],
        ].map(([name, desc]) => (
          <div style="display:flex; gap:12px; padding:12px 16px; background:rgba(51,102,255,0.03); border-radius:12px;">
            <span style="font-size:14px; font-weight:700; color:#1A1F36; min-width:180px; flex-shrink:0;">{name}</span>
            <span style="font-size:14px; color:#4B5563;">{desc}</span>
          </div>
        ))}
      </div>
      <p style="font-size:14px; color:#656B78; line-height:1.7;">
        Prices and scope are shown before purchase in the app and via Google Play. Each catalogue purchase applies only to the respective licence type.
      </p>
    </div>

    <!-- 06 Right of withdrawal -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">06</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Purchases, Right of Withdrawal &amp; Refunds</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        Purchases are processed via Google Play.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        <strong style="color:#1A1F36;">Right of withdrawal:</strong> As a consumer in the EU, you generally have a 14-day right of withdrawal. For digital content (question catalogues) that is made accessible immediately after purchase, the right of withdrawal expires pursuant to § 356(5) BGB once you have expressly agreed to immediate provision before the withdrawal period expires and confirmed that you thereby lose your right of withdrawal. This consent is obtained as part of the Google Play purchase process.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Refunds are governed by <a href="https://support.google.com/googleplay/answer/2479637" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:none;">Google Play's return policy</a>. For further issues: <a href="mailto:support@boatpass.de" style="color:#3366FF; text-decoration:none; font-weight:600;">support@boatpass.de</a>
      </p>
    </div>

    <!-- 07 Question catalogue accuracy -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">07</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Question Catalogue &amp; Accuracy</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        The question catalogues are based on official exam questions from the competent authorities (SBF Binnen: GDWS; SBF See: BSH; last updated August 2023, valid for exam year 2026). We strive to keep the content current but assume no liability for complete alignment with the current exam syllabus. <strong style="color:#1A1F36;">The app supports learning and does not replace official exam preparation.</strong>
      </p>
    </div>

    <!-- 08 Liability -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">08</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Liability</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        We are fully liable for damages resulting from injury to life, body, or health, as well as for intent and gross negligence. For slight negligence, liability is limited to breaches of a material contractual obligation (cardinal obligation) and only up to the foreseeable, typical damage. Any further liability for slight negligence is excluded. Liability under the Product Liability Act remains unaffected.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        In particular, no guarantee is given that using the app will result in passing an exam.
      </p>
    </div>

    <!-- 09 Changes -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">09</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Changes to These Terms</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        We reserve the right to amend these terms for good reason (e.g. changes in law, new features, or changes to the business model). We will notify users of material changes in good time within the app. Continued use of the app after amended terms take effect constitutes acceptance.
      </p>
    </div>

    <!-- 10 Governing law -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">10</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Governing Law &amp; Jurisdiction</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        German law applies. The place of jurisdiction for disputes with merchants is Berlin. For consumers, the statutory rules on jurisdiction apply.
      </p>
    </div>

    <!-- 11 Dispute resolution -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px;">
      <div style="font-size:11px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">11</div>
      <h2 style="font-size:18px; font-weight:800; color:#1A1F36; margin-bottom:16px;">Dispute Resolution</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        We are not willing and not obliged to participate in dispute resolution proceedings before a consumer arbitration board (§ 36 VSBG). For questions or complaints, contact us at <a href="mailto:support@boatpass.de" style="color:#3366FF; text-decoration:none; font-weight:600;">support@boatpass.de</a>.
      </p>
    </div>

  </div>
</BaseLayout>
