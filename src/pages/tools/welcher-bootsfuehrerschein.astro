---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import { PLAY_STORE_URL, appStoreUrl, bundleSaving, formatPrice, smartAppPath, storePrice, type Platform } from '../../data/stores';

const playStoreUrl = PLAY_STORE_URL;
// Das Ergebnis wird erst nach dem Laden gerendert, die Geräteweiche im BaseLayout
// greift dort nicht mehr – deshalb wählt das Skript den Store-Link selbst.
const iosUrl = appStoreUrl('de');
const chooserPath = smartAppPath('de');

// Preise je Store: iPhone/iPad sehen App-Store-Preise, alle anderen Google Play.
// Die Auswahl trifft das Inline-Skript anhand von html[data-platform].
const priceSet = (platform: Platform) => ({
  binnen: storePrice('sbfBinnen', platform, 'de'),
  see: storePrice('sbfSee', platform, 'de'),
  ubi: storePrice('ubi', platform, 'de'),
  src: storePrice('src', platform, 'de'),
  lrc: storePrice('lrc', platform, 'de'),
  bundle: storePrice('bundleSbf', platform, 'de'),
  bundleSave: `Spare ${formatPrice(bundleSaving('bundleSbf', ['sbfBinnen', 'sbfSee'], platform), 'de')}`,
});
const PS = { android: priceSet('android'), ios: priceSet('ios') };

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Welchen Bootsführerschein brauche ich?", "item": "https://boatpass.de/tools/welcher-bootsfuehrerschein/" },
  ],
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Bootsführerschein-Finder",
  "url": "https://boatpass.de/tools/welcher-bootsfuehrerschein/",
  "description": "Kostenloser interaktiver Konfigurator: Beantworte 3 Fragen zu Revier, Motorleistung und Funk und erfahre sofort, welchen Sportbootführerschein und welches Funkzeugnis du brauchst.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Web",
  "inLanguage": "de",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
  "publisher": { "@type": "Organization", "name": "Boatpass", "url": "https://boatpass.de" },
};

// Statische, crawl- und zitierbare Entscheidungslogik – dieselbe Wahrheit wie der
// interaktive Konfigurator, aber ohne JavaScript erreichbar (wichtig für KI-Crawler).
const decisionRows = [
  { vorhaben: 'Motorboot über 15 PS · Binnengewässer', schein: 'SBF Binnen', funk: 'UBI (nur bei Funkanlage an Bord)' },
  { vorhaben: 'Motorboot über 15 PS · Küste (Nord-/Ostsee)', schein: 'SBF See', funk: 'SRC (Küste) bzw. LRC (weltweit)' },
  { vorhaben: 'Motorboot über 15 PS · Binnen + Küste', schein: 'SBF Binnen + SBF See (Kombiprüfung)', funk: 'UBI + SRC/LRC' },
  { vorhaben: 'Motorboot bis 15 PS / 11,03 kW (Verbrenner) bzw. bis 7,5 kW (Elektro)', schein: 'kein SBF gesetzlich nötig*', funk: 'UBI/SRC nur bei Funkanlage' },
  { vorhaben: 'Segelboot ohne (Hilfs-)Motor', schein: 'kein SBF nötig*', funk: 'SRC nur bei Seefunkanlage' },
  { vorhaben: 'Bodensee (Motor ab 6 PS oder Segelfläche ab 12 m²)', schein: 'Bodenseeschifferpatent', funk: 'UBI bei Funkanlage' },
];

const faqs = [
  {
    q: 'Welchen Bootsführerschein brauche ich für ein Motorboot über 15 PS?',
    a: 'Für ein Motorboot mit mehr als 15 PS (11,03 kW) brauchst du auf Binnengewässern den SBF Binnen und an der Küste (Nord- und Ostsee) den SBF See. Wer beide Reviere befahren möchte, legt beide Scheine – am günstigsten in einer kombinierten Prüfung – ab.',
  },
  {
    q: 'Brauche ich einen Führerschein für ein Boot unter 15 PS?',
    a: 'Nein. Für Sportboote mit Verbrennungsmotor bis 15 PS (11,03 kW) ist in Deutschland kein amtlicher Sportbootführerschein vorgeschrieben. Bei Elektroantrieben liegt die Grenze niedriger – hier gilt die Pflicht bereits ab 7,5 kW (rund 10 PS). Ausnahmen gelten zudem auf einigen Revieren wie dem Rhein und dem Bodensee. Zum Mieten verlangen Vercharterer häufig trotzdem einen Nachweis (z. B. Charterschein).',
  },
  {
    q: 'Welches Funkzeugnis brauche ich für mein Boot?',
    a: 'Sobald du eine Sprechfunkanlage bedienst, brauchst du das passende Zeugnis: UBI für den Binnenfunk (Flüsse, Kanäle), SRC (Short Range Certificate) für den UKW-Seefunk im Küstenbereich und LRC (Long Range Certificate) für den weltweiten Seefunk inklusive Grenz-/Kurzwelle und Satellit.',
  },
  {
    q: 'Welcher Schein gilt auf dem Bodensee?',
    a: 'Auf dem Bodensee gilt das Bodenseeschifferpatent. Es ist Pflicht für Motorboote ab 6 PS und für Segelboote ab 12 m² Segelfläche – die Regeln weichen damit vom übrigen Binnenbereich ab.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// HowTo-Schema: der Konfigurator ist eine Schritt-für-Schritt-Anleitung
// (3-4 Fragen → Empfehlung) – Schritte spiegeln STEPS im Skript unten wider.
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Welchen Bootsführerschein brauche ich? In 3 Schritten herausfinden",
  "description": "Beantworte 3 kurze Fragen zu Revier, Motorleistung und Funk und erfahre sofort, welchen Sportbootführerschein (SBF Binnen/See) und welches Funkzeugnis (UBI/SRC/LRC) du brauchst.",
  "step": [
    { "@type": "HowToStep", "name": "Revier wählen", "text": "Gib an, ob du auf Binnengewässern, an der Küste (Nord-/Ostsee), auf beiden Revieren oder auf dem Bodensee fahren möchtest." },
    { "@type": "HowToStep", "name": "Motorisierung angeben", "text": "Wähle, ob dein Boot einen Verbrennungsmotor bis oder über 15 PS (11,03 kW) hat, einen Elektroantrieb bis oder über 7,5 kW, oder ob es ein Segelboot ohne (Hilfs-)Motor ist." },
    { "@type": "HowToStep", "name": "Funknutzung angeben", "text": "Sag, ob du eine UKW-Sprechfunkanlage an Bord bedienen möchtest. Bei Seefunk fragt der Finder zusätzlich nach der Reichweite (küstennah oder weltweit)." },
    { "@type": "HowToStep", "name": "Empfehlung erhalten", "text": "Du erhältst sofort die passende Kombination aus Sportbootführerschein und Funkzeugnis für dein Vorhaben – mit direktem Link zur jeweiligen Detailseite." },
  ],
};
---

<BaseLayout
  title="Welchen Bootsführerschein brauche ich? – SBF-Test"
  description="Finde mit 3 Fragen zu Revier, Motorleistung und Funk heraus, welchen Sportbootführerschein (SBF Binnen/See) und welches Funkzeugnis du brauchst."
  lang="de"
  altUrl="https://boatpass.de/en/tools/which-boating-license/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1) -->
  <PageHead
    lang="de"
    eyebrow="Kostenloser Finder"
    lede="Beantworte 3 kurze Fragen zu Revier, Motorleistung und Funk – und erfahre in 30 Sekunden, welchen Schein und welches Funkzeugnis du wirklich brauchst."
  >
    Welchen Bootsführerschein<br />brauche ich?
  </PageHead>

  <PageLayout variant="narrow">

    <!-- Interaktiver Konfigurator -->
    <div id="cfg" class="cfg-card">
      <div class="cfg-head">
        <div id="cfg-progress" class="cfg-progress"></div>
        <div id="cfg-progress-bar" class="cfg-progress-bar"><span></span></div>
      </div>
      <div id="cfg-question" class="cfg-question" tabindex="-1" aria-live="polite"></div>
      <div id="cfg-options" class="cfg-options"></div>
      <div id="cfg-back" class="cfg-back">
        <button type="button" id="cfg-back-btn" class="cfg-back-btn">
          <span class="cfg-back-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg></span> Zurück
        </button>
      </div>
    </div>

    <!-- Ergebnis -->
    <div id="cfg-result" style="display:none;" tabindex="-1"></div>

    <!-- Statische Entscheidungstabelle (immer sichtbar, ohne JS, KI-zitierbar) -->
    <section class="pg-section">
      <h2 class="pg-h2">Entscheidungshilfe auf einen Blick</h2>
      <p class="pg-p">
        Welcher Bootsführerschein und welches Funkzeugnis für welches Vorhaben – die wichtigsten Fälle als Übersicht.
      </p>
      <!-- min-width aktiviert das horizontale Scrollen des overflow-x-Wrappers auf schmalen Screens (wie AppComparisonTable/CatalogSources). Ohne min-width wurde die Tabelle stattdessen auf Handybreite gequetscht: die drei Spalten brachen mehrzeilig um und wurden unleserlich. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col">Dein Vorhaben</th>
              <th scope="col">Führerschein</th>
              <th scope="col">Funkzeugnis</th>
            </tr>
          </thead>
          <tbody>
            {decisionRows.map((row) => (
              <tr>
                <th scope="row">{row.vorhaben}</th>
                <td>{row.schein}</td>
                <td>{row.funk}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        * Die Führerscheinpflicht greift in Deutschland ab mehr als 15 PS (11,03 kW) – bei Elektroantrieben bereits ab 7,5 kW (rund 10 PS). Eine Reform soll diese Grenze technologieneutral auf 11,03 kW vereinheitlichen, ist aber noch nicht in Kraft getreten. Auf einzelnen Revieren (Rhein, Bodensee) gelten abweichende Regeln.
      </p>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Alle Lizenzen im Detail</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen/">SBF Binnen lernen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/ubi/">UBI – UKW-Sprechfunkzeugnis Binnen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/src/">SRC – Seefunk Küste<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/lrc/">LRC – Seefunk weltweit<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/fuehrerscheine/">Übersicht aller Bootsführerscheine<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

    <!-- Ratgeber & Vergleiche -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Noch unsicher? Diese Ratgeber helfen weiter</h2>
      <ul class="pg-related">
        <li><a href="/blog/sbf-binnen-vs-see/">SBF Binnen vs. SBF See – was ist der Unterschied?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/motorboot-oder-segelboot-welcher-sbf/">Motorboot oder Segelboot – welcher SBF passt zu dir?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-vs-src-funkschein/">UBI vs. SRC – welches Funkzeugnis brauche ich?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>

  <!-- is:global, weil die Optionen & Ergebnis-Karten zur Laufzeit per JS erzeugt
       werden. Astro-gescopte Styles (data-astro-*) greifen nur bei build-time
       gerenderten Elementen und würden die dynamischen Buttons ungestylt lassen. -->
  <style is:global>
    .cfg-card {
      background:var(--h-card); border:1px solid var(--h-line); border-radius:24px;
      padding:32px 28px; box-shadow:0 18px 48px rgba(26,31,54,0.08);
    }
    @media (min-width:560px) { .cfg-card { padding:36px 36px; } }

    .cfg-head { margin-bottom:22px; }
    .cfg-progress {
      font-size:12px; font-weight:800; color:var(--h-blue-ink); text-transform:uppercase;
      letter-spacing:1.5px; margin-bottom:10px;
    }
    .cfg-progress-bar {
      height:6px; border-radius:100px; background:rgba(51,102,255,0.12); overflow:hidden;
    }
    .cfg-progress-bar > span {
      display:block; height:100%; width:0%; border-radius:100px;
      background:var(--h-blue);
      transition:width .35s cubic-bezier(.4,0,.2,1);
    }
    .cfg-question {
      font-size:clamp(22px,3.2vw,28px); font-weight:800; color:var(--h-ink);
      letter-spacing:-0.6px; line-height:1.25; margin-bottom:22px;
    }

    .cfg-options { display:flex; flex-direction:column; gap:12px; }
    .cfg-opt {
      display:flex; align-items:center; gap:16px; text-align:left; width:100%;
      background:var(--h-card); border:1.5px solid var(--h-line); border-radius:16px;
      padding:18px 18px 18px 20px; cursor:pointer; position:relative;
      transition:border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .12s ease;
      animation:cfgIn .3s ease both;
    }
    .cfg-opt:hover {
      border-color:var(--h-blue-ink); background:rgba(51,102,255,0.035);
      box-shadow:0 10px 26px rgba(51,102,255,0.14); transform:translateY(-2px);
    }
    .cfg-opt:active { transform:translateY(0) scale(0.995); }
    .cfg-opt-text { min-width:0; display:flex; flex-direction:column; }
    .cfg-opt-label { font-weight:700; color:var(--h-ink); font-size:16.5px; line-height:1.3; }
    .cfg-opt-sub { font-size:13.5px; color:var(--h-muted); margin-top:3px; line-height:1.4; }
    .cfg-opt-arrow {
      margin-left:auto; flex:0 0 auto; display:inline-flex; align-items:center;
      justify-content:center; width:34px; height:34px; border-radius:50%;
      background:rgba(51,102,255,0.10); color:var(--h-blue-ink); font-weight:800; font-size:17px;
      transition:background .18s ease, color .18s ease, transform .18s ease;
    }
    .cfg-opt:hover .cfg-opt-arrow {
      background:var(--h-blue); color:#fff; transform:translateX(3px);
    }

    @keyframes cfgIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .cfg-opt { animation:none; } }

    .cfg-back { margin-top:22px; display:none; }
    .cfg-back-btn {
      display:inline-flex; align-items:center; gap:7px; background:none; border:none;
      color:var(--h-muted); font-size:14px; font-weight:600; cursor:pointer; padding:6px 2px;
      transition:color .15s ease;
    }
    .cfg-back-btn:hover { color:var(--h-blue-ink); }
    .cfg-back-btn:hover .cfg-back-arrow { transform:translateX(-3px); }
    .cfg-back-arrow { display:inline-block; transition:transform .15s ease; }

    .res-card {
      display:block; background:var(--h-card); border:1px solid var(--h-line);
      border-radius:16px; padding:20px 22px; text-decoration:none;
      transition:border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }
    a.res-card:hover {
      border-color:var(--h-line-2); box-shadow:0 8px 22px rgba(51,102,255,0.12); transform:translateY(-2px);
    }

    /* Ergebnis-Preis (Upselling): rechts neben dem Lizenznamen. */
    .res-price { text-align:right; }
    .res-price-num {
      font-size:20px; font-weight:900; color:var(--h-ink); letter-spacing:-0.5px; line-height:1; white-space:nowrap;
    }
    .res-price-note { font-size:11px; font-weight:600; color:var(--h-muted); margin-top:4px; white-space:nowrap; }
    .res-tag {
      display:inline-block; font-size:12px; font-weight:700; color:var(--h-muted);
      background:var(--h-paper-2); border:1px solid var(--h-line); padding:5px 11px; border-radius:100px; white-space:nowrap;
    }
    .res-learn { display:inline-block; margin-top:12px; color:var(--h-blue-ink); font-weight:800; font-size:14px; }

    /* Bundle-Spartipp unter den Ergebnis-Karten. */
    .res-bundle {
      display:flex; align-items:flex-start; gap:10px; margin-top:14px;
      background:var(--h-blue-wash);
      border-radius:14px; padding:14px 16px; font-size:14px; color:var(--h-ink); line-height:1.55;
    }
    .res-bundle strong { font-weight:800; }
    .res-bundle-icon { flex:0 0 auto; font-size:16px; line-height:1.4; }
    .cfg-restart-btn { display:inline-flex; align-items:center; min-height:40px; padding:0 16px; background:var(--h-card); border:1.5px solid var(--h-line-2); color:var(--h-blue-ink); font-weight:700; font-size:14px; border-radius:var(--h-r-pill); cursor:pointer; }
    .cfg-restart-btn:hover { border-color:var(--h-blue); }

    /* Ergebnis und Pfeile auf Tokens (Runde 3, 3.6); Logik unverändert. */
    .res-eyebrow { margin:0 0 12px; }
    .res-list { display:flex; flex-direction:column; gap:14px; }
    .res-head { display:flex; align-items:flex-start; gap:12px; }
    .res-main { min-width:0; }
    .res-cat { font-size:12px; font-weight:700; color:var(--h-muted); text-transform:uppercase; letter-spacing:.5px; }
    .res-name { font-family:var(--h-display); font-stretch:84%; font-weight:720; font-size:22px; letter-spacing:-.01em; color:var(--h-ink); }
    .res-aside { margin-left:auto; flex:0 0 auto; }
    .res-sub { font-size:14px; color:var(--h-muted); line-height:1.6; margin-top:8px; }
    .res-learn { display:inline-flex; align-items:center; gap:6px; }
    .res-learn svg, .cfg-opt-arrow svg, .cfg-back-arrow svg { display:block; }
    .cfg-back-arrow svg { transform:rotate(180deg); }
    .res-bundle-icon { display:flex; color:var(--h-blue-ink); }
    .res-actions { margin-top:22px; display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
    .res-note { font-size:12.5px; color:var(--h-muted); line-height:1.6; margin-top:14px; }
    /* Ergebnis steht an der Stelle des (dann verborgenen) Konfigurators: kein Spaltenabstand davor. */
    .pg-main > #cfg-result { margin-top:0; }
  </style>

  <script is:inline define:vars={{ playStoreUrl, iosUrl, chooserPath, PS }}>
    // Inline-SVG statt Pfeil-/Emoji-Zeichen (Spec Runde 3, 3.6); Pfade wie in src/icons.ts.
    var CHEV = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>';
    var CHEV_BTN = CHEV.replace('<svg ', '<svg class="h-btn-arrow" ');
    var BULB = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>';
    (function () {
      var platform = document.documentElement.getAttribute('data-platform');
      var P = PS[platform === 'ios' ? 'ios' : 'android'];
      var storeUrl = platform === 'ios' ? iosUrl : platform === 'android' ? playStoreUrl : chooserPath;
      var storeTarget = platform === 'desktop' ? '' : ' target="_blank" rel="noopener noreferrer"';
      const STEPS = [
        { id: 'revier', q: 'Wo möchtest du fahren?', options: [
          { v: 'binnen', label: 'Binnengewässer', sub: 'Flüsse, Kanäle & Seen' },
          { v: 'see', label: 'Küste (Nord- & Ostsee)', sub: 'Seeschifffahrtsstraßen' },
          { v: 'beides', label: 'Beides', sub: 'Binnen und Küste' },
          { v: 'bodensee', label: 'Bodensee', sub: 'eigene Regelung' },
        ]},
        { id: 'motor', q: 'Wie ist dein Boot motorisiert?', options: [
          { v: 'unter', label: 'Verbrenner bis 15 PS', sub: 'höchstens 11,03 kW' },
          { v: 'ueber', label: 'Verbrenner über 15 PS', sub: 'mehr als 11,03 kW' },
          { v: 'unter', label: 'Elektro bis 7,5 kW', sub: 'rund 10 PS' },
          { v: 'ueber', label: 'Elektro über 7,5 kW', sub: 'mehr als 7,5 kW' },
          { v: 'segel', label: 'Segelboot ohne (Hilfs-)Motor', sub: '' },
        ]},
        { id: 'funk', q: 'Willst du eine UKW-Sprechfunkanlage bedienen?', options: [
          { v: 'nein', label: 'Nein', sub: 'kein Funk an Bord' },
          { v: 'ja', label: 'Ja', sub: 'Funkanlage / DSC an Bord' },
        ]},
        { id: 'reichweite', q: 'Wie weit fährst du auf See?',
          when: function (a) { return a.funk === 'ja' && (a.revier === 'see' || a.revier === 'beides'); },
          options: [
            { v: 'kueste', label: 'Küstennah', sub: 'bis ~35 sm (Seegebiet A1)' },
            { v: 'weltweit', label: 'Weltweit / Hochsee', sub: 'Grenz-/Kurzwelle & Satellit' },
          ]},
      ];

      const FS = {
        binnen: { key: 'binnen', cat: 'Sportbootführerschein', name: 'SBF Binnen', href: '/sbf-binnen/', price: P.binnen, sub: 'Pflicht für Motorboote über 15 PS auf Binnengewässern.' },
        see: { key: 'see', cat: 'Sportbootführerschein', name: 'SBF See', href: '/sbf-see/', price: P.see, sub: 'Pflicht für Motorboote über 15 PS an der Küste – mit Navigationsaufgabe.' },
      };
      const FUNK = {
        ubi: { key: 'ubi', cat: 'Funkzeugnis', name: 'UBI', href: '/ubi/', price: P.ubi, sub: 'UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk.' },
        src: { key: 'src', cat: 'Funkzeugnis', name: 'SRC', href: '/src/', price: P.src, sub: 'UKW-Seefunkzeugnis mit DSC für den Küstenbereich.' },
        lrc: { key: 'lrc', cat: 'Funkzeugnis', name: 'LRC', href: '/lrc/', price: P.lrc, sub: 'Allgemeines Funkbetriebszeugnis für den weltweiten Seefunk.' },
      };

      const answers = {};
      const path = [];

      const elProgress = document.getElementById('cfg-progress');
      const elProgressBar = document.querySelector('#cfg-progress-bar > span');
      const elQuestion = document.getElementById('cfg-question');
      const elOptions = document.getElementById('cfg-options');
      const elBackWrap = document.getElementById('cfg-back');
      const elBackBtn = document.getElementById('cfg-back-btn');
      const elCfg = document.getElementById('cfg');
      const elResult = document.getElementById('cfg-result');

      function visibleSteps() {
        return STEPS.filter(function (s) { return !s.when || s.when(answers); });
      }

      // focusQuestion bewegt den Fokus auf die Frage, nachdem die alte Antwort-
      // Schaltfläche per innerHTML-Reset aus dem DOM entfernt wurde – sonst fällt
      // der Fokus auf <body> zurück und Tastatur-/Screenreader-Nutzer verlieren
      // bei jedem Schritt des Konfigurators ihre Position (WCAG 2.4.3, 4.1.3).
      // Beim ersten Rendern beim Seitenaufruf bleibt der Fokus unangetastet.
      function render(stepId, focusQuestion) {
        const steps = visibleSteps();
        const step = STEPS.find(function (s) { return s.id === stepId; });
        const idx = steps.indexOf(step);
        elProgress.textContent = 'Frage ' + (idx + 1) + ' von ' + steps.length;
        if (elProgressBar) {
          elProgressBar.style.width = Math.round(((idx + 1) / steps.length) * 100) + '%';
        }
        elQuestion.textContent = step.q;
        elOptions.innerHTML = '';
        step.options.forEach(function (opt) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cfg-opt';
          btn.innerHTML =
            '<span class="cfg-opt-text"><span class="cfg-opt-label">' + opt.label + '</span>' +
            (opt.sub ? '<span class="cfg-opt-sub">' + opt.sub + '</span>' : '') +
            '</span><span class="cfg-opt-arrow" aria-hidden="true">' + CHEV + '</span>';
          btn.addEventListener('click', function () { choose(stepId, opt.v); });
          elOptions.appendChild(btn);
        });
        elBackWrap.style.display = path.length ? 'block' : 'none';
        if (focusQuestion) { elQuestion.focus({ preventScroll: true }); }
      }

      function choose(stepId, value) {
        answers[stepId] = value;
        path.push(stepId);
        const steps = visibleSteps();
        const step = STEPS.find(function (s) { return s.id === stepId; });
        const next = steps[steps.indexOf(step) + 1];
        if (next) { render(next.id, true); } else { showResult(); }
      }

      elBackBtn.addEventListener('click', function () {
        const last = path.pop();
        if (last) { delete answers[last]; }
        elResult.style.display = 'none';
        elCfg.style.display = 'block';
        const steps = visibleSteps();
        render(last || steps[0].id, true);
      });

      function compute() {
        const recs = [];
        const a = answers;
        if (a.revier === 'bodensee') {
          recs.push({ cat: 'Sportbootführerschein', name: 'Bodenseeschifferpatent', href: '/fuehrerscheine/', sub: 'Pflichtschein für den Bodensee (Motor ab 6 PS / Segel ab 12 m²). Boatpass-Modul in Vorbereitung.', soon: true });
        } else if (a.motor === 'ueber') {
          if (a.revier === 'binnen') recs.push(FS.binnen);
          else if (a.revier === 'see') recs.push(FS.see);
          else if (a.revier === 'beides') { recs.push(FS.binnen); recs.push(FS.see); }
        } else {
          recs.push({ cat: 'Sportbootführerschein', name: 'Kein Pflicht-Führerschein', href: '/fuehrerscheine/', sub: 'Unterhalb der Führerscheingrenze (15 PS bei Verbrenner, 7,5 kW bei Elektro) ist kein SBF vorgeschrieben. Auf Rhein/Bodensee gelten Ausnahmen; zum Mieten kann ein Charterschein nötig sein.', info: true });
        }
        if (a.funk === 'ja') {
          if (a.revier === 'binnen' || a.revier === 'bodensee') recs.push(FUNK.ubi);
          else if (a.revier === 'see') recs.push(a.reichweite === 'weltweit' ? FUNK.lrc : FUNK.src);
          else if (a.revier === 'beides') { recs.push(FUNK.ubi); recs.push(a.reichweite === 'weltweit' ? FUNK.lrc : FUNK.src); }
        }
        return recs;
      }

      function showResult() {
        const recs = compute();
        elCfg.style.display = 'none';
        let html = '<p class="pg-eyebrow res-eyebrow">Deine Empfehlung</p>';
        html += '<div class="res-list">';
        recs.forEach(function (r) {
          // Rechte Spalte: Preis (kaufbare Lizenz) bzw. Status-Tag (kein Kauf / bald).
          let aside;
          if (r.price) {
            aside = '<div class="res-price"><div class="res-price-num">' + r.price + '</div>' +
              '<div class="res-price-note">einmalig in Boatpass</div></div>';
          } else if (r.soon) {
            aside = '<span class="res-tag">Bald in Boatpass</span>';
          } else {
            aside = '<span class="res-tag">Kein Kauf nötig</span>';
          }
          const learn = r.href && !r.info && !r.soon
            ? '<span class="res-learn">Mehr erfahren' + CHEV + '</span>' : '';
          const wrap = r.href ? 'a' : 'div';
          const hrefAttr = r.href ? ' href="' + r.href + '"' : '';
          html += '<' + wrap + hrefAttr + ' class="res-card">' +
            '<div class="res-head">' +
            '<div class="res-main"><div class="res-cat">' + r.cat + '</div>' +
            '<div class="res-name">' + r.name + '</div></div>' +
            '<div class="res-aside">' + aside + '</div></div>' +
            '<div class="res-sub">' + r.sub + '</div>' +
            learn +
            '</' + wrap + '>';
        });
        html += '</div>';

        // Bundle-Upselling: sind sowohl SBF Binnen als auch SBF See empfohlen,
        // ist das SBF-Bundle günstiger als der Einzelkauf beider Lizenzen.
        const hasBinnen = recs.some(function (r) { return r.key === 'binnen'; });
        const hasSee = recs.some(function (r) { return r.key === 'see'; });
        if (hasBinnen && hasSee) {
          html += '<div class="res-bundle">' +
            '<span class="res-bundle-icon" aria-hidden="true">' + BULB + '</span>' +
            '<span>Spar-Tipp: Beide zusammen im <strong>SBF-Bundle für ' + P.bundle + '</strong> – ' + P.bundleSave + ' gegenüber dem Einzelkauf.</span>' +
            '</div>';
        }

        html += '<div class="res-actions">' +
          '<a href="' + storeUrl + '"' + storeTarget + ' class="h-btn h-btn--sm">Jetzt mit Boatpass lernen' + CHEV_BTN + '</a>' +
          '<button type="button" id="cfg-restart" class="cfg-restart-btn">Nochmal starten</button>' +
          '</div>';
        html += '<p class="res-note">Preise gelten für den Vollzugang im jeweiligen Boatpass-Lernkatalog (Einmalkauf, kein Abo). Amtliche Prüfungs- und Verwaltungsgebühren sind nicht enthalten.</p>';
        elResult.innerHTML = html;
        elResult.style.display = 'block';
        document.getElementById('cfg-restart').addEventListener('click', function () {
          for (const k in answers) delete answers[k];
          path.length = 0;
          elResult.style.display = 'none';
          elCfg.style.display = 'block';
          render(STEPS[0].id, true);
        });
        elResult.focus({ preventScroll: true });
        elResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      render(STEPS[0].id);
    })();
  </script>

</BaseLayout>
