---
import BaseLayout from '../layouts/BaseLayout.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Kosten", "item": "https://boatpass.de/sbf-kosten/" },
  ],
};

const faqs = [
  {
    q: 'Was kostet der Sportbootführerschein insgesamt?',
    a: 'Ohne Vorbereitungskurs liegst du pro Schein bei rund 140–160 € (Prüfungsgebühr + Lernmaterial). Mit klassischem Bootsführerschein-Kurs kommst du je nach Anbieter auf ca. 300–550 € pro Schein. Wer die Theorie selbstständig mit einer App lernt, spart die Kursgebühr fast vollständig.',
  },
  {
    q: 'Wie hoch sind die reinen Prüfungsgebühren?',
    a: 'Die Prüfungsgebühren für Theorie und Praxis liegen je nach DMYV-Prüfungszentrum bei etwa 130–150 € pro Schein. Die kombinierte Prüfung SBF Binnen + See ist günstiger als zwei getrennte Prüfungen.',
  },
  {
    q: 'Kann ich beim SBF Geld sparen?',
    a: 'Ja. Der größte Kostenblock ist der Vorbereitungskurs. Da der offizielle ELWIS-Fragenkatalog frei verfügbar ist, kannst du die Theorie ohne teuren Kurs lernen — z. B. mit der Boatpass-App für einmalig 6,99 € pro Katalog (oder 11,99 € für beide). Für die Praxis reicht oft ein Übungstag auf dem Wasser.',
  },
  {
    q: 'Ist die kombinierte Prüfung Binnen + See günstiger?',
    a: 'Ja. Wer SBF Binnen und SBF See zusammen ablegt, zahlt für die kombinierte Prüfung weniger als für beide Einzelprüfungen. Auch beim Lernmaterial sparst du mit dem Komplett-Paket beider Kataloge.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Was kostet der Sportbootführerschein? SBF Kosten im Überblick"
  description="Alle Kosten für den Sportbootführerschein: Prüfungsgebühren, Kurs, Praxis & Lern-App. So viel kostet SBF Binnen, SBF See und die Kombi — und wo du am meisten sparst."
  lang="de"
  hasAlternate={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        💶 SBF Kosten
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Was kostet der<br>Sportbootführerschein?
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Prüfungsgebühren, Kurs, Praxis und Lernmaterial — hier siehst du alle Kostenpunkte für SBF Binnen, SBF See und die Kombination im Überblick. Plus: wie du clever sparst.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:#3366FF; color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
        ▶&nbsp;Theorie ab 6,99 € lernen
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Überblick -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">SBF Kosten im Überblick</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Die Gesamtkosten für den <strong>Sportbootführerschein</strong> hängen vor allem davon ab, ob du einen Vorbereitungskurs besuchst oder die Theorie selbstständig lernst. Die festen Kosten sind die <strong>amtlichen Prüfungsgebühren</strong> — alles andere lässt sich beeinflussen.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Grob gerechnet bewegst du dich pro Schein zwischen <strong>ca. 140 €</strong> (selbst gelernt mit App) und <strong>ca. 550 €</strong> (mit klassischem Kurs).
      </p>
    </section>

    <!-- Kostentabelle -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Die einzelnen Kostenpunkte</h2>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:15px; background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; overflow:hidden;">
          <thead>
            <tr style="background:rgba(26,31,54,0.04);">
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Kostenpunkt</th>
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Ungefähre Kosten</th>
              <th style="text-align:left; padding:14px 16px; font-weight:700; color:#1A1F36;">Pflicht?</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Prüfungsgebühr (Theorie + Praxis)</td>
              <td style="padding:13px 16px; color:#374151;">ca. 130–150 € pro Schein</td>
              <td style="padding:13px 16px; color:#374151;">Ja</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08); background:rgba(26,31,54,0.02);">
              <td style="padding:13px 16px; color:#374151;">Vorbereitungskurs (Fahrschule)</td>
              <td style="padding:13px 16px; color:#374151;">ca. 150–400 €</td>
              <td style="padding:13px 16px; color:#374151;">Optional</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Lern-App / Fragenkatalog (Boatpass)</td>
              <td style="padding:13px 16px; color:#374151;">6,99 € pro Katalog · 11,99 € Paket</td>
              <td style="padding:13px 16px; color:#374151;">Optional</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08); background:rgba(26,31,54,0.02);">
              <td style="padding:13px 16px; color:#374151;">Praktische Übungsstunden</td>
              <td style="padding:13px 16px; color:#374151;">variabel (je nach Anbieter)</td>
              <td style="padding:13px 16px; color:#374151;">Empfohlen</td>
            </tr>
            <tr style="border-top:1px solid rgba(51,102,255,0.08);">
              <td style="padding:13px 16px; color:#374151;">Nebenkosten (Passbild, Anmeldung)</td>
              <td style="padding:13px 16px; color:#374151;">gering</td>
              <td style="padding:13px 16px; color:#374151;">Ja</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:12px;">
        Die genauen Prüfungsgebühren legt das jeweilige DMYV-Prüfungszentrum fest und können regional leicht abweichen.
      </p>
    </section>

    <!-- Binnen / See / Kombi -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">SBF Binnen, SBF See oder beide?</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">SBF Binnen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Eine Prüfungsgebühr + Lernmaterial. Selbst gelernt ab ca. <strong>140 €</strong>.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">SBF See</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Wie Binnen, mit zusätzlicher Navigationsaufgabe in der Theorie. Selbst gelernt ab ca. <strong>140 €</strong>.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Kombi Binnen + See</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Günstiger als zwei Einzelprüfungen — eine kombinierte Prüfung, beide Scheine.</div>
        </div>
      </div>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-top:20px;">
        Wenn du ohnehin beide Reviere befahren möchtest, ist die <strong>kombinierte Prüfung</strong> klar am wirtschaftlichsten: Du sparst sowohl bei der Prüfungsgebühr als auch beim Lernmaterial (Komplett-Paket statt zwei Einzelkäufe).
      </p>
    </section>

    <!-- So sparst du -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">So sparst du beim Sportbootführerschein</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {[
          { icon: '📱', title: 'Theorie selbst lernen', desc: 'Der größte Kostenblock ist der Vorbereitungskurs. Mit dem offiziellen ELWIS-Katalog in der App lernst du die Theorie eigenständig — für einmalig 6,99 € statt mehreren Hundert Euro Kursgebühr.' },
          { icon: '🎯', title: 'Gezielt statt breit üben', desc: 'Mit Prüfungssimulation und Fehler-Training gehst du beim ersten Versuch durch — eine Wiederholungsprüfung kostet erneut Gebühren.' },
          { icon: '🤝', title: 'Kombi-Prüfung nutzen', desc: 'Brauchst du Binnen und See, spart die kombinierte Prüfung gegenüber zwei getrennten Anläufen.' },
        ].map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="font-size:24px; flex-shrink:0;">{f.icon}</span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">Häufige Fragen zu den SBF-Kosten</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <div style="font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</div>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:linear-gradient(135deg,#1A1F36,#3366FF); border-radius:24px; padding:48px 32px; text-align:center;">
      <h2 style="font-size:26px; font-weight:800; color:white; margin-bottom:12px;">Spar dir den teuren Kurs</h2>
      <p style="font-size:16px; color:rgba(255,255,255,0.75); margin-bottom:28px;">Lern die SBF-Theorie mit dem offiziellen ELWIS-Katalog — ab 6,99 € pro Schein. 15 Fragen täglich gratis.</p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:white; color:#1A1F36; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none;">
        ▶&nbsp;Im Google Play Store öffnen
      </a>
    </section>

    <!-- Interne Links -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.08);">
      <h2 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Weiterführende Seiten</h2>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/sbf-binnen/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Binnen lernen mit Boatpass</a>
        <a href="/sbf-see/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF See lernen mit Boatpass</a>
        <a href="/sbf-pruefung-ablauf/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Prüfung: Ablauf von Theorie & Praxis</a>
        <a href="/faq/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Häufige Fragen zum Sportbootführerschein</a>
      </div>
    </section>

  </div>
</BaseLayout>
