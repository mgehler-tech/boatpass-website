---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';
import { priceText } from '../data/stores';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Kosten", "item": "https://boatpass.de/sbf-kosten/" },
  ],
};

const faqs = [
  {
    q: 'Was kostet der Sportbootführerschein insgesamt?',
    a: 'Mit komplettem Kurs (Theorie + Praxis) solltest du 2026 je nach Anbieter und Region mit rund 500–650 € pro Schein rechnen. Online-Kurse inklusive Praxisausbildung gibt es ab etwa 340–400 €. Wer die Theorie selbstständig mit einer App lernt und nur die praktische Übung extern bucht, spart die teure Kursgebühr und kommt deutlich günstiger weg.',
  },
  {
    q: 'Wie hoch sind die reinen Prüfungsgebühren?',
    a: 'Die amtlichen Prüfungsgebühren (Theorie + Praxis) liegen 2026 bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Die kombinierte Prüfung SBF Binnen + See kostet zusammen nur 178,61 € – deutlich weniger als beide Einzelprüfungen (279,16 €).',
  },
  {
    q: 'Kann ich beim SBF Geld sparen?',
    a: 'Ja. Der größte Kostenblock ist der Vorbereitungskurs. Da der offizielle ELWIS-Fragenkatalog frei verfügbar ist, kannst du die Theorie ohne teuren Kurs lernen – z. B. mit der Boatpass-App für einmalig 9,99 € pro Katalog (oder ' + priceText('bundleSbf', 'de') + ' für beide). Für die Praxis reicht oft ein Übungstag auf dem Wasser.',
  },
  {
    q: 'Ist die kombinierte Prüfung Binnen + See günstiger?',
    a: 'Ja. Wer SBF Binnen und SBF See zusammen ablegt, zahlt für die kombinierte Prüfung weniger als für beide Einzelprüfungen. Auch beim Lernmaterial sparst du mit dem Komplett-Paket beider Kataloge.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Was kostet der Sportbootführerschein 2026?"
  description="Was kostet der Sportbootführerschein 2026? Alle Prüfungsgebühren, Kurs- & Praxiskosten für SBF Binnen, SBF See und Kombi im Überblick – plus Spartipps."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-costs/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="SBF Kosten"
    lede="Prüfungsgebühren, Kurs, Praxis und Lernmaterial – hier siehst du alle Kostenpunkte für SBF Binnen, SBF See und die Kombination im Überblick. Plus: wie du clever sparst."
    ctaLabel="Theorie ab 9,99 € lernen"
    cta
  >
    Was kostet der<br />Sportbootführerschein?
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfBinnen"
      from
      items={[
        { k: 'Prüfungsgebühr Binnen', v: '130,78 €' },
        { k: 'Prüfungsgebühr See', v: '148,38 €' },
        { k: 'Kombi-Prüfung', v: '178,61 €' },
        { k: 'Vorbereitungskurs', v: 'ca. 340–400 € aufwärts' },
        { k: 'Theorie mit Boatpass', v: 'ab 9,99 €' },
      ]}
    />

    <!-- Überblick -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Kosten im Überblick</h2>
      <p class="pg-p">
        Die Gesamtkosten für den <strong>Sportbootführerschein</strong> hängen vor allem davon ab, ob du einen Vorbereitungskurs besuchst oder die Theorie selbstständig lernst. Fest sind nur die <strong>amtlichen Prüfungsgebühren</strong> (130,78 € Binnen, 148,38 € See) – alles andere lässt sich beeinflussen.
      </p>
      <p class="pg-p">
        Mit komplettem Kurs liegst du 2026 pro Schein bei rund <strong>500–650 €</strong>. Wer die Theorie selbst lernt und nur die Praxis extern übt, kommt mit <strong>Prüfungsgebühr + App ab ca. 138 €</strong> plus Übungskosten deutlich günstiger weg.
      </p>
    </section>

    <!-- Kostentabelle -->
    <section class="pg-section">
      <h2 class="pg-h2">Die einzelnen Kostenpunkte</h2>
      <!-- min-width aktiviert das horizontale Scrollen des overflow-x-Wrappers auf schmalen Screens (wie AppComparisonTable/CatalogSources). Ohne min-width wurde die Tabelle stattdessen auf Handybreite gequetscht: die drei Spalten brachen mehrzeilig um und wurden unleserlich. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col">Kostenpunkt</th>
              <th scope="col">Ungefähre Kosten</th>
              <th scope="col">Pflicht?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Prüfungsgebühr Binnen (Theorie + Praxis)</th>
              <td>130,78 €</td>
              <td>Ja</td>
            </tr>
            <tr>
              <th scope="row">Prüfungsgebühr See (Theorie + Praxis)</th>
              <td>148,38 €</td>
              <td>Ja</td>
            </tr>
            <tr>
              <th scope="row">Kombi-Prüfung Binnen + See</th>
              <td>178,61 € (statt 279,16 €)</td>
              <td>Ja</td>
            </tr>
            <tr>
              <th scope="row">Vorbereitungskurs (online/Fahrschule)</th>
              <td>ca. 340–400 € aufwärts</td>
              <td>Optional</td>
            </tr>
            <tr>
              <th scope="row">Lern-App / Fragenkatalog (Boatpass)</th>
              <td>9,99 € pro Katalog · {priceText('bundleSbf', 'de')} Paket</td>
              <td>Optional</td>
            </tr>
            <tr>
              <th scope="row">Praktische Übungsstunden</th>
              <td>variabel (je nach Anbieter)</td>
              <td>Empfohlen</td>
            </tr>
            <tr>
              <th scope="row">Nebenkosten (Passbild, Anmeldung)</th>
              <td>gering</td>
              <td>Ja</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        Die Prüfungsgebühren sind bundesweit einheitlich durch DSV und DMYV festgelegt (Stand 2026). Kurs- und Praxiskosten variieren je nach Anbieter und Region.
      </p>
    </section>

    <!-- Binnen / See / Kombi -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Binnen, SBF See oder beide?</h2>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">SBF Binnen</p>
          <p class="pg-card-text">Prüfungsgebühr <strong>130,78 €</strong> (Theorie + Praxis) plus Lernmaterial.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">SBF See</p>
          <p class="pg-card-text">Prüfungsgebühr <strong>148,38 €</strong> – etwas höher wegen der Navigationsaufgabe.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Kombi Binnen + See</p>
          <p class="pg-card-text">Nur <strong>178,61 €</strong> statt 279,16 € – über 100 € gespart bei einer kombinierten Prüfung.</p>
        </div>
      </div>
      <p class="pg-p">
        Wenn du ohnehin beide Reviere befahren möchtest, ist die <strong>kombinierte Prüfung</strong> klar am wirtschaftlichsten: Du sparst sowohl bei der Prüfungsgebühr als auch beim Lernmaterial (Komplett-Paket statt zwei Einzelkäufe).
      </p>
    </section>

    <!-- So sparst du -->
    <section class="pg-section">
      <h2 class="pg-h2">So sparst du beim Sportbootführerschein</h2>
      <div class="pg-rows">
        {[
          { icon: 'phoneDevice', title: 'Theorie selbst lernen', desc: 'Der größte Kostenblock ist der Vorbereitungskurs. Mit dem offiziellen ELWIS-Katalog in der App lernst du die Theorie eigenständig – für einmalig 9,99 € statt mehreren Hundert Euro Kursgebühr.' },
          { icon: 'target', title: 'Gezielt statt breit üben', desc: 'Mit Prüfungssimulation und Fehlertraining gehst du beim ersten Versuch durch – eine Wiederholungsprüfung kostet erneut Gebühren.' },
          { icon: 'users', title: 'Kombi-Prüfung nutzen', desc: 'Brauchst du Binnen und See, spart die kombinierte Prüfung gegenüber zwei getrennten Anläufen.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zu den SBF-Kosten</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Seiten</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen/">SBF Binnen lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/faq/">Häufige Fragen zum Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/bootsfuehrerschein-kosten-sparen/">Bootsführerschein-Kosten sparen: die 5 besten Spartipps<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-app-vs-bootsschule/">SBF-App vs. Bootsschule – lohnt sich ein Theoriekurs?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-eigenes-boot-oder-charterboot/">SBF mit eigenem Boot oder Charterboot – was passt zu wem?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/aussenborder-basiswartung/">Außenborder-Basiswartung – einfache Pflege für lange Lebensdauer<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/bootsversicherung-sportboote-sinnvoll/">Bootsversicherung: welche Policen für dein Boot wirklich sinnvoll sind<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
