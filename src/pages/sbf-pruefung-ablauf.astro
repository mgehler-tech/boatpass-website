---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Prüfung Ablauf", "item": "https://boatpass.de/sbf-pruefung-ablauf/" },
  ],
};

const faqs = [
  {
    q: 'Wie läuft die SBF-Prüfung ab?',
    a: 'Die SBF-Prüfung besteht aus einem theoretischen und einem praktischen Teil. In der Theorie beantwortest du einen Multiple-Choice-Bogen (SBF Binnen: 30 Fragen in 45 Minuten; SBF See: 39 Fragen inkl. Navigationsaufgabe in 60 Minuten). In der Praxis zeigst du auf dem Wasser Manöver wie An- und Ablegen, Wenden und Mann-über-Bord sowie die wichtigsten Knoten.',
  },
  {
    q: 'Muss ich Theorie und Praxis am selben Tag machen?',
    a: 'Das hängt vom Prüfungszentrum ab. Häufig finden Theorie und Praxis am selben Termin statt, sie sind aber getrennte Prüfungsteile. Beide müssen bestanden werden, um den Schein zu erhalten.',
  },
  {
    q: 'Was passiert, wenn ich durchfalle?',
    a: 'Du wiederholst nur den nicht bestandenen Teil, nicht die ganze Prüfung. Das ist frühestens am Folgetag möglich und erfordert eine neue Anmeldung beim Prüfungsausschuss sowie eine eigene Gebühr. Die Zahl der Versuche ist nicht begrenzt, ein bestandener Teil bleibt aber nur befristet gültig – die Frist legt dein Prüfungsausschuss fest.',
  },
  {
    q: 'Wie lange dauert die SBF-Prüfung?',
    a: 'Die Theorieprüfung dauert beim SBF Binnen 45 Minuten, beim SBF See 60 Minuten (inklusive Navigationsaufgabe). Die praktische Prüfung dauert pro Person meist wenige Minuten bis etwa eine halbe Stunde, je nachdem, wie viele Manöver abgefragt werden. Mit Wartezeiten bei Sammelterminen solltest du für den Prüfungstag einen halben Tag einplanen.',
  },
  {
    q: 'Welche Voraussetzungen brauche ich für die SBF-Prüfung?',
    a: 'Für den SBF Binnen gilt ein Mindestalter von 16 Jahren. Du meldest dich beim zuständigen Prüfungsausschuss (z. B. DMYV) an. Ein Vorbereitungskurs ist nicht vorgeschrieben – du kannst dich vollständig selbst vorbereiten.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// HowTo-Schema: bildet die Schritt-für-Schritt-Anleitung dieser Seite ab
// (Anmeldung → Theorieprüfung → praktische Prüfung), siehe BlogLayout für das gleiche Muster.
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "So läuft die Sportbootführerschein-Prüfung ab",
  "description": "Schritt für Schritt zum Sportbootführerschein: Anmeldung beim Prüfungsausschuss, theoretische Prüfung und praktische Prüfung für SBF Binnen und SBF See.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Beim Prüfungsausschuss anmelden",
      "text": "Melde dich beim zuständigen Prüfungsausschuss (z. B. DMYV) an. Für den SBF Binnen gilt ein Mindestalter von 16 Jahren. Ein Vorbereitungskurs ist nicht vorgeschrieben – du kannst dich vollständig selbst vorbereiten.",
    },
    {
      "@type": "HowToStep",
      "name": "Theoretische Prüfung ablegen",
      "text": "Beantworte den Multiple-Choice-Fragebogen aus dem amtlichen ELWIS-Katalog: SBF Binnen 30 Fragen in 45 Minuten (mind. 5 von 7 Basisfragen, mind. 18 von 23 spezifischen Fragen richtig), SBF See 39 Fragen inkl. Navigationsaufgabe in 60 Minuten.",
    },
    {
      "@type": "HowToStep",
      "name": "Praktische Prüfung ablegen",
      "text": "Zeige auf dem Wasser sicheres Bootsführen: An- und Ablegen, Wenden, Aufstoppen und das Mann-über-Bord-Manöver sowie die prüfungsrelevanten Knoten.",
    },
  ],
};
---

<BaseLayout
  title="SBF Prüfung Ablauf – Theorie & Praxis erklärt"
  description="Wie läuft die Sportbootführerschein-Prüfung ab? Theorie und Praxis, Bestehensgrenzen, Unterlagen, Fristen und Dauer – für SBF Binnen und SBF See."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-exam/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Sportbootführerschein · Binnen & See"
    lede="Theorie und Praxis Schritt für Schritt erklärt: Aufbau, Fragen, Manöver und Bestehensgrenzen für SBF Binnen und SBF See. So weißt du genau, was am Prüfungstag auf dich zukommt."
    ctaLabel="Auf die Theorie vorbereiten"
    cta
  >
    SBF Prüfung –<br />so läuft sie ab
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfBinnen"
      from
      items={[
        { k: 'Theorie Binnen', v: '30 Fragen · 45 Min' },
        { k: 'Theorie See', v: '39 Fragen · 60 Min (inkl. Navigation)' },
        { k: 'Bestehensgrenze', v: '5 von 7 Basis, 18 von 23 spezifisch (See: 7 von 9 Navigation)' },
        { k: 'Mindestalter', v: '16 Jahre' },
        { k: 'Anmeldung', v: 'Prüfungsausschuss (DMYV)' },
      ]}
    />

    <!-- Geltungsbereich-Hinweis -->
    <div class="pg-card pg-card--soft pg-card--note">
      <span class="pg-row-icon pg-row-icon--sm">
        <Icon name="document" size={18} strokeWidth={1.75} />
      </span>
      <div class="pg-card-text">
        <strong>Diese Seite beschreibt den Ablauf der Sportbootführerschein-Prüfung – für <a href="/sbf-binnen/" class="pg-inline-link">SBF Binnen</a> und <a href="/sbf-see/" class="pg-inline-link">SBF See</a>.</strong>
        Die Sprechfunkzeugnisse haben einen eigenen Prüfungsablauf – Aufbau und Inhalte findest du auf den Seiten zu <a href="/ubi/" class="pg-inline-link">UBI</a>, <a href="/src/" class="pg-inline-link">SRC</a> und <a href="/lrc/" class="pg-inline-link">LRC</a>.
      </div>
    </div>

    <!-- Überblick -->
    <section class="pg-section">
      <h2 class="pg-h2">Theorie und Praxis – zwei Prüfungsteile</h2>
      <p class="pg-p">
        Die <strong>Sportbootführerschein-Prüfung</strong> besteht aus zwei getrennten Teilen: einer <strong>theoretischen Prüfung</strong> (Multiple-Choice-Bogen) und einer <strong>praktischen Prüfung</strong> auf dem Wasser. Beide musst du bestehen, um den Schein zu erhalten. Abgenommen wird die Prüfung von einem anerkannten Prüfungsausschuss (z. B. DMYV).
      </p>
      <p class="pg-p">
        Ein Vorbereitungskurs ist <strong>nicht vorgeschrieben</strong> – du kannst die Theorie selbstständig mit dem offiziellen Fragenkatalog lernen.
      </p>
    </section>

    <!-- Theorie -->
    <section class="pg-section">
      <h2 class="pg-h2">1. Die theoretische Prüfung</h2>
      <p class="pg-p">
        In der Theorie beantwortest du einen Fragebogen aus dem amtlichen ELWIS-Katalog. Der Aufbau unterscheidet sich je nach Schein:
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">SBF Binnen</p>
          <div class="pg-card-text">30 Fragen · 45 Minuten<br>7 Basisfragen (mind. 5 richtig)<br>23 spezifische Fragen (mind. 18 richtig)</div>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">SBF See</p>
          <div class="pg-card-text">39 Fragen · 60 Minuten<br>30 Standardfragen wie Binnen<br>+ 9 Fragen Navigationsaufgabe (mind. 7 richtig)</div>
        </div>
      </div>
    </section>

    <!-- Praxis -->
    <section class="pg-section">
      <h2 class="pg-h2">2. Die praktische Prüfung</h2>
      <p class="pg-p">
        In der Praxis zeigst du auf dem Wasser, dass du ein Boot sicher führen kannst. Geprüft werden typischerweise:
      </p>
      <div class="pg-rows">
        {[
          { icon: 'lifebuoy', title: 'Manöver', desc: 'An- und Ablegen, Wenden, Aufstoppen und das wichtige Mann-über-Bord-Manöver.', href: '/blog/anlegen-ablegen-hafenmanoever/' },
          { icon: 'knot', title: 'Knoten', desc: 'Die prüfungsrelevanten Knoten sicher und zügig anwenden (z. B. Palstek, Webeleinstek, Belegen einer Klampe).', href: '/blog/wichtigste-knoten-sbf/' },
          { icon: 'compass', title: 'Bootsführung & Sicherheit', desc: 'Richtiges Verhalten an Bord, Ausweichregeln und sicheres Steuern im Revier.', href: '/blog/ausweichregeln-vorfahrt-wasser/' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div>
              <div class="pg-row-title">
                {f.href ? <a href={f.href} class="pg-card-link">{f.title}</a> : f.title}
              </div>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="pg-note pg-note--after">
        Für die Praxis empfiehlt sich mindestens ein Übungstag auf dem Wasser. Die genauen Anforderungen können je nach Prüfungsausschuss leicht variieren.
      </p>
    </section>

    <!-- Voraussetzungen / Anmeldung -->
    <section class="pg-section">
      <h2 class="pg-h2">Voraussetzungen & Anmeldung</h2>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">Mindestalter</p>
          <p class="pg-card-text">16 Jahre (SBF Binnen)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Anmeldung</p>
          <p class="pg-card-text">beim Prüfungsausschuss (DMYV)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Kurspflicht</p>
          <p class="pg-card-text">keine – Selbststudium möglich</p>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        Eine Schritt-für-Schritt-Anleitung zur Anmeldung bei DSV und DMYV findest du im <a href="/blog/sbf-pruefung-anmelden/" class="pg-inline-link">Artikel zur SBF-Prüfungsanmeldung</a>.
      </p>
      <p class="pg-note pg-note--sm">
        Quellen: <a href="https://www.gesetze-im-internet.de/spfv/" target="_blank" rel="noopener noreferrer" class="pg-inline-link">Sportbootführerscheinverordnung (SpFV)</a>, <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Sportbootfuehrerscheine-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">ELWIS – Sportbootführerscheine</a>, Prüfungsportale von <a href="https://www.sportbootfuehrerscheine.org/" target="_blank" rel="noopener noreferrer" class="pg-inline-link">DSV</a> und <a href="https://www.dmyv.de/" target="_blank" rel="noopener noreferrer" class="pg-inline-link">DMYV</a>. Stand: Oktober 2026.
      </p>
    </section>

    <!-- Unterlagen und Fristen (übernommen aus dem früheren Blogartikel
         „SBF Prüfung: Alles was du wissen musst", der hierher umgeleitet wird) -->
    <section class="pg-section">
      <h2 class="pg-h2">Unterlagen und Fristen</h2>
      <p class="pg-p">
        Für die Zulassung zur Prüfung reichst du beim Prüfungsausschuss neben dem Antrag diese Unterlagen ein:
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">Ausweis</p>
          <p class="pg-card-text">Gültiger Personalausweis oder Reisepass</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Passbild</p>
          <p class="pg-card-text">35 × 45 mm, ohne Kopfbedeckung</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Ärztliches Zeugnis</p>
          <p class="pg-card-text">Amtliches Formular mit Seh- und Hörtest, ab Ausstellung 12 Monate gültig</p>
        </div>
      </div>
      <p class="pg-p pg-p--after">
        Die Prüfungsgebühr muss meist spätestens <strong>7 Tage vor dem Termin</strong> beim Prüfungsausschuss eingegangen sein; manche Ausschüsse setzen längere Fristen. Am Prüfungstag bringst du Ausweis und Prüfungszulassung mit. Fehlt ein Dokument oder ist das ärztliche Zeugnis abgelaufen, darfst du unter Umständen nicht teilnehmen. Die aktuellen Gebühren stehen in der <a href="/sbf-kosten/" class="pg-inline-link">Kostenübersicht</a>.
      </p>
    </section>

    <!-- Dauer -->
    <section class="pg-section">
      <h2 class="pg-h2">Wie lange dauern Prüfung und Vorbereitung?</h2>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-label">Theorieprüfung</p>
          <p class="pg-card-text">SBF Binnen 45 Minuten<br>SBF See 60 Minuten</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Praxisprüfung</p>
          <p class="pg-card-text">Pro Person meist wenige Minuten bis etwa eine halbe Stunde</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Vorbereitung</p>
          <p class="pg-card-text">SBF Binnen 3–6 Wochen bei 30–45 Minuten täglich; SBF See etwas länger</p>
        </div>
      </div>
      <p class="pg-p pg-p--after">
        Die praktische Prüfung findet oft als Sammeltermin statt: Während einer das Boot führt, werden andere parallel auf die Knoten geprüft. Wie du deine Lernzeit planst, zeigt der Artikel <a href="/blog/sbf-vorbereitung-wie-lange/" class="pg-inline-link">Wie lange dauert die SBF-Vorbereitung?</a>
      </p>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum Prüfungsablauf</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Seiten</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen-pruefungsfragen/">SBF Binnen Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see-pruefungsfragen/">SBF See Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/mann-ueber-bord-manoever/">Mann-über-Bord-Manöver: So gelingt es in der Praxisprüfung<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/anlegen-ablegen-hafenmanoever/">Anlegen und Ablegen: Hafenmanöver für die Praxisprüfung<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/schallsignale-sbf-erklaert/">Schallsignale beim SBF: See & Binnen im Überblick<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/erste-hilfe-an-bord/">Erste Hilfe an Bord: Die wichtigsten Maßnahmen auf dem Wasser<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-binnen-pruefung-nicht-bestanden/">SBF-Binnen-Prüfung nicht bestanden – was jetzt zu tun ist<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/promillegrenze-boot/">Promillegrenze auf dem Boot – was Sportbootführer wissen müssen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/umweltschutz-gewaesserschutz-bootfahren/">Umweltschutz und Gewässerschutz beim Bootfahren<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/faq/">Häufige Fragen zum Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
