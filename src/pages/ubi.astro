---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import type { IconName } from '../icons';
import PlatformPrice from '../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "UBI Sprechfunk", "item": "https://boatpass.de/ubi/" },
  ],
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für das UBI.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "UBI Prüfungsvorbereitung – UKW-Sprechfunkzeugnis Binnen",
  "description": "Vorbereitung auf die Prüfung zum UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk (UBI) mit dem amtlichen Fragenkatalog (130 Fragen), Prüfungssimulation und Fehlertraining.",
  "url": "https://boatpass.de/ubi/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Binnenschifffahrtsfunk und Verkehrskreise",
    "Funkeinrichtungen und ATIS",
    "Not-, Dringlichkeits- und Sicherheitsverkehr",
    "Sprechfunk-Betriebsverfahren und Rangfolgen",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT6H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('ubi'),
};

const faqs = [
  {
    q: 'Wie viele Fragen hat die UBI-Prüfung und wie viele muss ich richtig haben?',
    a: 'Die theoretische UBI-Prüfung besteht aus einem Bogen mit 22 Multiple-Choice-Fragen, den du in 60 Minuten beantwortest – bestanden ab 17 richtigen Antworten. Dazu kommt ein praktischer Teil mit Pflichtaufgaben wie ATIS-Einstellung, Gerätekunde sowie Not-, Dringlichkeits- und Sicherheitsmeldungen. Boatpass trainiert den vollständigen amtlichen Fragenkatalog mit 130 Fragen.',
  },
  {
    q: 'Was kostet das UBI?',
    a: 'Die amtliche Gesamtgebühr für das UBI beträgt 108,71 € und setzt sich aus Zulassung (15,89 €), Prüfung von Theorie & Praxis (70,03 €) und Erteilung des Zeugnisses (22,79 €) zusammen. Die Wiederholung von Theorie oder Praxis kostet 45,64 €. Diese amtlichen Gebühren sind unabhängig vom Boatpass UBI-Lernmodul (einmalig ' + priceText('ubi', 'de') + ').',
  },
  {
    q: 'Brauche ich für das UBI einen Funkkurs?',
    a: 'Nein. Ein Vorbereitungskurs ist nicht vorgeschrieben – der amtliche Fragenkatalog ist frei verfügbar, du kannst die Theorie also eigenständig lernen, zum Beispiel mit dem Boatpass UBI-Modul. Für den praktischen Sprechfunk-Teil empfiehlt sich vorab etwas Übung am Gerät.',
  },
  {
    q: 'Ab welchem Alter kann ich das UBI machen?',
    a: 'Das Mindestalter für die UBI-Prüfung beträgt 15 Jahre. Das UBI ist unabhängig vom SBF Binnen und kann separat erworben werden.',
  },
  {
    q: 'UBI oder SRC – welches Funkzeugnis brauche ich?',
    a: 'Das UBI ist für den UKW-Sprechfunk auf Binnenschifffahrtsstraßen zuständig, das SRC für den UKW-Seefunk im Küstenbereich. Beide sind nicht gegenseitig anrechenbar. Wer bereits ein Seefunkzeugnis (SRC oder LRC) besitzt, dem werden die theoretische und praktische UBI-Prüfung jedoch verkürzt.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist das UBI?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "UBI",
  "alternateName": "UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk",
  "description": "Das UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk (UBI) ist die amtliche bzw. amtlich anerkannte Erlaubnis zum Bedienen und Beaufsichtigen einer Schiffsfunkstelle auf Binnenschifffahrtsstraßen.",
  "url": "https://boatpass.de/ubi/",
  "inLanguage": "de",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Verkehrskreise', desc: 'Kanal- und Revierfunk, Streckenfunk auf Binnenwasserstraßen', count: 30, icon: 'wifi' },
  { name: 'Betriebsverfahren', desc: 'Gesprächsabwicklung, Prioritäten & Sprechprozeduren', count: 29, icon: 'microphone' },
  { name: 'ATIS & Technik', desc: 'Automatische Senderidentifizierung und Gerätekunde', count: 25, icon: 'satellite' },
  { name: 'Notruf & Sicherheit', desc: 'Notrufe, Dringlichkeits- und Sicherheitsverkehr', count: 24, icon: 'shield' },
  { name: 'Funk & Regelwerk', desc: 'Frequenzen, Lizenzrecht & Funkvorschriften', count: 22, icon: 'scale' },
];
---

<BaseLayout
  title="UBI Lernapp – UKW-Sprechfunkzeugnis Binnen lernen"
  description={`UBI-Funkzeugnis (UKW-Sprechfunk Binnen) lernen: Prüfung, Inhalte, Tipps. Boatpass UBI-Modul einmalig ab ${minPrice(['ubi'], 'de')} mit Prüfungssimulation – jetzt starten.`}
  lang="de"
  altUrl="https://boatpass.de/en/ubi/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="UKW-Sprechfunkzeugnis Binnen"
    lede="Das UKW-Sprechfunkzeugnis für Binnenschifffahrt (UBI) ist Pflicht für jeden, der Funk an Bord bedienen will. Hier erfährst du alles zur Prüfung – und wie dich das Boatpass UBI-Modul optimal vorbereitet."
    ctaLabel="Jetzt UBI lernen in der App"
    cta
  >
    UBI lernen –<br />alles zum Sprechfunkzeugnis
    <span slot="badge">Boatpass UBI-Modul – jetzt verfügbar · einmalig&nbsp;<PlatformPrice product="ubi" lang="de" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="ubi"
      items={[
        { k: 'Fragenkatalog', v: '130 Fragen' },
        { k: 'Theorie', v: '60 Min, bestanden ab 17 richtig' },
        { k: 'Prüfungsform', v: 'Schriftlich + praktisch (DSV)' },
        { k: 'Prüfungsgebühr', v: '108,71 €' },
        { k: 'Mindestalter', v: '15 Jahre' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Das UBI (UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk) berechtigt zum Bedienen von UKW-Funkanlagen auf Binnenschifffahrtsstraßen. Die Prüfung besteht aus einem theoretischen Teil mit 22 Multiple-Choice-Fragen in 60 Minuten – bestanden ab 17 richtigen Antworten – und einem praktischen Teil mit Pflichtaufgaben (ATIS-Einstellung, Gerätekunde sowie Not-, Dringlichkeits- und Sicherheitsmeldungen). Mindestalter: 15 Jahre. Boatpass trainiert den vollständigen amtlichen Fragenkatalog (130 Fragen) mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist UBI -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist das UBI?</h2>
      <p class="pg-p">
        Das <strong>UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk (UBI)</strong> ist die amtliche bzw. amtlich anerkannte Erlaubnis zum Bedienen und Beaufsichtigen einer Schiffsfunkstelle auf Binnenschifffahrtsstraßen. Die Prüfung wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) abgenommen. Mindestalter: 15 Jahre.
      </p>
      <p class="pg-p">
        Das UBI ist <strong>unabhängig vom SBF Binnen</strong> – du kannst es separat erwerben. In der Praxis empfiehlt sich jedoch die gemeinsame Vorbereitung, da viele Binnenschiffer beide Zeugnisse benötigen.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section class="pg-section">
      <CatalogSources lang="de" only="ubi" />
    </section>

    <!-- Wer braucht es -->
    <section class="pg-section">
      <h2 class="pg-h2">Wer braucht das UBI?</h2>
      <div class="pg-rows">
        {([
          { icon: 'anchor', title: 'Binnenfunk-Pflicht', desc: 'Wer eine UKW-Sprechfunkanlage auf Binnenwasserstraßen betreibt' },
          { icon: 'lifebuoy', title: 'Stark befahrene Reviere', desc: 'Sportbootfahrer, die auf Rhein, Elbe oder Donau unterwegs sind' },
          { icon: 'satellite', title: 'AIS-Sendebetrieb', desc: 'Wer AIS-Geräte (Automatic Identification System) mit Sendebetrieb nutzt' },
          { icon: 'home', title: 'Hausboote & Charter', desc: 'Charterer von Hausbooten und größeren Motorbooten auf Binnenwasserstraßen' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Prüfungsaufbau -->
    <section class="pg-section">
      <h2 class="pg-h2">UBI-Prüfung: Aufbau & Inhalte</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Prüfungsform</p>
          <p class="pg-card-text">Schriftlich + praktisch<br>DSV-Prüfungsausschuss</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Theorie</p>
          <p class="pg-card-text">Multiple Choice<br>Revier- & Betriebskunde</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Praxis</p>
          <p class="pg-card-text">Sprechübungen<br>Notrufe & Verfahren</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Prüfungsgebühr</p>
          <p class="pg-card-text">ca. 109 €<br>Gesamtprüfung (DSV)</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Prüfungsthemen:</strong> Verkehrskreise sowie Rangfolge und Arten des Funkverkehrs, Frequenzen und ihre Nutzung, automatisches Senderidentifizierungssystem (ATIS), Not-, Dringlichkeits- und Sicherheitsverkehr sowie Bedienung und Technik der Funkanlage.
        </p>
      </div>
      <div class="pg-card pg-card--note pg-card--hint">
        <span class="pg-row-icon pg-row-icon--hint"><Icon name="lightbulb" size={20} strokeWidth={1.75} /></span>
        <p class="pg-note">
          <strong>Schon ein Seefunkzeugnis?</strong> Für Inhaber des <a href="/src/" class="pg-inline-link">SRC</a> oder <a href="/lrc/" class="pg-inline-link">LRC</a> sind die theoretische und die praktische UBI-Prüfung verkürzt – beide Prüfungen sind ggf. sogar an einem Tag möglich.
        </p>
      </div>
    </section>

    <!-- Praxis-Brücke: Angst vorm Sprechfunk nehmen -->
    <PracticeBridge variant="radio" />

    <!-- Kosten im Detail -->
    <section class="pg-section">
      <h2 class="pg-h2">Was kostet das UBI?</h2>
      <p class="pg-p">
        Die amtliche Prüfungsgebühr setzt sich aus drei Posten zusammen. So viel zahlst du wofür:
      </p>
      <div class="pg-fees">
        {[
          { label: 'Zulassung zur Prüfung', desc: 'Antragsbearbeitung & Zulassung durch den Prüfungsausschuss', price: '15,89 €' },
          { label: 'Prüfung Theorie & Praxis', desc: 'Abnahme der schriftlichen und praktischen Prüfung', price: '70,03 €' },
          { label: 'Erteilung des Sprechfunkzeugnisses', desc: 'Ausstellung des amtlichen UBI-Zeugnisses', price: '22,79 €' },
        ].map(row => (
          <div class="pg-fee">
            <div>
              <p class="pg-fee-label">{row.label}</p>
              <p class="pg-fee-desc">{row.desc}</p>
            </div>
            <p class="pg-fee-price h-num">{row.price}</p>
          </div>
        ))}
        <div class="pg-fee pg-fee--total">
          <p class="pg-fee-label">Gesamt (inkl. MwSt.)</p>
          <p class="pg-fee-price pg-fee-price--accent h-num">108,71 €</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        Stand der Gebühren laut DSV. Wiederholung von Theorie <u>oder</u> Praxis: 45,64 €. Bei Auslandsprüfungen können zusätzliche Reisekosten anfallen. Diese amtlichen Gebühren sind unabhängig vom Boatpass UBI-Lernmodul (einmalig {priceText('ubi', 'de')}).
      </p>
    </section>

    <!-- So hilft Boatpass beim UBI -->
    <section class="pg-section">
      <h2 class="pg-h2">So hilft Boatpass beim UBI</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Vollständiger UBI-Fragenkatalog', desc: 'Alle offiziellen UBI-Fragen zu Binnenfunk und ATIS – vollständig abgedeckt, immer aktuell.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Übe unter echten Prüfungsbedingungen mit Bestehensgrenze und Zeitdruck.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Nur deine Schwachstellen trainieren – effizient und zielgerichtet.' },
          { icon: 'chart', title: 'Fortschritt nach Kategorie', desc: 'Sieh nach Thema aufgeschlüsselt, wie gut du auf die UBI-Prüfung vorbereitet bist.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der UBI-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p class="pg-note pg-note--sm">
        Quelle: amtlicher Fragenkatalog auf <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass UBI-Modul verfügbar -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Jetzt verfügbar</p>
          <h2 class="pg-h2">Boatpass UBI-Modul</h2>
          <p class="pg-p">Das UBI-Modul für Boatpass ist da – mit dem gleichen Lernkonzept wie SBF Binnen & See: offizieller Fragenkatalog, Prüfungssimulation und Fehlertraining. Einmalig <strong><PlatformPrice product="ubi" lang="de" /></strong>, kein Abo.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="ubi" lang="de" alt /></span> <span class="pg-cta-unit">Einmalkauf</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            UBI-Modul in der App freischalten
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(öffnet in neuem Tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum UBI</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Verwandte Führerscheine</h2>
      <ul class="pg-related">
        <li><a href="/funkschein-app/">Funkschein-Apps im Vergleich<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-binnen/">SBF Binnen lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/src/">SRC – Kurzstreckenzeugnis für Seefunk<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/faq/">Häufige Fragen zum Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-vs-src-funkschein/">UBI oder SRC – welches Funkzeugnis brauchst du?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-fragenkatalog-2026/">UBI-Fragenkatalog 2026: Das ändert sich zum 1. Oktober<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/notsignale-auf-see/">Notsignale auf See: diese Seenotsignale musst du kennen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/gps-kartenplotter-funkgeraet-moderne-navigation/">GPS, Kartenplotter und Funkgerät – moderne Navigation an Bord<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
