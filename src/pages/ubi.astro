---
import BaseLayout from '../layouts/BaseLayout.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "UBI Sprechfunk", "item": "https://boatpass.de/ubi/" },
  ],
};
---

<BaseLayout
  title="UBI Lernapp – UKW-Sprechfunkzeugnis Binnen lernen"
  description="Alles zum UBI (UKW-Sprechfunkzeugnis für Binnenschifffahrt): Prüfungsaufbau, Inhalte und wie du dich optimal vorbereitest. Boatpass UBI-Modul jetzt in der App – einmalig 5,99 €."
  lang="de"
  hasAlternate={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        📻 UKW-Sprechfunkzeugnis Binnen
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        UBI lernen –<br>alles zum Sprechfunkzeugnis
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Das UKW-Sprechfunkzeugnis für Binnenschifffahrt (UBI) ist Pflicht für jeden, der Funk an Bord bedienen will.
        Hier erfährst du alles zur Prüfung — und wie dich das Boatpass UBI-Modul optimal vorbereitet.
      </p>

      <!-- Verfügbar Badge -->
      <div style="display:inline-flex; align-items:center; gap:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#047857; font-size:14px; font-weight:700; padding:10px 20px; border-radius:14px; margin-bottom:24px;">
        ✅ Boatpass UBI-Modul — jetzt verfügbar · einmalig 5,99 €
      </div>
      <br/>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:15px; padding:14px 28px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2); margin-top:16px;">
        ▶&nbsp;Jetzt UBI lernen in der App
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Was ist UBI -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Was ist das UBI?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Das <strong>UKW-Sprechfunkzeugnis für den Binnenschifffahrtsfunk (UBI)</strong> ist die amtliche bzw. amtlich anerkannte Erlaubnis zum Bedienen und Beaufsichtigen einer Schiffsfunkstelle auf Binnenschifffahrtsstraßen. Die Prüfung wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) abgenommen. Mindestalter: 15 Jahre.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Das UBI ist <strong>unabhängig vom SBF Binnen</strong> — du kannst es separat erwerben. In der Praxis empfiehlt sich jedoch die gemeinsame Vorbereitung, da viele Binnenschiffer beide Zeugnisse benötigen.
      </p>
    </section>

    <!-- Wer braucht es -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">Wer braucht das UBI?</h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {[
          { icon: '⚓', text: 'Wer eine UKW-Sprechfunkanlage auf Binnenwasserstraßen betreibt' },
          { icon: '🚤', text: 'Sportbootfahrer, die auf stark befahrenen Wasserstraßen (Rhein, Elbe, Donau) unterwegs sind' },
          { icon: '📡', text: 'Wer AIS-Geräte (Automatic Identification System) mit Sendebetrieb nutzt' },
          { icon: '🏕️', text: 'Charterer von Hausbooten und größeren Motorbooten auf Binnenwasserstraßen' },
        ].map(item => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="font-size:20px; flex-shrink:0;">{item.icon}</span>
            <span style="font-size:15px; color:#4B5563; line-height:1.6;">{item.text}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Prüfungsaufbau -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:20px;">UBI-Prüfung: Aufbau & Inhalte</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Prüfungsform</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Schriftlich + praktisch<br>DSV-Prüfungsausschuss</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theorie</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Multiple Choice<br>Revier- & Betriebskunde</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Praxis</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Sprechübungen<br>Notrufe & Verfahren</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Prüfungsgebühr</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">ca. 109 €<br>Gesamtprüfung (DSV)</div>
        </div>
      </div>
      <div style="background:rgba(51,102,255,0.05); border:1px solid rgba(51,102,255,0.15); border-radius:14px; padding:20px; margin-bottom:16px;">
        <p style="font-size:15px; color:#4B5563; line-height:1.7; margin:0;">
          <strong style="color:#1A1F36;">Prüfungsthemen:</strong> Verkehrskreise sowie Rangfolge und Arten des Funkverkehrs, Frequenzen und ihre Nutzung, automatisches Senderidentifizierungssystem (ATIS), Not-, Dringlichkeits- und Sicherheitsverkehr sowie Bedienung und Technik der Funkanlage.
        </p>
      </div>
      <div style="display:flex; align-items:flex-start; gap:12px; background:rgba(16,185,129,0.07); border:1px solid rgba(16,185,129,0.25); border-radius:14px; padding:20px;">
        <span style="font-size:20px; flex-shrink:0;">💡</span>
        <p style="font-size:15px; color:#4B5563; line-height:1.7; margin:0;">
          <strong style="color:#047857;">Schon ein Seefunkzeugnis?</strong> Für Inhaber des <a href="/src/" style="color:#3366FF; text-decoration:none;">SRC</a> oder <a href="/lrc/" style="color:#3366FF; text-decoration:none;">LRC</a> sind die theoretische und die praktische UBI-Prüfung verkürzt — beide Prüfungen sind ggf. sogar an einem Tag möglich.
        </p>
      </div>
    </section>

    <!-- Kosten im Detail -->
    <section style="margin-bottom:48px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">Was kostet das UBI?</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:24px;">
        Die amtliche Prüfungsgebühr setzt sich aus drei Posten zusammen. So viel zahlst du wofür:
      </p>
      <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; overflow:hidden;">
        {[
          { label: 'Zulassung zur Prüfung', desc: 'Antragsbearbeitung & Zulassung durch den Prüfungsausschuss', price: '15,89 €' },
          { label: 'Prüfung Theorie & Praxis', desc: 'Abnahme der schriftlichen und praktischen Prüfung', price: '70,03 €' },
          { label: 'Erteilung des Sprechfunkzeugnisses', desc: 'Ausstellung des amtlichen UBI-Zeugnisses', price: '22,79 €' },
        ].map(row => (
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px; border-bottom:1px solid rgba(51,102,255,0.08);">
            <div>
              <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">{row.label}</div>
              <div style="font-size:13px; color:#6B7280; line-height:1.5;">{row.desc}</div>
            </div>
            <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">{row.price}</div>
          </div>
        ))}
        <div style="display:flex; justify-content:space-between; align-items:center; gap:16px; padding:20px 24px; background:rgba(51,102,255,0.05);">
          <div style="font-size:15px; font-weight:800; color:#1A1F36;">Gesamt (inkl. MwSt.)</div>
          <div style="font-size:20px; font-weight:900; color:#3366FF; white-space:nowrap;">108,71 €</div>
        </div>
      </div>
      <p style="font-size:13px; color:#9CA3AF; line-height:1.6; margin-top:12px;">
        Stand der Gebühren laut DSV. Wiederholung von Theorie <u>oder</u> Praxis: 45,64 €. Bei Auslandsprüfungen können zusätzliche Reisekosten anfallen. Diese amtlichen Gebühren sind unabhängig vom Boatpass UBI-Lernmodul (einmalig 5,99 €).
      </p>
    </section>

    <!-- Boatpass UBI-Modul verfügbar -->
    <section style="margin-bottom:48px; background:linear-gradient(135deg,#3366FF,#1A44D4); border:1px solid rgba(255,255,255,0.15); border-radius:24px; padding:40px; box-shadow:0 20px 60px rgba(51,102,255,0.3);">
      <div style="font-size:13px; font-weight:700; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">✅ Jetzt verfügbar</div>
      <h2 style="font-size:24px; font-weight:800; color:white; margin-bottom:12px;">Boatpass UBI-Modul</h2>
      <p style="font-size:15px; color:rgba(255,255,255,0.8); line-height:1.7; margin-bottom:20px;">
        Das UBI-Modul für Boatpass ist da — mit dem gleichen Lernkonzept wie SBF Binnen & See: offizieller Fragenkatalog, Prüfungssimulation und Fehler-Training. Einmalig <strong style="color:white;">5,99 €</strong>, kein Abo.
      </p>
      <div style="display:flex; align-items:baseline; gap:8px; margin-bottom:24px;">
        <span style="font-size:40px; font-weight:900; color:white; letter-spacing:-1.5px;">5,99 €</span>
        <span style="font-size:14px; color:rgba(255,255,255,0.7); font-weight:500;">Einmalkauf</span>
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:8px; background:white; color:#3366FF; font-weight:700; font-size:14px; padding:12px 24px; border-radius:12px; text-decoration:none; box-shadow:0 8px 24px rgba(0,0,0,0.18);">
        ▶&nbsp;UBI-Modul in der App freischalten
      </a>
    </section>

    <!-- Interne Links -->
    <section style="padding-top:32px; border-top:1px solid rgba(51,102,255,0.1);">
      <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Verwandte Führerscheine</h3>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/sbf-binnen/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Binnen lernen mit Boatpass</a>
        <a href="/sbf-see/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF See lernen mit Boatpass</a>
        <a href="/src/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SRC – Kurzstreckenzeugnis für Seefunk</a>
        <a href="/faq/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Häufige Fragen zum Sportbootführerschein</a>
      </div>
    </section>

  </div>
</BaseLayout>
