---
import AppLandingPage from '../components/AppLandingPage.astro';
import { LEARNING_APPS } from '../data/apps';
import { priceText } from '../data/stores';

// Alle Apps, die mindestens eines der drei Funkzeugnisse abdecken.
const apps = LEARNING_APPS.filter(app =>
  app.licenses.some(l => l === 'ubi' || l === 'src' || l === 'lrc')
);

const faqs = [
  {
    q: 'Welche App ist die beste für den Funkschein?',
    a: 'Das Feld ist kleiner als beim Sportbootführerschein: Fünf Apps decken die Funkzeugnisse ab. Bootspruefung.de bringt zusätzlich Musterfunksprüche mit, SBF-Fragen kommt vom Delius-Klasing-Verlag mit Karteikasten-System, Bootsprüfung deckt UBI, SRC und LRC zusammen mit SBF und Bodensee ab, Bootsschule1 bietet UBI und SRC als Teil seiner Kurse, und Boatpass bündelt die drei Funkkataloge mit SBF See und Binnen in einer App. Die kostenlosen Wimmer-Apps, Goritz und Sailbyte decken keine Funkzeugnisse ab.',
  },
  {
    q: 'UBI, SRC oder LRC – welches Funkzeugnis brauche ich?',
    a: 'Das UBI ist für den UKW-Sprechfunk auf Binnenschifffahrtsstraßen, das SRC für den UKW-Seefunk im Küstenbereich und das LRC für den weltweiten Seefunk inklusive Satellitenkommunikation. Die Zeugnisse sind nicht gegenseitig anrechenbar, wer aber bereits ein Seefunkzeugnis besitzt, bekommt die UBI-Prüfung verkürzt.',
  },
  {
    q: 'Kann ich die praktische Funkprüfung mit einer App üben?',
    a: 'Nein. Alle drei Funkzeugnisse haben einen praktischen Teil: Gerätebedienung, ATIS-Einstellung sowie Not-, Dringlichkeits- und Sicherheitsmeldungen. Eine App bereitet den Theorieteil vor und macht dich mit den Sprechprozeduren vertraut – das Sprechen am Gerät musst du üben.',
  },
  {
    q: 'Gibt es eine kostenlose Funkschein-App?',
    a: 'Bei Bootspruefung.de sind alle amtlichen Prüfungsfragen – auch für UBI, SRC und LRC – kostenlos nutzbar; Theorietexte, Musterfunksprüche und die vollständige Offline-Nutzung stecken in der Pro-Version. SBF-Fragen und Boatpass zeigen kostenlos eine Auswahl, die vollständigen Kataloge sind kostenpflichtig. Eine dauerhaft komplett kostenlose Funkschein-App wie die Wimmer-Apps beim SBF gibt es nicht.',
  },
  {
    q: 'Wie viele Fragen hat die UBI-Prüfung?',
    a: 'Der amtliche UBI-Fragenkatalog umfasst 130 Fragen. Im Prüfungsbogen beantwortest du 22 Multiple-Choice-Fragen in 60 Minuten, bestanden ab 17 richtigen Antworten. Dazu kommt der praktische Teil.',
  },
  {
    q: 'Gibt es die Funkschein-Apps auch für iPhone?',
    a: 'Ja. Alle fünf Apps – Bootspruefung.de, Bootsprüfung, Bootsschule1, SBF-Fragen und seit Oktober 2026 auch Boatpass – gibt es für Android und iOS.',
  },
];

const relatedLinks = [
  { href: '/ubi/', label: 'UBI – UKW-Sprechfunkzeugnis Binnen' },
  { href: '/src/', label: 'SRC – Kurzstreckenzeugnis für Seefunk' },
  { href: '/lrc/', label: 'LRC – Langstreckenzeugnis für Seefunk' },
  { href: '/sbf-app/', label: 'Alle Bootsführerschein-Apps im Vergleich' },
  { href: '/blog/ubi-vs-src-funkschein/', label: 'UBI oder SRC – welches Funkzeugnis brauchst du?' },
  { href: '/blog/notsignale-auf-see/', label: 'Notsignale auf See: was du kennen musst' },
];
---

<AppLandingPage
  lang="de"
  title="Funkschein-App: UBI, SRC und LRC lernen"
  description="Funkschein-App für UBI, SRC und LRC gesucht? Wir vergleichen Fragenkataloge, Preise und Plattformen – von Bootspruefung.de bis Boatpass. Jetzt vergleichen."
  altUrl="https://boatpass.de/en/radio-certificate-app/"
  path="/funkschein-app/"
  breadcrumbName="Funkschein-Apps im Vergleich"
  badge="UBI · SRC · LRC"
  h1="Funkschein-Apps im Vergleich"
  heroIntro="Für die Funkzeugnisse ist die Auswahl deutlich kleiner als beim Sportbootführerschein – fünf Apps decken UBI, SRC oder LRC überhaupt ab. Hier stehen sie nebeneinander."
  answer="Für die Funkzeugnisse UBI, SRC und LRC gibt es fünf Lern-Apps, die mindestens eines davon abdecken: Bootspruefung.de mit kostenlosen amtlichen Fragen und Musterfunksprüchen in der Pro-Version, SBF-Fragen vom Delius-Klasing-Verlag mit Karteikasten-System, Bootsprüfung als jüngster Anbieter mit allen drei Zeugnissen, Bootsschule1 mit UBI und SRC als Teil eines Kurses, und Boatpass, das alle drei Funkkataloge zusammen mit SBF See und Binnen in einer App bündelt."
  apps={apps}
  tableCaption="Alle Apps, die mindestens eines der Funkzeugnisse UBI, SRC oder LRC abdecken – alphabetisch sortiert."
  androidHeading="Funkschein-App für Android"
  androidParagraphs={[
    'Alle fünf Apps sind im Google Play Store verfügbar. Der Unterschied liegt weniger im Fragenkatalog – der ist amtlich und überall gleich – als im Drumherum: <strong>Bootspruefung.de</strong> liefert in der Pro-Version Musterfunksprüche und Theorietexte, <strong>SBF-Fragen</strong> setzt auf ein Karteikasten-System mit Prüfungssimulation nach Original-Bögen.',
    'Die beliebten kostenlosen Apps von Matthias Wimmer decken <strong>keine Funkzeugnisse</strong> ab, ebenso wenig die Goritz-Apps und Sailbyte. <strong>Bootsprüfung</strong> ist neu am Markt und deckt alle drei Zeugnisse ab, <strong>Bootsschule1</strong> bietet UBI und SRC nur im Rahmen seiner bezahlten Kurse.',
    'Bei Boatpass kosten die Funkmodule einmalig ' + priceText('ubi', 'de') + ' (UBI und SRC) beziehungsweise ' + priceText('lrc', 'de') + ' (LRC) – kein Abo, dauerhafter Zugriff.',
  ]}
  iosHeading="Funkschein-App für iPhone und iPad"
  iosParagraphs={[
    'Auf iOS sind alle fünf verglichenen Apps verfügbar. <strong>Bootspruefung.de</strong>, <strong>SBF-Fragen</strong>, <strong>Bootsprüfung</strong> und <strong>Boatpass</strong> decken UBI, SRC und LRC ab, <strong>Bootsschule1</strong> UBI und SRC.',
    '<strong>Boatpass ist seit Oktober 2026 im App Store</strong>. In beiden Stores gibt es zusätzlich ein Funk-Paket für alle drei Zeugnisse. Ein Kauf gilt nur im jeweiligen Store, ein Android-Kauf schaltet auf dem iPhone nichts frei.',
  ]}
  strengths={[
    'UBI, SRC und LRC in derselben App wie SBF See und SBF Binnen',
    'Vollständige amtliche Fragenkataloge, unter anderem 130 UBI-Fragen',
    'Prüfungssimulation mit Bestehensgrenze und Zeitlimit',
    'Fehlertraining für die typischen Stolperstellen bei Notrufverfahren',
    'Einmalkauf je Funkmodul oder als Funk-Paket – kein Abo',
    'Offline lernen – funktioniert ohne Internetverbindung',
  ]}
  limitations={[
    'Kein FKN-Pyroschein und kein Bodenseeschifferpatent',
    'Käufe gelten nur im jeweiligen Store – kein Übertrag zwischen Android und iPhone',
    'Keine Musterfunksprüche als Audio – die praktische Prüfung übst du am Gerät',
    'Deutlich weniger Bewertungen als Bootspruefung.de und SBF-Fragen',
    'Ersetzt nicht den praktischen Teil der Funkprüfung',
  ]}
  faqs={faqs}
  relatedLinks={relatedLinks}
>
  <section slot="after-table" style="margin-bottom:48px;">
    <h2 class="content-section-title" style="margin-bottom:16px;">Theorie und Praxis: was eine Funk-App leisten kann</h2>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Jedes Funkzeugnis hat zwei Teile. Die Theorie ist ein Multiple-Choice-Bogen aus dem amtlichen Katalog – genau dafür sind die Apps gebaut. Im praktischen Teil bedienst du ein Funkgerät, setzt einen DSC-Alarm ab und sprichst Not-, Dringlichkeits- und Sicherheitsmeldungen nach festem Schema. Das ersetzt keine App.
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Was Apps für die Praxis beitragen können, ist begrenzt: <strong>Bootspruefung.de</strong> bietet Musterfunksprüche zum Nachlesen, die übrigen Apps konzentrieren sich auf die Theorie. Für die Praxis brauchst du einen Kurs mit Übungsgerät oder einen Funksimulator. Unterschätze den Teil nicht: Die feste Reihenfolge einer Notmeldung muss in der Prüfung ohne Spickzettel sitzen.
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Beim UBI gilt seit dem 1. Oktober 2026 ein neuer amtlicher Fragenkatalog. Achte darauf, dass deine App ihn schon enthält; was sich geändert hat, steht im Artikel <a href="/blog/ubi-fragenkatalog-2026/" style="color:#3366FF; text-decoration:underline;">UBI-Fragenkatalog 2026</a>. Welches Zeugnis du brauchst, klären die Seiten zu <a href="/ubi/" style="color:#3366FF; text-decoration:underline;">UBI</a>, <a href="/src/" style="color:#3366FF; text-decoration:underline;">SRC</a> und <a href="/lrc/" style="color:#3366FF; text-decoration:underline;">LRC</a>.
    </p>
  </section>
</AppLandingPage>
