---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppChooser from '../components/AppChooser.astro';
---

<!-- noindex: Googlebot-Smartphone trägt „Android" im User-Agent und würde nur die
     Weiterleitung zu Google Play sehen – die Seite ist ein Sprungbrett, kein Inhalt. -->
<BaseLayout
  title="BoatPass-App laden – iPhone, iPad & Android"
  description="Lade die BoatPass-App für den Sportbootführerschein (SBF Binnen & See): kostenlos im App Store für iPhone und iPad oder bei Google Play für Android."
  lang="de"
  altUrl="https://boatpass.de/en/app/"
  noindex={true}
  showCta={false}
>
  <AppChooser lang="de" />
</BaseLayout>
