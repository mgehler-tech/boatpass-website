---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marius Gehler",
  "url": "https://boatpass.de/ueber-uns/",
  "jobTitle": "Gründer & Entwickler",
  "image": "https://boatpass.de/ueber-uns-hero.webp",
  "worksFor": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "description": "Marius Gehler ist App-Entwickler (Android & iOS) und Gründer von Boatpass – der modernen Lernapp für den Sportbootführerschein (SBF Binnen & See).",
  "knowsAbout": [
    "Sportbootführerschein",
    "SBF Binnen",
    "SBF See",
    "Android-Entwicklung",
    "iOS-Entwicklung",
    "ELWIS-Fragenkatalog",
  ],
};
---

<BaseLayout
  title="Über uns – die Geschichte hinter der Boatpass-App"
  description="Wer steckt hinter Boatpass? Die Geschichte und Motivation hinter der SBF-Lernapp – gebaut von einem Entwickler, der die Prüfung selbst gemacht hat."
  lang="de"
  altUrl="https://boatpass.de/en/about/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- Seitenkopf und schmale Spalte (Spec Runde 3, 3.1/3.5) -->
  <PageHead
    lang="de"
    eyebrow="Über uns"
    lede="Wer hinter der App steckt – und warum es sie gibt."
    cta
  >
    Über Boatpass
  </PageHead>

  <PageLayout variant="narrow">

    <!-- Autorenprofil -->
    <div class="pg-card pg-card--legal pg-portrait">
      <img
        src="/ueber-uns-hero.webp"
        alt="Marius Gehler, Gründer von Boatpass, am Steuerstand eines Motorboots im Hafen"
        width="1000"
        height="1250"
        loading="eager"
        fetchpriority="high"
      />
      <div class="pg-portrait-body">
        <p class="pg-card-title pg-card-title--lg">Marius Gehler</p>
        <p class="pg-card-label">Gründer & Entwickler von Boatpass</p>
        <p class="pg-p">
          Hi, ich bin Marius – Gründer und Entwickler von Boatpass. Ich entwickle seit Jahren
          Apps und habe Boatpass mit einem klaren Anspruch gebaut: eine SBF-App, die sich am
          Handy richtig gut anfühlt – schnell, aufgeräumt und motivierend.
        </p>
        <div class="pg-pills">
          {["SBF Binnen", "SBF See", "ELWIS-Fragenkatalog", "Android & iOS"].map(tag => (
            <span class="pg-pill">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Card: Warum es Boatpass gibt -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-h2 pg-h2--sm">Warum es Boatpass gibt</h2>
      <img
        src="/ueber-uns.webp"
        alt="Marius Gehler am Ruder eines Segelboots auf dem Wasser"
        width="1000"
        height="750"
        loading="lazy"
        class="pg-card-img"
      />
      <p class="pg-p pg-p--sm">
        Als ich anfing zu lernen, habe ich Freunde gefragt, die den Schein schon haben. Ihr Fazit war
        fast immer dasselbe: Inhaltlich gibt es gute Apps – aber keine, mit der das Lernen am Handy
        wirklich Spaß macht. Sperrige Menüs, lieblose Oberflächen, Fragen, die man stumpf auswendig lernt.
      </p>
      <p class="pg-p pg-p--sm">
        Das hat mich nicht losgelassen. Ich entwickle seit Jahren in meiner Freizeit Apps – Boatpass ist
        mein Herzensprojekt neben dem Beruf. Also habe ich die App gebaut, die mir selbst gefehlt hätte:
        eine, mit der das Lernen am Handy wirklich Spaß macht – und die inhaltlich 1:1 auf dem amtlichen
        Fragenkatalog aufsetzt.
      </p>
    </div>

    <!-- Card: Was mir wichtig ist -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-h2 pg-h2--sm">Was mir wichtig ist</h2>
      <p class="pg-p pg-p--sm">
        Theorie für den Bootführerschein muss sich nicht wie Pflicht anfühlen. Du sollst gern lernen und
        schnell vorankommen. Deshalb bekommst du bei jeder Frage verständliche Erklärungen und Merkhilfen –
        statt nur „richtig/falsch“. So bleibt der Stoff hängen, und du kommst schneller aufs Wasser.
      </p>
    </div>

    <!-- Card: Fachlich geprüft -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-h2 pg-h2--sm">Woher die Inhalte kommen</h2>
      <p class="pg-p pg-p--sm">
        Die Fragen und Antworten in Boatpass sind keine eigene Erfindung: Sie stammen 1:1 aus dem
        amtlichen Fragenkatalog, den das Bundesministerium für Digitales und Verkehr über
        <a href="https://www.elwis.de/" target="_blank" rel="noopener noreferrer" class="pg-inline-link">ELWIS</a>
        veröffentlicht. Welcher Katalog in welcher Fassung hinter jeder Lizenz steckt, kannst du auf den
        Lizenzseiten nachlesen und direkt bei ELWIS gegenprüfen.
      </p>
      <p class="pg-p pg-p--sm">
        Die Erklärungen und Merkhilfen schreibe ich selbst – auf Basis des Katalogs und der zugrunde
        liegenden Regelwerke (BinSchStrO, SeeSchStrO, KVR). Boatpass entsteht unabhängig und steht in
        keiner Verbindung zu DSV, DMYV oder einer Behörde.
      </p>
      <p class="pg-p pg-p--sm">
        Wenn dir in einer Erklärung ein Fehler auffällt: schreib mir. Ich prüfe jede Meldung selbst und
        korrigiere sie im nächsten Update.
      </p>
    </div>

    <!-- Card: Versprechen -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-h2 pg-h2--sm">Mein Versprechen</h2>
      <ul class="pg-checks">
        <li class="pg-check">
          <span class="pg-check-mark">✓</span>
          Immer aktueller, offizieller Fragenkatalog (ELWIS)
        </li>
        <li class="pg-check">
          <span class="pg-check-mark">✓</span>
          Kein Abo – einmal kaufen, dauerhaft nutzen
        </li>
        <li class="pg-check">
          <span class="pg-check-mark">✓</span>
          Erklärungen & Merkhilfen statt stumpfem Auswendiglernen
        </li>
        <li class="pg-check">
          <span class="pg-check-mark">✓</span>
          Von einem Entwickler gebaut, der Design ernst nimmt
        </li>
        <li class="pg-check">
          <span class="pg-check-mark">✓</span>
          Fehler melden – ich prüfe jede Meldung selbst und korrigiere sie im nächsten Update
        </li>
      </ul>
    </div>

    <!-- Card: Kontakt -->
    <div class="pg-card pg-card--legal">
      <h2 class="pg-h2 pg-h2--sm">Kontakt</h2>
      <p class="pg-p pg-p--sm">
        Feedback, einen Fehler entdeckt oder einfach eine Frage? Schreib mir über das
        <a href="/kontakt/" class="pg-inline-link">Kontaktformular</a> –
        ich lese jede Nachricht selbst.
      </p>
    </div>

  </PageLayout>
</BaseLayout>
