---
import BaseLayout from '../layouts/BaseLayout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marius Gehler",
  "url": "https://boatpass.de/ueber-uns/",
  "jobTitle": "Gründer & Entwickler",
  "image": "https://boatpass.de/ueber-uns-hero.webp",
  "worksFor": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "description": "Marius Gehler ist Android-Entwickler und Gründer von Boatpass – der modernen Lernapp für den Sportbootführerschein (SBF Binnen & See).",
  "knowsAbout": [
    "Sportbootführerschein",
    "SBF Binnen",
    "SBF See",
    "Android-Entwicklung",
    "ELWIS-Fragenkatalog",
  ],
};
---

<BaseLayout
  title="Über uns – die Geschichte hinter der Boatpass-App"
  description="Wer steckt hinter Boatpass? Die Geschichte und Motivation hinter der SBF-Lernapp – gebaut von einem Entwickler, der die Prüfung selbst gemacht hat."
  lang="de"
  altUrl="https://boatpass.de/en/about/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div style="max-width:720px; margin:0 auto; padding:80px 24px 120px;">

    <!-- Header -->
    <div style="margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        Über uns
      </div>
      <h1 style="font-size:clamp(30px,4.5vw,42px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:12px;">Über Boatpass</h1>
      <p style="font-size:16px; color:#656B78;">Wer hinter der App steckt – und warum es sie gibt.</p>
    </div>

    <!-- Autorenprofil -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; overflow:hidden; margin-bottom:16px;">
      <img
        src="/ueber-uns-hero.webp"
        alt="Marius Gehler, Gründer von Boatpass, am Steuerstand eines Motorboots im Hafen"
        width="1000"
        height="1250"
        loading="eager"
        fetchpriority="high"
        style="display:block; width:100%; height:380px; object-fit:cover; object-position:center 22%;"
      />
      <div style="padding:32px;">
        <div style="font-size:20px; font-weight:800; color:#1A1F36; margin-bottom:4px;">Marius Gehler</div>
        <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Gründer & Entwickler von Boatpass</div>
        <p style="font-size:16px; color:#4B5563; line-height:1.7; margin:0;">
          Hi, ich bin Marius – Gründer und Entwickler von Boatpass. Ich entwickle seit Jahren
          Apps und habe Boatpass mit einem klaren Anspruch gebaut: eine SBF-App, die sich am
          Handy richtig gut anfühlt – schnell, aufgeräumt und motivierend.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:20px;">
          {["SBF Binnen", "SBF See", "ELWIS-Fragenkatalog", "Android-Entwicklung"].map(tag => (
            <span style="font-size:12px; font-weight:700; background:rgba(51,102,255,0.08); color:#3366FF; border:1px solid rgba(51,102,255,0.15); padding:3px 10px; border-radius:100px;">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Card: Warum es Boatpass gibt -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Warum es Boatpass gibt</h2>
      <img
        src="/ueber-uns.webp"
        alt="Marius Gehler am Ruder eines Segelboots auf dem Wasser"
        width="1000"
        height="750"
        loading="lazy"
        style="display:block; width:100%; height:240px; object-fit:cover; object-position:center 35%; border-radius:12px; margin-bottom:20px;"
      />
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        Als ich anfing zu lernen, habe ich Freunde gefragt, die den Schein schon haben. Ihr Fazit war
        fast immer dasselbe: Inhaltlich gibt es gute Apps – aber keine, mit der das Lernen am Handy
        wirklich Spaß macht. Sperrige Menüs, lieblose Oberflächen, Fragen, die man stumpf auswendig lernt.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Das hat mich nicht losgelassen. Ich entwickle seit Jahren in meiner Freizeit Apps – Boatpass ist
        mein Herzensprojekt neben dem Beruf. Also habe ich die App gebaut, die mir selbst gefehlt hätte:
        eine, mit der das Lernen am Handy wirklich Spaß macht – und die inhaltlich 1:1 auf dem amtlichen
        Fragenkatalog aufsetzt.
      </p>
    </div>

    <!-- Card: Was mir wichtig ist -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Was mir wichtig ist</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Theorie für den Bootführerschein muss sich nicht wie Pflicht anfühlen. Du sollst gern lernen und
        schnell vorankommen. Deshalb bekommst du bei jeder Frage verständliche Erklärungen und Merkhilfen –
        statt nur „richtig/falsch“. So bleibt der Stoff hängen, und du kommst schneller aufs Wasser.
      </p>
    </div>

    <!-- Card: Fachlich geprüft -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Woher die Inhalte kommen</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        Die Fragen und Antworten in Boatpass sind keine eigene Erfindung: Sie stammen 1:1 aus dem
        amtlichen Fragenkatalog, den das Bundesministerium für Digitales und Verkehr über
        <a href="https://www.elwis.de/" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">ELWIS</a>
        veröffentlicht. Welcher Katalog in welcher Fassung hinter jeder Lizenz steckt, kannst du auf den
        Lizenzseiten nachlesen und direkt bei ELWIS gegenprüfen.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7; margin-bottom:12px;">
        Die Erklärungen und Merkhilfen schreibe ich selbst – auf Basis des Katalogs und der zugrunde
        liegenden Regelwerke (BinSchStrO, SeeSchStrO, KVR). Boatpass entsteht unabhängig und steht in
        keiner Verbindung zu DSV, DMYV oder einer Behörde.
      </p>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Wenn dir in einer Erklärung ein Fehler auffällt: schreib mir. Ich prüfe jede Meldung selbst und
        korrigiere sie im nächsten Update.
      </p>
    </div>

    <!-- Card: Versprechen -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px; margin-bottom:16px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Mein Versprechen</h2>
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px;">
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Immer aktueller, offizieller Fragenkatalog (ELWIS)
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Kein Abo – einmal kaufen, dauerhaft nutzen
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Erklärungen & Merkhilfen statt stumpfem Auswendiglernen
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Von einem Entwickler gebaut, der Design ernst nimmt
        </li>
        <li style="display:flex; align-items:flex-start; gap:12px; font-size:15px; color:#4B5563; line-height:1.6;">
          <span style="color:#3366FF; font-weight:700; flex-shrink:0;">✓</span>
          Fehler melden – ich prüfe jede Meldung selbst und korrigiere sie im nächsten Update
        </li>
      </ul>
    </div>

    <!-- Card: Kontakt -->
    <div style="background:white; border:1px solid rgba(51,102,255,0.1); border-radius:20px; padding:32px;">
      <h2 style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Kontakt</h2>
      <p style="font-size:15px; color:#4B5563; line-height:1.7;">
        Feedback, einen Fehler entdeckt oder einfach eine Frage? Schreib mir über das
        <a href="/kontakt/" style="color:#3366FF; text-decoration:none; font-weight:500;">Kontaktformular</a> –
        ich lese jede Nachricht selbst.
      </p>
    </div>

  </div>
</BaseLayout>
