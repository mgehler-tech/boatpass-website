---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import type { IconName } from '../icons';
import PlatformPrice from '../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SRC Seefunk", "item": "https://boatpass.de/src/" },
  ],
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für das SRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SRC Prüfungsvorbereitung – Short Range Certificate (Seefunk)",
  "description": "Vorbereitung auf die Prüfung zum Short Range Certificate (SRC) für den UKW-Seefunk mit DSC im Küstenbereich – mit dem amtlichen ELWIS-Fragenkatalog (180 Fragen), Prüfungssimulation und Fehlertraining.",
  "url": "https://boatpass.de/src/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "UKW-Seefunk und Betriebsverfahren",
    "DSC-Verfahren (Digital Selective Calling)",
    "Not-, Dringlichkeits- und Sicherheitsverkehr im GMDSS",
    "Funkvorschriften und Frequenznutzung",
    "Gerätekunde und Bedienung von UKW-Seefunkanlagen",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT8H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('src'),
};

const faqs = [
  {
    q: 'Wie läuft die SRC-Prüfung ab?',
    a: 'Die theoretische SRC-Prüfung umfasst einen Fragebogen mit 24 Multiple-Choice-Fragen in 30 Minuten – bestanden ab 19 richtigen Antworten. Dazu kommen die schriftliche Aufnahme einer Not-, Dringlichkeits- oder Sicherheitsmeldung sowie ein praktischer Teil mit vier Aufgaben am DSC-Funkgerät. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog mit 180 Fragen, den Boatpass vollständig trainiert.',
  },
  {
    q: 'Was kostet das SRC?',
    a: 'Die amtliche Prüfungsgebühr für das SRC beträgt bei DSV/DMYV aktuell rund 127,88 € (Zulassung, Prüfung und Erteilung des Zeugnisses). Ein optionaler Vorbereitungskurs an einer Funkschule kostet zusätzlich etwa 250–350 €, ist aber nicht vorgeschrieben. Diese Gebühren sind unabhängig vom Boatpass SRC-Lernmodul (einmalig ' + priceText('src', 'de') + ').',
  },
  {
    q: 'SRC oder UBI – welches Funkzeugnis brauche ich?',
    a: 'Das SRC ist das UKW-Seefunkzeugnis mit DSC für den Küstenbereich (Seegebiet A1), das UBI ist für den UKW-Sprechfunk auf Binnenschifffahrtsstraßen zuständig. Beide sind nicht gegenseitig anrechenbar. Wer auf hoher See außerhalb der UKW-Reichweite funken will, benötigt das umfangreichere LRC.',
  },
  {
    q: 'Ab welchem Alter kann ich das SRC machen und wie lange ist es gültig?',
    a: 'Zur SRC-Prüfung zugelassen wirst du ab 15 Jahren. Das SRC wird von den Prüfungsausschüssen des DSV und DMYV abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.',
  },
  {
    q: 'Brauche ich für das SRC einen Funkkurs?',
    a: 'Nein. Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du eigenständig mit dem offiziellen Fragenkatalog lernen, zum Beispiel mit dem Boatpass SRC-Modul. Für den praktischen Teil empfiehlt sich vorab etwas Übung am DSC-Funkgerät.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist das SRC?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SRC",
  "alternateName": "Short Range Certificate",
  "description": "Das Short Range Certificate (SRC) ist die amtliche Erlaubnis zur Teilnahme am weltweiten Seefunkdienst (GMDSS) im UKW-Bereich. Es berechtigt zur Bedienung aller UKW-Seefunkanlagen inklusive DSC mit einer Reichweite von rund 35 Seemeilen.",
  "url": "https://boatpass.de/src/",
  "inLanguage": "de",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Betriebsverfahren', desc: 'Gesprächsabwicklung, Prioritäten & Sprechprozeduren', count: 48, icon: 'microphone' },
  { name: 'DSC-Verfahren', desc: 'Digital Selective Calling, Notfall-DSC & Empfang', count: 38, icon: 'wifi' },
  { name: 'Not- & Sicherheitsverkehr', desc: 'Mayday, Pan-Pan, Sécurité & Koordination', count: 34, icon: 'shield' },
  { name: 'Funkvorschriften', desc: 'ITU-Vorschriften, Frequenzen & Zertifizierung', count: 30, icon: 'scale' },
  { name: 'Gerätekunde & Technik', desc: 'Aufbau, Bedienung & Wartung von UKW-Geräten', count: 30, icon: 'satellite' },
];
---

<BaseLayout
  title="SRC Funkzeugnis Lernapp – Short Range Certificate"
  description={`SRC-Funkzeugnis lernen: Prüfungsaufbau, Inhalte und Kosten im Überblick. Boatpass SRC-Modul einmalig ab ${minPrice(['src'], 'de')} mit Prüfungssimulation – jetzt starten.`}
  lang="de"
  altUrl="https://boatpass.de/en/src/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Short Range Certificate · Seefunk Küste"
    lede="Das Short Range Certificate (SRC) ist das meistgenutzte Seefunkzeugnis der Sportschifffahrt – Pflicht für jeden, der eine UKW-Seefunkanlage mit DSC im Küstenbereich bedient."
    ctaLabel="Jetzt SRC lernen in der App"
    cta
  >
    SRC lernen –<br />Kurzstreckenzeugnis Seefunk
    <span slot="badge">Boatpass SRC-Modul – jetzt verfügbar · einmalig&nbsp;<PlatformPrice product="src" lang="de" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="src"
      items={[
        { k: 'Fragenkatalog', v: '180 Fragen' },
        { k: 'Theorie', v: '30 Min, bestanden ab 19 richtig' },
        { k: 'Praxis', v: 'Bedienung am DSC-Funkgerät' },
        { k: 'Prüfungsgebühr', v: '127,88 €' },
        { k: 'Mindestalter', v: '15 Jahre' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Das SRC (Short Range Certificate) ist das UKW-Seefunkzeugnis mit DSC für den Küstenbereich (Seegebiet A1). Die theoretische Prüfung umfasst einen Fragebogen mit 24 Multiple-Choice-Fragen in 30 Minuten – bestanden ab 19 richtigen Antworten. Dazu kommen die schriftliche Aufnahme einer Not-, Dringlichkeits- oder Sicherheitsmeldung sowie ein praktischer Teil mit vier Aufgaben am Funkgerät. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog (180 Fragen); Boatpass trainiert alle SRC-Inhalte mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist das SRC?</h2>
      <p class="pg-p">
        Das <strong>Short Range Certificate (SRC)</strong> – auf Deutsch <em>Beschränkt Gültiges Funkbetriebszeugnis</em> – ist die amtliche Erlaubnis zur Teilnahme am weltweiten Seefunkdienst (GMDSS) im <strong>UKW-Bereich</strong>. Es berechtigt zur Bedienung aller UKW-Seefunkanlagen inklusive DSC (Digital Selective Calling) mit einer Reichweite von rund <strong>35 Seemeilen</strong> (Seegebiet A1).
      </p>
      <p class="pg-p">
        Das SRC ist für Segler und Motorbootfahrer <strong>Pflicht, sobald ein UKW-Seefunkgerät an Bord genutzt wird</strong> – auch im Küstenbereich. Es wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) und des Deutschen Motoryachtverbands (DMYV) abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section class="pg-section">
      <CatalogSources lang="de" only="src" />
    </section>

    <!-- Wer braucht es -->
    <section class="pg-section">
      <h2 class="pg-h2">Wer braucht das SRC?</h2>
      <div class="pg-rows">
        {([
          { icon: 'sailboat', title: 'UKW-Funkgerät an Bord', desc: 'Segler und Motorbootfahrer mit fest eingebautem oder tragbarem UKW-Seefunkgerät (DSC) an Bord' },
          { icon: 'waves', title: 'Küstenrevier & Ostsee', desc: 'Wer auf Nord- und Ostsee oder im Küstenrevier (Seegebiet A1) unterwegs ist' },
          { icon: 'lifebuoy', title: 'Charter-Skipper', desc: 'Viele Vercharterer setzen das SRC für Yachten mit Funkanlage voraus' },
          { icon: 'phone', title: 'Notruf & DSC-Alarm', desc: 'Jeder, der im Notfall korrekt einen DSC-Notalarm und Mayday-Ruf absetzen können muss' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Praxis-Brücke: Angst vorm Sprechfunk nehmen -->
    <PracticeBridge variant="radio" />

    <!-- SRC vs UBI vs LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">SRC, UBI oder LRC – welches Funkzeugnis?</h2>
      <div class="funk-compare-grid">
        <div class="pg-card pg-card--current">
          <p class="pg-card-title">SRC</p>
          <p class="pg-card-sub">Short Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Seefunk Küste (A1)</li>
            <li>✓ UKW + DSC</li>
            <li>✓ International gültig</li>
            <li>✗ Keine Grenz-/Kurzwelle</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">UBI</p>
          <p class="pg-card-sub">UKW-Sprechfunk Binnen</p>
          <ul class="pg-checklist">
            <li>✓ Binnenfunk (Flüsse, Kanäle)</li>
            <li>✓ AIS Binnenschifffahrt</li>
            <li>✗ Nicht für Seefunk gültig</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">LRC</p>
          <p class="pg-card-sub">Long Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Seefunk weltweit (A1–A4)</li>
            <li>✓ UKW + Grenz-/Kurzwelle</li>
            <li>✓ Satellitenfunk (GMDSS)</li>
          </ul>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        Für die allermeisten Küstenreviere ist das <strong>SRC</strong> das richtige Zeugnis. Wer auf hoher See funken will, braucht das <a href="/lrc/" class="pg-inline-link">LRC</a>; für Binnengewässer ist das <a href="/ubi/" class="pg-inline-link">UBI</a> zuständig. SRC und UBI sind nicht gegenseitig anrechenbar.
      </p>
    </section>

    <!-- Prüfungsaufbau -->
    <section class="pg-section">
      <h2 class="pg-h2">SRC-Prüfung: Aufbau & Inhalte</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theorie</p>
          <p class="pg-card-text">Schriftlich<br>Multiple-Choice-Fragebogen</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Praxis</p>
          <p class="pg-card-text">Bedienung am DSC-Funkgerät<br>Not-, Dringlichkeits- & Sicherheitsverkehr</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Englisch</p>
          <p class="pg-card-text">Notrufe empfangen & übersetzen<br>Deutschen Text ins Englische übertragen</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Mindestalter</p>
          <p class="pg-card-text">ab 15 Jahren<br>zur Prüfung zugelassen</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Prüfungsthemen:</strong> UKW-Seefunk und GMDSS-System (Seegebiet A1), DSC-Verfahren (Digital Selective Calling), Not-, Dringlichkeits- und Sicherheitsverkehr, Schiff-zu-Schiff- und Schiff-zu-Land-Kommunikation, NAVTEX, internationale Buchstabiertafel und Seenot-Englisch sowie die Funkvorschriften der ITU (VO Funk).
        </p>
      </div>
    </section>

    <!-- Kosten -->
    <section class="pg-section">
      <h2 class="pg-h2">Was kostet das SRC?</h2>
      <p class="pg-p">
        Für die amtliche SRC-Prüfung fällt eine Gebühr für Zulassung, Prüfung und Erteilung des Zeugnisses an:
      </p>
      <div class="pg-fees">
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Zulassung, Prüfung & Erteilung</p>
            <p class="pg-fee-desc">Amtliche Gebühr über DSV / DMYV (Theorie + Praxis + Zeugnis)</p>
          </div>
          <p class="pg-fee-price h-num">ca. 128 €</p>
        </div>
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Vorbereitungskurs (optional)</p>
            <p class="pg-fee-desc">Funkschule mit Lernmaterial & Praxistraining am Gerät</p>
          </div>
          <p class="pg-fee-price h-num">ca. 250–350 €</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        Die amtliche Prüfungsgebühr beträgt bei DSV/DMYV aktuell rund 127,88 €. Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du auch eigenständig mit dem offiziellen Fragenkatalog lernen. Diese amtlichen Gebühren sind unabhängig vom Boatpass SRC-Lernmodul (einmalig {priceText('src', 'de')}).
      </p>
    </section>

    <!-- So hilft Boatpass beim SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">So hilft Boatpass beim SRC</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Vollständiger SRC-Fragenkatalog', desc: 'Alle offiziellen SRC-Fragen für den Küstenbereich – vollständig abgedeckt, immer aktuell.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Übe unter echten Prüfungsbedingungen mit Zeitdruck und Bestehensgrenze.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Fokussiere dich auf die Fragen, die du noch nicht sicher beherrschst.' },
          { icon: 'chart', title: 'Fortschritt nach Kategorie', desc: 'Behalte den Überblick – welche Themen sind schon sicher, wo wird noch geübt?' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der SRC-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p class="pg-note pg-note--sm">
        Quelle: amtlicher Fragenkatalog auf <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass SRC-Modul verfügbar -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Jetzt verfügbar</p>
          <h2 class="pg-h2">Boatpass SRC-Modul</h2>
          <p class="pg-p">Das SRC-Modul für Boatpass ist da – mit dem gleichen Lernkonzept wie SBF Binnen & See: offizieller Fragenkatalog, Prüfungssimulation und gezieltes Fehlertraining. Einmalig <strong><PlatformPrice product="src" lang="de" /></strong>, kein Abo.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="src" lang="de" alt /></span> <span class="pg-cta-unit">Einmalkauf</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            SRC-Modul in der App freischalten
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(öffnet in neuem Tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum SRC</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Verwandte Führerscheine</h2>
      <ul class="pg-related">
        <li><a href="/funkschein-app/">Funkschein-Apps im Vergleich<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-binnen/">SBF Binnen lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/lrc/">LRC – Long Range Certificate für weltweiten Seefunk<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/ubi/">UBI – UKW-Sprechfunkzeugnis Binnen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/faq/">Häufige Fragen zum Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-vs-src-funkschein/">UBI oder SRC – welcher Funkschein passt zu deinem Boot?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/seefunk-grundlagen-einsteiger/">Seefunk für Einsteiger: Kanäle, DSC und Notruf verstehen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/notsignale-auf-see/">Notsignale auf See: diese Seenotsignale musst du kennen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/gps-kartenplotter-funkgeraet-moderne-navigation/">GPS, Kartenplotter und Funkgerät – moderne Navigation an Bord<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

<style>
  /* SRC/UBI/LRC-Vergleich: 3 Spalten auf Desktop, auf schmalen Screens
     gestapelt – sonst sprengen die Karten den Viewport (Horizontal-Overflow). */
  .funk-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .funk-compare-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
