---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import type { IconName } from '../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SRC Seefunk", "item": "https://boatpass.de/src/" },
  ],
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für das SRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SRC Prüfungsvorbereitung – Short Range Certificate (Seefunk)",
  "description": "Vorbereitung auf die Prüfung zum Short Range Certificate (SRC) für den UKW-Seefunk mit DSC im Küstenbereich – mit dem amtlichen ELWIS-Fragenkatalog (180 Fragen), Prüfungssimulation und Fehlertraining.",
  "url": "https://boatpass.de/src/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "UKW-Seefunk und Betriebsverfahren",
    "DSC-Verfahren (Digital Selective Calling)",
    "Not-, Dringlichkeits- und Sicherheitsverkehr im GMDSS",
    "Funkvorschriften und Frequenznutzung",
    "Gerätekunde und Bedienung von UKW-Seefunkanlagen",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT8H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "7.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

const faqs = [
  {
    q: 'Wie läuft die SRC-Prüfung ab?',
    a: 'Die theoretische SRC-Prüfung umfasst einen Fragebogen mit 24 Multiple-Choice-Fragen in 30 Minuten – bestanden ab 19 richtigen Antworten. Dazu kommen die schriftliche Aufnahme einer Not-, Dringlichkeits- oder Sicherheitsmeldung sowie ein praktischer Teil mit vier Aufgaben am DSC-Funkgerät. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog mit 180 Fragen, den Boatpass vollständig trainiert.',
  },
  {
    q: 'Was kostet das SRC?',
    a: 'Die amtliche Prüfungsgebühr für das SRC beträgt bei DSV/DMYV aktuell rund 127,88 € (Zulassung, Prüfung und Erteilung des Zeugnisses). Ein optionaler Vorbereitungskurs an einer Funkschule kostet zusätzlich etwa 250–350 €, ist aber nicht vorgeschrieben. Diese Gebühren sind unabhängig vom Boatpass SRC-Lernmodul (einmalig 7,99 €).',
  },
  {
    q: 'SRC oder UBI – welches Funkzeugnis brauche ich?',
    a: 'Das SRC ist das UKW-Seefunkzeugnis mit DSC für den Küstenbereich (Seegebiet A1), das UBI ist für den UKW-Sprechfunk auf Binnenschifffahrtsstraßen zuständig. Beide sind nicht gegenseitig anrechenbar. Wer auf hoher See außerhalb der UKW-Reichweite funken will, benötigt das umfangreichere LRC.',
  },
  {
    q: 'Ab welchem Alter kann ich das SRC machen und wie lange ist es gültig?',
    a: 'Zur SRC-Prüfung zugelassen wirst du ab 15 Jahren. Das SRC wird von den Prüfungsausschüssen des DSV und DMYV abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.',
  },
  {
    q: 'Brauche ich für das SRC einen Funkkurs?',
    a: 'Nein. Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du eigenständig mit dem offiziellen Fragenkatalog lernen, zum Beispiel mit dem Boatpass SRC-Modul. Für den praktischen Teil empfiehlt sich vorab etwas Übung am DSC-Funkgerät.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist das SRC?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SRC",
  "alternateName": "Short Range Certificate",
  "description": "Das Short Range Certificate (SRC) ist die amtliche Erlaubnis zur Teilnahme am weltweiten Seefunkdienst (GMDSS) im UKW-Bereich. Es berechtigt zur Bedienung aller UKW-Seefunkanlagen inklusive DSC mit einer Reichweite von rund 35 Seemeilen.",
  "url": "https://boatpass.de/src/",
  "inLanguage": "de",
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Betriebsverfahren', desc: 'Gesprächsabwicklung, Prioritäten & Sprechprozeduren', count: 48, icon: 'microphone', color: '#EA580C', bg: 'rgba(234,88,12,0.10)' },
  { name: 'DSC-Verfahren', desc: 'Digital Selective Calling, Notfall-DSC & Empfang', count: 38, icon: 'wifi', color: '#7C3AED', bg: 'rgba(124,58,237,0.10)' },
  { name: 'Not- & Sicherheitsverkehr', desc: 'Mayday, Pan-Pan, Sécurité & Koordination', count: 34, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Funkvorschriften', desc: 'ITU-Vorschriften, Frequenzen & Zertifizierung', count: 30, icon: 'scale', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Gerätekunde & Technik', desc: 'Aufbau, Bedienung & Wartung von UKW-Geräten', count: 30, icon: 'satellite', color: '#1D4ED8', bg: 'rgba(29,78,216,0.10)' },
];
---

<BaseLayout
  title="SRC Funkzeugnis Lernapp – Short Range Certificate"
  description="SRC-Funkzeugnis (Short Range Certificate) lernen: Prüfungsaufbau, Inhalte, Kosten und Vorbereitung. Boatpass SRC-Modul in der App – einmalig 7,99 €."
  lang="de"
  altUrl="https://boatpass.de/en/src/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Short Range Certificate · Seefunk Küste
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        SRC lernen –<br>Kurzstreckenzeugnis Seefunk
      </h1>
      <p style="font-size:18px; color:#656B78; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Das Short Range Certificate (SRC) ist das meistgenutzte Seefunkzeugnis der Sportschifffahrt – Pflicht für jeden, der eine UKW-Seefunkanlage mit DSC im Küstenbereich bedient.
      </p>

      <!-- Verfügbar Badge -->
      <div style="display:inline-flex; align-items:center; gap:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#047857; font-size:14px; font-weight:700; padding:10px 20px; border-radius:14px; margin-bottom:24px;">
        <Icon name="check" size={17} stroke="#047857" strokeWidth={2.5} />
        Boatpass SRC-Modul – jetzt verfügbar · einmalig 7,99 €
      </div>
      <br/>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:15px; padding:14px 28px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2); margin-top:16px;">
        ▶&nbsp;Jetzt SRC lernen in der App
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">Auf den Punkt</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          Das SRC (Short Range Certificate) ist das UKW-Seefunkzeugnis mit DSC für den Küstenbereich (Seegebiet A1). Die theoretische Prüfung umfasst einen Fragebogen mit 24 Multiple-Choice-Fragen in 30 Minuten – bestanden ab 19 richtigen Antworten. Dazu kommen die schriftliche Aufnahme einer Not-, Dringlichkeits- oder Sicherheitsmeldung sowie ein praktischer Teil mit vier Aufgaben am Funkgerät. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog (180 Fragen); Boatpass trainiert alle SRC-Inhalte mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist SRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Was ist das SRC?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Das <strong>Short Range Certificate (SRC)</strong> – auf Deutsch <em>Beschränkt Gültiges Funkbetriebszeugnis</em> – ist die amtliche Erlaubnis zur Teilnahme am weltweiten Seefunkdienst (GMDSS) im <strong>UKW-Bereich</strong>. Es berechtigt zur Bedienung aller UKW-Seefunkanlagen inklusive DSC (Digital Selective Calling) mit einer Reichweite von rund <strong>35 Seemeilen</strong> (Seegebiet A1).
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Das SRC ist für Segler und Motorbootfahrer <strong>Pflicht, sobald ein UKW-Seefunkgerät an Bord genutzt wird</strong> – auch im Küstenbereich. Es wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) und des Deutschen Motoryachtverbands (DMYV) abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="de" only="src" />
    </section>

    <!-- Wer braucht es -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Wer braucht das SRC?</h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {([
          { icon: 'sailboat', title: 'UKW-Funkgerät an Bord', desc: 'Segler und Motorbootfahrer mit fest eingebautem oder tragbarem UKW-Seefunkgerät (DSC) an Bord' },
          { icon: 'waves', title: 'Küstenrevier & Ostsee', desc: 'Wer auf Nord- und Ostsee oder im Küstenrevier (Seegebiet A1) unterwegs ist' },
          { icon: 'lifebuoy', title: 'Charter-Skipper', desc: 'Viele Vercharterer setzen das SRC für Yachten mit Funkanlage voraus' },
          { icon: 'phone', title: 'Notruf & DSC-Alarm', desc: 'Jeder, der im Notfall korrekt einen DSC-Notalarm und Mayday-Ruf absetzen können muss' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={item.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{item.title}</div>
              <div style="font-size:14px; color:#4B5563; line-height:1.6;">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Praxis-Brücke: Angst vorm Sprechfunk nehmen -->
    <PracticeBridge variant="radio" />

    <!-- SRC vs UBI vs LRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">SRC, UBI oder LRC – welches Funkzeugnis?</h2>
      <div class="funk-compare-grid">
        <div style="background:white; border:2px solid rgba(51,102,255,0.2); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">SRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Short Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Seefunk Küste (A1)</li>
            <li>✓ UKW + DSC</li>
            <li>✓ International gültig</li>
            <li>✗ Keine Grenz-/Kurzwelle</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">UBI</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">UKW-Sprechfunk Binnen</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Binnenfunk (Flüsse, Kanäle)</li>
            <li>✓ AIS Binnenschifffahrt</li>
            <li>✗ Nicht für Seefunk gültig</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">LRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Long Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Seefunk weltweit (A1–A4)</li>
            <li>✓ UKW + Grenz-/Kurzwelle</li>
            <li>✓ Satellitenfunk (GMDSS)</li>
          </ul>
        </div>
      </div>
      <p style="font-size:14px; color:#656B78; margin-top:12px; line-height:1.6;">
        Für die allermeisten Küstenreviere ist das <strong>SRC</strong> das richtige Zeugnis. Wer auf hoher See funken will, braucht das <a href="/lrc/" style="color:#3366FF; text-decoration:none;">LRC</a>; für Binnengewässer ist das <a href="/ubi/" style="color:#3366FF; text-decoration:none;">UBI</a> zuständig. SRC und UBI sind nicht gegenseitig anrechenbar.
      </p>
    </section>

    <!-- Prüfungsaufbau -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">SRC-Prüfung: Aufbau & Inhalte</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theorie</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Schriftlich<br>Multiple-Choice-Fragebogen</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Praxis</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Bedienung am DSC-Funkgerät<br>Not-, Dringlichkeits- & Sicherheitsverkehr</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Englisch</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Notrufe empfangen & übersetzen<br>Deutschen Text ins Englische übertragen</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Mindestalter</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">ab 15 Jahren<br>zur Prüfung zugelassen</div>
        </div>
      </div>
      <div style="background:rgba(51,102,255,0.05); border:1px solid rgba(51,102,255,0.15); border-radius:14px; padding:20px;">
        <p style="font-size:15px; color:#4B5563; line-height:1.7; margin:0;">
          <strong style="color:#1A1F36;">Prüfungsthemen:</strong> UKW-Seefunk und GMDSS-System (Seegebiet A1), DSC-Verfahren (Digital Selective Calling), Not-, Dringlichkeits- und Sicherheitsverkehr, Schiff-zu-Schiff- und Schiff-zu-Land-Kommunikation, NAVTEX, internationale Buchstabiertafel und Seenot-Englisch sowie die Funkvorschriften der ITU (VO Funk).
        </p>
      </div>
    </section>

    <!-- Kosten -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Was kostet das SRC?</h2>
      <p style="font-size:16px; color:#656B78; line-height:1.6; margin-bottom:24px;">
        Für die amtliche SRC-Prüfung fällt eine Gebühr für Zulassung, Prüfung und Erteilung des Zeugnisses an:
      </p>
      <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; overflow:hidden;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px; border-bottom:1px solid rgba(51,102,255,0.08);">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Zulassung, Prüfung & Erteilung</div>
            <div style="font-size:13px; color:#656B78; line-height:1.5;">Amtliche Gebühr über DSV / DMYV (Theorie + Praxis + Zeugnis)</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">ca. 128 €</div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px;">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Vorbereitungskurs (optional)</div>
            <div style="font-size:13px; color:#656B78; line-height:1.5;">Funkschule mit Lernmaterial & Praxistraining am Gerät</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">ca. 250–350 €</div>
        </div>
      </div>
      <p style="font-size:13px; color:#656B78; line-height:1.6; margin-top:12px;">
        Die amtliche Prüfungsgebühr beträgt bei DSV/DMYV aktuell rund 127,88 €. Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du auch eigenständig mit dem offiziellen Fragenkatalog lernen. Diese amtlichen Gebühren sind unabhängig vom Boatpass SRC-Lernmodul (einmalig 7,99 €).
      </p>
    </section>

    <!-- So hilft Boatpass beim SRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">So hilft Boatpass beim SRC</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {([
          { icon: 'book', title: 'Vollständiger SRC-Fragenkatalog', desc: 'Alle offiziellen SRC-Fragen für den Küstenbereich – vollständig abgedeckt, immer aktuell.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Übe unter echten Prüfungsbedingungen mit Zeitdruck und Bestehensgrenze.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Fokussiere dich auf die Fragen, die du noch nicht sicher beherrschst.' },
          { icon: 'chart', title: 'Fortschritt nach Kategorie', desc: 'Behalte den Überblick – welche Themen sind schon sicher, wo wird noch geübt?' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#656B78; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Lernen nach Kategorie</h2>
      <p style="font-size:16px; color:#656B78; line-height:1.6; margin-bottom:20px;">
        Der SRC-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p style="font-size:14px; color:#656B78; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
