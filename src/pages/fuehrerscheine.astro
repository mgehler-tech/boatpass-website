---
import BaseLayout from '../layouts/BaseLayout.astro';

// Verfügbare Führerscheine/Themenseiten — verlinken auf die bestehenden Detailseiten
const available = [
  {
    icon: '🌊',
    title: 'SBF Binnen',
    tag: 'Flüsse, Kanäle & Seen',
    desc: 'Der Sportbootführerschein für Binnengewässer — Flüsse, Kanäle und Seen. Pflicht ab 15 PS.',
    href: '/sbf-binnen/',
  },
  {
    icon: '⛵',
    title: 'SBF See',
    tag: 'Nord- & Ostsee',
    desc: 'Der Schein für Küstengewässer von Nord- und Ostsee. Eigene Prüfung mit Navigationsaufgabe.',
    href: '/sbf-see/',
  },
  {
    icon: '💶',
    title: 'SBF Kosten',
    tag: 'Gebühren & Spartipps',
    desc: 'Prüfungsgebühren, Kurs und Praxis im Überblick — und wie du beim Lernen clever sparst.',
    href: '/sbf-kosten/',
  },
  {
    icon: '📋',
    title: 'Prüfung & Ablauf',
    tag: 'Theorie & Praxis',
    desc: 'Wie Theorie- und Praxisprüfung ablaufen, wie du dich anmeldest und was am Prüfungstag zählt.',
    href: '/sbf-pruefung-ablauf/',
  },
];

// "Bald"-Themen — UBI/SRC haben Infoseiten, Bodensee/LRC noch nicht (nicht klickbar)
const soon = [
  { icon: '📻', title: 'UBI', desc: 'UKW-Sprechfunkzeugnis Binnenschifffahrt.', href: '/ubi/' },
  { icon: '📡', title: 'SRC', desc: 'Short Range Certificate — Seefunk.', href: '/src/' },
  { icon: '⚓', title: 'Bodenseeschifferpatent', desc: 'Pflichtschein für den Bodensee.', href: null },
  { icon: '🛰️', title: 'LRC', desc: 'Long Range Certificate — weltweiter Seefunk.', href: null },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Führerscheine", "item": "https://boatpass.de/fuehrerscheine/" },
  ],
};
---

<BaseLayout
  title="Bootsführerscheine im Überblick — welcher passt zu dir? | Boatpass"
  description="Alle Bootsführerscheine auf einen Blick: SBF Binnen, SBF See, Kosten und Prüfungsablauf — plus Sprechfunkzeugnisse UBI und SRC. Finde den richtigen Schein."
  lang="de"
  hasAlternate={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        ⚓ Alle Führerscheine
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Welcher Führerschein<br>passt zu dir?
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto;">
        Ob Binnengewässer oder Küste, Motorboot oder Funk an Bord — hier findest du
        den richtigen Schein und alles, was du für die Vorbereitung wissen musst.
      </p>
    </div>
  </div>

  <div style="max-width:1000px; margin:0 auto; padding:60px 24px 80px;">

    <!-- Verfügbar -->
    <section style="margin-bottom:64px;">
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">
        Sportbootführerschein
      </h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:28px;">
        Mit Boatpass lernst du die komplette Theorie — die Detailseiten erklären jeden Schein im Detail.
      </p>
      <div class="license-grid">
        {available.map(c => (
          <a href={c.href} class="license-card">
            <div class="license-icon">{c.icon}</div>
            <div class="license-title">{c.title}</div>
            <span class="license-tag">{c.tag}</span>
            <div class="license-desc">{c.desc}</div>
            <div class="license-link">Mehr erfahren →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Bald -->
    <section>
      <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:8px;">
        Bald verfügbar
      </h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:28px;">
        Wir arbeiten an weiteren Katalogen — Sprechfunkzeugnisse und Spezialscheine folgen.
      </p>
      <div class="license-grid">
        {soon.map(c => (
          c.href ? (
            <a href={c.href} class="license-card license-card-soon">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon">{c.icon}</div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
              <div class="license-link">Vorschau →</div>
            </a>
          ) : (
            <div class="license-card license-card-soon license-card-disabled">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon">{c.icon}</div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
            </div>
          )
        ))}
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  .license-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .license-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 20px;
    padding: 28px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .license-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(26,31,54,0.10);
    border-color: rgba(51,102,255,0.28);
  }
  .license-icon { font-size: 32px; margin-bottom: 14px; }
  .license-title {
    font-size: 20px;
    font-weight: 800;
    color: #1A1F36;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }
  .license-tag {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    color: #3366FF;
    background: rgba(51,102,255,0.08);
    border: 1px solid rgba(51,102,255,0.16);
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 12px;
  }
  .license-desc {
    font-size: 15px;
    color: #6B7280;
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }
  .license-link {
    font-size: 14px;
    font-weight: 700;
    color: #3366FF;
  }

  /* "Bald"-Karten optisch gedämpft */
  .license-card-soon { background: rgba(255,255,255,0.6); }
  .license-soon-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    font-size: 11px;
    font-weight: 700;
    color: #b45309;
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.3);
    padding: 3px 10px;
    border-radius: 100px;
  }
  /* Karten ohne Zielseite: sichtbar, aber nicht klickbar */
  .license-card-disabled { opacity: 0.6; cursor: default; }
  .license-card-disabled:hover {
    transform: none;
    box-shadow: none;
    border-color: rgba(51,102,255,0.10);
  }

  @media (max-width: 640px) {
    .license-grid { grid-template-columns: 1fr; }
  }
</style>
