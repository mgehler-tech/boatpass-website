---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';

// Verfügbare Führerscheine/Themenseiten – verlinken auf die bestehenden Detailseiten
const available = [
  {
    icon: 'waves' as IconName,
    title: 'SBF Binnen',
    tag: 'Flüsse, Kanäle & Seen',
    desc: 'Der Sportbootführerschein für Binnengewässer – Flüsse, Kanäle und Seen. Pflicht ab 15 PS.',
    href: '/sbf-binnen/',
  },
  {
    icon: 'sailboat' as IconName,
    title: 'SBF See',
    tag: 'Nord- & Ostsee',
    desc: 'Der Schein für Küstengewässer von Nord- und Ostsee. Eigene Prüfung mit Navigationsaufgabe.',
    href: '/sbf-see/',
  },
  {
    icon: 'banknotes' as IconName,
    title: 'SBF Kosten',
    tag: 'Gebühren & Spartipps',
    desc: 'Prüfungsgebühren, Kurs und Praxis im Überblick – und wie du beim Lernen clever sparst.',
    href: '/sbf-kosten/',
  },
  {
    icon: 'document' as IconName,
    title: 'Prüfung & Ablauf',
    tag: 'Theorie & Praxis',
    desc: 'Wie Theorie- und Praxisprüfung ablaufen, wie du dich anmeldest und was am Prüfungstag zählt.',
    href: '/sbf-pruefung-ablauf/',
  },
  {
    icon: 'phone' as IconName,
    title: 'UBI',
    tag: 'UKW-Sprechfunk Binnen',
    desc: 'Das UKW-Sprechfunkzeugnis für die Binnenschifffahrt – jetzt als Modul in der App, einmalig 7,99 €.',
    href: '/ubi/',
  },
  {
    icon: 'satellite' as IconName,
    title: 'SRC',
    tag: 'Seefunk Küste',
    desc: 'Das Short Range Certificate – UKW-Seefunkzeugnis (Kurzstrecke) für Küstengewässer – jetzt als Modul in der App, einmalig 7,99 €.',
    href: '/src/',
  },
  {
    icon: 'globe' as IconName,
    title: 'LRC',
    tag: 'Seefunk weltweit',
    desc: 'Das Allgemeine Funkbetriebszeugnis für weltweiten Seefunk (UKW, Grenz-/Kurzwelle, Satellit) – jetzt als Modul in der App, einmalig 9,99 €.',
    href: '/lrc/',
  },
];

// "Bald"-Themen – Bodensee noch ohne eigene Seite (nicht klickbar)
const soon = [
  { icon: 'anchor' as IconName, title: 'Bodenseeschifferpatent', desc: 'Pflichtschein für den Bodensee.', href: null },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Führerscheine", "item": "https://boatpass.de/fuehrerscheine/" },
  ],
};

const faqs = [
  {
    q: 'Welchen Bootsführerschein brauche ich?',
    a: 'Das hängt vom Revier und der Motorleistung ab: Auf Flüssen, Kanälen und Seen brauchst du ab 11,03 kW (15 PS) den SBF Binnen, auf Nord- und Ostsee den SBF See. Ist ein Funkgerät an Bord, kommt je nach Revier zusätzlich UBI, SRC oder LRC hinzu. Der kostenlose Finder oben zeigt dir in 3 Fragen die passende Kombination.',
  },
  {
    q: 'Was kostet ein Bootsführerschein?',
    a: 'Die amtlichen Prüfungsgebühren liegen 2026 bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Mit komplettem Vorbereitungskurs kommen meist 500–650 € pro Schein dazu; wer die Theorie selbst lernt – etwa mit Boatpass für 9,99 € pro Katalog – spart den Großteil davon.',
  },
  {
    q: 'Muss ich für den Bootsführerschein einen Kurs besuchen?',
    a: 'Nein, ein Kurs ist für die Theorie nicht vorgeschrieben. Der amtliche ELWIS-Fragenkatalog ist frei zugänglich, sodass du eigenständig lernen kannst – etwa mit einer App wie Boatpass. Für die praktische Prüfung ist meist trotzdem etwas Übung auf dem Wasser sinnvoll.',
  },
  {
    q: 'Brauche ich zusätzlich zum Bootsführerschein ein Funkzeugnis?',
    a: 'Nur wenn ein Funkgerät an Bord ist: Auf Binnengewässern reicht dafür das UBI, auf See das SRC für Kurzstrecke oder das LRC für weltweiten Funk. Ohne Funkgerät an Bord ist kein zusätzliches Funkzeugnis nötig.',
  },
  {
    q: 'Kann ich ein Boot auch ohne Führerschein fahren?',
    a: 'Ja, mit dem Charterschein darfst du auf ausgewiesenen Binnengewässern wie der Mecklenburgischen Seenplatte ein gemietetes Boot ohne SBF führen. Ganz ohne jeden Schein sind zudem Boote bis 11,03 kW (15 PS) erlaubt.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Bootsführerscheine: welcher passt zu dir?"
  description="Alle Bootsführerscheine auf einen Blick: SBF Binnen, SBF See, Kosten und Prüfungsablauf – plus Sprechfunkzeugnisse UBI und SRC. Finde den richtigen Schein."
  lang="de"
  altUrl="https://boatpass.de/en/licenses/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Alle Lizenzen
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        Welche Lizenz<br>passt zu dir?
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto;">
        Ob Binnengewässer oder Küste, Motorboot oder Funk an Bord – hier findest du
        die richtige Lizenz und alles, was du für die Vorbereitung wissen musst.
      </p>
    </div>
  </div>

  <div style="max-width:1000px; margin:0 auto; padding:60px 24px 80px;">

    <!-- Konfigurator-Banner -->
    <a href="/tools/welcher-bootsfuehrerschein/" style="display:flex; align-items:center; gap:18px; background:linear-gradient(135deg,#1A1F36,#3366FF); border-radius:18px; padding:24px 26px; text-decoration:none; margin-bottom:56px; box-shadow:0 10px 30px rgba(51,102,255,0.18);">
      <div style="flex:1; min-width:0;">
        <div style="font-size:12px; font-weight:700; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">Kostenloser Finder</div>
        <div style="font-size:21px; font-weight:900; color:white; letter-spacing:-0.5px; line-height:1.2;">Unsicher, welchen Schein du brauchst?</div>
        <div style="font-size:15px; color:rgba(255,255,255,0.85); line-height:1.5; margin-top:6px;">3 Fragen beantworten – sofort die richtige Lizenz & das passende Funkzeugnis erfahren.</div>
      </div>
      <span style="flex-shrink:0; background:white; color:#3366FF; font-weight:800; font-size:15px; padding:12px 22px; border-radius:12px; white-space:nowrap;">Finder starten →</span>
    </a>

    <!-- Verfügbar -->
    <section style="margin-bottom:64px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">
        Sportbootführerschein
      </h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:28px;">
        Mit Boatpass lernst du die komplette Theorie – die Detailseiten erklären jeden Schein im Detail.
      </p>
      <div class="license-grid">
        {available.map(c => (
          <a href={c.href} class="license-card">
            <div class="license-icon"><Icon name={c.icon} size={26} stroke="#3366FF" strokeWidth={1.75} /></div>
            <div class="license-title">{c.title}</div>
            <span class="license-tag">{c.tag}</span>
            <div class="license-desc">{c.desc}</div>
            <div class="license-link">Mehr erfahren →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Was ist ein Funkzeugnis -->
    <section style="margin-bottom:64px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Was ist ein Funkzeugnis?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Ein <strong>Funkzeugnis</strong> ist der amtliche Nachweis, der zum Betrieb von Seefunk- oder Binnenfunkanlagen an Bord berechtigt – anders als der Bootsführerschein wird es nur benötigt, wenn tatsächlich ein Funkgerät an Bord ist. In Deutschland gibt es drei Funkzeugnisse: das <a href="/ubi/" style="color:#3366FF; text-decoration:underline;">UBI</a> für UKW-Sprechfunk auf Binnengewässern, das <a href="/src/" style="color:#3366FF; text-decoration:underline;">SRC</a> für UKW-Seefunk mit DSC im Küstenbereich und das <a href="/lrc/" style="color:#3366FF; text-decoration:underline;">LRC</a> für weltweiten Seefunk inklusive Kurz-/Grenzwelle und Satellitenkommunikation.
      </p>
    </section>

    <!-- Bald -->
    <section>
      <h2 class="content-section-title" style="margin-bottom:8px;">
        Bald verfügbar
      </h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:28px;">
        Wir arbeiten an weiteren Lizenzen – Spezialscheine wie das Bodenseeschifferpatent folgen.
      </p>
      <div class:list={["license-grid", { "license-grid--single": soon.length === 1 }]}>
        {soon.map(c => (
          c.href ? (
            <a href={c.href} class="license-card license-card-soon">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon"><Icon name={c.icon} size={26} stroke="#3366FF" strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
              <div class="license-link">Vorschau →</div>
            </a>
          ) : (
            <div class="license-card license-card-soon license-card-disabled">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon"><Icon name={c.icon} size={26} stroke="#3366FF" strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-top:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Häufige Fragen zum Bootsführerschein</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</h3>
            <div style="font-size:15px; color:#6B7280; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Weiterführende Artikel -->
    <section style="margin-top:48px; padding-top:32px; border-top:1px solid rgba(51,102,255,0.1);">
      <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:16px;">Weiterführende Artikel</h3>
      <div class="related-links">
        <a href="/blog/sportbootfuehrerschein-voraussetzungen/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Voraussetzungen für den Sportbootführerschein</a>
        <a href="/blog/kinder-jugendliche-boot-fahren-mindestalter/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Ab wann dürfen Kinder und Jugendliche ein Boot führen?</a>
        <a href="/blog/sportbootfuehrerschein-reform-2026/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Sportbootführerschein-Reform 2026: Was sich ändert und was bleibt</a>
        <a href="/blog/sbf-binnen-vs-see/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF Binnen vs. SBF See – was ist der Unterschied?</a>
        <a href="/blog/motorboot-oder-segelboot-welcher-sbf/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Motorboot oder Segelboot – welcher SBF passt zu dir?</a>
        <a href="/blog/ubi-vs-src-funkschein/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ UBI vs. SRC – welches Funkzeugnis brauche ich?</a>
        <a href="/blog/charterschein-boot-mieten-ohne-fuehrerschein/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Boot mieten ohne Führerschein: der Charterschein</a>
        <a href="/blog/sportkuestenschifferschein-sks/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ Sportküstenschifferschein (SKS): die nächste Stufe nach dem SBF See</a>
        <a href="/blog/sbf-im-ausland-gueltig/" style="color:#3366FF; text-decoration:none; font-size:15px;">→ SBF im Ausland gültig? Kroatien, Niederlande & Italien</a>
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  .license-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  /* Eine einzelne "Bald"-Karte nicht in ein 2-Spalten-Raster zwingen – sonst
     bleibt die zweite Zelle leer und die Sektion wirkt unfertig (asymmetrisches
     Alignment neben der leeren Zelle). Bei genau einer Karte einspaltig und auf
     die Breite einer regulären Lizenz-Karte begrenzt ((952px − 20px Gap)/2),
     links ausgerichtet. Wächst die Liste, greift wieder das 2-Spalten-Raster;
     schmaler als 466px schrumpft die Spalte automatisch auf die volle Breite
     (Mobile unverändert). Reiner Layout-Feinschliff, Corporate Design unberührt. */
  .license-grid--single { grid-template-columns: minmax(0, 466px); }
  .license-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 20px;
    padding: 28px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .license-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(26,31,54,0.10);
    border-color: rgba(51,102,255,0.28);
  }
  .license-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(51,102,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .license-title {
    font-size: 20px;
    font-weight: 800;
    color: #1A1F36;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }
  .license-tag {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    color: #3366FF;
    background: rgba(51,102,255,0.08);
    border: 1px solid rgba(51,102,255,0.16);
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 12px;
  }
  .license-desc {
    font-size: 15px;
    color: #6B7280;
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }
  .license-link {
    font-size: 14px;
    font-weight: 700;
    color: #3366FF;
  }

  /* "Bald"-Karten optisch gedämpft */
  .license-card-soon { background: rgba(255,255,255,0.6); }
  .license-soon-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    font-size: 11px;
    font-weight: 700;
    color: #b45309;
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.3);
    padding: 3px 10px;
    border-radius: 100px;
  }
  /* Karten ohne Zielseite: sichtbar, aber nicht klickbar */
  .license-card-disabled { opacity: 0.6; cursor: default; }
  .license-card-disabled:hover {
    transform: none;
    box-shadow: none;
    border-color: rgba(51,102,255,0.10);
  }

  @media (max-width: 640px) {
    .license-grid { grid-template-columns: 1fr; }
  }

  html.dark .license-card {
    background: #181E2E;
    border-color: rgba(90, 120, 255, 0.14);
  }
  html.dark .license-card:hover {
    border-color: rgba(90, 120, 255, 0.32);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
  }
  html.dark .license-card-soon { background: rgba(24, 30, 46, 0.6); }
  html.dark .license-title { color: #E2E8F0; }
  html.dark .license-desc  { color: #94A3B8; }
</style>
