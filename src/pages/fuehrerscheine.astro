---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageLayout from '../components/page/PageLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';
import { priceText } from '../data/stores';

// Verfügbare Führerscheine/Themenseiten – verlinken auf die bestehenden Detailseiten
const available = [
  {
    icon: 'waves' as IconName,
    title: 'SBF Binnen',
    tag: 'Flüsse, Kanäle & Seen',
    desc: 'Der Sportbootführerschein für Binnengewässer – Flüsse, Kanäle und Seen. Pflicht ab 15 PS.',
    href: '/sbf-binnen/',
  },
  {
    icon: 'sailboat' as IconName,
    title: 'SBF See',
    tag: 'Nord- & Ostsee',
    desc: 'Der Schein für Küstengewässer von Nord- und Ostsee. Eigene Prüfung mit Navigationsaufgabe.',
    href: '/sbf-see/',
  },
  {
    icon: 'banknotes' as IconName,
    title: 'SBF Kosten',
    tag: 'Gebühren & Spartipps',
    desc: 'Prüfungsgebühren, Kurs und Praxis im Überblick – und wie du beim Lernen clever sparst.',
    href: '/sbf-kosten/',
  },
  {
    icon: 'document' as IconName,
    title: 'Prüfung & Ablauf',
    tag: 'Theorie & Praxis',
    desc: 'Wie Theorie- und Praxisprüfung ablaufen, wie du dich anmeldest und was am Prüfungstag zählt.',
    href: '/sbf-pruefung-ablauf/',
  },
  {
    icon: 'phone' as IconName,
    title: 'UBI',
    tag: 'UKW-Sprechfunk Binnen',
    desc: 'Das UKW-Sprechfunkzeugnis für die Binnenschifffahrt – jetzt als Modul in der App, einmalig ' + priceText('ubi', 'de') + '.',
    href: '/ubi/',
  },
  {
    icon: 'satellite' as IconName,
    title: 'SRC',
    tag: 'Seefunk Küste',
    desc: 'Das Short Range Certificate – UKW-Seefunkzeugnis (Kurzstrecke) für Küstengewässer – jetzt als Modul in der App, einmalig ' + priceText('src', 'de') + '.',
    href: '/src/',
  },
  {
    icon: 'globe' as IconName,
    title: 'LRC',
    tag: 'Seefunk weltweit',
    desc: 'Das Allgemeine Funkbetriebszeugnis für weltweiten Seefunk (UKW, Grenz-/Kurzwelle, Satellit) – jetzt als Modul in der App, einmalig ' + priceText('lrc', 'de') + '.',
    href: '/lrc/',
  },
];

// "Bald"-Themen – Bodensee noch ohne eigene Seite (nicht klickbar)
const soon = [
  { icon: 'anchor' as IconName, title: 'Bodenseeschifferpatent', desc: 'Pflichtschein für den Bodensee.', href: null },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Führerscheine", "item": "https://boatpass.de/fuehrerscheine/" },
  ],
};

const faqs = [
  {
    q: 'Welchen Bootsführerschein brauche ich?',
    a: 'Das hängt vom Revier und der Motorleistung ab: Auf Flüssen, Kanälen und Seen brauchst du ab 11,03 kW (15 PS) den SBF Binnen, auf Nord- und Ostsee den SBF See. Ist ein Funkgerät an Bord, kommt je nach Revier zusätzlich UBI, SRC oder LRC hinzu. Der kostenlose Finder oben zeigt dir in 3 Fragen die passende Kombination.',
  },
  {
    q: 'Was kostet ein Bootsführerschein?',
    a: 'Die amtlichen Prüfungsgebühren liegen 2026 bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Mit komplettem Vorbereitungskurs kommen meist 500–650 € pro Schein dazu; wer die Theorie selbst lernt – etwa mit Boatpass für 9,99 € pro Katalog – spart den Großteil davon.',
  },
  {
    q: 'Muss ich für den Bootsführerschein einen Kurs besuchen?',
    a: 'Nein, ein Kurs ist für die Theorie nicht vorgeschrieben. Der amtliche ELWIS-Fragenkatalog ist frei zugänglich, sodass du eigenständig lernen kannst – etwa mit einer App wie Boatpass. Für die praktische Prüfung ist meist trotzdem etwas Übung auf dem Wasser sinnvoll.',
  },
  {
    q: 'Brauche ich zusätzlich zum Bootsführerschein ein Funkzeugnis?',
    a: 'Nur wenn ein Funkgerät an Bord ist: Auf Binnengewässern reicht dafür das UBI, auf See das SRC für Kurzstrecke oder das LRC für weltweiten Funk. Ohne Funkgerät an Bord ist kein zusätzliches Funkzeugnis nötig.',
  },
  {
    q: 'Kann ich ein Boot auch ohne Führerschein fahren?',
    a: 'Ja, mit dem Charterschein darfst du auf ausgewiesenen Binnengewässern wie der Mecklenburgischen Seenplatte ein gemietetes Boot ohne SBF führen. Ganz ohne jeden Schein sind zudem Boote bis 11,03 kW (15 PS) erlaubt.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist ein Funkzeugnis?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "Funkzeugnis",
  "description": "Ein Funkzeugnis ist der amtliche Nachweis, der zum Betrieb von Seefunk- oder Binnenfunkanlagen an Bord berechtigt – anders als der Bootsführerschein wird es nur benötigt, wenn tatsächlich ein Funkgerät an Bord ist. In Deutschland gibt es drei Funkzeugnisse: UBI, SRC und LRC.",
  "url": "https://boatpass.de/fuehrerscheine/",
  "inLanguage": "de",
};
---

<BaseLayout
  title="Bootsführerscheine: welcher passt zu dir?"
  description="Alle Bootsführerscheine auf einen Blick: SBF Binnen, SBF See, Kosten und Prüfungsablauf – plus Sprechfunkzeugnisse UBI und SRC. Finde den richtigen Schein."
  lang="de"
  altUrl="https://boatpass.de/en/licenses/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und breite Spalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Alle Lizenzen"
    lede="Ob Binnengewässer oder Küste, Motorboot oder Funk an Bord – hier findest du die richtige Lizenz und alles, was du für die Vorbereitung wissen musst."
  >
    Welche Lizenz<br />passt zu dir?
  </PageHead>

  <PageLayout variant="wide">

    <!-- Konfigurator-Banner -->
    <a href="/tools/welcher-bootsfuehrerschein/" class="pg-banner">
      <span class="pg-banner-text">
        <span class="pg-eyebrow">Kostenloser Finder</span>
        <span class="pg-banner-title">Unsicher, welchen Schein du brauchst?</span>
        <span class="pg-banner-sub">3 Fragen beantworten – sofort die richtige Lizenz & das passende Funkzeugnis erfahren.</span>
      </span>
      <span class="h-btn h-btn--sm pg-banner-cta">Finder starten<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></span>
    </a>

    <!-- Verfügbar -->
    <section class="pg-section">
      <h2 class="pg-h2">
        Sportbootführerschein
      </h2>
      <p class="pg-p">
        Mit Boatpass lernst du die komplette Theorie – die Detailseiten erklären jeden Schein im Detail.
      </p>
      <div class="license-grid">
        {available.map(c => (
          <a href={c.href} class="license-card">
            <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
            <div class="license-title">{c.title}</div>
            <span class="license-tag">{c.tag}</span>
            <div class="license-desc">{c.desc}</div>
            <div class="license-link">Mehr erfahren<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
          </a>
        ))}
      </div>
    </section>

    <!-- Was ist ein Funkzeugnis -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist ein Funkzeugnis?</h2>
      <p class="pg-p">
        Ein <strong>Funkzeugnis</strong> ist der amtliche Nachweis, der zum Betrieb von Seefunk- oder Binnenfunkanlagen an Bord berechtigt – anders als der Bootsführerschein wird es nur benötigt, wenn tatsächlich ein Funkgerät an Bord ist. In Deutschland gibt es drei Funkzeugnisse: das <a href="/ubi/" class="pg-inline-link">UBI</a> für UKW-Sprechfunk auf Binnengewässern, das <a href="/src/" class="pg-inline-link">SRC</a> für UKW-Seefunk mit DSC im Küstenbereich und das <a href="/lrc/" class="pg-inline-link">LRC</a> für weltweiten Seefunk inklusive Kurz-/Grenzwelle und Satellitenkommunikation.
      </p>
    </section>

    <!-- Bald -->
    <section>
      <h2 class="pg-h2">
        Bald verfügbar
      </h2>
      <p class="pg-p">
        Wir arbeiten an weiteren Lizenzen – Spezialscheine wie das Bodenseeschifferpatent folgen.
      </p>
      <div class:list={["license-grid", { "license-grid--single": soon.length === 1 }]}>
        {soon.map(c => (
          c.href ? (
            <a href={c.href} class="license-card license-card-soon">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
              <div class="license-link">Vorschau<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
            </a>
          ) : (
            <div class="license-card license-card-soon license-card-disabled">
              <span class="license-soon-badge">bald</span>
              <div class="license-icon"><Icon name={c.icon} size={26} strokeWidth={1.75} /></div>
              <div class="license-title">{c.title}</div>
              <div class="license-desc">{c.desc}</div>
            </div>
          )
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum Bootsführerschein</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Weiterführende Artikel -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Artikel</h2>
      <ul class="pg-related">
        <li><a href="/blog/sportbootfuehrerschein-voraussetzungen/">Voraussetzungen für den Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sehtest-sportbootfuehrerschein-anforderungen-ablauf/">Sehtest für den Sportbootführerschein – Anforderungen und Ablauf<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/kinder-jugendliche-boot-fahren-mindestalter/">Ab wann dürfen Kinder und Jugendliche ein Boot führen?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sportbootfuehrerschein-reform-2026/">Sportbootführerschein-Reform 2026: Was sich ändert und was bleibt<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sportbootfuehrerschein-verloren-beschaedigt-ersatz/">Sportbootführerschein verloren oder beschädigt – so bekommst du Ersatz<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-binnen-vs-see/">SBF Binnen vs. SBF See – was ist der Unterschied?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/motorboot-oder-segelboot-welcher-sbf/">Motorboot oder Segelboot – welcher SBF passt zu dir?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-vs-src-funkschein/">UBI vs. SRC – welches Funkzeugnis brauche ich?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/charterschein-boot-mieten-ohne-fuehrerschein/">Boot mieten ohne Führerschein: der Charterschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sportkuestenschifferschein-sks/">Sportküstenschifferschein (SKS): die nächste Stufe nach dem SBF See<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-im-ausland-gueltig/">SBF im Ausland gültig? Kroatien, Niederlande & Italien<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

