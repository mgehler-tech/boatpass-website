---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import type { IconName } from '../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "LRC Seefunk", "item": "https://boatpass.de/lrc/" },
  ],
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für das LRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "LRC Prüfungsvorbereitung – Long Range Certificate",
  "description": "Vorbereitung auf die Prüfung zum Long Range Certificate (LRC), dem allgemeinen Funkbetriebszeugnis für den weltweiten Seefunk (UKW, Grenz-/Kurzwelle, Satellit) – mit dem amtlichen ELWIS-Fragenkatalog (76 Fragen), Prüfungssimulation und Fehler-Training.",
  "url": "https://boatpass.de/lrc/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Advanced",
  "teaches": [
    "Seefunk über UKW, Grenz- und Kurzwelle",
    "Satellitenfunk im GMDSS (Inmarsat, EPIRB, SART)",
    "Not-, Dringlichkeits- und Sicherheitsverkehr",
    "Funkvorschriften und Seegebiete A1–A4",
    "Seefunk-Englisch und Buchstabiertafel",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "9.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

const faqs = [
  {
    q: 'Wie läuft die LRC-Prüfung ab?',
    a: 'In der Theorie beantwortest du einen Fragebogen mit 14 LRC-Fragen in 20 Minuten – bestanden ab 11 richtigen Antworten. Wer noch kein SRC besitzt, bearbeitet zusätzlich den SRC-Fragebogen mit 24 Fragen. Dazu kommen ein Englisch-Diktat mit Übersetzung und ein praktischer Teil an den GMDSS-Geräten. Boatpass trainiert den amtlichen LRC-Fragenkatalog mit 76 Fragen.',
  },
  {
    q: 'Was ist der Unterschied zwischen LRC und SRC?',
    a: 'Das SRC gilt nur für den UKW-Seefunk im Küstenbereich (Seegebiet A1). Das LRC ist das höchste Seefunkzeugnis der Sportschifffahrt und gilt weltweit in allen Seegebieten A1–A4 – über UKW, Grenz- und Kurzwelle sowie über Satellit. Das LRC schließt den Funktionsumfang des SRC vollständig mit ein.',
  },
  {
    q: 'Was kostet das LRC?',
    a: 'Die amtliche Prüfungsgebühr für das LRC variiert je nach Verband und Bundesland und liegt bei rund 188–207 €. Ein optionaler Vorbereitungskurs kostet zusätzlich etwa 300–500 €, ist aber nicht vorgeschrieben. Diese Gebühren sind unabhängig vom Boatpass LRC-Lernmodul (einmalig 9,99 €).',
  },
  {
    q: 'Ab welchem Alter kann ich das LRC machen?',
    a: 'Den Antrag auf das LRC kannst du ab 18 Jahren stellen; am Prüfungstag musst du mindestens 17 Jahre und 9 Monate alt sein. Das LRC wird von den Prüfungsausschüssen des DSV und DMYV abgenommen und ist international anerkannt sowie zeitlich unbegrenzt gültig.',
  },
  {
    q: 'Brauche ich erst das SRC, bevor ich das LRC mache?',
    a: 'Nein. Wer kein SRC besitzt, bearbeitet in der LRC-Prüfung zusätzlich den SRC-Fragebogen mit 24 Fragen. Das LRC schließt den kompletten Funktionsumfang des SRC ein, du brauchst es also nicht vorab separat zu erwerben.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'UKW & Betriebsverfahren', desc: 'Seefunk, DSC, Sprechprozeduren & GMDSS-Überblick', count: 19, icon: 'microphone', color: '#EA580C', bg: 'rgba(234,88,12,0.10)' },
  { name: 'Grenz- & Kurzwelle', desc: 'MF/HF-Funk, NAVTEX & Übertragungsverfahren', count: 15, icon: 'wifi', color: '#7C3AED', bg: 'rgba(124,58,237,0.10)' },
  { name: 'Satellitenfunk', desc: 'GMDSS-Satellit, Inmarsat, EPIRB & SART', count: 13, icon: 'satellite', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Not- & Sicherheitsverkehr', desc: 'Mayday, Distress-DSC & SAR-Koordination', count: 11, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Funkvorschriften', desc: 'ITU VO Funk, Seegebiete A1–A4 & Zertifizierung', count: 10, icon: 'scale', color: '#1D4ED8', bg: 'rgba(29,78,216,0.10)' },
  { name: 'Englisch & Phonetik', desc: 'Seenot-Englisch, Buchstabiertafel & Notrufe', count: 8, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
];
---

<BaseLayout
  title="LRC Lernapp – Long Range Certificate (Allgemeines Funkbetriebszeugnis) lernen"
  description="Alles zum LRC (Long Range Certificate / Allgemeines Funkbetriebszeugnis): Prüfungsaufbau, Inhalte, Kosten und Vorbereitung. Boatpass LRC-Modul jetzt in der App – einmalig 9,99 €."
  lang="de"
  altUrl="https://boatpass.de/en/lrc/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.2); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Long Range Certificate · Seefunk weltweit
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        LRC lernen –<br>Allgemeines Funkbetriebszeugnis
      </h1>
      <p style="font-size:18px; color:#6B7280; line-height:1.65; max-width:580px; margin:0 auto 36px;">
        Das Long Range Certificate (LRC) ist das höchste Seefunkzeugnis der Sportschifffahrt – gültig für UKW, Grenz- und Kurzwelle sowie Satellitenfunk in allen Seegebieten weltweit.
      </p>

      <!-- Verfügbar Badge -->
      <div style="display:inline-flex; align-items:center; gap:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#047857; font-size:14px; font-weight:700; padding:10px 20px; border-radius:14px; margin-bottom:24px;">
        <Icon name="check" size={17} stroke="#047857" strokeWidth={2.5} />
        Boatpass LRC-Modul – jetzt verfügbar · einmalig 9,99 €
      </div>
      <br/>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:15px; padding:14px 28px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2); margin-top:16px;">
        ▶&nbsp;Jetzt LRC lernen in der App
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">Auf den Punkt</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          Das LRC (Long Range Certificate) ist das höchste Seefunkzeugnis der Sportschifffahrt und gilt weltweit für UKW, Grenz- und Kurzwelle sowie Satellitenfunk (alle Seegebiete A1–A4). Es baut auf dem SRC auf: In der Theorie wird ein Fragebogen mit 14 LRC-Fragen in 20 Minuten beantwortet – bestanden ab 11 richtigen Antworten. Wer kein SRC besitzt, bearbeitet zusätzlich den SRC-Fragebogen (24 Fragen). Dazu kommen Englisch-Diktat mit Übersetzung und ein praktischer Teil. Boatpass trainiert den amtlichen LRC-Fragenkatalog (76 Fragen) mit Prüfungssimulation und Fehler-Training.
        </p>
      </div>
    </section>

    <!-- Was ist LRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Was ist das LRC?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Das <strong>Long Range Certificate (LRC)</strong> – auf Deutsch <em>Allgemeines Funkbetriebszeugnis</em> – ist die amtliche Erlaubnis zur uneingeschränkten Teilnahme am weltweiten Seefunkdienst im GMDSS (Global Maritime Distress and Safety System). Es berechtigt zum Funk über <strong>UKW, Grenzwelle und Kurzwelle</strong> sowie über <strong>Satellit</strong> – also auch fernab der Küste auf hoher See.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Damit ist das LRC das <strong>höchste Seefunkzeugnis der Sportschifffahrt</strong>. Es wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) und des Deutschen Motoryachtverbands (DMYV) abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="de" only="lrc" />
    </section>

    <!-- Wer braucht es -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Wer braucht das LRC?</h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {([
          { icon: 'waves', title: 'Hochsee & Blauwasser', desc: 'Hochsee- und Blauwassersegler, die außerhalb der UKW-Reichweite (Seegebiete A2–A4) unterwegs sind' },
          { icon: 'satellite', title: 'Grenz- & Kurzwellenfunk', desc: 'Wer Grenz-/Kurzwellenfunk oder Satellitenkommunikation (z. B. Inmarsat) an Bord nutzt' },
          { icon: 'compass', title: 'Langfahrt & Atlantik', desc: 'Skipper auf Langfahrt, Atlantiküberquerung oder Weltumseglung' },
          { icon: 'anchor', title: 'Weltweites Zeugnis', desc: 'Wer ein uneingeschränktes, weltweit gültiges Seefunkzeugnis statt des küstennahen SRC möchte' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={item.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{item.title}</div>
              <div style="font-size:14px; color:#4B5563; line-height:1.6;">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- LRC vs SRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">LRC vs. SRC: Was ist der Unterschied?</h2>
      <div class="lrc-compare-grid">
        <div style="background:white; border:2px solid rgba(51,102,255,0.2); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">LRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Long Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Weltweit (Seegebiete A1–A4)</li>
            <li>✓ UKW + Grenz-/Kurzwelle</li>
            <li>✓ Satellitenfunk (GMDSS)</li>
            <li>✓ Uneingeschränkt gültig</li>
          </ul>
        </div>
        <div style="background:white; border:2px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-weight:800; color:#1A1F36; margin-bottom:4px;">SRC</div>
          <div style="font-size:13px; color:#3366FF; margin-bottom:12px;">Short Range Certificate</div>
          <ul style="list-style:none; padding:0; margin:0; font-size:14px; color:#4B5563; line-height:1.8;">
            <li>✓ Küstenbereich (Seegebiet A1)</li>
            <li>✓ Nur UKW-Seefunk</li>
            <li>✗ Keine Grenz-/Kurzwelle</li>
            <li>✗ Kein Satellitenfunk</li>
          </ul>
        </div>
      </div>
      <p style="font-size:14px; color:#9CA3AF; margin-top:12px; line-height:1.6;">
        Für die meisten Küstenreviere reicht das <a href="/src/" style="color:#3366FF; text-decoration:none;">SRC</a>. Wer jedoch auf hoher See funken will, braucht das LRC – es schließt den Funktionsumfang des SRC vollständig mit ein.
      </p>
    </section>

    <!-- Prüfungsaufbau -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">LRC-Prüfung: Aufbau & Inhalte</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theorie</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Schriftlich<br>Multiple Choice (SRC- + LRC-Bogen)</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Englisch</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Notrufe empfangen & übersetzen<br>Texte senden (Phonetik)</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Praxis</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">Bedienung GMDSS-Geräte<br>DSC, Grenz-/Kurzwelle, Satellit</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Mindestalter</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">18 Jahre (Antrag)<br>am Prüfungstag ≥ 17 J. 9 Mon.</div>
        </div>
      </div>
      <div style="background:rgba(51,102,255,0.05); border:1px solid rgba(51,102,255,0.15); border-radius:14px; padding:20px;">
        <p style="font-size:15px; color:#4B5563; line-height:1.7; margin:0;">
          <strong style="color:#1A1F36;">Prüfungsthemen:</strong> GMDSS-System und Seegebiete A1–A4, UKW-/Grenz-/Kurzwellen-Seefunk, DSC-Verfahren (Digital Selective Calling), Satellitenfunk (Inmarsat), NAVTEX, Not-, Dringlichkeits- und Sicherheitsverkehr, internationales Seenot-Englisch und Buchstabiertafel sowie die Funkvorschriften der ITU (VO Funk).
        </p>
      </div>
    </section>

    <!-- Praxis-Brücke: Angst vorm Sprechfunk nehmen -->
    <PracticeBridge variant="radio" />

    <!-- Kosten -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Was kostet das LRC?</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:24px;">
        Für die amtliche LRC-Prüfung fällt eine Gebühr für Zulassung, Prüfung und Erteilung des Zeugnisses an:
      </p>
      <div style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; overflow:hidden;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px; border-bottom:1px solid rgba(51,102,255,0.08);">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Zulassung, Prüfung & Erteilung</div>
            <div style="font-size:13px; color:#6B7280; line-height:1.5;">Amtliche Gebühr über DSV / DMYV (Theorie + Praxis + Zeugnis)</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">ca. 188 €</div>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:18px 24px;">
          <div>
            <div style="font-size:15px; font-weight:700; color:#1A1F36; margin-bottom:2px;">Vorbereitungskurs (optional)</div>
            <div style="font-size:13px; color:#6B7280; line-height:1.5;">Funkschule mit Lernmaterial & Praxistraining</div>
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; white-space:nowrap;">ca. 300–500 €</div>
        </div>
      </div>
      <p style="font-size:13px; color:#9CA3AF; line-height:1.6; margin-top:12px;">
        Die genaue Prüfungsgebühr variiert je nach Verband und Bundesland (ca. 188–207 €). Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du auch eigenständig mit dem offiziellen Fragenkatalog lernen. Diese amtlichen Gebühren sind unabhängig vom Boatpass LRC-Lernmodul (einmalig 9,99 €).
      </p>
    </section>

    <!-- So hilft Boatpass beim LRC -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">So hilft Boatpass beim LRC</h2>
      <div style="display:flex; flex-direction:column; gap:16px;">
        {([
          { icon: 'book', title: 'Vollständiger LRC-Fragenkatalog', desc: 'Alle offiziellen LRC-Fragen – inklusive SRC-Teil und LRC-Erweiterung – immer aktuell.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Übe unter echten Bedingungen: schriftliche Theorieprüfung mit Bestehensgrenze und Zeitdruck.' },
          { icon: 'refresh', title: 'Fehler-Training', desc: 'Nur deine Schwachstellen üben – kein Zeitverlust mit bereits Gelerntem.' },
          { icon: 'chart', title: 'Fortschritt nach Kategorie', desc: 'Sieh, welche LRC-Themen du sicher beherrschst und wo noch Lücken sind.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div style="display:flex; align-items:flex-start; gap:16px; background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:20px;">
            <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <Icon name={f.icon} size={21} stroke="#3366FF" strokeWidth={1.75} />
            </span>
            <div>
              <div style="font-weight:700; color:#1A1F36; margin-bottom:4px;">{f.title}</div>
              <div style="font-size:15px; color:#6B7280; line-height:1.6;">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Lernen nach Kategorie</h2>
      <p style="font-size:16px; color:#6B7280; line-height:1.6; margin-bottom:20px;">
        Der LRC-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
        Quelle: amtlicher Fragenkatalog auf <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" style="color:#3366FF; text-decoration:underline;">elwis.de</a>.
      </p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map(c => (
          <div style="display:flex; align-items:center; gap:14px; background:white; border:1px solid rgba(0,0,0,0.07); border-radius:14px; padding:14px 18px;">
            <span style={`width:40px; height:40px; border-radius:11px; background:${c.bg}; display:flex; align-items:center; justify-content:center; flex-shrink:0;`}>
              <Icon name={c.icon} size={20} stroke={c.color} strokeWidth={1.75} />
            </span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:700; color:#1A1F36; line-height:1.3;">{c.name}</div>
              <div style="font-size:12px; color:#9CA3AF; line-height:1.4; margin-top:2px;">{c.desc}</div>
            </div>
