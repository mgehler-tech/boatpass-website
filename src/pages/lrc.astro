---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import Icon from '../components/Icon.astro';
import PracticeBridge from '../components/PracticeBridge.astro';
import CatalogSources from '../components/CatalogSources.astro';
import type { IconName } from '../icons';
import PlatformPrice from '../components/PlatformPrice.astro';
import { PLAY_STORE_URL, minPrice, priceText, schemaOffers } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "LRC Seefunk", "item": "https://boatpass.de/lrc/" },
  ],
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für das LRC.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "LRC Prüfungsvorbereitung – Long Range Certificate",
  "description": "Vorbereitung auf die Prüfung zum Long Range Certificate (LRC), dem allgemeinen Funkbetriebszeugnis für den weltweiten Seefunk (UKW, Grenz-/Kurzwelle, Satellit) – mit dem amtlichen ELWIS-Fragenkatalog (76 Fragen), Prüfungssimulation und Fehlertraining.",
  "url": "https://boatpass.de/lrc/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Advanced",
  "teaches": [
    "Seefunk über UKW, Grenz- und Kurzwelle",
    "Satellitenfunk im GMDSS (Inmarsat, EPIRB, SART)",
    "Not-, Dringlichkeits- und Sicherheitsverkehr",
    "Funkvorschriften und Seegebiete A1–A4",
    "Seefunk-Englisch und Buchstabiertafel",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('lrc'),
};

const faqs = [
  {
    q: 'Wie läuft die LRC-Prüfung ab?',
    a: 'In der Theorie beantwortest du einen Fragebogen mit 14 LRC-Fragen in 20 Minuten – bestanden ab 11 richtigen Antworten. Wer noch kein SRC besitzt, bearbeitet zusätzlich den SRC-Fragebogen mit 24 Fragen. Dazu kommen ein Englisch-Diktat mit Übersetzung und ein praktischer Teil an den GMDSS-Geräten. Boatpass trainiert den amtlichen LRC-Fragenkatalog mit 76 Fragen.',
  },
  {
    q: 'Was ist der Unterschied zwischen LRC und SRC?',
    a: 'Das SRC gilt nur für den UKW-Seefunk im Küstenbereich (Seegebiet A1). Das LRC ist das höchste Seefunkzeugnis der Sportschifffahrt und gilt weltweit in allen Seegebieten A1–A4 – über UKW, Grenz- und Kurzwelle sowie über Satellit. Das LRC schließt den Funktionsumfang des SRC vollständig mit ein.',
  },
  {
    q: 'Was kostet das LRC?',
    a: 'Die amtliche Prüfungsgebühr für das LRC variiert je nach Verband und Bundesland und liegt bei rund 188–207 €. Ein optionaler Vorbereitungskurs kostet zusätzlich etwa 300–500 €, ist aber nicht vorgeschrieben. Diese Gebühren sind unabhängig vom Boatpass LRC-Lernmodul (einmalig ' + priceText('lrc', 'de') + ').',
  },
  {
    q: 'Ab welchem Alter kann ich das LRC machen?',
    a: 'Den Antrag auf das LRC kannst du ab 18 Jahren stellen; am Prüfungstag musst du mindestens 17 Jahre und 9 Monate alt sein. Das LRC wird von den Prüfungsausschüssen des DSV und DMYV abgenommen und ist international anerkannt sowie zeitlich unbegrenzt gültig.',
  },
  {
    q: 'Brauche ich erst das SRC, bevor ich das LRC mache?',
    a: 'Nein. Wer kein SRC besitzt, bearbeitet in der LRC-Prüfung zusätzlich den SRC-Fragebogen mit 24 Fragen. Das LRC schließt den kompletten Funktionsumfang des SRC ein, du brauchst es also nicht vorab separat zu erwerben.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist das LRC?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "LRC",
  "alternateName": "Long Range Certificate",
  "description": "Das Long Range Certificate (LRC) ist die amtliche Erlaubnis zur uneingeschränkten Teilnahme am weltweiten Seefunkdienst im GMDSS. Es berechtigt zum Funk über UKW, Grenzwelle und Kurzwelle sowie über Satellit und ist das höchste Seefunkzeugnis der Sportschifffahrt.",
  "url": "https://boatpass.de/lrc/",
  "inLanguage": "de",
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'UKW & Betriebsverfahren', desc: 'Seefunk, DSC, Sprechprozeduren & GMDSS-Überblick', count: 19, icon: 'microphone' },
  { name: 'Grenz- & Kurzwelle', desc: 'MF/HF-Funk, NAVTEX & Übertragungsverfahren', count: 15, icon: 'wifi' },
  { name: 'Satellitenfunk', desc: 'GMDSS-Satellit, Inmarsat, EPIRB & SART', count: 13, icon: 'satellite' },
  { name: 'Not- & Sicherheitsverkehr', desc: 'Mayday, Distress-DSC & SAR-Koordination', count: 11, icon: 'shield' },
  { name: 'Funkvorschriften', desc: 'ITU VO Funk, Seegebiete A1–A4 & Zertifizierung', count: 10, icon: 'scale' },
  { name: 'Englisch & Phonetik', desc: 'Seenot-Englisch, Buchstabiertafel & Notrufe', count: 8, icon: 'document' },
];
---

<BaseLayout
  title="LRC Funkzeugnis Lernapp – Long Range Certificate"
  description={`LRC-Funkzeugnis lernen: Prüfungsaufbau, Inhalte und Kosten im Überblick. Boatpass LRC-Modul einmalig ab ${minPrice(['lrc'], 'de')} mit Prüfungssimulation – jetzt starten.`}
  lang="de"
  altUrl="https://boatpass.de/en/lrc/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Long Range Certificate · Seefunk weltweit"
    lede="Das Long Range Certificate (LRC) ist das höchste Seefunkzeugnis der Sportschifffahrt – gültig für UKW, Grenz- und Kurzwelle sowie Satellitenfunk in allen Seegebieten weltweit."
    ctaLabel="Jetzt LRC lernen in der App"
    cta
  >
    LRC lernen –<br />Allgemeines Funkbetriebszeugnis
    <span slot="badge">Boatpass LRC-Modul – jetzt verfügbar · einmalig&nbsp;<PlatformPrice product="lrc" lang="de" /></span>
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="lrc"
      items={[
        { k: 'Fragenkatalog', v: '76 Fragen' },
        { k: 'Theorie', v: '20 Min, bestanden ab 11 richtig' },
        { k: 'Praxis', v: 'Bedienung GMDSS-Geräte' },
        { k: 'Prüfungsgebühr', v: 'ca. 188–207 €' },
        { k: 'Mindestalter', v: '18 Jahre (Antrag)' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Das LRC (Long Range Certificate) ist das höchste Seefunkzeugnis der Sportschifffahrt und gilt weltweit für UKW, Grenz- und Kurzwelle sowie Satellitenfunk (alle Seegebiete A1–A4). Es baut auf dem SRC auf: In der Theorie wird ein Fragebogen mit 14 LRC-Fragen in 20 Minuten beantwortet – bestanden ab 11 richtigen Antworten. Wer kein SRC besitzt, bearbeitet zusätzlich den SRC-Fragebogen (24 Fragen). Dazu kommen Englisch-Diktat mit Übersetzung und ein praktischer Teil. Boatpass trainiert den amtlichen LRC-Fragenkatalog (76 Fragen) mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist das LRC?</h2>
      <p class="pg-p">
        Das <strong>Long Range Certificate (LRC)</strong> – auf Deutsch <em>Allgemeines Funkbetriebszeugnis</em> – ist die amtliche Erlaubnis zur uneingeschränkten Teilnahme am weltweiten Seefunkdienst im GMDSS (Global Maritime Distress and Safety System). Es berechtigt zum Funk über <strong>UKW, Grenzwelle und Kurzwelle</strong> sowie über <strong>Satellit</strong> – also auch fernab der Küste auf hoher See.
      </p>
      <p class="pg-p">
        Damit ist das LRC das <strong>höchste Seefunkzeugnis der Sportschifffahrt</strong>. Es wird von den Prüfungsausschüssen des Deutschen Segler-Verbands (DSV) und des Deutschen Motoryachtverbands (DMYV) abgenommen, ist international anerkannt und zeitlich unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section class="pg-section">
      <CatalogSources lang="de" only="lrc" />
    </section>

    <!-- Wer braucht es -->
    <section class="pg-section">
      <h2 class="pg-h2">Wer braucht das LRC?</h2>
      <div class="pg-rows">
        {([
          { icon: 'waves', title: 'Hochsee & Blauwasser', desc: 'Hochsee- und Blauwassersegler, die außerhalb der UKW-Reichweite (Seegebiete A2–A4) unterwegs sind' },
          { icon: 'satellite', title: 'Grenz- & Kurzwellenfunk', desc: 'Wer Grenz-/Kurzwellenfunk oder Satellitenkommunikation (z. B. Inmarsat) an Bord nutzt' },
          { icon: 'compass', title: 'Langfahrt & Atlantik', desc: 'Skipper auf Langfahrt, Atlantiküberquerung oder Weltumseglung' },
          { icon: 'anchor', title: 'Weltweites Zeugnis', desc: 'Wer ein uneingeschränktes, weltweit gültiges Seefunkzeugnis statt des küstennahen SRC möchte' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(item => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={item.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{item.title}</p>
              <p class="pg-row-text">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- LRC vs SRC -->
    <section class="pg-section">
      <h2 class="pg-h2">LRC vs. SRC: Was ist der Unterschied?</h2>
      <div class="lrc-compare-grid">
        <div class="pg-card pg-card--current">
          <p class="pg-card-title">LRC</p>
          <p class="pg-card-sub">Long Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Weltweit (Seegebiete A1–A4)</li>
            <li>✓ UKW + Grenz-/Kurzwelle</li>
            <li>✓ Satellitenfunk (GMDSS)</li>
            <li>✓ Uneingeschränkt gültig</li>
          </ul>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">SRC</p>
          <p class="pg-card-sub">Short Range Certificate</p>
          <ul class="pg-checklist">
            <li>✓ Küstenbereich (Seegebiet A1)</li>
            <li>✓ Nur UKW-Seefunk</li>
            <li>✗ Keine Grenz-/Kurzwelle</li>
            <li>✗ Kein Satellitenfunk</li>
          </ul>
        </div>
      </div>
      <p class="pg-note pg-note--after">
        Für die meisten Küstenreviere reicht das <a href="/src/" class="pg-inline-link">SRC</a>. Wer jedoch auf hoher See funken will, braucht das LRC – es schließt den Funktionsumfang des SRC vollständig mit ein.
      </p>
    </section>

    <!-- Prüfungsaufbau -->
    <section class="pg-section">
      <h2 class="pg-h2">LRC-Prüfung: Aufbau & Inhalte</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theorie</p>
          <p class="pg-card-text">Schriftlich<br>Multiple Choice (SRC- + LRC-Bogen)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Englisch</p>
          <p class="pg-card-text">Notrufe empfangen & übersetzen<br>Texte senden (Phonetik)</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Praxis</p>
          <p class="pg-card-text">Bedienung GMDSS-Geräte<br>DSC, Grenz-/Kurzwelle, Satellit</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Mindestalter</p>
          <p class="pg-card-text">18 Jahre (Antrag)<br>am Prüfungstag ≥ 17 J. 9 Mon.</p>
        </div>
      </div>
      <div class="pg-card pg-card--soft">
        <p class="pg-note">
          <strong>Prüfungsthemen:</strong> GMDSS-System und Seegebiete A1–A4, UKW-/Grenz-/Kurzwellen-Seefunk, DSC-Verfahren (Digital Selective Calling), Satellitenfunk (Inmarsat), NAVTEX, Not-, Dringlichkeits- und Sicherheitsverkehr, internationales Seenot-Englisch und Buchstabiertafel sowie die Funkvorschriften der ITU (VO Funk).
        </p>
      </div>
    </section>

    <!-- Praxis-Brücke: Angst vorm Sprechfunk nehmen -->
    <PracticeBridge variant="radio" />

    <!-- Kosten -->
    <section class="pg-section">
      <h2 class="pg-h2">Was kostet das LRC?</h2>
      <p class="pg-p">
        Für die amtliche LRC-Prüfung fällt eine Gebühr für Zulassung, Prüfung und Erteilung des Zeugnisses an:
      </p>
      <div class="pg-fees">
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Zulassung, Prüfung & Erteilung</p>
            <p class="pg-fee-desc">Amtliche Gebühr über DSV / DMYV (Theorie + Praxis + Zeugnis)</p>
          </div>
          <p class="pg-fee-price h-num">ca. 188 €</p>
        </div>
        <div class="pg-fee">
          <div>
            <p class="pg-fee-label">Vorbereitungskurs (optional)</p>
            <p class="pg-fee-desc">Funkschule mit Lernmaterial & Praxistraining</p>
          </div>
          <p class="pg-fee-price h-num">ca. 300–500 €</p>
        </div>
      </div>
      <p class="pg-note pg-note--sm pg-note--after">
        Die genaue Prüfungsgebühr variiert je nach Verband und Bundesland (ca. 188–207 €). Ein Vorbereitungskurs ist nicht vorgeschrieben – die Theorie kannst du auch eigenständig mit dem offiziellen Fragenkatalog lernen. Diese amtlichen Gebühren sind unabhängig vom Boatpass LRC-Lernmodul (einmalig {priceText('lrc', 'de')}).
      </p>
    </section>

    <!-- So hilft Boatpass beim LRC -->
    <section class="pg-section">
      <h2 class="pg-h2">So hilft Boatpass beim LRC</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Vollständiger LRC-Fragenkatalog', desc: 'Alle offiziellen LRC-Fragen – inklusive SRC-Teil und LRC-Erweiterung – immer aktuell.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Übe unter echten Bedingungen: schriftliche Theorieprüfung mit Bestehensgrenze und Zeitdruck.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Nur deine Schwachstellen üben – kein Zeitverlust mit bereits Gelerntem.' },
          { icon: 'chart', title: 'Fortschritt nach Kategorie', desc: 'Sieh, welche LRC-Themen du sicher beherrschst und wo noch Lücken sind.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der LRC-Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p class="pg-note pg-note--sm">
        Quelle: amtlicher Fragenkatalog auf <a href="https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Boatpass LRC-Modul verfügbar -->
    <section class="pg-section">
      <div class="pg-cta">
        <div class="pg-cta-text">
          <p class="pg-eyebrow">Jetzt verfügbar</p>
          <h2 class="pg-h2">Boatpass LRC-Modul</h2>
          <p class="pg-p">Das LRC-Modul für Boatpass ist da – mit dem gleichen Lernkonzept wie SBF Binnen & See: offizieller Fragenkatalog, Prüfungssimulation und gezieltes Fehlertraining. Einmalig <strong><PlatformPrice product="lrc" lang="de" /></strong>, kein Abo.</p>
        </div>
        <div class="pg-cta-buy">
          <p class="pg-cta-price"><span class="h-num"><PlatformPrice product="lrc" lang="de" alt /></span> <span class="pg-cta-unit">Einmalkauf</span></p>
          <a class="h-btn h-btn--sm" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="page-module">
            LRC-Modul in der App freischalten
            <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
            <span class="sr-only h-off-desktop">(öffnet in neuem Tab)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum LRC</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Verwandte Führerscheine</h2>
      <ul class="pg-related">
        <li><a href="/funkschein-app/">Funkschein-Apps im Vergleich<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/src/">SRC – Kurzstreckenzeugnis für Seefunk<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen mit Boatpass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/ubi/">UBI – UKW-Sprechfunkzeugnis Binnen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/faq/">Häufige Fragen zum Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ubi-vs-src-funkschein/">UBI, SRC oder LRC – welches Funkzeugnis brauchst du?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/seefunk-grundlagen-einsteiger/">Seefunk für Einsteiger: Kanäle, DSC und Notruf verstehen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/notsignale-auf-see/">Notsignale auf See: diese Seenotsignale musst du kennen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/gps-kartenplotter-funkgeraet-moderne-navigation/">GPS, Kartenplotter und Funkgerät – moderne Navigation an Bord<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

<style>
  /* LRC/SRC-Vergleich: 2 Spalten auf breiteren Screens, auf schmalen
     Mobilgeräten gestapelt – sonst überlaufen die Karten den Viewport. */
  .lrc-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .lrc-compare-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
