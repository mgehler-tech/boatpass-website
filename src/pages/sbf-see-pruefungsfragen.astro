---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../icons';
import { PLAY_STORE_URL } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF See", "item": "https://boatpass.de/sbf-see/" },
    { "@type": "ListItem", "position": 3, "name": "Prüfungsfragen", "item": "https://boatpass.de/sbf-see-pruefungsfragen/" },
  ],
};

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Schifffahrtsrecht', desc: 'Vorfahrtregeln, Lichterführung & Kollisionsverhütungsregeln', count: 130, icon: 'scale' },
  { name: 'Navigation & Seekarte', desc: 'Kartenarbeit, Kurse, Gezeiten & Strom', count: 72, icon: 'compass' },
  { name: 'Sicherheit', desc: 'Rettungsausrüstung, Notsignale & Sicherheitsverhalten', count: 40, icon: 'shield' },
  { name: 'Signale & Zeichen', desc: 'Schall-, Sicht- und Seezeichen', count: 28, icon: 'bell' },
  { name: 'Wetterkunde', desc: 'Wind, Wetter, Gezeitentafel & Vorhersage', count: 10, icon: 'cloud' },
  { name: 'Allgemein', desc: 'Allgemeine Grundlagen & Seemannschaft', count: 5, icon: 'document' },
];

const faqs = [
  {
    q: 'Was ist beim SBF-See-Fragenkatalog anders als beim Binnen?',
    a: 'Der SBF See deckt die Seeschifffahrtsstraßen ab und enthält zusätzlich eine Navigationsaufgabe. Die Theorieprüfung besteht aus 30 Standardfragen (7 Basis + 23 spezifisch) plus 9 Fragen zur Navigationsaufgabe – insgesamt 39 Fragen in 60 Minuten.',
  },
  {
    q: 'Wie funktioniert die Navigationsaufgabe?',
    a: 'In der Navigationsaufgabe arbeitest du mit einer Seekarte: Kurse abtragen, Positionen bestimmen, Gezeiten und Strom berücksichtigen. Von den 9 Fragen musst du mindestens 7 richtig beantworten. Genau dieser Teil wird in der Boatpass-App mit realem Navigationsteil geübt.',
  },
  {
    q: 'Wo finde ich die offiziellen SBF-See-Prüfungsfragen?',
    a: 'Der amtliche Fragenkatalog See wird von ELWIS kostenlos herausgegeben. In der Boatpass-App lernst du den vollständigen aktuellen Katalog für Küste und Seeschifffahrtsstraßen – inklusive Prüfungssimulation mit Navigationsteil.',
  },
  {
    q: 'Wie viele Fragen muss ich richtig haben, um zu bestehen?',
    a: 'Du brauchst mindestens 5 von 7 Basisfragen, 18 von 23 spezifischen Fragen und 7 von 9 Fragen der Navigationsaufgabe. Insgesamt stehen dir 60 Minuten zur Verfügung.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="SBF See Prüfungsfragen & Navigationsaufgabe"
  description="Alle SBF-See-Prüfungsfragen aus dem offiziellen ELWIS-Katalog üben – inkl. Navigationsaufgabe. Aufbau, Bestehensgrenze und wie du die 39 Fragen meisterst."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-coastal-exam-questions/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="SBF See Prüfungsfragen"
    lede="Der komplette amtliche ELWIS-Katalog See – plus die Navigationsaufgabe mit realem Navigationsteil. Übe alle 39 Prüfungsfragen unter echten Bedingungen."
    ctaLabel="Kostenlos Fragen üben"
    cta
  >
    SBF See Fragen –<br />inklusive Navigation üben
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfSee"
      items={[
        { k: 'Fragenkatalog', v: '285 Fragen (72 Basis + 213 spezifisch)' },
        { k: 'Theorieprüfung', v: '39 Fragen · 60 Min' },
        { k: 'Basisfragen', v: '7, mind. 5 richtig' },
        { k: 'Spezifische Fragen', v: '23, mind. 18 richtig' },
        { k: 'Navigationsaufgabe', v: '9 Fragen, mind. 7 richtig' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Der amtliche SBF-See-Fragenkatalog umfasst 285 Fragen (72 Basis- + 213 spezifische See-Fragen). Die Theorieprüfung besteht aus 39 Fragen in 60 Minuten: 30 Standardfragen (7 Basis + 23 spezifische) plus 9 Fragen zur Navigationsaufgabe auf der Seekarte. Bestanden hat, wer mindestens 5 von 7 Basisfragen, 18 von 23 spezifischen Fragen und 7 von 9 Navigationsfragen richtig hat. Boatpass trainiert den vollständigen ELWIS-Katalog inklusive realem Navigationsteil.
        </p>
      </div>
    </section>

    <!-- Der Katalog -->
    <section class="pg-section">
      <h2 class="pg-h2">Der offizielle SBF-See-Fragenkatalog</h2>
      <p class="pg-p">
        Die <strong>Prüfungsfragen für den SBF See</strong> stammen aus dem amtlichen Fragenkatalog (DSV/DMYV, veröffentlicht über ELWIS) für die <strong>Seeschifffahrtsstraßen</strong> (Nord- und Ostsee). Er umfasst <strong>72 Basisfragen und 213 spezifische See-Fragen</strong> (zusammen 285 Fragen). Dazu kommt der entscheidende Teil, den es beim Binnen nicht gibt: die <strong>Navigationsaufgabe</strong>.
      </p>
      <p class="pg-p">
        Die Theorieprüfung umfasst insgesamt <strong>39 Fragen in 60 Minuten</strong> – 30 Standardfragen plus 9 Fragen zur Navigationsaufgabe auf der Seekarte.
      </p>
      <p class="pg-note pg-note--sm pg-note--after">
        Quelle: amtlicher Fragenkatalog (DSV/DMYV), kostenlos veröffentlicht über <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
    </section>

    <!-- Aufbau der Prüfung -->
    <section class="pg-section">
      <h2 class="pg-h2">So ist die SBF-See-Theorieprüfung aufgebaut</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Prüfungsbogen</p>
          <p class="pg-card-text">39 Fragen · 60 Minuten<br>Multiple Choice + Navigation</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basisfragen</p>
          <p class="pg-card-text">7 Fragen<br>mind. 5 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Spezifische Fragen</p>
          <p class="pg-card-text">23 Fragen<br>mind. 18 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Navigationsaufgabe</p>
          <p class="pg-card-text">9 Fragen<br>mind. 7 richtig</p>
        </div>
      </div>
    </section>

    <!-- Navigationsaufgabe -->
    <section class="pg-section">
      <h2 class="pg-h2">Die Navigationsaufgabe – der Knackpunkt beim SBF See</h2>
      <p class="pg-p">
        Die Navigationsaufgabe ist der Teil, vor dem die meisten Prüflinge Respekt haben. Auf der amtlichen <strong>Übungs-Seekarte</strong> trägst du Kurse ab, bestimmst Positionen und berücksichtigst Einflüsse wie <strong>Strom, Wind und Gezeiten</strong>. Von den 9 Einzelfragen musst du mindestens 7 richtig lösen.
      </p>
      <p class="pg-p">
        Der große Vorteil: Es gibt insgesamt nur <strong>15 amtliche Navigationsaufgaben</strong>, von denen in der Prüfung eine unverändert gestellt wird. Wer diese 15 Aufgaben mit einem <strong>realen Navigationsteil</strong> durchübt – genau wie in der echten Prüfung – geht souverän in den Prüfungstag. Genau das bildet die Boatpass-App ab.
      </p>
    </section>

    <!-- Effektiv üben -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF-See-Fragen effektiv üben</h2>
      <div class="pg-rows">
        {[
          { icon: 'book', title: 'Kompletter ELWIS-Katalog See', desc: 'Alle Fragen zu Küste und Seeschifffahrtsstraßen – vollständig abgedeckt, immer aktuell.' },
          { icon: 'compass', title: 'Navigation mit realem Navigationsteil', desc: 'Übe die Navigationsaufgabe so, wie sie in der echten Prüfung gestellt wird – Kurse, Positionen, Gezeiten.' },
          { icon: 'target', title: 'Prüfungssimulation: 39 Fragen, 60 Minuten', desc: 'Echte Prüfungsbedingungen inklusive Navigationsteil und Bestehensgrenze.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Wiederhole gezielt deine Schwachstellen, statt alles von vorne zu lernen.' },
        ].map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon as IconName} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum SBF-See-Katalog</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der Fragenkatalog ist in Themengebiete unterteilt – übe gezielt nach Schwachstellen.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Seiten</h2>
      <ul class="pg-related">
        <li><a href="/sbf-see/">SBF See lernen: Überblick & App<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-binnen-pruefungsfragen/">SBF Binnen Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-see-navigationsaufgaben-erklaert/">SBF See Navigationsaufgaben erklärt – Aufbau & Tipps<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/schwierigste-sbf-pruefungsfragen/">Die schwierigsten SBF-Prüfungsfragen – und wie du sie meisterst<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>
