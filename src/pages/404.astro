---
import BaseLayout from '../layouts/BaseLayout.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<BaseLayout
  title="Seite nicht gefunden (404)"
  description="Diese Seite existiert nicht oder wurde verschoben. Finde zurück zur Boatpass-Startseite oder zu den SBF-Lerninhalten."
  lang="de"
  hasAlternate={false}
  noindex={true}
  showCta={false}
>
  <div style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:120px 24px 80px; text-align:center;">
    <div style="max-width:560px;">
      <div style="font-size:88px; font-weight:900; letter-spacing:-4px; color:#3366FF; line-height:1; margin-bottom:8px;">404</div>
      <h1 style="font-size:clamp(26px,4vw,36px); font-weight:900; letter-spacing:-1.5px; color:#1A1F36; margin-bottom:14px;">
        Hier ist Niemand an Bord
      </h1>
      <p style="font-size:17px; color:#656B78; line-height:1.65; margin-bottom:32px;">
        Diese Seite gibt es nicht (mehr) oder die Adresse hat einen Tippfehler. Steuere zurück in sicheres Fahrwasser:
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:36px;">
        <a href="/" style="font-size:15px; font-weight:700; color:white; background:#3366FF; padding:13px 24px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.25);">Zur Startseite</a>
        <a href="/sbf-binnen/" style="font-size:15px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.15); padding:13px 22px; border-radius:14px; text-decoration:none;">SBF Binnen</a>
        <a href="/sbf-see/" style="font-size:15px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.15); padding:13px 22px; border-radius:14px; text-decoration:none;">SBF See</a>
        <a href="/faq/" style="font-size:15px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.15); padding:13px 22px; border-radius:14px; text-decoration:none;">Häufige Fragen</a>
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" style="font-size:14px; color:#656B78; text-decoration:underline; text-underline-offset:2px;">
        Oder lade die Boatpass-App im Play Store →
      </a>
    </div>
  </div>

  <style>
    html.dark h1 { color: #E2E8F0; }
    html.dark p  { color: #94A3B8; }
    html.dark a[style*="background:white"],
    html.dark a[style*="background: white"] {
      background: #1A2140 !important;
      color: #E2E8F0 !important;
      border-color: rgba(90, 120, 255, 0.22) !important;
    }
    html.dark a[style*="color:#656B78"] { color: #94A3B8 !important; }
  </style>
</BaseLayout>
