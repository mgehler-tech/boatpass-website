---
import AppLandingPage from '../components/AppLandingPage.astro';
import { appsForLicense } from '../data/apps';
import { priceText } from '../data/stores';

const apps = appsForLicense('sbf-see');

const faqs = [
  {
    q: 'Welche App ist die beste für den SBF See?',
    a: 'Wenn du nichts ausgeben willst: Sportbootführerschein See 2023 von Matthias Wimmer – komplett kostenlos, ohne Werbung, allerdings ohne Navigationsaufgaben. Wenn du die Navigationsaufgaben auf dem iPhone gründlich üben willst: SBF See von Ralf Goritz. Wenn du Erklärungen zu den Antworten und einen begleitenden Onlinekurs willst: Bootspruefung.de. Wenn du SBF See mit weiteren Scheinen kombinierst und kein Abo möchtest: Boatpass.',
  },
  {
    q: 'Decken die Apps auch die Navigationsaufgaben ab?',
    a: 'Nicht alle. Die SBF-See-Prüfung enthält neben den Multiple-Choice-Fragen einen Navigationsteil mit Kartenarbeit, Kursberechnung und Standortbestimmung. Die kostenlose Wimmer-App deckt ihn nicht ab. Boatpass, Bootspruefung.de, Bootsprüfung, SBF-Fragen und SBF See von Ralf Goritz behandeln die Navigationsaufgaben. Ein gedruckter Übungssatz mit der amtlichen Übungskarte ist trotzdem sinnvoll – in der Prüfung arbeitest du auf Papier.',
  },
  {
    q: 'Wie viele Fragen hat die SBF-See-Prüfung?',
    a: 'Der amtliche Fragenkatalog SBF See umfasst 285 Fragen (72 Basis- und 213 See-Fragen) plus 15 Navigationsaufgaben. Im Prüfungsbogen beantwortest du 30 Fragen: 7 Basisfragen und 23 spezifische See-Fragen. Dazu kommt eine Navigationsaufgabe. Details zum Ablauf findest du auf unserer Seite zur SBF-Prüfung.',
  },
  {
    q: 'Reicht eine App, um den SBF See zu bestehen?',
    a: 'Für die Theorie ja, sofern du den kompletten Katalog durcharbeitest und die Navigationsaufgaben zusätzlich übst. Die praktische Prüfung – Manöver und Knoten – lernst du nur auf dem Wasser.',
  },
  {
    q: 'Gibt es eine SBF-See-App für das iPhone?',
    a: 'Ja, sogar mehrere: Bootspruefung.de, Bootsprüfung, Bootsschule1, SBF-Fragen, Sailbyte, Boatpass (seit Oktober 2026) und SBF See von Ralf Goritz, die es nur für iOS gibt. Nur die kostenlose Wimmer-App ist auf Android beschränkt.',
  },
  {
    q: 'Funktionieren die Apps offline?',
    a: 'Boatpass, SBF-Fragen, Bootsprüfung, SBF See von Ralf Goritz und die Wimmer-App lernen offline. Bei Bootspruefung.de ist die vollständige Offline-Nutzung Teil der Pro-Version. Bei Sailbyte sind SBF See und Binnen offline nutzbar.',
  },
];

const relatedLinks = [
  { href: '/sbf-see/', label: 'SBF See – Prüfung, Kosten und Ablauf' },
  { href: '/sbf-see-pruefungsfragen/', label: 'SBF-See-Prüfungsfragen im Überblick' },
  { href: '/sbf-app/', label: 'Alle Bootsführerschein-Apps im Vergleich' },
  { href: '/sbf-binnen-app/', label: 'SBF-Binnen-Apps im Vergleich' },
  { href: '/sbf-see-navigationsaufgaben/', label: 'SBF See Navigationsaufgaben Schritt für Schritt' },
  { href: '/blog/sbf-see-navigationsaufgaben-erklaert/', label: 'Navigationsaufgaben beim SBF See erklärt' },
  { href: '/blog/sbf-binnen-vs-see/', label: 'SBF Binnen oder See – welcher Schein passt?' },
];
---

<AppLandingPage
  lang="de"
  title="SBF-See-App: die besten Apps im Vergleich"
  description="SBF See App gesucht? Acht Apps für Android und iPhone im Vergleich: Preise, Bewertungen und wer die Navigationsaufgaben wirklich abdeckt – inklusive Boatpass."
  altUrl="https://boatpass.de/en/sbf-coastal-app/"
  path="/sbf-see-app/"
  breadcrumbName="SBF-See-Apps im Vergleich"
  badge="Sportbootführerschein See"
  h1="SBF-See-Apps im Vergleich"
  heroIntro="Acht Apps decken den amtlichen Fragenkatalog SBF See ab – zu sehr unterschiedlichen Preisen und mit unterschiedlicher Tiefe bei den Navigationsaufgaben. Hier stehen sie nebeneinander."
  answer="Für den SBF See gibt es acht verbreitete Lern-Apps. Kostenlos und sehr gut bewertet ist Sportbootführerschein See 2023 von Matthias Wimmer, deckt aber die Navigationsaufgaben nicht ab. Die meisten Bewertungen haben Bootspruefung.de und SBF See von Ralf Goritz (nur iOS, mit animierten Navigationsaufgaben). Bootsprüfung, SBF-Fragen und Boatpass behandeln ebenfalls die Kartenarbeit, Sailbyte arbeitet mit Monatsabo, Bootsschule1 gehört zu einem Komplettkurs."
  apps={apps}
  tableCaption="Alle Apps, die den amtlichen Fragenkatalog SBF See abdecken – alphabetisch sortiert."
  androidHeading="SBF-See-App für Android"
  androidParagraphs={[
    'Bis auf SBF See von Ralf Goritz sind alle Apps im Google Play Store verfügbar. Die meistgenutzte kostenlose Variante ist <strong>Sportbootführerschein See 2023</strong> von Matthias Wimmer mit über 100.000 Downloads – ohne Werbung, ohne In-App-Käufe, ohne Tracking. Sie arbeitet nach dem Karteikasten-Prinzip: Eine Frage gilt erst als erledigt, wenn du sie fünfmal richtig beantwortet hast.',
    'Der entscheidende Haken: Die <strong>Navigationsaufgaben deckt sie nicht ab</strong>. Für Kursberechnung, Besteckrechnung und Kartenarbeit brauchst du zusätzliches Material – oder eine App, die den Teil enthält.',
    'Boatpass gibt es ebenfalls bei Google Play. Der SBF-See-Katalog kostet einmalig ' + priceText('sbfSee', 'de') + ', im Paket mit SBF Binnen ' + priceText('bundleSbf', 'de') + '. Zum Ausprobieren ist die App kostenlos.',
  ]}
  iosHeading="SBF-See-App für iPhone und iPad"
  iosParagraphs={[
    'Auf dem iPhone ist die Auswahl groß. Eine eigene Erwähnung verdient <strong>SBF See von Ralf Goritz</strong>: Die App gibt es nur für iOS, sie ist die meistbewertete reine See-App und zeigt alle Navigationsaufgaben als Animation für Papier- und Digitalkarte. Daneben gibt es <strong>Bootspruefung.de</strong>, <strong>SBF-Fragen</strong>, <strong>Bootsprüfung</strong>, <strong>Bootsschule1</strong>, <strong>Sailbyte</strong> und <strong>Boatpass</strong> im App Store.',
    'Die kostenlose Wimmer-App gibt es nicht im App Store. <strong>Boatpass ist seit Oktober 2026 dort verfügbar</strong>; ein Kauf gilt allerdings nur im jeweiligen Store, ein Android-Kauf schaltet auf dem iPhone nichts frei.',
  ]}
  strengths={[
    'Vollständiger amtlicher SBF-See-Katalog inklusive Navigationsaufgaben',
    'Prüfungssimulation mit Bestehensgrenze und Zeitlimit',
    'Fehlertraining für die Fragen, die du falsch beantwortet hast',
    'Kombinierbar mit SBF Binnen, UBI, SRC und LRC in derselben App',
    'Einmalig 9,99 € für den SBF-See-Katalog, kein Abo',
    'Offline lernen – funktioniert ohne Internetverbindung',
  ]}
  limitations={[
    'Käufe gelten nur im jeweiligen Store – kein Übertrag zwischen Android und iPhone',
    'Kein SKS – wer den Sportküstenschifferschein anschließt, braucht eine zweite App',
    'Noch wenige Bewertungen im Vergleich zu Bootspruefung.de, Goritz oder Wimmer',
    'Kein Onlinekurs im Browser als Ergänzung',
    'Ersetzt nicht die praktische Ausbildung und das Üben auf der Papierkarte',
  ]}
  faqs={faqs}
  relatedLinks={relatedLinks}
>
  <section slot="after-table" style="margin-bottom:48px;">
    <h2 class="content-section-title" style="margin-bottom:16px;">Navigationsaufgaben: was die Apps abdecken</h2>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Der Navigationsteil ist beim SBF See der Unterschied zum Binnenschein: 15 amtliche Aufgaben mit Kursberechnung, Peilung und Standortbestimmung auf der Übungskarte D49. In der Prüfung löst du eine davon auf Papier, mit Navigationsbesteck. Die Apps gehen damit sehr unterschiedlich um (Angaben laut Store-Beschreibungen und Anbieter-Websites, Stand Oktober 2026):
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      <strong>SBF See von Ralf Goritz</strong> zeigt alle Navigationsaufgaben als Animation, für Papier- und Digitalkarte, und enthält die Übungskarte D49 in digitaler Form. <strong>Bootspruefung.de</strong> erklärt die Aufgaben in seinem Video-Kurs. <strong>Bootsprüfung</strong>, <strong>SBF-Fragen</strong> und <strong>Boatpass</strong> enthalten die Navigationsaufgaben; Boatpass fragt jede Aufgabe in neun Teilfragen ab. Die kostenlose <strong>Wimmer-App</strong> enthält keine Navigationsaufgaben.
    </p>
    <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
      Egal welche App: Übe mindestens ein paar Aufgaben auf der gedruckten Karte, denn in der Prüfung gibt es kein Display. Den Lösungsweg für jeden Aufgabentyp zeigt die Seite <a href="/sbf-see-navigationsaufgaben/" style="color:#3366FF; text-decoration:underline;">SBF See Navigationsaufgaben Schritt für Schritt</a>. Wie die Aufgaben aufgebaut sind, erklären wir im Artikel <a href="/blog/sbf-see-navigationsaufgaben-erklaert/" style="color:#3366FF; text-decoration:underline;">SBF-See-Navigationsaufgaben erklärt</a>, die Kursumrechnung im Artikel <a href="/blog/kursumrechnung-sbf-see/" style="color:#3366FF; text-decoration:underline;">Kursumrechnung beim SBF See</a>.
    </p>
  </section>
</AppLandingPage>
