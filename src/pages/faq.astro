---
import BaseLayout from '../layouts/BaseLayout.astro';

// FAQ thematisch gruppiert: bessere Übersicht für Nutzer + klare H2-Struktur
// und thematische Keyword-Cluster für SEO. Jede Kategorie bekommt eine eigene
// Sprungmarke (id), damit Google sie als eigenständigen Abschnitt erfassen kann.
const categories: { id: string; title: string; faqs: { q: string; a: string }[] }[] = [
  {
    id: 'grundlagen',
    title: 'Grundlagen & Lizenzen',
    faqs: [
      {
        q: 'Was ist der Sportbootführerschein (SBF)?',
        a: 'Der Sportbootführerschein (SBF) ist die amtliche Fahrerlaubnis für Sportboote in Deutschland. Er ist Pflicht für Motorboote mit mehr als 15 PS (11 kW) auf Bundeswasserstraßen. Es gibt zwei Varianten: SBF Binnen für Binnengewässer und SBF See für Küstengewässer. Wer beide Scheine braucht, kann sie in einer kombinierten Prüfung ablegen.',
      },
      {
        q: 'Was ist der Unterschied zwischen SBF Binnen und SBF See?',
        a: 'Der SBF Binnen berechtigt zur Fahrt auf Binnenschifffahrtsstraßen – also auf Flüssen, Kanälen und Binnenseen. Der SBF See gilt auf Seeschifffahrtsstraßen, also den Küstengewässern Deutschlands (Nord- und Ostsee). Wichtig: Beide Scheine sind getrennte Führerscheine mit eigener Prüfung. Wer beide Reviere befahren möchte, muss beide ablegen – oder die Kombination wählen.',
      },
      {
        q: 'Welche Funkzeugnisse gibt es – und brauche ich eines?',
        a: 'Sobald du eine Funkanlage an Bord bedienst, brauchst du das passende Sprechfunkzeugnis. Für den Binnenfunk (Flüsse, Kanäle) ist das das UBI (UKW-Sprechfunkzeugnis Binnenschifffahrt). Für den Seefunk im Küstenbereich gilt das SRC (Short Range Certificate), für den weltweiten Seefunk inklusive Grenz-/Kurzwelle und Satellit das LRC (Long Range Certificate). Diese Funkzeugnisse sind unabhängig vom SBF und werden in Boatpass als eigene Lernmodule angeboten.',
      },
      {
        q: 'Welche Lizenz brauche ich für mein Revier?',
        a: 'Faustregel: Für ein Motorboot über 15 PS brauchst du auf Binnengewässern den SBF Binnen, an der Küste den SBF See. Kommt eine Funkanlage dazu, ergänzt du sie um das passende Funkzeugnis – UBI im Binnenbereich, SRC an der Küste, LRC für weltweite Fahrt. Eine Übersicht aller Scheine findest du auf der Seite „Führerscheine“ sowie im <a href="/blog/sbf-gueltigkeit-welcher-schein-wo/" style="color:#3366FF; text-decoration:underline;">Artikel „SBF-Gültigkeit: Welcher Schein gilt wo?“</a>.',
      },
      {
        q: 'Brauche ich für die Ostsee den SBF See oder den SBF Binnen?',
        a: 'An Nord- und Ostsee gilt der SBF See, denn die Küstengewässer sind Seeschifffahrtsstraßen – der SBF Binnen reicht dort nicht. Wichtig: Die Grenze zwischen See und Binnen verläuft nicht an der Küstenlinie, sondern an den Flussmündungen. Auf der Elbe brauchst du zum Beispiel bis Hamburg den SBF See, oberhalb den SBF Binnen. Für den Bodensee gilt eine eigene Regelung (Bodensee-Schifferpatent). Wer Küste und Binnen befahren möchte, macht beide Scheine – am günstigsten in der Kombiprüfung.',
      },
      {
        q: 'SRC oder UBI – welches Funkzeugnis brauche ich?',
        a: 'Das hängt vom Revier ab. Für den Seefunk an der Küste – also eine UKW-Seefunkanlage mit DSC – brauchst du das SRC (Short Range Certificate). Für den Binnenfunk auf Flüssen und Kanälen ist das UBI (UKW-Sprechfunkzeugnis Binnenschifffahrt) zuständig. Das SRC gilt nicht im Binnenfunk, das UBI nicht im Seefunk – wer beide Reviere befährt, braucht beide Zeugnisse. In Boatpass lernst du UBI und SRC als eigenes Modul für je einmalig 7,99 €.',
      },
      {
        q: 'Was ist der Unterschied zwischen SRC und LRC?',
        a: 'Beide sind Seefunkzeugnisse und unterscheiden sich vor allem in der Reichweite. Das SRC (Short Range Certificate) gilt für den UKW-Seefunk mit DSC im Küstenbereich (Seegebiet A1, rund 35 Seemeilen). Das LRC (Long Range Certificate) deckt zusätzlich den weltweiten Seefunk über Grenz- und Kurzwelle (MF/HF) sowie Satellitenfunk ab (Seegebiete A1–A4) – nötig für Hochsee- und Blauwasserfahrt. Für Küstenreviere reicht das SRC; das LRC baut darauf auf und ist die Wahl fürs offene Meer. In Boatpass gibt es beide als eigenes Modul (SRC 7,99 €, LRC 9,99 €).',
      },
    ],
  },
  {
    id: 'voraussetzungen',
    title: 'Voraussetzungen & Recht',
    faqs: [
      {
        q: 'Wie alt muss man für den Sportbootführerschein sein?',
        a: 'Das Mindestalter beträgt für den SBF Binnen und den SBF See unter Motor jeweils 16 Jahre. Für den SBF Binnen unter Segel reicht 14 Jahre. Zur Prüfung anmelden darfst du dich schon etwas früher (ab etwa 15 Jahren und 9 Monaten) – das Mindestalter musst du erst bei der Aushändigung des Führerscheins erreicht haben. Auch wer führerscheinfrei ein Boot bis 15 PS fährt, muss mindestens 16 Jahre alt sein.',
      },
      {
        q: 'Welche Unterlagen brauche ich für die Prüfungsanmeldung?',
        a: 'Für die Anmeldung beim Prüfungsausschuss (DMYV oder DSV) brauchst du: den Antrag auf Zulassung zur Prüfung, ein ärztliches Zeugnis für Sportbootführerscheinbewerber (Seh-, Hör- und Farbtest, 12 Monate gültig, ca. 30–65 €), ein biometrisches Passfoto (35 × 45 mm), einen Zuverlässigkeitsnachweis (Kopie des Kfz-Führerscheins oder ein polizeiliches Führungszeugnis der Belegart O) sowie die Prüfungsgebühr. Ein Kursnachweis ist nicht nötig – du darfst dich auch nach reiner App-Vorbereitung mit Boatpass anmelden.',
      },
      {
        q: 'Brauche ich überhaupt einen Bootsführerschein? (15-PS-Regel)',
        a: 'In Deutschland darfst du Motorboote bis einschließlich 15 PS (11,03 kW) ab 16 Jahren ohne Sportbootführerschein führen – auf Binnen- und Seeschifffahrtsstraßen. Erst über 15 PS wird der SBF Pflicht. Ausnahmen: Auf dem <a href="/blog/bodensee-schifferpatent/" style="color:#3366FF; text-decoration:underline;">Bodensee (Bodensee-Schifferpatent)</a> und auf dem Rhein gelten niedrigere Grenzen, und einzelne Zonen (z. B. ein Abschnitt der Spree in Berlin) verlangen unabhängig von der Motorleistung einen Schein. Fürs offene Meer oder einen <a href="/blog/charterschein-boot-mieten-ohne-fuehrerschein/" style="color:#3366FF; text-decoration:underline;">Charter im Ausland</a> brauchst du fast immer den SBF See.',
      },
      {
        q: 'Gilt auf dem Boot die 0,5-Promille-Grenze wie beim Auto?',
        a: 'Nein, nicht in dieser Form. Für Sportboote gilt nicht das StVG, sondern die Binnenschifffahrtsstraßen-Ordnung (BinSchStrO) bzw. die Seeschifffahrtsstraßen-Ordnung (SeeSchStrO): Der Schiffsführer muss jederzeit fahrtüchtig sein. Strafbar wird Trunkenheit über § 315a StGB – relative Fahruntüchtigkeit kann schon bei niedrigen Werten plus Ausfallerscheinungen vorliegen, absolute Fahruntüchtigkeit ab 1,6 Promille. Die sichere Regel lautet: Als Schiffsführer trinkst du keinen Alkohol. Mehr dazu im <a href="/blog/promillegrenze-boot/" style="color:#3366FF; text-decoration:underline;">Artikel zur Promillegrenze auf dem Boot</a>.',
      },
      {
        q: 'Wie lange ist der Sportbootführerschein gültig?',
        a: 'Der deutsche Sportbootführerschein ist unbefristet – lebenslang gültig, ohne Verlängerung oder Erneuerung. Seit 2018 wird er im Scheckkartenformat mit dem ICC (International Certificate of Competence) auf der Rückseite ausgestellt und damit in über 30 Ländern anerkannt, darunter die wichtigsten Charterreviere wie Kroatien, Griechenland, Italien, Spanien und die Türkei. Alte Papierführerscheine ohne ICC kannst du beim DMYV oder DSV auf das neue Format umschreiben lassen.',
      },
      {
        q: 'Was ist der Charterschein – und ersetzt er den SBF?',
        a: 'Der Charterschein (amtlich Charterbescheinigung) erlaubt es, auf bestimmten ausgewiesenen Binnengewässern – vor allem auf der Mecklenburgischen Seenplatte – ein gemietetes Boot ohne Sportbootführerschein zu führen. Voraussetzung: Das Boot ist maximal 15 m lang und 12 km/h schnell, das Mindestalter liegt meist bei 16 Jahren, dazu kommt eine 2- bis 3-stündige Einweisung durch den Vermieter. Es gelten Auflagen wie Nachtfahrverbot und Fahrverbot ab Windstärke 4. Der Charterschein ersetzt den SBF aber nicht: Er gilt nur fürs Mietboot, nur im ausgewiesenen Revier und nicht im Ausland. Details im <a href="/blog/charterschein-boot-mieten-ohne-fuehrerschein/" style="color:#3366FF; text-decoration:underline;">Artikel zum Charterschein</a>.',
      },
    ],
  },
  {
    id: 'pruefung',
    title: 'Prüfung & Vorbereitung',
    faqs: [
      {
        q: 'Wie läuft die SBF-Theorieprüfung ab?',
        a: 'Beide Scheine haben eine schriftliche Theorieprüfung. Beim SBF Binnen besteht der Bogen aus 30 Fragen (7 Basisfragen + 23 spezifische Fragen), die in 45 Minuten beantwortet werden müssen. Bestanden ist, wer mindestens 5 von 7 Basisfragen und mindestens 18 von 23 spezifischen Fragen richtig hat. Der SBF See hat zusätzlich eine Navigationsaufgabe mit 9 Fragen (mind. 7 richtig), insgesamt 39 Fragen in 60 Minuten. Nach der Theorie folgt eine praktische Prüfung auf dem Wasser.',
      },
      {
        q: 'Muss ich einen Kurs besuchen oder kann ich mich selbst vorbereiten?',
        a: 'Ein Kurs ist nicht vorgeschrieben – du kannst dich vollständig auf eigene Faust vorbereiten. Die offiziellen Fragenkataloge sind öffentlich zugänglich, und Apps wie Boatpass ermöglichen ein strukturiertes Lernen ohne Fahrschule. Viele Prüflinge bestehen den theoretischen Teil ohne Kurs. Für die praktische Prüfung empfiehlt sich jedoch mindestens ein Übungstag auf dem Wasser.',
      },
      {
        q: 'Wie lange dauert die Vorbereitung?',
        a: 'Mit konsequentem Lernen (20–30 Minuten täglich) sind 4–6 Wochen für die Theorie realistisch. Wer gezielt mit dem offiziellen Fragenkatalog übt und Fehler systematisch aufarbeitet, kommt auch schneller ans Ziel. Die Boatpass-App zeigt dir deinen Fortschritt und trainiert gezielt deine Schwachstellen.',
      },
      {
        q: 'Gilt der deutsche SBF auch im Ausland?',
        a: 'Der SBF Binnen wird auf deutschen Binnenschifffahrtsstraßen anerkannt. Im Ausland gelten die jeweiligen nationalen Vorschriften – in vielen europäischen Ländern reicht der SBF aus, in anderen ist zusätzlich der ICC (International Certificate of Competence) notwendig, den du auf Basis deines deutschen Scheins beantragen kannst. Details zu einzelnen Charterrevieren findest du im <a href="/blog/sbf-im-ausland-gueltig/" style="color:#3366FF; text-decoration:underline;">Artikel zur SBF-Gültigkeit im Ausland</a>.',
      },
      {
        q: 'Wie viele Fehler darf man beim SBF haben?',
        a: 'Beim SBF Binnen darfst du höchstens 2 von 7 Basisfragen und 5 von 23 spezifischen Fragen falsch beantworten – bestanden ist, wer mindestens 5 Basis- und 18 spezifische Fragen richtig hat. Beim SBF See gilt dasselbe für Basis- und Spezifikfragen; zusätzlich musst du von den 9 Navigationsaufgaben mindestens 7 richtig lösen (also höchstens 2 Fehler). Boatpass zeigt dir in der Prüfungssimulation sofort, ob du nach diesen amtlichen Kriterien bestanden hättest.',
      },
      {
        q: 'Was passiert, wenn ich durch die SBF-Prüfung falle?',
        a: 'Du kannst die Prüfung wiederholen – nicht bestandene Teile werden einzeln nachgeholt. Hast du nur die Theorie oder nur die Praxis nicht bestanden, wiederholst du auch nur diesen Teil; eine bereits bestandene Teilprüfung musst du in der Regel nicht erneut ablegen. Die Wiederholungsgebühren liegen 2026 je nach Prüfungsausschuss bei etwa 37–49 € für die Theorie und 57–75 € für die Praxis. Mit dem gezielten Fehler-Training in Boatpass bereitest du genau die Themen nach, an denen es gehakt hat.',
      },
      {
        q: 'Wie schwer ist die Navigationsaufgabe beim SBF See?',
        a: 'Die Navigationsaufgabe gilt für viele als anspruchsvollster Teil des SBF See, ist aber gut lernbar. Du arbeitest mit einer amtlichen Übungsseekarte und löst 9 Aufgaben rund um Kurse (<a href="/blog/kompass-missweisung-deviation-erklaert/" style="color:#3366FF; text-decoration:underline;">Kompasskurs, Missweisung und Deviation</a>), Standort- und Distanzbestimmung sowie Gezeiten. Mindestens 7 der 9 Aufgaben müssen richtig sein. Mit etwas Übung an Kartenarbeit, Anlegezirkel und Kursdreieck wird die Aufgabe zur Routine – Boatpass trainiert die zugehörigen Fragen aus dem amtlichen Katalog.',
      },
    ],
  },
  {
    id: 'fragenkatalog',
    title: 'Fragenkataloge',
    faqs: [
      {
        q: 'Wie viele Fragen hat der offizielle SBF-Fragenkatalog?',
        a: 'Der amtliche SBF-Fragenkatalog wird von DSV und DMYV festgelegt und über ELWIS kostenlos veröffentlicht. Der Katalog Binnen umfasst unter Motor 72 Basisfragen und 181 spezifische Fragen (zusammen 253), plus 47 Segelfragen für den Geltungsbereich Segeln. Der Katalog See enthält 72 Basisfragen und 213 spezifische See-Fragen (zusammen 285). Boatpass enthält den vollständigen aktuellen Katalog für beide Scheine.',
      },
      {
        q: 'Aus welchem Fragenkatalog lernen die Funkmodule (UBI, SRC, LRC)?',
        a: 'Die Funkzeugnisse haben einen eigenen amtlichen Fragenkatalog – nicht den ELWIS/SBF-Katalog. Die Prüfungsfragen für die Seefunkzeugnisse SRC und LRC sowie für das Binnenfunkzeugnis UBI werden von der Bundesnetzagentur herausgegeben (zuständig u. a. die Außenstelle Hamburg für den Seefunk); die Prüfungen selbst nehmen die Ausschüsse von DSV und DMYV ab. Der aktuell gültige Katalog gilt seit der Funkschein-Reform vom 1. Oktober 2018. Boatpass enthält für jedes Funkmodul – UBI, SRC und LRC – den vollständigen offiziellen Katalog.',
      },
      {
        q: 'Wie aktuell ist der Fragenkatalog in der App?',
        a: 'Boatpass enthält für jede Lizenz den jeweils aktuellen amtlichen Fragenkatalog. Für SBF Binnen und SBF See ist das der über ELWIS veröffentlichte Katalog von DSV/DMYV; für die Funkmodule UBI, SRC und LRC der amtliche Funk-Fragenkatalog der Bundesnetzagentur. Sobald eine dieser Stellen ihren Katalog aktualisiert, ziehen wir die App zeitnah nach – du lernst also immer mit den Fragen, die auch in der echten Prüfung gestellt werden.',
      },
    ],
  },
  {
    id: 'kosten',
    title: 'Kosten',
    faqs: [
      {
        q: 'Was kostet die SBF-Prüfung?',
        a: 'Die amtlichen Prüfungsgebühren (Theorie + Praxis) liegen 2026 bei 130,78 € für den SBF Binnen und 148,38 € für den SBF See. Die kombinierte Prüfung Binnen + See kostet zusammen nur 178,61 € statt 279,16 €. Hinzu kommen optional Kursgebühren (Online-Kurse ab ca. 340 €). Mit der Boatpass-App lernst du die Theorie ohne teuren Vorbereitungskurs.',
      },
      {
        q: 'Spare ich Geld mit der Kombiprüfung Binnen + See?',
        a: 'Ja. Einzeln kosten die amtlichen Prüfungsgebühren 130,78 € (Binnen) und 148,38 € (See), zusammen also 279,16 €. Die kombinierte Prüfung Binnen + See kostet dagegen nur 178,61 € – du sparst rund 100 €. Möglich ist das, weil die 72 Basisfragen bei beiden Scheinen identisch sind und nur einmal geprüft werden. In Boatpass lernst du beide Kataloge im Komplett-Paket für 16,98 € statt 19,98 €.',
      },
      {
        q: 'Was kosten die Funkzeugnisse (UBI, SRC, LRC)?',
        a: 'Die amtlichen Prüfungsgebühren (Zulassung, Prüfung und Erteilung) liegen beim UBI bei rund 109 €, beim SRC bei rund 128 € und beim LRC bei etwa 188–207 €. Ein Vorbereitungskurs ist freiwillig. In Boatpass lernst du die Theorie als Modul: UBI und SRC für je einmalig 7,99 €, LRC für einmalig 9,99 € – kein Abo.',
      },
      {
        q: 'Ist die Boatpass-App kostenlos?',
        a: 'Ja – die App ist kostenlos. Im kostenlosen Modus kannst du täglich 15 Lernfragen bearbeiten und die App kennenlernen. Der Vollzugang für den SBF (unbegrenzte Fragen, Prüfungssimulation, Fehler-Training) ist ein einmaliger Kauf für 9,99 € pro Katalog – oder beide SBF-Kataloge als Komplett-Paket für 16,98 € (du sparst 3 €). Die Funkmodule UBI, SRC und LRC schaltest du separat frei (ab 7,99 €). Kein Abo, keine versteckten Kosten.',
      },
    ],
  },
  {
    id: 'app',
    title: 'Boatpass-App',
    faqs: [
      {
        q: 'Auf welchen Geräten läuft die App?',
        a: 'Boatpass ist aktuell für Android verfügbar (Google Play Store). Eine iOS-Version ist in Planung.',
      },
      {
        q: 'Kann ich die App offline nutzen?',
        a: 'Ja – alle Fragen und Erklärungen sind nach dem Download offline verfügbar. Eine Internetverbindung ist nur für den initialen Download und eventuelle Katalog-Updates nötig.',
      },
    ],
  },
];

// Alle Fragen flach für das FAQPage-Schema (Rich Results in der Google-Suche).
const allFaqs = categories.flatMap(c => c.faqs);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<BaseLayout
  title="FAQ – Häufige Fragen zum Sportbootführerschein & Funkzeugnissen"
  description="Antworten auf die häufigsten Fragen rund um Sportbootführerschein (SBF Binnen & See) sowie die Funkzeugnisse UBI, SRC und LRC: Ablauf, Kosten, Fragenkataloge und die Boatpass-App."
  lang="de"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-3xl mx-auto px-4 pt-24 pb-16">
    <h1 class="section-display-title mb-4">Häufige Fragen</h1>
    <p class="faq-subtitle text-gray-500 text-xl mb-8">Alles rund um den Sportbootführerschein, die Funkzeugnisse und die Boatpass-App</p>

    <!-- Kategorie-Navigation: Sprungmarken zu den Themenblöcken -->
    <nav aria-label="FAQ-Kategorien" class="flex flex-wrap gap-2 mb-12">
      {categories.map((cat) => (
        <a
          href={`#${cat.id}`}
          class="text-sm font-semibold text-primary bg-primary/8 border border-primary/15 rounded-full px-4 py-2 hover:bg-primary/15 transition-colors"
        >
          {cat.title}
        </a>
      ))}
    </nav>

    <div class="space-y-12">
      {categories.map((cat) => (
        <section id={cat.id} class="scroll-mt-24">
          <h2 class="text-2xl font-bold text-text mb-5">{cat.title}</h2>
          <div class="space-y-4">
            {cat.faqs.map((faq) => (
              <details class="faq-item bg-white border border-gray-100 rounded-2xl overflow-hidden group">
                <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-text list-none">
                  <h3 class="font-semibold text-base m-0">{faq.q}</h3>
                  <span class="text-primary ml-4 transition-transform group-open:rotate-180">▼</span>
                </summary>
                <div class="faq-answer px-6 pb-6 text-gray-600 leading-relaxed" set:html={faq.a} />
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:global>
  html.dark .faq-item {
    background: #181E2E;
    border-color: rgba(90, 120, 255, 0.12);
  }
  html.dark .faq-answer { color: #94A3B8; }
  html.dark .faq-subtitle { color: #64748B; }
</style>
