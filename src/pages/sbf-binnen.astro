---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/page/PageHead.astro';
import DisplayFontPreload from '../components/page/DisplayFontPreload.astro';
import PageLayout from '../components/page/PageLayout.astro';
import PageFacts from '../components/page/PageFacts.astro';
import PageLink from '../components/page/PageLink.astro';
import Icon from '../components/Icon.astro';
import CatalogSources from '../components/CatalogSources.astro';
import BoatSchoolFinder from '../components/BoatSchoolFinder.astro';
import type { IconName } from '../icons';
import { PLAY_STORE_URL, schemaOffers } from '../data/stores';

const playStoreUrl = PLAY_STORE_URL;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Binnen", "item": "https://boatpass.de/sbf-binnen/" },
  ],
};

const faqs = [
  {
    q: 'Ab wann brauche ich den SBF Binnen?',
    a: 'Der SBF Binnen ist Pflicht für Sportboote mit mehr als 11,03 kW (15 PS) Antriebsleistung auf Binnenschifffahrtsstraßen. Bei Elektroantrieben greift die Führerscheinpflicht bereits ab 7,5 kW. Eine geplante Reform soll die Grenze technologieneutral auf 11,03 kW vereinheitlichen, ist aber noch nicht in Kraft getreten. Auf einzelnen Revieren wie dem Rhein können strengere regionale Regeln gelten.',
  },
  {
    q: 'Wie läuft die SBF-Binnen-Theorieprüfung ab?',
    a: 'Du beantwortest einen Bogen mit 30 Multiple-Choice-Fragen (7 Basisfragen + 23 spezifische Binnen-Fragen) in 45 Minuten. Seit der getrennten Bewertung musst du beide Teile separat bestehen: mindestens 5 von 7 Basisfragen und mindestens 18 von 23 spezifischen Fragen richtig. Danach folgt eine kurze praktische Prüfung auf dem Wasser.',
  },
  {
    q: 'Brauche ich für den SBF Binnen einen Kurs?',
    a: 'Nein. Der offizielle ELWIS-Fragenkatalog ist frei verfügbar, du kannst die Theorie also eigenständig lernen – z. B. mit Boatpass. Eine Fahrschule ist nicht vorgeschrieben; für die Praxis reicht oft ein Übungstag auf dem Wasser.',
  },
  {
    q: 'Wie lange muss ich für den SBF Binnen lernen?',
    a: 'Bei 20–30 Minuten täglich ist die Theorie meist in 3–5 Wochen sicher beherrschbar. Wer den kompletten Fragenkatalog systematisch durcharbeitet und Fehler gezielt nachübt, ist deutlich schneller prüfungsreif.',
  },
  {
    q: 'Gilt der SBF Binnen auch auf Nord- und Ostsee?',
    a: 'Nein. Für die Küstengewässer von Nord- und Ostsee brauchst du den SBF See. Wer beide Reviere befahren möchte, kann Binnen und See in einer kombinierten Prüfung ablegen – das ist günstiger als zwei Einzelprüfungen.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// DefinedTerm-Schema: maschinenlesbare Kurzdefinition für Entity-Clarity bei
// KI-Suchmaschinen. Spiegelt den Text aus dem "Was ist der SBF Binnen?"-Abschnitt.
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": "SBF Binnen",
  "alternateName": "Sportbootführerschein Binnen",
  "description": "Der Sportbootführerschein Binnen (SBF Binnen) ist die amtliche Fahrerlaubnis für Motorboote auf deutschen Binnenschifffahrtsstraßen – Flüsse, Kanäle und Binnenseen. Er ist Pflicht für Boote mit mehr als 11,03 kW (15 PS) Motorleistung.",
  "url": "https://boatpass.de/sbf-binnen/",
  "inLanguage": "de",
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für den SBF Binnen
// (zusätzlich zur App-Auszeichnung). Alle Angaben spiegeln den Seiteninhalt.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Binnen Prüfungsvorbereitung",
  "description": "Komplette Vorbereitung auf die theoretische Prüfung zum Sportbootführerschein Binnen mit dem vollständigen amtlichen ELWIS-Fragenkatalog (253+ Fragen), Prüfungssimulation und gezieltem Fehlertraining.",
  "url": "https://boatpass.de/sbf-binnen/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Schifffahrtsrecht und Wasserstraßenordnung",
    "Vorfahrts- und Ausweichregeln",
    "Schifffahrtszeichen und Lichterführung",
    "Navigation auf Binnengewässern",
    "Amtlicher SBF-Binnen-Fragenkatalog",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": schemaOffers('sbfBinnen'),
};

// Direktvergleich Binnen vs. See als Entscheidungshilfe
const compare = [
  { label: 'Revier', binnen: 'Flüsse, Kanäle & Binnenseen', see: 'Küstengewässer Nord- & Ostsee' },
  { label: 'Pflicht ab', binnen: '11,03 kW (15 PS)', see: '11,03 kW (15 PS)' },
  { label: 'Bootslänge', binnen: 'unter Motor max. 20 m', see: 'keine Begrenzung' },
  { label: 'Theorieprüfung', binnen: '30 Fragen · 45 Min', see: '30 Fragen + Navigation · 60 Min' },
  { label: 'Navigationsaufgabe', binnen: '–', see: 'ja (Kartenaufgabe)' },
  { label: 'Prüfungsgebühr 2026', binnen: '130,78 €', see: '148,38 €' },
  { label: 'Mindestalter', binnen: '16 Jahre', see: '16 Jahre' },
];

const categories: { name: string; desc: string; count: number; icon: IconName }[] = [
  { name: 'Schifffahrtsrecht', desc: 'Vorfahrtregeln, Lichterführung & Wasserstraßenordnung', count: 124, icon: 'scale' },
  { name: 'Navigation', desc: 'Karten, Kurse, Positionen & Peilungen', count: 52, icon: 'compass' },
  { name: 'Sicherheit', desc: 'Rettungsausrüstung, Notsignale & Sicherheitsverhalten', count: 39, icon: 'shield' },
  { name: 'Signale & Zeichen', desc: 'Schallzeichen, Sichtzeichen & Flaggen', count: 28, icon: 'bell' },
  { name: 'Wetterkunde', desc: 'Wind, Wetter & Vorhersage', count: 6, icon: 'cloud' },
  { name: 'Allgemein', desc: 'Allgemeine Grundlagen & Seemannschaft', count: 4, icon: 'document' },
  { name: 'Segeln', desc: 'Segelspezifische Fragen für den Geltungsbereich Segeln', count: 47, icon: 'sailboat' },
];
---

<BaseLayout
  title="SBF Binnen lernen – App zur Theorieprüfung"
  description="Lerne für den SBF Binnen mit der Boatpass-App: offizieller ELWIS-Fragenkatalog, Prüfungssimulation & gezieltes Fehlertraining. Kostenlos starten."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-inland/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />

  <!-- Seitenkopf (PageHead, Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Sportbootführerschein Binnen"
    lede="Bereite dich mit dem offiziellen ELWIS-Fragenkatalog auf die SBF-Binnen-Prüfung vor. 3 Lernmodi, Prüfungssimulation und gezieltes Fehlertraining – kostenlos starten."
    cta
  >
    SBF Binnen lernen –<br />die smarte Lernapp
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfBinnen"
      items={[
        { k: 'Fragenkatalog', v: '253+ Fragen' },
        { k: 'Theorieprüfung', v: '30 Fragen · 45 Min' },
        { k: 'Bestehensgrenze', v: '5 von 7 Basis, 18 von 23 spezifisch' },
        { k: 'Prüfungsgebühr 2026', v: '130,78 €' },
        { k: 'Mindestalter', v: '16 Jahre' },
      ]}
    />

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section class="pg-section">
      <div class="pg-answer">
        <p class="pg-answer-label">Auf den Punkt</p>
        <p class="pg-answer-text">
          Der SBF Binnen (Sportbootführerschein Binnen) ist die amtliche Fahrerlaubnis für Motorboote mit mehr als 11,03 kW (15 PS) auf deutschen Binnenschifffahrtsstraßen. Die Theorieprüfung umfasst 30 Multiple-Choice-Fragen (7 Basis- + 23 spezifische Fragen) in 45 Minuten – bestanden ab 5 von 7 Basis- und 18 von 23 spezifischen Fragen richtig. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog (253+ Fragen); Boatpass trainiert alle Inhalte mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist SBF Binnen -->
    <section class="pg-section">
      <h2 class="pg-h2">Was ist der SBF Binnen?</h2>
      <p class="pg-p">
        Der <strong>Sportbootführerschein Binnen (SBF Binnen)</strong> ist die amtliche Fahrerlaubnis für Motorboote auf deutschen Binnenschifffahrtsstraßen – Flüsse, Kanäle und Binnenseen. Er ist Pflicht für Boote mit mehr als <strong>11,03 kW (15 PS) Motorleistung</strong>. Für Elektromotoren gilt bisher eine Grenze von 7,5 kW – eine geplante Reform soll die Schwelle technologieneutral auf einheitlich 11,03 kW anheben, ist aber noch nicht in Kraft getreten. Auf einigen Revieren (z. B. dem Rhein) gelten strengere regionale Grenzen. Wo genau die Grenze verläuft und wann du <a href="/blog/boot-fahren-ohne-fuehrerschein-15-ps/" class="pg-inline-link">ganz ohne Führerschein fahren darfst</a>, erklären wir im Detail.
      </p>
      <p class="pg-p">
        Das Mindestalter beträgt 16 Jahre. Der Schein wird vom DMYV abgenommen und ist unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section class="pg-section">
      <CatalogSources lang="de" only="binnen" />
    </section>

    <!-- Prüfungsaufbau -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF-Binnen-Prüfung: Aufbau & Bestehensgrenze</h2>
      <div class="pg-cards pg-cards--4">
        <div class="pg-card">
          <p class="pg-card-label">Theorieprüfung</p>
          <p class="pg-card-text">30 Fragen · 45 Minuten<br>Multiple Choice</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Basisfragen</p>
          <p class="pg-card-text">7 Fragen<br>mind. 5 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Spezifische Fragen</p>
          <p class="pg-card-text">23 Fragen<br>mind. 18 richtig</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-label">Fragenkatalog</p>
          <p class="pg-card-text">253+ Fragen<br>offizieller ELWIS-Katalog</p>
        </div>
      </div>
      <p class="pg-note">
        Nach der Theorie folgt eine <strong>praktische Prüfung</strong> auf dem Wasser. Die amtliche Prüfungsgebühr für den SBF Binnen beträgt 2026 <strong>130,78 €</strong> (Theorie + Praxis).
      </p>
    </section>

    <!-- Ablauf: Praxis & Anmeldung -->
    <section class="pg-section">
      <h2 class="pg-h2">Ablauf: von der Anmeldung bis zur Praxis</h2>
      <p class="pg-p">
        Du meldest dich bei einem anerkannten Prüfungsausschuss (z. B. DMYV) an. Zuerst legst du die Theorieprüfung ab, danach folgt die <strong>praktische Prüfung</strong> auf dem Wasser.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Anmeldung</p>
          <p class="pg-card-text">Antrag beim Prüfungsausschuss, Passbild und Ausweis – Mindestalter 16 Jahre.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Praktische Manöver</p>
          <p class="pg-card-text">An- und Ablegen, Wenden, Aufstoppen und das Mann-über-Bord-Manöver.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title"><a href="/blog/wichtigste-knoten-sbf/" class="pg-card-link">Knoten</a></p>
          <p class="pg-card-text">Die prüfungsrelevanten Knoten zügig anwenden (z. B. Palstek, Webeleinstek, Klampe).</p>
        </div>
      </div>
      <PageLink lang="de" href="/sbf-pruefung-ablauf/">Prüfungsablauf Schritt für Schritt</PageLink>
    </section>

    <!-- Bootsfahrschule finden -->
    <BoatSchoolFinder lang="de" variant="binnen" />

    <!-- Kosten kompakt -->
    <section class="pg-section">
      <h2 class="pg-h2">Was kostet der SBF Binnen?</h2>
      <p class="pg-p">
        Fest ist nur die amtliche <strong>Prüfungsgebühr von 130,78 €</strong> (Theorie + Praxis). Den größten Kostenblock macht der Vorbereitungskurs aus – wer die Theorie selbst mit dem offiziellen ELWIS-Katalog lernt, spart genau diesen Posten.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-kpi">130,78 €</p>
          <p class="pg-card-text">Amtliche Prüfungsgebühr</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi">≈ 500–650 €</p>
          <p class="pg-card-text">Kompletter Kurs (optional)</p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">ab 9,99 €</p>
          <p class="pg-card-text">Theorie lernen mit Boatpass</p>
        </div>
      </div>
      <PageLink lang="de" href="/sbf-kosten/">Alle SBF-Kosten im Detail</PageLink>
    </section>

    <!-- Geltungsbereich -->
    <section class="pg-section">
      <h2 class="pg-h2">Wo darf ich mit dem SBF Binnen fahren?</h2>
      <p class="pg-p">
        Der SBF Binnen gilt auf den <strong>Binnenschifffahrtsstraßen</strong> Deutschlands – also Flüssen, Kanälen und Binnenseen. Unter Motor ist die Bootslänge auf <strong>20 Meter</strong> begrenzt; für längere Fahrzeuge brauchst du ein Sportschifferzeugnis. Für die Küstengewässer von Nord- und Ostsee ist er nicht gültig – dort gilt der SBF See.
      </p>
      <div class="pg-cards pg-cards--3">
        <div class="pg-card">
          <p class="pg-card-title">Wo er gilt</p>
          <p class="pg-card-text">Flüsse, Kanäle und Binnenseen auf deutschen Binnenschifffahrtsstraßen.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Voraussetzungen</p>
          <p class="pg-card-text">Mindestalter 16 Jahre. Der Schein wird vom DMYV abgenommen und gilt unbegrenzt.</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Regionale Grenzen</p>
          <p class="pg-card-text">Auf manchen Revieren (z. B. Rhein) gelten strengere Leistungsgrenzen – vorher prüfen.</p>
        </div>
      </div>
    </section>

    <!-- Vergleich Binnen vs. See -->
    <section class="pg-section">
      <h2 class="pg-h2">SBF Binnen oder See – was brauchst du?</h2>
      <p class="pg-p">
        Binnen und See sind zwei eigenständige Scheine. Wer beide Reviere befahren will, kann sie in einer
        <strong>kombinierten Prüfung</strong> günstiger zusammen ablegen (rund 178,61 € statt zweimal einzeln).
      </p>
      <!-- min-width aktiviert das horizontale Scrollen des overflow-x-Wrappers auf schmalen Screens (wie AppComparisonTable/CatalogSources). Ohne min-width wurde die Tabelle stattdessen auf Handybreite gequetscht: die drei Spalten brachen mehrzeilig um und wurden unleserlich. -->
      <div class="pg-table">
        <table>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">SBF Binnen</th>
              <th scope="col">SBF See</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.binnen}</td>
                <td>{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <PageLink lang="de" href="/sbf-see/" class="pg-link--spaced">SBF See im Detail ansehen</PageLink>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zum SBF Binnen</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section class="pg-section">
      <h2 class="pg-h2">Lernen nach Kategorie</h2>
      <p class="pg-p">
        Der offizielle Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p class="pg-note pg-note--sm">
        Quelle: amtlicher Fragenkatalog (DSV/DMYV) auf <a href="https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-node.html" target="_blank" rel="noopener noreferrer" class="pg-inline-link">elwis.de</a>.
      </p>
      <div class="pg-rows">
        {categories.map(c => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={c.icon} size={20} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{c.name}</p>
              <p class="pg-row-text">{c.desc}</p>
            </div>
            <span class="pg-pill">{c.count} Fragen</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Wie die App hilft -->
    <section class="pg-section">
      <h2 class="pg-h2">So hilft Boatpass beim SBF Binnen</h2>
      <div class="pg-rows">
        {([
          { icon: 'book', title: 'Vollständiger ELWIS-Katalog', desc: 'Alle 253+ offiziellen Fragen für SBF Binnen – immer aktuell, direkt in der App.' },
          { icon: 'target', title: 'Prüfungssimulation', desc: 'Echte Prüfungsbedingungen: 30 Fragen, 45 Minuten, Bestehensgrenze – genau wie am Prüfungstag.' },
          { icon: 'refresh', title: 'Fehlertraining', desc: 'Trainiere gezielt die Fragen, die du noch nicht kannst. Kein Zeitverschwendung mit bereits gelernten Inhalten.' },
          { icon: 'chart', title: 'Fortschrittsanzeige', desc: 'Sieh jederzeit, wie weit du bist – nach Kategorie aufgeschlüsselt.' },
        ] satisfies { icon: IconName; title: string; desc: string }[]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Artikel</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen-pruefungsfragen/">SBF Binnen Prüfungsfragen üben<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-binnen-app/">SBF-Binnen-Apps im Vergleich<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-vorbereitung-wie-lange/">Wie lange muss ich für den SBF lernen?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/sbf-binnen-vs-see/">SBF Binnen vs. SBF See – was ist der Unterschied?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/motorboot-oder-segelboot-welcher-sbf/">Motorboot oder Segelboot – welcher SBF und welche Praxis?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/ausweichregeln-vorfahrt-wasser/">Ausweichregeln auf dem Wasser – wer muss ausweichen?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/schallsignale-sbf-erklaert/">Schallsignale beim SBF: See & Binnen im Überblick<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/lichterfuehrung-erklaert/">Lichterführung erklärt – welche Lichter führt ein Boot nachts?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/verhalten-bei-verminderter-sicht-nebel/">Verminderte Sicht und Nebel: richtig verhalten mit dem Sportbootführerschein<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/schleppverband-besondere-fahrzeuge-erkennen/">Schleppverband und besondere Fahrzeuge – Signalkörper am Tag erkennen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/anlegen-ablegen-hafenmanoever/">Anlegen und Ablegen: Hafenmanöver für Einsteiger<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/5-tipps-sbf-bestehen/">Mit diesen 5 Tipps die SBF-Prüfung beim ersten Versuch bestehen<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
