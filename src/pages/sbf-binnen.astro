---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CatalogSources from '../components/CatalogSources.astro';
import BoatSchoolFinder from '../components/BoatSchoolFinder.astro';
import type { IconName } from '../icons';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "SBF Binnen", "item": "https://boatpass.de/sbf-binnen/" },
  ],
};

const faqs = [
  {
    q: 'Ab wann brauche ich den SBF Binnen?',
    a: 'Der SBF Binnen ist Pflicht für Sportboote mit mehr als 11,03 kW (15 PS) Antriebsleistung auf Binnenschifffahrtsstraßen. Bei Elektroantrieben greift die Führerscheinpflicht bereits ab 7,5 kW. Eine geplante Reform soll die Grenze technologieneutral auf 11,03 kW vereinheitlichen, ist aber noch nicht in Kraft getreten. Auf einzelnen Revieren wie dem Rhein können strengere regionale Regeln gelten.',
  },
  {
    q: 'Wie läuft die SBF-Binnen-Theorieprüfung ab?',
    a: 'Du beantwortest einen Bogen mit 30 Multiple-Choice-Fragen (7 Basisfragen + 23 spezifische Binnen-Fragen) in 45 Minuten. Seit der getrennten Bewertung musst du beide Teile separat bestehen: mindestens 5 von 7 Basisfragen und mindestens 18 von 23 spezifischen Fragen richtig. Danach folgt eine kurze praktische Prüfung auf dem Wasser.',
  },
  {
    q: 'Brauche ich für den SBF Binnen einen Kurs?',
    a: 'Nein. Der offizielle ELWIS-Fragenkatalog ist frei verfügbar, du kannst die Theorie also eigenständig lernen – z. B. mit Boatpass. Eine Fahrschule ist nicht vorgeschrieben; für die Praxis reicht oft ein Übungstag auf dem Wasser.',
  },
  {
    q: 'Wie lange muss ich für den SBF Binnen lernen?',
    a: 'Bei 20–30 Minuten täglich ist die Theorie meist in 3–5 Wochen sicher beherrschbar. Wer den kompletten Fragenkatalog systematisch durcharbeitet und Fehler gezielt nachübt, ist deutlich schneller prüfungsreif.',
  },
  {
    q: 'Gilt der SBF Binnen auch auf Nord- und Ostsee?',
    a: 'Nein. Für die Küstengewässer von Nord- und Ostsee brauchst du den SBF See. Wer beide Reviere befahren möchte, kann Binnen und See in einer kombinierten Prüfung ablegen – das ist günstiger als zwei Einzelprüfungen.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

// Course-Schema: markiert die Seite eindeutig als Lernkurs für den SBF Binnen
// (zusätzlich zur App-Auszeichnung). Alle Angaben spiegeln den Seiteninhalt.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "SBF Binnen Prüfungsvorbereitung",
  "description": "Komplette Vorbereitung auf die theoretische Prüfung zum Sportbootführerschein Binnen mit dem vollständigen amtlichen ELWIS-Fragenkatalog (253+ Fragen), Prüfungssimulation und gezieltem Fehlertraining.",
  "url": "https://boatpass.de/sbf-binnen/",
  "inLanguage": "de",
  "provider": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
  },
  "educationalLevel": "Beginner",
  "teaches": [
    "Schifffahrtsrecht und Wasserstraßenordnung",
    "Vorfahrts- und Ausweichregeln",
    "Schifffahrtszeichen und Lichterführung",
    "Navigation auf Binnengewässern",
    "Amtlicher SBF-Binnen-Fragenkatalog",
  ],
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "online",
    "courseWorkload": "PT12H",
    "instructor": {
      "@type": "Person",
      "name": "Marius Gehler",
    },
  },
  "offers": {
    "@type": "Offer",
    "category": "EducationApplication",
    "price": "9.99",
    "priceCurrency": "EUR",
    "url": "https://play.google.com/store/apps/details?id=com.boatpass.app",
  },
};

// Direktvergleich Binnen vs. See als Entscheidungshilfe
const compare = [
  { label: 'Revier', binnen: 'Flüsse, Kanäle & Binnenseen', see: 'Küstengewässer Nord- & Ostsee' },
  { label: 'Pflicht ab', binnen: '11,03 kW (15 PS)', see: '11,03 kW (15 PS)' },
  { label: 'Bootslänge', binnen: 'unter Motor max. 20 m', see: 'keine Begrenzung' },
  { label: 'Theorieprüfung', binnen: '30 Fragen · 45 Min', see: '30 Fragen + Navigation · 60 Min' },
  { label: 'Navigationsaufgabe', binnen: '–', see: 'ja (Kartenaufgabe)' },
  { label: 'Prüfungsgebühr 2026', binnen: '130,78 €', see: '148,38 €' },
  { label: 'Mindestalter', binnen: '16 Jahre', see: '16 Jahre' },
];

const categories: { name: string; desc: string; count: number; icon: IconName; color: string; bg: string }[] = [
  { name: 'Schifffahrtsrecht', desc: 'Vorfahrtregeln, Lichterführung & Wasserstraßenordnung', count: 124, icon: 'scale', color: '#6366F1', bg: 'rgba(99,102,241,0.10)' },
  { name: 'Navigation', desc: 'Karten, Kurse, Positionen & Peilungen', count: 52, icon: 'compass', color: '#0D9488', bg: 'rgba(13,148,136,0.10)' },
  { name: 'Sicherheit', desc: 'Rettungsausrüstung, Notsignale & Sicherheitsverhalten', count: 39, icon: 'shield', color: '#E11D48', bg: 'rgba(225,29,72,0.10)' },
  { name: 'Signale & Zeichen', desc: 'Schallzeichen, Sichtzeichen & Flaggen', count: 28, icon: 'bell', color: '#D97706', bg: 'rgba(217,119,6,0.10)' },
  { name: 'Wetterkunde', desc: 'Wind, Wetter & Vorhersage', count: 6, icon: 'cloud', color: '#0284C7', bg: 'rgba(2,132,199,0.10)' },
  { name: 'Allgemein', desc: 'Allgemeine Grundlagen & Seemannschaft', count: 4, icon: 'document', color: '#64748B', bg: 'rgba(100,116,139,0.10)' },
  { name: 'Segeln', desc: 'Segelspezifische Fragen für den Geltungsbereich Segeln', count: 47, icon: 'sailboat', color: '#0EA5E9', bg: 'rgba(14,165,233,0.10)' },
];
---

<BaseLayout
  title="SBF Binnen lernen – App zur Theorieprüfung"
  description="Lerne für den SBF Binnen mit der Boatpass-App. Offizieller ELWIS-Fragenkatalog, Prüfungssimulation & Fehlertraining. Kostenlos starten."
  lang="de"
  altUrl="https://boatpass.de/en/sbf-inland/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <!-- Hero -->
  <div style="background:#F0F4FA; padding:100px 24px 60px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:24px;">
        Sportbootführerschein Binnen
      </div>
      <h1 style="font-size:clamp(32px,5vw,52px); font-weight:900; letter-spacing:-0.045em; color:#1A1F36; line-height:1.1; margin-bottom:20px;">
        SBF Binnen lernen –<br>die smarte Lernapp
      </h1>
      <p style="font-size:18px; color:#656B78; line-height:1.65; max-width:560px; margin:0 auto 36px;">
        Bereite dich mit dem offiziellen ELWIS-Fragenkatalog auf die SBF-Binnen-Prüfung vor.
        3 Lernmodi, Prüfungssimulation und gezieltes Fehlertraining – kostenlos starten.
      </p>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg,#1A1F36,#3366FF); color:white; font-weight:700; font-size:16px; padding:16px 32px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.2);">
        ▶&nbsp;Kostenlos im Play Store
      </a>
    </div>
  </div>

  <div style="max-width:800px; margin:0 auto; padding:60px 24px 100px;">

    <!-- Answer-Snippet: kurze, zitierfähige Direktantwort für Suchmaschinen & KI -->
    <section style="margin-bottom:48px;">
      <div style="background:white; border:1px solid rgba(51,102,255,0.18); border-left:4px solid #3366FF; border-radius:16px; padding:24px 26px;">
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">Auf den Punkt</div>
        <p style="font-size:17px; color:#1A1F36; line-height:1.7; margin:0; font-weight:600;">
          Der SBF Binnen (Sportbootführerschein Binnen) ist die amtliche Fahrerlaubnis für Motorboote mit mehr als 11,03 kW (15 PS) auf deutschen Binnenschifffahrtsstraßen. Die Theorieprüfung umfasst 30 Multiple-Choice-Fragen (7 Basis- + 23 spezifische Fragen) in 45 Minuten – bestanden ab 5 von 7 Basis- und 18 von 23 spezifischen Fragen richtig. Geprüft wird aus dem amtlichen ELWIS-Fragenkatalog (253+ Fragen); Boatpass trainiert alle Inhalte mit Prüfungssimulation und Fehlertraining.
        </p>
      </div>
    </section>

    <!-- Was ist SBF Binnen -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Was ist der SBF Binnen?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:12px;">
        Der <strong>Sportbootführerschein Binnen (SBF Binnen)</strong> ist die amtliche Fahrerlaubnis für Motorboote auf deutschen Binnenschifffahrtsstraßen – Flüsse, Kanäle und Binnenseen. Er ist Pflicht für Boote mit mehr als <strong>11,03 kW (15 PS) Motorleistung</strong>. Für Elektromotoren gilt bisher eine Grenze von 7,5 kW – eine geplante Reform soll die Schwelle technologieneutral auf einheitlich 11,03 kW anheben, ist aber noch nicht in Kraft getreten. Auf einigen Revieren (z. B. dem Rhein) gelten strengere regionale Grenzen. Wo genau die Grenze verläuft und wann du <a href="/blog/boot-fahren-ohne-fuehrerschein-15-ps/" style="color:#3366FF; text-decoration:underline;">ganz ohne Führerschein fahren darfst</a>, erklären wir im Detail.
      </p>
      <p style="font-size:16px; color:#4B5563; line-height:1.75;">
        Das Mindestalter beträgt 16 Jahre. Der Schein wird vom DMYV abgenommen und ist unbegrenzt gültig.
      </p>
    </section>

    <!-- Quellen-Transparenz: amtlicher Fragenkatalog -->
    <section style="margin-bottom:48px;">
      <CatalogSources lang="de" only="binnen" />
    </section>

    <!-- Prüfungsaufbau -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">SBF-Binnen-Prüfung: Aufbau & Bestehensgrenze</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:20px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Theorieprüfung</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">30 Fragen · 45 Minuten<br>Multiple Choice</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Basisfragen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">7 Fragen<br>mind. 5 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Spezifische Fragen</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">23 Fragen<br>mind. 18 richtig</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:24px;">
          <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Fragenkatalog</div>
          <div style="font-size:15px; color:#4B5563; line-height:1.6;">253+ Fragen<br>offizieller ELWIS-Katalog</div>
        </div>
      </div>
      <p style="font-size:15px; color:#656B78; line-height:1.7;">
        Nach der Theorie folgt eine <strong>praktische Prüfung</strong> auf dem Wasser. Die amtliche Prüfungsgebühr für den SBF Binnen beträgt 2026 <strong>130,78 €</strong> (Theorie + Praxis).
      </p>
    </section>

    <!-- Ablauf: Praxis & Anmeldung -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Ablauf: von der Anmeldung bis zur Praxis</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Du meldest dich bei einem anerkannten Prüfungsausschuss (z. B. DMYV) an. Zuerst legst du die Theorieprüfung ab, danach folgt die <strong>praktische Prüfung</strong> auf dem Wasser.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Anmeldung</div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">Antrag beim Prüfungsausschuss, Passbild und Ausweis – Mindestalter 16 Jahre.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Praktische Manöver</div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">An- und Ablegen, Wenden, Aufstoppen und das Mann-über-Bord-Manöver.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;"><a href="/blog/wichtigste-knoten-sbf/" style="color:inherit; text-decoration:underline;">Knoten</a></div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">Die prüfungsrelevanten Knoten zügig anwenden (z. B. Palstek, Webeleinstek, Klampe).</div>
        </div>
      </div>
      <a href="/sbf-pruefung-ablauf/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">Prüfungsablauf Schritt für Schritt →</a>
    </section>

    <!-- Bootsfahrschule finden -->
    <BoatSchoolFinder lang="de" variant="binnen" />

    <!-- Kosten kompakt -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Was kostet der SBF Binnen?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Fest ist nur die amtliche <strong>Prüfungsgebühr von 130,78 €</strong> (Theorie + Praxis). Den größten Kostenblock macht der Vorbereitungskurs aus – wer die Theorie selbst mit dem offiziellen ELWIS-Katalog lernt, spart genau diesen Posten.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:18px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">130,78 €</div>
          <div style="font-size:14px; color:#656B78; line-height:1.55; margin-top:4px;">Amtliche Prüfungsgebühr</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#1A1F36;">≈ 500–650 €</div>
          <div style="font-size:14px; color:#656B78; line-height:1.55; margin-top:4px;">Kompletter Kurs (optional)</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-size:22px; font-weight:900; color:#3366FF;">ab 9,99 €</div>
          <div style="font-size:14px; color:#656B78; line-height:1.55; margin-top:4px;">Theorie lernen mit Boatpass</div>
        </div>
      </div>
      <a href="/sbf-kosten/" style="display:inline-flex; align-items:center; gap:8px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">Alle SBF-Kosten im Detail →</a>
    </section>

    <!-- Geltungsbereich -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:16px;">Wo darf ich mit dem SBF Binnen fahren?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Der SBF Binnen gilt auf den <strong>Binnenschifffahrtsstraßen</strong> Deutschlands – also Flüssen, Kanälen und Binnenseen. Unter Motor ist die Bootslänge auf <strong>20 Meter</strong> begrenzt; für längere Fahrzeuge brauchst du ein Sportschifferzeugnis. Für die Küstengewässer von Nord- und Ostsee ist er nicht gültig – dort gilt der SBF See.
      </p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;">
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Wo er gilt</div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">Flüsse, Kanäle und Binnenseen auf deutschen Binnenschifffahrtsstraßen.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Voraussetzungen</div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">Mindestalter 16 Jahre. Der Schein wird vom DMYV abgenommen und gilt unbegrenzt.</div>
        </div>
        <div style="background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; padding:22px;">
          <div style="font-weight:700; color:#1A1F36; margin-bottom:6px;">Regionale Grenzen</div>
          <div style="font-size:15px; color:#656B78; line-height:1.65;">Auf manchen Revieren (z. B. Rhein) gelten strengere Leistungsgrenzen – vorher prüfen.</div>
        </div>
      </div>
    </section>

    <!-- Vergleich Binnen vs. See -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">SBF Binnen oder See – was brauchst du?</h2>
      <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">
        Binnen und See sind zwei eigenständige Scheine. Wer beide Reviere befahren will, kann sie in einer
        <strong>kombinierten Prüfung</strong> günstiger zusammen ablegen (rund 178,61 € statt zweimal einzeln).
      </p>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:15px; background:white; border:1px solid rgba(51,102,255,0.10); border-radius:16px; overflow:hidden;">
          <thead>
            <tr style="background:rgba(26,31,54,0.04);">
              <th style="text-align:left; padding:14px 18px; font-weight:700; color:#1A1F36;"></th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF Binnen</th>
              <th style="text-align:left; padding:14px 18px; font-weight:800; color:#1A1F36;">SBF See</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row, i) => (
              <tr style={`border-top:1px solid rgba(51,102,255,0.08);${i % 2 ? ' background:rgba(26,31,54,0.02);' : ''}`}>
                <td style="padding:13px 18px; font-weight:600; color:#1A1F36;">{row.label}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.binnen}</td>
                <td style="padding:13px 18px; color:#4B5563;">{row.see}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/sbf-see/" style="display:inline-flex; align-items:center; gap:8px; margin-top:18px; color:#3366FF; font-weight:700; font-size:15px; text-decoration:none;">SBF See im Detail ansehen →</a>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:20px;">Häufige Fragen zum SBF Binnen</h2>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {faqs.map(f => (
          <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
            <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.q}</h3>
            <div style="font-size:15px; color:#656B78; line-height:1.7;">{f.a}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Lernen nach Kategorie -->
    <section style="margin-bottom:48px;">
      <h2 class="content-section-title" style="margin-bottom:8px;">Lernen nach Kategorie</h2>
      <p style="font-size:16px; color:#656B78; line-height:1.6; margin-bottom:20px;">
        Der offizielle Fragenkatalog umfasst {categories.reduce((s, c) => s + c.count, 0)} Fragen in {categories.length} Themengebieten – übe gezielt nach Schwachstellen.
      </p>
      <p style="font-size:14px; color:#9CA3AF; line-height:1.6; margin-top:-8px; margin-bottom:20px;">
