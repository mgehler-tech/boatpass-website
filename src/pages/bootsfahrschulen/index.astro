---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import Icon from '../../components/Icon.astro';
import { cities } from '../../data/boat-schools';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Bootsfahrschulen", "item": "https://boatpass.de/bootsfahrschulen/" },
  ],
};

const faqs = [
  {
    q: 'Brauche ich eine Bootsfahrschule, um den Sportbootführerschein zu machen?',
    a: 'Nein, ein Fahrschulbesuch ist gesetzlich nicht vorgeschrieben. Du kannst die Theorie eigenständig lernen, z. B. mit der BoatPass-App. Für die praktische Prüfung empfiehlt sich jedoch eine Fahrschule, da du dort das Fahren auf dem Wasser, Manöver und Knoten unter Anleitung übst.',
  },
  {
    q: 'Was kostet eine Bootsfahrschule?',
    a: 'Ein Komplettkurs (Theorie + Praxis) kostet je nach Stadt und Umfang zwischen 400 und 800 Euro pro Schein. Die amtlichen Prüfungsgebühren kommen mit ca. 130 Euro (Binnen) bzw. 148 Euro (See) hinzu. Wer die Theorie selbst lernt, spart den größten Posten.',
  },
  {
    q: 'Was ist der Unterschied zwischen Bootsfahrschule und BoatPass?',
    a: 'BoatPass ist eine Lern-App für die theoretische Prüfungsvorbereitung mit dem offiziellen ELWIS-Fragenkatalog. Eine Bootsfahrschule bietet zusätzlich praktische Ausbildung auf dem Wasser und übernimmt oft die Prüfungsanmeldung. Beides ergänzt sich ideal.',
  },
  {
    q: 'Wie finde ich eine gute Bootsfahrschule in meiner Stadt?',
    a: 'Achte auf Bewertungen, Erfahrung und ob die Schule vom DMYV oder DSV anerkannt ist. Vergleiche Preise und frage nach, ob Praxisstunden auf dem Gewässer stattfinden, das du später befahren möchtest. Unsere Stadtseiten verlinken direkt auf Google Maps, um Fahrschulen in deiner Nähe zu finden.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

---

<BaseLayout
  title="Bootsfahrschulen in Deutschland – SBF finden"
  description="Finde eine Bootsfahrschule in deiner Stadt: Berlin, Hamburg, München, Köln und mehr. Infos zu Gewässern, Prüfungsorten und Kosten für den SBF."
  lang="de"
  altUrl="https://boatpass.de/en/boat-schools/"
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Seitenkopf und breite Spalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow="Fahrschule finden"
    lede="Mit BoatPass lernst du die komplette Theorie für den Sportbootführerschein. Für die praktische Ausbildung auf dem Wasser brauchst du eine Bootsfahrschule – finde die passende in deiner Stadt."
  >
    Bootsfahrschule<br />in deiner Nähe
  </PageHead>

  <PageLayout variant="wide">

    <!-- Info-Box -->
    <div class="pg-answer pg-answer--icon">
      <span class="pg-row-icon"><Icon name="lightbulb" size={20} strokeWidth={1.75} /></span>
      <div class="pg-answer-body">
        <p class="pg-card-title">Theorie + Praxis</p>
        <p class="pg-card-text">
          <strong>BoatPass</strong> = Theorie lernen (offizieller ELWIS-Fragenkatalog, Prüfungssimulation, Fehlertraining).
          <strong>Bootsfahrschule</strong> = Praxisausbildung auf dem Wasser + Prüfungsanmeldung.
          Beides zusammen ist der schnellste Weg zum Sportbootführerschein.
        </p>
      </div>
    </div>

    <!-- Städte-Grid -->
    <section class="pg-section">
      <h2 class="pg-h2">
        Bootsfahrschulen nach Stadt
      </h2>
      <p class="pg-p">
        Wähle deine Stadt und erfahre alles über Gewässer, Prüfungsorte und Bootsfahrschulen vor Ort.
      </p>
      <div class="city-grid">
        {cities.map(city => (
          <a href={`/bootsfahrschulen/${city.slug}/`} class="city-card">
            <div class="city-icon">
              <Icon name="mapPin" size={26} strokeWidth={1.75} />
            </div>
            <div class="city-name">{city.name}</div>
            <span class="pg-pill">{city.state}</span>
            <div class="city-waterways">{city.waterways.de}</div>
            <div class="city-link">Mehr erfahren<Icon name="chevronRight" size={16} strokeWidth={2.25} /></div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="pg-section">
      <h2 class="pg-h2">Häufige Fragen zur Bootsfahrschule</h2>
      <div class="pg-faq">
        {faqs.map(f => (
          <div class="pg-faq-item">
            <h3 class="pg-h3">{f.q}</h3>
            <p class="pg-card-text">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Weiterführende Artikel -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Artikel</h2>
      <ul class="pg-related">
        <li><a href="/sbf-binnen/">SBF Binnen lernen mit BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-see/">SBF See lernen mit BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/fuehrerscheine/">Alle Bootsführerscheine im Überblick<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

