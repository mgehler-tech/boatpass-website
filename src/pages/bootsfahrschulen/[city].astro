---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import PageLayout from '../../components/page/PageLayout.astro';
import PageFacts from '../../components/page/PageFacts.astro';
import DisplayFontPreload from '../../components/page/DisplayFontPreload.astro';
import Icon from '../../components/Icon.astro';
import { cities, mapsSearchUrl } from '../../data/boat-schools';
import type { BoatSchoolCity } from '../../data/boat-schools';
import { PLAY_STORE_URL } from '../../data/stores';

export function getStaticPaths() {
  return cities.map(city => ({ params: { city: city.slug }, props: { city } }));
}

interface Props { city: BoatSchoolCity }
const { city } = Astro.props;

const playStoreUrl = PLAY_STORE_URL;

// Kennzahlen der Seitenleiste, wörtlich aus den Stadtdaten (Spec Runde 3, 3.3).
const cityFacts = [
  { k: 'Bundesland', v: city.state },
  { k: 'Gewässer', v: city.waterways.de },
  { k: 'Benötigter Schein', v: licenceLabel(city.variant) },
  ...(city.schools.length ? [{ k: 'Bootsfahrschulen vor Ort', v: `${city.schools.length}` }] : []),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://boatpass.de/" },
    { "@type": "ListItem", "position": 2, "name": "Bootsfahrschulen", "item": "https://boatpass.de/bootsfahrschulen/" },
    { "@type": "ListItem", "position": 3, "name": city.name, "item": `https://boatpass.de/bootsfahrschulen/${city.slug}/` },
  ],
};

const faqSchema = city.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": city.faq.map(f => ({
    "@type": "Question",
    "name": f.q.de,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.de },
  })),
} : null;

function licenceLabel(variant: 'coastal' | 'inland' | 'both'): string {
  if (variant === 'coastal') return 'SBF See';
  if (variant === 'inland') return 'SBF Binnen';
  return 'SBF Binnen & SBF See';
}

function licenceDescription(variant: 'coastal' | 'inland' | 'both', name: string): string {
  if (variant === 'coastal') {
    return `Für die Küstengewässer rund um ${name} brauchst du den Sportbootführerschein See (SBF See). Er berechtigt zur Fahrt auf den Seeschifffahrtsstraßen von Nord- und Ostsee.`;
  }
  if (variant === 'inland') {
    return `Für die Binnengewässer rund um ${name} brauchst du den Sportbootführerschein Binnen (SBF Binnen) ab 15 PS. Er gilt auf Flüssen, Kanälen und Seen in ganz Deutschland.`;
  }
  return `In ${name} sind sowohl Binnengewässer als auch Küstengewässer erreichbar. Für Flüsse und Seen brauchst du den SBF Binnen, für die Küste den SBF See. Viele Fahrschulen bieten die Kombination beider Scheine an.`;
}

function licenceLinks(variant: 'coastal' | 'inland' | 'both'): { href: string; label: string }[] {
  if (variant === 'coastal') return [{ href: '/sbf-see/', label: 'SBF See im Detail' }];
  if (variant === 'inland') return [{ href: '/sbf-binnen/', label: 'SBF Binnen im Detail' }];
  return [
    { href: '/sbf-binnen/', label: 'SBF Binnen im Detail' },
    { href: '/sbf-see/', label: 'SBF See im Detail' },
  ];
}
---

<BaseLayout
  title={`Bootsfahrschulen in ${city.name} – SBF-Kurse`}
  description={city.metaDescription.de}
  lang="de"
  altUrl={`https://boatpass.de/en/boat-schools/${city.slug}/`}
>
  <DisplayFontPreload slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Seitenkopf und Lesespalte (Spec Runde 2, 5.3) -->
  <PageHead
    lang="de"
    eyebrow={city.state}
    lede={city.intro.de}
    ctaLabel="Kostenlos laden"
    cta
  >
    Bootsfahrschulen<br />in {city.name}
  </PageHead>

  <PageLayout>
    <PageFacts
      slot="aside"
      lang="de"
      title="Auf einen Blick"
      product="sbfBinnen"
      from
      items={cityFacts}
    />

    <!-- Gewässer -->
    <section class="pg-section">
      <h2 class="pg-h2">Gewässer in {city.name}</h2>
      <p class="pg-p">
        {city.waterways.de} – {licenceDescription(city.variant, city.name)}
      </p>
      <div class="pg-cards pg-cards--2">
        <div class="pg-card">
          <p class="pg-card-title">Gewässer</p>
          <p class="pg-card-text">{city.waterways.de}</p>
        </div>
        <div class="pg-card">
          <p class="pg-card-title">Benötigter Schein</p>
          <p class="pg-card-text">{licenceLabel(city.variant)}</p>
        </div>
      </div>
      <ul class="pg-related">
        {licenceLinks(city.variant).map(link => (
          <li><a href={link.href}>{link.label}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        ))}
      </ul>
    </section>

    <!-- Bootsfahrschulen -->
    <section class="pg-section">
      <h2 class="pg-h2">Bootsfahrschulen in {city.name}</h2>
      <p class="pg-p">
        {city.schools.length > 0
          ? `Hier findest du ${city.schools.length} Bootsfahrschulen in ${city.name}, die auf den Sportbootführerschein vorbereiten.`
          : `In ${city.name} gibt es mehrere Bootsfahrschulen, die auf den Sportbootführerschein vorbereiten.`}
      </p>

      {city.schools.length > 0 && (
        <div class="pg-schools">
          {city.schools.map(school => (
            <div class="pg-school">
              <div class="pg-school-head">
                <span class="pg-row-icon pg-row-icon--sm">
                  <Icon name="mapPin" size={18} strokeWidth={1.75} />
                </span>
                <div class="pg-row-body">
                  <h3 class="pg-card-title">{school.name}</h3>
                  <p class="pg-row-text">{school.address}</p>
                </div>
              </div>
              <div class="pg-school-tags">
                {school.licenses.map(lic => (
                  <span class="pg-pill">{lic}</span>
                ))}
              </div>
              <div class="pg-school-actions">
                <a href={school.website} target="_blank" rel="noopener noreferrer" class="pg-school-link">
                  <Icon name="globe" size={15} strokeWidth={1.75} />
                  Website
                </a>
                {school.phone && (
                  <a href={`tel:${school.phone.replace(/\s/g, '')}`} class="pg-school-link pg-school-link--muted">
                    <Icon name="phone" size={15} strokeWidth={1.75} />
                    {school.phone}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      <a href={mapsSearchUrl(city.mapsQuery)} target="_blank" rel="noopener noreferrer" class="pg-banner">
        <span class="pg-banner-text">
          <span class="pg-eyebrow">Google Maps</span>
          <span class="pg-banner-title">Weitere Bootsfahrschulen in {city.name}</span>
          <span class="pg-banner-sub">Alle Fahrschulen, Bewertungen und Kontaktdaten auf Google Maps anzeigen.</span>
        </span>
        <span class="h-btn h-btn--sm pg-banner-cta">Karte öffnen<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></span>
      </a>
    </section>

    <!-- Prüfung -->
    <section class="pg-section">
      <h2 class="pg-h2">Prüfung in {city.name}</h2>
      <p class="pg-p">
        {city.examInfo.de}
      </p>
      <div class="pg-cards pg-cards--2">
        <div class="pg-card">
          <p class="pg-kpi">
            {city.variant === 'coastal' ? '148,38' : city.variant === 'inland' ? '130,78' : '178,61'} &euro;
          </p>
          <p class="pg-card-text">
            Amtliche Prüfungsgebühr {city.variant === 'both' ? '(Kombi, eine gemeinsame Prüfung; an getrennten Tagen 185,67 €)' : city.variant === 'coastal' ? '(See)' : '(Binnen)'}
          </p>
        </div>
        <div class="pg-card">
          <p class="pg-kpi pg-kpi--accent">ab 9,99 &euro;</p>
          <p class="pg-card-text">Theorie lernen mit BoatPass</p>
        </div>
      </div>
    </section>

    <!-- Theorie mit BoatPass -->
    <section class="pg-section">
      <h2 class="pg-h2">Theorie mit BoatPass lernen</h2>
      <p class="pg-p">
        Bereite dich eigenständig auf die Theorieprüfung vor – mit dem offiziellen ELWIS-Fragenkatalog,
        Prüfungssimulation und gezieltem Fehlertraining. So sparst du den Theorie-Teil der Fahrschule
        und lernst flexibel in deinem eigenen Tempo.
      </p>
      <div class="pg-rows">
        {([
          { icon: 'book' as const, title: 'Offizieller ELWIS-Fragenkatalog', desc: `Alle amtlichen Prüfungsfragen für den ${licenceLabel(city.variant)} – immer aktuell.` },
          { icon: 'target' as const, title: 'Prüfungssimulation', desc: 'Echte Prüfungsbedingungen mit Timer und separater Bestehensgrenze.' },
          { icon: 'refresh' as const, title: 'Fehlertraining', desc: 'Nur die Fragen üben, die du noch nicht sicher kannst.' },
        ]).map(f => (
          <div class="pg-row">
            <span class="pg-row-icon">
              <Icon name={f.icon} size={21} strokeWidth={1.75} />
            </span>
            <div class="pg-row-body">
              <p class="pg-row-title">{f.title}</p>
              <p class="pg-row-text">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="h-btn h-btn--sm">Kostenlos laden<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /></a>
    </section>

    <!-- FAQ -->
    {city.faq.length > 0 && (
      <section class="pg-section">
        <h2 class="pg-h2">Häufige Fragen zu Bootsfahrschulen in {city.name}</h2>
        <div class="pg-faq">
          {city.faq.map(f => (
            <div class="pg-faq-item">
              <h3 class="pg-h3">{f.q.de}</h3>
              <p class="pg-card-text">{f.a.de}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Interne Links -->
    <section class="pg-section pg-section--related">
      <h2 class="pg-h2 pg-h2--sm">Weiterführende Artikel</h2>
      <ul class="pg-related">
        <li><a href="/bootsfahrschulen/">Alle Bootsfahrschulen in Deutschland<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/blog/wassersport-reviere-deutschland/">Wassersport-Reviere in Deutschland: Wo darfst du mit dem SBF fahren?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        {city.variant !== 'coastal' && (
          <li><a href="/sbf-binnen/">SBF Binnen lernen mit BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        )}
        {city.variant !== 'inland' && (
          <li><a href="/sbf-see/">SBF See lernen mit BoatPass<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        )}
        <li><a href="/sbf-kosten/">Was kostet der Sportbootführerschein?<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/sbf-pruefung-ablauf/">SBF Prüfung: Ablauf von Theorie & Praxis<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
        <li><a href="/fuehrerscheine/">Alle Bootsführerscheine im Überblick<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a></li>
      </ul>
    </section>

  </PageLayout>
</BaseLayout>

