---
import BaseLayout from './BaseLayout.astro';
import BlogInlineCta from '../components/BlogInlineCta.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'de' | 'en';
}

const { post, lang } = Astro.props;
const { title, seoTitle, description, date, updated, readingTime, tags, author = 'Marius Gehler', image, imageAlt, altSlug } = post.data;
// <title> nutzt die Kurzform (falls gesetzt), H1 und Schema behalten den vollen Titel.
const metaTitle = seoTitle ?? title;

// Verwandte Artikel: gleiche Sprache, gewichtet nach gemeinsamen Tags, dann nach Datum. Max. 3.
// Cross-Linking zwischen Blogposts gegen "Sackgassen-Seiten" (verbessert Crawling/Indexierung).
const relatedCandidates = await getCollection('blog', (e) => e.data.lang === lang && e.id !== post.id);
const relatedPosts = relatedCandidates
  .map((p) => ({ p, shared: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.shared - a.shared || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map(({ p }) => ({
    title: p.data.title,
    readingTime: p.data.readingTime,
    href: (lang === 'de' ? '/blog/' : '/en/blog/') + p.id.replace(/^(de|en)\//, '') + '/',
  }));
// Auto-generierte, gebrandete OG-Karte pro Artikel (siehe src/pages/og/blog/[...route].png.ts).
// Frontmatter `image` überschreibt sie bei Bedarf. Eigene Hero-Bilder werden als 1600×900
// abgelegt (siehe Hero-<img> unten) – die generierte Karte ist immer 1200×630.
const ogImage = image ?? `/og/blog/${post.id}.png`;
const ogImageWidth = image ? 1600 : 1200;
const ogImageHeight = image ? 900 : 630;
// hreflang DE↔EN: nur wenn eine Übersetzung via altSlug verlinkt ist.
const hasAlternate = !!altSlug;
const altUrl = altSlug
  ? (lang === 'de'
      ? `https://boatpass.de/en/blog/${altSlug}/`
      : `https://boatpass.de/blog/${altSlug}/`)
  : undefined;
const locale = lang === 'de' ? 'de-DE' : 'en-US';
const dateOpts = { year: 'numeric', month: 'long', day: 'numeric' } as const;
const formattedDate = date.toLocaleDateString(locale, dateOpts);
// Frische-Signal: dateModified = updated, sonst Veröffentlichungsdatum.
const isoDate = date.toISOString();
const isoModified = (updated ?? date).toISOString();
const formattedUpdated = updated ? updated.toLocaleDateString(locale, dateOpts) : null;

// Autor: Foto + vertrauensbildende Bio (Foto liegt in /public/images/marius-gehler.jpg).
const authorPhoto = '/marius.webp';
const authorRole = lang === 'de' ? 'Gründer & Entwickler von BoatPass' : 'Founder & Developer of BoatPass';
const authorBio = lang === 'de'
  ? 'Marius hat BoatPass mit einem klaren Anspruch entwickelt: eine SBF-Lernapp, die sich am Handy wirklich gut anfühlt – schnell, aufgeräumt und mit dem vollständigen amtlichen ELWIS-Fragenkatalog.'
  : 'Marius built BoatPass with one clear goal: a boating-licence study app that feels genuinely good on your phone – fast, clean, and powered by the complete official ELWIS question catalog.';
// E-E-A-T: Expertise-Signale für Suchmaschinen & KI-Crawler, spiegelt das Person-Schema von /ueber-uns/.
const authorJobTitle = lang === 'de' ? 'Gründer & Entwickler' : 'Founder & Developer';
const authorKnowsAbout = lang === 'de'
  ? ['Sportbootführerschein', 'SBF Binnen', 'SBF See', 'Android-Entwicklung', 'ELWIS-Fragenkatalog']
  : ['Sportbootführerschein', 'SBF Binnen', 'SBF See', 'Android development', 'ELWIS question catalog'];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  // Google empfiehlt `image` für Article-Rich-Results. Wir nutzen die ohnehin
  // generierte OG-Karte (1200×630), damit Bild und Social-Preview identisch sind.
  "image": {
    "@type": "ImageObject",
    "url": ogImage.startsWith('http') ? ogImage : `https://boatpass.de${ogImage}`,
    "width": ogImageWidth,
    "height": ogImageHeight,
  },
  "datePublished": isoDate,
  "dateModified": isoModified,
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://boatpass.de/ueber-uns/",
    "jobTitle": authorJobTitle,
    "image": `https://boatpass.de${authorPhoto}`,
    "knowsAbout": authorKnowsAbout,
    "worksFor": {
      "@type": "Organization",
      "name": "Boatpass",
      "url": "https://boatpass.de",
    },
  },
  "publisher": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
    "logo": {
      "@type": "ImageObject",
      "url": "https://boatpass.de/images/app-icon.png",
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
  "inLanguage": lang === 'de' ? 'de-DE' : 'en-US',
};

// FAQPage-Schema: nur wenn der Artikel FAQ-Paare im Frontmatter hinterlegt hat.
// Frage/Antwort spiegeln den sichtbaren Artikelinhalt (Überschriften + Prosa) wider.
const faqEntries = post.data.faq ?? [];
const faqSchema = faqEntries.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqEntries.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer,
        },
      })),
    }
  : null;

// HowTo-Schema: nur wenn der Artikel eine Schritt-für-Schritt-Anleitung im Frontmatter hinterlegt hat.
// Schritte spiegeln den sichtbaren Artikelinhalt wider (siehe post.data.howTo).
const howTo = post.data.howTo;
const howToSchema = howTo
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": howTo.name,
      "description": howTo.description,
      "step": howTo.steps.map((s) => ({
        "@type": "HowToStep",
        "name": s.name,
        "text": s.text,
      })),
    }
  : null;

const blogHref = lang === 'de' ? 'https://boatpass.de/blog/' : 'https://boatpass.de/en/blog/';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": lang === 'de' ? 'Startseite' : 'Home', "item": lang === 'de' ? 'https://boatpass.de/' : 'https://boatpass.de/en/' },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": blogHref },
    { "@type": "ListItem", "position": 3, "name": title, "item": Astro.url.href },
  ],
};
---

<BaseLayout title={metaTitle} description={description} lang={lang} type="article" hasAlternate={hasAlternate} altUrl={altUrl} ogImage={ogImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {howToSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
  <article class="max-w-2xl mx-auto px-4 pt-24 pb-16">

    <!-- Back link -->
    <a href={lang === 'de' ? '/blog/' : '/en/blog/'}
      class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      style="display:inline-flex; align-items:center; gap:6px; font-size:15px; font-weight:600; color:#3366FF; text-decoration:none; margin-bottom:36px;">
      ← {lang === 'de' ? 'Alle Artikel' : 'All articles'}
    </a>

    <!-- Header -->
    <header style="margin-bottom:40px;">
      <div style="display:flex; gap:6px; margin-bottom:16px;">
        {tags.map(tag => (
          <span style="font-size:13px; font-weight:700; background:rgba(51,102,255,0.08); color:#3366FF; border:1px solid rgba(51,102,255,0.15); padding:4px 12px; border-radius:100px;">{tag}</span>
        ))}
      </div>
      <h1 style="font-size:clamp(26px,4vw,38px); font-weight:900; letter-spacing:-1px; color:#1A1F36; line-height:1.2; margin-bottom:16px;">{title}</h1>
      <div style="display:flex; align-items:center; gap:16px; padding-bottom:24px; border-bottom:1px solid rgba(51,102,255,0.08); flex-wrap:wrap;">
        <a href="/ueber-uns/" rel="author" style="display:inline-flex; align-items:center; gap:8px; text-decoration:none;">
          <img src={authorPhoto} alt={author} width="28" height="28" loading="lazy" decoding="async" style="width:28px; height:28px; border-radius:50%; object-fit:cover; flex-shrink:0;" />
          <span style="font-size:14px; font-weight:600; color:#1A1F36;">{author}</span>
        </a>
        <span style="width:3px; height:3px; border-radius:50%; background:#D1D5DB;"></span>
        <span style="font-size:14px; color:#656B78;">{formattedDate}</span>
        <span style="width:3px; height:3px; border-radius:50%; background:#D1D5DB;"></span>
        <span style="font-size:14px; color:#656B78;">{readingTime} {lang === 'de' ? 'Min. Lesezeit' : 'min read'}</span>
        {formattedUpdated && (
          <>
            <span style="width:3px; height:3px; border-radius:50%; background:#D1D5DB;"></span>
            <span style="font-size:14px; color:#656B78;">{lang === 'de' ? `Aktualisiert: ${formattedUpdated}` : `Updated: ${formattedUpdated}`}</span>
          </>
        )}
      </div>
    </header>

    <!-- Hero-Bild: nur wenn der Artikel eines im Frontmatter hinterlegt hat -->
    {image && (
      <img src={image} alt={imageAlt ?? title} width="1600" height="900" loading="eager" decoding="async" fetchpriority="high"
        style="width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:16px; margin-bottom:40px;" />
    )}

    <!-- Content -->
    <div class="article-body">
      <slot />
    </div>

    <BlogInlineCta lang={lang} />

    <!-- FAQ: macht die im Frontmatter hinterlegten Fragen/Antworten sichtbar,
         statt sie nur unsichtbar im FAQPage-Schema zu verstecken (Rich-Results-
         Konformität + zitierfähiger Direktantwort-Block für KI-Crawler). -->
    {faqEntries.length > 0 && (
      <section style="margin-top:48px;">
        <h2 class="content-section-title" style="margin-bottom:20px;">{lang === 'de' ? 'Häufige Fragen' : 'Frequently asked questions'}</h2>
        <div style="display:flex; flex-direction:column; gap:14px;">
          {faqEntries.map(f => (
            <div style="background:white; border:1px solid rgba(51,102,255,0.08); border-radius:16px; padding:22px;">
              <h3 style="font-size:16px; font-weight:700; color:#1A1F36; margin-bottom:8px;">{f.question}</h3>
              <p style="font-size:15px; color:#656B78; line-height:1.7; margin:0;">{f.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Verwandte Artikel: cross-linking zwischen Blogposts -->
    {relatedPosts.length > 0 && (
      <section style="margin-top:48px;">
        <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;">{lang === 'de' ? 'Verwandte Artikel' : 'Related articles'}</div>
        <div style="display:grid; gap:12px;">
          {relatedPosts.map(r => (
            <a href={r.href} style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 20px; background:white; border:1px solid rgba(51,102,255,0.12); border-radius:12px; text-decoration:none;">
              <span style="font-size:16px; font-weight:700; color:#1A1F36; line-height:1.35;">{r.title}</span>
              <span style="font-size:13px; color:#656B78; white-space:nowrap; flex-shrink:0;">{r.readingTime} {lang === 'de' ? 'Min.' : 'min'} →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Autoren-Box: schafft Vertrauen & Nähe -->
    <div style="margin-top:48px; display:flex; gap:18px; align-items:flex-start; padding:24px; background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px;">
      <img src={authorPhoto} alt={author} width="64" height="64" loading="lazy" decoding="async" style="width:64px; height:64px; border-radius:50%; object-fit:cover; flex-shrink:0;" />
      <div>
        <div style="font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">{lang === 'de' ? 'Über den Autor' : 'About the author'}</div>
        <a href={lang === 'de' ? '/ueber-uns/' : '/en/about/'} rel="author" style="font-size:17px; font-weight:800; color:#1A1F36; text-decoration:none;">{author}</a>
        <div style="font-size:14px; font-weight:600; color:#656B78; margin-bottom:8px;">{authorRole}</div>
        <p style="font-size:15px; line-height:1.6; color:#4B5563; margin:0;">{authorBio}</p>
      </div>
    </div>

    <!-- Pillar-/Führerschein-Seiten (zweisprachig) -->
    <div style="margin-top:32px; padding:24px; background:rgba(51,102,255,0.04); border:1px solid rgba(51,102,255,0.12); border-radius:16px;">
      <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;">{lang === 'de' ? 'Führerschein-Seiten' : 'Licence pages'}</div>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        {lang === 'de' ? (
          <>
            <a href="/sbf-binnen/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SBF Binnen lernen</a>
            <a href="/sbf-see/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SBF See lernen</a>
            <a href="/sbf-kosten/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SBF Kosten</a>
            <a href="/src/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SRC Seefunkzeugnis</a>
            <a href="/ubi/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">UBI Binnenfunk</a>
            <a href="/lrc/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">LRC Funkbetriebszeugnis</a>
            <a href="/faq/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">Häufige Fragen</a>
          </>
        ) : (
          <>
            <a href="/en/sbf-inland/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">Learn SBF Inland</a>
            <a href="/en/sbf-coastal/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">Learn SBF Coastal</a>
            <a href="/en/sbf-costs/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SBF costs</a>
            <a href="/en/src/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">SRC radio certificate</a>
            <a href="/en/ubi/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">UBI inland radio</a>
            <a href="/en/lrc/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">LRC radio certificate</a>
            <a href="/en/faq/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">FAQ</a>
          </>
        )}
      </div>
    </div>

  </article>
</BaseLayout>

<style is:global>
  .article-body {
    font-size: 17px;
    line-height: 1.75;
    color: #4B5563;
  }

  /* Paragraphs */
  .article-body p {
    margin-bottom: 1.4em;
  }

  /* Headings */
  .article-body h2 {
    font-size: 1.45em;
    font-weight: 900;
    color: #1A1F36;
    letter-spacing: -0.4px;
    line-height: 1.2;
    margin-top: 2.2em;
    margin-bottom: 0.6em;
  }
  .article-body h3 {
    font-size: 1.15em;
    font-weight: 800;
    color: #1A1F36;
    letter-spacing: -0.2px;
    line-height: 1.3;
    margin-top: 1.8em;
    margin-bottom: 0.5em;
  }

  /* Lists */
  .article-body ul,
  .article-body ol {
    margin-bottom: 1.4em;
    padding-left: 1.5em;
  }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body li {
    margin-bottom: 0.4em;
  }

  /* Strong */
  .article-body strong {
    font-weight: 700;
    color: #1A1F36;
  }

  /* Links */
  .article-body a {
    color: #3366FF;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body a:hover { color: #2952CC; }

  /* Blockquote */
  .article-body blockquote {
    border-left: 3px solid #3366FF;
    margin: 1.8em 0;
    padding: 12px 20px;
    background: rgba(51,102,255,0.04);
    border-radius: 0 8px 8px 0;
    color: #374151;
    font-style: normal;
  }
  .article-body blockquote p { margin-bottom: 0; }

  /* Tables */
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.6em;
    font-size: 0.9em;
  }
  .article-body th {
    background: rgba(26,31,54,0.04);
    color: #1A1F36;
    font-weight: 700;
    text-align: left;
    padding: 10px 14px;
    border-bottom: 2px solid rgba(51,102,255,0.12);
  }
  .article-body td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(51,102,255,0.06);
    vertical-align: top;
  }
  .article-body tr:last-child td { border-bottom: none; }
  .article-body tr:nth-child(even) td {
    background: rgba(26,31,54,0.02);
  }

  /* Code */
  .article-body code {
    font-size: 0.88em;
    background: rgba(26,31,54,0.05);
    padding: 2px 6px;
    border-radius: 4px;
    color: #3366FF;
  }

  /* Mobile: breite Tabellen horizontal scrollbar machen, statt das
     gesamte Seitenlayout zu sprengen. Desktop bleibt unverändert. */
  @media (max-width: 700px) {
    .article-body table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  html.dark .article-body { color: #94A3B8; }
  html.dark .article-body h2,
  html.dark .article-body h3 { color: #E2E8F0; }
  html.dark .article-body strong { color: #E2E8F0; }
  html.dark .article-body blockquote {
    background: rgba(90, 120, 255, 0.07);
    color: #94A3B8;
  }
  html.dark .article-body th {
    background: rgba(90, 120, 255, 0.08);
    color: #C8D0E8;
    border-color: rgba(90, 120, 255, 0.16);
  }
  html.dark .article-body td { border-color: rgba(90, 120, 255, 0.08); }
  html.dark .article-body tr:nth-child(even) td { background: rgba(90, 120, 255, 0.04); }
  html.dark .article-body code {
    background: rgba(90, 120, 255, 0.12);
    color: #8BB4FF;
  }
</style>
