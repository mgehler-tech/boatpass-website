---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'de' | 'en';
}

const { post, lang } = Astro.props;
const { title, description, date, readingTime, tags, author = 'Marius Gehler' } = post.data;
const formattedDate = date.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const isoDate = date.toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://boatpass.de/ueber-uns/",
  },
  "publisher": {
    "@type": "Organization",
    "name": "Boatpass",
    "url": "https://boatpass.de",
    "logo": {
      "@type": "ImageObject",
      "url": "https://boatpass.de/images/app-icon.png",
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
  "inLanguage": lang === 'de' ? 'de-DE' : 'en-US',
};

const blogHref = lang === 'de' ? 'https://boatpass.de/blog/' : 'https://boatpass.de/en/blog/';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": lang === 'de' ? 'Startseite' : 'Home', "item": lang === 'de' ? 'https://boatpass.de/' : 'https://boatpass.de/en/' },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": blogHref },
    { "@type": "ListItem", "position": 3, "name": title, "item": Astro.url.href },
  ],
};
---

<BaseLayout title={title} description={description} lang={lang} type="article" hasAlternate={false}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="max-w-2xl mx-auto px-4 py-16">

    <!-- Back link -->
    <a href={lang === 'de' ? '/blog/' : '/en/blog/'}
      class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      style="display:inline-flex; align-items:center; gap:6px; font-size:15px; font-weight:600; color:#3366FF; text-decoration:none; margin-bottom:36px;">
      ← {lang === 'de' ? 'Alle Artikel' : 'All articles'}
    </a>

    <!-- Header -->
    <header style="margin-bottom:40px;">
      <div style="display:flex; gap:6px; margin-bottom:16px;">
        {tags.map(tag => (
          <span style="font-size:13px; font-weight:700; background:rgba(51,102,255,0.08); color:#3366FF; border:1px solid rgba(51,102,255,0.15); padding:4px 12px; border-radius:100px;">{tag}</span>
        ))}
      </div>
      <h1 style="font-size:clamp(26px,4vw,38px); font-weight:900; letter-spacing:-1px; color:#1A1F36; line-height:1.2; margin-bottom:16px;">{title}</h1>
      <div style="display:flex; align-items:center; gap:16px; padding-bottom:24px; border-bottom:1px solid rgba(51,102,255,0.08); flex-wrap:wrap;">
        <a href="/ueber-uns/" rel="author" style="display:inline-flex; align-items:center; gap:8px; text-decoration:none;">
          <div style="width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,#1A1F36,#3366FF); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; color:white; flex-shrink:0;">M</div>
          <span style="font-size:14px; font-weight:600; color:#1A1F36;">{author}</span>
        </a>
        <span style="width:3px; height:3px; border-radius:50%; background:#D1D5DB;"></span>
        <span style="font-size:14px; color:#9CA3AF;">{formattedDate}</span>
        <span style="width:3px; height:3px; border-radius:50%; background:#D1D5DB;"></span>
        <span style="font-size:14px; color:#9CA3AF;">{readingTime} {lang === 'de' ? 'Min. Lesezeit' : 'min read'}</span>
      </div>
    </header>

    <!-- Content -->
    <div class="article-body">
      <slot />
    </div>

    <!-- Interne Links -->
    {lang === 'de' && (
      <div style="margin-top:48px; padding:24px; background:rgba(51,102,255,0.04); border:1px solid rgba(51,102,255,0.12); border-radius:16px;">
        <div style="font-size:13px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;">Führerschein-Seiten</div>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">
          <a href="/sbf-binnen/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">⚓ SBF Binnen lernen</a>
          <a href="/sbf-see/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">🌊 SBF See lernen</a>
          <a href="/sbf-kosten/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">💶 SBF Kosten</a>
          <a href="/faq/" style="font-size:14px; font-weight:600; color:#1A1F36; background:white; border:1px solid rgba(51,102,255,0.12); padding:8px 16px; border-radius:100px; text-decoration:none;">❓ Häufige Fragen</a>
        </div>
      </div>
    )}

  </article>
</BaseLayout>

<style is:global>
  .article-body {
    font-size: 17px;
    line-height: 1.75;
    color: #4B5563;
  }

  /* Paragraphs */
  .article-body p {
    margin-bottom: 1.4em;
  }

  /* Headings */
  .article-body h2 {
    font-size: 1.45em;
    font-weight: 900;
    color: #1A1F36;
    letter-spacing: -0.4px;
    line-height: 1.2;
    margin-top: 2.2em;
    margin-bottom: 0.6em;
  }
  .article-body h3 {
    font-size: 1.15em;
    font-weight: 800;
    color: #1A1F36;
    letter-spacing: -0.2px;
    line-height: 1.3;
    margin-top: 1.8em;
    margin-bottom: 0.5em;
  }

  /* Lists */
  .article-body ul,
  .article-body ol {
    margin-bottom: 1.4em;
    padding-left: 1.5em;
  }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body li {
    margin-bottom: 0.4em;
  }

  /* Strong */
  .article-body strong {
    font-weight: 700;
    color: #1A1F36;
  }

  /* Links */
  .article-body a {
    color: #3366FF;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body a:hover { color: #2952CC; }

  /* Blockquote */
  .article-body blockquote {
    border-left: 3px solid #3366FF;
    margin: 1.8em 0;
    padding: 12px 20px;
    background: rgba(51,102,255,0.04);
    border-radius: 0 8px 8px 0;
    color: #374151;
    font-style: normal;
  }
  .article-body blockquote p { margin-bottom: 0; }

  /* Tables */
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.6em;
    font-size: 0.9em;
  }
  .article-body th {
    background: rgba(26,31,54,0.04);
    color: #1A1F36;
    font-weight: 700;
    text-align: left;
    padding: 10px 14px;
    border-bottom: 2px solid rgba(51,102,255,0.12);
  }
  .article-body td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(51,102,255,0.06);
    vertical-align: top;
  }
  .article-body tr:last-child td { border-bottom: none; }
  .article-body tr:nth-child(even) td {
    background: rgba(26,31,54,0.02);
  }

  /* Code */
  .article-body code {
    font-size: 0.88em;
    background: rgba(26,31,54,0.05);
    padding: 2px 6px;
    border-radius: 4px;
    color: #3366FF;
  }
</style>
