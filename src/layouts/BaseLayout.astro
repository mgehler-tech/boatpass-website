---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import '../styles/global.css';
// Preload des tatsächlich genutzten Font-Subsets: Inter wird per unicode-range in
// sieben Subsets ausgeliefert, für DE/EN lädt der Browser nur "latin". Ohne Preload
// entdeckt er die Datei erst nach dem CSS-Parsing – das kostet Zeit im kritischen Pfad.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { AppRating } from '../data/apps';
import { APP_STORE_ID, PLAY_STORE_URL, appStoreUrl, smartAppPath } from '../data/stores';

interface Props {
  title: string;
  description: string;
  lang: 'de' | 'en';
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article';
  showCta?: boolean;
  hasAlternate?: boolean;
  altUrl?: string;
  noindex?: boolean;
  appRating?: AppRating;
  /** Override für Astro.url.pathname, s. Header.astro. Nötig für Seiten wie 404.astro,
   * die unter keiner echten Route erreichbar sind. */
  currentPath?: string;
  /** Startseite: Kopfzeile oben transparent, nach 24 px Scrollweg Fläche (s. Header.astro). */
  heroHeader?: boolean;
}

const { title, description, lang, ogImage, ogImageWidth, ogImageHeight, type, showCta = true, hasAlternate = true, altUrl, noindex = false, appRating, currentPath, heroHeader = false } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <script is:inline>
  (function() {
    // h-js: JavaScript läuft – Bausteine mit .h-js-only (Quiz, Theme-Umschalter)
    // werden sichtbar. Vor dem ersten Paint gesetzt, damit nichts nachspringt.
    document.documentElement.classList.add('h-js');
    try {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    } catch (e) {}
  })();
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://plausible.io" crossorigin />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <!-- Safari Smart App Banner: natives „Laden/Öffnen"-Banner auf iPhone und iPad -->
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    <!-- Plausible Analytics (cookielos, DSGVO-konform, kein Consent nötig) -->
    <script is:inline defer data-domain="boatpass.de" src="https://plausible.io/js/script.tagged-events.js"></script>
    <script is:inline define:vars={{ playUrl: PLAY_STORE_URL, iosUrl: appStoreUrl(lang), chooserPath: smartAppPath(lang) }}>
      window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };

      // Geräteweiche für Store-Links. Generische CTAs verlinken im Markup auf Google Play
      // (funktioniert ohne JS). iPhone/iPad bekommen stattdessen den App Store, Desktop
      // die Auswahlseite /app/ mit beiden Badges + QR-Code. Explizite Store-Badges tragen
      // data-store und bleiben unangetastet. `data-platform` auf <html> steuert außerdem
      // per CSS, welche Badge-Reihenfolge/Variante sichtbar ist.
      (function () {
        var ua = navigator.userAgent;
        // Android zuerst: die iPadOS-Heuristik (MacIntel + Touch) darf kein Android-Gerät treffen.
        var isAndroid = /Android/i.test(ua);
        var isIos = !isAndroid && (/iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));
        var platform = isAndroid ? 'android' : isIos ? 'ios' : 'desktop';
        document.documentElement.setAttribute('data-platform', platform);
        if (platform === 'android') return;
        document.addEventListener('DOMContentLoaded', function () {
          var links = document.querySelectorAll('a[href^="' + playUrl + '"]:not([data-store])');
          for (var i = 0; i < links.length; i++) {
            if (platform === 'ios') {
              links[i].href = iosUrl;
            } else {
              links[i].href = chooserPath;
              links[i].removeAttribute('target');
            }
          }
        });
      })();

      // Conversion Tracking: Store-Klicks getrennt nach Store. `position` identifiziert die
      // CTA-Platzierung (data-cta-position, z. B. "blog-inline"/"bottom-banner"), damit
      // sich Conversion-Beiträge einzelner CTA-Positionen in Plausible vergleichen lassen.
      // Ungetaggte CTAs (Hero, Header, Pricing, …) fallen auf "other" zurück.
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a');
        if (!link || !link.href) return;
        var event = link.href.indexOf('play.google.com') !== -1 ? 'play_store_click'
          : link.href.indexOf('apps.apple.com') !== -1 ? 'app_store_click'
          : link.pathname === chooserPath ? 'app_chooser_click'
          : null;
        if (!event) return;
        var positionEl = link.closest('[data-cta-position]');
        var position = positionEl ? positionEl.getAttribute('data-cta-position') : 'other';
        window.plausible(event, { props: { path: window.location.pathname, position: position } });
      });
    </script>
    <SEO title={title} description={description} lang={lang} ogImage={ogImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} type={type} hasAlternate={hasAlternate} altUrl={altUrl} noindex={noindex} appRating={appRating} />
    <!-- Seitenspezifische Head-Einträge, z. B. Font-Preloads der Startseite. -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background">
    <a href="#main-content" class="skip-link">
      {lang === 'de' ? 'Zum Hauptinhalt springen' : 'Skip to main content'}
    </a>
    {heroHeader && <div class="header-sentinel" aria-hidden="true" style="position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;"></div>}
    <Header lang={lang} altUrl={altUrl} hasAlternate={hasAlternate} currentPath={currentPath} transparentAtTop={heroHeader} />
    <main id="main-content">
      <slot />
    </main>
    {showCta && <CtaBanner lang={lang} />}
    <Footer lang={lang} />
    <script>
      import { initThemeToggles } from '../scripts/theme-toggle';
      initThemeToggles();
    </script>
  </body>
</html>
