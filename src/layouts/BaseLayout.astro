---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import '../styles/global.css';
// Preload des tatsächlich genutzten Font-Subsets: Inter wird per unicode-range in
// sieben Subsets ausgeliefert, für DE/EN lädt der Browser nur "latin". Ohne Preload
// entdeckt er die Datei erst nach dem CSS-Parsing – das kostet Zeit im kritischen Pfad.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { AppRating } from '../data/apps';

interface Props {
  title: string;
  description: string;
  lang: 'de' | 'en';
  ogImage?: string;
  type?: 'website' | 'article';
  showCta?: boolean;
  hasAlternate?: boolean;
  altUrl?: string;
  noindex?: boolean;
  appRating?: AppRating;
}

const { title, description, lang, ogImage, type, showCta = true, hasAlternate = true, altUrl, noindex = false, appRating } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <script is:inline>
  (function() {
    try {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    } catch (e) {}
  })();
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://plausible.io" crossorigin />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <!-- Plausible Analytics (cookielos, DSGVO-konform, kein Consent nötig) -->
    <script is:inline defer data-domain="boatpass.de" src="https://plausible.io/js/script.tagged-events.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };

      // Conversion Tracking: Play Store Klicks
      document.addEventListener('click', function (e) {
        const link = e.target.closest('a');
        if (link && link.href && link.href.includes('play.google.com')) {
          window.plausible('play_store_click', { props: { path: window.location.pathname } });
        }
      });
    </script>
    <SEO title={title} description={description} lang={lang} ogImage={ogImage} type={type} hasAlternate={hasAlternate} altUrl={altUrl} noindex={noindex} appRating={appRating} />
  </head>
  <body class="min-h-screen bg-background">
    <a href="#main-content" class="skip-link">
      {lang === 'de' ? 'Zum Hauptinhalt springen' : 'Skip to main content'}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    {showCta && <CtaBanner lang={lang} />}
    <Footer lang={lang} />
  </body>
</html>
