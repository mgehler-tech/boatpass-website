---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'de' | 'en';
  ogImage?: string;
  type?: 'website' | 'article';
  showCta?: boolean;
  hasAlternate?: boolean;
  altUrl?: string;
  noindex?: boolean;
}

const { title, description, lang, ogImage, type, showCta = true, hasAlternate = true, altUrl, noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/app-icon.png" />
    <link rel="apple-touch-icon" href="/images/app-icon.png" />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3Y8BE0JR9B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3Y8BE0JR9B', {
        page_path: window.location.pathname,
      });

      // Conversion Tracking: Play Store Klicks
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link && link.href && link.href.includes('play.google.com')) {
          gtag('event', 'play_store_click', {
            event_category: 'conversion',
            event_label: window.location.pathname,
          });
        }
      });
    </script>
    <SEO title={title} description={description} lang={lang} ogImage={ogImage} type={type} hasAlternate={hasAlternate} altUrl={altUrl} noindex={noindex} />
  </head>
  <body class="min-h-screen bg-background">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    {showCta && <CtaBanner lang={lang} />}
    <Footer lang={lang} />
  </body>
</html>
