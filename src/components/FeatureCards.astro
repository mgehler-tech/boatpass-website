---
import { useTranslations } from '../i18n/index';
import Icon from './Icon.astro';
import type { IconName } from '../icons';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Bewusst auf die drei Lernmodi fokussiert – passend zur Überschrift
// "Drei Wege zum Bestehen". Fortschritt/Statistik ist in die Fehler-Training-
// Karte eingearbeitet; Katalog (CatalogSources) und Sprachen (TrustBar) stehen
// bereits an anderer Stelle und werden hier nicht wiederholt.
const features: { icon: IconName; title: string; desc: string }[] = [
  { icon: 'book', title: t.features.learn.title, desc: t.features.learn.desc },
  { icon: 'clipboard', title: t.features.exam.title, desc: t.features.exam.desc },
  { icon: 'target', title: t.features.training.title, desc: t.features.training.desc },
];
---

<section id="features" class="max-w-6xl mx-auto px-6 py-12 md:py-20">
  <div class="reveal-item section-header" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
      {t.features.chip}
    </div>
    <h2 class="section-display-title" style="margin-bottom:14px;">{t.features.title}</h2>
    <p style="font-size:16px; color:#6B7280; max-width:440px; line-height:1.65; margin-bottom:56px;">{t.features.subtitle}</p>
  </div>

  <div class="feat-grid">
    {features.map(f => (
      <div class="feat-card reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="feat-top-line"></div>
        <div style="width:52px; height:52px; border-radius:14px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
          <Icon name={f.icon} size={24} stroke="#3366FF" strokeWidth={1.75} />
        </div>
        <h3 style="font-size:17px; font-weight:800; color:#1A1F36; margin-bottom:10px; letter-spacing:-0.2px;">{f.title}</h3>
        <p style="font-size:14px; color:#6B7280; line-height:1.65;">{f.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .feat-card {
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 20px;
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, opacity 0.6s ease;
  }
  .feat-top-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3366FF, #5B8CFF);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    border-radius: 3px 3px 0 0;
  }
  .feat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(26,31,54,0.08);
    border-color: rgba(51,102,255,0.18);
  }
  .feat-card:hover .feat-top-line {
    transform: scaleX(1);
  }
  @media (max-width: 900px) {
    .feat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .feat-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.opacity = '1';
        (e.target as HTMLElement).style.transform = 'translateY(0)';
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#features .reveal-item').forEach(el => observer.observe(el));
</script>
