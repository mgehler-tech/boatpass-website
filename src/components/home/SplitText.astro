---
// Überschrift, die wortweise einblenden kann.
//
// Barrierefreiheit: Die Überschrift trägt den ungeteilten Text als
// aria-label; die geteilten Wörter sind aria-hidden. Screenreader lesen so
// einen sauberen Satz statt einzelner Wort-Spans. Ohne JavaScript ist der
// Text ganz normal sichtbar – die Startzustände setzt erst home.css, wenn
// HomeBoot Bewegung erlaubt.
//
// Mini-Syntax im Text:
//   *Wort*   → Akzent (kursiv, Markenfarbe), auch über mehrere Wörter
//   |        → erzwungener Zeilenumbruch
interface Props {
  as?: 'h1' | 'h2' | 'h3';
  text: string;
  class?: string;
  id?: string;
}

const { as: Tag = 'h2', text, class: className, id } = Astro.props;

const label = text.replace(/\*/g, '').replace(/\s*\|\s*/g, ' ').replace(/­/g, '');

type Token = { kind: 'word'; text: string; accent: boolean } | { kind: 'break' };
const tokens: Token[] = [];
let inAccent = false;
for (const raw of text.split(/\s+/).filter(Boolean)) {
  if (raw === '|') {
    tokens.push({ kind: 'break' });
    continue;
  }
  let word = raw;
  if (word.startsWith('*')) {
    inAccent = true;
    word = word.slice(1);
  }
  const accent = inAccent;
  if (word.endsWith('*')) {
    inAccent = false;
    word = word.slice(0, -1);
  }
  tokens.push({ kind: 'word', text: word, accent });
}
---

<Tag class:list={['h-split', className]} id={id} aria-label={label} data-split>
  <span aria-hidden="true">{tokens.map((tok, i) => {
    if (tok.kind === 'break') return <br />;
    const next = tokens[i + 1];
    const space = next && next.kind === 'word' ? ' ' : '';
    return (
      <Fragment>
        <span class:list={['w', tok.accent && 'w--accent']}><span class="wi">{tok.text}</span></span>{space}
      </Fragment>
    );
  })}</span>
</Tag>
