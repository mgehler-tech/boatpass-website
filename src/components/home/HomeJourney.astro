---
// Lernweg – vier Etappen als Logbuch-Tabelle. Reihenfolge ist inhaltlich
// begründet (starten, verstehen, messen, prüfen), deshalb nummeriert.
//
// Desktop (≥1024px): links die Etappen als Zeilen mit einer Fortschrittslinie
// in der Nummernspalte, rechts ein mitlaufendes Handy auf einer ruhigen Fläche
// (CSS sticky), dessen Screen zur jeweils aktiven Etappe wechselt. Jede Etappe
// hat zwei bis drei Screens; ihre Chips sind Schalter (aria-pressed) dafür.
// Etappe 02 enthält das Quiz. Darunter: jede Etappe mit eigenem Handy. Etappen sind
// so hoch wie ihr Inhalt (am Desktop mindestens 44vh); die Nummer steht nur
// einmal, als Marker auf der Linie (Spec Runde 2, 5.1).
// Die Aktivierung läuft über home-motion.ts (IntersectionObserver) und
// funktioniert auch bei reduzierter Bewegung – dann ohne Übergänge.
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import QuizDemo from './QuizDemo.astro';
import { useTranslations } from '../../i18n/index';
interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const de = lang === 'de';

// Echte App-Screens (iOS 1.4.x, Simulator, 9:41, einheitliche Demodaten) als
// journey/<name>.<lang>.webp. Je Etappe mehrere Screens; die Chips schalten sie.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/journey/*.webp', { eager: true });
const shot = (name: string) => files[`../../assets/images/journey/${name}.${lang}.webp`].default;

// Reihenfolge je Etappe = Reihenfolge der Chips in home.journeyChips.
const screens: { name: string; alt: string }[][] = de
  ? [
      [
        { name: 'start', alt: 'Boatpass App – Startbildschirm mit Lernplan, Prüfungsreife und Plan für heute' },
        { name: 'plan', alt: 'Boatpass App – Lernplan mit Prüfungstermin, Prüfungsreife und Tagesziel' },
        { name: 'topics', alt: 'Boatpass App – Themenübersicht mit Fortschritt je Thema' },
      ],
      [
        { name: 'picture', alt: 'Boatpass App – Bildfrage zu Tafelzeichen mit richtiger Antwort' },
        { name: 'explain', alt: 'Boatpass App – Erklärung zur Antwort mit Merkhilfe' },
        { name: 'nav', alt: 'Boatpass App – Navigationsaufgabe mit amtlicher Lösung und Lösungsweg' },
      ],
      [
        { name: 'logbook', alt: 'Boatpass App – Logbuch mit Fortschritt je Thema' },
        { name: 'knots', alt: 'Boatpass App – Knotenkunde: Palstek Schritt für Schritt' },
      ],
      [
        { name: 'sheets', alt: 'Boatpass App – Prüfung mit den 15 amtlichen Prüfungsbögen' },
        { name: 'curve', alt: 'Boatpass App – Zufallsprüfung mit Formkurve der letzten Prüfungen' },
        { name: 'result', alt: 'Boatpass App – bestandene Prüfung mit Ergebnis nach Bereichen' },
      ],
    ]
  : [
      [
        { name: 'start', alt: 'Boatpass app – home screen with study plan, exam readiness and plan for today' },
        { name: 'plan', alt: 'Boatpass app – study plan with exam date, exam readiness and daily goal' },
        { name: 'topics', alt: 'Boatpass app – topic overview with progress per topic' },
      ],
      [
        { name: 'picture', alt: 'Boatpass app – picture question on signs with the correct answer' },
        { name: 'explain', alt: 'Boatpass app – explanation of the answer with mnemonic' },
        { name: 'nav', alt: 'Boatpass app – navigation task with official solution and worked solution' },
      ],
      [
        { name: 'logbook', alt: 'Boatpass app – logbook with progress per topic' },
        { name: 'knots', alt: 'Boatpass app – knots: bowline step by step' },
      ],
      [
        { name: 'sheets', alt: 'Boatpass app – exam with the 15 official exam sheets' },
        { name: 'curve', alt: 'Boatpass app – random exam with progress curve of recent exams' },
        { name: 'result', alt: 'Boatpass app – passed exam with results by section' },
      ],
    ];

const steps = t.steps.items.map((item, i) => ({
  ...item,
  num: String(i + 1).padStart(2, '0'),
  screens: screens[i].map((sc, k) => ({ ...sc, src: shot(sc.name), chip: h.journeyChips[i][k] })),
}));
const chipsLabel = de ? 'Screen wählen' : 'Choose screen';
---


<section id="features" class="hj h-section" aria-labelledby="hj-title">
  <div class="h-container">
    <SectionHead
      title={t.steps.title}
      lede={t.steps.subtitle}
      id="hj-title"
      layout="split"
    />

    <div class="hj-grid" data-journey>
      <div class="hj-track">
        <div class="hj-line" aria-hidden="true"><span class="hj-line-fill" data-journey-fill></span></div>
        <ol class="hj-steps">
          {steps.map((step, i) => (
            <li class:list={['hj-step', { 'hj-step--quiz': i === 1 }]} data-journey-step={i} data-journey-title={step.title}>
              <span class="hj-marker h-num" aria-hidden="true">{step.num}</span>
              <div class="hj-body">
                <h3 class="hj-title">{step.title}</h3>
                <p class="hj-desc">{step.desc}</p>
                <ul class="h-tags hj-chips" aria-label={chipsLabel}>
                  {step.screens.map((sc, k) => (
                    <li>
                      <button
                        type="button"
                        class="h-tag hj-chip"
                        aria-pressed={k === 0 ? 'true' : 'false'}
                        data-journey-chip={`${i}-${k}`}
                      >{sc.chip}</button>
                    </li>
                  ))}
                </ul>
                <figure class="hj-shot">
                  <div class="h-phone hj-shot-phone">
                    <div class="h-phone-screen">
                      {step.screens.map((sc, k) => (
                        <Image
                          src={sc.src}
                          alt={sc.alt}
                          widths={[240, 480]}
                          sizes="220px"
                          quality={78}
                          loading="lazy"
                          class:list={['hj-inline', { 'is-active': k === 0 }]}
                          data-journey-inline={`${i}-${k}`}
                        />
                      ))}
                    </div>
                  </div>
                </figure>
                {i === 1 && <QuizDemo lang={lang} />}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="hj-stage">
        <div class="hj-stage-sticky">
          <!-- Gerät steht frei auf dem Papier (kein Kasten, Spec 4.6); ein weicher
               Lichtfleck dahinter trennt es leise vom Grund. -->
          <div class="hj-backdrop">
            <div class="h-phone hj-phone">
              <div class="h-phone-screen">
                {steps.map((step, i) =>
                  step.screens.map((sc, k) => (
                    <Image
                      src={sc.src}
                      alt={sc.alt}
                      widths={[300, 600]}
                      sizes="300px"
                      quality={80}
                      loading="lazy"
                      class:list={['hj-screen', { 'is-active': i === 0 && k === 0 }]}
                      data-journey-screen={`${i}-${k}`}
                    />
                  )),
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hj { background: var(--h-paper); }

  .hj-grid {
    position: relative;
    margin-top: clamp(48px, 6vw, 80px);
  }

  /* ── Fortschrittslinie in der Nummernspalte ── */
  .hj-track { position: relative; padding-left: 64px; }
  .hj-line {
    position: absolute;
    left: 19px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--h-line-2);
  }
  .hj-line-fill {
    position: absolute;
    left: -1px;
    right: -1px;
    top: 0;
    bottom: 0;
    background: var(--h-blue);
    transform-origin: top center;
    transform: scaleY(var(--hj-progress, 0));
  }

  .hj-steps { margin: 0; padding: 0; list-style: none; }
  .hj-step { position: relative; padding: 28px 0 48px; border-top: 1px solid var(--h-line-2); }

  .hj-marker {
    position: absolute;
    left: -64px;
    top: 26px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 32px;
    border: 1px solid var(--h-line-2);
    border-radius: var(--h-r-sm);
    background: var(--h-paper);
    color: var(--h-ink);
    font-family: var(--h-sans);
    font-size: 13px;
    font-weight: 500;
    transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  }
  .hj-step.is-done .hj-marker,
  .hj-step.is-active .hj-marker {
    border-color: var(--h-blue);
    background: var(--h-blue);
    color: #fff;
  }

  .hj-title {
    margin: 0;
    font-family: var(--h-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--h-ink);
  }
  .hj-desc {
    margin: 14px 0 20px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--h-muted);
  }

  /* Chips als Schalter für die Screens der Etappe. Ohne JS bleiben sie reine
     Beschriftung (kein Zeiger, kein Fokus-Versprechen). */
  .hj-chip {
    display: block;
    min-height: 32px;
    padding: 5px 12px;
    background: transparent;
    cursor: default;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .h-js .hj-chip { cursor: pointer; }
  .h-js .hj-chip:hover { border-color: var(--h-blue); }
  .h-js .hj-chip[aria-pressed='true'] {
    border-color: var(--h-blue);
    background: var(--h-blue);
    color: #fff;
  }
  .hj-chip:focus-visible { outline: 2px solid var(--h-blue); outline-offset: 2px; }
  html:not(.h-js) .hj-chip { pointer-events: none; }

  /* Handy je Etappe (nur unter 1024px); die Chips blenden seine Screens um. */
  .hj-shot { margin: 28px 0 0; }
  .hj-shot-phone { --pw: 220px; }
  .hj-inline { opacity: 0; transition: opacity 0.4s ease; }
  .hj-inline.is-active { opacity: 1; }
  .hj-step--quiz .hj-shot { margin-bottom: 28px; }

  .hj-stage { display: none; }

  @media (max-width: 639px) {
    .hj-track { padding-left: 50px; }
    .hj-line { left: 16px; }
    .hj-marker { left: -50px; width: 34px; height: 28px; font-size: 12px; }
  }

  @media (min-width: 1024px) {
    .hj-grid {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 80px);
    }
    /* Etappen auf Inhaltshöhe mit kleinem Mindestmaß; die Quiz-Etappe ist so
       hoch wie das Quiz. Schwellen: Abschnitt < 2100 px bei 1440×900. */
    .hj-step {
      min-height: 44vh;
      padding: 28px 0 36px;
    }
    .hj-shot { display: none; }

    /* Die Bühne klebt nur so hoch, wie das Gerät samt Luft ist (nicht fenster-
       hoch), und reicht unten in den Abschnittsabstand hinein. Sonst schiebt
       das Rasterende das Handy schon weg, bevor die kurze letzte Etappe aktiv
       ist. --hj-box: Gerät = 2,092 × Breite (siehe .h-phone) plus 2 × 40 px
       Luft; --hj-inset stellt es unter der Leiste mittig ins Fenster. */
    .hj-stage {
      --hj-pw: min(320px, calc((100svh - 64px) * 0.36));
      --hj-box: calc(var(--hj-pw) * 2.092 + 80px);
      --hj-inset: max(0px, calc((100svh - 64px - var(--hj-box)) / 2));
      display: block;
      position: relative;
      padding-top: var(--hj-inset);
      margin-bottom: calc(-1 * var(--h-section-pad));
    }
    .hj-stage-sticky {
      position: sticky;
      top: calc(64px + var(--hj-inset));
    }
    .hj-backdrop {
      position: relative;
      display: grid;
      place-items: center;
      padding: 40px 0;
    }
    /* Weicher Lichtfleck hinter dem Gerät statt eines Kastens. */
    .hj-backdrop::before {
      content: '';
      position: absolute;
      inset: -10%;
      background: radial-gradient(closest-side, var(--h-paper-2), transparent);
      opacity: 0.6;
      pointer-events: none;
    }
    .hj-phone {
      position: relative;
      --pw: var(--hj-pw);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), var(--h-shadow-device);
    }
    .hj-screen {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 0.9s var(--h-ease);
    }
    .hj-screen.is-prev { clip-path: inset(0 0 0 0); transition: none; z-index: 1; }
    .hj-screen.is-active { clip-path: inset(0 0 0 0); z-index: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hj-screen, .hj-marker, .hj-inline, .hj-chip { transition: none !important; }
  }
</style>
