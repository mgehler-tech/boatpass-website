---
// Merkhilfen-Band zwischen Hero und Lernweg: die Merkhilfen der zehn
// Quizfragen, wortgleich aus der App (data/quiz-questions.json). Bewusst kein
// Laufband – es steht eine Merkhilfe da, die nächste kommt erst auf Klick.
// Alle Einträge liegen übereinander in einer Gitterzelle, damit die Höhe beim
// Wechsel nicht springt. Ohne JS steht die erste Merkhilfe da, der Schalter
// bleibt verborgen (home-motion.ts blendet ihn ein).
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/index';
import { QUIZ_QUESTIONS, QUIZ_LICENCE_LABELS } from '../../data/quiz';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const h = useTranslations(lang).home;
const items = QUIZ_QUESTIONS.map(q => ({
  licence: QUIZ_LICENCE_LABELS[q.licence][lang],
  text: q.mnemonic[lang],
}));
---

<section class="hm" aria-labelledby={`hm-title-${lang}`}>
  <div class="h-container hm-inner">
    <h2 class="sr-only" id={`hm-title-${lang}`}>{h.mnemoSection}</h2>
    <span class="hm-icon" aria-hidden="true"><Icon name="lightbulb" size={22} strokeWidth={1.75} /></span>
    <ul class="hm-list" data-mnemo-list aria-live="polite">
      {items.map((item, i) => (
        <li class:list={['hm-item', { 'is-current': i === 0 }]} data-mnemo-item>
          <p class="hm-meta">{h.mnemoTitle} · <span class="hm-lic">{item.licence}</span></p>
          <p class="hm-text">{item.text}</p>
        </li>
      ))}
    </ul>
    <div class="hm-nav" data-mnemo-nav hidden>
      <span class="hm-count h-num" data-mnemo-count aria-hidden="true">1 / {items.length}</span>
      <button type="button" class="hm-next" data-mnemo-next>
        {h.mnemoNext}
        <Icon name="chevronRight" size={16} strokeWidth={2.25} />
      </button>
    </div>
  </div>
</section>

<style is:global>
  .hm {
    background: var(--h-deep);
    color: var(--h-on-deep);
  }
  html.dark .hm { box-shadow: inset 0 1px 0 var(--h-deep-line), inset 0 -1px 0 var(--h-deep-line); }
  .hm-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'icon list'
      'nav nav';
    align-items: center;
    gap: 16px 18px;
    padding-block: clamp(24px, 3vw, 32px);
  }
  @media (min-width: 900px) {
    .hm-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'icon list nav';
      gap: 24px;
    }
  }

  .hm-icon {
    grid-area: icon;
    align-self: start;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(244, 178, 74, 0.14);
    color: var(--h-beacon);
  }

  .hm-list {
    grid-area: list;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hm-item {
    grid-area: 1 / 1;
    align-self: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.45s var(--h-ease), visibility 0s linear 0.45s;
  }
  .hm-item.is-current {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.4s ease 0.1s, transform 0.5s var(--h-ease) 0.1s, visibility 0s;
  }
  .hm-meta {
    margin: 0 0 4px;
    font-size: 13px;
    color: var(--h-on-deep-muted);
  }
  .hm-lic { color: var(--h-beacon); font-weight: 600; }
  .hm-text {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--h-on-deep);
    text-wrap: pretty;
  }

  .hm-nav {
    grid-area: nav;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .hm-nav[hidden] { display: none; }
  @media (min-width: 900px) {
    .hm-nav { justify-content: flex-end; }
  }
  .hm-count { font-size: 13px; color: var(--h-on-deep-muted); }
  .hm-next {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px 0 20px;
    border: 0;
    border-radius: var(--h-r-pill);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px var(--h-deep-line);
    color: var(--h-on-deep);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .hm-next:hover { background: rgba(255, 255, 255, 0.14); }
  .hm-next:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hm-next svg { transition: transform 0.35s var(--h-ease); }
  .hm-next:hover svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .hm-item,
    .hm-item.is-current { transform: none; transition: opacity 0.2s ease, visibility 0s; }
    .hm-next svg { transition: none; }
  }
</style>
