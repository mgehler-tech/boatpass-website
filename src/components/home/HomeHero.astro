---
// Hero – links die Aussage mit dem einen CTA, rechts ein Schein-Wähler: Chips
// für die fünf Lizenzen wechseln den echten Startbildschirm der App, die
// Faktenzeile und die Foto-Szene. Erster Viewport bewusst auf fünf Elemente reduziert (Spec
// docs/superpowers/specs/2026-10-17-premium-polish-design.md, 4.2): H1,
// Subline, Button mit einzeiliger Bewertung, eine Faktenzeile als Satz und
// darunter die amtlichen Kataloge als ruhige Textzeile mit Links zur
// jeweiligen Lizenzseite (die Fragenzahlen stehen in der Preisliste).
//
// Der CTA hängt vom Gerät ab (html[data-platform] aus dem BaseLayout):
// Handys bekommen den einen Button, der direkt in ihren Store führt. Desktop
// zeigt stattdessen die offiziellen Badges beider Stores, damit sofort sichtbar
// ist, dass es die App für iOS und Android gibt; der QR-Link darunter führt
// zur Auswahlseite /app/. Ohne JS bleibt der neutrale Button.
//
// Der Text steht ab dem ersten Paint fertig da (H1 = LCP-Element, CTA sofort
// nutzbar). Der Auftakt des Handys läuft als CSS-Animation und wartet nicht
// auf das JS-Bundle; GSAP übernimmt nur das Neigen per Maus.
import { Image } from 'astro:assets';
import StoreCta from './StoreCta.astro';
import StoreBadges from '../StoreBadges.astro';
import HeroPhoto from './HeroPhoto.astro';
import StoreRating from '../StoreRating.astro';
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/index';
import { smartAppPath } from '../../data/stores';
import type { ImageMetadata } from 'astro';
import type { HeroScene } from './HeroPhoto.astro';
import shotBinnenDe from '../../assets/images/hero-app/binnen.de.webp';
import shotSeeDe from '../../assets/images/hero-app/see.de.webp';
import shotUbiDe from '../../assets/images/hero-app/ubi.de.webp';
import shotSrcDe from '../../assets/images/hero-app/src.de.webp';
import shotLrcDe from '../../assets/images/hero-app/lrc.de.webp';
import shotBinnenEn from '../../assets/images/hero-app/binnen.en.webp';
import shotSeeEn from '../../assets/images/hero-app/see.en.webp';
import shotUbiEn from '../../assets/images/hero-app/ubi.en.webp';
import shotSrcEn from '../../assets/images/hero-app/src.en.webp';
import shotLrcEn from '../../assets/images/hero-app/lrc.en.webp';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const p = t.pricing;

// Schein-Wähler: Reihenfolge wie t.hero.licenses (Binnen, See, UBI, SRC, LRC).
// Die Zahlen kommen aus der Preisliste, damit beide Stellen gleich bleiben;
// die Zusätze sind eigene Kurzformen (home.heroNotes). UBI ist Binnenfunk und teilt sich die Binnen-Szene.
const shots: Record<'de' | 'en', ImageMetadata[]> = {
  de: [shotBinnenDe, shotSeeDe, shotUbiDe, shotSrcDe, shotLrcDe],
  en: [shotBinnenEn, shotSeeEn, shotUbiEn, shotSrcEn, shotLrcEn],
};
const meta: { key: string; scene: HeroScene; questions: string; note: string }[] = [
  { key: 'binnen', scene: 'binnen', questions: p.catalog1Questions, note: h.heroNotes[0] },
  { key: 'see', scene: 'see', questions: p.catalog2Questions, note: h.heroNotes[1] },
  { key: 'ubi', scene: 'binnen', questions: p.catalog3Questions, note: h.heroNotes[2] },
  { key: 'src', scene: 'funk', questions: p.srcQuestions, note: h.heroNotes[3] },
  { key: 'lrc', scene: 'funk', questions: p.lrcQuestions, note: h.heroNotes[4] },
];
const licenses = meta.map((m, i) => {
  const name = t.hero.licenses[i];
  // "SBF Binnen" → Präfix "SBF" plus Kurzform "Binnen" (s. CSS, schmale Handys).
  const [pre, short] = name.startsWith('SBF ') ? ['SBF', name.slice(4)] : ['', name];
  return { ...m, name, pre, short, shot: shots[lang][i] };
});

// Reihenfolge wie t.hero.licenses: Binnen, See, UBI, SRC, LRC.
const hrefs = lang === 'de'
  ? ['/sbf-binnen/', '/sbf-see/', '/ubi/', '/src/', '/lrc/']
  : ['/en/sbf-inland/', '/en/sbf-coastal/', '/en/ubi/', '/en/src/', '/en/lrc/'];
const catalogs = t.hero.licenses.map((name, i) => ({ name, href: hrefs[i] }));
---

<section class="hh" aria-labelledby="hh-title">
  <div class="h-container">
    <div class="hh-grid">
      <div class="hh-copy">
        <h1 id="hh-title" class="hh-title">
          {t.hero.headline1}<br />
          {t.hero.headline2}<br />
          <span class="hh-accent">{t.hero.headlineAccent}</span>
        </h1>

        <p class="hh-sub">{t.hero.subline}</p>

        <div class="hh-actions">
          <StoreCta lang={lang} position="hero" id="hero-cta" class="hh-cta-device" />
          <StoreBadges lang={lang} height={48} eager position="hero" id="hero-badge" class="hh-cta-desktop" />
          <StoreRating lang={lang} />
        </div>

        <a class="hh-qr hh-cta-desktop" href={smartAppPath(lang)} data-cta-position="hero-qr">
          <Icon name="qrCode" size={18} strokeWidth={1.75} />
          <span>{h.heroQr}</span>
        </a>

        <p class="hh-note">{h.heroNote}</p>
      </div>

      <!-- Foto-Paneel mit Schein-Wähler: Die Chips wechseln den echten
           Startbildschirm der App, die Faktenzeile und die Szene dahinter
           (Binnen, See, Funk). Ohne JavaScript bleibt SBF Binnen stehen. -->
      <div class="hh-visual hh-panel" data-hero-picker>
        <HeroPhoto active="binnen" />

        <div class="hh-picker">
          <div class="hh-chips" role="tablist" aria-label={h.heroPickerLabel}>
            {licenses.map((l, i) => (
              <button
                type="button"
                class="hh-chip"
                role="tab"
                id={`hh-tab-${l.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="hh-stage"
                tabindex={i === 0 ? 0 : -1}
                data-license={l.key}
                data-scene={l.scene}
              >
                {l.pre && <span class="hh-chip-pre">{l.pre} </span>}{l.short}
              </button>
            ))}
          </div>
        </div>

        <div class="hh-stage" id="hh-stage" role="tabpanel" aria-labelledby="hh-tab-binnen">
          <p class="hh-facts">
            {licenses.map((l, i) => (
              <span class="hh-fact" data-license={l.key} hidden={i !== 0}>
                <strong>{l.questions}</strong> {h.heroQuestions}
                <span class="hh-fact-sep" aria-hidden="true">·</span>
                {l.note}
              </span>
            ))}
          </p>

          <div class="hh-phone-pos">
            <div class="hh-phone-wrap">
              <div class="h-phone hh-phone" data-tilt>
                <div class="h-phone-screen">
                  {licenses.map((l, i) => (
                    <Image
                      src={l.shot}
                      alt={h.heroPhoneAlt.replace('{license}', l.name)}
                      class:list={['hh-shot', { 'is-active': i === 0 }]}
                      data-license={l.key}
                      widths={[300, 480, 640, 760]}
                      sizes="(min-width: 1024px) 340px, 240px"
                      quality={80}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      aria-hidden={i === 0 ? undefined : 'true'}
                    />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Amtliche Kataloge: eine ruhige Zeile, je ein Textlink zur Lizenzseite. -->
    <p class="hh-catalogs">
      <span class="hh-catalogs-label">{h.heroData}</span>
      {catalogs.map((c, i) => (
        <>
          {i > 0 && <span class="hh-catalog-sep" aria-hidden="true">·</span>}
          <a class="hh-catalog" href={c.href}>{c.name}</a>
        </>
      ))}
    </p>
  </div>
</section>

<style is:global>
  .hh {
    position: relative;
    padding: calc(64px + clamp(20px, 3vw, 36px)) 0 clamp(48px, 6vw, 88px);
    background: var(--h-paper);
    overflow: clip;
    /* Container für 100cqw: das Paneel misst den Rand ohne Scrollbar. */
    container-type: inline-size;
  }
  @media (min-width: 1024px) {
    .hh { padding-top: 80px; }
  }

  /* ── Amtliche Kataloge: ruhige Textzeile, je ein Link zur Lizenzseite ── */
  .hh-catalogs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    font-size: 14px;
    color: var(--h-muted);
  }
  .hh-catalogs-label { margin-right: 6px; font-weight: 600; color: var(--h-ink); }
  .hh-catalog-sep { color: var(--h-line-2); }
  .hh-catalog {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--h-blue-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .hh-catalog:hover { text-decoration-color: currentColor; }
  .hh-catalog:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; border-radius: var(--h-r-sm); }

  .hh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .hh-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 72px);
      align-items: center;
    }
  }

  /* ── Text ── */
  .hh-copy { container-type: inline-size; align-self: center; }
  .hh-title {
    margin: 0;
    font-family: var(--h-display);
    font-stretch: 80%;
    font-weight: 760;
    /* Größe folgt der Spaltenbreite (cqi): „führerschein." bricht nie mitten
       im Wort. Einzige erlaubte Trennstelle ist das weiche Trennzeichen. */
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    font-size: clamp(2.8rem, 14cqi, 6.6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--h-ink);
    hyphens: manual;
    overflow-wrap: normal;
  }
  /* Niedrige Laptop-Fenster (z. B. MacBook mit Lesezeichenleiste): die
     Überschrift richtet sich zusätzlich nach der Höhe, damit Button und
     Bewertung ohne Scrollen sichtbar bleiben. Nur kleiner, nie größer. */
  @media (min-width: 1024px) {
    .hh-title { font-size: min(clamp(2.8rem, 14cqi, 6.6rem), 11.5vh); }
  }
  .hh-accent { color: var(--h-blue-ink); }

  .hh-sub {
    margin: 28px 0 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--h-muted);
    text-wrap: pretty;
  }

  .hh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  /* Bewertungszeile: StoreRating.astro (eigene Styles). */

  /* Desktop: Badges beider Stores statt des Geräte-Buttons (s. Kopfkommentar). */
  .hh-cta-desktop { display: none !important; }
  html[data-platform='desktop'] .hh-cta-desktop { display: flex !important; }
  html[data-platform='desktop'] .hh-cta-device { display: none; }

  .hh-qr {
    align-items: center;
    gap: 8px;
    width: fit-content;
    min-height: 44px;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--h-blue-ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .hh-qr:hover { text-decoration-color: currentColor; }
  .hh-qr:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; border-radius: var(--h-r-sm); }
  .hh-qr svg { flex: none; }

  /* Fakten als ein Satz statt vier Häkchen. */
  .hh-note {
    margin: 20px 0 0;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--h-muted);
    text-wrap: pretty;
  }

  /* ── Foto-Paneel mit Schein-Wähler ──
     Unter 1024 px ein randabfallendes Band, ab 1024 px ein Paneel, das rechts
     bis an den Viewport läuft. Das Foto (HeroPhoto) liegt absolut dahinter,
     oben sitzen Chips und Faktenzeile, darunter steht das Gerät vollständig im
     Paneel. Seine Breite folgt der Paneelhöhe abzüglich der Kopfzone
     (Paneel ist Größen-Container; Gerät ist rund 2,13-mal so hoch wie breit). */
  .hh-visual { margin: 0; }
  .hh-panel {
    position: relative;
    overflow: hidden;
    margin-inline: calc(-1 * var(--h-gutter));
    height: clamp(560px, 150vw, 680px);
    background: var(--h-paper-2);
    container-type: size;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .hh-panel { height: clamp(560px, 74vw, 700px); }
  }
  /* Dark Mode: leichte Abdunkelung über dem Dämmerungsfoto, unter Gerät und
     Chips – hält Kontaktschatten und Bedienelemente lesbar. */
  .hh-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(8, 11, 20, 0.35), rgba(8, 11, 20, 0.6));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  html.dark .hh-panel::after { opacity: 0.3; }

  /* ── Chips und Faktenzeile ──
     Feste, fast deckende Flächen statt Glas: Kontrast bleibt auf hellem
     Himmel wie auf dunkler Dämmerung über 4,5:1. */
  .hh-picker {
    position: absolute;
    z-index: 3;
    top: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: center;
  }
  .hh-chips {
    display: flex;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 10px 30px -14px rgba(11, 21, 48, 0.45), inset 0 0 0 1px rgba(11, 21, 48, 0.06);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .hh-chips::-webkit-scrollbar { display: none; }
  .hh-chip {
    flex: none;
    min-height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #0B1530;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.25s var(--h-ease), color 0.25s var(--h-ease);
  }
  .hh-chip:hover { background: rgba(11, 21, 48, 0.06); }
  .hh-chip[aria-selected='true'] { background: #0B1530; color: #fff; }
  .hh-chip:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 1px; }
  html.dark .hh-chips {
    background: rgba(11, 16, 36, 0.82);
    box-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  html.dark .hh-chip { color: #E6ECF8; }
  html.dark .hh-chip:hover { background: rgba(255, 255, 255, 0.08); }
  html.dark .hh-chip[aria-selected='true'] { background: #fff; color: #0B1530; }
  /* Schmale Handys: "SBF" bleibt für Screenreader, sichtbar nur "Binnen" und
     "See", damit alle fünf Chips ohne Scrollen nebeneinander passen. */
  @media (max-width: 479px) {
    .hh-chip { padding: 0 12px; font-size: 13px; }
    .hh-chip-pre {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .hh-stage { position: absolute; inset: 0; z-index: 2; }
  .hh-facts {
    position: absolute;
    top: 76px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: center;
    margin: 0;
  }
  .hh-fact {
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    color: #33405F;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }
  .hh-fact strong { color: #0B1530; font-weight: 700; }
  .hh-fact-sep { margin: 0 6px; color: #8A93AB; }
  html.dark .hh-fact { background: rgba(11, 16, 36, 0.78); color: #C3CCE0; }
  html.dark .hh-fact strong { color: #fff; }
  html.dark .hh-fact-sep { color: #6F7A96; }
  .hh-fact[hidden] { display: none; }

  /* ── Gerät ── */
  .hh-phone-pos {
    position: absolute;
    left: 50%;
    bottom: 4cqh;
    transform: translateX(-50%);
  }
  .hh-phone-wrap { perspective: 1400px; }
  .hh-phone {
    --pw: min(240px, 64cqw, calc((100cqh - 150px) / 2.13));
    transform-style: preserve-3d;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), var(--h-shadow-device);
  }
  /* Alle Screenshots liegen übereinander, der aktive blendet ein. */
  .hh-shot { opacity: 0; transition: opacity 0.45s var(--h-ease); }
  .hh-shot.is-active { opacity: 1; }

  @media (min-width: 1024px) {
    .hh-panel {
      /* Bis an den rechten Viewport-Rand: Containerrest plus Gutter zurückgeben. */
      margin-inline: 0 calc(-1 * ((100cqw - min(100cqw, var(--h-max))) / 2 + var(--h-gutter)));
      height: clamp(600px, 86vh, 820px);
      border-radius: 28px 0 0 28px;
    }
    .hh-picker { top: 28px; left: 28px; right: 28px; }
    .hh-facts { top: 86px; left: 28px; right: 28px; }
    .hh-phone { --pw: min(340px, 60cqw, calc((100cqh - 170px) / 2.13)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hh-panel::after, .hh-chip, .hh-shot { transition: none; }
  }

  /* ── Auftakt (nur mit h-motion, ab dem ersten Paint) ──
     Nur transform – das Handy bleibt LCP-tauglich sichtbar. Der Hub bleibt
     unter der Luft zum Paneelrand, damit das Gerät auch im Startbild der
     Animation nicht angeschnitten ist. */
  .hh-phone-wrap { --hh-rise: 18px; }
  .h-motion .hh-phone-wrap { animation: hh-rise 1.4s var(--h-ease) 0.1s both; }
  @keyframes hh-rise { from { transform: translateY(var(--hh-rise)); } }
  @media (min-width: 1024px) {
    .hh-phone-wrap { --hh-rise: 24px; }
  }
</style>

<script>
  // Schein-Wähler: Tabs nach WAI-ARIA (Pfeiltasten, Pos1/Ende, automatische
  // Aktivierung). Schaltet Screenshot, Faktenzeile und Foto-Szene um.
  const root = document.querySelector<HTMLElement>('[data-hero-picker]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.hh-chip'));
    const stage = root.querySelector<HTMLElement>('.hh-stage');
    const shots = Array.from(root.querySelectorAll<HTMLElement>('.hh-shot'));
    const facts = Array.from(root.querySelectorAll<HTMLElement>('.hh-fact'));
    const photos = Array.from(root.querySelectorAll<HTMLElement>('.hh-photo'));

    const select = (tab: HTMLButtonElement, focus = false) => {
      const key = tab.dataset.license;
      const scene = tab.dataset.scene;
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      stage?.setAttribute('aria-labelledby', tab.id);
      shots.forEach((s) => {
        const on = s.dataset.license === key;
        s.classList.toggle('is-active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      facts.forEach((f) => { f.hidden = f.dataset.license !== key; });
      photos.forEach((p) => p.classList.toggle('is-active', p.dataset.scene === scene));
      if (focus) {
        tab.focus();
        tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });
  }
</script>
