---
// Hero – links die Aussage mit dem einen CTA, rechts der echte Startbildschirm
// der App. Erster Viewport bewusst auf fünf Elemente reduziert (Spec
// docs/superpowers/specs/2026-10-17-premium-polish-design.md, 4.2): H1,
// Subline, Button mit einzeiliger Bewertung, eine Faktenzeile als Satz und
// darunter die amtlichen Kataloge als ruhige Textzeile mit Links zur
// jeweiligen Lizenzseite (die Fragenzahlen stehen in der Preisliste).
//
// Der Text steht ab dem ersten Paint fertig da (H1 = LCP-Element, CTA sofort
// nutzbar). Der Auftakt des Handys läuft als CSS-Animation und wartet nicht
// auf das JS-Bundle; GSAP übernimmt nur das Neigen per Maus.
import { Image } from 'astro:assets';
import StoreCta from './StoreCta.astro';
import HeroPhoto from './HeroPhoto.astro';
import { useTranslations } from '../../i18n/index';
import { getBoatpassCombinedRating, formatRating } from '../../data/apps';
import homeShotDe from '../../assets/images/app.screenshot.0.de.png';
import homeShotEn from '../../assets/images/app.screenshot.0.en.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const homeShot = lang === 'de' ? homeShotDe : homeShotEn;

// Google Play und App Store zusammen (nach Anzahl gewichtet), wie im Schema.
const rating = getBoatpassCombinedRating();
const score = rating ? formatRating(rating.score).replace('.', lang === 'de' ? ',' : '.') : null;

// Reihenfolge wie t.hero.licenses: Binnen, See, UBI, SRC, LRC.
const hrefs = lang === 'de'
  ? ['/sbf-binnen/', '/sbf-see/', '/ubi/', '/src/', '/lrc/']
  : ['/en/sbf-inland/', '/en/sbf-coastal/', '/en/ubi/', '/en/src/', '/en/lrc/'];
const catalogs = t.hero.licenses.map((name, i) => ({ name, href: hrefs[i] }));
const STAR = 'M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z';
---

<section class="hh" aria-labelledby="hh-title">
  <div class="h-container">
    <div class="hh-grid">
      <div class="hh-copy">
        <h1 id="hh-title" class="hh-title">
          {t.hero.headline1}<br />
          {t.hero.headline2}<br />
          <span class="hh-accent">{t.hero.headlineAccent}</span>
        </h1>

        <p class="hh-sub">{t.hero.subline}</p>

        <div class="hh-actions">
          <StoreCta lang={lang} position="hero" id="hero-cta" />
          {rating && (
            <p class="hh-rating">
              <span class="hh-stars" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="12" height="12" viewBox="0 0 16 16"><path d={STAR} fill="currentColor" /></svg>
                ))}
              </span>
              <span class="hh-rating-text">
                <span class="sr-only">{h.ratingOutOf},</span>
                <span class="h-num">{score}</span> · {rating.ratings} {h.ratingCountLabel}
              </span>
            </p>
          )}
        </div>

        <p class="hh-note">{h.heroNote}</p>
      </div>

      <div class="hh-visual hh-panel">
        <HeroPhoto />
        <div class="h-stage hh-stage">
          <div class="hh-phone-wrap">
            <div class="h-phone hh-phone" data-tilt>
              <div class="h-phone-screen">
                <Image
                  src={homeShot}
                  alt={h.phoneAlt}
                  widths={[300, 480, 640]}
                  sizes="(min-width: 1024px) 290px, 230px"
                  quality={80}
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Amtliche Kataloge: eine ruhige Zeile, je ein Textlink zur Lizenzseite. -->
    <p class="hh-catalogs">
      <span class="hh-catalogs-label">{h.heroData}</span>
      {catalogs.map((c, i) => (
        <>
          {i > 0 && <span class="hh-catalog-sep" aria-hidden="true">·</span>}
          <a class="hh-catalog" href={c.href}>{c.name}</a>
        </>
      ))}
    </p>
  </div>
</section>

<style is:global>
  .hh {
    position: relative;
    padding: calc(64px + clamp(20px, 3vw, 36px)) 0 clamp(48px, 6vw, 88px);
    background: var(--h-paper);
    overflow: clip;
  }

  /* ── Amtliche Kataloge: ruhige Textzeile, je ein Link zur Lizenzseite ── */
  .hh-catalogs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    margin: clamp(32px, 4vw, 48px) 0 0;
    font-size: 14px;
    color: var(--h-muted);
  }
  .hh-catalogs-label { margin-right: 6px; font-weight: 600; color: var(--h-ink); }
  .hh-catalog-sep { color: var(--h-line-2); }
  .hh-catalog {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--h-blue-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .hh-catalog:hover { text-decoration-color: currentColor; }
  .hh-catalog:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; border-radius: var(--h-r-sm); }

  .hh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .hh-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 72px);
      align-items: start;
    }
  }

  /* ── Text ── */
  .hh-copy { container-type: inline-size; }
  .hh-title {
    margin: 0;
    font-family: var(--h-display);
    font-stretch: 80%;
    font-weight: 760;
    /* Größe folgt der Spaltenbreite (cqi): „führerschein." bricht nie mitten
       im Wort. Einzige erlaubte Trennstelle ist das weiche Trennzeichen. */
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    font-size: clamp(2.8rem, 14cqi, 6.6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--h-ink);
    hyphens: manual;
    overflow-wrap: normal;
  }
  /* Niedrige Laptop-Fenster (z. B. MacBook mit Lesezeichenleiste): die
     Überschrift richtet sich zusätzlich nach der Höhe, damit Button und
     Bewertung ohne Scrollen sichtbar bleiben. Nur kleiner, nie größer. */
  @media (min-width: 1024px) {
    .hh-title { font-size: min(clamp(2.8rem, 14cqi, 6.6rem), 11.5vh); }
  }
  .hh-accent { color: var(--h-blue-ink); }

  .hh-sub {
    margin: 28px 0 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--h-muted);
    text-wrap: pretty;
  }

  .hh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  /* Bewertung: eine Zeile neben dem Button (Sterne, Score, Anzahl). */
  .hh-rating { display: inline-flex; align-items: center; gap: 8px; margin: 0; }
  .hh-stars { display: inline-flex; gap: 2px; color: var(--h-beacon); }
  .hh-stars svg { display: block; }
  .hh-rating-text { font: 600 14px/1 var(--h-sans); color: var(--h-muted); }
  .hh-rating-text .h-num { color: var(--h-ink); }

  /* Fakten als ein Satz statt vier Häkchen. */
  .hh-note {
    margin: 20px 0 0;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--h-muted);
    text-wrap: pretty;
  }

  /* ── Handy auf einer ruhigen Fläche ── */
  .hh-visual { margin: 0; }
  .hh-stage {
    height: 440px;
    overflow: hidden;
  }
  .hh-phone-wrap {
    position: relative;
    width: 230px;
    margin: 40px auto 0;
    perspective: 1400px;
  }
  .hh-phone { --pw: 230px; transform-style: preserve-3d; }

  /* Desktop: Handy mittig auf der Fläche, in voller Höhe sichtbar. */
  @media (min-width: 1024px) {
    .hh-stage {
      display: grid;
      place-items: center;
      height: auto;
      padding: 44px 32px;
    }
    .hh-phone-wrap {
      /* Breite folgt auch der Fensterhöhe, damit das Handy auf niedrigen
         Laptop-Fenstern vollständig im Bild bleibt. */
      --hh-pw: clamp(200px, min(18vw, 31vh), 256px);
      width: var(--hh-pw);
      margin: 0;
    }
    .hh-phone { --pw: var(--hh-pw); }
  }

  /* ── Auftakt (nur mit h-motion, ab dem ersten Paint) ──
     Nur transform – das Handy bleibt LCP-tauglich sichtbar. */
  .h-motion .hh-phone-wrap { animation: hh-rise 1.4s var(--h-ease) 0.1s both; }
  @keyframes hh-rise { from { transform: translateY(56px); } }
</style>
