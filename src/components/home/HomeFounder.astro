---
// Gründer – ein Gesicht hinter der App. Beide Fotos sind die, die auch auf
// „Über uns" stehen; keine Angaben über Beteiligte, die es nicht gibt.
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import { useTranslations } from '../../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const aboutUrl = lang === 'de' ? '/ueber-uns/' : '/en/about/';
const contactUrl = lang === 'de' ? '/kontakt/' : '/en/contact/';
---

<section class="hf h-section h-deep" aria-labelledby="hf-title">
  <div class="h-container">
    <SectionHead title={t.founder.title} id="hf-title" />

    <div class="hf-grid">
      <div class="hf-media">
        <figure class="hf-portrait" data-hf-portrait>
          <img
            src="/ueber-uns-hero.webp"
            alt={h.founderPortraitAlt}
            width="1000"
            height="1250"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="hf-inset" data-reveal>
          <img
            src="/ueber-uns.webp"
            alt={h.founderInsetAlt}
            width="1000"
            height="750"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="hf-copy">
        <p class="hf-role" data-reveal>{t.founder.role}</p>
        <p class="hf-intro" data-reveal>{t.founder.intro}</p>
        <ul class="hf-points" data-reveal>
          <li><Icon name="check" size={16} strokeWidth={2.5} class="hf-point-icon" />{t.founder.chip1}</li>
          <li><Icon name="check" size={16} strokeWidth={2.5} class="hf-point-icon" />{t.founder.chip2}</li>
        </ul>
        <div class="hf-links" data-reveal>
          <a class="h-link" href={aboutUrl}>{t.founder.cta}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a>
          <a class="h-link" href={contactUrl}>{h.founderContact}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hf { overflow: clip; }
  .hf-grid {
    display: grid;
    gap: 64px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 1024px) {
    .hf-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(56px, 7vw, 112px); align-items: end; }
  }

  .hf-media { position: relative; max-width: 460px; margin-right: 40px; }
  .hf-portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--h-r);
    background: #122453;
  }
  .hf-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }
  .hf-inset {
    position: absolute;
    right: -40px;
    bottom: -32px;
    width: 50%;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 5px solid #fff;
    border-radius: var(--h-r-md);
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.7);
  }
  .hf-inset img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
  }

  .hf-role {
    margin: 0;
    font-family: var(--h-sans);
    font-size: 13px;
    color: var(--h-on-deep-muted);
  }
  .hf-intro {
    margin: 18px 0 0;
    max-width: 36ch;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--h-on-deep);
  }
  .hf-points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .hf-points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 10px;
    border-radius: var(--h-r-pill);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px var(--h-deep-line);
    color: var(--h-on-deep);
  }
  .hf-point-icon { flex-shrink: 0; color: var(--h-beacon); }
  .hf-links { display: flex; flex-wrap: wrap; gap: 4px 28px; margin-top: 22px; }
  .hf .h-link { color: #fff; text-decoration-color: rgba(255, 255, 255, 0.4); }
  .hf .h-link:hover { text-decoration-color: #fff; }
</style>
