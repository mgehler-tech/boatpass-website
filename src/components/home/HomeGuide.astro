---
// FAQ und Ratgeber nebeneinander. Die FAQ-Paare kommen von der Seite (dort
// entsteht auch das FAQPage-Schema), die Artikel sind die drei neuesten
// Blogposts der jeweiligen Sprache.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/index';

interface Props {
  lang: 'de' | 'en';
  num: string;
  faqs: { q: string; a: string }[];
}

const { lang, num, faqs } = Astro.props;
const t = useTranslations(lang);
const h = t.home;

const posts = (await getCollection('blog', entry => entry.data.lang === lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const postHref = (id: string) => {
  const slug = id.replace(`${lang}/`, '');
  return lang === 'de' ? `/blog/${slug}/` : `/en/blog/${slug}/`;
};
const postDate = (d: Date) => d.toISOString().slice(0, 10).split('-').reverse().join('.');
---

<section id="ratgeber" class="hg h-section" aria-labelledby="hg-title">
  <div class="h-container">
    <SectionHead num={num} label={h.guideLabel} meta={h.guideMeta} title={h.faqTitle} id="hg-title" />

    <div class="hg-grid">
      <div class="hg-faq">
        <div class="hg-acc" data-reveal>
          {faqs.map((f, i) => (
            <details class="hg-item">
              <summary class="hg-q">
                <span class="hg-q-num h-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.q}</h3>
                <span class="hg-icon" aria-hidden="true"></span>
              </summary>
              <div class="hg-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
        <a class="h-link hg-more" href={getLocalizedPath(lang, '/faq/')}>{h.faqMore}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a>
      </div>

      <div class="hg-articles">
        <h2 class="hg-sub" data-reveal>{h.articlesTitle}</h2>
        <ol class="hg-list">
          {posts.map(post => (
            <li data-reveal>
              <a class="hg-post" href={postHref(post.id)}>
                <span class="hg-post-meta">
                  <span class="h-num">{postDate(post.data.date)}</span>
                  {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
                  <span>{post.data.readingTime} {h.minRead}</span>
                </span>
                <span class="hg-post-title">{post.data.title}</span>
                <span class="hg-post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="h-link hg-more" href={getLocalizedPath(lang, '/blog/')}>{t.blog.allArticles}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hg { background: var(--h-paper); }
  .hg-grid { display: grid; gap: 64px; margin-top: clamp(36px, 4vw, 56px); }
  @media (min-width: 1024px) {
    .hg-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(56px, 7vw, 104px); }
  }

  .hg-acc { border-top: 1.5px solid var(--h-rule); }
  .hg-item { border-bottom: 1px solid var(--h-line-2); }
  .hg-q {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 28px;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  .hg-q::-webkit-details-marker { display: none; }
  .hg-q-num { font-family: var(--h-mono); font-size: 13px; color: var(--h-muted); }
  .hg-q h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--h-ink);
  }
  .hg-q:hover h3 { color: var(--h-blue-ink); }
  .hg-q:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; }
  /* Plus, das sich beim Öffnen zum Minus schließt. */
  .hg-icon {
    position: relative;
    width: 28px;
    height: 28px;
    border: 1px solid var(--h-line-2);
    border-radius: 2px;
  }
  .hg-icon::before,
  .hg-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    margin: -0.75px 0 0 -5.5px;
    background: var(--h-ink);
    transition: transform 0.35s var(--h-ease);
  }
  .hg-icon::after { transform: rotate(90deg); }
  .hg-item[open] .hg-icon { border-color: var(--h-rule); }
  .hg-item[open] .hg-icon::after { transform: rotate(0deg); }
  .hg-a p {
    margin: 0;
    padding: 0 40px 22px 56px;
    max-width: 66ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--h-muted);
  }
  @media (max-width: 639px) {
    .hg-q { grid-template-columns: 32px minmax(0, 1fr) 28px; }
    .hg-a p { padding: 0 0 20px 44px; }
  }
  /* Sanftes Aufklappen, wo der Browser es kann – sonst öffnet es sofort. */
  .home { interpolate-size: allow-keywords; }
  .hg-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.45s var(--h-ease), content-visibility 0.45s allow-discrete;
  }
  .hg-item[open]::details-content { block-size: auto; }

  .hg-more { margin-top: 14px; }

  .hg-sub {
    margin: 0 0 14px;
    font-family: var(--h-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    line-height: 1.1;
    color: var(--h-ink);
  }
  .hg-list { margin: 0; padding: 0; list-style: none; border-top: 1.5px solid var(--h-rule); }
  .hg-list li { border-bottom: 1px solid var(--h-line-2); }
  .hg-post {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 0;
    color: inherit;
    text-decoration: none;
  }
  .hg-post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-family: var(--h-mono);
    font-size: 12.5px;
    color: var(--h-muted);
  }
  .hg-post-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--h-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.25s ease;
  }
  .hg-post:hover .hg-post-title { text-decoration-color: currentColor; }
  .hg-post-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--h-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hg-post:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .hg-icon::before, .hg-icon::after, .hg-item::details-content { transition: none; }
  }
</style>
