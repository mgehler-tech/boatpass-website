---
// Echte Google-Play-Rezensionen (nur deutsche Startseite – alle vorliegenden
// Texte sind deutschsprachig, eine übersetzte Rezension wäre keine mehr).
//
// Regeln aus data/reviews.ts gelten weiter: wortgleich, keine Profilbilder.
// Hier gibt es bewusst gar keine Avatare – weder fremde Fotos noch
// Buchstaben-Kreise –, sondern Name, Datum, Sterne und ggf. „bestanden".
//
// Laufband: eine echte Liste; home-motion.ts hängt ab 769px und ohne
// reduzierte Bewegung aria-hidden/inert-Klone an und startet die Animation.
// Anhalten per Schalter (WCAG 2.2.2), Hover oder Fokus; außerhalb des
// Sichtbereichs steht sie ohnehin still. Ohne JS: wischbare Reihe.
import Icon from '../Icon.astro';
import SplitText from './SplitText.astro';
import { REVIEWS_DE, formatReviewDate } from '../../data/reviews';
import { getBoatpassRating, formatRating } from '../../data/apps';
import { useTranslations } from '../../i18n/index';

const t = useTranslations('de');
const h = t.home;
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
const rating = getBoatpassRating();
const score = rating ? formatRating(rating.score).replace('.', ',') : null;
---

<section class="hr h-section" aria-labelledby="hr-title">
  <div class="h-container hr-head">
    <div class="hr-intro">
      <p class="h-eyebrow" data-reveal>{h.reviewsEyebrow}</p>
      <SplitText as="h2" id="hr-title" class="h-display" text={h.reviewsTitle} />
      <p class="h-lede" data-reveal>{h.reviewsIntro}</p>
    </div>

    {rating && (
      <div class="hr-score" data-reveal>
        <p class="hr-score-line">
          <span class="hr-score-num h-num">{score}</span>
          <span class="sr-only">{h.ratingOutOf},</span>
          <span class="hr-score-stars" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg width="18" height="18" viewBox="0 0 16 16"><path d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z" fill="currentColor" /></svg>
            ))}
          </span>
        </p>
        <p class="hr-score-count">{rating.ratings} {h.ratingSource}</p>
        <a class="h-link" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="reviews">
          {h.reviewsAll}
          <Icon name="chevronRight" size={16} strokeWidth={2.25} />
          <span class="sr-only">{h.newTab}</span>
        </a>
      </div>
    )}
  </div>

  <!-- tabindex: Ohne Laufband ist die Reihe seitlich scrollbar und muss per
       Tastatur erreichbar sein. Läuft das Laufband, entfernt home-motion.ts
       den Tab-Stopp wieder (dann gibt es nichts zu scrollen). -->
  <div class="hr-viewport" data-marquee role="region" aria-label={h.reviewsListLabel} tabindex="0">
    <ul class="hr-track" data-marquee-track>
      {REVIEWS_DE.map(r => (
        <li class="hr-card">
          <figure class="hr-figure">
            <div class="hr-stars" role="img" aria-label={`${r.stars} von 5 Sternen`}>
              {Array.from({ length: r.stars }).map(() => (
                <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z" fill="currentColor" /></svg>
              ))}
            </div>
            <blockquote class="hr-quote"><p>{r.excerpt ?? r.text}</p></blockquote>
            <figcaption class="hr-meta">
              <span class="hr-name">{r.name}</span>
              <time class="hr-date" datetime={r.date}>{formatReviewDate(r.date)}</time>
              {r.passed && <span class="hr-passed"><Icon name="check" size={13} strokeWidth={3} />{r.passed}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="h-container hr-foot">
    <button type="button" class="hr-toggle" data-marquee-toggle data-paused="false" hidden
      data-label-pause={h.reviewsPause} data-label-play={h.reviewsPlay}>
      <span class="hr-toggle-icon" aria-hidden="true"></span>
      <span data-marquee-toggle-label>{h.reviewsPause}</span>
    </button>
  </div>
</section>

<style is:global>
  .hr { background: var(--h-paper); }
  .hr-head {
    display: grid;
    gap: 40px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .hr-head { grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr); gap: 64px; }
  }

  .hr-score {
    padding-top: 22px;
    border-top: 1px solid var(--h-line-2);
  }
  .hr-score-line { display: flex; align-items: center; gap: 16px; margin: 0; }
  .hr-score-num {
    font-family: var(--h-display);
    font-weight: 500;
    font-size: clamp(64px, 8vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--h-ink);
  }
  .hr-score-stars { display: inline-flex; gap: 3px; color: var(--h-beacon); }
  .hr-score-count { margin: 12px 0 6px; font-size: 15px; font-weight: 550; color: var(--h-muted); }

  /* ── Reihe: ohne Laufband wischbar ── */
  .hr-viewport {
    margin-top: clamp(48px, 6vw, 80px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--h-gutter);
    padding: 6px 0 20px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .hr-viewport::-webkit-scrollbar { display: none; }
  .hr-viewport:focus-visible { outline: 3px solid var(--h-blue); outline-offset: -3px; border-radius: 24px; }
  .hr-track {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 0 var(--h-gutter);
    list-style: none;
  }
  .hr-card {
    flex-shrink: 0;
    width: min(360px, 80vw);
    scroll-snap-align: start;
  }
  .hr-figure {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 26px 26px 22px;
    border-radius: 24px;
    background: var(--h-card);
    border: 1px solid var(--h-line);
  }
  .hr-stars { display: flex; gap: 2px; color: var(--h-beacon); }
  .hr-quote { margin: 18px 0 22px; flex: 1; }
  .hr-quote p {
    margin: 0;
    font-family: var(--h-display);
    font-weight: 420;
    font-size: 19px;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--h-ink);
  }
  .hr-quote p::before { content: '„'; }
  .hr-quote p::after { content: '“'; }
  .hr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding-top: 16px;
    border-top: 1px solid var(--h-line);
    font-size: 14px;
  }
  .hr-name { font-weight: 700; color: var(--h-ink); }
  .hr-date { color: var(--h-muted); }
  .hr-passed {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--h-stbd-wash);
    color: var(--h-stbd-ink);
    font-size: 12.5px;
    font-weight: 700;
  }

  /* ── Laufband (Klasse von home-motion.ts) ── */
  .hr-viewport.is-marquee {
    overflow: hidden;
    scroll-snap-type: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .hr-viewport.is-marquee .hr-track {
    animation: hr-marquee var(--hr-duration, 70s) linear infinite;
  }
  .hr-viewport.is-marquee:hover .hr-track,
  .hr-viewport.is-marquee:focus-within .hr-track,
  .hr-viewport.is-paused .hr-track,
  .hr-viewport.is-offscreen .hr-track { animation-play-state: paused; }
  /* Die Hälfte der (verdoppelten) Spur plus ein halber Abstand – nahtlos. */
  @keyframes hr-marquee {
    to { transform: translateX(calc(-50% - 10px)); }
  }

  .hr-foot { display: flex; justify-content: flex-end; }
  .hr-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--h-line-2);
    background: transparent;
    color: var(--h-text);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .hr-toggle[hidden] { display: none; }
  .hr-toggle:hover { border-color: var(--h-blue); color: var(--h-blue-ink); }
  .hr-toggle-icon {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .hr-toggle[data-paused='true'] .hr-toggle-icon {
    width: 0;
    height: 0;
    border-left: 10px solid currentColor;
    border-right: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
</style>
