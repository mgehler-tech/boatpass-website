---
// Echte Rezensionen aus Google Play und dem App Store (nur deutsche
// Startseite – alle vorliegenden Texte sind deutschsprachig, eine übersetzte
// Rezension wäre keine mehr).
//
// Regeln aus data/reviews.ts gelten weiter: wortgleich, keine Profilbilder.
// Aufbau: beide Store-Bewertungen neben dem Titel, eine Rezension mit
// bestandener Prüfung groß vorn, die übrigen als ruhige Karten daneben und
// darunter (ab 1024px) bzw. als Wischreihe (darunter). Jede Karte nennt ihren
// Store. Keine Linien, kein Tabellen-Raster.
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import { REVIEWS_DE, formatReviewDate, type Review, type ReviewStore } from '../../data/reviews';
import { getBoatpassRating, getBoatpassIosRating, formatRating, type AppRating } from '../../data/apps';
import { PLAY_STORE_URL, appStoreUrl } from '../../data/stores';
import { useTranslations } from '../../i18n/index';

const t = useTranslations('de');
const h = t.home;

// App Store zuerst, wie im Footer.
const scores = [
  { store: 'ios' as const, rating: getBoatpassIosRating(), label: h.ratingSourceIos },
  { store: 'play' as const, rating: getBoatpassRating(), label: h.ratingSourcePlay },
].filter((s): s is { store: ReviewStore; rating: AppRating; label: string } => s.rating !== null);
const fmt = (n: number) => formatRating(n).replace('.', ',');

const STORE_NAME: Record<ReviewStore, string> = { ios: 'App Store', play: 'Google Play' };

// Vorn steht die erste Stimme mit bestandener Prüfung – das stärkste Argument.
const lead = REVIEWS_DE.find(r => r.passed) ?? REVIEWS_DE[0];
const rest = REVIEWS_DE.filter(r => r !== lead);

// Kachel-Raster ab 1024px: große Karte 2×2 links oben, zwei kleine rechts
// daneben, darunter volle Dreierreihen. Geht nur bei 2 + 3n weiteren Karten
// auf, sonst fließen die Karten einfach.
const bento = rest.length >= 5 && (rest.length - 2) % 3 === 0;
const len = (r: Review) => (r.excerpt ?? r.text).length;
const byLen = (a: Review, b: Review) => len(b) - len(a);

// Neben der großen Karte steht je die kürzeste Stimme beider Stores, damit
// die Höhe passt. Der Rest wechselt die Stores ab (der große Platz gehört
// einem Store, also beginnt die Reihe mit dem anderen), längste zuerst: In
// der Wischreihe unter 1024px ist die erste Karte dann voll, nicht halb leer.
function interleave(list: Review[], first: ReviewStore): Review[] {
  const a = list.filter(r => r.store === first).sort(byLen);
  const b = list.filter(r => r.store !== first).sort(byLen);
  const out: Review[] = [];
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    if (a[i]) out.push(a[i]);
    if (b[i]) out.push(b[i]);
  }
  return out;
}
const other: ReviewStore = lead.store === 'ios' ? 'play' : 'ios';
let side: Review[] = [];
if (bento) {
  const shortest = (st: ReviewStore) => rest.filter(r => r.store === st).sort(byLen).at(-1);
  side = [shortest(other), shortest(lead.store)].filter((r): r is Review => !!r);
  // Fehlt ein Store, kommen die zwei kürzesten insgesamt neben die große Karte.
  if (side.length < 2) side = [...rest].sort(byLen).slice(-2);
}
const below = interleave(rest.filter(r => !side.includes(r)), other);
// Reihenfolge im DOM (= Wischreihe): erst die Reihen darunter, dann die zwei
// kurzen. Die Position im Raster setzt --hr-row/--hr-col je Karte.
const cards = bento
  ? [
      ...below.map((r, i) => ({ r, row: 3 + Math.floor(i / 3), col: 'auto' })),
      ...side.map((r, i) => ({ r, row: 1 + i, col: '3' })),
    ]
  : rest.map(r => ({ r, row: 'auto', col: 'auto' }));
const rows = bento ? 2 + Math.ceil(below.length / 3) : 0;

const STAR = 'M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z';
---

<section class="hr h-section" aria-labelledby="hr-title">
  <div class="h-container">
    <div class="hr-head">
      <SectionHead title={h.reviewsTitle} lede={h.reviewsIntro} id="hr-title" />
      {scores.length > 0 && (
        <div class="hr-scores" data-reveal>
          {scores.map(({ store, rating, label }) => (
            <div class="hr-score">
              <p class="hr-score-num h-num">{fmt(rating.score)}<span class="sr-only"> {h.ratingOutOf}</span></p>
              <div class="hr-score-side">
                <span class="hr-score-stars" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="16" height="16" viewBox="0 0 16 16"><path d={STAR} fill="currentColor" /></svg>
                  ))}
                </span>
                <span class="hr-score-count">{rating.ratings} {label}</span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class:list={['hr-wall', bento && 'hr-wall--bento']} style={bento ? `--hr-rows:${rows}` : undefined}>
      <figure class="hr-lead" data-reveal>
        <div class="hr-top">
          <span class="hr-stars" role="img" aria-label={`${lead.stars} von 5 Sternen`}>
            {Array.from({ length: lead.stars }).map(() => (
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={STAR} fill="currentColor" /></svg>
            ))}
          </span>
          {lead.passed && (
            <span class="hr-passed"><Icon name="check" size={14} strokeWidth={2.75} />{lead.passed}</span>
          )}
        </div>
        <blockquote class="hr-quote"><p>{lead.excerpt ?? lead.text}</p></blockquote>
        <figcaption class="hr-by">
          <span class="hr-name">{lead.name}</span>
          <time class="hr-date" datetime={lead.date}>{formatReviewDate(lead.date)}</time>
          <span class="hr-src">{STORE_NAME[lead.store]}</span>
        </figcaption>
      </figure>

      <ol class="hr-list" aria-label={h.reviewsListLabel} data-reveal>
        {cards.map(({ r, row, col }) => (
          <li class="hr-card" style={`--hr-row:${row};--hr-col:${col}`}>
            <figure class="hr-fig">
              <div class="hr-top">
                <span class="hr-stars" role="img" aria-label={`${r.stars} von 5 Sternen`}>
                  {Array.from({ length: r.stars }).map(() => (
                    <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d={STAR} fill="currentColor" /></svg>
                  ))}
                </span>
                {r.passed && (
                  <span class="hr-passed"><Icon name="check" size={12} strokeWidth={3} />{r.passed}</span>
                )}
              </div>
              <blockquote class="hr-quote"><p>{r.excerpt ?? r.text}</p></blockquote>
              <figcaption class="hr-by">
                <span class="hr-name">{r.name}</span>
                <time class="hr-date" datetime={r.date}>{formatReviewDate(r.date)}</time>
                <span class="hr-src">{STORE_NAME[r.store]}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>

    <p class="hr-more" data-reveal>
      <!-- data-store: Die Links führen gezielt zur Bewertungsseite des jeweiligen Stores und dürfen nicht umgeleitet werden. -->
      <a class="h-link" href={appStoreUrl('de')} data-store="ios" target="_blank" rel="noopener noreferrer" data-cta-position="reviews">
        {h.reviewsAllIos}
        <Icon name="chevronRight" size={16} strokeWidth={2.25} />
        <span class="sr-only">{h.newTab}</span>
      </a>
      <a class="h-link" href={PLAY_STORE_URL} data-store="play" target="_blank" rel="noopener noreferrer" data-cta-position="reviews">
        {h.reviewsAll}
        <Icon name="chevronRight" size={16} strokeWidth={2.25} />
        <span class="sr-only">{h.newTab}</span>
      </a>
    </p>
  </div>
</section>

<style is:global>
  .hr { background: var(--h-paper); }

  /* ── Kopf: Titel links, Gesamtbewertung rechts unten ─────────────── */
  .hr-head { display: grid; gap: 28px; }
  @media (min-width: 1024px) {
    .hr-head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 64px; }
  }
  .hr-scores { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 36px; }
  .hr-score { display: flex; align-items: center; gap: 14px; }
  /* Feine Trennlinie zwischen den beiden Stores, nur wenn sie nebeneinander stehen. */
  .hr-score + .hr-score { position: relative; }
  .hr-score + .hr-score::before {
    content: '';
    position: absolute;
    left: -18px;
    top: 10%;
    bottom: 10%;
    width: 1px;
    background: var(--h-line);
  }
  /* Schmal: untereinander, ohne Trennlinie (sie hinge sonst links im Leeren). */
  @media (max-width: 699px) {
    .hr-scores { flex-direction: column; align-items: flex-start; }
    .hr-score + .hr-score::before { display: none; }
  }
  .hr-score-num {
    margin: 0;
    font-family: var(--h-display);
    font-stretch: 80%;
    font-weight: 740;
    font-size: clamp(2.75rem, 4.2vw, 3.75rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--h-ink);
  }
  .hr-score-side { display: grid; gap: 6px; }
  .hr-score-stars { display: flex; gap: 3px; color: var(--h-beacon); }
  .hr-score-count { font-size: 14px; color: var(--h-muted); }

  /* ── Rezensionen ──────────────────────────────────────────────────── */
  .hr-wall { display: grid; gap: 16px; margin-top: clamp(36px, 4.5vw, 56px); }

  .hr-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .hr-stars { display: inline-flex; gap: 2px; color: var(--h-beacon); }
  .hr-passed {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px 4px 9px;
    border-radius: var(--h-r-pill);
    background: var(--h-stbd-wash);
    color: var(--h-stbd-ink);
    font-size: 13px;
    font-weight: 650;
  }
  .hr-quote { margin: 0; }
  .hr-quote p { margin: 0; text-wrap: pretty; }
  .hr-quote p::before { content: '„'; }
  .hr-quote p::after { content: '“'; }
  .hr-by { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin-top: auto; }
  .hr-name { font-size: 15px; font-weight: 700; color: var(--h-ink); }
  .hr-date, .hr-src { font-size: 13.5px; color: var(--h-muted); }
  .hr-src::before { content: '·'; margin-right: 10px; }

  /* Große Karte: tiefes Blau, Zitat in der Display-Schrift. Sterne und
     „bestanden“ oben, Zitat und Name sitzen unten. */
  .hr-lead {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: clamp(26px, 4vw, 48px);
    border-radius: calc(var(--h-r) + 8px);
    background: var(--h-deep);
    color: var(--h-on-deep);
  }
  html.dark .hr-lead { background: #18213F; }
  .hr-lead .hr-passed { background: rgba(104, 217, 160, 0.16); color: #7BE0AE; }
  .hr-lead .hr-quote { margin-top: auto; }
  .hr-lead .hr-quote p {
    max-width: 34ch;
    font-family: var(--h-display);
    font-stretch: 92%;
    font-weight: 560;
    font-size: clamp(1.4rem, 2.5vw, 2.15rem);
    line-height: 1.26;
    letter-spacing: -0.012em;
    color: var(--h-on-deep);
  }
  .hr-lead .hr-by { margin-top: 0; }
  .hr-lead .hr-name { font-size: 16px; color: var(--h-on-deep); }
  .hr-lead .hr-date, .hr-lead .hr-src { color: var(--h-on-deep-muted); }

  /* Kleine Karten */
  .hr-list { margin: 0; padding: 0; list-style: none; }
  .hr-card { display: flex; }
  .hr-fig {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    margin: 0;
    padding: 22px 22px 20px;
    border-radius: var(--h-r);
    background: var(--h-card);
    box-shadow: 0 0 0 1px var(--h-line), 0 1px 2px rgba(11, 21, 48, 0.04);
  }
  .hr-fig .hr-quote p { font-size: 16px; line-height: 1.58; color: var(--h-ink); }

  /* Unter 1024px: Wischreihe statt langer Liste. Die angeschnittene
     nächste Karte zeigt, dass es weitergeht. */
  @media (max-width: 1023px) {
    .hr-list {
      display: flex;
      gap: 12px;
      margin-inline: calc(-1 * var(--h-gutter));
      padding: 2px var(--h-gutter) 10px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--h-gutter);
      scrollbar-width: none;
    }
    .hr-list::-webkit-scrollbar { display: none; }
    .hr-card { flex: 0 0 min(84%, 340px); scroll-snap-align: start; }
    /* Gleich hohe Karten, Name direkt unter dem Zitat: Freiraum bleibt
       unten in der Karte statt mitten im Text. */
    .hr-fig .hr-by { margin-top: 0; }
  }

  @media (min-width: 1024px) {
    .hr-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hr-list { display: contents; }
    .hr-wall:not(.hr-wall--bento) .hr-lead { grid-column: 1 / -1; }

    /* Große Karte über zwei Spalten und zwei Zeilen, zwei kleine rechts
       daneben, darunter volle Dreierreihen. Die Liste ist ein Subgrid,
       damit sie eine echte <ol> bleibt; die Position jeder Karte kommt als
       --hr-row/--hr-col aus dem Frontmatter. */
    .hr-wall--bento { grid-template-rows: repeat(var(--hr-rows, 3), auto); }
    .hr-wall--bento .hr-lead { grid-column: 1 / 3; grid-row: 1 / 3; }
    .hr-wall--bento .hr-list {
      display: grid;
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      pointer-events: none;
    }
    .hr-wall--bento .hr-card {
      pointer-events: auto;
      grid-row: var(--hr-row);
      grid-column: var(--hr-col);
    }
  }

  .hr-more { display: flex; flex-wrap: wrap; gap: 0 28px; margin: 24px 0 0; }
</style>
