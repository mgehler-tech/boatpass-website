---
// Foto-Bühne des Heros (Spec 4.1): Art Direction mit je zwei Quellen (3:4 ab
// 1024 px, 16:9 darunter) für Tag und Dämmerung (Spec Anhang A1 und A2).
// Astros <Picture> kennt kein <source media>, deshalb getImage() je Quelle und
// Format und handgebaute <picture>-Elemente; so lädt das Handy nie beide
// Bildformate.
//
// Der Dark Mode ist klassenbasiert (html.dark), deshalb zwei <picture>: Tag
// eager mit hoher Priorität (LCP-Kandidat), Dämmerung lazy. CSS blendet die
// jeweils andere aus; ein per display:none verborgenes lazy-Bild wird nicht
// geladen. Im Dark Mode kostet das Tagbild einmalig einen versteckten Download
// (rund 30 bis 60 KB), dafür steht das Tagbild im Hellmodus ab dem ersten Paint.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import waterDay from '../../assets/images/hero/water-day.webp';
import waterDayWide from '../../assets/images/hero/water-day-wide.webp';
import waterDusk from '../../assets/images/hero/water-dusk.webp';
import waterDuskWide from '../../assets/images/hero/water-dusk-wide.webp';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const widths = [640, 960, 1280, 1920];
const quality = 68;
// Paneel ab 1024 px: 5 von 12 Spalten plus Rand, rund 42 % der Breite.
const portraitSizes = '42vw';
// Unter 640 px ist das Band 124vw hoch; ein 16:9-Bild, das es per object-fit:
// cover füllt, ist rund 220vw breit. Zwischen 640 und 1023 px hat das Band
// selbst 16:9, also 100vw.
const wideSizes = '(max-width: 639px) 220vw, 100vw';

async function sources(portrait: ImageMetadata, wide: ImageMetadata) {
  const [pAvif, pWebp, wAvif, wWebp] = await Promise.all([
    getImage({ src: portrait, width: 960, widths, format: 'avif', quality }),
    getImage({ src: portrait, width: 960, widths, format: 'webp', quality }),
    getImage({ src: wide, width: 1280, widths, format: 'avif', quality }),
    getImage({ src: wide, width: 1280, widths, format: 'webp', quality }),
  ]);
  return { pAvif, pWebp, wAvif, wWebp };
}

const day = await sources(waterDay, waterDayWide);
const dusk = await sources(waterDusk, waterDuskWide);
---

<picture class:list={['hh-photo', 'hh-photo--day', className]}>
  <source media="(min-width: 1024px)" type="image/avif" srcset={day.pAvif.srcSet.attribute} sizes={portraitSizes} />
  <source media="(min-width: 1024px)" type="image/webp" srcset={day.pWebp.srcSet.attribute} sizes={portraitSizes} />
  <source type="image/avif" srcset={day.wAvif.srcSet.attribute} sizes={wideSizes} />
  <source type="image/webp" srcset={day.wWebp.srcSet.attribute} sizes={wideSizes} />
  <img
    src={day.wWebp.src}
    width={day.wWebp.attributes.width}
    height={day.wWebp.attributes.height}
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>
<picture class:list={['hh-photo', 'hh-photo--dusk', className]}>
  <source media="(min-width: 1024px)" type="image/avif" srcset={dusk.pAvif.srcSet.attribute} sizes={portraitSizes} />
  <source media="(min-width: 1024px)" type="image/webp" srcset={dusk.pWebp.srcSet.attribute} sizes={portraitSizes} />
  <source type="image/avif" srcset={dusk.wAvif.srcSet.attribute} sizes={wideSizes} />
  <source type="image/webp" srcset={dusk.wWebp.srcSet.attribute} sizes={wideSizes} />
  <img
    src={dusk.wWebp.src}
    width={dusk.wWebp.attributes.width}
    height={dusk.wWebp.attributes.height}
    alt=""
    loading="lazy"
    decoding="async"
  />
</picture>

<style is:global>
  /* Füllt das Paneel. Ab 1024 px 12 % Überhang unten als Reserve für die
     Scroll-Parallaxe (home-motion.ts), damit kein Rand durchblitzt; darunter
     läuft keine Parallaxe, deshalb kein Überhang (der würde nur den
     Bildausschnitt verschieben). */
  .hh-photo {
    position: absolute;
    inset: 0;
    display: block;
    line-height: 0;
  }
  @media (min-width: 1024px) {
    .hh-photo { bottom: -12%; }
  }
  .hh-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
  }
  /* Tag oder Dämmerung, nie beide: ein verborgenes lazy-Bild wird nicht geladen. */
  html.dark .hh-photo--day { display: none; }
  html:not(.dark) .hh-photo--dusk { display: none; }
</style>
