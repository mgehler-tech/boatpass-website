---
// Lizenzen & Preise als Tarifliste. Fragenzahlen kommen aus i18n/pricing, Preise
// je Store aus data/stores (PlatformPrice zeigt auf iPhone/iPad den App-Store-
// Preis) – nichts ist hier hart kodiert (Fragenzahlen der Pakete sind die
// Summe ihrer Teile, Streichpreis und Ersparnis kommen je Store aus stores.ts).
// Aufbau: das Modell (kostenlos → Vollzugang), dann zwei Gruppen mit den
// Einzellizenzen als Zeilen und dem Paket der Gruppe als Karte daneben, dann
// der Schein-Finder. Bewusst keine drei Karten mit hervorgehobener Mitte.
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import StoreCta from './StoreCta.astro';
import PlatformPrice from '../PlatformPrice.astro';
import { useTranslations } from '../../i18n/index';
import { PLAY_STORE_URL, PRICES, bundleSaving, formatPrice, priceNote, type ProductKey } from '../../data/stores';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.pricing;
const h = t.home;
const de = lang === 'de';
const playStoreUrl = PLAY_STORE_URL;
// Pakete: Streichpreis (Summe der Einzelpreise) und Ersparnis je Store –
// beides weicht zwischen Google Play und App Store ab.
const saveLabel = de ? 'Spare' : 'Save';
const bundleInfo = (bundle: ProductKey, parts: ProductKey[]) =>
  (['android', 'ios'] as const).map(platform => ({
    cls: platform === 'android' ? 'pp-android' : 'pp-ios',
    strike: formatPrice(parts.reduce((sum, k) => sum + (PRICES[k][platform] ?? 0), 0), lang),
    save: formatPrice(bundleSaving(bundle, parts, platform), lang),
  }));
const finderUrl = de ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/';

type Row = {
  name: string;
  sub: string;
  note?: string;
  questions: string;
  topics?: string;
  product: ProductKey;
  href: string;
  action: string;
};

/** Das Paket einer Gruppe: eigene Karte neben den Zeilen (Spec Runde 2, 5.2). */
type Bundle = {
  name: string;
  sub: string;
  questions: string;
  product: ProductKey;
  /** Die enthaltenen Einzelprodukte (Streichpreis, Ersparnis, Katalogzahl). */
  parts: ProductKey[];
  badge: string;
  choose: string;
};

const sum = (...counts: string[]) => String(counts.reduce((n, c) => n + Number(c), 0));

const groups: { key: 'sbf' | 'funk'; title: string; note?: string; rows: Row[]; bundle: Bundle }[] = [
  {
    key: 'sbf',
    title: p.sbfHeading,
    rows: [
      { name: p.catalog1Name, sub: p.catalog1Tagline, questions: p.catalog1Questions, topics: p.catalog1Themes, product: 'sbfBinnen', href: de ? '/sbf-binnen/' : '/en/sbf-inland/', action: p.detailsLink },
      { name: p.catalog2Name, sub: p.catalog2Desc, note: p.catalog2Highlight, questions: p.catalog2Questions, topics: p.catalog2Themes, product: 'sbfSee', href: de ? '/sbf-see/' : '/en/sbf-coastal/', action: p.detailsLink },
    ],
    bundle: { name: h.bundleName, sub: p.bundleTagline, questions: sum(p.catalog1Questions, p.catalog2Questions), product: 'bundleSbf', parts: ['sbfBinnen', 'sbfSee'], badge: p.bundleLabel, choose: p.bundleChoose },
  },
  {
    key: 'funk',
    title: p.funkHeading,
    note: p.funkSubtitle,
    rows: [
      { name: 'SRC', sub: de ? 'Seefunk (Küste)' : 'Sea radio (coastal)', questions: p.srcQuestions, topics: p.srcThemes, product: 'src', href: de ? '/src/' : '/en/src/', action: p.funkMore },
      { name: 'UBI', sub: de ? 'Binnenfunk' : 'Inland radio', questions: p.catalog3Questions, topics: p.catalog3Themes, product: 'ubi', href: de ? '/ubi/' : '/en/ubi/', action: p.funkMore },
      { name: 'LRC', sub: de ? 'Seefunk (weltweit)' : 'Sea radio (worldwide)', questions: p.lrcQuestions, topics: p.lrcThemes, product: 'lrc', href: de ? '/lrc/' : '/en/lrc/', action: p.funkMore },
    ],
    bundle: { name: h.funkBundleName, sub: h.funkBundleTagline, questions: sum(p.catalog3Questions, p.srcQuestions, p.lrcQuestions), product: 'bundleFunk', parts: ['ubi', 'src', 'lrc'], badge: p.bundleLabel, choose: p.bundleChoose },
  },
];
---

<section id="pricing" class="hp h-section" aria-labelledby="hp-title">
  <div class="h-container">
    <SectionHead
      title={p.title}
      lede={p.subtitle}
      id="hp-title"
      layout="split"
    />

    <!-- Modell: kostenlos starten → bei Bedarf einmalig freischalten -->
    <div class="hp-model" data-reveal>
      <div class="hp-plan">
        <p class="hp-plan-label">{p.freeLabel}</p>
        <p class="hp-plan-price h-num">{h.freePrice}</p>
        <p class="hp-plan-sub">{p.compareFreeSub}</p>
        <ul class="hp-plan-list">
          {p.freeFeatures.map(f => <li><Icon name="check" size={16} strokeWidth={2.5} class="hp-plan-icon" />{f}</li>)}
        </ul>
      </div>
      <div class="hp-plan">
        <p class="hp-plan-label">{p.comparePaidLabel}</p>
        <p class="hp-plan-price h-num"><span class="hp-plan-unit">{h.fullFrom}</span> {h.fullPrice} <span class="hp-plan-unit">{h.fullUnit}</span></p>
        <p class="hp-plan-sub">{p.comparePaidSub}</p>
        <ul class="hp-plan-list">
          {p.comparePaidFeatures.map(f => <li><Icon name="check" size={16} strokeWidth={2.5} class="hp-plan-icon" />{f}</li>)}
        </ul>
      </div>
      <div class="hp-plan hp-plan--cta">
        <StoreCta lang={lang} position="pricing" label={p.ctaFree} id="pricing-cta" />
      </div>
    </div>

    <!-- Tarifliste: Einzellizenzen als Zeilen, das Paket der Gruppe als Karte daneben -->
    {groups.map(group => (
      <div class="hp-group">
        <div class="hp-group-head" data-reveal>
          <h3 class="hp-group-title">{group.title}</h3>
          {group.note && <p class="hp-group-note">{group.note}</p>}
        </div>
        <div class="hp-group-body">
          <ul class="hp-rows">
            {group.rows.map(row => (
              <li data-reveal>
                <!-- Die ganze Zeile ist der Link zur Detailseite; der Name der
                     Zeile ergibt sich aus ihrem Inhalt plus „, Details ansehen". -->
                <a class="hp-row" href={row.href}>
                  <span class="hp-name">
                    <span class="hp-name-main">{row.name}</span>
                    <span class="hp-name-sub">{row.sub}</span>
                    {row.note && <span class="hp-name-note">{row.note}</span>}
                  </span>
                  <span class="hp-cell hp-cell--q h-num"><strong>{row.questions}</strong> {h.colQuestions}</span>
                  <span class="hp-cell hp-cell--t h-num">{row.topics ? <Fragment><strong>{row.topics}</strong> {h.colTopics}</Fragment> : <span aria-hidden="true">—</span>}</span>
                  <span class="hp-price">
                    <span class="hp-price-num h-num"><PlatformPrice product={row.product} lang={lang} /></span>
                    <span class="hp-price-sub">{h.once}</span>
                  </span>
                  <span class="hp-chevron" aria-hidden="true"><Icon name="chevronRight" size={18} strokeWidth={2.25} /></span>
                  <span class="sr-only">, {row.action}</span>
                </a>
              </li>
            ))}
          </ul>
          <aside class="hp-bundle" aria-labelledby={`hp-bundle-${group.key}`} data-reveal>
            <span class="hp-badge">{group.bundle.badge}</span>
            <h4 id={`hp-bundle-${group.key}`} class="hp-bundle-title">{group.bundle.name}</h4>
            <p class="hp-bundle-sub">{group.bundle.sub}</p>
            <p class="hp-bundle-meta h-num"><strong>{group.bundle.questions}</strong> {h.colQuestions} · {group.bundle.parts.length} {p.catalogsLabel}</p>
            <p class="hp-bundle-price h-num"><PlatformPrice product={group.bundle.product} lang={lang} /></p>
            <p class="hp-bundle-save">
              {bundleInfo(group.bundle.product, group.bundle.parts).map(b => (
                <span class={b.cls}><s class="h-num">{b.strike}</s>{` · ${saveLabel} ${b.save}`}</span>
              ))}
            </p>
            <a class="h-btn h-btn--sm hp-bundle-cta" href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="pricing-bundle">
              {group.bundle.choose}<Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" /><span class="sr-only h-off-desktop">{h.newTab}</span>
            </a>
            <p class="hp-bundle-note">{p.bundleNote}</p>
          </aside>
        </div>
      </div>
    ))}

    <!-- Preishinweis je Store (PAngV) – Text passend zum Gerät -->
    <p class="hp-price-note" data-reveal>
      <span class="pp-android">{priceNote('android', lang)}</span><span class="pp-ios">{priceNote('ios', lang)}</span>
    </p>

    <a class="hp-finder" href={finderUrl} data-reveal>
      <span class="hp-finder-text">
        <strong>{h.finderTitle}</strong>
        <span>{h.finderText}</span>
      </span>
      <span class="hp-finder-cta">{h.finderCta}<Icon name="chevronRight" size={16} strokeWidth={2.25} /></span>
    </a>
  </div>
</section>

<style is:global>
  .hp { background: var(--h-paper); }

  /* ── Modell ── */
  .hp-model {
    display: grid;
    margin-top: clamp(40px, 5vw, 64px);
    padding: 4px 20px;
    border-radius: var(--h-r);
    background: var(--h-card);
    box-shadow: inset 0 0 0 1px var(--h-line), 0 1px 2px rgba(11, 21, 48, 0.04), 0 18px 44px -30px rgba(11, 21, 48, 0.3);
  }
  @media (min-width: 900px) {
    .hp-model { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; }
  }
  .hp-plan { padding: 24px 0; }
  .hp-plan + .hp-plan { border-top: 1px solid var(--h-line); }
  @media (min-width: 900px) {
    .hp-model { padding: 8px; }
    .hp-plan { padding: 28px 32px; }
    .hp-plan + .hp-plan { border-top: 0; border-left: 1px solid var(--h-line); }
  }
  .hp-plan--cta { display: flex; align-items: center; }
  .hp-plan-label { margin: 0; font-family: var(--h-sans); font-size: 13px; color: var(--h-muted); }
  .hp-plan-price {
    margin: 8px 0 6px;
    font-family: var(--h-display);
    font-stretch: 82%;
    font-weight: 720;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--h-ink);
  }
  .hp-plan-unit {
    font-family: var(--h-sans);
    font-stretch: 100%;
    font-size: 13px;
    font-weight: 400;
    color: var(--h-muted);
  }
  .hp-plan-sub { margin: 0; font-size: 15px; color: var(--h-muted); }
  .hp-plan-list {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.5;
    color: var(--h-text);
  }
  .hp-plan-list li { display: flex; align-items: center; gap: 8px; }
  .hp-plan-list li + li { margin-top: 4px; }
  .hp-plan-icon { flex-shrink: 0; color: var(--h-stbd-ink); }

  /* ── Tarifliste ── */
  .hp-group { margin-top: clamp(48px, 6vw, 72px); }
  .hp-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--h-line-2);
  }
  .hp-group-title {
    margin: 0;
    font-family: var(--h-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    line-height: 1.1;
    color: var(--h-ink);
  }
  .hp-group-note { margin: 0; font-family: var(--h-sans); font-size: 13px; color: var(--h-muted); }

  /* Die Liste ist Größen-Container: Die Zeile wird nach ihrer eigenen Breite
     fünfspaltig, nicht nach dem Viewport. Neben der Karte (ab 1024 px) ist sie
     erst ab etwa 1200 px Fensterbreite breit genug; darunter stapelt sie. */
  .hp-rows { margin: 0; padding: 0; list-style: none; container-type: inline-size; }
  /* Haarlinie am Listenelement, damit sie bündig mit der Gruppenlinie beginnt
     (der Link darunter ragt für die Hover-Fläche 12 px nach links hinaus). */
  .hp-rows > li { border-bottom: 1px solid var(--h-line-2); }

  /* ── Gruppe: Zeilen links, Paket-Karte rechts (Spec Runde 2, 5.2) ── */
  .hp-group-body { display: grid; gap: 24px; }
  @media (min-width: 1024px) {
    .hp-group-body {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 0 40px;
      align-items: start;
    }
  }
  .hp-bundle {
    padding: 24px;
    border-radius: var(--h-r);
    background: var(--h-card);
    box-shadow: inset 0 0 0 1px var(--h-line), 0 1px 2px rgba(11, 21, 48, 0.04), 0 18px 44px -30px rgba(11, 21, 48, 0.3);
  }
  @media (min-width: 640px) {
    .hp-bundle { padding: 28px; }
  }
  .hp-bundle .hp-badge { display: inline-block; }
  .hp-bundle-title {
    margin: 12px 0 0;
    font-family: var(--h-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.05;
    color: var(--h-ink);
  }
  .hp-bundle-sub { margin: 6px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--h-muted); }
  .hp-bundle-meta { margin: 14px 0 0; font-family: var(--h-sans); font-size: 13px; color: var(--h-muted); }
  .hp-bundle-meta strong { font-weight: 500; font-size: 15px; color: var(--h-ink); }
  .hp-bundle-price {
    margin: 16px 0 0;
    font-family: var(--h-display);
    font-stretch: 82%;
    font-weight: 720;
    font-size: 36px;
    line-height: 1;
    color: var(--h-ink);
  }
  .hp-bundle-save { margin: 6px 0 0; font-family: var(--h-sans); font-size: 13px; color: var(--h-blue-ink); }
  .hp-bundle-cta { margin-top: 20px; }
  .hp-bundle-note { margin: 12px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--h-muted); }
  .hp-price-note {
    max-width: 80ch;
    margin: 20px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--h-muted);
  }
  /* Zeile = Link. Negativer Außenabstand plus gleich großer Innenabstand,
     damit die Hover-Fläche über den Text hinausreicht, ohne das Raster zu
     verschieben. */
  .hp-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name chev'
      'q t'
      'price price';
    gap: 10px 16px;
    align-items: baseline;
    min-height: 72px;
    margin-inline: -12px;
    padding: 20px 12px;
    border-radius: var(--h-r-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .hp-row:hover { background: var(--h-blue-wash); }
  .hp-row:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; }
  .hp-name { grid-area: name; }
  .hp-cell--q { grid-area: q; }
  .hp-cell--t { grid-area: t; }
  .hp-price { grid-area: price; }
  .hp-chevron {
    grid-area: chev;
    justify-self: end;
    align-self: center;
    color: var(--h-blue-ink);
    transition: transform 0.3s var(--h-ease);
  }
  .hp-chevron svg { display: block; }
  .hp-row:hover .hp-chevron { transform: translateX(4px); }
  /* Fünf Spalten erst, wenn der Name mindestens ~215 px bekommt
     (720 − 506 px feste Spalten und Abstände). */
  @container (min-width: 720px) {
    .hp-row {
      grid-template-columns: minmax(0, 1fr) 110px 110px 170px 20px;
      grid-template-areas: 'name q t price chev';
      gap: 24px;
      padding: 22px 12px;
    }
  }

  .hp-name { display: flex; flex-direction: column; gap: 3px; }
  .hp-name-main {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--h-display);
    font-stretch: 84%;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    color: var(--h-ink);
  }
  .hp-badge {
    padding: 2px 9px;
    border: 1px solid var(--h-blue-ink);
    border-radius: var(--h-r-pill);
    font-family: var(--h-sans);
    font-stretch: 100%;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--h-blue-ink);
  }
  .hp-name-sub { font-size: 14.5px; color: var(--h-muted); }
  .hp-name-note { font-family: var(--h-sans); font-size: 12.5px; color: var(--h-text); }

  .hp-cell { font-family: var(--h-sans); font-size: 13px; color: var(--h-muted); }
  .hp-cell strong { font-weight: 500; color: var(--h-ink); font-size: 15px; }

  .hp-price { display: flex; flex-direction: column; gap: 2px; }
  .hp-price-num {
    font-family: var(--h-display);
    font-stretch: 82%;
    font-weight: 720;
    font-size: 24px;
    line-height: 1;
    color: var(--h-ink);
  }
  .hp-price-sub { font-family: var(--h-sans); font-size: 12.5px; color: var(--h-muted); }


  /* ── Schein-Finder ── */
  .hp-finder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(32px, 4vw, 48px);
    padding: 20px 0;
    border-block: 1px solid var(--h-line-2);
    color: inherit;
    text-decoration: none;
  }
  .hp-finder-text { display: flex; flex-direction: column; gap: 2px; }
  .hp-finder-text strong { font-size: 17px; color: var(--h-ink); }
  .hp-finder-text span { font-size: 15px; color: var(--h-muted); }
  .hp-finder-cta { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--h-blue-ink); transition: gap 0.3s var(--h-ease); }
  .hp-finder:hover .hp-finder-cta { gap: 10px; }
  .hp-finder:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .hp-row, .hp-chevron, .hp-finder-cta, .h-btn-arrow { transition: none; }
  }
</style>
