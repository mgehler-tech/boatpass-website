---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'de' | 'en';
  featured?: boolean;
}

const { post, lang, featured = false } = Astro.props;
const { title, description, date, readingTime, tags, author } = post.data;
const slug = post.id.replace(`${lang}/`, '');
const href = lang === 'de' ? `/blog/${slug}/` : `/en/blog/${slug}/`;
const formattedDate = date.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
});
const authorInitials = author
  .split(' ')
  .map(part => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const categoryIcons: Record<string, string> = {
  'Prüfungswissen':        '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  'Exam Knowledge':        '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  'Navigation':            '<path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />',
  'Vorbereitung':          '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />',
  'Preparation':           '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />',
  'Führerschein-Vergleich':'<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.97zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.97z" />',
  'License Comparison':    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.97zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.97z" />',
};
const category = tags[0] ?? '';
const defaultIcon = categoryIcons['Prüfungswissen']!;
const iconPaths = category ? (categoryIcons[category] ?? defaultIcon) : defaultIcon;
---

{featured ? (
  <a href={href} class="blog-featured group" data-tags={tags.join(',')}>
    <div class="blog-featured-bar"></div>
    <div class="blog-featured-body">
      <div class="blog-tags">
        {tags.slice(0, 2).map(tag => (
          <span class="blog-tag">{tag}</span>
        ))}
      </div>
      <h3 class="blog-featured-title group-hover:text-primary transition-colors">{title}</h3>
      <p class="blog-featured-desc">{description}</p>
      <div class="blog-featured-footer">
        <div class="blog-author">
          <span class="blog-avatar" aria-hidden="true">{authorInitials}</span>
          <span class="blog-author-meta">
            <span class="blog-author-name">{author}</span>
            <span class="blog-author-sub">{formattedDate} · {readingTime} {lang === 'de' ? 'Min lesen' : 'min read'}</span>
          </span>
        </div>
        <span class="blog-cta">{lang === 'de' ? 'Weiterlesen' : 'Read more'} →</span>
      </div>
    </div>
  </a>
) : (
  <a href={href} class="blog-compact group" data-tags={tags.join(',')}>
    <div class="blog-compact-head">
      <div class="blog-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none"
             stroke="white" stroke-width="1.75"
             stroke-linecap="round" stroke-linejoin="round"
             set:html={iconPaths} />
      </div>
      {category && <span class="blog-tag">{category}</span>}
    </div>
    <div class="blog-compact-body">
      <h3 class="blog-compact-title group-hover:text-primary transition-colors">{title}</h3>
      <p class="blog-compact-desc">{description}</p>
    </div>
    <div class="blog-compact-footer">
      <div class="blog-author">
        <span class="blog-avatar" aria-hidden="true">{authorInitials}</span>
        <span class="blog-author-meta">
          <span class="blog-author-name">{author}</span>
          <span class="blog-author-sub">{formattedDate} · {readingTime} {lang === 'de' ? 'Min' : 'min'}</span>
        </span>
      </div>
    </div>
  </a>
)}

<style>
  /* Featured */
  .blog-featured {
    display: block;
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .blog-featured:hover {
    box-shadow: 0 12px 40px rgba(26,31,54,0.08);
    border-color: rgba(51,102,255,0.18);
  }
  .blog-featured-bar {
    height: 3px;
    background: linear-gradient(90deg, #1A1F36, #3366FF);
  }
  .blog-featured-body {
    padding: 28px 28px 24px;
  }
  .blog-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
  }
  .blog-tag {
    font-size: 11px;
    font-weight: 700;
    background: rgba(51,102,255,0.08);
    color: #3366FF;
    border: 1px solid rgba(51,102,255,0.15);
    padding: 2px 9px;
    border-radius: 100px;
  }
  .blog-featured-title {
    font-size: 20px;
    font-weight: 900;
    color: #1A1F36;
    letter-spacing: -0.3px;
    line-height: 1.25;
    margin-bottom: 10px;
  }
  .blog-featured-desc {
    font-size: 14px;
    color: #6B7280;
    line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .blog-cta { font-size: 13px; font-weight: 700; color: #3366FF; white-space: nowrap; }

  /* Shared author block */
  .blog-author {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .blog-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1A1F36, #3366FF);
    color: white;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .blog-author-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .blog-author-name {
    font-size: 12.5px;
    font-weight: 700;
    color: #1A1F36;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .blog-author-sub { font-size: 11.5px; color: #9CA3AF; }

  /* Compact card */
  .blog-compact {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid rgba(51,102,255,0.08);
    border-radius: 16px;
    padding: 22px;
    text-decoration: none;
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    height: 100%;
  }
  .blog-compact:hover {
    box-shadow: 0 10px 30px rgba(26,31,54,0.08);
    border-color: rgba(51,102,255,0.16);
    transform: translateY(-2px);
  }
  .blog-compact-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .blog-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #3366FF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .blog-compact-body { flex: 1; min-width: 0; margin-bottom: 18px; }
  .blog-compact-title {
    font-size: 16px;
    font-weight: 800;
    color: #1A1F36;
    line-height: 1.3;
    letter-spacing: -0.2px;
    margin-bottom: 8px;
  }
  .blog-compact-desc {
    font-size: 13px;
    color: #6B7280;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-compact-footer {
    padding-top: 16px;
    border-top: 1px solid rgba(26,31,54,0.06);
  }
</style>
