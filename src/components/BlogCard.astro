---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'de' | 'en';
}

const { post, lang } = Astro.props;
const { title, description, date, readingTime, tags, author } = post.data;
const slug = post.id.replace(`${lang}/`, '');
const href = lang === 'de' ? `/blog/${slug}/` : `/en/blog/${slug}/`;
const formattedDate = date.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
});
const authorPhoto = '/marius.webp';

const categoryIcons: Record<string, string> = {
  'Prüfungswissen':        '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  'Exam Knowledge':        '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  'Navigation':            '<path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />',
  'Vorbereitung':          '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />',
  'Preparation':           '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25" />',
  'Führerschein-Vergleich':'<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.97zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.97z" />',
  'License Comparison':    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.97zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.97z" />',
  'Sicherheit':            '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.572-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.285Z" />',
  'Praxis':                '<path stroke-linecap="round" stroke-linejoin="round" d="M16.712 4.33a9.027 9.027 0 0 1 1.652 1.306c.51.51.944 1.064 1.306 1.652M16.712 4.33l-3.448 4.138m3.448-4.138a9.014 9.014 0 0 0-9.424 0M19.67 7.288l-4.138 3.448m4.138-3.448a9.014 9.014 0 0 1 0 9.424m-4.138-5.976a3.736 3.736 0 0 0-.88-1.388 3.737 3.737 0 0 0-1.388-.88m2.268 2.268a3.765 3.765 0 0 1 0 2.528m-2.268-4.796a3.765 3.765 0 0 0-2.528 0m4.796 4.796c-.181.506-.475.982-.88 1.388a3.736 3.736 0 0 1-1.388.88m2.268-2.268 4.138 3.448m0 0a9.027 9.027 0 0 1-1.306 1.652c-.51.51-1.064.944-1.652 1.306m0 0-3.448-4.138m3.448 4.138a9.014 9.014 0 0 1-9.424 0m5.976-4.138a3.765 3.765 0 0 1-2.528 0m0 0a3.736 3.736 0 0 1-1.388-.88 3.737 3.737 0 0 1-.88-1.388m2.268 2.268L7.288 19.67m0 0a9.024 9.024 0 0 1-1.652-1.306 9.027 9.027 0 0 1-1.306-1.652m0 0 4.138-3.448M4.33 7.288l4.138 3.448M4.33 7.288a9.014 9.014 0 0 0 0 9.424" />',
};
// Kategorie-Akzentfarben – sorgen für schnelle Scanbarkeit über alle Karten
const categoryColors: Record<string, string> = {
  'Prüfungswissen': '#3366FF', 'Exam Knowledge': '#3366FF',
  'Vorbereitung': '#00A878', 'Preparation': '#00A878',
  'Führerschein-Vergleich': '#7C3AED', 'License Comparison': '#7C3AED',
  'Navigation': '#0EA5E9',
  'Sicherheit': '#F97316', 'Safety': '#F97316',
  'Praxis': '#E11D48', 'Practice': '#E11D48',
};
// Schriftfarbe der Kategorie-Chips. Die Akzentfarbe oben taugt als Fläche
// (Icon-Kachel, Farbbalken), nicht als Schrift auf ihrer eigenen 8%-Tönung:
// #0EA5E9 kam dort auf 2,56:1, #F97316 auf 2,58:1, #00A878 auf 2,80:1 – WCAG 2.2
// AA verlangt für die 12px-Chipschrift 4,5:1 (SC 1.4.3). Diese Werte halten den
// Farbton der Kategorie und erreichen ≥5:1, hell auf der weißen Karte, dunkel
// auf der Karte #181E2E.
const categoryInk: Record<string, { light: string; dark: string }> = {
  'Prüfungswissen': { light: '#1C55FF', dark: '#678DFF' }, 'Exam Knowledge': { light: '#1C55FF', dark: '#678DFF' },
  'Vorbereitung': { light: '#007856', dark: '#00AA79' }, 'Preparation': { light: '#007856', dark: '#00AA79' },
  'Führerschein-Vergleich': { light: '#7C3AED', dark: '#A67AF3' }, 'License Comparison': { light: '#7C3AED', dark: '#A67AF3' },
  'Navigation': { light: '#0A719F', dark: '#0EA5E9' },
  'Sicherheit': { light: '#B14B05', dark: '#F97316' }, 'Safety': { light: '#B14B05', dark: '#F97316' },
  'Praxis': { light: '#C91A40', dark: '#EB6280' }, 'Practice': { light: '#C91A40', dark: '#EB6280' },
};
const category = tags[0] ?? '';
const defaultIcon = categoryIcons['Prüfungswissen']!;
const iconPaths = category ? (categoryIcons[category] ?? defaultIcon) : defaultIcon;
const accent = categoryColors[category] ?? '#3366FF';
const ink = categoryInk[category] ?? categoryInk['Prüfungswissen']!;
const tagStyle = `--tag-ink:${ink.light}; --tag-ink-dark:${ink.dark}; background:${accent}14; border-color:${accent}26`;
// "Neu"-Badge für Artikel der letzten 21 Tage
const isNew = (Date.now() - date.getTime()) < 21 * 24 * 60 * 60 * 1000;
const searchText = `${title} ${description}`.toLowerCase();
---

<a href={href} class="blog-compact group" aria-label={title} data-tags={tags.join(',')} data-search={searchText}>
  <div class="blog-compact-head">
    <div class="blog-icon" style={`background:${accent}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
           viewBox="0 0 24 24" fill="none"
           stroke="white" stroke-width="1.75"
           stroke-linecap="round" stroke-linejoin="round"
           aria-hidden="true"
           set:html={iconPaths} />
    </div>
    {category && <span class="blog-tag" style={tagStyle}>{category}</span>}
    {isNew && <span class="blog-tag-new">{lang === 'de' ? 'Neu' : 'New'}</span>}
  </div>
  <div class="blog-compact-body">
    <h3 class="blog-compact-title group-hover:text-primary transition-colors">{title}</h3>
    <p class="blog-compact-desc">{description}</p>
  </div>
  <div class="blog-compact-footer">
    <div class="blog-author">
      <img class="blog-avatar" src={authorPhoto} alt={author} width="32" height="32" loading="lazy" decoding="async" />
      <span class="blog-author-meta">
        <span class="blog-author-name">{author}</span>
        <span class="blog-author-sub">{formattedDate} · {readingTime} {lang === 'de' ? 'Min' : 'min'}</span>
      </span>
    </div>
  </div>
</a>

<style>
  .blog-tag {
    font-size: 12px;
    font-weight: 700;
    background: rgba(51,102,255,0.08);
    color: var(--tag-ink, #1C55FF);
    border: 1px solid rgba(51,102,255,0.15);
    padding: 2px 9px;
    border-radius: 100px;
  }
  .blog-tag-new {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    background: #1A1F36;
    color: white;
    padding: 2px 9px;
    border-radius: 100px;
  }
  /* Shared author block */
  .blog-author {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .blog-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .blog-author-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .blog-author-name {
    font-size: 13px;
    font-weight: 700;
    color: #1A1F36;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .blog-author-sub { font-size: 12px; color: #656B78; }

  /* Compact card */
  .blog-compact {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid rgba(51,102,255,0.08);
    border-radius: 16px;
    padding: 22px;
    text-decoration: none;
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    height: 100%;
  }
  .blog-compact:hover {
    box-shadow: 0 10px 30px rgba(26,31,54,0.08);
    border-color: rgba(51,102,255,0.16);
    transform: translateY(-2px);
  }
  .blog-compact-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .blog-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #3366FF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .blog-compact-body { flex: 1; min-width: 0; margin-bottom: 18px; }
  .blog-compact-title {
    font-size: 16px;
    font-weight: 800;
    color: #1A1F36;
    line-height: 1.3;
    letter-spacing: -0.2px;
    margin-bottom: 8px;
  }
  .blog-compact-desc {
    font-size: 14px;
    color: #656B78;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-compact-footer {
    padding-top: 16px;
    border-top: 1px solid rgba(26,31,54,0.06);
  }

  html.dark .blog-compact {
    background: #181E2E !important;
    border-color: rgba(90, 120, 255, 0.10) !important;
  }
  html.dark .blog-compact:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4) !important;
    border-color: rgba(90, 120, 255, 0.20) !important;
  }
  html.dark .blog-compact-title,
  html.dark .blog-author-name  { color: #E2E8F0 !important; }
  html.dark .blog-compact-desc,
  html.dark .blog-author-sub   { color: #94A3B8 !important; }
  html.dark .blog-compact-footer { border-color: rgba(90, 120, 255, 0.10) !important; }
  html.dark .blog-tag { color: var(--tag-ink-dark, #678DFF) !important; }
  html.dark .blog-tag-new { background: #2952CC !important; }
</style>
