---
import { icons, type IconName } from '../icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: string;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, stroke = 'currentColor', strokeWidth = 1.75, class: className } = Astro.props;
const paths = icons[name] ?? icons.anchor;
---

<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size}
     viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width={strokeWidth}
     stroke-linecap="round" stroke-linejoin="round" class={className} set:html={paths} />
