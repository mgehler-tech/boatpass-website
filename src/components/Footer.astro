---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import appIcon from '../assets/images/app-icon.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<footer style="background:#E8EDF6; border-top:1px solid rgba(51,102,255,0.10);" class="mt-24">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <span class="text-lg font-black" style="color:#1A1F36; display:inline-flex; align-items:center; gap:8px;"><Image src={appIcon} alt="Boatpass Logo" width={52} height={52} loading="lazy" style="width:26px;height:26px;border-radius:6px;" /> Boat<span style="color:#3366FF;">Pass</span></span>
        <p class="text-gray-500 text-sm mt-2">
          {lang === 'de'
            ? 'Die App für den Sportbootführerschein.'
            : 'The app for your boating license.'}
        </p>
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-3">
          <img src={lang === 'de' ? '/images/google-play-badge-1_de_.png' : '/images/google-play-badge-2_en_.png'} alt={lang === 'de' ? 'Boatpass im Google Play Store herunterladen' : 'Download Boatpass on Google Play'} width="104" height="40" loading="lazy" class="h-10 w-auto" />
        </a>
      </div>

      <!-- Lizenzen / Licenses -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Lizenzen' : 'Licenses'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'de' ? '/sbf-binnen/' : '/en/sbf-inland/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'SBF Binnen' : 'SBF Inland'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-see/' : '/en/sbf-coastal/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'SBF See' : 'SBF Coastal'}</a></li>
          <li><a href={lang === 'de' ? '/ubi/' : '/en/ubi/'} class="text-gray-500 hover:text-text transition-colors">UBI</a></li>
          <li><a href={lang === 'de' ? '/src/' : '/en/src/'} class="text-gray-500 hover:text-text transition-colors">SRC</a></li>
          <li><a href={lang === 'de' ? '/lrc/' : '/en/lrc/'} class="text-gray-500 hover:text-text transition-colors">LRC</a></li>
        </ul>
      </div>

      <!-- Ratgeber / Guides -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Ratgeber' : 'Guides'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'de' ? '/sbf-kosten/' : '/en/sbf-costs/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'SBF Kosten' : 'SBF Costs'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'Prüfung & Ablauf' : 'Exam & Process'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-binnen-pruefungsfragen/' : '/en/sbf-inland-exam-questions/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'Prüfungsfragen Binnen' : 'Inland Exam Questions'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-see-pruefungsfragen/' : '/en/sbf-coastal-exam-questions/'} class="text-gray-500 hover:text-text transition-colors">{lang === 'de' ? 'Prüfungsfragen See' : 'Coastal Exam Questions'}</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Seiten' : 'Pages'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={getLocalizedPath(lang, '/blog/')} class="text-gray-500 hover:text-text transition-colors">{t.nav.blog}</a></li>
          <li><a href={getLocalizedPath(lang, '/faq/')} class="text-gray-500 hover:text-text transition-colors">{t.nav.faq}</a></li>
          <li><a href={lang === 'de' ? '/ueber-uns/' : '/en/about/'} class="text-gray-500 hover:text-text transition-colors">{t.nav.about}</a></li>
          <li><a href={lang === 'de' ? '/kontakt/' : '/en/contact/'} class="text-gray-500 hover:text-text transition-colors">{t.nav.contact}</a></li>
        </ul>
      </div>

      <!-- Rechtliches -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Rechtliches' : 'Legal'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'de' ? '/datenschutz/' : '/en/privacy/'} class="text-gray-500 hover:text-text transition-colors">{t.footer.privacy}</a></li>
          <li><a href={lang === 'de' ? '/impressum/' : '/en/legal/'} class="text-gray-500 hover:text-text transition-colors">{t.footer.imprint}</a></li>
        </ul>
        <div class="mt-4">
          <a href={lang === 'de' ? '/en/' : '/'} class="footer-link text-sm text-primary hover:underline">{t.footer.switchLang}</a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-6 text-center text-gray-400 text-xs">
      © {year} Boatpass. {lang === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.'}
    </div>
  </div>
</footer>

<style>
  /* Touch-Flächen der Footer-Navigation auf dem Handy vergrößern
     (WCAG 2.5.5 – mind. 44px). Die Links waren zuvor nur ~20px hohe Textzeilen
     und dadurch – gerade wenn alle Spalten zu einer langen Einzelspalte stapeln –
     schwer präzise zu treffen. display:flex macht die ganze Spaltenbreite tappbar
     (langer Linktext bricht dabei sauber um), min-height sichert die 44px.
     Greift nur unterhalb von 640px – das Desktop-Layout bleibt unverändert.
     Reiner Layout-Feinschliff: Farben, Schrift und Branding bleiben unberührt. */
  @media (max-width: 640px) {
    footer ul a,
    footer .footer-link {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
