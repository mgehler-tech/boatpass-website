---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import appIcon from '../assets/images/app-icon.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<footer style="background:#E8EDF6; border-top:1px solid rgba(51,102,255,0.10);" class="mt-24">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class={`grid grid-cols-1 sm:grid-cols-2 ${lang === 'de' ? 'lg:grid-cols-5' : 'md:grid-cols-3'} gap-8 mb-8`}>
      <!-- Brand -->
      <div>
        <span class="text-lg font-black" style="color:#1A1F36; display:inline-flex; align-items:center; gap:8px;"><Image src={appIcon} alt="Boatpass Logo" width={52} height={52} loading="lazy" style="width:26px;height:26px;border-radius:6px;" /> Boat<span style="color:#3366FF;">Pass</span></span>
        <p class="text-gray-500 text-sm mt-2">
          {lang === 'de'
            ? 'Die App für den Sportbootführerschein.'
            : 'The app for your boating license.'}
        </p>
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-3">
          <img src={lang === 'de' ? '/images/google-play-badge-1_de_.png' : '/images/google-play-badge-2_en_.png'} alt={lang === 'de' ? 'Boatpass im Google Play Store herunterladen' : 'Download Boatpass on Google Play'} width="104" height="40" loading="lazy" class="h-10 w-auto" />
        </a>
      </div>

      <!-- Lizenzen (nur DE) -->
      {lang === 'de' && (
        <div>
          <h3 class="font-semibold text-text mb-3 text-sm">Lizenzen</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/sbf-binnen/" class="text-gray-500 hover:text-text transition-colors">SBF Binnen</a></li>
            <li><a href="/sbf-see/" class="text-gray-500 hover:text-text transition-colors">SBF See</a></li>
            <li><a href="/ubi/" class="text-gray-500 hover:text-text transition-colors">UBI</a></li>
            <li><a href="/src/" class="text-gray-500 hover:text-text transition-colors">SRC</a></li>
            <li><a href="/lrc/" class="text-gray-500 hover:text-text transition-colors">LRC</a></li>
          </ul>
        </div>
      )}

      <!-- Ratgeber (nur DE) -->
      {lang === 'de' && (
        <div>
          <h3 class="font-semibold text-text mb-3 text-sm">Ratgeber</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/sbf-kosten/" class="text-gray-500 hover:text-text transition-colors">SBF Kosten</a></li>
            <li><a href="/sbf-pruefung-ablauf/" class="text-gray-500 hover:text-text transition-colors">Prüfung &amp; Ablauf</a></li>
            <li><a href="/sbf-binnen-pruefungsfragen/" class="text-gray-500 hover:text-text transition-colors">Prüfungsfragen Binnen</a></li>
            <li><a href="/sbf-see-pruefungsfragen/" class="text-gray-500 hover:text-text transition-colors">Prüfungsfragen See</a></li>
          </ul>
        </div>
      )}

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Seiten' : 'Pages'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={getLocalizedPath(lang, '/blog/')} class="text-gray-500 hover:text-text transition-colors">{t.nav.blog}</a></li>
          <li><a href={getLocalizedPath(lang, '/faq/')} class="text-gray-500 hover:text-text transition-colors">{t.nav.faq}</a></li>
          <li><a href={lang === 'de' ? '/ueber-uns/' : '/en/about/'} class="text-gray-500 hover:text-text transition-colors">{t.nav.about}</a></li>
          <li><a href={lang === 'de' ? '/kontakt/' : '/en/contact/'} class="text-gray-500 hover:text-text transition-colors">{t.nav.contact}</a></li>
        </ul>
      </div>

      <!-- Rechtliches -->
      <div>
        <h3 class="font-semibold text-text mb-3 text-sm">{lang === 'de' ? 'Rechtliches' : 'Legal'}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lang === 'de' ? '/datenschutz/' : '/en/privacy/'} class="text-gray-500 hover:text-text transition-colors">{t.footer.privacy}</a></li>
          <li><a href={lang === 'de' ? '/impressum/' : '/en/legal/'} class="text-gray-500 hover:text-text transition-colors">{t.footer.imprint}</a></li>
        </ul>
        <div class="mt-4">
          <a href={lang === 'de' ? '/en/' : '/'} class="text-sm text-primary hover:underline">{t.footer.switchLang}</a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-6 text-center text-gray-400 text-xs">
      © {year} Boatpass. {lang === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.'}
    </div>
  </div>
</footer>
