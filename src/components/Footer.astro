---
// Fußzeile aller Seiten (Spec docs/superpowers/specs/2026-10-17-premium-polish-design.md, 4.4):
// Store-Badges mit Bewertung je Store (nur ab MIN_STORE_RATINGS), drei
// Link-Spalten als reiner Text, darunter die rechtliche Zeile. Der Hell/Dunkel-
// Umschalter sitzt im Header (ThemeToggle), nicht hier.
// Keine Icons, keine Chevrons, keine Haarlinien zwischen den Zeilen.
import StoreBadges from './StoreBadges.astro';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import { getBoatpassStoreRatingsForDisplay } from '../data/apps';
import { PLAY_STORE_URL, appStoreUrl } from '../data/stores';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';
const year = new Date().getFullYear();
const playStoreUrl = PLAY_STORE_URL;
const numberLocale = de ? 'de-DE' : 'en-GB';

// Bewertungen je Store getrennt – die Stores weisen sie nicht gemeinsam aus.
const storeRatings = getBoatpassStoreRatingsForDisplay().map(({ store, rating }) => {
  const n = rating.ratings;
  const noun = de ? (n === 1 ? 'Bewertung' : 'Bewertungen') : (n === 1 ? 'review' : 'reviews');
  const name = store === 'ios' ? 'App Store' : 'Google Play';
  return {
    store,
    href: store === 'ios' ? appStoreUrl(lang) : playStoreUrl,
    // Zwei feste Nachkommastellen, damit mehrere Blöcke gleich aussehen (4,96 · 5,00).
    score: rating.score.toFixed(2).replace('.', de ? ',' : '.'),
    count: `${n.toLocaleString(numberLocale)} ${noun} · ${name}`,
  };
});

interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
  /** Expliziter Store-Link – die Geräteweiche im BaseLayout lässt ihn unverändert. */
  store?: 'ios' | 'play';
}

const licenseLinks: FooterLink[] = [
  { href: de ? '/sbf-binnen/' : '/en/sbf-inland/', label: de ? 'SBF Binnen' : 'SBF Inland' },
  { href: de ? '/sbf-see/' : '/en/sbf-coastal/', label: de ? 'SBF See' : 'SBF Coastal' },
  { href: de ? '/ubi/' : '/en/ubi/', label: 'UBI' },
  { href: de ? '/src/' : '/en/src/', label: 'SRC' },
  { href: de ? '/lrc/' : '/en/lrc/', label: 'LRC' },
];

const guideLinks: FooterLink[] = [
  { href: de ? '/sbf-kosten/' : '/en/sbf-costs/', label: de ? 'SBF Kosten' : 'SBF Costs' },
  { href: de ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/', label: de ? 'Prüfung & Ablauf' : 'Exam & Process' },
  { href: de ? '/sbf-binnen-pruefungsfragen/' : '/en/sbf-inland-exam-questions/', label: de ? 'Prüfungsfragen Binnen' : 'Inland Exam Questions' },
  { href: de ? '/sbf-see-pruefungsfragen/' : '/en/sbf-coastal-exam-questions/', label: de ? 'Prüfungsfragen See' : 'Coastal Exam Questions' },
  { href: de ? '/sbf-see-navigationsaufgaben/' : '/en/sbf-coastal-navigation-tasks/', label: de ? 'Navigationsaufgaben See' : 'Coastal Navigation Tasks' },
  { href: de ? '/sbf-app/' : '/en/sbf-app/', label: de ? 'SBF-Apps im Vergleich' : 'Apps Compared' },
  { href: de ? '/sbf-app-kostenlos/' : '/en/sbf-app-free/', label: de ? 'Kostenlose SBF-Apps' : 'Free SBF Apps' },
];

const aboutLinks: FooterLink[] = [
  { href: getLocalizedPath(lang, '/blog/'), label: t.nav.blog },
  { href: getLocalizedPath(lang, '/faq/'), label: t.nav.faq },
  { href: de ? '/ueber-uns/' : '/en/about/', label: t.nav.about },
  { href: de ? '/kontakt/' : '/en/contact/', label: t.nav.contact },
  { href: appStoreUrl(lang), label: 'App Store (iPhone & iPad)', external: true, store: 'ios' },
  { href: playStoreUrl, label: 'Google Play (Android)', external: true, store: 'play' },
];

const legalLinks: FooterLink[] = [
  { href: de ? '/datenschutz/' : '/en/privacy/', label: t.footer.privacy },
  { href: de ? '/impressum/' : '/en/legal/', label: t.footer.imprint },
  { href: de ? '/nutzungsbedingungen/' : '/en/terms/', label: t.footer.terms },
];

const columns: { heading: string; links: FooterLink[]; guides?: boolean }[] = [
  { heading: de ? 'Lizenzen' : 'Licenses', links: licenseLinks },
  // Ratgeber ist auf dem Handy über Menü und Startseite erreichbar; dort
  // bleibt die Spalte ausgeblendet, damit der Footer nicht zur Linkwand wird.
  { heading: de ? 'Ratgeber' : 'Guides', links: guideLinks, guides: true },
  { heading: 'BoatPass', links: aboutLinks },
];
---

<footer class="site-footer">
  <div class="h-container">

    <!-- Store-Badges + Bewertung je Store -->
    <div class="footer-store">
      <StoreBadges lang={lang} height={40} position="footer" id="footer-badge" />
      {storeRatings.map((r) => (
        <a href={r.href} data-store={r.store} target="_blank" rel="noopener noreferrer" class="footer-rating" aria-label={`${r.score} ${de ? 'von 5' : 'out of 5'} · ${r.count}`}>
          <span class="footer-rating-top">
            <span class="footer-rating-stars" aria-hidden="true">★★★★★</span>
            <span class="footer-rating-score">{r.score}</span>
            <span class="footer-rating-outof">{de ? 'von 5' : 'out of 5'}</span>
          </span>
          <span class="footer-rating-count">{r.count}</span>
        </a>
      ))}
    </div>

    <!-- Link-Spalten -->
    <div class="footer-cols">
      {columns.map((col) => (
        <div class:list={['footer-col', col.guides && 'footer-col--guides']}>
          <h3 class="footer-col-title">{col.heading}</h3>
          <ul class="footer-links">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-store={link.store}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Rechtliches + Darstellung -->
    <div class="footer-legal">
      <p class="footer-copyright">© {year} Boatpass</p>
      {legalLinks.map((link) => (
        <a href={link.href} class="footer-legal-link">{link.label}</a>
      ))}
    </div>
    <p class="footer-made">{t.footer.madeIn}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 6vw, 96px);
    padding: clamp(40px, 5vw, 64px) 0 32px;
    background: var(--h-paper-2);
    border-top: 1px solid var(--h-line);
    color: var(--h-text);
    font-family: var(--h-sans);
  }
  :global(html.dark) .site-footer { background: #0D1018; }

  /* ── Badges + Bewertung ── */
  .footer-store {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-bottom: 40px;
  }
  .footer-rating {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: fit-content;
    text-decoration: none;
    border-radius: var(--h-r-sm);
  }
  .footer-rating-top { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .footer-rating-stars { font-size: 14px; line-height: 1; letter-spacing: 1px; color: var(--h-beacon); }
  .footer-rating-score { font: 600 14px/1 var(--h-sans); color: var(--h-ink); }
  .footer-rating-outof { font-size: 12px; color: var(--h-muted); }
  .footer-rating-count { font-size: 13px; color: var(--h-muted); }
  .footer-rating:hover .footer-rating-score { color: var(--h-blue-ink); }

  /* ── Spalten ── */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 20px;
    margin-bottom: 40px;
  }
  @media (min-width: 640px) {
    .footer-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
  @media (max-width: 639px) {
    .footer-col--guides { display: none; }
  }
  .footer-col-title { margin: 0 0 6px; font: 600 14px/1.4 var(--h-sans); color: var(--h-ink); }
  .footer-links { margin: 0; padding: 0; list-style: none; }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 10px;
    font: 400 15px/1.4 var(--h-sans);
    color: var(--h-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-links a:hover { color: var(--h-ink); text-decoration: underline; text-underline-offset: 4px; }

  /* ── Rechtliches ── */
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    padding-top: 12px;
    border-top: 1px solid var(--h-line);
  }
  .footer-copyright { margin: 0; font-size: 13px; color: var(--h-muted); }
  .footer-legal-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    color: var(--h-muted);
    text-decoration: none;
  }
  .footer-legal-link:hover { color: var(--h-ink); text-decoration: underline; text-underline-offset: 4px; }
  .footer-made { margin: 4px 0 0; font-size: 13px; color: var(--h-muted); }

  .site-footer a:focus-visible { outline: 3px solid var(--h-blue); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .footer-links a { transition: none; }
  }
</style>
