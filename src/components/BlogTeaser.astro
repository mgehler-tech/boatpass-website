---
// Die drei neuesten Ratgeber-Artikel als Inhaltsverzeichnis: Kategorie,
// Titel, Kurzbeschreibung, Datum – mit Haarlinien statt Karten und ohne
// Icon-Kacheln. Die Blog-Übersicht nutzt weiterhin BlogCard.
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', entry => entry.data.lang === lang);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map(post => {
    const slug = post.id.replace(`${lang}/`, '');
    return {
      href: lang === 'de' ? `/blog/${slug}/` : `/en/blog/${slug}/`,
      title: post.data.title,
      description: post.data.description,
      category: post.data.tags[0] ?? '',
      date: post.data.date,
      readingTime: post.data.readingTime,
    };
  });
const fmt = (d: Date) => d.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<section class="bt">
  <div class="bt-inner">
    <header class="bt-head">
      <h2 class="display bt-title">{t.blog.title}</h2>
      <a href={getLocalizedPath(lang, '/blog/')} class="bt-all">{t.blog.allArticles} <span aria-hidden="true">→</span></a>
    </header>
    <ol class="bt-list">
      {posts.map(post => (
        <li class="bt-item">
          <a href={post.href} class="bt-link">
            {post.category && <span class="bt-cat">{post.category}</span>}
            <h3 class="bt-item-title">{post.title}</h3>
            <p class="bt-desc">{post.description}</p>
            <span class="bt-meta">
              <time datetime={post.date.toISOString()}>{fmt(post.date)}</time> · {post.readingTime} {lang === 'de' ? 'Min.' : 'min'}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bt { color: var(--ink); border-top: 1px solid var(--ink); }
  .bt-inner { max-width: 1200px; margin-inline: auto; padding: 64px 24px 56px; }
  .bt-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 28px;
  }
  .bt-title { font-size: clamp(2.3rem, 1.6rem + 2.8vw, 3.8rem); }
  .bt-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--link);
    font-size: 15px;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .bt-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .bt-item { border-top: 2px solid var(--ink); }
  .bt-link { display: block; padding: 16px 0 26px; color: inherit; text-decoration: none; }
  .bt-cat {
    display: block;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  .bt-item-title {
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem);
    font-weight: 720;
    font-stretch: 86%;
    line-height: 1.15;
    margin-bottom: 10px;
    text-wrap: pretty;
  }
  .bt-link:hover .bt-item-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .bt-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bt-meta { font-size: 13px; color: var(--ink-2); }

  @media (min-width: 800px) {
    .bt-inner { padding: 96px 40px 88px; }
    .bt-list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 40px; }
  }
</style>
