---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { useTranslations, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', entry => entry.data.lang === lang);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section class="section-band max-w-6xl mx-auto px-6 py-14 md:py-20">
  <div class="blog-teaser-header">
    <div class="blog-teaser-heading">
      <span class="section-eyebrow blog-teaser-eyebrow">{t.blog.eyebrow}</span>
      <h2 class="section-display-title">{t.blog.title}</h2>
    </div>
    <a href={getLocalizedPath(lang, '/blog/')} class="blog-teaser-all">
      {t.blog.allArticles} →
    </a>
  </div>

  <div class="blog-teaser-grid">
    {posts.map(post => <BlogCard post={post} lang={lang} />)}
  </div>
</section>

<style>
  /* Kopfzeile der Blog-Sektion: lange Überschrift (z. B. "Tipps & Wissenswertes")
     und der "Alle Artikel"-Link teilten sich zuvor eine starre Flex-Zeile ohne
     Umbruch. Auf schmalen Screens quetschte das den Link in eine schmale Spalte
     und riss die große Überschrift mitten im Wort um; items-center ließ den
     kleinen Link zudem an einer mehrzeiligen Überschrift „schweben".
     Jetzt: der Link bricht bei Platzmangel sauber unter die Überschrift, sitzt
     sonst auf deren Grundlinie (baseline) und behält eine ausreichend große
     Touch-Fläche (WCAG 2.5.5 – mind. 44px). Reiner Layout-Feinschliff. */
  .blog-teaser-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 40px;
  }
  .blog-teaser-eyebrow {
    margin-bottom: 14px;
  }
  .blog-teaser-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .blog-teaser-all:hover { text-decoration: underline; }

  /* Drei gleichwertige Artikel-Karten in einer Reihe – dasselbe Raster, das die
     Blog-Übersicht (.cluster-grid in pages/blog/index.astro) für dieselben Karten
     bereits verwendet.

     Vorher stand hier eine große Featured-Karte links neben zwei gestapelten
     Kompakt-Karten. Weil die rechte Spalte (zwei Karten + Lücke) rund 504px hoch
     ist, die Featured-Karte mit ihrem Inhalt aber nur etwa 250px braucht, klaffte
     zwischen Beschreibung und Fußzeile ein leeres Feld von ~250px. Füllen ließ es
     sich nicht: Die Artikel haben kein Titelbild (nur 10 von 69 setzen `image`),
     und die Featured-Karte war mit 544px ohnehin exakt so breit wie eine
     Kompakt-Karte – also nicht größer, nur leerer.

     Eine Sonderrolle gibt der Inhalt auch nicht her: Die drei Karten zeigen die
     drei neuesten Artikel, durchweg vom selben Autor, aus derselben Woche und alle
     mit „Neu"-Badge. Als gleichwertige Reihe fluchten sie oben wie unten, der
     Abschnitt folgt demselben Kartenraster wie Features und Preise, und die
     farbigen Kategorie-Icons erscheinen jetzt auf allen drei Karten – auf der
     Featured-Karte fehlten sie ganz. Breakpoints wie in der Blog-Übersicht. */
  .blog-teaser-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .blog-teaser-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .blog-teaser-grid { grid-template-columns: 1fr; }
  }
</style>
