---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { useTranslations, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', entry => entry.data.lang === lang);
const sortedByDate = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Kuratierte, thematisch zentrale Artikel, die sonst kaum eingehende Links bekommen
// (siehe Interne-Linking-Audit): ohne Kuration würde die Startseite immer nur die
// 3 neuesten Posts bewerben und die Cluster-Kollegen bleiben Sackgassen-Seiten.
const curatedSlugsBySlang: Record<'de' | 'en', string[]> = {
  de: ['wichtigste-knoten-sbf', 'schallsignale-sbf-erklaert'],
  en: ['most-important-knots-sbf', 'sound-signals-sbf-explained'],
};
const curated = curatedSlugsBySlang[lang]
  .map(slug => sortedByDate.find(p => p.id === `${lang}/${slug}`))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const featured = sortedByDate[0];
const rest = [...curated, ...sortedByDate.slice(1)]
  .filter((p, i, arr) => arr.findIndex(o => o.id === p.id) === i)
  .filter(p => p.id !== featured?.id)
  .slice(0, 2);
---

<section class="max-w-6xl mx-auto px-6 py-12 md:py-20">
  <div class="flex items-center justify-between mb-10">
    <h2 class="text-3xl font-bold" style="color:#1A1F36">{t.blog.title}</h2>
    <a href={getLocalizedPath(lang, '/blog/')} class="text-primary font-semibold text-sm hover:underline">
      {t.blog.allArticles} →
    </a>
  </div>

  <div class="blog-teaser-grid">
    {featured && <BlogCard post={featured} lang={lang} featured={true} />}
    {rest.length > 0 && (
      <div class="blog-teaser-compact">
        {rest.map(post => <BlogCard post={post} lang={lang} featured={false} />)}
      </div>
    )}
  </div>
</section>

<style>
  .blog-teaser-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .blog-teaser-compact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .blog-teaser-grid { grid-template-columns: 1fr; }
  }
</style>
