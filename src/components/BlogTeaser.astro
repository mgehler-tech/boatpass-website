---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { useTranslations, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', entry => entry.data.lang === lang);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const [featured, ...rest] = posts;
---

<section class="max-w-6xl mx-auto px-6 py-12 md:py-20">
  <div class="blog-teaser-header">
    <h2 class="section-display-title">{t.blog.title}</h2>
    <a href={getLocalizedPath(lang, '/blog/')} class="blog-teaser-all">
      {t.blog.allArticles} →
    </a>
  </div>

  <div class="blog-teaser-grid">
    {featured && <BlogCard post={featured} lang={lang} featured={true} />}
    {rest.length > 0 && (
      <div class="blog-teaser-compact">
        {rest.map(post => <BlogCard post={post} lang={lang} featured={false} />)}
      </div>
    )}
  </div>
</section>

<style>
  /* Kopfzeile der Blog-Sektion: lange Überschrift (z. B. "Tipps & Wissenswertes")
     und der "Alle Artikel"-Link teilten sich zuvor eine starre Flex-Zeile ohne
     Umbruch. Auf schmalen Screens quetschte das den Link in eine schmale Spalte
     und riss die große Überschrift mitten im Wort um; items-center ließ den
     kleinen Link zudem an einer mehrzeiligen Überschrift „schweben".
     Jetzt: der Link bricht bei Platzmangel sauber unter die Überschrift, sitzt
     sonst auf deren Grundlinie (baseline) und behält eine ausreichend große
     Touch-Fläche (WCAG 2.5.5 – mind. 44px). Reiner Layout-Feinschliff. */
  .blog-teaser-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 40px;
  }
  .blog-teaser-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .blog-teaser-all:hover { text-decoration: underline; }

  /* Featured-Karte (links) und die zwei gestapelten Kompakt-Karten (rechts)
     teilen sich eine Zeile. Bislang stand die Featured-Karte per align-items:start
     oben und behielt ihre kurze Eigenhöhe (~250px), während die rechte Spalte aus
     zwei Karten fast doppelt so hoch ist (~530px). Darunter blieb ein großer,
     unausgeglichener Leerraum – die untere Kante der beiden Spalten lief ausgefranst
     auseinander. Mit stretch füllt die Featured-Karte die volle Zeilenhöhe; ihre
     Fußzeile ist unten verankert (siehe .blog-featured in BlogCard.astro), sodass
     beide Spalten bündig auf einer Linie abschließen – dieselbe „gleiche Höhe, CTA
     unten"-Behandlung wie die .paid-card-Reihe im Preis-Abschnitt. Einspaltig (mobil)
     steht jede Karte allein in ihrer Zeile, dort greift stretch nicht – das Layout
     bleibt unverändert. Reiner Layout-Feinschliff: Corporate Design unberührt. */
  .blog-teaser-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: stretch;
  }
  .blog-teaser-compact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .blog-teaser-grid { grid-template-columns: 1fr; }
  }
</style>
