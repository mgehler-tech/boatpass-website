---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<div class="max-w-6xl mx-auto px-6 mb-16">
  <div class="cta-banner-card">
    <div class="cta-banner-text">
      <h2 class="cta-banner-title">{t.ctaBanner.title}</h2>
      <p class="cta-banner-subtitle">{t.ctaBanner.subtitle}</p>
    </div>
    <div class="cta-banner-action">
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="bottom-banner" id="cta-banner-play" class="cta-banner-button">
        <svg width="10" height="12" viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1.5 1.5L8.5 6L1.5 10.5V1.5Z" fill="#3366FF" stroke="#3366FF" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <span>{t.ctaBanner.cta}</span>
      </a>
      <div id="cta-banner-ios" class="cta-banner-ios-badge">
        <Icon name="phoneDevice" size={16} strokeWidth={2} />
        <span>{t.hero.ctaIos}</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Play Store hat kein iOS-Pendant (App noch nicht erschienen, siehe hero.ctaIos) –
  // ohne diese Weiche landen iOS-Besucher:innen auf einer Store-Seite, die sie nicht
  // installieren können. Gleiche Erkennung wie im Hero-CTA (HeroSection.astro), hier
  // für den sitewide Bottom-Banner (auf jeder Seite via BaseLayout eingebunden).
  (function () {
    var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (!isIos) return;
    var play = document.getElementById('cta-banner-play');
    var ios = document.getElementById('cta-banner-ios');
    if (play && ios) {
      play.style.display = 'none';
      ios.style.display = 'inline-flex';
    }
  })();
</script>

<style>
  .cta-banner-card {
    background: linear-gradient(135deg, #3366FF 0%, #1A44D4 100%);
    border-radius: 28px;
    padding: 48px 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    box-shadow: 0 20px 50px rgba(51, 102, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
  }
  
  /* Decorative orb */
  .cta-banner-card::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 70%);
    pointer-events: none;
  }

  .cta-banner-text {
    text-align: left;
    max-width: 600px;
  }

  /* Banner-Überschrift flüssig statt hartkodiert: skaliert sanft von 26px bis
     32px mit (clamp), sodass der abrupte Font-Sprung am 768px-Breakpoint
     entfällt und die Größe auch auf Tablets sauber mitwächst. Laufweite in em
     (statt fester -1.5px), damit sie bei kleinerer Schrift proportional lockerer
     wird – dieselbe Behandlung wie die zentralisierten Titel-Klassen. Corporate
     Design (Weiß, Font-Weight 900) bleibt unberührt. */
  .cta-banner-title {
    font-size: clamp(1.625rem, 4.5vw, 2rem); /* 26px … 32px */
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .cta-banner-subtitle {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  .cta-banner-action {
    flex-shrink: 0;
  }

  .cta-banner-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    color: #3366FF;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 100px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-banner-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  /* Startet ausgeblendet, das Inline-Script schaltet auf iOS um (siehe oben). */
  .cta-banner-ios-badge {
    display: none;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 100px;
  }

  @media (max-width: 768px) {
    .cta-banner-card {
      flex-direction: column;
      text-align: center;
      padding: 40px 24px;
      gap: 24px;
    }
    .cta-banner-text {
      text-align: center;
    }
    .cta-banner-subtitle {
      font-size: 15px;
    }
    .cta-banner-button, .cta-banner-ios-badge {
      width: 100%;
      justify-content: center;
    }
  }
</style>
