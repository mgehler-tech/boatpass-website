---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<!-- Abschluss vor dem Footer (auf jeder Seite via BaseLayout): ein Streifen in
     Druckfarbe mit invertierter Karten-Randskala statt Verlaufs-Karte. -->
<section class="ctab">
  <div class="chart-rule ctab-rule" aria-hidden="true"></div>
  <div class="ctab-inner">
    <div class="ctab-text">
      <h2 class="display ctab-title">{t.ctaBanner.title}</h2>
      <p class="ctab-sub">{t.ctaBanner.subtitle}</p>
    </div>
    <div class="ctab-action">
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" data-cta-position="bottom-banner" id="cta-banner-play" class="ctab-btn">
        <svg width="11" height="13" viewBox="0 0 10 12" fill="none" aria-hidden="true">
          <path d="M1.5 1.5L8.5 6L1.5 10.5V1.5Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <span>{t.ctaBanner.cta}</span>
      </a>
      <div id="cta-banner-ios" class="ctab-ios">
        <Icon name="phoneDevice" size={16} strokeWidth={2} />
        <span>{t.hero.ctaIos}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Play Store hat kein iOS-Pendant (App noch nicht erschienen, siehe hero.ctaIos) –
  // ohne diese Weiche landen iOS-Besucher:innen auf einer Store-Seite, die sie nicht
  // installieren können. Gleiche Erkennung wie im Hero-CTA (HeroSection.astro), hier
  // für den sitewide Bottom-Banner (auf jeder Seite via BaseLayout eingebunden).
  (function () {
    var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (!isIos) return;
    var play = document.getElementById('cta-banner-play');
    var ios = document.getElementById('cta-banner-ios');
    if (play && ios) {
      play.style.display = 'none';
      ios.style.display = 'inline-flex';
    }
  })();
</script>

<style>
  .ctab {
    /* Farben lokal umgedreht: Papier-Schrift auf Druckfarbe. Die Randskala
       liest --ink und erscheint dadurch hell auf dunklem Grund. */
    --band: #0F1B2A;
    --band-ink: #F5F3EC;
    background: var(--band);
    color: var(--band-ink);
  }
  :global(html.dark) .ctab { --band: #16273A; --band-ink: #E8ECF1; }
  .ctab-rule { --ink: var(--band-ink); border-top: 0; }

  .ctab-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 48px 24px 56px;
    display: grid;
    gap: 28px;
  }
  .ctab-title { font-size: clamp(2.3rem, 1.6rem + 2.8vw, 3.8rem); margin-bottom: 12px; }
  .ctab-sub { font-size: 16.5px; line-height: 1.5; opacity: 0.86; max-width: 32em; }

  .ctab-btn, .ctab-ios {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 26px;
    border-radius: 8px;
    font-size: 17px;
    font-weight: 700;
  }
  .ctab-btn {
    background: var(--band-ink);
    color: var(--band);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .ctab-btn:hover { opacity: 0.9; }
  .ctab-btn:focus-visible { outline: 2px solid var(--band-ink); outline-offset: 3px; }
  /* Startet ausgeblendet, das Inline-Script schaltet auf iOS um (siehe oben). */
  .ctab-ios { display: none; border: 1.5px solid var(--band-ink); }

  /* Der Streifen schließt direkt an den Footer an. */
  :global(.ctab ~ footer) { margin-top: 0 !important; }

  @media (max-width: 640px) {
    .ctab-btn, .ctab-ios { width: 100%; }
  }
  @media (min-width: 800px) {
    .ctab-inner { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 48px; padding: 72px 40px 80px; }
  }
</style>
