---
// Fakten-Karte „Auf einen Blick" in der Seitenleiste der Lizenzseiten (Spec
// Runde 2, 5.3): vier bis fünf Begriff/Wert-Paare, die 1:1 aus der Seite
// stammen, darunter ab 1024 px Preis und ein kleiner Store-Button (am Handy
// steht der Kopf-Button direkt darüber, deshalb dort ausgeblendet).
import Icon from '../Icon.astro';
import PlatformPrice from '../PlatformPrice.astro';
import { useTranslations } from '../../i18n/index';
import { PLAY_STORE_URL, type ProductKey } from '../../data/stores';

interface Props {
  lang: 'de' | 'en';
  title: string;
  items: { k: string; v: string }[];
  /** Mit Produkt: Preiszeile und Store-Button unter den Paaren. */
  product?: ProductKey;
  /** Seiten, die mehrere Produkte behandeln: „In der App ab …" statt „für …". */
  from?: boolean;
}

const { lang, title, items, product, from = false } = Astro.props;
const de = lang === 'de';
const t = useTranslations(lang);
const priceLead = de ? (from ? 'In der App ab' : 'In der App für') : (from ? 'In the app from' : 'In the app for');
---

<div class="pg-aside-card">
  <h2 class="pg-aside-title">{title}</h2>
  <dl class="pg-facts">
    {items.map(item => (
      <div class="pg-fact">
        <dt class="pg-fact-k">{item.k}</dt>
        <dd class="pg-fact-v h-num">{item.v}</dd>
      </div>
    ))}
  </dl>
  {product && (
    <div class="pg-aside-buy">
      <p class="pg-aside-price">
        {`${priceLead} `}<strong class="h-num"><PlatformPrice product={product} lang={lang} /></strong>{` ${de ? 'einmalig' : 'one-off'}`}
      </p>
      <a class="h-btn h-btn--sm" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" data-cta-position="page-aside">
        {de ? 'Kostenlos starten' : 'Start for free'}
        <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
        <span class="sr-only h-off-desktop">{t.home.newTab}</span>
      </a>
    </div>
  )}
</div>
