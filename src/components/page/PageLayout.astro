---
// Spaltenordnung der Inhaltsseiten (Spec Runde 2, 5.3; Runde 3, 3.1). `read`:
// Lesespalte plus klebende Seitenleiste (Slot „aside"), die im DOM vor dem
// Inhalt steht und am Handy direkt unter dem Kopf erscheint. `wide`: eine
// Spalte über die Containerbreite (Übersichten). `narrow`: eine Spalte mit
// 760 px, linksbündig auf der Containerkante, ohne Leiste (Infoseiten, FAQ,
// Schein-Finder).
interface Props {
  variant?: 'read' | 'wide' | 'narrow';
}

const { variant = 'read' } = Astro.props;
const hasAside = variant === 'read' && Astro.slots.has('aside');
---

<div class="h-container">
  <div class:list={['pg-layout', `pg-layout--${variant}`]}>
    {hasAside && (
      <aside class="pg-aside">
        <slot name="aside" />
      </aside>
    )}
    <div class="pg-main">
      <slot />
    </div>
  </div>
</div>
