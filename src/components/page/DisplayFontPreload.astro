---
// Display-Schrift (Archivo, Subset latin mit Breitenachse) für Seiten mit
// PageHead: Preload plus eigene @font-face-Deklaration mit font-display: swap,
// wie auf der Startseite (Entscheidung des Inhabers, 2026-10-21). Hintergrund
// (Spec Runde 2, 5.3 / Plan Task 9): Lighthouse rechnet die 90-KB-Datei vor
// dem LCP ein, unabhängig von font-display; optional hätte die Zahl nicht
// verbessert, aber kalte Erstbesuche ohne Archivo gelassen. Mit swap rendert
// die H1 zuerst in Inter (--h-display fällt darauf zurück) und wechselt zu
// Archivo, sobald die Datei da ist; der Preload zieht das vor. Dieselbe Datei
// nutzt die Startseite, der Cache greift gegenseitig.
// Einsatz: <DisplayFontPreload slot="head" /> im BaseLayout.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

// Unicode-Bereich des latin-Subsets, wie in @fontsource-variable/archivo/wdth.css.
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFace = `@font-face{font-family:"Archivo Variable";font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivoLatin}) format("woff2-variations");unicode-range:${LATIN}}`;
---

<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontFace}></style>
