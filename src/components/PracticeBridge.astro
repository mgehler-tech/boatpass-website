---
import Icon from './Icon.astro';
import type { IconName } from '../icons';

interface Props {
  // 'navigation' → Kartenaufgaben (SBF See); 'radio' → Sprechfunkverfahren (SRC/UBI/LRC)
  variant: 'navigation' | 'radio';
}

const { variant } = Astro.props;

type Content = {
  heading: string;
  intro: string;
  points: { icon: IconName; title: string; desc: string }[];
  reassure: string;
};

const content: Record<Props['variant'], Content> = {
  navigation: {
    heading: 'Kartenaufgaben digital meistern – schaffe ich das ohne Kurs?',
    intro: 'Die Navigationsaufgabe gilt als der schwierigste Prüfungsteil – ist aber kein Bauchgefühl, sondern ein festes Schema: Kurs anlegen, Standort bestimmen, Wind- und Stromversatz sowie Gezeiten einrechnen. Genau solche Wiederhol-Aufgaben lernst du auf dem Smartphone oft besser als im Buch.',
    points: [
      { icon: 'compass', title: 'Schema statt Raten', desc: 'Jede Kartenaufgabe folgt denselben Rechenschritten. Du lernst den Ablauf – nicht 15 Einzelfälle auswendig.' },
      { icon: 'refresh', title: 'Beliebig oft wiederholen', desc: 'Alle 15 Navigationsaufgaben à 9 Fragen sind getrennt vom Fragebogen übbar – so oft, bis der Ablauf sitzt.' },
      { icon: 'check', title: 'Sofortige Kontrolle', desc: 'Nach jedem Schritt siehst du, ob dein Ergebnis stimmt – mit Erklärung, statt nur „richtig/falsch".' },
    ],
    reassure: 'Für die praktische Kartenarbeit am Prüfungstag brauchst du Übungsseekarte, Zirkel und Anlegedreieck. Den Rechenweg bringst du mit BoatPass sicher mit – du gehst mit Routine in die Aufgabe, nicht hoffend.',
  },
  radio: {
    heading: 'Angst vorm Sprechfunk? Die nehmen wir dir.',
    intro: 'Die Sorge vor Diktat und dem Absetzen einer Meldung kommt fast immer aus fehlender Wiederholung – nicht aus mangelndem Können. Die Meldungen folgen einem festen Wortlaut (MAYDAY, PAN PAN, Buchstabiertafel). Wer den Ablauf oft genug durchgespielt hat, dem sitzt er.',
    points: [
      { icon: 'microphone', title: 'Fester Wortlaut', desc: 'Not-, Dringlichkeits- und Sicherheitsmeldungen haben eine feste Reihenfolge. Du lernst das Muster – und füllst es im Ernstfall sicher aus.' },
      { icon: 'clipboard', title: 'Meldungen Schritt für Schritt', desc: 'Buchstabiertafel, Anruf, Verkehrsabwicklung: Du übst jeden Baustein einzeln, bis er ohne Nachdenken kommt.' },
      { icon: 'refresh', title: 'Sicherheit durch Wiederholung', desc: 'Was du hundertmal durchgespielt hast, sagst du am Prüfungstag automatisch – die praktische Hürde wird zur Formsache.' },
    ],
    reassure: 'Den finalen Sprechschliff am echten Gerät holst du dir im praktischen Prüfungsteil bei deiner Funkschule. Den Wortlaut und die Verfahren bringst du mit BoatPass sicher mit.',
  },
};

const c = content[variant];
---

<section style="margin-bottom:48px;">
  <h2 style="font-size:28px; font-weight:800; color:#1A1F36; letter-spacing:-1px; margin-bottom:16px;">{c.heading}</h2>
  <p style="font-size:16px; color:#4B5563; line-height:1.75; margin-bottom:20px;">{c.intro}</p>

  <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:18px;">
    {c.points.map(p => (
      <div style="display:flex; align-items:flex-start; gap:14px; background:white; border:1px solid rgba(51,102,255,0.1); border-radius:14px; padding:18px;">
        <span style="width:40px; height:40px; border-radius:11px; background:rgba(51,102,255,0.08); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <Icon name={p.icon} size={20} stroke="#3366FF" strokeWidth={1.75} />
        </span>
        <div>
          <div style="font-weight:700; color:#1A1F36; margin-bottom:3px; font-size:14px;">{p.title}</div>
          <div style="font-size:14px; color:#4B5563; line-height:1.6;">{p.desc}</div>
        </div>
      </div>
    ))}
  </div>

  <!-- Ehrliche Abgrenzung: App bringt Verfahren/Schema, Praxis bleibt vor Ort -->
  <div class="practice-note" style="display:flex; align-items:flex-start; gap:14px; background:linear-gradient(160deg,#F4F7FE 0%,#EAF0FC 100%); border:1px solid rgba(51,102,255,0.16); border-radius:16px; padding:20px 24px;">
    <span style="flex-shrink:0; margin-top:1px;"><Icon name="lifebuoy" size={20} stroke="#3366FF" strokeWidth={1.75} /></span>
    <p class="practice-note-text" style="font-size:14px; color:#4B5563; line-height:1.65; margin:0;">{c.reassure}</p>
  </div>
</section>

<style>
  html.dark section h2 { color: #E2E8F0 !important; }
  html.dark section > p { color: #94A3B8 !important; }
  html.dark section [style*="background:white"] {
    background: #181E2E !important;
    border-color: rgba(90, 120, 255, 0.12) !important;
  }
  html.dark section [style*="color:#1A1F36"] { color: #E2E8F0 !important; }
  html.dark section [style*="color:#4B5563"]  { color: #94A3B8 !important; }
  html.dark section [style*="background:rgba(51,102,255,0.08)"] {
    background: rgba(90, 120, 255, 0.14) !important;
  }
  html.dark .practice-note {
    background: rgba(90, 120, 255, 0.07) !important;
    border-color: rgba(90, 120, 255, 0.18) !important;
  }
  html.dark .practice-note-text { color: #94A3B8 !important; }
</style>
