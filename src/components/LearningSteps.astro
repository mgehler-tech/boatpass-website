---
// Vier echte App-Screens als Produktkarten (ersetzt die frei stehenden
// Screenshots auf der Startseite). Jede Funktion sitzt jetzt in einer eigenen
// Karte mit Rahmen und klarer Hierarchie: Nummern-Badge → Titel → Beschreibung
// → Screenshot. Die Aufnahme belegt, wovon der Text darüber spricht, und
// verankert die Karte optisch unten.
//
// Reihenfolge ist inhaltlich begründet und keine Dekoration: starten,
// verstehen, messen, prüfen. Deshalb tragen die Karten fortlaufende Nummern.
//
// Auf dem Handy laufen die Karten als horizontaler Snap-Slider (die nächste
// Karte lugt bewusst hervor); ab dem md-Breakpoint stehen sie als 4er-Grid.
// Die Slider-Mechanik (.snap-row / .snap-item / .snap-dots) kommt aus
// global.css – hier nur die karten-spezifischen Maße darüber gelegt.
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/index';
import screenshotHomeDe from '../assets/images/app.screenshot.0.de.png';
import screenshotQuestionDe from '../assets/images/app.screenshot.3.de.png';
import screenshotLogDe from '../assets/images/app.screenshot.1.de.png';
import screenshotExamDe from '../assets/images/app.screenshot.2.de.png';
import screenshotHomeEn from '../assets/images/app.screenshot.0.en.png';
import screenshotQuestionEn from '../assets/images/app.screenshot.3.en.png';
import screenshotLogEn from '../assets/images/app.screenshot.1.en.png';
import screenshotExamEn from '../assets/images/app.screenshot.2.en.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';

const shots = de
  ? [screenshotHomeDe, screenshotQuestionDe, screenshotLogDe, screenshotExamDe]
  : [screenshotHomeEn, screenshotQuestionEn, screenshotLogEn, screenshotExamEn];

const alts = de
  ? [
      'Boatpass App – Startbildschirm mit Tagesziel, Streak und Lernmodi',
      'Boatpass App – Frage mit Erklärung und Merkhilfe',
      'Boatpass App – Logbuch mit Fortschritt je Kategorie',
      'Boatpass App – Prüfungsbereich mit Formkurve',
    ]
  : [
      'Boatpass app – home screen with daily goal, streak and study modes',
      'Boatpass app – question with explanation and mnemonic',
      'Boatpass app – logbook with progress per category',
      'Boatpass app – exam area with performance curve',
    ];

const steps = t.steps.items.map((item, i) => ({
  ...item,
  num: String(i + 1).padStart(2, '0'),
  shot: shots[i],
  alt: alts[i],
}));

// Akzentwort in der Überschrift ("BoatPass") blau hervorheben, ohne den Text
// aus der Übersetzung zu lösen: Wir teilen an genau diesem Wort auf.
const titleParts = t.steps.title.split('BoatPass');
---

<section id="features" class="section-band learning-steps max-w-6xl mx-auto px-6 py-14 md:py-20">
  <!-- Sehr dezente nautische Wellenlinien, rein dekorativ (oben rechts). -->
  <svg class="ls-waves" viewBox="0 0 420 260" fill="none" aria-hidden="true" focusable="false">
    <path d="M-20 40 C 60 10, 140 70, 220 40 S 380 10, 460 40" />
    <path d="M-20 80 C 60 50, 140 110, 220 80 S 380 50, 460 80" />
    <path d="M-20 120 C 60 90, 140 150, 220 120 S 380 90, 460 120" />
    <path d="M-20 160 C 60 130, 140 190, 220 160 S 380 130, 460 160" />
  </svg>

  <div class="reveal-item steps-head" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
    <h2 class="section-display-title steps-title">
      {titleParts[0]}<span class="ls-accent">BoatPass</span>{titleParts[1]}
    </h2>
    <p class="steps-sub">{t.steps.subtitle}</p>
  </div>

  <div class="steps-grid snap-row" data-snap-row="steps"
    aria-label={de ? 'Vier Screens aus der App' : 'Four screens from the app'}>
    {steps.map(step => (
      <div class="step snap-item reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="step-badge">{step.num}</div>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-desc">{step.desc}</p>
        <div class="step-shot">
          <Image src={step.shot} alt={step.alt} width={520} quality={80} loading="lazy" />
        </div>
      </div>
    ))}
  </div>
  <div class="snap-dots" data-snap-dots="steps"></div>
</section>

<style>
  .learning-steps {
    position: relative;
    overflow: hidden;
  }

  /* Dekolinien: nur ganz leicht sichtbar, oben rechts, hinter den Inhalten. */
  .ls-waves {
    position: absolute;
    top: 8px;
    right: -40px;
    width: 320px;
    height: auto;
    z-index: 0;
    pointer-events: none;
    color: rgba(51, 102, 255, 0.10);
  }
  .ls-waves path {
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }
  html.dark .ls-waves { color: rgba(120, 155, 255, 0.12); }

  /* Inhalte über den Dekolinien. */
  .steps-head,
  .steps-grid,
  .snap-dots { position: relative; z-index: 1; }

  .steps-title {
    margin-bottom: 16px;
  }
  .ls-accent { color: #3366FF; }
  html.dark .ls-accent { color: var(--color-accent-fg); }

  .steps-sub {
    font-size: 16px;
    color: #656B78;
    max-width: 480px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }

  /* Produktkarte: heller Grund, feiner Rahmen, sehr dezenter Schatten. Der
     Screenshot sitzt unten und schließt die Karte optisch ab – deshalb ist die
     Karte ein Flex-Container und die Aufnahme wird per margin-top:auto nach
     unten gedrückt, damit alle Karten trotz unterschiedlich langer Texte auf
     gleicher Höhe „enden". */
  .step {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 1px solid #E7EDF7;
    border-radius: 28px;
    box-shadow: 0 8px 30px rgba(15, 23, 46, 0.06);
    padding: 24px 20px 0;
    overflow: hidden;
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #EEF4FF;
    color: #3366FF;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 16px;
  }

  .step-title {
    font-size: 18px;
    line-height: 24px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--color-navy);
    margin-bottom: 16px;
  }
  .step-desc {
    font-size: 16px;
    line-height: 28px;
    color: #656B78;
    margin-bottom: 20px;
  }

  /* Screenshot als eingebettetes Produkt-Preview: volle Kartenbreite, oben
     abgerundet, unten vom Kartenrand beschnitten. Feste Höhe zeigt den oberen,
     aussagekräftigen Teil des Hochkant-Screens. */
  .step-shot {
    margin-top: auto;
    height: 260px;
    overflow: hidden;
    border-radius: 20px 20px 0 0;
    border: 1px solid rgba(26, 31, 54, 0.08);
    border-bottom: none;
    line-height: 0;
  }
  .step-shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Handy: horizontaler Slider statt Grid. Feste Kartenbreite (304px) mit
     Peek der nächsten Karte; Karten rasten linksbündig ein (start), damit die
     erste Karte am Rand steht und die nächste rechts hervorlugt. Die
     Grundmechanik (Flex, Snap, Rand-Ausgleich) steht in global.css unter
     .snap-row; hier nur Breite, Abstand und Ausrichtung überschrieben. */
  @media (max-width: 768px) {
    .steps-grid {
      display: flex;
      gap: 16px;
    }
    .steps-grid .step {
      flex: 0 0 304px;
      min-height: 520px;
      scroll-snap-align: start;
    }
  }

  /* Sehr kleine Geräte (≈360px): Karte etwas schmaler, Abstand minimal enger. */
  @media (max-width: 360px) {
    .steps-grid { gap: 14px; }
    .steps-grid .step { flex-basis: 292px; }
  }

  /* Größere Handys (≈414–430px): Karte darf leicht wachsen, Peek bleibt. */
  @media (min-width: 414px) and (max-width: 768px) {
    .steps-grid .step { flex-basis: 312px; }
  }

  /* Aktiver Punkt im Marken-Blau, inaktiv im hellen Blau der Vorgaben –
     scoped auf diese Reihe, damit andere Snap-Reihen unverändert bleiben. */
  .snap-dots :global(.snap-dot::after) { background: #D8E3F8; }
  .snap-dots :global(.snap-dot[aria-current="true"]::after) { background: #3366FF; }

  /* Dark Mode: Karte, Rahmen, Badge und Text auf den dunklen Grund anheben. */
  html.dark .steps-sub { color: #94A3B8; }
  html.dark .step {
    background: #181E2E;
    border-color: rgba(90, 120, 255, 0.14);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }
  html.dark .step-badge {
    background: rgba(90, 120, 255, 0.12);
    color: var(--color-accent-fg);
  }
  html.dark .step-title { color: #E2E8F0; }
  html.dark .step-desc { color: #94A3B8; }
  html.dark .step-shot { border-color: rgba(90, 120, 255, 0.14); }
  html.dark .snap-dots :global(.snap-dot::after) { background: rgba(226, 232, 240, 0.22); }
  html.dark .snap-dots :global(.snap-dot[aria-current="true"]::after) { background: #5B8CFF; }
</style>

<script>
  import { initSnapDots } from '../scripts/snapDots';

  initSnapDots('[data-snap-row="steps"]');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    document.querySelectorAll<HTMLElement>('#features .reveal-item').forEach(el => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    });
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.opacity = '1';
          (e.target as HTMLElement).style.transform = 'translateY(0)';
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#features .reveal-item').forEach(el => observer.observe(el));
  }
</script>
