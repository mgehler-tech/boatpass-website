---
// Vier echte App-Screens als Kurs mit vier Wegpunkten: starten, verstehen,
// messen, prüfen. Die Reihenfolge ist inhaltlich begründet, deshalb tragen die
// Schritte Wegpunkt-Nummern auf einer gestrichelten Kurslinie – Sprache der
// Kartenaufgabe statt nummerierter Karten.
//
//  • Handy (≤768px): seitlich wischbare Reihe (Mechanik .snap-row/.snap-item/
//    .snap-dots aus global.css), die Kurslinie läuft über alle Schritte durch.
//  • Desktop: vier Spalten nebeneinander, Text über dem Screenshot.
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/index';
import screenshotHomeDe from '../assets/images/app.screenshot.0.de.png';
import screenshotQuestionDe from '../assets/images/app.screenshot.3.de.png';
import screenshotLogDe from '../assets/images/app.screenshot.1.de.png';
import screenshotExamDe from '../assets/images/app.screenshot.2.de.png';
import screenshotHomeEn from '../assets/images/app.screenshot.0.en.png';
import screenshotQuestionEn from '../assets/images/app.screenshot.3.en.png';
import screenshotLogEn from '../assets/images/app.screenshot.1.en.png';
import screenshotExamEn from '../assets/images/app.screenshot.2.en.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';

const shots = de
  ? [screenshotHomeDe, screenshotQuestionDe, screenshotLogDe, screenshotExamDe]
  : [screenshotHomeEn, screenshotQuestionEn, screenshotLogEn, screenshotExamEn];

const alts = de
  ? [
      'Boatpass App – Startbildschirm mit Tagesziel, Streak und Lernmodi',
      'Boatpass App – Frage mit Erklärung und Merkhilfe',
      'Boatpass App – Logbuch mit Fortschritt je Kategorie',
      'Boatpass App – Prüfungsbereich mit Formkurve',
    ]
  : [
      'Boatpass app – home screen with daily goal, streak and study modes',
      'Boatpass app – question with explanation and mnemonic',
      'Boatpass app – logbook with progress per category',
      'Boatpass app – exam area with performance curve',
    ];

const steps = t.steps.items.map((item, i) => ({ ...item, num: i + 1, shot: shots[i], alt: alts[i] }));
---

<section id="features" class="ls">
  <div class="ls-inner">
    <header class="ls-head">
      <h2 class="display ls-title">{t.steps.title}</h2>
      <p class="ls-sub">{t.steps.subtitle}</p>
    </header>

    <ol class="ls-route snap-row" data-snap-row="steps"
      aria-label={de ? 'Vier Screens aus der App' : 'Four screens from the app'}>
      {steps.map(step => (
        <li class="ls-step snap-item">
          <div class="ls-wp" aria-hidden="true">
            <span class="ls-wp-mark"></span>
            <span class="ls-wp-num">WP {step.num}</span>
          </div>
          <h3 class="ls-step-title">{step.title}</h3>
          <p class="ls-step-desc">{step.desc}</p>
          <div class="ls-shot">
            <Image src={step.shot} alt={step.alt} width={480} quality={80} loading="lazy" />
          </div>
        </li>
      ))}
    </ol>
    <div class="snap-dots" data-snap-dots="steps"></div>
  </div>
</section>

<style>
  .ls { color: var(--ink); }
  .ls-inner { max-width: 1200px; margin-inline: auto; padding: 72px 24px 64px; }

  .ls-head { margin-bottom: 40px; }
  .ls-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem); margin-bottom: 16px; }
  .ls-sub { font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 30em; }

  /* Route: Liste ohne Aufzählungszeichen. Abstand zwischen den Schritten als
     Innenabstand statt gap, damit die Kurslinie lückenlos durchläuft. */
  .ls-route { list-style: none; margin: 0; padding: 0; }
  .ls-step { position: relative; padding-right: 28px; min-width: 0; }

  /* Kurslinie: gestrichelt, auf Höhe der Wegpunkte, über die volle Breite
     jedes Schritts – aneinandergereiht ergibt das eine durchgehende Linie. */
  .ls-step::before {
    content: "";
    position: absolute;
    top: 9px;
    left: 0;
    right: 0;
    border-top: 1.5px dashed var(--ink);
    opacity: 0.55;
  }
  .ls-step:last-child::before { right: auto; width: 60%; }

  /* Wegpunkt-Symbol wie in der Seekarte: Kreis mit Punkt. */
  .ls-wp { position: relative; display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .ls-wp-mark {
    position: relative;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }
  .ls-wp-mark::after {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--ink);
  }
  .ls-wp-num {
    font-size: 13px;
    font-style: italic;
    font-weight: 600;
    color: var(--magenta);
    background: var(--paper);
    padding-right: 6px;
  }

  .ls-step-title {
    font-size: 23px;
    font-weight: 740;
    font-stretch: 84%;
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .ls-step-desc { font-size: 15.5px; line-height: 1.5; color: var(--ink-2); margin-bottom: 22px; max-width: 26em; }

  /* Echter Screenshot, ohne nachgebauten Geräterahmen: nur Kontur und ein
     knapper Schatten, wie ein ausgedrucktes Bildschirmfoto auf dem Kartentisch. */
  .ls-shot { line-height: 0; max-width: 250px; }
  .ls-shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    border: 1px solid var(--rule-2);
    box-shadow: 0 18px 30px -22px rgba(15, 27, 42, 0.55);
  }

  /* Handy/Tablet: Wisch-Reihe. */
  @media (max-width: 768px) {
    .ls-route { display: flex; gap: 0; }
    .ls-route .ls-step { flex: 0 0 78%; padding-right: 22px; }
    .ls-shot { max-width: 220px; }
  }

  @media (min-width: 769px) {
    .ls-inner { padding: 104px 40px 96px; }
    .ls-head {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 40px;
      margin-bottom: 56px;
    }
    .ls-title { margin-bottom: 0; }
    .ls-route { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 56px; }
    .snap-dots { display: none; }
  }
  @media (min-width: 1100px) {
    .ls-route { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Punkte der Wisch-Reihe in Druckfarbe statt Markenblau. */
  .snap-dots :global(.snap-dot::after) { background: var(--rule-2); }
  .snap-dots :global(.snap-dot[aria-current="true"]::after) { background: var(--ink); }
</style>

<script>
  import { initSnapDots } from '../scripts/snapDots';
  initSnapDots('[data-snap-row="steps"]');
</script>
