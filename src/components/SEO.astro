---
import type { AppRating } from '../data/apps';

interface Props {
  title: string;
  description: string;
  lang: 'de' | 'en';
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article';
  /** Set false for pages that have no counterpart in the other language (e.g. DE-only landing pages). Prevents broken hreflang to non-existent URLs. */
  hasAlternate?: boolean;
  /** Explicit alternate-language URL. Needed when the slug differs between languages (e.g. blog posts), where the path heuristic does not apply. */
  altUrl?: string;
  /** Set true to keep a page out of the index (e.g. thin/duplicate pages). */
  noindex?: boolean;
  appRating?: AppRating;
}

const {
  title,
  description,
  lang,
  canonical = Astro.url.href,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  type = 'website',
  hasAlternate = true,
  altUrl: altUrlOverride,
  noindex = false,
  appRating,
} = Astro.props;

const altLang = lang === 'de' ? 'en' : 'de';
const altUrl = altUrlOverride ?? (lang === 'de'
  ? `https://boatpass.de/en${Astro.url.pathname}`
  : `https://boatpass.de${Astro.url.pathname.replace('/en', '')}`);
// Mit explizitem altUrl (z.B. Blog mit abweichenden Slugs) zeigt x-default auf die DE-Version,
// sonst – wie bisher – auf die Startseite.
const xDefaultUrl = altUrlOverride
  ? (lang === 'de' ? canonical : altUrlOverride)
  : (hasAlternate ? 'https://boatpass.de/' : canonical);
const resolvedOgImage = ogImage ?? (lang === 'en' ? '/images/og-image-en.jpg' : '/images/og-image.jpg');
const ogImageAbs = resolvedOgImage.startsWith('http') ? resolvedOgImage : `https://boatpass.de${resolvedOgImage}`;
const ogImageType = ogImageAbs.endsWith('.jpg') || ogImageAbs.endsWith('.jpeg') ? 'image/jpeg' : 'image/png';
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '/en/' || Astro.url.pathname === '/en';
---

<title>{title} | Boatpass</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
<meta name="theme-color" content="#3366FF" />

<!-- hreflang -->
<link rel="alternate" hreflang={lang} href={canonical} />
{hasAlternate && <link rel="alternate" hreflang={altLang} href={altUrl} />}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph -->
<meta property="og:site_name" content="Boatpass" />
<meta property="og:title" content={`${title} | Boatpass`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:alt" content={`${title} – Boatpass`} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
{hasAlternate && <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | Boatpass`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
<meta name="twitter:image:alt" content={`${title} – Boatpass`} />

<!-- Schema.org Organization (auf allen Seiten) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Boatpass",
  "url": "https://boatpass.de",
  "logo": "https://boatpass.de/images/app-icon.png",
  "description": "Boatpass ist die moderne Lernapp für den Sportbootführerschein (SBF Binnen & See) – mit offiziellem ELWIS-Fragenkatalog, Prüfungssimulation und Fehlertraining.",
  "sameAs": [
    "https://play.google.com/store/apps/details?id=com.boatpass.app"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": "https://boatpass.de/kontakt/",
    "availableLanguage": ["German", "English"]
  }
})} />

<!-- Schema.org MobileApplication (nur auf Startseite) -->
{isHomepage && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "name": "Boatpass – Sportbootführerschein App",
    "url": "https://boatpass.de",
    "downloadUrl": "https://play.google.com/store/apps/details?id=com.boatpass.app",
    "operatingSystem": "Android",
    "applicationCategory": "EducationApplication",
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "lowPrice": "0",
      "highPrice": "16.98",
      "offerCount": "4",
      "offers": [
        {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
          "name": "Kostenlos",
          "description": "Kostenlos – 15 Fragen täglich gratis"
        },
        {
          "@type": "Offer",
          "price": "9.99",
          "priceCurrency": "EUR",
          "name": "SBF Binnen Vollzugang",
          "description": "Vollzugang SBF Binnen – einmaliger Kauf, kein Abo"
        },
        {
          "@type": "Offer",
          "price": "9.99",
          "priceCurrency": "EUR",
          "name": "SBF See Vollzugang",
          "description": "Vollzugang SBF See – einmaliger Kauf, kein Abo"
        },
        {
          "@type": "Offer",
          "price": "16.98",
          "priceCurrency": "EUR",
          "name": "Komplett-Paket SBF Binnen + See",
          "description": "Beide Kataloge im Paket – einmaliger Kauf, 3 € gespart"
        }
      ]
    },
    ...(appRating && appRating.ratings > 0 ? {
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": appRating.score.toFixed(1),
        "ratingCount": appRating.ratings,
        "bestRating": "5",
        "worstRating": "1"
      }
    } : {}),
    "description": description,
    "inLanguage": "de",
    "publisher": {
      "@type": "Organization",
      "name": "Boatpass",
      "url": "https://boatpass.de"
    }
  })} />
)}
