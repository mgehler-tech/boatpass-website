---
import { useTranslations } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { num: '1', label: t.howItWorks.step1, desc: t.howItWorks.step1Desc },
  { num: '2', label: t.howItWorks.step2, desc: t.howItWorks.step2Desc },
  { num: '3', label: t.howItWorks.step3, desc: t.howItWorks.step3Desc },
];
---

<section style="background:linear-gradient(160deg,#E8EDF6 0%,#DCE4F2 100%); padding:100px 24px;" id="how-it-works">
  <div class="max-w-6xl mx-auto">

    <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; margin-bottom:60px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        🧭 {t.howItWorks.chip}
      </div>
      <h2 style="font-size:42px; font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1;">{t.howItWorks.title}</h2>
    </div>

    <div class="steps-row">
      <!-- Connecting line -->
      <div class="steps-line"></div>

      {steps.map(step => (
        <div class="step-item reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
          <div style="width:56px; height:56px; border-radius:50%; background:#3366FF; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:900; color:white; margin-bottom:20px; position:relative; z-index:1; box-shadow:0 8px 20px rgba(51,102,255,0.25);">
            {step.num}
          </div>
          <div style="font-size:16px; font-weight:800; color:#1A1F36; margin-bottom:8px;">{step.label}</div>
          <div style="font-size:14px; color:#6B7280; line-height:1.6;">{step.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-row {
    display: flex;
    position: relative;
    max-width: 900px;
  }
  .steps-line {
    position: absolute;
    top: 28px;
    left: 56px;
    right: 56px;
    height: 2px;
    background: linear-gradient(90deg, #3366FF, #5B8CFF);
    opacity: 0.2;
  }
  .step-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }
  @media (max-width: 640px) {
    .steps-row { flex-direction: column; align-items: flex-start; }
    .steps-line { display: none; }
    .step-item { align-items: flex-start; text-align: left; padding: 0 0 24px 0; }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.opacity = '1';
        (e.target as HTMLElement).style.transform = 'translateY(0)';
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#how-it-works .reveal-item').forEach(el => obs.observe(el));
</script>
