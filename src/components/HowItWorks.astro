---
import { useTranslations } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { num: '1', label: t.howItWorks.step1 },
  { num: '2', label: t.howItWorks.step2 },
  { num: '3', label: t.howItWorks.step3 },
];
---

<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-text mb-14">{t.howItWorks.title}</h2>
    <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0">
      {steps.map((step, i) => (
        <>
          <div class="flex flex-col items-center text-center max-w-48">
            <div class="w-14 h-14 rounded-full bg-primary text-white text-xl font-bold flex items-center justify-center mb-4">
              {step.num}
            </div>
            <p class="font-semibold text-text">{step.label}</p>
          </div>
          {i < steps.length - 1 && (
            <div class="hidden md:block w-16 h-0.5 bg-primary/20 mx-4"></div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
