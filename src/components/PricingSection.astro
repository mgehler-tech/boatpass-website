---
import { useTranslations } from '../i18n/index';
import Icon from './Icon.astro';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const soonItems = [t.pricing.soon1];
---

<section id="pricing" style="padding:96px 24px; text-align:center;">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; margin-bottom:56px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        {t.pricing.chip}
      </div>
      <h2 style="font-size:42px; font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:14px; max-width:640px; margin-left:auto; margin-right:auto;">{t.pricing.title}</h2>
      <p style="font-size:16px; color:#6B7280; max-width:520px; margin:0 auto;">{t.pricing.subtitle}</p>
    </div>

    <div class="catalog-stack">

      <!-- Free vs Paid: Geschäftsmodell einmal zentral vor den Lizenz-Karten gegenüberstellen -->
      <div class="reveal-item compare-bar" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <!-- Free -->
        <div class="compare-col compare-free">
          <div class="compare-head">
            <span class="compare-label">{t.pricing.freeLabel}</span>
            <span class="compare-sub">{t.pricing.compareFreeSub}</span>
          </div>
          <div class="compare-features">
            {t.pricing.freeFeatures.map(f => (
              <div class="compare-feature">
                <span class="compare-check compare-check-free">
                  <Icon name="check" size={11} stroke="#3366FF" strokeWidth={2.5} />
                </span>
                <span>{f}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Paid -->
        <div class="compare-col compare-paid">
          <div class="compare-badge">{t.pricing.comparePaidBadge}</div>
          <!-- Orb -->
          <div style="position:absolute; top:-50px; right:-50px; width:160px; height:160px; border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,0.15),transparent 70%); pointer-events:none;"></div>
          <div class="compare-head" style="position:relative;">
            <span class="compare-label">{t.pricing.comparePaidLabel}</span>
            <span class="compare-sub">{t.pricing.comparePaidSub}</span>
          </div>
          <div class="compare-features" style="position:relative;">
            {t.pricing.comparePaidFeatures.map(f => (
              <div class="compare-feature">
                <span class="compare-check compare-check-paid">
                  <Icon name="check" size={11} stroke="white" strokeWidth={2.5} />
                </span>
                <span>{f}</span>
              </div>
            ))}
          </div>
          <div class="compare-price">{t.pricing.comparePaidPrice}</div>
        </div>
      </div>

      <!-- SBF Binnen – Freemium card (full width hero) -->
      <div class="reveal-item catalog-card featured" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <!-- Orb -->
        <div style="position:absolute; top:-60px; right:-60px; width:220px; height:220px; border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,0.15),transparent 70%); pointer-events:none;"></div>

        <div style="text-align:left; position:relative;">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div style="font-size:11px; font-weight:700; color:rgba(255,255,255,0.55); text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
            <div style="background:rgba(255,255,255,0.20); color:white; font-size:11px; font-weight:700; padding:4px 12px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
          </div>

          <div style="font-size:32px; font-weight:900; color:white; letter-spacing:-0.5px; margin-bottom:4px;">{t.pricing.catalog1Name}</div>
          <div style="font-size:14px; color:rgba(255,255,255,0.7); margin-bottom:18px;">{t.pricing.catalog1Tagline}</div>

          <!-- Inhalt des Katalogs: konkrete Zahlen statt generischer Feature-Wiederholung -->
          <div style="display:flex; gap:8px; margin-bottom:10px;">
            <span class="hero-stat"><strong>{t.pricing.catalog1Questions}</strong> {t.pricing.questionsUnit}</span>
            <span class="hero-stat"><strong>{t.pricing.catalog1Themes}</strong> {t.pricing.themesUnit}</span>
          </div>
          <div style="display:flex; align-items:center; gap:7px; margin-bottom:4px;">
            <Icon name="check" size={13} stroke="rgba(255,255,255,0.85)" strokeWidth={2.5} />
            <span style="font-size:12.5px; color:rgba(255,255,255,0.75);">{t.pricing.catalog1Note}</span>
          </div>

          <!-- CTAs -->
          <div style="display:flex; flex-direction:column; gap:10px; margin-top:28px;">
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-white-btn"
              style="display:block; text-align:center; padding:14px; border-radius:14px; font-size:15px; font-weight:700; text-decoration:none; background:white; color:#3366FF; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
              {t.pricing.ctaFree} →
            </a>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-outline-btn"
              style="display:block; text-align:center; padding:12px; border-radius:14px; font-size:14px; font-weight:600; text-decoration:none; border:1px solid rgba(255,255,255,0.25); color:white; background:rgba(255,255,255,0.06);">
              {t.pricing.ctaUnlock} · {t.pricing.price}
            </a>
          </div>
        </div>
      </div>

      <!-- Paid catalogs row: SBF See + UBI + SRC + LRC -->
      <div class="paid-grid">

        <!-- SBF See -->
        <div class="reveal-item catalog-card paid-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; background:white; border:1px solid rgba(51,102,255,0.10); box-shadow:0 8px 30px rgba(26,31,54,0.03);">
          <div class="paid-card-inner" style="text-align:left;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
              <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
            </div>
            <div style="font-size:24px; font-weight:900; color:#1A1F36; margin-bottom:6px; letter-spacing:-0.3px;">{t.pricing.catalog2Name}</div>
            <div style="font-size:14px; color:#6B7280; margin-bottom:16px; line-height:1.5;">{t.pricing.catalog2Desc}</div>
            <div class="catalog-content">
              <div class="stat-grid">
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog2Questions}</div>
                  <div class="stat-label">{t.pricing.questionsUnit}</div>
                </div>
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog2Themes}</div>
                  <div class="stat-label">{t.pricing.themesUnit}</div>
                </div>
              </div>
              <div class="catalog-highlight">
                <Icon name="check" size={14} stroke="#3366FF" strokeWidth={2.5} />
                <span>{t.pricing.catalog2Highlight}</span>
              </div>
              <div class="catalog-note">{t.pricing.catalog2Note}</div>
            </div>
            <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-bottom:20px;">
              <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.price}</span>
              <span style="font-size:13px; color:#6B7280; font-weight:500;">{lang === 'de' ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-see-btn"
              style="display:block; text-align:center; padding:12px; border-radius:12px; font-size:14px; font-weight:700; text-decoration:none; border:1px solid rgba(51,102,255,0.15); color:#1A1F36; background:white;">
              {t.pricing.ctaStore}
            </a>
          </div>
        </div>

        <!-- UBI Sprechfunk -->
        <div class="reveal-item catalog-card paid-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; background:white; border:1px solid rgba(51,102,255,0.10); box-shadow:0 8px 30px rgba(26,31,54,0.03);">
          <div class="paid-card-inner" style="text-align:left;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
              <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
                <div style="font-size:11px; font-weight:600; color:#6B7280; background:#F9FAFB; border:1px solid #E5E7EB; padding:3px 9px; border-radius:100px;">{t.pricing.ubiOnlyNote}</div>
              </div>
            </div>
            <div style="font-size:24px; font-weight:900; color:#1A1F36; margin-bottom:6px; letter-spacing:-0.3px;">{t.pricing.catalog3Name}</div>
            <div style="font-size:14px; color:#6B7280; margin-bottom:16px; line-height:1.5;">{t.pricing.catalog3Desc}</div>
            <div class="catalog-content">
              <div class="stat-grid">
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog3Questions}</div>
                  <div class="stat-label">{t.pricing.questionsUnit}</div>
                </div>
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog3Themes}</div>
                  <div class="stat-label">{t.pricing.themesUnit}</div>
                </div>
              </div>
              <div class="catalog-highlight">
                <Icon name="check" size={14} stroke="#3366FF" strokeWidth={2.5} />
                <span>{t.pricing.catalog3Highlight}</span>
              </div>
            </div>
            <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-bottom:20px;">
              <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.ubiPrice}</span>
              <span style="font-size:13px; color:#6B7280; font-weight:500;">{lang === 'de' ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-see-btn"
              style="display:block; text-align:center; padding:12px; border-radius:12px; font-size:14px; font-weight:700; text-decoration:none; border:1px solid rgba(51,102,255,0.15); color:#1A1F36; background:white;">
              {t.pricing.ctaStore}
            </a>
          </div>
        </div>

        <!-- SRC Seefunk -->
        <div class="reveal-item catalog-card paid-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; background:white; border:1px solid rgba(51,102,255,0.10); box-shadow:0 8px 30px rgba(26,31,54,0.03);">
          <div class="paid-card-inner" style="text-align:left;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
              <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
                <div style="font-size:11px; font-weight:600; color:#6B7280; background:#F9FAFB; border:1px solid #E5E7EB; padding:3px 9px; border-radius:100px;">{t.pricing.ubiOnlyNote}</div>
              </div>
            </div>
            <div style="font-size:24px; font-weight:900; color:#1A1F36; margin-bottom:6px; letter-spacing:-0.3px;">{t.pricing.srcName}</div>
            <div style="font-size:14px; color:#6B7280; margin-bottom:16px; line-height:1.5;">{t.pricing.srcDesc}</div>
            <div class="catalog-content">
              <div class="stat-grid">
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.srcQuestions}</div>
                  <div class="stat-label">{t.pricing.questionsUnit}</div>
                </div>
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.srcThemes}</div>
                  <div class="stat-label">{t.pricing.themesUnit}</div>
                </div>
              </div>
              <div class="catalog-highlight">
                <Icon name="check" size={14} stroke="#3366FF" strokeWidth={2.5} />
                <span>{t.pricing.srcHighlight}</span>
              </div>
            </div>
            <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-bottom:20px;">
              <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.srcPrice}</span>
              <span style="font-size:13px; color:#6B7280; font-weight:500;">{lang === 'de' ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-see-btn"
              style="display:block; text-align:center; padding:12px; border-radius:12px; font-size:14px; font-weight:700; text-decoration:none; border:1px solid rgba(51,102,255,0.15); color:#1A1F36; background:white;">
              {t.pricing.ctaStore}
            </a>
          </div>
        </div>

        <!-- LRC Seefunk -->
        <div class="reveal-item catalog-card paid-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; background:white; border:1px solid rgba(51,102,255,0.10); box-shadow:0 8px 30px rgba(26,31,54,0.03);">
          <div class="paid-card-inner" style="text-align:left;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
              <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
                <div style="font-size:11px; font-weight:600; color:#6B7280; background:#F9FAFB; border:1px solid #E5E7EB; padding:3px 9px; border-radius:100px;">{t.pricing.ubiOnlyNote}</div>
              </div>
            </div>
            <div style="font-size:24px; font-weight:900; color:#1A1F36; margin-bottom:6px; letter-spacing:-0.3px;">{t.pricing.lrcName}</div>
            <div style="font-size:14px; color:#6B7280; margin-bottom:16px; line-height:1.5;">{t.pricing.lrcDesc}</div>
            <div class="catalog-content">
              <div class="stat-grid">
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.lrcQuestions}</div>
                  <div class="stat-label">{t.pricing.questionsUnit}</div>
                </div>
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.lrcThemes}</div>
                  <div class="stat-label">{t.pricing.themesUnit}</div>
                </div>
              </div>
              <div class="catalog-highlight">
                <Icon name="check" size={14} stroke="#3366FF" strokeWidth={2.5} />
                <span>{t.pricing.lrcHighlight}</span>
              </div>
            </div>
            <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-bottom:20px;">
              <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.lrcPrice}</span>
              <span style="font-size:13px; color:#6B7280; font-weight:500;">{lang === 'de' ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-see-btn"
              style="display:block; text-align:center; padding:12px; border-radius:12px; font-size:14px; font-weight:700; text-decoration:none; border:1px solid rgba(51,102,255,0.15); color:#1A1F36; background:white;">
              {t.pricing.ctaStore}
            </a>
          </div>
        </div>

      </div>

      <!-- Coming Soon – compact full-width bar -->
      <div class="reveal-item soon-bar" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div style="font-size:11px; font-weight:700; color:#6B7280; text-transform:uppercase; letter-spacing:1px; flex-shrink:0;">{t.pricing.soonLabel}</div>
        <div class="soon-items">
          {soonItems.map(item => (
            <div style="display:flex; align-items:center; gap:8px;">
              <span class="plus-circle">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 1.5V6.5M1.5 4H6.5" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
              <span style="font-size:14px; font-weight:500; color:#6B7280;">{item}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Komplett-Paket / Bundle -->
    <div class="reveal-item bundle-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
      <!-- Orb -->
      <div style="position:absolute; top:-50px; left:-50px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,0.12),transparent 70%); pointer-events:none;"></div>

      <div class="bundle-inner">
        <div style="text-align:left;">
          <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.18); color:white; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:4px 12px; border-radius:100px; margin-bottom:14px;">
            {t.pricing.bundleLabel}
          </div>
          <div style="font-size:26px; font-weight:900; color:white; letter-spacing:-0.5px; margin-bottom:4px;">{t.pricing.bundleName}</div>
          <div style="font-size:14px; color:rgba(255,255,255,0.75);">{t.pricing.bundleDesc}</div>
        </div>

        <div class="bundle-action">
          <div style="display:flex; flex-direction:column; align-items:flex-end; line-height:1;">
            <span style="font-size:38px; font-weight:900; color:white; letter-spacing:-1.5px; white-space:nowrap;">{t.pricing.bundlePrice}</span>
            <span style="margin-top:8px; background:rgba(255,255,255,0.2); color:white; font-size:12px; font-weight:700; padding:4px 12px; border-radius:100px; white-space:nowrap;">{t.pricing.bundleSave}</span>
          </div>
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
            class="cta-white-btn"
            style="display:block; text-align:center; padding:14px 24px; border-radius:14px; font-size:15px; font-weight:700; text-decoration:none; background:white; color:#3366FF; box-shadow:0 8px 24px rgba(0,0,0,0.18); white-space:nowrap;">
            {t.pricing.bundleCta} →
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .catalog-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
  }
  .paid-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .catalog-card {
    border-radius: 24px;
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  /* Paid catalog cards: equal height, prices + CTA aligned at the bottom */
  .paid-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .paid-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .paid-card .price-row {
    margin-top: auto;
  }
  /* Coming soon – compact full-width bar */
  .soon-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    background: white;
    border: 1px solid rgba(51,102,255,0.06);
    border-radius: 20px;
    padding: 18px 24px;
    box-shadow: 0 8px 30px rgba(26,31,54,0.02);
  }
  .soon-items {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  /* Hero stats (SBF Binnen) – translucent pills on the blue card */
  .hero-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 13px;
    color: rgba(255,255,255,0.85);
  }
  .hero-stat strong {
    font-size: 16px;
    font-weight: 900;
    color: white;
    letter-spacing: -0.5px;
  }
  /* Free vs Paid – zentrale Gegenüberstellung des Modells vor den Lizenz-Karten */
  .compare-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(26,31,54,0.03);
    text-align: left;
  }
  .compare-col {
    padding: 26px 28px;
  }
  .compare-paid {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #3366FF 0%, #1A44D4 100%);
  }
  .compare-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    background: rgba(255,255,255,0.20);
    color: white;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: 100px;
  }
  .compare-head {
    margin-bottom: 18px;
  }
  .compare-label {
    display: block;
    font-size: 19px;
    font-weight: 900;
    letter-spacing: -0.4px;
  }
  .compare-free .compare-label { color: #1A1F36; }
