---
import { useTranslations } from '../i18n/index';
import Icon from './Icon.astro';
import type { IconName } from '../icons';

interface Props {
  lang: 'de' | 'en';
  // Startseite: zeigt das zusammengeführte Redesign (Header mit Aktualitätsgarantie,
  // SBF-Karten mit "gültig seit"-Stempel, kompakte Funkscheine, Katalog-Hinweis,
  // Enthalten-Leiste, Trust-Leiste). Ohne den Prop (Lizenz-Seiten) bleibt das
  // bisherige, schlanke Preis-Layout unverändert.
  withGuarantee?: boolean;
}

const { lang, withGuarantee = false } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

const soonItems = [t.pricing.soon1];

// Daten für das Redesign (Startseite). "gültig seit"-Stempel + Katalog-Bezeichnung
// kommen aus catalogSources (amtliche Quelle) – nichts doppelt gepflegt.
const cs = t.catalogSources;
const sbfCards = [
  {
    name: t.pricing.catalog1Name, icon: 'waves' as IconName,
    stamp: cs.binnenStand, cat: cs.binnenCat,
    questions: t.pricing.catalog1Questions, themes: t.pricing.catalog1Themes,
  },
  {
    name: t.pricing.catalog2Name, icon: 'anchor' as IconName,
    stamp: cs.seeStand, cat: cs.seeCat,
    questions: t.pricing.catalog2Questions, themes: t.pricing.catalog2Themes,
  },
];
const funkCards = [
  { abbr: 'SRC', name: de ? 'Seefunk (Küste)' : 'Sea radio (coastal)', stamp: cs.srcStand, next: null as string | null, price: t.pricing.srcPrice, url: de ? '/src/' : '/en/src/', icon: 'satellite' as IconName },
  { abbr: 'LRC', name: de ? 'Seefunk (weltweit)' : 'Sea radio (worldwide)', stamp: cs.lrcStand, next: null as string | null, price: t.pricing.lrcPrice, url: de ? '/lrc/' : '/en/lrc/', icon: 'globe' as IconName },
  { abbr: 'UBI', name: de ? 'UKW-Sprechfunk Binnen' : 'VHF radio, inland', stamp: cs.ubiStand, next: cs.ubiNext, price: t.pricing.ubiPrice, url: de ? '/ubi/' : '/en/ubi/', icon: 'wifi' as IconName },
];
---

<section id="pricing" class="section-band px-6 py-14 md:py-20" style="text-align:center;">
  <div class="max-w-6xl mx-auto">
  {withGuarantee ? (
    <div class="pv2-inner">

      <!-- Header: eine Aussage im Fließtext (Aktualität steht dort, keine Doppelung) -->
      <div class="reveal-item pv2-header" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="pv2-header-main">
          <span class="pv2-chip">{t.pricing.v2Chip}</span>
          <h2 class="section-display-title pv2-title">{t.pricing.v2Title}</h2>
          <p class="pv2-subtitle">{t.pricing.v2Subtitle}</p>
        </div>
      </div>

      <!-- SBF-Karten -->
      <div class="reveal-item pv2-subheading" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">{t.pricing.sbfHeading}</div>
      <div class="pv2-cards">
        {sbfCards.map(card => (
          <div class="reveal-item pv2-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
            <div class="pv2-card-top">
              <span class="pv2-tile"><Icon name={card.icon} size={24} stroke="#3366FF" strokeWidth={1.75} /></span>
              <div class="pv2-card-heading">
                <div class="pv2-card-name">{card.name}</div>
                <span class="pv2-stamp">{card.stamp}</span>
              </div>
            </div>
            <div class="pv2-card-cat">{card.cat}</div>
            <div class="pv2-card-stats">
              <span class="pv2-statline"><Icon name="document" size={15} stroke="#3366FF" strokeWidth={2} /><strong>{card.questions}</strong> {t.pricing.questionsUnit}</span>
              <span class="pv2-statline"><Icon name="clipboard" size={15} stroke="#3366FF" strokeWidth={2} /><strong>{card.themes}</strong> {t.pricing.themesUnit}</span>
            </div>
            <div class="pv2-price">
              <span class="pv2-price-num">{t.pricing.price}</span>
              <span class="pv2-price-sub">{de ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <ul class="pv2-features">
              {t.pricing.cardFeatures.map(f => (
                <li><span class="pv2-check"><Icon name="check" size={12} stroke="#3366FF" strokeWidth={3} /></span>{f}</li>
              ))}
            </ul>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="pv2-cta cta-white-btn">{t.pricing.ctaFree} →</a>
          </div>
        ))}

        <!-- Bundle (hervorgehoben) -->
        <div class="reveal-item pv2-card pv2-card-bundle" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
          <span class="pv2-popular">★ {t.pricing.popular}</span>
          <div class="pv2-card-top">
            <span class="pv2-tile"><Icon name="scale" size={24} stroke="#3366FF" strokeWidth={1.75} /></span>
            <div class="pv2-card-heading">
              <div class="pv2-card-name">{t.pricing.bundleName}</div>
              <span class="pv2-stamp pv2-stamp-blue">{de ? 'Binnen + See' : 'Inland + Coastal'}</span>
            </div>
          </div>
          <div class="pv2-card-cat">{t.pricing.bundleInclusive}</div>
          <div class="pv2-card-stats">
            <span class="pv2-statline"><Icon name="document" size={15} stroke="#3366FF" strokeWidth={2} /><strong>{de ? 'Alle' : 'All'}</strong> {t.pricing.questionsUnit}</span>
            <span class="pv2-statline"><Icon name="clipboard" size={15} stroke="#3366FF" strokeWidth={2} /><strong>{de ? 'Alle' : 'All'}</strong> {t.pricing.themesUnit}</span>
          </div>
          <div class="pv2-price">
            <span class="pv2-price-num">{t.pricing.bundlePrice}</span>
            <span class="pv2-save">{t.pricing.bundleSave}</span>
          </div>
          <ul class="pv2-features">
            {t.pricing.bundleFeatures.map(f => (
              <li><span class="pv2-check pv2-check-bundle"><Icon name="check" size={12} stroke="#3366FF" strokeWidth={3} /></span>{f}</li>
            ))}
          </ul>
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="pv2-cta pv2-cta-bundle cta-white-btn">{t.pricing.ctaFree} →</a>
        </div>
      </div>

      <!-- Funkscheine (kompakt) -->
      <div class="reveal-item pv2-funk" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="pv2-subheading" style="margin-bottom:6px;">{t.pricing.funkHeading}</div>
        <p class="pv2-funk-sub">{t.pricing.funkSubtitle}</p>
        <div class="pv2-funk-grid">
          {funkCards.map(f => (
            <a href={f.url} class="pv2-funk-card">
              <div class="pv2-funk-top">
                <span class="pv2-tile pv2-tile-sm"><Icon name={f.icon} size={18} stroke="#3366FF" strokeWidth={1.75} /></span>
                <span class="pv2-funk-abbr">{f.abbr}</span>
              </div>
              <div class="pv2-funk-stamps">
                <span class="pv2-stamp pv2-stamp-sm">{f.stamp}</span>
                {f.next && <span class="pv2-stamp pv2-stamp-sm pv2-stamp-amber">{f.next}</span>}
              </div>
              <div class="pv2-funk-name">{f.name}</div>
              <div class="pv2-funk-bottom">
                <span class="pv2-funk-price">{f.price}</span>
                <span class="pv2-funk-more">{t.pricing.funkMore} →</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Katalog-Hinweis + offizielle Quelle -->
      <div class="reveal-item pv2-note" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="pv2-note-col">
          <span class="pv2-note-icon"><Icon name="question" size={17} stroke="#3366FF" strokeWidth={2} /></span>
          <div>
            <div class="pv2-note-title">{t.pricing.noteTitle}</div>
            <p class="pv2-note-text">{cs.validityNote}</p>
          </div>
        </div>
        <div class="pv2-note-col pv2-note-source">
          <span class="pv2-note-icon"><Icon name="document" size={17} stroke="#3366FF" strokeWidth={2} /></span>
          <div>
            <div class="pv2-note-title">{t.pricing.sourceTitle}</div>
            <p class="pv2-note-text">{cs.issuerNote}</p>
          </div>
        </div>
      </div>

      <!-- In jeder Lizenz enthalten + Trust-Leiste -->
      <div class="guarantee-wrap">
        <div class="reveal-item incl-strip" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
          <div class="incl-title">{t.pricing.includedTitle}</div>
          <div class="incl-grid">
            {t.pricing.included.map(it => (
              <div class="incl-item">
                <span class="incl-icon"><Icon name={it.icon as IconName} size={18} stroke="#3366FF" strokeWidth={2} /></span>
                <span class="incl-text">
                  <span class="incl-label">{it.label}</span>
                  <span class="incl-sub">{it.sub}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  ) : (
    <Fragment>

    <!-- Header -->
    <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; margin-bottom:56px;">
      <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
        {t.pricing.chip}
      </div>
      <h2 class="section-display-title" style="margin-bottom:14px; max-width:640px; margin-left:auto; margin-right:auto;">{t.pricing.title}</h2>
      <p style="font-size:16px; color:#656B78; max-width:520px; margin:0 auto;">{t.pricing.subtitle}</p>
    </div>

    <div class="catalog-stack">

      <!-- Free vs Paid: Geschäftsmodell einmal zentral vor den Lizenz-Karten gegenüberstellen -->
      <div class="reveal-item compare-bar" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <!-- Free -->
        <div class="compare-col compare-free">
          <div class="compare-head">
            <span class="compare-label">{t.pricing.freeLabel}</span>
            <span class="compare-sub">{t.pricing.compareFreeSub}</span>
          </div>
          <div class="compare-features">
            {t.pricing.freeFeatures.map(f => (
              <div class="compare-feature">
                <span class="compare-check compare-check-free">
                  <Icon name="check" size={11} stroke="#3366FF" strokeWidth={2.5} />
                </span>
                <span>{f}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Paid -->
        <div class="compare-col compare-paid">
          <div class="compare-badge">{t.pricing.comparePaidBadge}</div>
          <!-- Orb -->
          <div style="position:absolute; top:-50px; right:-50px; width:160px; height:160px; border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,0.15),transparent 70%); pointer-events:none;"></div>
          <div class="compare-head" style="position:relative;">
            <span class="compare-label">{t.pricing.comparePaidLabel}</span>
            <span class="compare-sub">{t.pricing.comparePaidSub}</span>
          </div>
          <div class="compare-features" style="position:relative;">
            {t.pricing.comparePaidFeatures.map(f => (
              <div class="compare-feature">
                <span class="compare-check compare-check-paid">
                  <Icon name="check" size={11} stroke="white" strokeWidth={2.5} />
                </span>
                <span>{f}</span>
              </div>
            ))}
          </div>
          <div class="compare-price">{t.pricing.comparePaidPrice}</div>
        </div>
      </div>

      <!-- SBF Binnen – Freemium card (full width). -->
      <div class="reveal-item catalog-card featured" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div style="text-align:left; position:relative;">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
            <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
          </div>

          <div style="font-size:32px; font-weight:900; color:#1A1F36; letter-spacing:-0.5px; margin-bottom:4px;">{t.pricing.catalog1Name}</div>
          <div style="font-size:14px; color:#656B78; margin-bottom:18px;">{t.pricing.catalog1Tagline}</div>

          <div style="display:flex; gap:8px; margin-bottom:10px;">
            <span class="hero-stat"><strong>{t.pricing.catalog1Questions}</strong> {t.pricing.questionsUnit}</span>
            <span class="hero-stat"><strong>{t.pricing.catalog1Themes}</strong> {t.pricing.themesUnit}</span>
          </div>
          <div style="display:flex; align-items:center; gap:7px; margin-bottom:4px;">
            <Icon name="check" size={13} stroke="#3366FF" strokeWidth={2.5} />
            <span style="font-size:12.5px; color:#656B78;">{t.pricing.catalog1Note}</span>
          </div>

          <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-top:24px;">
            <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.price}</span>
            <span style="font-size:13px; color:#656B78; font-weight:500;">{de ? 'Einmalkauf' : 'one-time'}</span>
          </div>

          <div style="margin-top:16px;">
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-white-btn"
              style="display:block; text-align:center; padding:14px; border-radius:14px; font-size:15px; font-weight:700; text-decoration:none; background:#3366FF; color:white; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
              {t.pricing.ctaFree} →
            </a>
          </div>
        </div>
      </div>

      <!-- Paid catalogs row: SBF See + Weitere Lizenzen -->
      <div class="paid-grid">

        <!-- SBF See -->
        <div class="reveal-item catalog-card paid-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; background:white; border:1px solid rgba(51,102,255,0.10); box-shadow:0 8px 30px rgba(26,31,54,0.03);">
          <div class="paid-card-inner" style="text-align:left;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
              <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px;">{t.pricing.available}</div>
              <div style="font-size:11px; font-weight:600; color:#059669; background:#ECFDF5; border:1px solid #A7F3D0; padding:3px 9px; border-radius:100px;">{t.pricing.freeTrialNote}</div>
            </div>
            <div style="font-size:24px; font-weight:900; color:#1A1F36; margin-bottom:6px; letter-spacing:-0.3px;">{t.pricing.catalog2Name}</div>
            <div style="font-size:14px; color:#656B78; margin-bottom:16px; line-height:1.5;">{t.pricing.catalog2Desc}</div>
            <div class="catalog-content">
              <div class="stat-grid">
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog2Questions}</div>
                  <div class="stat-label">{t.pricing.questionsUnit}</div>
                </div>
                <div class="stat-box">
                  <div class="stat-num">{t.pricing.catalog2Themes}</div>
                  <div class="stat-label">{t.pricing.themesUnit}</div>
                </div>
              </div>
              <div class="catalog-highlight">
                <Icon name="check" size={14} stroke="#3366FF" strokeWidth={2.5} />
                <span>{t.pricing.catalog2Highlight}</span>
              </div>
              <div class="catalog-note">{t.pricing.catalog2Note}</div>
            </div>
            <div class="price-row" style="display:flex; align-items:baseline; gap:6px; margin-bottom:20px;">
              <span style="font-size:36px; font-weight:900; color:#1A1F36; letter-spacing:-1.5px;">{t.pricing.price}</span>
              <span style="font-size:13px; color:#656B78; font-weight:500;">{de ? 'Einmalkauf' : 'one-time'}</span>
            </div>
            <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
              class="cta-white-btn"
              style="display:block; text-align:center; padding:14px; border-radius:12px; font-size:15px; font-weight:700; text-decoration:none; background:#3366FF; color:white; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
              {t.pricing.ctaFree} →
            </a>
          </div>
        </div>

        <!-- Weitere Funk-Lizenzen (UBI · SRC · LRC) -->
        <a href={de ? '/fuehrerscheine/' : '/en/licenses/'}
          class="reveal-item catalog-card paid-card licenses-link-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
          <div class="paid-card-inner" style="text-align:left; justify-content:space-between;">
            <div style="font-size:11px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;">{de ? 'Weitere Lizenzen' : 'More licenses'}</div>
            <div class="licenses-list">
              <div class="license-row">
                <div class="license-row-left">
                  <span class="license-abbr">UBI</span>
                  <span class="license-name">{de ? 'Sprechfunk' : 'VHF radio'}</span>
                </div>
                <span class="license-price">{t.pricing.ubiPrice}</span>
              </div>
              <div class="license-row">
                <div class="license-row-left">
                  <span class="license-abbr">SRC</span>
                  <span class="license-name">{de ? 'Seefunk (Küste)' : 'Sea radio (coastal)'}</span>
                </div>
                <span class="license-price">{t.pricing.srcPrice}</span>
              </div>
              <div class="license-row">
                <div class="license-row-left">
                  <span class="license-abbr">LRC</span>
                  <span class="license-name">{de ? 'Seefunk (weltweit)' : 'Sea radio (worldwide)'}</span>
                </div>
                <span class="license-price">{t.pricing.lrcPrice}</span>
              </div>
            </div>
            <span class="licenses-link-cta" style="margin-top:auto;">{de ? 'Alle Lizenzen ansehen' : 'View all licenses'} →</span>
          </div>
        </a>

      </div>

      <!-- Coming Soon – compact full-width bar -->
      <div class="reveal-item soon-bar" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div style="font-size:11px; font-weight:700; color:#656B78; text-transform:uppercase; letter-spacing:1px; flex-shrink:0;">{t.pricing.soonLabel}</div>
        <div class="soon-items">
          {soonItems.map(item => (
            <div style="display:flex; align-items:center; gap:8px;">
              <span class="plus-circle">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 1.5V6.5M1.5 4H6.5" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
              <span style="font-size:14px; font-weight:500; color:#656B78;">{item}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Komplett-Paket / Bundle -->
    <div class="reveal-item bundle-card" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
      <div style="position:absolute; top:-50px; left:-50px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,0.12),transparent 70%); pointer-events:none;"></div>

      <div class="bundle-inner">
        <div style="text-align:left;">
          <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.18); color:white; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:4px 12px; border-radius:100px; margin-bottom:14px;">
            {t.pricing.bundleLabel}
          </div>
          <div style="font-size:26px; font-weight:900; color:white; letter-spacing:-0.5px; margin-bottom:4px;">{t.pricing.bundleName}</div>
          <div style="font-size:14px; color:rgba(255,255,255,0.75);">{t.pricing.bundleDesc}</div>
        </div>

        <div class="bundle-action">
          <div class="bundle-price-block" style="display:flex; flex-direction:column; align-items:flex-end; line-height:1;">
            <span style="font-size:38px; font-weight:900; color:white; letter-spacing:-1.5px; white-space:nowrap;">{t.pricing.bundlePrice}</span>
            <span style="margin-top:8px; background:rgba(255,255,255,0.2); color:white; font-size:12px; font-weight:700; padding:4px 12px; border-radius:100px; white-space:nowrap;">{t.pricing.bundleSave}</span>
          </div>
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
            class="cta-white-btn"
            style="display:block; text-align:center; padding:14px 24px; border-radius:14px; font-size:15px; font-weight:700; text-decoration:none; background:white; color:#3366FF; box-shadow:0 8px 24px rgba(0,0,0,0.18); white-space:nowrap;">
            {t.pricing.ctaFree} →
          </a>
        </div>
      </div>
    </div>

    </Fragment>
  )}
  </div>
</section>

<style>
  .catalog-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
  }
  .paid-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .catalog-card {
    border-radius: 24px;
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  .paid-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .paid-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .paid-card .price-row {
    margin-top: auto;
  }
  .licenses-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: auto;
    margin-bottom: 0;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 12px;
    overflow: hidden;
  }
  .license-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    gap: 8px;
  }
  .license-row + .license-row {
    border-top: 1px solid rgba(51,102,255,0.08);
  }
  .license-row-left {
    display: flex;
