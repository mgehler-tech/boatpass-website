---
/**
 * Preise der Startseite als Preistafel.
 *
 * Statt drei Karten mit hervorgehobener Mitte: eine Tafel mit einer Zeile je
 * Lizenz – Name, amtlicher Fragenkatalog mit gültiger Fassung und direkter
 * ELWIS-Quelle, Preis. So steht der Beleg („womit du lernst, kannst du
 * nachprüfen") direkt neben dem Preis, statt in einem eigenen Block.
 *
 * Katalog-Bezeichnungen und Fassungen kommen aus `catalogSources`, die Links
 * aus `data/catalogs.ts` – dieselben Quellen wie auf den Lizenzseiten.
 */
import { useTranslations } from '../i18n/index';
import { CATALOG_URLS, type LicenseKey } from '../data/catalogs';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';
const p = t.pricing;
const cs = t.catalogSources;
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

// "Stand dieser Übersicht" wird beim Build aus dem aktuellen Datum gesetzt –
// so ist die Angabe bei jedem Deploy ehrlich aktuell (wie in CatalogSources).
const now = new Date();
const months = de
  ? ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember']
  : ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const pageStand = `${months[now.getMonth()]} ${now.getFullYear()}`;

interface Row {
  key?: LicenseKey;
  name: string;
  sub: string;
  catalog?: string;
  stand?: string;
  next?: string;
  price: string;
  priceNote: string;
  strike?: string;
  save?: string;
  popular?: boolean;
  url?: string;
  more?: string;
}

const sbfRows: Row[] = [
  { key: 'binnen', name: p.catalog1Name, sub: `${p.catalog1Questions} ${p.questionsUnit}`, catalog: cs.binnenCat, stand: cs.binnenStand, price: p.price, priceNote: p.priceNote, url: de ? '/sbf-binnen/' : '/en/sbf-inland/', more: p.detailsLink },
  { key: 'see', name: p.catalog2Name, sub: `${p.catalog2Questions} ${p.questionsUnit}`, catalog: cs.seeCat, stand: cs.seeStand, price: p.price, priceNote: p.priceNote, url: de ? '/sbf-see/' : '/en/sbf-coastal/', more: p.detailsLink },
  { name: de ? 'Binnen + See' : 'Inland + Coastal', sub: p.bundleTagline, price: p.bundlePrice, priceNote: p.priceNote, strike: p.bundleStrike, save: p.bundleSave, popular: true },
];
const funkRows: Row[] = [
  { key: 'src', name: 'SRC', sub: de ? 'Seefunk (Küste)' : 'Sea radio (coastal)', catalog: cs.srcCat, stand: cs.srcStand, price: p.srcPrice, priceNote: de ? 'einmalig' : 'one-time', url: de ? '/src/' : '/en/src/', more: p.funkMore },
  { key: 'ubi', name: 'UBI', sub: de ? 'Binnenfunk' : 'Inland radio', catalog: cs.ubiCat, stand: cs.ubiStand, next: cs.ubiNext, price: p.ubiPrice, priceNote: de ? 'einmalig' : 'one-time', url: de ? '/ubi/' : '/en/ubi/', more: p.funkMore },
  { key: 'lrc', name: 'LRC', sub: de ? 'Seefunk (weltweit)' : 'Sea radio (worldwide)', catalog: cs.lrcCat, stand: cs.lrcStand, price: p.lrcPrice, priceNote: de ? 'einmalig' : 'one-time', url: de ? '/lrc/' : '/en/lrc/', more: p.funkMore },
];
const groups = [
  { title: p.sbfHeading, note: null as string | null, rows: sbfRows },
  { title: p.funkHeading, note: p.funkSubtitle, rows: funkRows },
];
const cols = de
  ? { license: 'Lizenz', catalog: cs.colCatalog, price: 'Preis' }
  : { license: 'Licence', catalog: cs.colCatalog, price: 'Price' };
---

<section id="pricing" class="pr">
  <div class="pr-inner">
    <header class="pr-head">
      <p class="pr-label">{p.v2Chip}</p>
      <h2 class="display pr-title">{p.v2Title}</h2>
      <div class="pr-intro">
        <p>{p.v2Subtitle}</p>
        <p class="pr-free">{p.subtitle}</p>
      </div>
    </header>

    <div class="pr-board">
      <div class="pr-cols" aria-hidden="true">
        <span>{cols.license}</span>
        <span>{cols.catalog}</span>
        <span class="pr-cols-price">{cols.price}</span>
      </div>

      {groups.map(g => (
        <div class="pr-group">
          <h3 class="pr-group-title">
            {g.title}
            {g.note && <span class="pr-group-note">{g.note}</span>}
          </h3>
          <ul class="pr-rows">
            {g.rows.map(r => (
              <li class:list={['pr-row', { 'pr-row--popular': r.popular }]}>
                <div class="pr-name">
                  <span class="pr-name-main">{r.name}</span>
                  {r.popular && <span class="pr-popular">{p.popular}</span>}
                  <span class="pr-name-sub">{r.sub}</span>
                </div>
                <div class="pr-cat">
                  {r.catalog ? (
                    <>
                      <span class="pr-cat-name">{r.catalog}</span>
                      <span class="pr-cat-meta">
                        <span class="pr-stand">{r.stand}</span>
                        {r.next && <span class="pr-stand pr-stand--next">{r.next}</span>}
                        {r.key && (
                          <a class="pr-src" href={CATALOG_URLS[r.key]} target="_blank" rel="noopener nofollow">
                            {cs.sourceCta}&nbsp;↗
                          </a>
                        )}
                      </span>
                    </>
                  ) : (
                    <span class="pr-cat-name">{p.bundleInclusive}</span>
                  )}
                </div>
                <div class="pr-price">
                  <span class="pr-price-num num">{r.price}</span>
                  <span class="pr-price-note">
                    {r.strike && <s class="pr-strike">{r.strike}</s>}
                    {r.save ? <span class="pr-save">{r.save}</span> : r.priceNote}
                  </span>
                  {r.url && <a class="pr-more" href={r.url}>{r.more} <span aria-hidden="true">→</span></a>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pr-foot">
      <div class="pr-cta-block">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="pr-cta">{p.ctaFree} <span aria-hidden="true">→</span></a>
        <p class="pr-cta-note">{p.compareFreeSub} · {p.comparePaidSub}</p>
      </div>
      <div class="pr-included">
        <p class="pr-included-title">{de ? 'Enthalten in SBF Binnen und SBF See' : 'Included in SBF Binnen and SBF See'}</p>
        <ul>
          {p.cardFeatures.slice(0, 3).map(f => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <div class="pr-notes">
      <p><strong>{p.noteTitle}.</strong> {cs.validityNote}</p>
      <p><strong>{p.sourceTitle}.</strong> {cs.issuerNote}</p>
      <p class="pr-notes-stand"><strong>{cs.pageStandLabel}:</strong> {pageStand} · {cs.disclaimer}</p>
    </div>
  </div>
</section>

<style>
  .pr { color: var(--ink); border-top: 1px solid var(--ink); }
  .pr-inner { max-width: 1200px; margin-inline: auto; padding: 72px 24px 64px; }

  .pr-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .pr-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem); margin-bottom: 18px; }
  .pr-intro { display: grid; gap: 10px; max-width: 40em; font-size: 16.5px; line-height: 1.55; color: var(--ink-2); }
  .pr-free { color: var(--ink); font-weight: 600; }
  .pr-head { margin-bottom: 40px; }

  /* Tafel: kräftige Kopflinie, Gruppen mit Zwischenüberschrift, Zeilen mit
     Haarlinien. Spalten auf Desktop per Grid, auf dem Handy gestapelt. */
  .pr-board { border-top: 2px solid var(--ink); }
  .pr-cols { display: none; }
  .pr-group-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding: 14px 0 12px;
    border-bottom: 1px solid var(--ink);
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pr-group + .pr-group .pr-group-title { margin-top: 28px; }
  .pr-group-note { font-size: 14px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--ink-2); font-style: italic; }

  .pr-rows { list-style: none; margin: 0; padding: 0; }
  .pr-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "name price" "cat cat";
    gap: 10px 20px;
    padding: 18px 0 18px;
    border-bottom: 1px solid var(--rule-2);
  }
  .pr-name { grid-area: name; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .pr-name-main { font-size: 26px; font-weight: 760; font-stretch: 80%; line-height: 1; }
  .pr-name-sub { flex-basis: 100%; font-size: 14.5px; color: var(--ink-2); }
  .pr-popular {
    font-size: 11.5px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  /* Beliebteste Zeile: Textmarker-Grund statt Plakette. */
  .pr-row--popular {
    background: color-mix(in srgb, var(--land) 55%, transparent);
    margin-inline: -12px;
    padding-inline: 12px;
  }

  .pr-cat { grid-area: cat; display: flex; flex-direction: column; gap: 6px; font-size: 14.5px; }
  .pr-cat-name { color: var(--ink); line-height: 1.4; }
  .pr-cat-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  .pr-stand {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--starboard);
    white-space: nowrap;
  }
  .pr-stand::before { content: "● "; font-size: 9px; vertical-align: 1px; }
  .pr-stand--next { color: #9A5B00; }
  :global(html.dark) .pr-stand--next { color: #F2B544; }
  .pr-src {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 13px;
    font-weight: 650;
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .pr-price { grid-area: price; display: flex; flex-direction: column; align-items: flex-end; text-align: right; gap: 3px; }
  .pr-price-num { font-size: 30px; font-weight: 780; font-stretch: 78%; line-height: 1; white-space: nowrap; }
  .pr-price-note { font-size: 12.5px; color: var(--ink-2); display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0 8px; }
  .pr-strike { color: var(--ink-2); }
  .pr-save { font-weight: 700; color: var(--starboard); }
  .pr-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
    font-size: 13.5px;
    font-weight: 650;
    color: var(--link);
    white-space: nowrap;
  }
  .pr-more:hover, .pr-src:hover { text-decoration-thickness: 2px; text-decoration: underline; }

  .pr-foot { display: grid; gap: 28px; margin-top: 36px; }
  .pr-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 26px;
    border-radius: 8px;
    background: var(--action);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .pr-cta:hover { background: var(--action-hover); }
  .pr-cta-note { margin-top: 10px; font-size: 14px; color: var(--ink-2); }

  .pr-included-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  .pr-included ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; }
  .pr-included li { display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 600; }
  .pr-included li::before {
    content: "";
    width: 10px;
    height: 6px;
    margin-top: -3px;
    border-left: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(-45deg);
    flex-shrink: 0;
  }

  .pr-notes {
    margin-top: 44px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-2);
    display: grid;
    gap: 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62em;
  }
  .pr-notes strong { color: var(--ink); font-weight: 650; }

  @media (min-width: 900px) {
    .pr-inner { padding: 104px 40px 88px; }
    .pr-head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 64px; align-items: end; margin-bottom: 56px; }
    .pr-label { grid-column: 1 / -1; }
    .pr-title { margin-bottom: 0; }

    .pr-cols {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      gap: 32px;
      padding: 10px 0;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-2);
    }
    .pr-cols-price { text-align: right; }
    .pr-row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      grid-template-areas: "name cat price";
      gap: 32px;
      align-items: start;
      padding: 22px 0;
    }
    .pr-row--popular { margin-inline: -16px; padding-inline: 16px; }
    .pr-name-main { font-size: 30px; }
    .pr-price-num { font-size: 36px; }

    .pr-foot { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: 64px; }
  }
</style>
