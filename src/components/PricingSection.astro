    .pv2-funk-sub { margin: 0; }
  }

  @media (max-width: 940px) {
    .pv2-cards { grid-template-columns: 1fr; max-width: 460px; margin-left: auto; margin-right: auto; }
    /* Bis 768px greift .snap-row aus global.css und macht daraus eine
       Wisch-Reihe – die Zentrierung würde sie dort einschnüren. display und
       gap müssen lokal stehen, weil der komponentenlokale Selektor durch
       Astros data-astro-cid spezifischer ist als die globale Utility-Klasse. */
    @media (max-width: 768px) {
      .pv2-cards {
        display: flex;
        gap: 14px;
        max-width: none;
        margin-left: 0;
        margin-right: 0;
      }
    }
    .pv2-note { grid-template-columns: 1fr; }
    .pv2-note-source { border-left: none; padding-left: 0; border-top: 1px solid rgba(51,102,255,0.12); padding-top: 16px; }
    html.dark .pv2-note-source { border-top-color: rgba(90,120,255,0.14) !important; }
  }
  @media (max-width: 640px) {
    .pv2-funk-grid { grid-template-columns: 1fr; }
  }

  /* Funkscheine als Wisch-Reihe, gleicher Umbruch wie die übrigen Reihen.
     Zwischen 641 und 768 px standen sie sonst zu dritt nebeneinander und
     damit auf rund 220 px Breite gequetscht. display und gap müssen lokal
     stehen, weil der komponentenlokale Selektor durch Astros data-astro-cid
     spezifischer ist als die globale .snap-row-Utility. */
  @media (max-width: 768px) {
    .pv2-funk-grid { display: flex; gap: 14px; }
  }
  @media (max-width: 680px) {
    .paid-grid { grid-template-columns: 1fr; }
    .bundle-inner { flex-direction: column; align-items: flex-start; }
    .bundle-action { width: 100%; flex-direction: column; align-items: stretch; gap: 18px; }
    .bundle-price-block { align-items: flex-start !important; }
    .catalog-card.featured { padding: 24px; }
    .compare-bar { grid-template-columns: 1fr; }
  }

  /* ============ Mobile-Redesign SBF (Tab-Switch statt Karussell) ============
     Nur ≤768px aktiv. Desktop (≥769px) behält unverändert das 3er-Grid mit
     Binnen-, See- und Bundle-Karte; dieser Block bleibt dort ausgeblendet. */
  .pv2-sbf-m { display: none; }

  @media (max-width: 768px) {
    /* Altes SBF-Karussell samt Punkten auf Mobile ersetzen */
    .pv2-cards { display: none !important; }
    .snap-dots[data-snap-dots="pricing"] { display: none; }

    .pv2-sbf-m { display: block; }

    /* Segmentierter Umschalter Binnen | See */
    .pv2-switch {
      display: grid; grid-template-columns: 1fr 1fr; gap: 4px;
      background: #EEF2FB; border: 1px solid rgba(51,102,255,0.12);
      border-radius: 14px; padding: 4px; margin-bottom: 16px;
    }
    .pv2-switch-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 11px 12px; border: 0; border-radius: 10px; background: transparent;
      font-size: 15px; font-weight: 700; color: #656B78; cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    }
    .pv2-switch-btn.is-active { background: #FFFFFF; color: #3366FF; box-shadow: 0 2px 8px rgba(26,31,54,0.10); }
    .pv2-switch-btn:focus-visible { outline: 2px solid #3366FF; outline-offset: 2px; }

    .pv2-sbf-card {
      text-align: left; background: #FFFFFF; border: 1px solid rgba(51,102,255,0.10);
      border-radius: 22px; padding: 24px; box-shadow: 0 8px 30px rgba(26,31,54,0.05);
    }
    .pv2-sbf-q { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #656B78; }
    .pv2-sbf-q strong { color: #1A1F36; font-weight: 800; }
    .pv2-details {
      display: flex; align-items: center; justify-content: center;
      min-height: 44px; text-align: center; margin-top: 4px;
      font-size: 14px; font-weight: 700; color: #3366FF; text-decoration: none;
    }

    /* Bundle als eigener Verkaufsplatz unter der SBF-Karte */
    .pv2-bundle-m {
      position: relative; text-align: left; margin-top: 16px;
      background: #FFFFFF; border: 1.5px solid rgba(51,102,255,0.45);
      border-radius: 22px; padding: 24px; box-shadow: 0 12px 40px rgba(51,102,255,0.14);
    }
    .pv2-bundle-icons { display: inline-flex; align-items: center; gap: 6px; }
    .pv2-plus { font-size: 16px; font-weight: 800; color: #3366FF; }
    .pv2-bundle-cat { min-height: 0; margin-bottom: 14px; }
    .pv2-bundle-price {
      display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      padding-top: 16px; border-top: 1px solid rgba(51,102,255,0.08); margin-bottom: 16px;
    }
    /* Kontrast-Fix, siehe Begründung bei der Basisregel .pv2-strike oben. */
    .pv2-strike { font-size: 14px; color: #656B78; text-decoration: line-through; }
    .pv2-save-green {
      font-size: 12.5px; font-weight: 700; color: #059669;
      background: #ECFDF5; border: 1px solid #A7F3D0; padding: 3px 10px; border-radius: 100px;
    }

    /* Dark Mode für die neuen Mobile-Elemente */
    html.dark .pv2-switch { background: #1A2140; border-color: rgba(90,120,255,0.14); }
    html.dark .pv2-switch-btn { color: #94A3B8; }
    html.dark .pv2-switch-btn.is-active { background: #242C46; color: #8BB4FF; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }
    html.dark .pv2-sbf-card,
    html.dark .pv2-bundle-m { background: #181E2E; box-shadow: 0 8px 30px rgba(0,0,0,0.25); }
    html.dark .pv2-sbf-card { border-color: rgba(90,120,255,0.14); }
    html.dark .pv2-bundle-m { border-color: rgba(90,120,255,0.5); }
    html.dark .pv2-sbf-q { color: #94A3B8; }
    html.dark .pv2-sbf-q strong { color: #E2E8F0; }
    html.dark .pv2-plus { color: #8BB4FF; }
    html.dark .pv2-strike { color: #94A3B8; }
    html.dark .pv2-save-green { background: rgba(34,197,94,0.12); border-color: rgba(34,197,94,0.3); color: #4ADE80; }
  }
</style>

<script>
  import { initSnapDots } from '../scripts/snapDots';

  initSnapDots('[data-snap-row="funk"]');

  // Mobile SBF-Tab-Switch: Binnen/See umschalten (Panels per [hidden] toggeln).
  document.querySelectorAll<HTMLElement>('.pv2-sbf-m').forEach(root => {
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.pv2-switch-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.pv2-sbf-panel'));
    if (!btns.length) return;

    const select = (idx: number) => {
      btns.forEach((b, i) => {
        const active = i === idx;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.tabIndex = active ? 0 : -1;
      });
      panels.forEach((p, i) => { p.hidden = i !== idx; });
    };

    btns.forEach((btn, i) => btn.addEventListener('click', () => select(i)));

    // Pfeiltasten für die Tabliste (ARIA-Konvention).
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const current = btns.findIndex(b => b.classList.contains('is-active'));
      const next = e.key === 'ArrowRight'
        ? (current + 1) % btns.length
        : (current - 1 + btns.length) % btns.length;
      select(next);
      btns[next].focus();
    });
  });

  const reduceMotionPricing = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotionPricing) {
    document.querySelectorAll<HTMLElement>('#pricing .reveal-item').forEach(el => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    });
  } else {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.opacity = '1';
          (e.target as HTMLElement).style.transform = 'translateY(0)';
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#pricing .reveal-item').forEach(el => obs.observe(el));
  }
</script>
