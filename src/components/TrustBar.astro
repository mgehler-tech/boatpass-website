---
import { useTranslations } from '../i18n/index';
import { getBoatpassRating } from '../data/apps';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const appRating = getBoatpassRating();
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
const ratingScoreLabel = appRating
  ? appRating.score.toFixed(1).replace('.', lang === 'de' ? ',' : '.')
  : null;

const items = [
  t.trust.catalog,
  t.trust.current,
  t.trust.oneTime,
  t.trust.languages,
];
---

<div style="padding:14px 24px;">
  <div class="max-w-6xl mx-auto trust-inner">
    {appRating && (
      <>
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="trust-rating-badge" aria-label={`${ratingScoreLabel} ★ (${appRating.ratings}) – ${lang === 'de' ? 'Bewertung bei Google Play' : 'rating on Google Play'}`}>
          <img src="/images/google-play-icon.png" alt="" width="20" height="20" aria-hidden="true" />
          <span class="trust-rating-score">{ratingScoreLabel}</span>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
            <path d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z" fill="#FBBF24"/>
          </svg>
          <span class="trust-rating-count">({appRating.ratings})</span>
        </a>
        <div class="trust-sep" aria-hidden="true"></div>
      </>
    )}
    {items.map((label, i) => (
      <>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
            <circle cx="8" cy="8" r="8" fill="rgba(51,102,255,0.08)"/>
            <path d="M5 8.2L7 10.2L11 6" stroke="#3366FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{label}</span>
        </div>
        {i < items.length - 1 && <div class="trust-sep" aria-hidden="true"></div>}
      </>
    ))}
  </div>
</div>

<style>
  .trust-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #4B5563;
    padding: 6px 20px;
    white-space: nowrap;
  }
  .trust-sep {
    width: 1px;
    height: 14px;
    background: rgba(51,102,255,0.10);
    flex-shrink: 0;
  }
  html.dark .trust-item { color: #94A3B8 !important; }
  html.dark .trust-sep  { background: rgba(90, 120, 255, 0.12) !important; }

  .trust-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 12px;
    padding: 6px 14px 6px 6px;
    border-radius: 100px;
    background: rgba(51,102,255,0.06);
    border: 1px solid rgba(51,102,255,0.16);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .trust-rating-badge img {
    border-radius: 5px;
    flex-shrink: 0;
    display: block;
  }
  .trust-rating-score {
    font-size: 13px;
    font-weight: 700;
    color: #1A1F36;
  }
  .trust-rating-count {
    font-size: 12px;
    font-weight: 500;
    color: #6B7280;
  }
  .trust-rating-badge:hover {
    background: rgba(51,102,255,0.10);
    border-color: rgba(51,102,255,0.28);
  }
  html.dark .trust-rating-badge {
    background: rgba(90,120,255,0.08) !important;
    border-color: rgba(90,120,255,0.20) !important;
  }
  html.dark .trust-rating-badge:hover {
    background: rgba(90,120,255,0.14) !important;
    border-color: rgba(90,120,255,0.32) !important;
  }
  html.dark .trust-rating-score { color: #E2E8F0 !important; }
  html.dark .trust-rating-count { color: #94A3B8 !important; }

  @media (max-width: 700px) {
    .trust-sep { display: none; }
    /* Lange Labels (z. B. im Englischen) umbrechen lassen statt den
       Viewport auf sehr schmalen Screens zu sprengen. */
    .trust-item { padding: 6px 12px; white-space: normal; }
  }
</style>
