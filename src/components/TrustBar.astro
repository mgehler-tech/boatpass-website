---
import { useTranslations } from '../i18n/index';
import { getBoatpassRating } from '../data/apps';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const appRating = getBoatpassRating();
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
const ratingLabel = appRating
  ? `${appRating.score.toFixed(1).replace('.', lang === 'de' ? ',' : '.')} ★ ${lang === 'de' ? 'bei Google Play' : 'on Google Play'} (${appRating.ratings})`
  : null;

const items = [
  t.trust.catalog,
  t.trust.current,
  t.trust.oneTime,
  t.trust.languages,
];
---

<div style="padding:14px 24px;">
  <div class="max-w-6xl mx-auto trust-inner">
    {ratingLabel && (
      <>
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="trust-item trust-rating">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
            <path d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z" fill="#FBBF24"/>
          </svg>
          <span>{ratingLabel}</span>
        </a>
        <div class="trust-sep" aria-hidden="true"></div>
      </>
    )}
    {items.map((label, i) => (
      <>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
            <circle cx="8" cy="8" r="8" fill="rgba(51,102,255,0.08)"/>
            <path d="M5 8.2L7 10.2L11 6" stroke="#3366FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{label}</span>
        </div>
        {i < items.length - 1 && <div class="trust-sep" aria-hidden="true"></div>}
      </>
    ))}
  </div>
</div>

<style>
  .trust-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #4B5563;
    padding: 6px 20px;
    white-space: nowrap;
  }
  .trust-sep {
    width: 1px;
    height: 14px;
    background: rgba(51,102,255,0.10);
    flex-shrink: 0;
  }
  html.dark .trust-item { color: #94A3B8 !important; }
  html.dark .trust-sep  { background: rgba(90, 120, 255, 0.12) !important; }

  .trust-rating {
    text-decoration: none;
    font-weight: 700;
    color: #1A1F36;
  }
  .trust-rating:hover { color: #3366FF; }
  html.dark .trust-rating { color: #E2E8F0 !important; }
  html.dark .trust-rating:hover { color: #7C9CFF !important; }

  @media (max-width: 700px) {
    .trust-sep { display: none; }
    /* Lange Labels (z. B. im Englischen) umbrechen lassen statt den
       Viewport auf sehr schmalen Screens zu sprengen. */
    .trust-item { padding: 6px 12px; white-space: normal; }
  }
</style>
