---
import { DATA_AS_OF_LABEL, LICENSE_LABELS, formatRating, type LearningApp } from '../data/apps';

interface Props {
  apps: LearningApp[];
  lang: 'de' | 'en';
  /** Scheine, die in der Spalte „Scheine" gezeigt werden. Leer = alle der App. */
  caption?: string;
}

const { apps, lang, caption } = Astro.props;

const t = lang === 'de'
  ? {
      app: 'App', rating: 'Bewertung', price: 'Preis', licenses: 'Scheine',
      offline: 'Offline', platforms: 'Plattformen', reviews: 'Bew.',
      yes: 'Ja', no: 'Nein', partial: 'Teilweise', unknown: 'k. A.',
      asOf: `Stand der Daten: ${DATA_AS_OF_LABEL.de}. Quellen: Play-Store-Listings und Anbieter-Websites.`,
      ownHint: 'unsere App',
    }
  : {
      app: 'App', rating: 'Rating', price: 'Price', licenses: 'Licences',
      offline: 'Offline', platforms: 'Platforms', reviews: 'reviews',
      yes: 'Yes', no: 'No', partial: 'Partly', unknown: 'n/a',
      asOf: `Data as of ${DATA_AS_OF_LABEL.en}. Sources: Play Store listings and vendor websites.`,
      ownHint: 'our app',
    };

function offlineLabel(value: LearningApp['offline']): string {
  if (value === true) return t.yes;
  if (value === false) return t.no;
  if (value === 'partial') return t.partial;
  return t.unknown;
}

function platformLabel(app: LearningApp): string {
  const parts = [app.playUrl ? 'Android' : null, app.appStoreUrl ? 'iOS' : null].filter(Boolean);
  return parts.length ? parts.join(' · ') : t.unknown;
}
---

<!-- Desktop: Tabelle (ab 760px). Darunter würden sechs Spalten den Viewport
     sprengen und horizontal scrollen – dort greift die Karten-Ansicht unten. -->
<div class="cmp-table-wrap" style="background:white; border:1px solid rgba(51,102,255,0.12); border-radius:16px; overflow-x:auto;">
  <table style="width:100%; border-collapse:collapse; min-width:640px; font-size:14px;">
    {caption && <caption style="caption-side:top; text-align:left; padding:18px 20px 0; font-size:13px; color:#6B7280;">{caption}</caption>}
    <thead>
      <tr>
        {[t.app, t.rating, t.price, t.licenses, t.offline, t.platforms].map(h => (
          <th scope="col" style="text-align:left; padding:14px 16px; font-size:12px; font-weight:700; color:#3366FF; text-transform:uppercase; letter-spacing:1px; border-bottom:1px solid rgba(51,102,255,0.12); white-space:nowrap;">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {apps.map(app => (
        <tr>
          <th scope="row" style="text-align:left; padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; font-weight:700; color:#1A1F36;">
            {app.name}
            {app.isOwn && (
              <span style="display:inline-block; margin-left:6px; font-size:11px; font-weight:700; color:#3366FF; background:rgba(51,102,255,0.08); border-radius:100px; padding:2px 8px; white-space:nowrap;">{t.ownHint}</span>
            )}
            <div style="font-size:12px; font-weight:500; color:#9CA3AF; margin-top:3px;">{app.vendor}</div>
          </th>
          <td style="padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; color:#4B5563;">
            {app.rating
              ? <span>{formatRating(app.rating).replace('.', lang === 'de' ? ',' : '.')} ★<br /><span style="font-size:12px; color:#9CA3AF;">{app.ratingCount?.toLocaleString(lang === 'de' ? 'de-DE' : 'en-GB')} {t.reviews}</span></span>
              : <span style="color:#9CA3AF;">{t.unknown}</span>}
            {app.downloads && <div style="font-size:12px; color:#9CA3AF; margin-top:4px;">{app.downloads}</div>}
          </td>
          <td style="padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; color:#4B5563;">{app.price[lang]}</td>
          <td style="padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; color:#4B5563;">
            {app.licenses.map(l => LICENSE_LABELS[l][lang]).join(', ')}
            {!app.singleApp && (
              <div style="font-size:12px; color:#9CA3AF; margin-top:4px;">
                {lang === 'de' ? 'je Schein eine eigene App' : 'a separate app per licence'}
              </div>
            )}
          </td>
          <td style="padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; color:#4B5563;">{offlineLabel(app.offline)}</td>
          <td style="padding:16px; border-bottom:1px solid rgba(51,102,255,0.08); vertical-align:top; color:#4B5563; white-space:nowrap;">{platformLabel(app)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Mobile: gestapelte Karten (unter 760px). Jede App wird zu einer eigenen
     Karte mit Label-Wert-Zeilen, statt die sechsspaltige Tabelle horizontal
     scrollen zu lassen – dieselbe Behandlung wie die Katalog-Tabelle
     (CatalogSources.astro). Reiner Layout-Feinschliff, gleiche Daten. -->
<div class="cmp-cards">
  {caption && <p class="cmp-cards-caption">{caption}</p>}
  {apps.map(app => (
    <div class="cmp-card">
      <div class="cmp-card-head">
        <div class="cmp-card-name">
          {app.name}
          {app.isOwn && <span class="cmp-card-own">{t.ownHint}</span>}
        </div>
        <div class="cmp-card-vendor">{app.vendor}</div>
      </div>
      <dl class="cmp-card-rows">
        <div class="cmp-card-row">
          <dt>{t.rating}</dt>
          <dd>
            {app.rating
              ? <span>{formatRating(app.rating).replace('.', lang === 'de' ? ',' : '.')} ★ <span class="cmp-card-sub">· {app.ratingCount?.toLocaleString(lang === 'de' ? 'de-DE' : 'en-GB')} {t.reviews}</span></span>
              : <span class="cmp-card-muted">{t.unknown}</span>}
            {app.downloads && <span class="cmp-card-sub"> · {app.downloads}</span>}
          </dd>
        </div>
        <div class="cmp-card-row">
          <dt>{t.price}</dt>
          <dd>{app.price[lang]}</dd>
        </div>
        <div class="cmp-card-row">
          <dt>{t.licenses}</dt>
          <dd>
            {app.licenses.map(l => LICENSE_LABELS[l][lang]).join(', ')}
            {!app.singleApp && (
              <span class="cmp-card-sub"> · {lang === 'de' ? 'je Schein eine eigene App' : 'a separate app per licence'}</span>
            )}
          </dd>
        </div>
        <div class="cmp-card-row">
          <dt>{t.offline}</dt>
          <dd>{offlineLabel(app.offline)}</dd>
        </div>
        <div class="cmp-card-row">
          <dt>{t.platforms}</dt>
          <dd>{platformLabel(app)}</dd>
        </div>
      </dl>
    </div>
  ))}
</div>

<p style="font-size:13px; color:#9CA3AF; line-height:1.6; margin-top:12px;">{t.asOf}</p>

<style>
  /* Karten-Ansicht standardmäßig aus; ab 760px zeigt die Tabelle, darunter
     stapeln die Karten – exakt der Breakpoint der Katalog-Tabelle. */
  .cmp-cards { display: none; }

  @media (max-width: 760px) {
    .cmp-table-wrap { display: none; }
    .cmp-cards { display: flex; flex-direction: column; gap: 12px; }
  }

  .cmp-cards-caption {
    font-size: 13px;
    color: #6B7280;
    line-height: 1.6;
    margin: 0 0 4px;
  }
  .cmp-card {
    background: white;
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .cmp-card-head {
    padding-bottom: 14px;
    margin-bottom: 4px;
    border-bottom: 1px solid rgba(51,102,255,0.08);
  }
  .cmp-card-name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 16px;
    font-weight: 700;
    color: #1A1F36;
    letter-spacing: -0.2px;
  }
  .cmp-card-own {
    font-size: 11px;
    font-weight: 700;
    color: #3366FF;
    background: rgba(51,102,255,0.08);
    border-radius: 100px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .cmp-card-vendor {
    font-size: 12px;
    font-weight: 500;
    color: #9CA3AF;
    margin-top: 4px;
  }
  .cmp-card-rows {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .cmp-card-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
  }
  .cmp-card-row + .cmp-card-row {
    border-top: 1px solid rgba(51,102,255,0.06);
  }
  .cmp-card-row dt {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 700;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  .cmp-card-row dd {
    margin: 0;
    text-align: right;
    font-size: 14px;
    color: #4B5563;
    line-height: 1.5;
  }
  .cmp-card-sub { font-size: 12px; color: #9CA3AF; }
  .cmp-card-muted { color: #9CA3AF; }

  html.dark .cmp-card {
    background: #181E2E !important;
    border-color: rgba(90,120,255,0.12) !important;
  }
  html.dark .cmp-card-head { border-bottom-color: rgba(90,120,255,0.10) !important; }
  html.dark .cmp-card-row + .cmp-card-row { border-top-color: rgba(90,120,255,0.08) !important; }
  html.dark .cmp-card-name { color: #E2E8F0 !important; }
  html.dark .cmp-card-vendor { color: #6B7280 !important; }
  html.dark .cmp-card-row dt { color: #94A3B8 !important; }
  html.dark .cmp-card-row dd { color: #B4BCDA !important; }
  html.dark .cmp-card-sub,
  html.dark .cmp-card-muted { color: #6B7280 !important; }
  html.dark .cmp-card-own {
    background: rgba(90,120,255,0.14) !important;
    color: #8BB4FF !important;
  }
  html.dark .cmp-cards-caption { color: #94A3B8 !important; }
</style>
