---
/**
 * Hero der Startseite.
 *
 * Aufbau wie ein Kartenblatt: oben der Titel (die H1 mit dem Hauptsuchbegriff,
 * sehr groß und schmal gesetzt – das lange Kompositum ist hier das Bild),
 * darunter die Randskala, links Text und Download, rechts ein Seekarten-
 * Ausschnitt mit einer echten Prüfungsfrage zum Ausprobieren. Die Frage zeigt,
 * was die App ausmacht (Erklärung + Merkhilfe), statt es zu behaupten.
 */
import Icon from './Icon.astro';
import ChartArt from './ChartArt.astro';
import SampleQuestion from './SampleQuestion.astro';
import { useTranslations } from '../i18n/index';
import { getBoatpassRating, formatRating } from '../data/apps';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const de = lang === 'de';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';

// Google-Play-Bewertung direkt am Haupt-CTA als Social Proof (Score · Sterne · Anzahl).
const appRating = getBoatpassRating();
const ratingScoreLabel = appRating
  ? formatRating(appRating.score).replace('.', de ? ',' : '.')
  : null;
const fullStars = appRating ? Math.round(appRating.score) : 0;
const ratingsLabel = de ? 'Bewertungen bei Google Play' : 'ratings on Google Play';

// Schriftgröße der H1 in Container-Einheiten, so dass die längere der beiden
// Zeilen ab Desktop genau die Spalte füllt. Gemessen in Archivo (wdth 76 %):
// DE „Der schnellste Weg zum" 9,04 em, EN „The fastest way to get your" 10,11 em.
const h1Fit = de ? '11cqi' : '9.8cqi';
---

<section class="hero">
  <div class="hero-title">
    <!-- H1: konstant, mit dem Hauptsuchbegriff. Zweite Zeile ist das
         Kompositum allein – ab Desktop-Breite in einer Zeile. -->
    <h1 class="display hero-h1" style={`--h1-fit:${h1Fit}`}>
      <span class="hero-h1-a">{t.hero.headline1} {t.hero.headline2}</span>
      <span class="hero-h1-b">{t.hero.headlineAccent}</span>
    </h1>
  </div>

  <div class="hero-copy">
    <p class="hero-sub">{t.hero.subline}</p>

    <div class="hero-cta-row">
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" id="hero-cta-play" class="hero-cta">
        <svg width="12" height="14" viewBox="0 0 10 12" fill="none" aria-hidden="true">
          <path d="M1.5 1.5L8.5 6L1.5 10.5V1.5Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        {t.hero.cta}
      </a>
      <div id="hero-cta-ios" class="hero-ios">
        <Icon name="phoneDevice" size={17} strokeWidth={2} />
        {t.hero.ctaIos}
      </div>
    </div>

    <div class="hero-trust">
      <!-- Offizielles "Jetzt bei Google Play"-Badge -->
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        id="hero-gplay-badge" class="gplay-badge"
        aria-label={de ? 'Boatpass bei Google Play herunterladen' : 'Get Boatpass on Google Play'}>
        <img src="/images/google-play-icon.png" alt="" width="22" height="22" aria-hidden="true" class="gplay-badge-icon" />
        <span class="gplay-badge-text">
          <span class="gplay-badge-eyebrow">{de ? 'Jetzt bei' : 'Get it on'}</span>
          <span class="gplay-badge-wordmark">Google Play</span>
        </span>
      </a>

      {appRating && (
        <div class="hero-rating"
          aria-label={`${ratingScoreLabel} ${de ? 'von 5 Sternen' : 'out of 5 stars'} – ${appRating.ratings} ${ratingsLabel}`}>
          <span class="hero-rating-score num">{ratingScoreLabel}</span>
          <span class="hero-rating-meta">
            <span class="hero-stars" aria-hidden="true">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg width="13" height="13" viewBox="0 0 16 16" class:list={['hero-star', { 'hero-star--empty': i >= fullStars }]}>
                  <path d="M8 1.5l1.85 3.75 4.15.6-3 2.93.71 4.13L8 11.02l-3.71 1.9.71-4.13-3-2.93 4.15-.6L8 1.5z" fill="currentColor"/>
                </svg>
              ))}
            </span>
            <span class="hero-rating-count">{appRating.ratings} {ratingsLabel}</span>
          </span>
        </div>
      )}
    </div>

    <script is:inline>
      // Läuft während des Parsens, also vor dem ersten Paint – kein Umspringen sichtbar.
      // iPadOS gibt sich seit iOS 13 als MacIntel aus, daher der maxTouchPoints-Check.
      (function () {
        var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        if (!isIos) return;
        var play = document.getElementById('hero-cta-play');
        var ios = document.getElementById('hero-cta-ios');
        var gplay = document.getElementById('hero-gplay-badge');
        if (play && ios) {
          play.style.display = 'none';
          ios.style.display = 'inline-flex';
        }
        // Google-Play-Badge auf iOS ausblenden – dort führt es nicht zum Ziel.
        if (gplay) gplay.style.display = 'none';
      })();
    </script>

    <!-- Lizenzen als Kartenlegende: alle Namen dauerhaft lesbar, keine Rotation. -->
    <dl class="hero-legend">
      <dt>{de ? 'Lizenzen' : 'Licences'}</dt>
      <dd>
        {t.hero.licenses.map(name => <span>{name}</span>)}
      </dd>
    </dl>
  </div>

  <div class="hero-rule chart-rule" aria-hidden="true"></div>

  <div class="hero-chart">
    <div class="hero-chart-art"><ChartArt /></div>
    <div class="hero-sheet">
      <SampleQuestion lang={lang} />
    </div>
  </div>
</section>

<style>
  /* Raster mit benannten Linien: Inhalt in einer 1200er-Spalte, Randskala und
     Karte laufen bis an die Bildschirmkante. */
  .hero {
    display: grid;
    grid-template-columns: [full-start] 20px [content-start] minmax(0, 1fr) [content-end] 20px [full-end];
    padding-top: 64px; /* fixer Header */
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .hero-title { grid-column: content; padding: 36px 0 18px; }
  .hero-copy { grid-column: content; padding-bottom: 36px; }
  .hero-rule { grid-column: full; }
  .hero-chart { grid-column: full; position: relative; padding: 28px 20px 40px; overflow: hidden; }

  /* Schriftgröße an der Spaltenbreite (Container-Einheiten, Faktor je Sprache
     im Frontmatter): Ab Desktop füllen die Zeilen die Inhaltsbreite. Auf
     schmalen Screens greift das Minimum, dann trennt das weiche Trennzeichen
     im Wort („Sportboot-/führerschein."). */
  .hero-title { container-type: inline-size; }
  .hero-h1 {
    font-size: clamp(2.85rem, var(--h1-fit, 11cqi), 8.2rem);
    color: var(--ink);
    hyphens: manual;
  }
  /* Schmal: fließend, damit „zum Sportboot-" eine Zeile teilt. */
  .hero-h1-a, .hero-h1-b { display: inline; }

  .hero-sub {
    font-size: clamp(1.06rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 34em;
    margin-bottom: 26px;
  }

  .hero-cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 26px 0 22px;
    border-radius: 8px;
    background: var(--action);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .hero-cta:hover { background: var(--action-hover); }
  .hero-cta:active { transform: translateY(1px); }
  .hero-ios {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 22px;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-trust { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  /* Offizielles schwarzes Google-Play-Badge (nachgebaut mit dem Play-Icon). */
  .gplay-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #000;
    color: #fff;
    padding: 7px 16px 7px 12px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid transparent;
  }
  :global(html.dark) .gplay-badge { border-color: rgba(255, 255, 255, 0.22); }
  .gplay-badge-icon { display: block; flex-shrink: 0; }
  .gplay-badge-text { display: flex; flex-direction: column; line-height: 1.1; }
  .gplay-badge-eyebrow { font-size: 9px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; }
  .gplay-badge-wordmark { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }

  .hero-rating { display: flex; align-items: center; gap: 10px; }
  .hero-rating-score { font-size: 30px; font-weight: 780; font-stretch: 80%; line-height: 1; }
  .hero-rating-meta { display: flex; flex-direction: column; gap: 3px; }
  .hero-stars { display: inline-flex; gap: 1px; color: #D99A06; }
  .hero-star--empty { color: var(--rule-2); }
  .hero-rating-count { font-size: 13px; color: var(--ink-2); line-height: 1.2; }

  /* Legende: Lizenz-Namen wie ein Kartenlegenden-Eintrag. */
  .hero-legend {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 30px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }
  .hero-legend dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    flex-shrink: 0;
  }
  .hero-legend dd { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  /* Eckige Legendenkästchen wie auf der Karte – keine Pillen. */
  .hero-legend dd span {
    font-size: 13px;
    font-weight: 650;
    padding: 3px 8px;
    border: 1px solid var(--rule-2);
    border-radius: 2px;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .hero-legend { flex-direction: column; gap: 8px; }
  }

  /* Schmal: Die Karte ist ein Streifen über dem Bogen, der Bogen liegt zur
     Hälfte darauf. So sieht man Land, Leuchtfeuer und Rose statt nur einer
     Fläche hinter den Rändern des Bogens. */
  .hero-chart { padding-top: 104px; }
  .hero-chart-art { position: absolute; inset: 0 0 auto 0; height: 250px; }
  .hero-sheet { position: relative; max-width: 520px; margin-inline: auto; }

  @media (min-width: 640px) {
    .hero { grid-template-columns: [full-start] 32px [content-start] minmax(0, 1fr) [content-end] 32px [full-end]; }
    .hero-chart { padding: 150px 32px 56px; }
    .hero-chart-art { height: 320px; }
  }

  /* Desktop: Titel über die volle Breite, darunter Text links und Karte
     rechts, die bis an den rechten Rand läuft. Die Karte bekommt ihre eigene
     senkrechte Randskala an der linken Kante. */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns:
        [full-start] minmax(40px, 1fr)
        [content-start] minmax(0, 560px)
        [split] minmax(0, 620px)
        [content-end] minmax(40px, 1fr) [full-end];
      grid-template-rows: auto auto 1fr;
    }
    .hero-title { grid-column: content-start / content-end; grid-row: 1; padding: 56px 0 30px; }
    .hero-rule { grid-row: 2; }
    .hero-copy {
      grid-column: content-start / split;
      grid-row: 3;
      padding: 44px 56px 64px 0;
      display: flex;
      flex-direction: column;
    }
    .hero-legend { margin-top: auto; }
    .hero-chart {
      grid-column: split / full-end;
      grid-row: 3;
      padding: 44px 40px 64px 56px;
      border-left: 1px solid var(--ink);
    }
    /* Feste Höhe statt inset:0: Klappt die Auswertung auf, wächst die Fläche,
       die Karte bleibt aber im selben Maßstab stehen und zeigt nur mehr. */
    .hero-chart-art { inset: 0 0 auto 0; height: 900px; }
    /* Senkrechte Randskala an der Kartenkante */
    .hero-chart::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 11px;
      border-right: 1px solid var(--ink);
      background:
        repeating-linear-gradient(180deg, var(--ink) 0 1px, transparent 1px 12px) left top / 4px 100% no-repeat,
        repeating-linear-gradient(180deg, var(--ink) 0 60px, transparent 60px 120px) right top / 5px 100% no-repeat,
        var(--paper);
      z-index: 1;
    }
    .hero-sheet { margin-inline: 0; max-width: 500px; }
    .hero-h1-a, .hero-h1-b { display: block; white-space: nowrap; }
  }

  @media (max-width: 420px) {
    .hero-trust { gap: 14px; }
    .hero-cta { width: 100%; justify-content: center; }
  }
</style>
