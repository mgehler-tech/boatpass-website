---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/index';
import screenshot0De from '../assets/images/app-screenshot.de.png';
import screenshot1De from '../assets/images/app.screenshot.1.de.png';
import screenshot2De from '../assets/images/app.screenshot.2.de.png';
import screenshot3De from '../assets/images/app.screenshot.3.de.png';
import screenshot0En from '../assets/images/app-screenshot.en.png';
import screenshot1En from '../assets/images/app.screenshot.1.en.png';
import screenshot2En from '../assets/images/app.screenshot.2.en.png';
import screenshot3En from '../assets/images/app.screenshot.3.en.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [screenshot0, screenshot1, screenshot2, screenshot3] = lang === 'en'
  ? [screenshot0En, screenshot1En, screenshot2En, screenshot3En]
  : [screenshot0De, screenshot1De, screenshot2De, screenshot3De];
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<section class="hero-section" style="position:relative; min-height:100vh; display:flex; align-items:center; padding: 100px 0 0; overflow:hidden; background:#F0F4FA;">

  <!-- Background orbs -->
  <div style="position:absolute; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle,rgba(51,102,255,0.08),transparent 70%); top:-80px; right:-60px; pointer-events:none;"></div>
  <div style="position:absolute; width:320px; height:320px; border-radius:50%; background:radial-gradient(circle,rgba(51,102,255,0.06),transparent 70%); bottom:120px; right:300px; pointer-events:none;"></div>

  <!-- Dot grid overlay -->
  <div style="position:absolute; inset:0; background-image:radial-gradient(rgba(51,102,255,0.10) 1px,transparent 1px); background-size:32px 32px; mask-image:radial-gradient(ellipse 80% 80% at 65% 40%,black 0%,transparent 70%); pointer-events:none;"></div>

  <!-- Content grid -->
  <div class="max-w-6xl mx-auto px-6 w-full hero-grid" style="position:relative; z-index:2;">

    <!-- Left: text -->
    <div style="max-width:580px;">

      <!-- Badge -->
      <div class="animate-fade-up" style="display:inline-flex; align-items:center; gap:8px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; padding:6px 14px; border-radius:100px; margin-bottom:28px;">
        <span class="animate-blink" style="width:6px;height:6px;background:#3366FF;border-radius:50%;display:inline-block;flex-shrink:0;"></span>
        {t.hero.badge}
      </div>

      <!-- H1 -->
      <h1 class="animate-fade-up delay-1" style="font-size:clamp(40px,6vw,64px); font-weight:900; line-height:1.0; letter-spacing:-0.045em; color:#1A1F36; margin-bottom:22px;">
        {t.hero.headline1}<br>
        {t.hero.headline2}<br>
        <span
          id="hero-accent"
          class="gradient-text"
          data-words={JSON.stringify(lang === 'de'
            ? ['SBF Binnen.', 'SBF See.', 'UBI.', 'SRC.']
            : ['Boating License.', 'SBF Inland.', 'SBF Coastal.']
          )}
        >{t.hero.headlineAccent}</span>
      </h1>

      <!-- Subline -->
      <p class="animate-fade-up delay-2" style="font-size:18px; color:#6B7280; line-height:1.65; margin-bottom:40px; max-width:460px;">
        {t.hero.subline}
      </p>

      <!-- CTAs -->
      <div class="animate-fade-up delay-3" style="display:flex; gap:14px; align-items:center; margin-bottom:52px; flex-wrap:wrap;">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
          id="hero-cta-play"
          class="cta-primary"
          style="display:inline-flex; align-items:center; gap:10px; background:#3366FF; color:white; font-weight:700; font-size:15px; padding:14px 28px; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(51,102,255,0.25);">
          ▶&nbsp;{t.hero.cta}
        </a>
        <div id="hero-cta-ios" class="ios-badge"
          style="display:none; align-items:center; gap:10px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); font-weight:700; font-size:15px; padding:13px 27px; border-radius:14px;">
          <Icon name="phoneDevice" size={17} strokeWidth={2} />
          {t.hero.ctaIos}
        </div>
        <script is:inline>
          // Läuft während des Parsens, also vor dem ersten Paint – kein Umspringen sichtbar.
          // iPadOS gibt sich seit iOS 13 als MacIntel aus, daher der maxTouchPoints-Check.
          (function () {
            var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
              (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            if (!isIos) return;
            var play = document.getElementById('hero-cta-play');
            var ios = document.getElementById('hero-cta-ios');
            if (play && ios) {
              play.style.display = 'none';
              ios.style.display = 'inline-flex';
            }
          })();
        </script>
        <a href="#features"
          style="color:#3366FF; font-size:15px; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:6px; padding:14px 0;">
          {t.hero.ctaSecondary} →
        </a>
      </div>

      <!-- Stats -->
      <div class="animate-fade-up delay-4 hero-stats" style="display:flex; gap:36px; padding-top:36px; border-top:1px solid rgba(51,102,255,0.10); flex-wrap:wrap;">
        <div>
          <div style="font-size:26px; font-weight:900; letter-spacing:-1px; color:#1A1F36;">{t.hero.stat1Num}</div>
          <div style="font-size:14px; color:#6B7280; margin-top:2px;">{t.hero.stat1Label}</div>
        </div>
        <div>
          <div style="font-size:26px; font-weight:900; letter-spacing:-1px; color:#1A1F36;">{t.hero.stat2Num}</div>
          <div style="font-size:14px; color:#6B7280; margin-top:2px;">{t.hero.stat2Label}</div>
        </div>
        <div>
          <div style="font-size:26px; font-weight:900; letter-spacing:-1px; color:#1A1F36;">{t.hero.stat3Num}</div>
          <div style="font-size:14px; color:#6B7280; margin-top:2px;">{t.hero.stat3Label}</div>
        </div>
      </div>
    </div>

    <!-- Right: real app screenshot -->
    <div class="animate-float-straight phone-col" style="position:relative; flex-shrink:0;">
      <!-- Glow -->
      <div style="position:absolute; width:300px; height:300px; background:radial-gradient(circle,rgba(51,102,255,0.15),transparent 70%); bottom:-40px; left:50%; transform:translateX(-50%); filter:blur(24px); pointer-events:none;"></div>
      <!-- Shadow -->
      <div style="position:absolute; bottom:-20px; left:50%; transform:translateX(-50%); width:200px; height:28px; background:radial-gradient(ellipse,rgba(26,31,54,0.15),transparent 70%); filter:blur(10px);"></div>

      <!-- Mini banners cycling in sync -->
      <!-- Banner 0: Streak -->
      <div class="phone-banner" style="animation-delay:0s;">
        <div class="banner-icon-wrapper orange">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.048 8.287 8.287 0 0 0 9 9.6a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
            <path d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />
          </svg>
        </div>
        <div>
          <div class="banner-title">{lang === 'de' ? '4 Tage Streak' : '4 Day Streak'}</div>
          <div class="banner-subtitle">{lang === 'de' ? 'Heute gesichert ✓' : 'Saved today ✓'}</div>
        </div>
      </div>

      <!-- Banner 1: Logbuch -->
      <div class="phone-banner" style="animation-delay:-4s;">
        <div class="banner-icon-wrapper blue">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1.5" y="6" width="2" height="4.5" rx="0.5" fill="#3366FF"/>
            <rect x="5" y="3" width="2" height="7.5" rx="0.5" fill="#3366FF"/>
            <rect x="8.5" y="1" width="2" height="9.5" rx="0.5" fill="#3366FF"/>
          </svg>
        </div>
        <div>
          <div class="banner-title">{lang === 'de' ? '21 % geschafft' : '21% completed'}</div>
          <div class="banner-subtitle">{lang === 'de' ? '64 / 300 Fragen' : '64 / 300 questions'}</div>
        </div>
      </div>

      <!-- Banner 2: Exam -->
      <div class="phone-banner" style="animation-delay:-8s;">
        <div class="banner-icon-wrapper blue">
          <svg width="10" height="10" viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1.5 1.5L8.5 6L1.5 10.5V1.5Z" fill="#3366FF" stroke="#3366FF" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <div class="banner-title">{lang === 'de' ? 'Prüfungsmodus' : 'Exam Mode'}</div>
          <div class="banner-subtitle">{lang === 'de' ? '30 Fragen · 45 Min' : '30 questions · 45 min'}</div>
        </div>
      </div>

      <!-- Banner 3: Leider falsch -->
      <div class="phone-banner" style="animation-delay:-12s;">
        <div class="banner-icon-wrapper red">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke="#EF4444" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="banner-title">{lang === 'de' ? 'Leider falsch' : 'Incorrect answer'}</div>
          <div class="banner-subtitle">{lang === 'de' ? 'Mit Erklärung & Merkhilfe' : 'Explanation & tips'}</div>
        </div>
      </div>

      <!-- Phone frame + cycling screenshots -->
      <div class="phone-frame" style="position:relative; width:260px; border-radius:44px; padding:10px; background:#ffffff; box-shadow:0 0 0 1px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.02), 0 40px 80px rgba(26,31,54,0.12);">
        <div style="position:relative; border-radius:36px; overflow:hidden; line-height:0; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
          <Image src={screenshot0} alt="Boatpass SBF Lernapp – Hauptscreen" class="phone-slide" style="animation-delay:0s;" width={480} quality={80} fetchpriority="high" />
          <Image src={screenshot1} alt="Boatpass App – Prüfungsmodus" class="phone-slide" style="animation-delay:-4s;" width={480} quality={80} loading="lazy" />
          <Image src={screenshot2} alt="Boatpass App – Lernmodus" class="phone-slide" style="animation-delay:-8s;" width={480} quality={80} loading="lazy" />
          <Image src={screenshot3} alt="Boatpass App – Fehler-Training" class="phone-slide" style="animation-delay:-12s;" width={480} quality={80} loading="lazy" />
        </div>
      </div>
    </div>
  </div>

  <!-- Wave bottom -->
  <div class="hero-wave" style="position:absolute; bottom:-2px; left:0; right:0; height:80px; overflow:hidden; pointer-events:none;">
    <svg style="width:200%; height:100%; animation:wave 12s linear infinite;" viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="#F0F4FA"/>
      <path d="M1440,40 C1680,80 1920,0 2160,40 C2400,80 2640,0 2880,40 L2880,80 L1440,80 Z" fill="#F0F4FA"/>
    </svg>
  </div>
</section>

<style>
  #hero-accent { transition: opacity 0.3s ease; }

  /* Eigene Blautöne statt #3366FF: Auf dem hellen Badge-Grund erreicht die
     Akzentfarbe nur 3,8:1 und verfehlt AA für 15px-Fetttext. Hell braucht
     dunkleres, Dunkel helleres Blau – eine feste Farbe kann beides nicht. */
  .ios-badge { color: #1A44D4; }
  :global(html.dark) .ios-badge { color: #5B8CFF; }

  .phone-slide {
    width: 100%;
    display: block;
    border-radius: 36px;
    animation: phoneCycle 16s infinite;
  }
  .phone-slide + .phone-slide {
    position: absolute;
    top: 0; left: 0;
  }

  @keyframes phoneCycle {
    0%   { opacity: 1; transform: scale(1)    translateY(0);    }
    18%  { opacity: 1; transform: scale(1)    translateY(0);    }
    25%  { opacity: 0; transform: scale(0.97) translateY(10px); }
    94%  { opacity: 0; transform: scale(0.97) translateY(-10px);}
    100% { opacity: 1; transform: scale(1)    translateY(0);    }
  }

  /* Banner styles */
  .phone-banner {
    position: absolute;
    left: -190px;
    top: 50%;
    transform: translateY(-50%);
    width: 215px;
    background: white;
    border-radius: 20px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 10px 30px rgba(26,31,54,0.08), 0 1px 3px rgba(0,0,0,0.02);
    border: 1px solid rgba(51, 102, 255, 0.05);
    z-index: 10;
    pointer-events: none;
    animation: bannerCycle 16s infinite;
  }
  .banner-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    font-size: 16px;
    flex-shrink: 0;
  }
  .banner-icon-wrapper.orange {
    background: rgba(249,115,22,0.10);
  }
  .banner-icon-wrapper.blue {
    background: rgba(51,102,255,0.08);
  }
  .banner-icon-wrapper.red {
    background: rgba(239,68,68,0.08);
  }
  .banner-title {
    font-size: 14px;
    font-weight: 800;
    color: #1A1F36;
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .banner-subtitle {
    font-size: 13px;
    font-weight: 500;
    color: #6B7280;
    line-height: 1.2;
  }

  .animate-float-straight {
    animation: floatStraight 4s ease-in-out infinite;
  }

  @keyframes floatStraight {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }

  @keyframes bannerCycle {
    0%   { opacity: 1; transform: translateY(-50%) scale(1) translateX(0); }
    18%  { opacity: 1; transform: translateY(-50%) scale(1) translateX(0); }
    25%  { opacity: 0; transform: translateY(-50%) scale(0.95) translateX(-15px); }
    94%  { opacity: 0; transform: translateY(-50%) scale(0.95) translateX(-15px); }
    100% { opacity: 1; transform: translateY(-50%) scale(1) translateX(0); }
  }

  @media (max-width: 960px) {
    .phone-banner {
      display: none;
    }
  }

  /* Bei reduzierter Bewegung die durchwechselnden Floating-Banner ausblenden:
     ohne ihr Timing würden alle vier deckungsgleich übereinander liegen. */
  @media (prefers-reduced-motion: reduce) {
    .phone-banner {
      display: none;
    }
  }
</style>

<script>
  const el = document.getElementById('hero-accent') as HTMLElement | null;
  if (el) {
    const words: string[] = JSON.parse(el.dataset.words ?? '[]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (words.length > 1 && !prefersReducedMotion) {
      let i = 0;
      setInterval(() => {
        el.style.opacity = '0';
        setTimeout(() => {
          i = (i + 1) % words.length;
          el.textContent = words[i];
          el.style.opacity = '1';
        }, 300);
      }, 2500);
    }
  }
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 60px;
  }
  .cta-primary {
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(51,102,255,0.30) !important;
  }
  html.dark .hero-section { background: #0F1117 !important; }
  html.dark .hero-section h1 { color: #E2E8F0 !important; }
  html.dark .hero-section .delay-2 { color: #94A3B8 !important; }
  html.dark .hero-section .delay-4 { border-color: rgba(90, 120, 255, 0.14) !important; }
  html.dark .hero-section .delay-4 [style*="color:#1A1F36"] { color: #E2E8F0 !important; }
  html.dark .hero-section .delay-4 [style*="color:#6B7280"] { color: #94A3B8 !important; }
  html.dark .hero-section [style*="background:#ffffff"] { background: #181E2E !important; }
  html.dark .phone-frame {
    box-shadow: 0 0 0 1.5px rgba(255,255,255,0.18), 0 2px 8px rgba(0,0,0,0.3), 0 40px 80px rgba(0,0,0,0.4) !important;
  }
  html.dark .phone-banner {
    background: #181E2E !important;
    border-color: rgba(90, 120, 255, 0.12) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
  }
  html.dark .banner-title { color: #E2E8F0 !important; }
  html.dark .banner-subtitle { color: #94A3B8 !important; }
  html.dark .hero-wave path { fill: #0F1117 !important; }

  /* Hero-Kennzahlen (Offiziell · 3 · Kostenlos) auf sehr schmalen Screens.
     Die drei Blöcke passen inhaltlich in eine Zeile, doch der feste 36px-Gap
     (2×) sprengte unterhalb von ~399px die Zeilenbreite – die dritte Zahl
     ("Kostenlos"/"Free") brach als einzelner Orphan in eine zweite Reihe um und
     ließ die Statistik-Zeile im wichtigsten Above-the-fold-Bereich unausgewogen
     wirken (2+1 statt einer sauberen Reihe). Ab hier verteilen sich die drei
     Werte per space-between gleichmäßig über die volle Textbreite und bleiben so
     auf einer Linie; der reduzierte Gap dient nur noch als Mindestabstand. Greift
     erst dort, wo sonst umgebrochen würde – breitere Screens bleiben unverändert
     links ausgerichtet. Reiner Layout-Feinschliff: Farben, Schrift und die
     Zahlen-/Label-Größen des Corporate Designs bleiben unberührt. */
  @media (max-width: 400px) {
    .hero-stats {
      gap: 8px !important;
      justify-content: space-between;
    }
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
    }
    .phone-col {
      display: none;
    }
    /* Phone-Spalte ist hier ausgeblendet – ohne sie würde der kurze Text-Block
       in der vollen Viewport-Höhe vertikal zentriert und dadurch weit vom Header
       weggeschoben. Stattdessen den Inhalt oben andocken und die Höhe freigeben. */
    .hero-section {
      min-height: auto !important;
      align-items: flex-start !important;
      padding-top: 88px !important;
      padding-bottom: 64px !important;
    }
  }
</style>
