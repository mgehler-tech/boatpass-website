---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import appIcon from '../assets/images/app-icon.png';
import { PLAY_STORE_URL } from '../data/stores';

/**
 * Kopfzeile aller Seiten (Spec docs/superpowers/specs/2026-10-17-premium-polish-design.md, 4.3).
 * Vier Einträge (Features · Preise · Führerscheine · Ratgeber), rechts die
 * DE|EN-Pille, die Hell|Dunkel-Pille (ThemeToggle, Verhalten in
 * src/scripts/theme-toggle.ts) und der CTA. Beide Pillen bleiben auf jeder
 * Breite im Header, auch auf dem Handy: So lässt sich Sprache oder eine vom
 * System erzwungene Darstellung wechseln, ohne erst das Menü zu öffnen.
 * Blog und FAQ liegen im Ratgeber-Menü.
 *
 * Auf der Startseite (transparentAtTop) ist die Kopfzeile ganz oben transparent
 * und wird nach 24 px Scrollweg zur transluzenten Fläche; den Sentinel dafür
 * rendert das BaseLayout. Auf allen anderen Seiten ist sie von Anfang an Fläche.
 */
interface Props {
  lang: 'de' | 'en';
  altUrl?: string;
  hasAlternate?: boolean;
  /** Override für Astro.url.pathname. Nötig für die 404-Seite: die ist unter
   * keiner echten Route erreichbar, "auf der aktuellen Seite bleiben" ergäbe
   * dort einen Link auf /404/ – eine URL ohne Inhalt. */
  currentPath?: string;
  /** Startseite: oben transparent, nach dem Scrollen Fläche. */
  transparentAtTop?: boolean;
}

const { lang, altUrl, hasAlternate = true, currentPath: currentPathOverride, transparentAtTop = false } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = PLAY_STORE_URL;
const de = lang === 'de';
const boatSchoolUrl = de ? '/bootsfahrschulen/' : '/en/boat-schools/';

// Der Sprachwechsel muss auf der aktuellen Seite bleiben statt auf die
// Startseite zu springen. Ohne explizites altUrl (z. B. abweichende Slugs bei
// Blogposts) greift dieselbe Pfad-Heuristik wie in SEO.astro für hreflang.
// altUrl ist dort eine absolute URL (fürs hreflang-Tag) – für einen anklickbaren
// Link wird sie wie jeder andere interne Link im Header auf einen relativen Pfad
// gekürzt, statt einen vollen Origin-Wechsel auszulösen.
const currentPath = currentPathOverride ?? Astro.url.pathname;
const otherLangPath = hasAlternate
  ? (altUrl ?? (de ? `/en${currentPath}` : currentPath.replace(/^\/en/, ''))).replace(/^https:\/\/boatpass\.de/, '')
  : (de ? '/en/' : '/');
const deHref = de ? currentPath : otherLangPath;
const enHref = de ? otherLangPath : currentPath;

/**
 * Mega-Menü-Struktur. Zwei bis drei Spalten mit Gruppenüberschrift plus eine
 * Promo-Kachel. Beschreibungen sind Teil der Navigation, nicht Deko: Sie machen
 * die Einträge scanbar, sobald ein Menü mehr als eine Handvoll Ziele hat.
 */
interface MegaItem { href: string; label: string; desc: string; soon?: boolean }
interface MegaGroup { title: string; items: MegaItem[] }

const licensesGroups: MegaGroup[] = [
  {
    title: de ? 'Sportbootführerscheine' : 'Boating licences',
    items: [
      { href: de ? '/sbf-binnen/' : '/en/sbf-inland/', label: de ? 'SBF Binnen' : 'SBF Inland', desc: de ? 'Flüsse, Seen und Kanäle' : 'Rivers, lakes and canals' },
      { href: de ? '/sbf-see/' : '/en/sbf-coastal/', label: de ? 'SBF See' : 'SBF Coastal', desc: de ? 'Küstengewässer und Navigation' : 'Coastal waters and navigation' },
      { href: '', label: de ? 'Bodenseeschifferpatent' : 'Lake Constance licence', desc: de ? 'In Vorbereitung' : 'In preparation', soon: true },
    ],
  },
  {
    title: de ? 'Funkzeugnisse' : 'Radio certificates',
    items: [
      { href: de ? '/ubi/' : '/en/ubi/', label: 'UBI', desc: de ? 'UKW-Sprechfunk Binnen' : 'VHF radio, inland waters' },
      { href: de ? '/src/' : '/en/src/', label: 'SRC', desc: de ? 'Seefunk im Küstenbereich' : 'Marine radio, coastal' },
      { href: de ? '/lrc/' : '/en/lrc/', label: 'LRC', desc: de ? 'Weltweiter Seefunk' : 'Worldwide marine radio' },
    ],
  },
];

const guidesGroups: MegaGroup[] = [
  {
    title: de ? 'Vorbereitung' : 'Preparation',
    items: [
      { href: de ? '/sbf-kosten/' : '/en/sbf-costs/', label: de ? 'SBF Kosten' : 'SBF costs', desc: de ? 'Alle Gebühren im Überblick' : 'Every fee at a glance' },
      { href: de ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/', label: de ? 'Prüfung & Ablauf' : 'Exam & process', desc: de ? 'Anmeldung bis Prüfungstag' : 'From registration to exam day' },
      { href: de ? '/sbf-binnen-pruefungsfragen/' : '/en/sbf-inland-exam-questions/', label: de ? 'Prüfungsfragen Binnen' : 'Inland exam questions', desc: de ? 'Amtlicher Katalog erklärt' : 'Official catalogue explained' },
      { href: de ? '/sbf-see-pruefungsfragen/' : '/en/sbf-coastal-exam-questions/', label: de ? 'Prüfungsfragen See' : 'Coastal exam questions', desc: de ? 'Amtlicher Katalog erklärt' : 'Official catalogue explained' },
      { href: de ? '/sbf-see-navigationsaufgaben/' : '/en/sbf-coastal-navigation-tasks/', label: de ? 'Navigationsaufgaben See' : 'Coastal navigation tasks', desc: de ? 'Kartenaufgabe Schritt für Schritt' : 'The chart task step by step' },
    ],
  },
  {
    title: de ? 'App-Vergleich' : 'App comparison',
    items: [
      { href: de ? '/sbf-app/' : '/en/sbf-app/', label: de ? 'Alle Apps im Vergleich' : 'All apps compared', desc: de ? 'Sieben Apps nebeneinander' : 'Seven apps side by side' },
      { href: de ? '/sbf-see-app/' : '/en/sbf-coastal-app/', label: de ? 'SBF-See-Apps' : 'SBF See apps', desc: de ? 'Mit Navigationsaufgaben' : 'With navigation tasks' },
      { href: de ? '/sbf-binnen-app/' : '/en/sbf-inland-app/', label: de ? 'SBF-Binnen-Apps' : 'SBF Binnen apps', desc: de ? 'Von gratis bis Monatsabo' : 'From free to monthly plans' },
      { href: de ? '/funkschein-app/' : '/en/radio-certificate-app/', label: de ? 'Funkschein-Apps' : 'Radio certificate apps', desc: de ? 'UBI, SRC und LRC' : 'UBI, SRC and LRC' },
      { href: de ? '/sbf-app-kostenlos/' : '/en/sbf-app-free/', label: de ? 'Kostenlose Apps' : 'Free apps', desc: de ? 'Was wirklich gratis geht' : 'What is genuinely free' },
    ],
  },
  {
    title: t.nav.readGroup,
    items: [
      { href: getLocalizedPath(lang, '/blog/'), label: t.nav.blog, desc: de ? 'Artikel rund ums Bootfahren' : 'Articles on boating' },
      { href: getLocalizedPath(lang, '/faq/'), label: t.nav.faq, desc: de ? 'Kurze Antworten' : 'Short answers' },
    ],
  },
];

const promo = {
  href: de ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/',
  eyebrow: 'Tool',
  title: de ? 'Welcher Schein passt zu dir?' : 'Which licence fits you?',
  desc: de ? 'Drei Fragen, eine klare Empfehlung.' : 'Three questions, one clear answer.',
  cta: de ? 'Jetzt herausfinden' : 'Find out now',
};

const homeHref = getLocalizedPath(lang, '/');
---

<header class="site-header" data-hero={transparentAtTop ? '' : undefined}>
  <div class="h-container site-header-bar">

    <!-- Logo -->
    <a href={homeHref} class="logo-link">
      <!-- Immer above the fold: lazy-loading würde das Logo unnötig verzögern. -->
      <Image src={appIcon} alt="" width={56} height={56} loading="eager" />
      Boat<span class="logo-accent">Pass</span>
    </a>

    <!-- Hauptnavigation (ab 1024px) -->
    <nav aria-label={de ? 'Hauptnavigation' : 'Main navigation'} class="site-nav">
      <a href={`${homeHref}#features`} class="nav-link">Features</a>
      <a href={`${homeHref}#pricing`} class="nav-link">{de ? 'Preise' : 'Pricing'}</a>

      <!-- Führerscheine / Licences -->
      <div class="nav-dropdown">
        <a id="licenses-trigger" href={de ? '/fuehrerscheine/' : '/en/licenses/'} class="nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          {de ? 'Führerscheine' : 'Licenses'}
          <svg class="nav-caret" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div id="licenses-menu" class="nav-mega nav-mega--licenses">
          <div class="nav-mega-cols">
            {licensesGroups.map(group => (
              <div class="nav-mega-col">
                <div class="nav-mega-title">{group.title}</div>
                {group.items.map(item => (item.soon ? (
                  <span class="nav-mega-item nav-mega-item--soon">
                    <span class="nav-mega-label">{item.label}</span>
                    <span class="nav-mega-desc">{item.desc}<span class="nav-mega-soon">{de ? 'bald' : 'soon'}</span></span>
                  </span>
                ) : (
                  <a href={item.href} class="nav-mega-item">
                    <span class="nav-mega-label">{item.label}</span>
                    <span class="nav-mega-desc">{item.desc}</span>
                  </a>
                )))}
              </div>
            ))}
          </div>
          <a href={promo.href} class="nav-mega-promo">
            <span class="nav-mega-promo-eyebrow">{promo.eyebrow}</span>
            <span class="nav-mega-promo-title">{promo.title}</span>
            <span class="nav-mega-promo-desc">{promo.desc}</span>
            <span class="nav-mega-promo-cta">{promo.cta}<Icon name="chevronRight" size={14} strokeWidth={2.25} /></span>
          </a>
          <a href={boatSchoolUrl} class="nav-mega-footer-link">
            {de ? 'Bootsfahrschule in deiner Nähe finden' : 'Find a boat school near you'}
            <Icon name="chevronRight" size={14} strokeWidth={2.25} class="nav-mega-footer-arrow" />
          </a>
        </div>
      </div>

      <!-- Ratgeber / Guides (drei Spalten: Menü hängt mittig unter der ganzen Navigation) -->
      <div class="nav-dropdown nav-dropdown--wide">
        <button id="guides-trigger" type="button" class="nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          {de ? 'Ratgeber' : 'Guides'}
          <svg class="nav-caret" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div id="guides-menu" class="nav-mega nav-mega--guides">
          <div class="nav-mega-cols">
            {guidesGroups.map(group => (
              <div class="nav-mega-col">
                <div class="nav-mega-title">{group.title}</div>
                {group.items.map(item => (
                  <a href={item.href} class="nav-mega-item">
                    <span class="nav-mega-label">{item.label}</span>
                    <span class="nav-mega-desc">{item.desc}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
          <a href={promo.href} class="nav-mega-promo">
            <span class="nav-mega-promo-eyebrow">{promo.eyebrow}</span>
            <span class="nav-mega-promo-title">{promo.title}</span>
            <span class="nav-mega-promo-desc">{promo.desc}</span>
            <span class="nav-mega-promo-cta">{promo.cta}<Icon name="chevronRight" size={14} strokeWidth={2.25} /></span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Rechts: Sprache, Darstellung, CTA, Menü -->
    <div class="site-actions">
      <nav class="lang-switcher h-seg" aria-label={t.nav.language}>
        <a href={deHref} hreflang="de" lang="de" class="lang-option h-seg-opt" aria-current={de ? 'page' : undefined}>DE</a>
        <a href={enHref} hreflang="en" lang="en" class="lang-option h-seg-opt" aria-current={de ? undefined : 'page'}>EN</a>
      </nav>
      <ThemeToggle lang={lang} />
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="site-cta h-btn h-btn--sm" data-cta-position="header">
        {t.nav.getApp}
        <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
      </a>
      <button id="mobile-menu-btn" type="button" class="site-burger" aria-label={de ? 'Menü öffnen' : 'Open menu'} aria-expanded="false" aria-controls="mobile-menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobiles Menü (unter 1024px) -->
  <div id="mobile-menu" class="mobile-menu-panel" aria-hidden="true" inert>
    <nav aria-label={de ? 'Mobile Navigation' : 'Mobile navigation'} class="mobile-menu-nav">
      <a href={`${homeHref}#features`} class="mobile-nav-link">Features</a>
      <a href={`${homeHref}#pricing`} class="mobile-nav-link">{de ? 'Preise' : 'Pricing'}</a>

      <!-- Führerscheine -->
      <div class="mobile-accordion">
        <button type="button" class="mobile-accordion-trigger mobile-nav-link" aria-expanded="false" aria-controls="mobile-acc-body">
          <span>{de ? 'Führerscheine' : 'Licenses'}</span>
          <span class="accordion-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div id="mobile-acc-body" class="mobile-accordion-body">
          <div class="mobile-subnav">
            <a href={promo.href} class="mobile-nav-sublink mobile-nav-sublink--cta">{de ? 'Welcher Schein?' : 'Which licence?'}</a>
            <div class="mobile-divider"></div>
            {licensesGroups.map((group, i) => (
              <>
                {i > 0 && <div class="mobile-divider"></div>}
                <div class="mobile-subnav-heading">{group.title}</div>
                {group.items.map(item => (item.soon ? (
                  <span class="mobile-nav-sublink mobile-nav-sublink--soon">{item.label} <span class="soon-badge">{de ? 'bald' : 'soon'}</span></span>
                ) : (
                  <a href={item.href} class="mobile-nav-sublink">{item.label}</a>
                )))}
              </>
            ))}
            <div class="mobile-divider"></div>
            <a href={boatSchoolUrl} class="mobile-nav-sublink mobile-nav-sublink--cta">{de ? 'Fahrschule finden' : 'Find a boat school'}</a>
          </div>
        </div>
      </div>

      <!-- Ratgeber (inkl. Blog und FAQ) -->
      <div class="mobile-accordion">
        <button type="button" class="mobile-accordion-trigger mobile-nav-link" aria-expanded="false" aria-controls="mobile-acc-guides-body">
          <span>{de ? 'Ratgeber' : 'Guides'}</span>
          <span class="accordion-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div id="mobile-acc-guides-body" class="mobile-accordion-body">
          <div class="mobile-subnav">
            {guidesGroups.map((group, i) => (
              <>
                {i > 0 && <div class="mobile-divider"></div>}
                <div class="mobile-subnav-heading">{group.title}</div>
                {group.items.map(item => (
                  <a href={item.href} class="mobile-nav-sublink">{item.label}</a>
                ))}
              </>
            ))}
          </div>
        </div>
      </div>

      <div class="mobile-menu-footer">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn h-btn h-btn--sm" data-cta-position="header">
          {t.nav.getApp}
          <Icon name="chevronRight" size={16} strokeWidth={2.25} class="h-btn-arrow" />
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Backdrop -->
<div id="mobile-menu-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('header.site-header');
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  // Kopfzeile: oben transparent (nur mit Sentinel aus dem BaseLayout), danach Fläche.
  const sentinel = document.querySelector('.header-sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      (entries) => header.classList.toggle('is-scrolled', !entries[0].isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }

  // Alle sichtbaren fokussierbaren Elemente im Menü (collapsed Accordion-Inhalte ausgeschlossen)
  function getFocusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    ).filter(el => {
      const body = el.closest<HTMLElement>('.mobile-accordion-body');
      if (!body) return true;
      return !!el.closest('.mobile-accordion')?.classList.contains('accordion-open');
    });
  }

  function openMenu() {
    menu?.classList.add('open');
    backdrop?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    menu?.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => getFocusable()[0]?.focus());
  }

  function closeMenu() {
    menu?.classList.remove('open');
    backdrop?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    menu?.setAttribute('inert', '');
    document.body.style.overflow = '';
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    menu?.classList.contains('open') ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });

  // Focus-Trap innerhalb des mobilen Menüs
  menu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Menü schließt bei Klick auf Link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Akkordeons
  menu?.querySelectorAll('.mobile-accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const accordion = trigger.closest('.mobile-accordion');
      const isOpen = accordion?.classList.contains('accordion-open');
      accordion?.classList.toggle('accordion-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // Desktop-Dropdowns: aria-expanded per Fokus verwalten
  function wireDropdown(triggerId: string) {
    const trigger = document.getElementById(triggerId);
    const container = trigger?.closest('.nav-dropdown');
    if (!container || !trigger) return;
    container.addEventListener('focusin', () => trigger.setAttribute('aria-expanded', 'true'));
    container.addEventListener('focusout', (e: Event) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!container.contains(next)) trigger.setAttribute('aria-expanded', 'false');
    });
  }
  wireDropdown('licenses-trigger');
  wireDropdown('guides-trigger');
</script>

<style>
  /* ── Kopfzeile ─────────────────────────────────────────────────────── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    /* Erst die deckende Rückfallebene (Browser ohne color-mix, z. B. iOS 15),
       dann die transluzente Fläche. */
    background: var(--h-paper);
    background: color-mix(in srgb, var(--h-paper) 78%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--h-line);
    transition: background-color 0.3s var(--h-ease), border-color 0.3s var(--h-ease);
  }
  :global(html.dark) .site-header {
    background: var(--h-deep);
    background: color-mix(in srgb, var(--h-deep) 78%, transparent);
  }
  /* Startseite ganz oben: Kopfzeile liegt über Papier, keine Fläche nötig.
     Nur mit JavaScript (h-js aus dem BaseLayout): Ohne Skript gäbe es kein
     is-scrolled, und die Kopfzeile stünde beim Scrollen durchsichtig über
     Foto und Navy-Abschnitten. Bei geöffnetem mobilen Menü bleibt sie Fläche,
     sonst stünde sie durchsichtig über dem abgedunkelten Hintergrund; ohne
     :has()-Unterstützung fällt die ganze Regel weg und die Kopfzeile ist
     immer Fläche (gute Degradation). */
  :global(html.h-js) .site-header[data-hero]:not(.is-scrolled):not(:has(.mobile-menu-panel.open)) {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .site-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }

  /* Logo */
  .logo-link {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--h-ink);
    text-decoration: none;
    border-radius: var(--h-r-sm);
  }
  .logo-link :global(img) { width: 28px; height: 28px; border-radius: 6px; }
  .logo-accent { color: var(--h-blue-ink); }

  /* Hauptnavigation */
  .site-nav { position: relative; display: none; align-items: center; gap: 28px; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: 500 15px/1 var(--h-sans);
    color: var(--h-text);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .nav-link:hover,
  .nav-dropdown:focus-within .nav-dropdown-trigger { color: var(--h-ink); }
  .nav-caret { opacity: 0.6; transition: transform 0.3s var(--h-ease); }
  .nav-dropdown:hover .nav-caret,
  .nav-dropdown:focus-within .nav-caret { transform: rotate(180deg); }

  /* Rechts: DE|EN- und Hell|Dunkel-Pille (Stil .h-seg in brand.css), CTA, Menü */
  .site-actions { display: flex; align-items: center; gap: 8px; }
  .site-cta { display: none; }
  .site-burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--h-r-sm);
  }
  .hamburger-line {
    display: block;
