---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import appIcon from '../assets/images/app-icon.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b" style="background: rgba(240,244,250,0.85); backdrop-filter: blur(20px); border-color: rgba(51,102,255,0.10);">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href={getLocalizedPath(lang, '/')} class="logo-link flex items-center gap-2 text-xl font-black" style="color: #1A1F36; letter-spacing: -0.5px; text-decoration: none;">
      <Image src={appIcon} alt="" width={56} height={56} style="width: 28px; height: 28px; border-radius: 6px;" />
      Boat<span style="color: #3366FF;">Pass</span>
    </a>

    <!-- Links -->
    <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'} class="hidden md:flex items-center gap-8">
      <a href={`${getLocalizedPath(lang, '/')}#features`} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {lang === 'de' ? 'Features' : 'Features'}
      </a>
      <a href={`${getLocalizedPath(lang, '/')}#pricing`} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {lang === 'de' ? 'Preise' : 'Pricing'}
      </a>

      <!-- Führerscheine / Licenses Dropdown -->
      <div class="nav-dropdown">
        <a id="licenses-trigger" href={lang === 'de' ? '/fuehrerscheine/' : '/en/licenses/'} class="text-sm font-medium nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" style="color: #6B7280; text-decoration:none; display:flex; align-items:center; gap:4px;">
          {lang === 'de' ? 'Führerscheine' : 'Licenses'} <span aria-hidden="true" style="font-size:10px;">▾</span>
        </a>
        <ul id="licenses-menu" class="nav-dropdown-menu">
          <li><a href={lang === 'de' ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/'} class="nav-dropdown-item" style="font-weight:700; color:#3366FF;">{lang === 'de' ? 'Welcher Schein? →' : 'Which licence? →'}</a></li>
          <li aria-hidden="true"><div style="height:1px; background:rgba(51,102,255,0.10); margin:4px 0;"></div></li>
          <li><a href={lang === 'de' ? '/sbf-binnen/' : '/en/sbf-inland/'} class="nav-dropdown-item">{lang === 'de' ? 'SBF Binnen' : 'SBF Inland'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-see/' : '/en/sbf-coastal/'} class="nav-dropdown-item">{lang === 'de' ? 'SBF See' : 'SBF Coastal'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-kosten/' : '/en/sbf-costs/'} class="nav-dropdown-item">{lang === 'de' ? 'SBF Kosten' : 'SBF Costs'}</a></li>
          <li><a href={lang === 'de' ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/'} class="nav-dropdown-item">{lang === 'de' ? 'Prüfung & Ablauf' : 'Exam & Process'}</a></li>
          <li aria-hidden="true"><div style="height:1px; background:rgba(51,102,255,0.10); margin:4px 0;"></div></li>
          <li><a href={lang === 'de' ? '/ubi/' : '/en/ubi/'} class="nav-dropdown-item">UBI</a></li>
          <li><a href={lang === 'de' ? '/src/' : '/en/src/'} class="nav-dropdown-item">SRC</a></li>
          <li><a href={lang === 'de' ? '/lrc/' : '/en/lrc/'} class="nav-dropdown-item">LRC</a></li>
          <li><span class="nav-dropdown-item nav-dropdown-soon">Bodenseeschifferpatent <span aria-hidden="true" style="font-size:12px;color:#3366FF;">{lang === 'de' ? 'bald' : 'soon'}</span></span></li>
        </ul>
      </div>

      <a href={getLocalizedPath(lang, '/blog/')} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {t.nav.blog}
      </a>
      <a href={getLocalizedPath(lang, '/faq/')} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {t.nav.faq}
      </a>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <div class="lang-switcher">
        <a href="/" class={`lang-option${lang === 'de' ? ' lang-active' : ''}`}>
          DE
        </a>
        <a href="/en/" class={`lang-option${lang === 'en' ? ' lang-active' : ''}`}>
          EN
        </a>
      </div>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 text-sm font-bold text-white px-5 py-2.5 rounded-full"
        style="background: #3366FF; box-shadow: 0 4px 14px rgba(51,102,255,0.25); text-decoration: none;">
        {t.nav.getApp}
      </a>

      <!-- Hamburger Button (Mobile only) -->
      <button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center items-center w-11 h-11 rounded-lg" style="background: rgba(51,102,255,0.06); border: 1px solid rgba(51,102,255,0.12);" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="mobile-menu-panel md:hidden" aria-hidden="true">
    <nav aria-label={lang === 'de' ? 'Mobile Navigation' : 'Mobile navigation'} class="px-4 pt-3 pb-5 flex flex-col gap-0.5">
      <a href={`${getLocalizedPath(lang, '/')}#features`} class="mobile-nav-link">
        {lang === 'de' ? 'Features' : 'Features'}
      </a>
      <a href={`${getLocalizedPath(lang, '/')}#pricing`} class="mobile-nav-link">
        {lang === 'de' ? 'Preise' : 'Pricing'}
      </a>

      <!-- Führerscheine Accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-trigger mobile-nav-link w-full text-left" aria-expanded="false" aria-controls="mobile-acc-body">
          <span>{lang === 'de' ? 'Führerscheine' : 'Licenses'}</span>
          <span class="accordion-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div id="mobile-acc-body" class="mobile-accordion-body">
          <div class="mobile-subnav">
            <a href={lang === 'de' ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/'} class="mobile-nav-sublink mobile-nav-sublink--cta">{lang === 'de' ? 'Welcher Schein? →' : 'Which licence? →'}</a>
            <div class="mobile-divider"></div>
            <a href={lang === 'de' ? '/sbf-binnen/' : '/en/sbf-inland/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF Binnen' : 'SBF Inland'}</a>
            <a href={lang === 'de' ? '/sbf-see/' : '/en/sbf-coastal/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF See' : 'SBF Coastal'}</a>
            <a href={lang === 'de' ? '/sbf-kosten/' : '/en/sbf-costs/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF Kosten' : 'SBF Costs'}</a>
            <a href={lang === 'de' ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/'} class="mobile-nav-sublink">{lang === 'de' ? 'Prüfung & Ablauf' : 'Exam & Process'}</a>
            <div class="mobile-divider"></div>
            <a href={lang === 'de' ? '/ubi/' : '/en/ubi/'} class="mobile-nav-sublink">UBI</a>
            <a href={lang === 'de' ? '/src/' : '/en/src/'} class="mobile-nav-sublink">SRC</a>
            <a href={lang === 'de' ? '/lrc/' : '/en/lrc/'} class="mobile-nav-sublink">LRC</a>
            <span class="mobile-nav-sublink mobile-nav-sublink--soon">Bodenseeschifferpatent <span class="soon-badge">{lang === 'de' ? 'bald' : 'soon'}</span></span>
          </div>
        </div>
      </div>

      <a href={getLocalizedPath(lang, '/blog/')} class="mobile-nav-link">
        {t.nav.blog}
      </a>
      <a href={getLocalizedPath(lang, '/faq/')} class="mobile-nav-link">
        {t.nav.faq}
      </a>

      <div class="mobile-menu-footer">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn">
          {t.nav.getApp}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Backdrop -->
<div id="mobile-menu-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  // Alle sichtbaren fokussierbaren Elemente im Menü (collapsed Accordion-Inhalte ausgeschlossen)
  function getFocusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    ).filter(el => {
      const body = el.closest<HTMLElement>('.mobile-accordion-body');
      if (!body) return true;
      return !!el.closest('.mobile-accordion')?.classList.contains('accordion-open');
    });
  }

  function openMenu() {
    menu?.classList.add('open');
    backdrop?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    // Fokus auf erstes Element setzen
    requestAnimationFrame(() => getFocusable()[0]?.focus());
  }

  function closeMenu() {
    menu?.classList.remove('open');
    backdrop?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // Fokus zurück auf Hamburger-Button
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    menu?.classList.contains('open') ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  // Escape schließt das Menü
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });

  // Focus-Trap innerhalb des mobilen Menüs
  menu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Menü schließt bei Klick auf Link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Accordion
  menu?.querySelectorAll('.mobile-accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const accordion = trigger.closest('.mobile-accordion');
      const isOpen = accordion?.classList.contains('accordion-open');
      if (isOpen) {
        accordion?.classList.remove('accordion-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        accordion?.classList.add('accordion-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Desktop Dropdown: aria-expanded per Fokus verwalten
  const dropdownTrigger = document.getElementById('licenses-trigger');
  const dropdownContainer = dropdownTrigger?.closest('.nav-dropdown');
  if (dropdownContainer && dropdownTrigger) {
    dropdownContainer.addEventListener('focusin', () => {
      dropdownTrigger.setAttribute('aria-expanded', 'true');
    });
    dropdownContainer.addEventListener('focusout', (e: FocusEvent) => {
      if (!dropdownContainer.contains(e.relatedTarget as Node)) {
        dropdownTrigger.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background: rgba(51,102,255,0.06);
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 100px;
    padding: 3px;
    gap: 2px;
  }
  .lang-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #6B7280;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 100px;
    transition: color 0.15s;
  }
  /* Touch-Fläche unsichtbar auf min. 44px Höhe erweitern (WCAG 2.5.5),
     ohne die sichtbare Pill-Größe zu verändern. */
  .lang-option::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 44px;
    min-height: 100%;
  }
  .lang-option:hover { color: #1A1F36; }
  .lang-active {
    background: white;
    color: #1A1F36 !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }

  .nav-link:hover { color: #1A1F36 !important; }

  .nav-dropdown { position: relative; }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 12px;
    padding: 8px;
    min-width: 150px;
    box-shadow: 0 8px 24px rgba(26,31,54,0.1);
    z-index: 100;
    list-style: none;
    margin: 0;
  }
  /* Unsichtbare Brücke über die 12px-Lücke, damit der Hover nicht abreißt */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu { display: flex; flex-direction: column; gap: 2px; }
  .nav-dropdown-item {
    font-size: 14px;
    font-weight: 500;
    color: #4B5563;
    text-decoration: none;
    padding: 11px 14px;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .nav-dropdown-item:hover { background: rgba(51,102,255,0.06); color: #1A1F36; }
  /* "bald"-Einträge ohne Zielseite: sichtbar, aber nicht klickbar */
  .nav-dropdown-soon { cursor: default; opacity: 0.55; }
  .nav-dropdown-soon:hover { background: none; color: #4B5563; }

  /* Hamburger lines */
  .hamburger-line {
    display: block;
    width: 18px;
    height: 2px;
    background: #1A1F36;
    border-radius: 2px;
    margin: 2px 0;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile Menu Panel */
  .mobile-menu-panel {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    background: rgba(240,244,250,0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(51,102,255,0.10);
    box-shadow: 0 12px 40px rgba(26,31,54,0.10);
    transform: translateY(-6px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.24s cubic-bezier(0.4,0,0.2,1), opacity 0.24s;
    z-index: 49;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }
  .mobile-menu-panel.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Backdrop */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(26,31,54,0.28);
    z-index: 48;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .mobile-backdrop.open { display: block; }

  /* Mobile nav links */
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 15px;
    font-weight: 600;
    color: #1A1F36;
    text-decoration: none;
    padding: 11px 12px;
    border-radius: 10px;
    background: none;
    border: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    width: 100%;
    letter-spacing: -0.1px;
  }
  .mobile-nav-link:hover { background: rgba(51,102,255,0.07); }

  /* Accordion */
  .accordion-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(51,102,255,0.09);
    color: #3366FF;
    transition: transform 0.22s cubic-bezier(0.4,0,0.2,1), background 0.2s, color 0.2s;
  }
  .mobile-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s cubic-bezier(0.4,0,0.2,1);
    overflow: hidden;
  }
  .mobile-accordion-body > .mobile-subnav {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 4px 0 6px 0;
  }
  .accordion-open .mobile-accordion-body {
    grid-template-rows: 1fr;
  }
  .accordion-open .accordion-chevron {
    transform: rotate(180deg);
    background: #3366FF;
    color: #fff;
  }

  /* Sublinks */
  .mobile-nav-sublink {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #4B5563;
    text-decoration: none;
    padding: 11px 12px 11px 32px;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s;
  }
  .mobile-nav-sublink:hover { background: rgba(51,102,255,0.07); color: #1A1F36; }
  .mobile-nav-sublink--cta {
    font-weight: 700;
    color: #3366FF;
  }
  .mobile-nav-sublink--cta:hover { color: #2952CC; }
  .mobile-nav-sublink--soon {
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
  }
  .soon-badge {
    font-size: 12px;
    font-weight: 700;
    color: #3366FF;
    background: rgba(51,102,255,0.12);
    border-radius: 100px;
    padding: 1px 7px;
    margin-left: 4px;
  }

  /* Divider */
  .mobile-divider {
    height: 1px;
    background: rgba(51,102,255,0.09);
    margin: 3px 12px;
  }

  @media (prefers-color-scheme: dark) {
    /* Header bar */
    header {
      background: rgba(10, 13, 20, 0.95) !important;
      border-color: rgba(90, 120, 255, 0.14) !important;
    }

    /* Logo */
    .logo-link { color: #E2E8F0 !important; }

    /* Desktop nav links */
    .nav-link { color: #94A3B8 !important; }
    .nav-link:hover { color: #E2E8F0 !important; }

    /* ── Lang-Switcher ─────────────────────────────────────────────────────
       Das war der konkrete Nutzerbericht: DE/EN nicht unterscheidbar.
       Lösung: aktive Pill bekommt soliden #3366FF-Hintergrund mit weißem Text,
       inaktive Pill bleibt transparent-grau → klare visuelle Trennung. */
    .lang-switcher {
      background: rgba(90, 120, 255, 0.12) !important;
      border-color: rgba(90, 120, 255, 0.24) !important;
    }
    .lang-option { color: #6B7280 !important; }
    .lang-option:hover { color: #E2E8F0 !important; }
    .lang-active {
      background: #3366FF !important;
      color: #ffffff !important;
      box-shadow: 0 1px 6px rgba(51, 102, 255, 0.40) !important;
    }

    /* Hamburger-Striche: dunkelnavy wird auf Handy unsichtbar → hellgrau */
    .hamburger-line { background: #C8D0E8 !important; }
    #mobile-menu-btn {
      background: rgba(90, 120, 255, 0.10) !important;
      border-color: rgba(90, 120, 255, 0.18) !important;
    }

    /* Desktop Dropdown-Menü */
    .nav-dropdown-menu {
      background: #1A2140 !important;
      border-color: rgba(90, 120, 255, 0.16) !important;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5) !important;
    }
    .nav-dropdown-item { color: #B4BCDA !important; }
    .nav-dropdown-item:hover {
      background: rgba(90, 120, 255, 0.10) !important;
      color: #E2E8F0 !important;
    }

    /* Mobiles Menü Panel */
    .mobile-menu-panel {
      background: rgba(10, 13, 20, 0.98) !important;
      border-color: rgba(90, 120, 255, 0.12) !important;
    }
    .mobile-nav-link { color: #E2E8F0 !important; }
    .mobile-nav-link:hover { background: rgba(90, 120, 255, 0.10) !important; }
    .mobile-nav-sublink { color: #94A3B8 !important; }
    .mobile-nav-sublink:hover {
      background: rgba(90, 120, 255, 0.10) !important;
      color: #E2E8F0 !important;
    }
    .mobile-divider { background: rgba(90, 120, 255, 0.10) !important; }
    .accordion-chevron { background: rgba(90, 120, 255, 0.14) !important; }
    .accordion-open .accordion-chevron { background: #3366FF !important; }
    .soon-badge {
      background: rgba(90, 120, 255, 0.20) !important;
      color: #8BB4FF !important;
    }
  }

  /* Footer with CTA */
  .mobile-menu-footer {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(51,102,255,0.09);
  }
  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: white;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 12px;
    background: #3366FF;
    box-shadow: 0 4px 16px rgba(51,102,255,0.28);
    transition: background 0.15s, box-shadow 0.15s, transform 0.15s;
    letter-spacing: -0.1px;
  }
  .mobile-cta-btn:hover {
    background: #2952CC;
    box-shadow: 0 6px 20px rgba(51,102,255,0.35);
    transform: translateY(-1px);
  }
</style>
