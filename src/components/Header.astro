---
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../i18n/index';
import Icon from './Icon.astro';
import appIcon from '../assets/images/app-icon.png';
import type { IconName } from '../icons';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
const de = lang === 'de';

/**
 * Mega-Menü-Struktur. Zwei Spalten mit Gruppenüberschrift plus eine Promo-Kachel.
 * Beschreibungen sind Teil der Navigation, nicht Deko: Sie machen die Einträge
 * scanbar, sobald ein Menü mehr als eine Handvoll Ziele hat.
 */
interface MegaItem { href: string; label: string; desc: string; icon: IconName; soon?: boolean }
interface MegaGroup { title: string; items: MegaItem[] }

const licensesGroups: MegaGroup[] = [
  {
    title: de ? 'Sportbootführerscheine' : 'Boating licences',
    items: [
      { href: de ? '/sbf-binnen/' : '/en/sbf-inland/', label: de ? 'SBF Binnen' : 'SBF Inland', desc: de ? 'Flüsse, Seen und Kanäle' : 'Rivers, lakes and canals', icon: 'waves' },
      { href: de ? '/sbf-see/' : '/en/sbf-coastal/', label: de ? 'SBF See' : 'SBF Coastal', desc: de ? 'Küstengewässer und Navigation' : 'Coastal waters and navigation', icon: 'anchor' },
      { href: '', label: de ? 'Bodenseeschifferpatent' : 'Lake Constance licence', desc: de ? 'In Vorbereitung' : 'In preparation', icon: 'compass', soon: true },
    ],
  },
  {
    title: de ? 'Funkzeugnisse' : 'Radio certificates',
    items: [
      { href: de ? '/ubi/' : '/en/ubi/', label: 'UBI', desc: de ? 'UKW-Sprechfunk Binnen' : 'VHF radio, inland waters', icon: 'wifi' },
      { href: de ? '/src/' : '/en/src/', label: 'SRC', desc: de ? 'Seefunk im Küstenbereich' : 'Marine radio, coastal', icon: 'satellite' },
      { href: de ? '/lrc/' : '/en/lrc/', label: 'LRC', desc: de ? 'Weltweiter Seefunk' : 'Worldwide marine radio', icon: 'globe' },
    ],
  },
];

const guidesGroups: MegaGroup[] = [
  {
    title: de ? 'Vorbereitung' : 'Preparation',
    items: [
      { href: de ? '/sbf-kosten/' : '/en/sbf-costs/', label: de ? 'SBF Kosten' : 'SBF costs', desc: de ? 'Alle Gebühren im Überblick' : 'Every fee at a glance', icon: 'banknotes' },
      { href: de ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/', label: de ? 'Prüfung & Ablauf' : 'Exam & process', desc: de ? 'Anmeldung bis Prüfungstag' : 'From registration to exam day', icon: 'clipboard' },
      { href: de ? '/sbf-binnen-pruefungsfragen/' : '/en/sbf-inland-exam-questions/', label: de ? 'Prüfungsfragen Binnen' : 'Inland exam questions', desc: de ? 'Amtlicher Katalog erklärt' : 'Official catalogue explained', icon: 'book' },
      { href: de ? '/sbf-see-pruefungsfragen/' : '/en/sbf-coastal-exam-questions/', label: de ? 'Prüfungsfragen See' : 'Coastal exam questions', desc: de ? 'Amtlicher Katalog erklärt' : 'Official catalogue explained', icon: 'document' },
    ],
  },
  {
    title: de ? 'App-Vergleich' : 'App comparison',
    items: [
      { href: de ? '/sbf-app/' : '/en/sbf-app/', label: de ? 'Alle Apps im Vergleich' : 'All apps compared', desc: de ? 'Sechs Apps nebeneinander' : 'Six apps side by side', icon: 'scale' },
      { href: de ? '/sbf-see-app/' : '/en/sbf-coastal-app/', label: de ? 'SBF-See-Apps' : 'SBF See apps', desc: de ? 'Mit Navigationsaufgaben' : 'With navigation tasks', icon: 'sailboat' },
      { href: de ? '/sbf-binnen-app/' : '/en/sbf-inland-app/', label: de ? 'SBF-Binnen-Apps' : 'SBF Binnen apps', desc: de ? 'Von gratis bis Monatsabo' : 'From free to monthly plans', icon: 'waves' },
      { href: de ? '/funkschein-app/' : '/en/radio-certificate-app/', label: de ? 'Funkschein-Apps' : 'Radio certificate apps', desc: de ? 'UBI, SRC und LRC' : 'UBI, SRC and LRC', icon: 'microphone' },
      { href: de ? '/sbf-app-kostenlos/' : '/en/sbf-app-free/', label: de ? 'Kostenlose Apps' : 'Free apps', desc: de ? 'Was wirklich gratis geht' : 'What is genuinely free', icon: 'creditCard' },
    ],
  },
];

const promo = {
  href: de ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/',
  eyebrow: de ? 'Tool' : 'Tool',
  title: de ? 'Welcher Schein passt zu dir?' : 'Which licence fits you?',
  desc: de ? 'Fünf Fragen, eine klare Empfehlung.' : 'Five questions, one clear answer.',
  cta: de ? 'Jetzt herausfinden' : 'Find out now',
};
---

<header class="fixed top-0 left-0 right-0 z-50 border-b" style="background: rgba(240,244,250,0.85); backdrop-filter: blur(20px); border-color: rgba(51,102,255,0.10);">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href={getLocalizedPath(lang, '/')} class="logo-link flex items-center gap-2 text-xl font-black" style="color: #1A1F36; letter-spacing: -0.5px; text-decoration: none;">
      <Image src={appIcon} alt="" width={56} height={56} style="width: 28px; height: 28px; border-radius: 6px;" />
      Boat<span style="color: #3366FF;">Pass</span>
    </a>

    <!-- Links -->
    <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'} class="hidden md:flex items-center gap-8">
      <a href={`${getLocalizedPath(lang, '/')}#features`} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {lang === 'de' ? 'Features' : 'Features'}
      </a>
      <a href={`${getLocalizedPath(lang, '/')}#pricing`} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {lang === 'de' ? 'Preise' : 'Pricing'}
      </a>

      <!-- Führerscheine / Licenses Dropdown -->
      <div class="nav-dropdown">
        <a id="licenses-trigger" href={lang === 'de' ? '/fuehrerscheine/' : '/en/licenses/'} class="text-sm font-medium nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" style="color: #6B7280; text-decoration:none; display:flex; align-items:center; gap:4px;">
          {lang === 'de' ? 'Führerscheine' : 'Licenses'} <span aria-hidden="true" style="font-size:10px;">▾</span>
        </a>
        <div id="licenses-menu" class="nav-mega">
          <div class="nav-mega-cols">
            {licensesGroups.map(group => (
              <div class="nav-mega-col">
                <div class="nav-mega-title">{group.title}</div>
                {group.items.map(item => (item.soon ? (
                  <span class="nav-mega-item nav-mega-item--soon">
                    <span class="nav-mega-icon"><Icon name={item.icon} size={17} stroke="#9CA3AF" strokeWidth={1.75} /></span>
                    <span class="nav-mega-text">
                      <span class="nav-mega-label">{item.label}<span class="nav-mega-soon">{de ? 'bald' : 'soon'}</span></span>
                      <span class="nav-mega-desc">{item.desc}</span>
                    </span>
                  </span>
                ) : (
                  <a href={item.href} class="nav-mega-item">
                    <span class="nav-mega-icon"><Icon name={item.icon} size={17} stroke="#3366FF" strokeWidth={1.75} /></span>
                    <span class="nav-mega-text">
                      <span class="nav-mega-label">{item.label}</span>
                      <span class="nav-mega-desc">{item.desc}</span>
                    </span>
                  </a>
                )))}
              </div>
            ))}
          </div>
          <a href={promo.href} class="nav-mega-promo">
            <span class="nav-mega-promo-eyebrow">{promo.eyebrow}</span>
            <span class="nav-mega-promo-title">{promo.title}</span>
            <span class="nav-mega-promo-desc">{promo.desc}</span>
            <span class="nav-mega-promo-cta">{promo.cta} <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>

      <!-- Ratgeber / Guides Dropdown -->
      <div class="nav-dropdown">
        <button id="guides-trigger" class="text-sm font-medium nav-link nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" style="color: #6B7280; background:none; border:none; cursor:pointer; display:flex; align-items:center; gap:4px; padding:0; font-family:inherit;">
          {lang === 'de' ? 'Ratgeber' : 'Guides'} <span aria-hidden="true" style="font-size:10px;">▾</span>
        </button>
        <div id="guides-menu" class="nav-mega">
          <div class="nav-mega-cols">
            {guidesGroups.map(group => (
              <div class="nav-mega-col">
                <div class="nav-mega-title">{group.title}</div>
                {group.items.map(item => (
                  <a href={item.href} class="nav-mega-item">
                    <span class="nav-mega-icon"><Icon name={item.icon} size={17} stroke="#3366FF" strokeWidth={1.75} /></span>
                    <span class="nav-mega-text">
                      <span class="nav-mega-label">{item.label}</span>
                      <span class="nav-mega-desc">{item.desc}</span>
                    </span>
                  </a>
                ))}
              </div>
            ))}
          </div>
          <a href={promo.href} class="nav-mega-promo">
            <span class="nav-mega-promo-eyebrow">{promo.eyebrow}</span>
            <span class="nav-mega-promo-title">{promo.title}</span>
            <span class="nav-mega-promo-desc">{promo.desc}</span>
            <span class="nav-mega-promo-cta">{promo.cta} <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>

      <a href={getLocalizedPath(lang, '/blog/')} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {t.nav.blog}
      </a>
      <a href={getLocalizedPath(lang, '/faq/')} class="text-sm font-medium nav-link" style="color: #6B7280; text-decoration: none;">
        {t.nav.faq}
      </a>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <div class="lang-switcher">
        <a href="/" class={`lang-option${lang === 'de' ? ' lang-active' : ''}`}>
          DE
        </a>
        <a href="/en/" class={`lang-option${lang === 'en' ? ' lang-active' : ''}`}>
          EN
        </a>
      </div>
      <!-- Theme Toggle (Icon-Pill matching lang-switcher) -->
      <button type="button" id="theme-toggle" class="theme-switcher" aria-pressed="false" aria-label={lang === 'de' ? 'Design wechseln' : 'Toggle theme'}>
        <span class="theme-option" id="theme-opt-light">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </span>
        <span class="theme-option" id="theme-opt-dark">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
      </button>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 text-sm font-bold text-white px-5 py-2.5 rounded-full"
        style="background: #3366FF; box-shadow: 0 4px 14px rgba(51,102,255,0.25); text-decoration: none;">
        {t.nav.getApp}
      </a>

      <!-- Hamburger Button (Mobile only) -->
      <button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center items-center w-11 h-11 rounded-lg" style="background: rgba(51,102,255,0.06); border: 1px solid rgba(51,102,255,0.12);" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="mobile-menu-panel md:hidden" aria-hidden="true">
    <nav aria-label={lang === 'de' ? 'Mobile Navigation' : 'Mobile navigation'} class="px-4 pt-3 pb-5 flex flex-col gap-0.5">
      <a href={`${getLocalizedPath(lang, '/')}#features`} class="mobile-nav-link">
        {lang === 'de' ? 'Features' : 'Features'}
      </a>
      <a href={`${getLocalizedPath(lang, '/')}#pricing`} class="mobile-nav-link">
        {lang === 'de' ? 'Preise' : 'Pricing'}
      </a>

      <!-- Führerscheine Accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-trigger mobile-nav-link w-full text-left" aria-expanded="false" aria-controls="mobile-acc-body">
          <span>{lang === 'de' ? 'Führerscheine' : 'Licenses'}</span>
          <span class="accordion-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div id="mobile-acc-body" class="mobile-accordion-body">
          <div class="mobile-subnav">
            <a href={lang === 'de' ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/'} class="mobile-nav-sublink mobile-nav-sublink--cta">{lang === 'de' ? 'Welcher Schein? →' : 'Which licence? →'}</a>
            <div class="mobile-divider"></div>
            <a href={lang === 'de' ? '/sbf-binnen/' : '/en/sbf-inland/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF Binnen' : 'SBF Inland'}</a>
            <a href={lang === 'de' ? '/sbf-see/' : '/en/sbf-coastal/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF See' : 'SBF Coastal'}</a>
            <div class="mobile-divider"></div>
            <a href={lang === 'de' ? '/ubi/' : '/en/ubi/'} class="mobile-nav-sublink">UBI</a>
            <a href={lang === 'de' ? '/src/' : '/en/src/'} class="mobile-nav-sublink">SRC</a>
            <a href={lang === 'de' ? '/lrc/' : '/en/lrc/'} class="mobile-nav-sublink">LRC</a>
            <span class="mobile-nav-sublink mobile-nav-sublink--soon">Bodenseeschifferpatent <span class="soon-badge">{lang === 'de' ? 'bald' : 'soon'}</span></span>
          </div>
        </div>
      </div>

      <!-- Ratgeber / Guides Accordion -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-trigger mobile-nav-link w-full text-left" aria-expanded="false" aria-controls="mobile-acc-guides-body">
          <span>{lang === 'de' ? 'Ratgeber' : 'Guides'}</span>
          <span class="accordion-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div id="mobile-acc-guides-body" class="mobile-accordion-body">
          <div class="mobile-subnav">
            <a href={lang === 'de' ? '/sbf-kosten/' : '/en/sbf-costs/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF Kosten' : 'SBF Costs'}</a>
            <a href={lang === 'de' ? '/sbf-pruefung-ablauf/' : '/en/sbf-exam/'} class="mobile-nav-sublink">{lang === 'de' ? 'Prüfung & Ablauf' : 'Exam & Process'}</a>
            <a href={lang === 'de' ? '/sbf-binnen-pruefungsfragen/' : '/en/sbf-inland-exam-questions/'} class="mobile-nav-sublink">{lang === 'de' ? 'Prüfungsfragen Binnen' : 'Inland Exam Questions'}</a>
            <a href={lang === 'de' ? '/sbf-see-pruefungsfragen/' : '/en/sbf-coastal-exam-questions/'} class="mobile-nav-sublink">{lang === 'de' ? 'Prüfungsfragen See' : 'Coastal Exam Questions'}</a>
            <a href={lang === 'de' ? '/sbf-app/' : '/en/sbf-app/'} class="mobile-nav-sublink">{lang === 'de' ? 'Alle Apps im Vergleich' : 'All Apps Compared'}</a>
            <a href={lang === 'de' ? '/sbf-see-app/' : '/en/sbf-coastal-app/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF-See-Apps' : 'SBF See Apps'}</a>
            <a href={lang === 'de' ? '/sbf-binnen-app/' : '/en/sbf-inland-app/'} class="mobile-nav-sublink">{lang === 'de' ? 'SBF-Binnen-Apps' : 'SBF Binnen Apps'}</a>
            <a href={lang === 'de' ? '/funkschein-app/' : '/en/radio-certificate-app/'} class="mobile-nav-sublink">{lang === 'de' ? 'Funkschein-Apps' : 'Radio Certificate Apps'}</a>
            <a href={lang === 'de' ? '/sbf-app-kostenlos/' : '/en/sbf-app-free/'} class="mobile-nav-sublink">{lang === 'de' ? 'Kostenlose Apps' : 'Free Apps'}</a>
          </div>
        </div>
      </div>

      <a href={getLocalizedPath(lang, '/blog/')} class="mobile-nav-link">
        {t.nav.blog}
      </a>
      <a href={getLocalizedPath(lang, '/faq/')} class="mobile-nav-link">
        {t.nav.faq}
      </a>

      <div class="mobile-menu-footer">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn">
          {t.nav.getApp}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Backdrop -->
<div id="mobile-menu-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  // Alle sichtbaren fokussierbaren Elemente im Menü (collapsed Accordion-Inhalte ausgeschlossen)
  function getFocusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    ).filter(el => {
      const body = el.closest<HTMLElement>('.mobile-accordion-body');
      if (!body) return true;
      return !!el.closest('.mobile-accordion')?.classList.contains('accordion-open');
    });
  }

  function openMenu() {
    menu?.classList.add('open');
    backdrop?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    // Fokus auf erstes Element setzen
    requestAnimationFrame(() => getFocusable()[0]?.focus());
  }

  function closeMenu() {
    menu?.classList.remove('open');
    backdrop?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    // Fokus zurück auf Hamburger-Button
    btn?.focus();
  }

  btn?.addEventListener('click', () => {
    menu?.classList.contains('open') ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  // Escape schließt das Menü
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });

  // Focus-Trap innerhalb des mobilen Menüs
  menu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Menü schließt bei Klick auf Link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Accordion
  menu?.querySelectorAll('.mobile-accordion-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const accordion = trigger.closest('.mobile-accordion');
      const isOpen = accordion?.classList.contains('accordion-open');
      if (isOpen) {
        accordion?.classList.remove('accordion-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        accordion?.classList.add('accordion-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Desktop Dropdown: aria-expanded per Fokus verwalten
  function wireDropdown(triggerId: string) {
    const trigger = document.getElementById(triggerId);
    const container = trigger?.closest('.nav-dropdown');
    if (!container || !trigger) return;
    container.addEventListener('focusin', () => trigger.setAttribute('aria-expanded', 'true'));
    container.addEventListener('focusout', (e: FocusEvent) => {
      if (!container.contains(e.relatedTarget as Node)) trigger.setAttribute('aria-expanded', 'false');
    });
  }
  wireDropdown('licenses-trigger');
  wireDropdown('guides-trigger');

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  const themeOptLight = document.getElementById('theme-opt-light');
  const themeOptDark = document.getElementById('theme-opt-dark');

  function syncThemeToggle() {
    const isDark = document.documentElement.classList.contains('dark');
    themeOptLight?.classList.toggle('theme-option-active', !isDark);
    themeOptDark?.classList.toggle('theme-option-active', isDark);
    themeToggle?.setAttribute('aria-pressed', String(isDark));
  }

  themeToggle?.addEventListener('click', (e) => {
    const clicked = (e.target as Element).closest('#theme-opt-light, #theme-opt-dark');
    let isDark: boolean;
    if (clicked?.id === 'theme-opt-light') {
      isDark = false;
      document.documentElement.classList.remove('dark');
    } else if (clicked?.id === 'theme-opt-dark') {
      isDark = true;
      document.documentElement.classList.add('dark');
    } else {
      isDark = document.documentElement.classList.toggle('dark');
    }
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeToggle();
  });

  syncThemeToggle();
</script>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    background: rgba(51,102,255,0.06);
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 100px;
    padding: 3px;
    gap: 2px;
  }
  .lang-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #6B7280;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 100px;
    transition: color 0.15s;
  }
