---
import { useTranslations } from '../i18n/index';
import Icon from './Icon.astro';
import type { IconName } from '../icons';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps: { icon: IconName; label: string; desc: string }[] = [
  { icon: 'document', label: t.roadmap.step1, desc: t.roadmap.step1Desc },
  { icon: 'clipboard', label: t.roadmap.step2, desc: t.roadmap.step2Desc },
  { icon: 'book', label: t.roadmap.step3, desc: t.roadmap.step3Desc },
  { icon: 'sailboat', label: t.roadmap.step4, desc: t.roadmap.step4Desc },
];
---

<section id="roadmap" class="max-w-6xl mx-auto px-6 py-24">
  <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; margin-bottom:48px; max-width:620px;">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
      {t.roadmap.chip}
    </div>
    <h2 style="font-size:42px; font-weight:900; letter-spacing:-2px; color:#1A1F36; line-height:1.1; margin-bottom:14px;">{t.roadmap.title}</h2>
    <p style="font-size:16px; color:#6B7280; line-height:1.65;">{t.roadmap.subtitle}</p>
  </div>

  <div class="road-grid">
    {steps.map((step, i) => (
      <div class="road-step reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
        <div class="road-top">
          <div class="road-num">{i + 1}</div>
          <div class="road-icon">
            <Icon name={step.icon} size={22} stroke="#3366FF" strokeWidth={1.75} />
          </div>
        </div>
        <h3 style="font-size:16px; font-weight:800; color:#1A1F36; margin:18px 0 8px; letter-spacing:-0.2px;">{step.label}</h3>
        <p style="font-size:14px; color:#6B7280; line-height:1.65; margin:0;">{step.desc}</p>
      </div>
    ))}
  </div>

  <!-- Positionierung gegenüber Bootsschulen: Partner, nicht Konkurrent -->
  <div class="partner-note reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
    <Icon name="lifebuoy" size={20} stroke="#3366FF" strokeWidth={1.75} />
    <p style="font-size:14px; color:#4B5563; line-height:1.65; margin:0;">{t.roadmap.partnerNote}</p>
  </div>
</section>

<style>
  .road-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .road-step {
    background: white;
    border: 1px solid rgba(51,102,255,0.10);
    border-radius: 20px;
    padding: 26px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, opacity 0.6s ease;
  }
  .road-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(26,31,54,0.08);
    border-color: rgba(51,102,255,0.18);
  }
  .road-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .road-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #3366FF;
    color: white;
    font-size: 15px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(51,102,255,0.25);
    flex-shrink: 0;
  }
  .road-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(51,102,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
  }
  .partner-note {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 24px;
    background: linear-gradient(160deg, #F4F7FE 0%, #EAF0FC 100%);
    border: 1px solid rgba(51,102,255,0.16);
    border-radius: 16px;
    padding: 20px 24px;
  }
  .partner-note :global(svg) { flex-shrink: 0; margin-top: 1px; }
  @media (max-width: 900px) {
    .road-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .road-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.opacity = '1';
        (e.target as HTMLElement).style.transform = 'translateY(0)';
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#roadmap .reveal-item').forEach(el => obs.observe(el));
</script>
