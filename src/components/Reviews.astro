---
// Echte Google-Play-Rezensionen. Vorerst nur auf der deutschen Startseite –
// alle vorliegenden Texte sind deutschsprachig, und eine übersetzte Rezension
// wäre keine Rezension mehr.
//
// Gesetzt wie Zitate in einer Zeitung: Haarlinien statt Karten, kein Laufband,
// keine Initialen-Kreise. Wer das Bestehen selbst erwähnt hat, bekommt einen
// Stempel – in Stempelfarbe, wie auf einem amtlichen Bescheid.
import { REVIEWS_DE, formatReviewDate } from '../data/reviews';
import { getBoatpassRating, formatRating } from '../data/apps';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.boatpass.app';
const rating = getBoatpassRating();
const score = rating ? formatRating(rating.score).replace('.', ',') : null;
const [featured, ...rest] = REVIEWS_DE;
---

<section class="rv-section">
  <div class="rv-inner">
    <header class="rv-head">
      <h2 class="display rv-title">Was Lernende schreiben</h2>
      <p class="rv-sub">Unverändert aus dem Play Store übernommen, mit Datum und Sternzahl. Nachlesen kannst du sie dort selbst.</p>
      {rating && (
        <p class="rv-agg">
          <span class="rv-agg-score num">{score}</span>
          <span class="rv-agg-meta">
            <span class="rv-stars" aria-hidden="true">★★★★★</span>
            <span>aus {rating.ratings} Bewertungen bei Google Play</span>
          </span>
        </p>
      )}
      <a class="rv-link" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
        Alle Bewertungen ansehen <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="rv-body">
      <figure class="rv rv--featured">
        <div class="rv-stars" role="img" aria-label={`${featured.stars} von 5 Sternen`}>
          <span aria-hidden="true">{'★'.repeat(featured.stars)}</span>
        </div>
        <blockquote class="rv-text">„{featured.excerpt ?? featured.text}“</blockquote>
        <figcaption class="rv-meta">
          <span class="rv-name">{featured.name}</span>
          <time class="rv-date" datetime={featured.date}>{formatReviewDate(featured.date)}</time>
        </figcaption>
        {featured.passed && <span class="rv-stamp">{featured.passed}</span>}
      </figure>

      <div class="rv-grid snap-row" data-snap-row="reviews" aria-label="Weitere Bewertungen von Lernenden">
        {rest.map(r => (
          <figure class="rv snap-item">
            <div class="rv-stars" role="img" aria-label={`${r.stars} von 5 Sternen`}>
              <span aria-hidden="true">{'★'.repeat(r.stars)}</span>
            </div>
            <blockquote class="rv-text">„{r.excerpt ?? r.text}“</blockquote>
            <figcaption class="rv-meta">
              <span class="rv-name">{r.name}</span>
              <time class="rv-date" datetime={r.date}>{formatReviewDate(r.date)}</time>
            </figcaption>
            {r.passed && <span class="rv-stamp">{r.passed}</span>}
          </figure>
        ))}
      </div>
      <div class="snap-dots" data-snap-dots="reviews"></div>
    </div>
  </div>
</section>

<style>
  .rv-section { color: var(--ink); }
  .rv-inner { max-width: 1200px; margin-inline: auto; padding: 72px 24px 72px; }

  .rv-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem); margin-bottom: 16px; }
  .rv-sub { font-size: 16px; line-height: 1.55; color: var(--ink-2); max-width: 28em; margin-bottom: 26px; }

  .rv-agg {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    border-block: 1px solid var(--rule);
    margin-bottom: 8px;
  }
  .rv-agg-score { font-size: 56px; font-weight: 780; font-stretch: 76%; line-height: 0.9; }
  .rv-agg-meta { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--ink-2); line-height: 1.3; }
  .rv-stars { color: #C98A00; font-size: 14px; letter-spacing: 2px; line-height: 1; }
  :global(html.dark) .rv-stars { color: #E7B43C; }

  .rv-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--link);
    font-size: 15px;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .rv-link:hover { text-decoration-thickness: 2px; }

  .rv { position: relative; margin: 0; }
  .rv-text { margin: 12px 0 14px; font-size: 16.5px; line-height: 1.55; }
  .rv-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 13.5px; }
  .rv-name { font-weight: 700; }
  .rv-date { color: var(--ink-2); }

  .rv--featured { padding: 28px 0 32px; border-top: 1px solid var(--ink); }
  .rv--featured .rv-text {
    font-size: clamp(1.45rem, 1.1rem + 1.3vw, 2.2rem);
    font-weight: 600;
    font-stretch: 86%;
    line-height: 1.22;
    letter-spacing: -0.005em;
    max-width: 26em;
  }

  /* Stempel „… bestanden": doppelter Rand, leicht schief, Stempelfarbe. */
  .rv-stamp {
    display: inline-block;
    margin-top: 16px;
    padding: 5px 10px 4px;
    border: 2px solid currentColor;
    outline: 1px solid currentColor;
    outline-offset: 2px;
    border-radius: 3px;
    color: var(--stamp);
    font-size: 12px;
    font-weight: 780;
    font-stretch: 82%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-4deg);
    transform-origin: left center;
    opacity: 0.92;
  }
  .rv--featured .rv-stamp { font-size: 14px; }

  .rv-grid .rv { padding: 22px 0 26px; border-top: 1px solid var(--rule-2); }

  /* Handy: weitere Rezensionen als Wisch-Reihe mit Rahmen. */
  @media (max-width: 768px) {
    .rv-grid { display: flex; gap: 12px; align-items: stretch; }
    .rv-grid .rv {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--rule-2);
      border-radius: 3px;
      padding: 20px 20px 22px;
      background: var(--sheet);
    }
    .rv-grid .rv-text { flex: 1; }
    .rv-grid .rv-stamp { align-self: flex-start; }
    .snap-dots :global(.snap-dot::after) { background: var(--rule-2); }
    .snap-dots :global(.snap-dot[aria-current="true"]::after) { background: var(--ink); }
  }

  @media (min-width: 769px) {
    .rv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  }
  @media (min-width: 1024px) {
    .rv-inner {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 72px;
      padding: 104px 40px 104px;
      align-items: start;
    }
    .rv-head { position: sticky; top: 96px; }
    .rv-title { font-size: clamp(2.5rem, 1.2rem + 2.4vw, 3.6rem); }
  }
</style>

<script>
  import { initSnapDots } from '../scripts/snapDots';
  initSnapDots('[data-snap-row="reviews"]');
</script>
