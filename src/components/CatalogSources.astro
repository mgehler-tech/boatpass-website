---
import { useTranslations } from '../i18n/index';

type LicenseKey = 'binnen' | 'see' | 'src' | 'lrc' | 'ubi';

interface Props {
  lang: 'de' | 'en';
  // Wenn gesetzt: kompakter Einzel-Block für genau eine Lizenz (für Lizenz-Seiten).
  only?: LicenseKey;
}

const { lang, only } = Astro.props;
const t = useTranslations(lang);

// "Stand dieser Übersicht" wird beim Build aus dem aktuellen Datum gesetzt –
// so ist die Angabe bei jedem Deploy ehrlich aktuell.
const now = new Date();
const monthsDe = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const monthsEn = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const pageStand = lang === 'de'
  ? `${monthsDe[now.getMonth()]} ${now.getFullYear()}`
  : `${monthsEn[now.getMonth()]} ${now.getFullYear()}`;

// Lizenz-Namen, Stände und ELWIS-Links sind amtlich verifiziert (Stand Juni 2026).
// Verlinkt sind die kanonischen ELWIS-Seiten, die stets die gültige Fassung zeigen.
const rows: { key: LicenseKey; license: string; catalog: string; stand: string; next?: string; url: string }[] = [
  { key: 'binnen', license: 'SBF Binnen', catalog: t.catalogSources.binnenCat, stand: t.catalogSources.binnenStand, url: 'https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-Binnen/Fragenkatalog-Binnen-neu-node.html' },
  { key: 'see', license: 'SBF See', catalog: t.catalogSources.seeCat, stand: t.catalogSources.seeStand, url: 'https://www.elwis.de/DE/Sportschifffahrt/Sportbootfuehrerscheine/Fragenkatalog-See/Fragenkatalog-See-neu-node.html' },
  { key: 'src', license: 'SRC', catalog: t.catalogSources.srcCat, stand: t.catalogSources.srcStand, url: 'https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Fragenkatalog-SRC-2018.html' },
  { key: 'lrc', license: 'LRC', catalog: t.catalogSources.lrcCat, stand: t.catalogSources.lrcStand, url: 'https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Fragenkatalog-LRC-2018.html' },
  { key: 'ubi', license: 'UBI', catalog: t.catalogSources.ubiCat, stand: t.catalogSources.ubiStand, next: t.catalogSources.ubiNext, url: 'https://www.elwis.de/DE/Schifffahrtsrecht/Sprechfunkzeugnisse/Sprechfunkzeugnisse-node.html' },
];

const single = only ? rows.find(r => r.key === only) : null;
---

{single ? (
  <div class="cat-single">
    <div class="cat-single-head">
      <span style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:4px 10px; border-radius:100px;">
        {t.catalogSources.chip}
      </span>
      <span class="cat-single-pills">
        <span class="stand-pill">{single.stand}</span>
        {single.next && <span class="stand-pill stand-pill-next">{single.next}</span>}
      </span>
    </div>
    <h3 class="cat-single-title">{t.catalogSources.singleTitle}</h3>
    <p class="cat-single-name">{single.catalog}</p>
    <a href={single.url} target="_blank" rel="noopener nofollow" class="src-link">{t.catalogSources.sourceCta}&nbsp;↗</a>
    <p class="cat-single-note">{t.catalogSources.validityNote}</p>
    <p class="cat-single-foot">
      <strong>{t.catalogSources.pageStandLabel}:</strong> {pageStand} · {t.catalogSources.disclaimer}
    </p>
  </div>
) : (

<section id="catalog-sources" class="max-w-6xl mx-auto px-6 py-12 md:py-20">
  <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; margin-bottom:32px; max-width:640px;">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(51,102,255,0.08); border:1px solid rgba(51,102,255,0.18); color:#3366FF; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:5px 12px; border-radius:100px; margin-bottom:16px;">
      {t.catalogSources.chip}
    </div>
    <h2 style="font-size:36px; font-weight:900; letter-spacing:-1.6px; color:#1A1F36; line-height:1.12; margin-bottom:14px;">{t.catalogSources.title}</h2>
    <p style="font-size:16px; color:#6B7280; line-height:1.65;">{t.catalogSources.intro}</p>
  </div>

  <div class="reveal-item" style="opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease;">
    <!-- Desktop: Tabelle -->
    <div class="cat-table-wrap">
      <table class="cat-table">
        <thead>
          <tr>
            <th>{t.catalogSources.colLicense}</th>
            <th>{t.catalogSources.colCatalog}</th>
            <th>{t.catalogSources.colStand}</th>
            <th>{t.catalogSources.colSource}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr>
              <td><span class="lic-badge">{r.license}</span></td>
              <td class="cat-name">{r.catalog}</td>
              <td>
                <span class="cat-cell-pills">
                  <span class="stand-pill">{r.stand}</span>
                  {r.next && <span class="stand-pill stand-pill-next">{r.next}</span>}
                </span>
              </td>
              <td>
                <a href={r.url} target="_blank" rel="noopener nofollow" class="src-link">{t.catalogSources.sourceCta}&nbsp;↗</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile: Karten -->
    <div class="cat-cards">
      {rows.map(r => (
        <div class="cat-card">
          <div class="cat-card-top">
            <span class="lic-badge">{r.license}</span>
            <span class="cat-card-pills">
              <span class="stand-pill">{r.stand}</span>
              {r.next && <span class="stand-pill stand-pill-next">{r.next}</span>}
            </span>
          </div>
          <div class="cat-name" style="margin:10px 0 12px;">{r.catalog}</div>
          <a href={r.url} target="_blank" rel="noopener nofollow" class="src-link">{t.catalogSources.sourceCta}&nbsp;↗</a>
        </div>
      ))}
    </div>

    <!-- Erklärung der Datumsangaben + Herausgeber-Hinweis + Stand der Übersicht -->
    <div class="cat-foot">
      <p class="validity-note">{t.catalogSources.validityNote}</p>
      <p class="issuer-note">{t.catalogSources.issuerNote}</p>
      <div class="foot-meta">
        <span class="page-stand"><strong>{t.catalogSources.pageStandLabel}:</strong> {pageStand}</span>
        <span class="disclaimer">{t.catalogSources.disclaimer}</span>
      </div>
    </div>
  </div>
</section>
)}

<style>
  /* Einzel-Lizenz-Block (für Lizenz-Seiten) */
  .cat-single {
    background: white;
    border: 1px solid rgba(51,102,255,0.14);
    border-radius: 18px;
    padding: 26px 28px;
    box-shadow: 0 16px 40px rgba(26,31,54,0.05);
  }
  .cat-single-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }
  .cat-single-title {
    font-size: 19px;
    font-weight: 800;
    color: #1A1F36;
    letter-spacing: -0.4px;
    margin: 0 0 6px;
  }
  .cat-single-name {
    font-size: 15px;
    color: #4B5563;
    line-height: 1.55;
    margin: 0 0 14px;
  }
  .cat-single-note {
    font-size: 13px;
    color: #4B5563;
    line-height: 1.6;
    margin: 16px 0 0;
  }
  .cat-single-foot {
    font-size: 12px;
    color: #9097A6;
    line-height: 1.6;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(51,102,255,0.08);
  }
  .cat-single-foot strong { color: #4B5563; }

  .cat-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 18px;
    background: white;
    box-shadow: 0 16px 40px rgba(26,31,54,0.05);
  }
  .cat-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    min-width: 640px;
  }
  .cat-table thead th {
    text-align: left;
    padding: 16px 20px;
    font-size: 12px;
    font-weight: 700;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    background: rgba(26,31,54,0.03);
    border-bottom: 1px solid rgba(51,102,255,0.10);
  }
  .cat-table tbody td {
    padding: 16px 20px;
    border-top: 1px solid rgba(51,102,255,0.08);
    vertical-align: middle;
  }
  .cat-name { color: #4B5563; line-height: 1.5; }
  .lic-badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    color: #1A1F36;
    background: rgba(51,102,255,0.08);
    border: 1px solid rgba(51,102,255,0.16);
    border-radius: 8px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .stand-pill {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: #047857;
    background: rgba(16,185,129,0.10);
    border: 1px solid rgba(16,185,129,0.28);
    border-radius: 100px;
    padding: 4px 12px;
    white-space: nowrap;
  }
  /* Künftige Fassung (z. B. UBI ab 01.10.2026): bernsteinfarben, signalisiert "kommt noch". */
  .stand-pill-next {
    color: #B45309;
    background: rgba(245,158,11,0.10);
    border-color: rgba(245,158,11,0.30);
  }
  .cat-single-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-start;
  }
  .cat-card-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-start;
  }
  .cat-cell-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .src-link {
    font-size: 13px;
    font-weight: 700;
    color: #3366FF;
    text-decoration: none;
    white-space: nowrap;
  }
  .src-link:hover { text-decoration: underline; }

  .cat-cards { display: none; }
  .cat-card {
    background: white;
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 16px;
    padding: 18px;
  }
  .cat-card-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .cat-foot { margin-top: 24px; }
  .validity-note {
    font-size: 14px;
    color: #1A1F36;
    line-height: 1.65;
    font-weight: 500;
    background: rgba(51,102,255,0.05);
    border: 1px solid rgba(51,102,255,0.12);
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 16px;
  }
  .issuer-note {
    font-size: 13px;
    color: #6B7280;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .foot-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
  }
  .page-stand { font-size: 13px; color: #4B5563; white-space: nowrap; }
  .page-stand strong { color: #1A1F36; }
  .disclaimer { font-size: 12px; color: #9097A6; line-height: 1.55; }

  @media (max-width: 760px) {
    .cat-table-wrap { display: none; }
    .cat-cards { display: flex; flex-direction: column; gap: 12px; }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.opacity = '1';
        (e.target as HTMLElement).style.transform = 'translateY(0)';
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#catalog-sources .reveal-item').forEach(el => obs.observe(el));
</script>
