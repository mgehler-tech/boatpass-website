---
/**
 * FAQ der Startseite (DE und EN). Die Fragen kommen von der Seite, weil sie
 * dort auch das FAQPage-Schema speisen – Anzeige und Schema bleiben so eins.
 *
 * Akkordeon mit Haarlinien statt Karten. Die Antworten bleiben im DOM, das
 * Schema ist davon unberührt; aufgeklappt wird mit dem nativen <details>.
 */
interface Props {
  lang: 'de' | 'en';
  faqs: { q: string; a: string }[];
}
const { lang, faqs } = Astro.props;
const de = lang === 'de';
---

<section class="faq">
  <div class="faq-inner">
    <header class="faq-head">
      <h2 class="display faq-title">{de ? 'Häufig gestellte Fragen' : 'Frequently Asked Questions'}</h2>
      <p class="faq-more">
        {de ? (
          <>Weitere Antworten findest du in den <a href="/faq/">häufigen Fragen zum Sportbootführerschein</a>.</>
        ) : (
          <>Find more answers in the <a href="/en/faq/">German boating license FAQ</a>.</>
        )}
      </p>
    </header>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">
            <h3>{f.q}</h3>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { color: var(--ink); border-top: 1px solid var(--ink); }
  .faq-inner { max-width: 1200px; margin-inline: auto; padding: 64px 24px 56px; display: grid; gap: 28px; }
  .faq-title { font-size: clamp(2.3rem, 1.6rem + 2.8vw, 3.8rem); margin-bottom: 14px; }
  .faq-more { font-size: 15px; line-height: 1.6; color: var(--ink-2); max-width: 24em; }
  .faq-more a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }

  .faq-list { border-top: 2px solid var(--ink); }
  .faq-item { border-bottom: 1px solid var(--rule-2); }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q h3 { font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem); font-weight: 700; font-stretch: 88%; line-height: 1.25; margin: 0; }
  .faq-q:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; }

  /* Plus, das beim Öffnen zum Minus wird – zwei gezeichnete Striche. */
  .faq-icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .faq-icon::before, .faq-icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease;
  }
  .faq-icon::after { transform: rotate(90deg); }
  .faq-item[open] .faq-icon::after { transform: rotate(0deg); }

  .faq-a { padding: 0 0 22px; font-size: 16px; line-height: 1.65; color: var(--ink-2); max-width: 44em; }

  @media (min-width: 900px) {
    .faq-inner { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 72px; padding: 104px 40px 96px; align-items: start; }
    .faq-title { font-size: clamp(2.3rem, 1.2rem + 2.2vw, 3.3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-icon::before, .faq-icon::after { transition: none; }
  }
</style>
