---
// Persönliche Vorstellung. Stand bisher nur unter "Über uns", wo sie kaum
// jemand erreicht.
//
// Das echte Foto bekommt Platz: groß, rechteckig, ohne Karten-Rahmen. Die
// Belege (amtliche Fragen, persönlicher Support) als schlichte Liste statt
// Chips. Keine Angaben über Beteiligte, die es nicht gibt.
import { useTranslations } from '../i18n/index';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const aboutUrl = lang === 'de' ? '/ueber-uns/' : '/en/about/';
---

<section class="fn">
  <div class="fn-inner">
    <img
      class="fn-photo"
      src="/ueber-uns.webp"
      alt={t.founder.imageAlt}
      width="1000"
      height="750"
      loading="lazy"
      decoding="async"
    />
    <div class="fn-text">
      <h2 class="display fn-title">{t.founder.title}</h2>
      <p class="fn-role">{t.founder.role}</p>
      <p class="fn-intro">{t.founder.intro}</p>
      <ul class="fn-facts">
        <li>{t.founder.chip1}</li>
        <li>{t.founder.chip2}</li>
      </ul>
      <a class="fn-link" href={aboutUrl}>{t.founder.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .fn { background: var(--paper-2); border-top: 1px solid var(--ink); color: var(--ink); }
  .fn-inner { max-width: 1200px; margin-inline: auto; padding: 0 0 64px; display: grid; gap: 32px; }

  .fn-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 30%;
  }
  .fn-text { padding-inline: 24px; }
  .fn-title { font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem); margin-bottom: 10px; }
  .fn-role {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 22px;
  }
  .fn-intro { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.55; max-width: 30em; margin-bottom: 22px; }

  .fn-facts { list-style: none; margin: 0 0 22px; padding: 0; border-top: 1px solid var(--rule-2); max-width: 30em; }
  .fn-facts li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule-2);
    font-size: 16px;
    font-weight: 650;
  }
  /* Häkchen gezeichnet statt Icon-Kachel */
  .fn-facts li::before {
    content: "";
    width: 12px;
    height: 7px;
    margin-top: -4px;
    border-left: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(-45deg);
    flex-shrink: 0;
  }

  .fn-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--link);
    font-size: 16px;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .fn-link:hover { text-decoration-thickness: 2px; }

  /* Desktop: Foto läuft links bis an den Bildschirmrand, der Text endet an
     der rechten Kante der 1200er-Inhaltsspalte. */
  @media (min-width: 900px) {
    .fn-inner {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
      padding: 0;
    }
    .fn-photo { height: 100%; min-height: 540px; aspect-ratio: auto; }
    .fn-text { padding: 80px max(40px, calc((100vw - 1200px) / 2)) 80px 0; }
  }
</style>
