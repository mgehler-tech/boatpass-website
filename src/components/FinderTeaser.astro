---
// Teaser für den Bootsführerschein-Finder. Verlinkt bewusst nur auf die
// Tool-Seite statt den interaktiven Konfigurator zu duplizieren – so bleibt die
// Entscheidungslogik eine einzige Quelle der Wahrheit.
//
// Gestaltet als Formular-Ausschnitt auf Flachwasser-Blau: die drei Fragen des
// Finders als leere Zeilen zum Ausfüllen. Die ganze Fläche ist ein Link.
interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;

const finderUrl = lang === 'de' ? '/tools/welcher-bootsfuehrerschein/' : '/en/tools/which-boating-license/';
const questions = lang === 'de'
  ? ['Revier', 'Motorleistung', 'Funk']
  : ['Waters', 'Engine power', 'Radio'];
const t = {
  de: {
    chip: 'Kostenloser Finder',
    title: ['Welchen Bootsführerschein ', 'brauchst du wirklich?'],
    sub: '3 kurze Fragen zu Revier, Motorleistung und Funk – und du weißt in 30 Sekunden, welcher Schein (SBF Binnen, SBF See) und welches Funkzeugnis (UBI, SRC, LRC) zu deinem Vorhaben passt.',
    button: 'Finder starten',
  },
  en: {
    chip: 'Free finder',
    title: ['Which boating licence ', 'do you really need?'],
    sub: '3 quick questions about your waters, engine power and radio – and in 30 seconds you’ll know which licence (SBF Inland, SBF Coastal) and radio certificate (UBI, SRC, LRC) fits your plans.',
    button: 'Start finder',
  },
}[lang];
---

<section id="finder-teaser" class="ft">
  <a href={finderUrl} class="ft-link" aria-label={lang === 'de' ? 'Welchen Bootsführerschein brauchst du wirklich? – Finder starten' : 'Which boating licence do you really need? – Start finder'}>
    <svg class="ft-contours" viewBox="0 0 600 400" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
      <path d="M620,40 C520,60 470,20 400,70 S300,160 250,230 S180,330 120,420" />
      <path d="M620,110 C540,120 500,90 450,140 S360,220 320,280 S260,370 220,420" />
      <path d="M620,190 C560,190 540,170 500,210 S430,270 400,320 S360,390 340,420" />
      <path class="ft-dash" d="M620,270 C580,270 570,250 550,280 S500,340 480,380 S470,410 460,420" />
    </svg>
    <div class="ft-inner">
      <div class="ft-copy">
        <p class="ft-label">{t.chip}</p>
        <h2 class="display ft-title">{t.title[0]}<br>{t.title[1]}</h2>
        <p class="ft-sub">{t.sub}</p>
      </div>
      <ol class="ft-form" aria-hidden="true">
        {questions.map((q, i) => (
          <li class="ft-row">
            <span class="ft-row-num">{i + 1}</span>
            <span class="ft-row-q">{q}</span>
            <span class="ft-row-line"></span>
          </li>
        ))}
      </ol>
      <span class="ft-button">
        {t.button}
        <span class="ft-button-arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</section>

<style>
  .ft { background: var(--water-1); border-block: 1px solid var(--ink); color: var(--ink); }
  .ft-link { position: relative; display: block; overflow: hidden; color: inherit; text-decoration: none; }
  /* Tiefenlinien nur in der rechten Hälfte, hinter den Formularzeilen –
     nie durch den Fließtext. */
  .ft-contours {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    pointer-events: none;
  }
  .ft-contours path { fill: none; stroke: var(--contour); stroke-width: 1; opacity: 0.75; }
  @media (max-width: 899px) {
    .ft-contours { width: 100%; height: 42%; top: auto; bottom: 0; }
  }
  .ft-contours .ft-dash { stroke-dasharray: 7 5; }

  .ft-inner {
    position: relative;
    max-width: 1200px;
    margin-inline: auto;
    padding: 56px 24px 60px;
    display: grid;
    grid-template-areas: "copy" "form" "button";
    gap: 28px;
  }
  .ft-copy { grid-area: copy; }
  .ft-form { grid-area: form; }
  .ft-button { grid-area: button; justify-self: start; }
  .ft-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .ft-title { font-size: clamp(2.2rem, 1.5rem + 2.8vw, 3.9rem); margin-bottom: 18px; hyphens: manual; }
  .ft-sub { font-size: 16.5px; line-height: 1.55; color: var(--ink-2); max-width: 34em; }

  .ft-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 16px;
    font-weight: 700;
  }
  .ft-button-arrow { display: inline-block; transition: transform 0.2s ease; }
  .ft-link:hover .ft-button-arrow { transform: translateX(4px); }
  .ft-link:focus-visible { outline: 2px solid var(--action); outline-offset: -6px; }

  /* Drei leere Formularzeilen: Frage, Linie zum Ausfüllen. */
  .ft-form { list-style: none; margin: 0; padding: 0; align-self: center; }
  .ft-row {
    display: grid;
    grid-template-columns: 34px auto 1fr;
    align-items: end;
    gap: 14px;
    padding: 18px 0 10px;
  }
  .ft-row-num { font-size: 14px; font-style: italic; font-weight: 600; color: var(--magenta); }
  .ft-row-q { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem); font-weight: 720; font-stretch: 80%; line-height: 1; }
  .ft-row-line { border-bottom: 1.5px solid var(--ink); margin-bottom: 4px; min-width: 40px; }

  @media (max-width: 768px) {
    .ft-title br { display: none; }
    .ft-button { width: 100%; justify-content: center; justify-self: stretch; }
  }
  @media (min-width: 900px) {
    .ft-inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: "copy form" "button form";
      column-gap: 72px;
      row-gap: 32px;
      padding: 88px 40px 92px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ft-button-arrow { transition: none; }
  }
</style>
